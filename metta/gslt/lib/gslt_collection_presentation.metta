; Reconstruct one source presentation from retained allocation decisions.
(: gslt:collection-presentation:wrap (-> Atom Atom %Undefined%))
(= (gslt:collection-presentation:wrap $frame $result)
  (case $result
    ((None None)
     ((Some (RecursivePresentation $value $remaining))
       (case $frame
         (((PresentationApp $label)
            (Some (RecursivePresentation (PApp $label $value) $remaining)))
          ((PresentationLam $display)
            (Some (RecursivePresentation (PLam $display $value) $remaining)))
          ((PresentationMultiLam $arity $display)
            (Some (RecursivePresentation (PMultiLam $arity $display $value) $remaining)))
          ((PresentationSubst $body)
            (Some (RecursivePresentation (PSubst $body $value) $remaining)))
          ((PresentationCons $head)
            (Some (RecursivePresentation (LCons $head $value) $remaining)))
          ((PresentationCollection $kind $residual)
            (let $items (gslt:automata:append $value $residual)
              (Some (RecursivePresentation (PCollection $kind $items RNone) $remaining))))))))))

(: gslt:collection-presentation:arguments (-> Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:collection-presentation:arguments $names $path $index $schemas $targets $events)
  (case (PresentationRows $schemas $targets)
    (((PresentationRows LNil LNil) (Some (RecursivePresentation LNil $events)))
     ((PresentationRows (LCons $schema $schemasTail) (LCons $target $targetsTail))
       (let $childPath (gslt:automata:append $path (LCons $index LNil))
         (case (gslt:collection-presentation:at $names $childPath $schema $target $events)
           ((None None)
            ((Some (RecursivePresentation $head $remaining))
              (let* (($nextIndex (+ $index 1))
                     ($tail (gslt:collection-presentation:arguments $names $path $nextIndex
                              $schemasTail $targetsTail $remaining)))
                (gslt:collection-presentation:wrap (PresentationCons $head) $tail)))))))
     ($other None))))

(: gslt:collection-presentation:unordered (-> Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:collection-presentation:unordered $names $path $kind $schemas $targets $events)
  (case $events
    ((LNil None)
     ((LCons (CollectionEvent $eventPath $eventKind $decisions) $remaining)
       (if (== $eventPath $path)
         (if (== $eventKind $kind)
           (let* (($count (gslt:automata:length $schemas))
                  ($decisionCount (gslt:automata:length $decisions)))
             (if (== $decisionCount $count)
               (let* (($items (gslt:recursive-collection:arrange $names $kind $targets))
                      ($idempotent (if (== $kind "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashSet") 1 0)))
                 (case (gslt:collection:replay $idempotent $items $decisions)
                   ((None None)
                    ((Some (CollectionPair $values $residual))
                      (let* (($rest (gslt:recursive-collection:arrange $names $kind $residual))
                             ($children (gslt:collection-presentation:arguments $names $path 0 $schemas $values $remaining)))
                        (gslt:collection-presentation:wrap (PresentationCollection $kind $rest) $children))))))
               None))
           None)
         None)))))

(: gslt:collection-presentation:at (-> Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:collection-presentation:at $names $path $schema $target $events)
  (case (PresentationPair $schema $target)
    (((PresentationPair (FVar $name) $value)
       (Some (RecursivePresentation $value $events)))
     ((PresentationPair (Var $expected) (Var $actual))
       (if (== $expected $actual) (Some (RecursivePresentation $target $events)) None))
     ((PresentationPair (PApp $label $schemas) (PApp $actual $targets))
       (if (== $label $actual)
         (let $children (gslt:collection-presentation:arguments $names $path 0 $schemas $targets $events)
           (gslt:collection-presentation:wrap (PresentationApp $actual) $children))
         None))
     ((PresentationPair (PLam $unused $body) (PLam $display $targetBody))
       (let* (($childPath (gslt:automata:append $path (LCons 0 LNil)))
              ($child (gslt:collection-presentation:at $names $childPath $body $targetBody $events)))
         (gslt:collection-presentation:wrap (PresentationLam $display) $child)))
     ((PresentationPair (PMultiLam $arity $unused $body) (PMultiLam $actual $display $targetBody))
       (if (== $arity $actual)
         (let* (($childPath (gslt:automata:append $path (LCons 0 LNil)))
                ($child (gslt:collection-presentation:at $names $childPath $body $targetBody $events)))
           (gslt:collection-presentation:wrap (PresentationMultiLam $actual $display) $child))
         None))
     ((PresentationPair (PSubst $body $replacement) (PSubst $targetBody $targetReplacement))
       (let $bodyPath (gslt:automata:append $path (LCons 0 LNil))
         (case (gslt:collection-presentation:at $names $bodyPath $body $targetBody $events)
           ((None None)
            ((Some (RecursivePresentation $bodyValue $remaining))
              (let* (($replacementPath (gslt:automata:append $path (LCons 1 LNil)))
                     ($replacementValue (gslt:collection-presentation:at $names $replacementPath $replacement $targetReplacement $remaining)))
                (gslt:collection-presentation:wrap (PresentationSubst $bodyValue) $replacementValue)))))))
     ((PresentationPair (PCollection $kind $schemas $rest) (PCollection $actual $targets RNone))
       (if (== $kind $actual)
         (if (== $kind "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.vec")
           (case $rest
             ((RNone
                (let $children (gslt:collection-presentation:arguments $names $path 0 $schemas $targets $events)
                  (gslt:collection-presentation:wrap (PresentationCollection $kind LNil) $children)))
              ((RSome $unused)
                (let* (($count (gslt:automata:length $schemas))
                       ($first (gslt:complete:take $count $targets))
                       ($later (gslt:complete:drop $count $targets))
                       ($children (gslt:collection-presentation:arguments $names $path 0 $schemas $first $events)))
                  (gslt:collection-presentation:wrap (PresentationCollection $kind $later) $children)))))
           (gslt:collection-presentation:unordered $names $path $kind $schemas $targets $events))
         None))
     ($other None))))

; Incremental physical grouping keeps original records as opaque payloads.
(: gslt:collection-presentation:group-reverse-onto (-> Atom Atom %Undefined%))
(= (gslt:collection-presentation:group-reverse-onto $items $reversed)
  (case $items
    ((LNil $reversed)
     ((LCons $head $tail)
       (gslt:collection-presentation:group-reverse-onto $tail (LCons $head $reversed))))))

(: gslt:collection-presentation:group-expand (-> Atom %Undefined%))
(= (gslt:collection-presentation:group-expand $work)
  (case $work
    (((GroupingGroups $slots $closed $selected $remaining)
      (if (== $slots 0)
        (GroupingExpansion LNil LNil)
        (let* (($previous (- $slots 1))
               ($bucket (gslt:collection-presentation:group-reverse-onto $selected LNil))
               ($closed-next (gslt:automata:append $closed (LCons $bucket LNil)))
               ($next (if (== $previous 0)
                        (GroupingResidual $closed-next LNil $remaining)
                        (GroupingGroups $previous $closed-next LNil $remaining))))
          (GroupingExpansion
            (LCons $next (LCons (GroupingSelectGroup $slots $closed $selected $remaining 0) LNil))
            LNil))))
     ((GroupingSelectGroup $slots $closed $selected $remaining $cursor)
      (case (gslt:rule:row-at $cursor $remaining)
        ((None (GroupingExpansion LNil LNil))
         ((Some $occurrence)
          (let* (($residual (gslt:rule:scope-match-erase-at $cursor $remaining))
                 ($next (+ $cursor 1)))
            (GroupingExpansion
              (LCons (GroupingGroups $slots $closed (LCons $occurrence $selected) $residual)
                (LCons (GroupingSelectGroup $slots $closed $selected $remaining $next) LNil))
              LNil))))))
     ((GroupingResidual $closed $selected LNil)
      (let $residual (gslt:collection-presentation:group-reverse-onto $selected LNil)
        (GroupingExpansion LNil (LCons (GroupingAllocation $closed $residual) LNil))))
     ((GroupingResidual $closed $selected (LCons $head $tail))
      (GroupingExpansion
        (LCons (GroupingSelectResidual $closed $selected (LCons $head $tail) 0) LNil)
        LNil))
     ((GroupingSelectResidual $closed $selected $remaining $cursor)
      (case (gslt:rule:row-at $cursor $remaining)
        ((None (GroupingExpansion LNil LNil))
         ((Some $occurrence)
          (let* (($residual (gslt:rule:scope-match-erase-at $cursor $remaining))
                 ($next (+ $cursor 1)))
            (GroupingExpansion
              (LCons (GroupingResidual $closed (LCons $occurrence $selected) $residual)
                (LCons (GroupingSelectResidual $closed $selected $remaining $next) LNil))
              LNil)))))))))

(: gslt:collection-presentation:group-begin (-> Atom Atom %Undefined%))
(= (gslt:collection-presentation:group-begin $count $occurrences)
  (let $first (if (== $count 0)
                (GroupingResidual LNil LNil $occurrences)
                (GroupingGroups $count LNil LNil $occurrences))
    (GroupingState (LCons $first LNil) LNil)))

(: gslt:collection-presentation:group-tick (-> Atom %Undefined%))
(= (gslt:collection-presentation:group-tick $state)
  (case $state
    (((GroupingState LNil $answers) $state)
     ((GroupingState (LCons $work $pending) $answers)
      (case (gslt:collection-presentation:group-expand $work)
        (((GroupingExpansion $children $published)
          (let* (($agenda (gslt:automata:append $children $pending))
                 ($next-answers (gslt:automata:append $answers $published)))
            (GroupingState $agenda $next-answers)))))))))

(: gslt:collection-presentation:group-run (-> Atom Atom %Undefined%))
(= (gslt:collection-presentation:group-run $steps $state)
  (if (== $steps 0)
    $state
    (let* (($next (gslt:collection-presentation:group-tick $state))
           ($remaining (- $steps 1)))
      (gslt:collection-presentation:group-run $remaining $next))))

(: gslt:collection-presentation:group-complete (-> Atom %Undefined%))
(= (gslt:collection-presentation:group-complete $state)
  (case $state
    (((GroupingState LNil $answers) True)
     ((GroupingState (LCons $head $tail) $answers) False))))

(: gslt:collection-presentation:group-answers (-> Atom %Undefined%))
(= (gslt:collection-presentation:group-answers $state)
  (case $state
    (((GroupingState $agenda $answers) $answers))))
