; Typed occurrence enumeration uses authored declarations and explicit reduction
; permissions. Every declaration alternative and every physical child is retained.
; Load after gslt_scoped_execution.metta. All inputs are inert wire values.

(: gslt:sites:take (-> Atom Atom %Undefined%))
(= (gslt:sites:take $count $items)
   (if (== $count 0) LNil
     (case $items ((LNil LNil) ((LCons $item $rest)
       (let* (($previous (- $count 1)) ($tail (gslt:sites:take $previous $rest)))
         (LCons $item $tail)))))))

(: gslt:sites:drop (-> Atom Atom %Undefined%))
(= (gslt:sites:drop $count $items)
   (if (== $count 0) $items
     (case $items ((LNil LNil) ((LCons $item $rest)
       (let $previous (- $count 1) (gslt:sites:drop $previous $rest)))))))

(: gslt:sites:argument-permitted (-> Atom Atom Atom %Undefined%))
(= (gslt:sites:argument-permitted $permissions $constructor $index)
   (case $permissions
     (((OperationalPermissions $enabled $all $slots $lambda $multi $kinds)
       (case $all ((PermissionYes True)
         (PermissionNo (let $slot (TermSlot $constructor $index)
           (gslt:automata:member $slot $slots)))))))))

(: gslt:sites:wrap-application (-> Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:wrap-application $declaration $constructor $before $index $after $sites)
   (case $sites ((LNil LNil)
     ((LCons (RuleJobSite $address $context $focus $bound $type $frames) $rest)
       (let $tail (gslt:sites:wrap-application $declaration $constructor $before $index $after $rest)
         (LCons (RuleJobSite (LCons $index $address) (ContextApp $constructor $before $context $after)
           $focus $bound $type (LCons (TypingApplication $declaration $index) $frames)) $tail))))))

(: gslt:sites:wrap-lambda (-> Atom Atom Atom %Undefined%))
(= (gslt:sites:wrap-lambda $binder $domain $sites)
   (case $sites ((LNil LNil)
     ((LCons (RuleJobSite $address $context $focus $bound $type $frames) $rest)
       (let $tail (gslt:sites:wrap-lambda $binder $domain $rest)
         (LCons (RuleJobSite (LCons 0 $address) (ContextLam $binder $context)
           $focus $bound $type (LCons (TypingLambda $domain) $frames)) $tail))))))

(: gslt:sites:wrap-multi (-> Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:wrap-multi $arity $binders $domain $sites)
   (case $sites ((LNil LNil)
     ((LCons (RuleJobSite $address $context $focus $bound $type $frames) $rest)
       (let $tail (gslt:sites:wrap-multi $arity $binders $domain $rest)
         (LCons (RuleJobSite (LCons 0 $address) (ContextMultiLam $arity $binders $context)
           $focus $bound $type (LCons (TypingMultiLambda $arity $domain) $frames)) $tail))))))

(: gslt:sites:wrap-collection (-> Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:wrap-collection $frame $kind $before $index $after $sites)
   (case $sites ((LNil LNil)
     ((LCons (RuleJobSite $address $context $focus $bound $type $frames) $rest)
       (let $tail (gslt:sites:wrap-collection $frame $kind $before $index $after $rest)
         (LCons (RuleJobSite (LCons $index $address) (ContextCollection $kind $before $context $after RNone)
           $focus $bound $type (LCons $frame $frames)) $tail))))))

(: gslt:sites:generate (-> Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:generate $declarations $free $permissions $bound $expected $source)
   (case $permissions
     (((OperationalPermissions PermissionNo $all $slots $lambda $multi $kinds) LNil)
      ((OperationalPermissions PermissionYes $all $slots $lambda $multi $kinds)
       (if (gslt:premise:object-pattern $source)
         (if (gslt:premise:type-has $declarations $free $bound $source $expected)
           (let* (($tail (gslt:sites:descend $declarations $free $permissions $bound $expected $source))
                  ($here (RuleJobSite LNil ContextHole $source $bound $expected LNil)))
             (LCons $here $tail)) LNil) LNil)))))

(: gslt:sites:descend (-> Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:descend $declarations $free $permissions $bound $expected $source)
   (case $permissions
     (((OperationalPermissions $enabled $all $slots $lambda $multi $kinds)
       (case $source
         (((PApp $constructor $arguments)
           (gslt:sites:application-rows $declarations $free $permissions $bound $expected
             $constructor $arguments $declarations 0))
          ((PLam $binder $body)
           (case ($lambda $expected)
             (((PermissionYes (TArrow $domain $codomain))
               (let* (($inner (LCons $domain $bound))
                      ($sites (gslt:sites:generate $declarations $free $permissions $inner $codomain $body)))
                 (gslt:sites:wrap-lambda $binder $domain $sites)))
              ($unpermitted LNil))))
          ((PMultiLam $arity $binders $body)
           (case ($multi $expected)
             (((PermissionYes (TArrow (TMultiBinder $domain) $codomain))
               (let* (($inner (gslt:premise:type-extend-count $domain $arity $bound))
                      ($sites (gslt:sites:generate $declarations $free $permissions $inner $codomain $body)))
                 (gslt:sites:wrap-multi $arity $binders $domain $sites)))
              ($unpermitted LNil))))
          ((PCollection $kind $elements RNone)
           (if (gslt:automata:member $kind $kinds)
             (let* (($direct (gslt:sites:direct-collection $declarations $free $permissions $bound $expected $kind $elements))
                    ($authored (gslt:sites:collection-rows $declarations $free $permissions $bound $expected $kind $elements $declarations 0)))
               (gslt:automata:append $direct $authored)) LNil))
          ($leaf LNil)))))))

(: gslt:sites:application-rows (-> Atom Atom Atom Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:application-rows $declarations $free $permissions $bound $expected $constructor $arguments $remaining $index)
   (case $remaining ((LNil LNil)
     ((LCons $row $rest)
       (let* (($here (gslt:sites:application-row $declarations $free $permissions $bound $expected $constructor $arguments $row $index))
              ($next (+ $index 1))
              ($tail (gslt:sites:application-rows $declarations $free $permissions $bound $expected $constructor $arguments $rest $next)))
         (gslt:automata:append $here $tail))))))

(: gslt:sites:application-row (-> Atom Atom Atom Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:application-row $declarations $free $permissions $bound $expected $constructor $arguments $row $declaration)
   (case $row
     (((GrammarTypingV1 $label $category $parameters)
       (if (== $label $constructor)
         (let $result (TBase $category)
           (if (== $expected $result)
             (case $parameters
               (((LCons (TermSimple $name (TCollection $kind $element)) LNil) LNil)
                ($ordinary
                 (if (gslt:premise:type-arguments $declarations $free $bound $arguments $parameters)
                   (gslt:sites:application-children $declarations $free $permissions $bound $constructor $arguments $parameters $declaration $arguments 0)
                   LNil)))) LNil)) LNil)))))

(: gslt:sites:application-children (-> Atom Atom Atom Atom Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:application-children $declarations $free $permissions $bound $constructor $arguments $parameters $declaration $remaining $index)
   (case $remaining ((LNil LNil)
     ((LCons $argument $rest)
       (let* (($next (+ $index 1))
              ($here
               (if (gslt:sites:argument-permitted $permissions $constructor $index)
                 (case (gslt:rule:row-at $index $parameters)
                   ((None LNil)
                    ((Some $parameter)
                     (case (gslt:premise:parameter-type $parameter)
                       ((None LNil)
                        ((Some $type)
                         (let* (($sites (gslt:sites:generate $declarations $free $permissions $bound $type $argument))
                                ($before (gslt:sites:take $index $arguments))
                                ($after (gslt:sites:drop $next $arguments)))
                           (gslt:sites:wrap-application $declaration $constructor $before $index $after $sites)))))))) LNil))
              ($tail (gslt:sites:application-children $declarations $free $permissions $bound $constructor $arguments $parameters $declaration $rest $next)))
         (gslt:automata:append $here $tail))))))

(: gslt:sites:direct-collection (-> Atom Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:direct-collection $declarations $free $permissions $bound $expected $kind $elements)
   (case $expected
     (((TCollection $actual $type)
       (if (== $actual $kind)
         (if (gslt:premise:type-elements $declarations $free $bound $elements $type)
           (let $frame (TypingDirectCollection $kind)
             (gslt:sites:collection-children $declarations $free $permissions $bound $type $kind $elements $frame $elements 0))
           LNil) LNil))
      ($other LNil))))

(: gslt:sites:collection-rows (-> Atom Atom Atom Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:collection-rows $declarations $free $permissions $bound $expected $kind $elements $remaining $index)
   (case $remaining ((LNil LNil)
     ((LCons $row $rest)
       (let* (($here (gslt:sites:collection-row $declarations $free $permissions $bound $expected $kind $elements $row $index))
              ($next (+ $index 1))
              ($tail (gslt:sites:collection-rows $declarations $free $permissions $bound $expected $kind $elements $rest $next)))
         (gslt:automata:append $here $tail))))))

(: gslt:sites:collection-row (-> Atom Atom Atom Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:collection-row $declarations $free $permissions $bound $expected $kind $elements $row $declaration)
   (case ($row $expected)
     ((((GrammarTypingV1 $label $category (LCons (TermSimple $name (TCollection $actual $type)) LNil)) (TBase $sort))
       (if (== $category $sort)
         (if (== $actual $kind)
           (if (gslt:premise:type-elements $declarations $free $bound $elements $type)
             (let $frame (TypingAuthoredCollection $declaration)
               (gslt:sites:collection-children $declarations $free $permissions $bound $type $kind $elements $frame $elements 0))
             LNil) LNil) LNil))
      ($ordinary LNil))))

(: gslt:sites:collection-children (-> Atom Atom Atom Atom Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:collection-children $declarations $free $permissions $bound $type $kind $elements $frame $remaining $index)
   (case $remaining ((LNil LNil)
     ((LCons $element $rest)
       (let* (($next (+ $index 1))
              ($sites (gslt:sites:generate $declarations $free $permissions $bound $type $element))
              ($before (gslt:sites:take $index $elements))
              ($after (gslt:sites:drop $next $elements))
              ($here (gslt:sites:wrap-collection $frame $kind $before $index $after $sites))
              ($tail (gslt:sites:collection-children $declarations $free $permissions $bound $type $kind $elements $frame $rest $next)))
         (gslt:automata:append $here $tail))))))

(: gslt:sites:cross-sites (-> Atom Atom Atom %Undefined%))
(= (gslt:sites:cross-sites $ordinal $declaration $sites)
   (case $sites ((LNil LNil) ((LCons $site $rest)
     (let* (($tail (gslt:sites:cross-sites $ordinal $declaration $rest))
            ($job (RuleJob $ordinal $declaration $site)))
       (LCons $job $tail))))))

(: gslt:sites:cross-rules (-> Atom Atom Atom %Undefined%))
(= (gslt:sites:cross-rules $rules $sites $ordinal)
   (case $rules ((LNil LNil) ((LCons $declaration $rest)
     (let* (($here (gslt:sites:cross-sites $ordinal $declaration $sites))
            ($next (+ $ordinal 1))
            ($tail (gslt:sites:cross-rules $rest $sites $next)))
       (gslt:automata:append $here $tail))))))

(: gslt:sites:jobs (-> Atom Atom Atom Atom Atom Atom Atom %Undefined%))
(= (gslt:sites:jobs $declarations $free $permissions $bound $expected $source $rules)
   (let $sites (gslt:sites:generate $declarations $free $permissions $bound $expected $source)
     (gslt:sites:cross-rules $rules $sites 0)))
