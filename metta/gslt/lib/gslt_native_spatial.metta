(: native:spatial:prepend-left (-> Atom Atom Atom %Undefined%))
(= (native:spatial:prepend-left $item $pairs $tail)
  (case $pairs
    ((LNil $tail)
     ((LCons (Split $left $right) $rest)
      (let $next (native:spatial:prepend-left $item $rest $tail)
        (LCons (Split (LCons $item $left) $right) $next))))))
(: native:spatial:prepend-right (-> Atom Atom %Undefined%))
(= (native:spatial:prepend-right $item $pairs)
  (case $pairs
    ((LNil LNil)
     ((LCons (Split $left $right) $rest)
      (let $next (native:spatial:prepend-right $item $rest)
        (LCons (Split $left (LCons $item $right)) $next))))))
(: native:spatial:splits (-> Atom %Undefined%))
(= (native:spatial:splits $bag)
  (case $bag
    ((LNil (LCons (Split LNil LNil) LNil))
     ((LCons $item $rest)
      (let* (($pairs (native:spatial:splits $rest))
             ($right (native:spatial:prepend-right $item $pairs)))
        (native:spatial:prepend-left $item $pairs $right))))))
(: native:spatial:leaf (-> Atom Atom %Undefined%))
(= (native:spatial:leaf $leaf $bag)
  (case $leaf
    ((NativeEmp (if (== $bag LNil) 1 0))
     ((NativeSingle $item) (if (== $bag (LCons $item LNil)) 1 0)))))
(: native:spatial:binary (-> Atom Atom Atom %Undefined%))
(= (native:spatial:binary $op $left $right)
  (case $op
    ((NativeAnd (if (== $left 1) $right 0))
     (NativeOr (if (== $left 1) 1 $right))
     (NativeImp (if (== $left 1) $right 1)))))
(: native:spatial:step (-> Atom %Undefined%))
(= (native:spatial:step $state)
  (case $state
    (((NativeEval $formula $bag $next)
      (case $formula
        (((NativeAtom $leaf)
          (let $value (native:spatial:leaf $leaf $bag) (NativeReturn $value $next)))
         (NativeTop (NativeReturn 1 $next))
         (NativeBottom (NativeReturn 0 $next))
         ((NativeNeg $inner) (NativeEval $inner $bag (NativeNegate $next)))
         ((NativeConj $left $right) (NativeEval $left $bag (NativeBinaryLeft NativeAnd $right $bag $next)))
         ((NativeDisj $left $right) (NativeEval $left $bag (NativeBinaryLeft NativeOr $right $bag $next)))
         ((NativeImpl $left $right) (NativeEval $left $bag (NativeBinaryLeft NativeImp $right $bag $next)))
         ((NativeSep $index $left $right)
          (if (== $index 0)
            (let $pairs (native:spatial:splits $bag) (NativeChoose $left $right $pairs $next))
            (NativeReturn 0 $next)))
         ((NativePossibly $inner) (NativeReturn 0 $next))
         ((NativeOutgoing $inner) (NativeReturn 0 $next)))))
     ((NativeChoose $left $right $pairs $next)
      (case $pairs
        ((LNil (NativeReturn 0 $next))
         ((LCons (Split $first $second) $rest)
          (NativeEval $left $first (NativeSplitLeft $left $right $second $rest $next))))))
     ((NativeReturn $value $next)
      (case $next
        ((NativeHalt (NativeReturn $value NativeHalt))
         ((NativeNegate $later)
          (let $result (if (== $value 1) 0 1) (NativeReturn $result $later)))
         ((NativeBinaryLeft $op $right $bag $later) (NativeEval $right $bag (NativeBinaryRight $op $value $later)))
         ((NativeBinaryRight $op $left $later)
          (let $result (native:spatial:binary $op $left $value) (NativeReturn $result $later)))
         ((NativeSplitLeft $left $right $rightBag $rest $later)
          (NativeEval $right $rightBag (NativeSplitRight $left $right $value $rest $later)))
         ((NativeSplitRight $left $right $first $rest $later)
          (let $found (if (== $first 1) $value 0)
            (NativeChoose $left $right $rest (NativeSplitRest $found $later))))
         ((NativeSplitRest $found $later)
          (let $result (if (== $found 1) 1 $value) (NativeReturn $result $later)))))))))
(: native:spatial:run (-> Atom Atom %Undefined%))
(= (native:spatial:run $fuel $state)
  (if (== $fuel 0) $state
    (let* (($next (native:spatial:step $state)) ($remaining (- $fuel 1)))
      (native:spatial:run $remaining $next))))
(: native:spatial:answer (-> Atom %Undefined%))
(= (native:spatial:answer $state)
  (case $state
    (((NativeReturn $value $next)
      (case $next
        ((NativeHalt (if (== $value 1) NativeProved NativeRefuted))
         ($other NativeUnknown))))
     ($other NativeUnknown))))
(: native:spatial:admitted (-> Atom %Undefined%))
(= (native:spatial:admitted $formula)
  (case $formula
    (((NativeAtom $leaf) 1)
     (NativeTop 1)
     (NativeBottom 1)
     ((NativeNeg $inner) (native:spatial:admitted $inner))
     ((NativeConj $left $right)
      (let* (($first (native:spatial:admitted $left)) ($second (native:spatial:admitted $right)))
        (native:spatial:binary NativeAnd $first $second)))
     ((NativeDisj $left $right)
      (let* (($first (native:spatial:admitted $left)) ($second (native:spatial:admitted $right)))
        (native:spatial:binary NativeAnd $first $second)))
     ((NativeImpl $left $right)
      (let* (($first (native:spatial:admitted $left)) ($second (native:spatial:admitted $right)))
        (native:spatial:binary NativeAnd $first $second)))
     ((NativeSep $index $left $right)
      (if (== $index 0)
        (let* (($first (native:spatial:admitted $left)) ($second (native:spatial:admitted $right)))
          (native:spatial:binary NativeAnd $first $second))
        0))
     ((NativePossibly $inner) 0)
     ((NativeOutgoing $inner) 0))))
(: native:spatial:start (-> Atom Atom Atom %Undefined%))
(= (native:spatial:start $formula $bag $fuel)
  (let $admitted (native:spatial:admitted $formula)
    (if (== $admitted 1)
      (let $cursor (native:spatial:run $fuel (NativeEval $formula $bag NativeHalt))
        (NativeSession $formula $bag $cursor))
      (NativeUnsupported $formula $bag))))
(: native:spatial:resume (-> Atom Atom %Undefined%))
(= (native:spatial:resume $fuel $packet)
  (case $packet
    (((NativeSession $formula $bag $cursor)
      (let $admitted (native:spatial:admitted $formula)
        (if (== $admitted 1)
          (let $next (native:spatial:run $fuel $cursor) (NativeSession $formula $bag $next))
          (NativeUnsupported $formula $bag))))
     ((NativeUnsupported $formula $bag) $packet))))
(: native:spatial:read (-> Atom %Undefined%))
(= (native:spatial:read $packet)
  (case $packet
    (((NativeSession $formula $bag $cursor)
      (let $admitted (native:spatial:admitted $formula)
        (if (== $admitted 1) (native:spatial:answer $cursor) NativeUnsupported)))
     ((NativeUnsupported $formula $bag) NativeUnsupported))))
