; Residual contexts preserve the original typed occurrence beside its variant.
(: gslt:collection-context:wrap (-> Atom Atom %Undefined%))
(= (gslt:collection-context:wrap $frame $inner)
  (case $frame
    ((ContextHole $inner)
     ((ContextApp $label $before $unused $after) (ContextApp $label $before $inner $after))
     ((ContextLam $display $unused) (ContextLam $display $inner))
     ((ContextMultiLam $arity $displays $unused) (ContextMultiLam $arity $displays $inner))
     ((ContextSubstBody $unused $replacement) (ContextSubstBody $inner $replacement))
     ((ContextSubstReplacement $body $unused) (ContextSubstReplacement $body $inner))
     ((ContextCollection $kind $before $unused $after $rest)
       (ContextCollection $kind $before $inner $after $rest)))))

(: gslt:collection-context:map-frame (-> Atom Atom %Undefined%))
(= (gslt:collection-context:map-frame $frame $contexts)
  (case $contexts
    ((LNil LNil)
     ((LCons $inner $tail)
       (let* (($head (gslt:collection-context:wrap $frame $inner))
              ($later (gslt:collection-context:map-frame $frame $tail)))
         (LCons $head $later))))))

(: gslt:collection-context:row (-> Atom Atom Atom Atom %Undefined%))
(= (gslt:collection-context:row $kind $rest $inner $residuals)
  (case $residuals
    ((LNil LNil)
     ((LCons $residual $tail)
       (let $later (gslt:collection-context:row $kind $rest $inner $tail)
         (LCons (ContextCollection $kind LNil $inner $residual $rest) $later))))))

(: gslt:collection-context:cross (-> Atom Atom Atom Atom %Undefined%))
(= (gslt:collection-context:cross $kind $rest $contexts $residuals)
  (case $contexts
    ((LNil LNil)
     ((LCons $inner $tail)
       (let* (($head (gslt:collection-context:row $kind $rest $inner $residuals))
              ($later (gslt:collection-context:cross $kind $rest $tail $residuals)))
         (gslt:automata:append $head $later))))))

(: gslt:collection-context:residuals (-> Atom Atom Atom %Undefined%))
(= (gslt:collection-context:residuals $kind $items $index)
  (let $consumed (gslt:rule:scope-match-erase-at $index $items)
    (if (== $kind "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.hashSet")
      (LCons $consumed (LCons $items LNil))
      (LCons $consumed LNil))))

(: gslt:collection-context:variants (-> Atom Atom %Undefined%))
(= (gslt:collection-context:variants $focus $context)
  (case $context
    ((ContextHole (LCons ContextHole LNil))
     ((ContextApp $label $before $inner $after)
       (let $children (gslt:collection-context:variants $focus $inner)
         (gslt:collection-context:map-frame $context $children)))
     ((ContextLam $display $inner)
       (let $children (gslt:collection-context:variants $focus $inner)
         (gslt:collection-context:map-frame $context $children)))
     ((ContextMultiLam $arity $displays $inner)
       (let $children (gslt:collection-context:variants $focus $inner)
         (gslt:collection-context:map-frame $context $children)))
     ((ContextSubstBody $inner $replacement)
       (let $children (gslt:collection-context:variants $focus $inner)
         (gslt:collection-context:map-frame $context $children)))
     ((ContextSubstReplacement $body $inner)
       (let $children (gslt:collection-context:variants $focus $inner)
         (gslt:collection-context:map-frame $context $children)))
     ((ContextCollection $kind $before $inner $after $rest)
       (let $children (gslt:collection-context:variants $focus $inner)
         (if (== $kind "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.vec")
           (gslt:collection-context:map-frame $context $children)
           (let* (($original (gslt:rule:scope-fill $inner $focus))
                  ($items (gslt:automata:append $before (LCons $original $after)))
                  ($index (gslt:automata:length $before))
                  ($residuals (gslt:collection-context:residuals $kind $items $index)))
             (gslt:collection-context:cross $kind $rest $children $residuals))))))))

(: gslt:collection-context:address (-> Atom %Undefined%))
(= (gslt:collection-context:address $context)
  (case $context
    ((ContextHole LNil)
     ((ContextApp $label $before $inner $after)
       (let* (($index (gslt:automata:length $before))
              ($tail (gslt:collection-context:address $inner))) (LCons $index $tail)))
     ((ContextLam $display $inner)
       (let $tail (gslt:collection-context:address $inner) (LCons 0 $tail)))
     ((ContextMultiLam $arity $displays $inner)
       (let $tail (gslt:collection-context:address $inner) (LCons 0 $tail)))
     ((ContextSubstBody $inner $replacement)
       (let $tail (gslt:collection-context:address $inner) (LCons 0 $tail)))
     ((ContextSubstReplacement $body $inner)
       (let $tail (gslt:collection-context:address $inner) (LCons 1 $tail)))
     ((ContextCollection $kind $before $inner $after $rest)
       (let* (($index (gslt:automata:length $before))
              ($tail (gslt:collection-context:address $inner))) (LCons $index $tail))))))

(: gslt:collection-context:sites (-> Atom Atom %Undefined%))
(= (gslt:collection-context:sites $site $contexts)
  (case $site
    (((RuleJobSite $oldAddress $oldContext $focus $bound $type $frames)
      (case $contexts
        ((LNil LNil)
         ((LCons $context $tail)
          (let* (($address (gslt:collection-context:address $context))
                 ($later (gslt:collection-context:sites $site $tail)))
            (LCons (CollectionSiteVariant $site
              (RuleJobSite $address $context $focus $bound $type $frames)) $later)))))))))

(: gslt:collection-context:site-variants (-> Atom %Undefined%))
(= (gslt:collection-context:site-variants $site)
  (case $site
    (((RuleJobSite $address $context $focus $bound $type $frames)
      (let $contexts (gslt:collection-context:variants $focus $context)
        (gslt:collection-context:sites $site $contexts))))))
