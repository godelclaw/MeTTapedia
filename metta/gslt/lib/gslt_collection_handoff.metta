; Ordinary matching evidence for a retained recursive collection answer.
(: gslt:collection-handoff:trace-arguments (-> Atom Atom Atom Atom %Undefined%))
(= (gslt:collection-handoff:trace-arguments $select $path $index $schemas)
  (case $schemas
    ((LNil LNil)
     ((LCons $schema $tail)
       (let* (($childPath (gslt:automata:append $path (LCons $index LNil)))
              ($headTrace (gslt:collection-handoff:trace $childPath $schema))
              ($nextIndex (+ $index 1))
              ($tailTrace (gslt:collection-handoff:trace-arguments $select $path $nextIndex $tail))
              ($combined (gslt:automata:append $headTrace $tailTrace)))
         (if (== $select 1) (LCons (BagChoice $childPath 0) $combined) $combined))))))

(: gslt:collection-handoff:trace (-> Atom Atom %Undefined%))
(= (gslt:collection-handoff:trace $path $schema)
  (case $schema
    (((FVar $name) LNil)
     ((Var $index) LNil)
     ((PApp $label $schemas) (gslt:collection-handoff:trace-arguments 0 $path 0 $schemas))
     ((PLam $display $body)
       (let $childPath (gslt:automata:append $path (LCons 0 LNil))
         (gslt:collection-handoff:trace $childPath $body)))
     ((PMultiLam $arity $display $body)
       (let $childPath (gslt:automata:append $path (LCons 0 LNil))
         (gslt:collection-handoff:trace $childPath $body)))
     ((PSubst $body $replacement)
       (let* (($bodyPath (gslt:automata:append $path (LCons 0 LNil)))
              ($replacementPath (gslt:automata:append $path (LCons 1 LNil)))
              ($bodyTrace (gslt:collection-handoff:trace $bodyPath $body))
              ($replacementTrace (gslt:collection-handoff:trace $replacementPath $replacement)))
         (gslt:automata:append $bodyTrace $replacementTrace)))
     ((PCollection $kind $schemas $rest)
       (let $select (if (== $kind "Mettapedia.OSLF.MeTTaIL.Syntax.CollType.vec") 0 1)
         (gslt:collection-handoff:trace-arguments $select $path 0 $schemas))))))

(: gslt:collection-handoff:prepare (-> Atom Atom Atom %Undefined%))
(= (gslt:collection-handoff:prepare $names $request $answer)
  (case $request
    (((ScopedMatcherRequest $rule $spec $ambient $site $path $depth $initial $schema $target)
       (case $answer
         (((RecursiveCollectionAnswer $assignment $events)
           (case (gslt:collection-presentation:at $names $path $schema $target $events)
             ((None None)
              ((Some (RecursivePresentation $source LNil))
                (let $trace (gslt:collection-handoff:trace $path $schema)
                  (Some (PreparedCollectionMatch $source (ScopedMatcherAnswer $assignment $trace) $events))))
              ((Some (RecursivePresentation $source (LCons $unused $remaining))) None))))))))))
