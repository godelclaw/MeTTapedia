; Finite strategy for the existing modal mu-calculus Formula encoding.
; NativeBox is universal over outgoing edges carrying the selected action.
; Budget is a structural preflight allowance, not a retained evaluator cursor.

(: native:mu:member (-> Atom Atom %Undefined%))
(= (native:mu:member $item $items)
  (case $items
    ((LNil 0)
     ((LCons $head $tail)
      (if (== $item $head) 1 (native:mu:member $item $tail))))))
(: native:mu:length (-> Atom %Undefined%))
(= (native:mu:length $items)
  (case $items
    ((LNil 0)
     ((LCons $head $tail) (+ 1 (native:mu:length $tail))))))
(: native:mu:nth (-> Atom Atom %Undefined%))
(= (native:mu:nth $index $items)
  (case $items
    ((LNil LNil)
     ((LCons $head $tail)
      (if (== $index 0) $head (let $next (- $index 1) (native:mu:nth $next $tail)))))))
(: native:mu:subset (-> Atom Atom %Undefined%))
(= (native:mu:subset $items $universe)
  (case $items
    ((LNil 1)
     ((LCons $head $tail)
      (if (== (native:mu:member $head $universe) 1)
        (native:mu:subset $tail $universe) 0)))))
(: native:mu:distinct (-> Atom %Undefined%))
(= (native:mu:distinct $items)
  (case $items
    ((LNil 1)
     ((LCons $head $tail)
      (if (== (native:mu:member $head $tail) 1) 0 (native:mu:distinct $tail))))))
(: native:mu:env-valid (-> Atom Atom %Undefined%))
(= (native:mu:env-valid $environment $universe)
  (case $environment
    ((LNil 1)
     ((LCons $states $tail)
      (if (== (native:mu:subset $states $universe) 1)
        (native:mu:env-valid $tail $universe) 0)))))
(: native:mu:edges-valid (-> Atom Atom %Undefined%))
(= (native:mu:edges-valid $edges $universe)
  (case $edges
    ((LNil 1)
     ((LCons (NativeEdge $source $action $target) $tail)
      (if (== (native:mu:member $source $universe) 1)
        (if (== (native:mu:member $target $universe) 1)
          (native:mu:edges-valid $tail $universe) 0) 0)))))

(: native:mu:positive (-> Atom Atom Atom %Undefined%))
(= (native:mu:positive $formula $index $polarity)
  (case $formula
    ((NativeTop 1)
     (NativeBottom 1)
     ((NativeVar $variable) (if (== $variable $index) $polarity 1))
     ((NativeNeg $inner) (let $next (- 1 $polarity) (native:mu:positive $inner $index $next)))
     ((NativeConj $left $right)
      (if (== (native:mu:positive $left $index $polarity) 1)
        (native:mu:positive $right $index $polarity) 0))
     ((NativeDisj $left $right)
      (if (== (native:mu:positive $left $index $polarity) 1)
        (native:mu:positive $right $index $polarity) 0))
     ((NativeDiamond $action $inner) (native:mu:positive $inner $index $polarity))
     ((NativeBox $action $inner) (native:mu:positive $inner $index $polarity))
     ((NativeMu $inner) (let $next (+ $index 1) (native:mu:positive $inner $next $polarity)))
     ((NativeNu $inner) (let $next (+ $index 1) (native:mu:positive $inner $next $polarity))))))
; Membership in the finite ordinal accepts exact natural slots only.
(: native:mu:index-valid (-> Atom Atom %Undefined%))
(= (native:mu:index-valid $index $depth)
  (if (== $depth 0) 0
    (let $last (- $depth 1)
      (if (== $index $last) 1 (native:mu:index-valid $index $last)))))
(: native:mu:formed (-> Atom Atom %Undefined%))
(= (native:mu:formed $formula $depth)
  (case $formula
    ((NativeTop 1)
     (NativeBottom 1)
     ((NativeVar $index) (native:mu:index-valid $index $depth))
     ((NativeNeg $inner) (native:mu:formed $inner $depth))
     ((NativeConj $left $right)
      (if (== (native:mu:formed $left $depth) 1) (native:mu:formed $right $depth) 0))
     ((NativeDisj $left $right)
      (if (== (native:mu:formed $left $depth) 1) (native:mu:formed $right $depth) 0))
     ((NativeDiamond $action $inner) (native:mu:formed $inner $depth))
     ((NativeBox $action $inner) (native:mu:formed $inner $depth))
     ((NativeMu $inner)
      (if (== (native:mu:positive $inner 0 1) 1) (let $next (+ $depth 1) (native:mu:formed $inner $next)) 0))
     ((NativeNu $inner)
      (if (== (native:mu:positive $inner 0 1) 1) (let $next (+ $depth 1) (native:mu:formed $inner $next)) 0)))))
(: native:mu:budget (-> Atom Atom %Undefined%))
(= (native:mu:budget $formula $card)
  (case $formula
    ((NativeTop 1)
     (NativeBottom 1)
     ((NativeVar $index) 1)
     ((NativeNeg $inner) (+ 1 (native:mu:budget $inner $card)))
     ((NativeConj $left $right) (+ 1 (+ (native:mu:budget $left $card) (native:mu:budget $right $card))))
     ((NativeDisj $left $right) (+ 1 (+ (native:mu:budget $left $card) (native:mu:budget $right $card))))
     ((NativeDiamond $action $inner) (+ 1 (native:mu:budget $inner $card)))
     ((NativeBox $action $inner) (+ 1 (native:mu:budget $inner $card)))
     ((NativeMu $inner) (+ 1 (* $card (native:mu:budget $inner $card))))
     ((NativeNu $inner) (+ 1 (* $card (native:mu:budget $inner $card)))))))

; Set results use the declared universe order; repeated graph edges do not
; create extra state-set members.
(: native:mu:choose (-> Atom Atom Atom %Undefined%))
(= (native:mu:choose $selected $item $tail)
  (if (== $selected 1) (LCons $item $tail) $tail))
(: native:mu:set-operation (-> Atom Atom Atom Atom %Undefined%))
(= (native:mu:set-operation $operation $universe $left $right)
  (case $universe
    ((LNil LNil)
     ((LCons $item $rest)
      (let* (($inLeft (native:mu:member $item $left))
             ($inRight (native:mu:member $item $right))
             ($tail (native:mu:set-operation $operation $rest $left $right))
             ($take (case $operation
               ((NativeIntersection (if (== $inLeft 1) $inRight 0))
                (NativeUnion (if (== $inLeft 1) 1 $inRight))
                (NativeDifference (if (== $inLeft 1) (- 1 $inRight) 0))))))
        (native:mu:choose $take $item $tail))))))
(: native:mu:edge-test (-> Atom Atom Atom Atom Atom %Undefined%))
(= (native:mu:edge-test $universal $edges $source $action $targets)
  (case $edges
    ((LNil $universal)
     ((LCons (NativeEdge $from $label $to) $rest)
      (if (== $source $from)
        (if (== $action $label)
          (let $member (native:mu:member $to $targets)
            (if (== $member $universal)
              (native:mu:edge-test $universal $rest $source $action $targets)
              (- 1 $universal)))
          (native:mu:edge-test $universal $rest $source $action $targets))
        (native:mu:edge-test $universal $rest $source $action $targets))))))
(: native:mu:modal (-> Atom Atom Atom Atom Atom %Undefined%))
(= (native:mu:modal $universal $universe $edges $action $targets)
  (case $universe
    ((LNil LNil)
     ((LCons $source $rest)
      (let* (($take (native:mu:edge-test $universal $edges $source $action $targets))
             ($tail (native:mu:modal $universal $rest $edges $action $targets)))
        (native:mu:choose $take $source $tail))))))
(: native:mu:iterate (-> Atom Atom Atom Atom Atom Atom Atom %Undefined%))
(= (native:mu:iterate $remaining $body $universe $edges $environment $states $card)
  (if (== $remaining 0) $states
    (let $next (native:mu:evaluate $body $universe $edges (LCons $states $environment) $card)
      (let $rest (- $remaining 1) (native:mu:iterate $rest $body $universe $edges $environment $next $card)))))
(: native:mu:evaluate (-> Atom Atom Atom Atom Atom %Undefined%))
(= (native:mu:evaluate $formula $universe $edges $environment $card)
  (case $formula
    ((NativeTop $universe)
     (NativeBottom LNil)
     ((NativeVar $index)
      (let $states (native:mu:nth $index $environment)
        (native:mu:set-operation NativeIntersection $universe $universe $states)))
     ((NativeNeg $inner)
      (let $states (native:mu:evaluate $inner $universe $edges $environment $card)
        (native:mu:set-operation NativeDifference $universe $universe $states)))
     ((NativeConj $left $right)
      (let* (($first (native:mu:evaluate $left $universe $edges $environment $card))
             ($second (native:mu:evaluate $right $universe $edges $environment $card)))
        (native:mu:set-operation NativeIntersection $universe $first $second)))
     ((NativeDisj $left $right)
      (let* (($first (native:mu:evaluate $left $universe $edges $environment $card))
             ($second (native:mu:evaluate $right $universe $edges $environment $card)))
        (native:mu:set-operation NativeUnion $universe $first $second)))
     ((NativeDiamond $action $inner)
      (let $targets (native:mu:evaluate $inner $universe $edges $environment $card)
        (native:mu:modal 0 $universe $edges $action $targets)))
     ((NativeBox $action $inner)
      (let $targets (native:mu:evaluate $inner $universe $edges $environment $card)
        (native:mu:modal 1 $universe $edges $action $targets)))
     ((NativeMu $body) (native:mu:iterate $card $body $universe $edges $environment LNil $card))
     ((NativeNu $body) (native:mu:iterate $card $body $universe $edges $environment $universe $card)))))

(: native:mu:check (-> Atom Atom Atom Atom Atom Atom %Undefined%))
(= (native:mu:check $formula $universe $edges $environment $budget $state)
  (let* (($card (native:mu:length $universe))
         ($depth (native:mu:length $environment)))
    (if (== (native:mu:distinct $universe) 1)
      (if (== (native:mu:member $state $universe) 1)
        (if (== (native:mu:edges-valid $edges $universe) 1)
          (if (== (native:mu:env-valid $environment $universe) 1)
            (if (== (native:mu:formed $formula $depth) 1)
              (if (< $budget (native:mu:budget $formula $card)) NativeUnknown
                (let $result (native:mu:evaluate $formula $universe $edges $environment $card)
                  (if (== (native:mu:member $state $result) 1) NativeProved NativeRefuted)))
              NativeRejected)
            NativeRejected)
          NativeRejected)
        NativeRejected)
      NativeRejected)))
