/-
Prints `tests/petta/gslt_descent_controls.metta`. Every expected readout is the Lean scheduled
machine's (`StructuralDescent.Scheduled`): the answers of the drained search at a root goal, and
whether a branch was cut by depth.
Run from `lean/mettapedia`: `lake env lean ../../metta/gslt/tools/generate_descent_controls.lean`.
-/
import Mettapedia.OSLF.MeTTaIL.Complete.ClassesControls
import Mettapedia.Languages.MeTTa.PeTTa.Bridges.MeTTaIL.GeneralProgramDriverExecution

open Mettapedia.OSLF.MeTTaIL Syntax
open Mettapedia.GSLT.LanguageDef CettaWire InferenceCettaWire
open Mettapedia.Languages.MeTTa.PeTTa.Bridges.MeTTaIL
open PremiseOperationsExecution.GeneralExecution (eventsTerm traceTerm)
open StructuralDescent.Scheduled (Goal Result)

def render (term : Term) : String := Term.render term
def assignment (value : ScopedRuleMatching.Assignment) : Term := RuleInstantiationExecution.ScopedCapture.scopedAssignmentTerm value

def answerTerm {environment : GeneralPremise.Environment} {goal : Goal} : Result environment goal → Term
  | .premise completed event _ =>
      .application "PremiseAnswer" [assignment completed, PremiseOperationsExecution.GeneralExecution.eventTerm event]
  | .premises completed events _ => .application "PremisesAnswer" [assignment completed, eventsTerm events]
  | .quantified completed events _ =>
      .application "QuantifiedAnswer" [assignment completed, PremiseOperationsExecution.GeneralExecution.quantifiedEventsTerm events]
  | .root trace captured completed events target _ => .application "RootAnswer"
      [traceTerm trace, assignment captured, assignment completed, eventsTerm events, encodePattern target]
  | .steps index trace captured completed events target _ _ => .application "StepsAnswer"
      [.natural index, traceTerm trace, assignment captured, assignment completed, eventsTerm events, encodePattern target]

def cutTerm (unresolved : List StructuralDescent.Scheduled.Obligation) : Term :=
  .symbol (if unresolved.any (fun | .depthExhausted _ => true | _ => false) then "True" else "False")

def rootGoalTerm (depth : Nat) (bound : List TypeExpr) (type : TypeExpr) (source : Pattern) (index : Nat) : Term :=
  .application "DescentRootGoal" [.natural depth, CettaWire.encodeList AuthoredRule.typeTerm bound, AuthoredRule.typeTerm type,
    encodePattern source, .natural index]

def descentControl (label : String) (plan : GeneralExecutionAdmission.Plan) (type : TypeExpr) (source : Pattern)
    (depth index : Nat) : String :=
  let environment := GeneralPlanEnvironment.environment plan
  let goal : Goal := .root depth [] type source index
  let finished := StructuralDescent.Scheduled.finish environment goal
  let fuel := (StructuralDescent.Scheduled.treeStart environment goal).cost
  let expected := Term.application "DescentReadout" [CettaWire.encodeList answerTerm finished.answers, cutTerm finished.unresolved]
  "!(let* (($g (gslt:descent:start " ++ render (rootGoalTerm depth [] type source index) ++ "))\n" ++
  "        ($s (gslt:descent:run " ++ render (GeneralProgramDriverExecution.environmentTerm plan source) ++ " " ++
    toString fuel ++ " $g))\n" ++
  "        ($r (gslt:descent:readout $s)))\n" ++
  "  (println! (DescentControl " ++ reprStr label ++ " (== $r (quote " ++ render expected ++ ")))))"

def term : TypeExpr := .base "Term"

def main : IO Unit := do
  IO.println "; Generated by tools/generate_descent_controls.lean. Expected readouts are the Lean scheduled machine's."
  for depth in [0, 1, 2, 3, 4] do
    for index in [0, 1, 2, 3] do
      IO.println (descentControl s!"lambda-nested-d{depth}-r{index}" Complete.Controls.lambdaPlan term
        StructuralDescent.Controls.nestedRedex depth index)
  for depth in [1, 2, 3] do
    for index in [0, 1, 2, 3] do
      IO.println (descentControl s!"lambda-two-steps-d{depth}-r{index}" Complete.Controls.lambdaPlan term
        Complete.Controls.twoSteps depth index)
  for depth in [1, 2, 3, 4] do
    for index in [0, 1, 2, 3, 4] do
      IO.println (descentControl s!"letcase-nested-d{depth}-r{index}" Complete.Controls.letCasePlan
        Mettapedia.OSLF.NativeTypes.Instances.LetCase.computation StructuralDescent.Controls.LetCaseControls.nested depth index)
  for index in [0, 1, 2, 3, 4, 5] do
    IO.println (descentControl s!"partrec-d1-r{index}" StructuralDescent.Controls.partrecPlan (.base "Cfg")
      StructuralDescent.Controls.partrecStart 1 index)

#eval main
