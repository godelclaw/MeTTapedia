/-
Prints `tests/petta/gslt_descent_state_controls.metta`. Each control runs the scheduled descent
machine for some fuel from a root goal and compares the whole MeTTa state, agenda, answers,
obligations and work, with the encoded Lean state (`CompleteExecution.DescentCodec.stateTerm`).
Run from `lean/mettapedia`: `lake env lean ../../metta/gslt/tools/generate_descent_state_controls.lean`.
-/
import Mettapedia.OSLF.MeTTaIL.Complete.ClassesControls
import Mettapedia.Languages.MeTTa.PeTTa.Bridges.MeTTaIL.CompleteExecution.DescentCodec
import Mettapedia.Languages.MeTTa.PeTTa.Bridges.MeTTaIL.GeneralProgramDriverExecution

open Mettapedia.OSLF.MeTTaIL Syntax
open Mettapedia.GSLT.LanguageDef CettaWire InferenceCettaWire
open Mettapedia.Languages.MeTTa.PeTTa.Bridges.MeTTaIL
open StructuralDescent.Scheduled (Goal)

def render (term : Term) : String := Term.render term

def stateControl (label : String) (plan : GeneralExecutionAdmission.Plan) (type : TypeExpr) (source : Pattern)
    (depth index fuel : Nat) : String :=
  let environment := GeneralPlanEnvironment.environment plan
  let goal : Goal := .root depth [] type source index
  let state := StructuralDescent.Scheduled.run environment goal fuel (StructuralDescent.Scheduled.start environment goal)
  "!(let* (($b (gslt:descent:start " ++ render (CompleteExecution.DescentCodec.goalTerm goal) ++ "))\n" ++
  "        ($s (gslt:descent:run " ++ render (GeneralProgramDriverExecution.environmentTerm plan source) ++ " " ++
    toString fuel ++ " $b)))\n" ++
  "  (println! (DescentStateControl " ++ reprStr label ++ " (== $s (quote " ++
    render (CompleteExecution.DescentCodec.stateTerm state) ++ ")))))"

def term : TypeExpr := .base "Term"

def main : IO Unit := do
  IO.println "; Generated by tools/generate_descent_state_controls.lean. Expected states are the Lean machine's."
  for fuel in [0, 1, 2, 3, 5, 8, 13, 21, 40, 80] do
    IO.println (stateControl s!"lambda-nested-d3-r1-f{fuel}" Complete.Controls.lambdaPlan term
      StructuralDescent.Controls.nestedRedex 3 1 fuel)
  for fuel in [4, 16, 64] do
    IO.println (stateControl s!"lambda-two-steps-d2-r0-f{fuel}" Complete.Controls.lambdaPlan term
      Complete.Controls.twoSteps 2 0 fuel)
  for fuel in [4, 16, 64] do
    IO.println (stateControl s!"letcase-nested-d2-r1-f{fuel}" Complete.Controls.letCasePlan
      Mettapedia.OSLF.NativeTypes.Instances.LetCase.computation StructuralDescent.Controls.LetCaseControls.nested 2 1 fuel)
  for fuel in [3, 10, 30] do
    IO.println (stateControl s!"partrec-d1-r2-f{fuel}" StructuralDescent.Controls.partrecPlan (.base "Cfg")
      StructuralDescent.Controls.partrecStart 1 2 fuel)
  for fuel in [2, 10] do
    IO.println (stateControl s!"lambda-depth0-f{fuel}" Complete.Controls.lambdaPlan term
      StructuralDescent.Controls.nestedRedex 0 0 fuel)

#eval main
