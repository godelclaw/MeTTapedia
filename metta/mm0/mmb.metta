(: mm0:mmb:resolve-statements (-> Atom Atom Atom Number Number Number Atom Atom %Undefined%))
(= (mm0:mmb:resolve-statements $source $resolver
       (MM0:MMBTables (MM0:L $sorts) (MM0:L $terms) (MM0:L $theorems))
       $ns $nt $nh (MM0:L $statements) (MM0:L $commands))
   (case $statements
     ((() (if (and (== $ns (size-atom $sorts))
                    (and (== $nt (size-atom $terms)) (== $nh (size-atom $theorems))))
             (let $ordered (reverse $commands)
               (Some (MM0:MMBProgram MM0:MMBBinaryV1 $resolver (MM0:L $ordered) $source)))
             None))
      ((cons (MM0:MMBStatement $opcode $local $start $after $proof) $rest)
       (let* (($tables (MM0:MMBTables (MM0:L $sorts) (MM0:L $terms) (MM0:L $theorems)))
              ($resolved (case $opcode
                ((4 (if (and (== $local False) (== $proof (MM0:L ())))
                      (let* (($info (mm0:data-at (MM0:L $sorts) $ns))
                             ($introduced (mm0:mmb:introduce $resolver MM0:MMUSort $ns False)))
                        (case ($info $introduced)
                          ((((Some $profile) (Some (MM0:MMUIntroduced $next $id $expected)))
                            (Some (MM0:MMUResolved $next
                              (MM0:L (MM0:ProofDeclaration False (MM0:L (MM0:AdmitSort $id $profile)))))))
                           ($bad None))))
                      None))
                 (5 (if (== $local False) (mm0:mmb:resolve-term $resolver $tables $nt False $proof) None))
                 (13 (if (== $local True) (mm0:mmb:resolve-term $resolver $tables $nt True $proof) None))
                 (2 (if (== $local False) (mm0:mmb:resolve-assertion $resolver $tables $nh False True $proof) None))
                 (6 (if (== $local False) (mm0:mmb:resolve-assertion $resolver $tables $nh False False $proof) None))
                 (14 (if (== $local True) (mm0:mmb:resolve-assertion $resolver $tables $nh True False $proof) None))
                 ($bad None)))))
         (case $resolved
           (((Some (MM0:MMUResolved $next $command))
             (let* (($nextSort (if (== $opcode 4) (+ $ns 1) $ns))
                    ($nextTerm (if (is-member $opcode (5 13)) (+ $nt 1) $nt))
                    ($nextTheorem (if (is-member $opcode (2 6 14)) (+ $nh 1) $nh))
                    ($accumulated (cons $command $commands)))
               (mm0:mmb:resolve-statements $source $next $tables $nextSort $nextTerm $nextTheorem
                 (MM0:L $rest) (MM0:L $accumulated))))
            ($bad None)))))
      ($bad None))))
