(: mm0:mmb:proof-step (-> Atom Atom Atom Atom Atom Atom %Undefined%))
(= (mm0:mmb:proof-step $resolver $tables $formal $mode $state
       (MM0:MMBCode $opcode $data $start $after))
   (if (or (== $mode MM0:MMBAssertion)
         (and (== $mode MM0:MMBDefinition) (is-member $opcode (16 17 18 19 31))))
     (case $opcode
       ((16 (mm0:mmb:proof-term $resolver $tables $state $data False))
        (17 (mm0:mmb:proof-term $resolver $tables $state $data True))
        (18 (mm0:mmb:proof-reference $state $data))
        (19 (mm0:mmb:proof-dummy $resolver $state $data))
        (20 (mm0:mmb:proof-theorem $resolver $tables $formal $state $data False))
        (21 (mm0:mmb:proof-theorem $resolver $tables $formal $state $data True))
        (22 (mm0:mmb:proof-hypothesis $state))
        (23 (mm0:mmb:proof-conversion $state))
        (24 (mm0:mmb:proof-reflexivity $state))
        (25 (mm0:mmb:proof-symmetry $state))
        (26 (mm0:mmb:proof-congruence $resolver $state))
        (27 (mm0:mmb:proof-unfold $resolver $tables $formal $state))
        (28 (mm0:mmb:proof-cut $state))
        (30 (mm0:mmb:proof-save $state True))
        (31 (mm0:mmb:proof-save $state False))
