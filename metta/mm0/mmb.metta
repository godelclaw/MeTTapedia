                      ($bad None))))
                  ($bad None)))))
            ($bad None))))
        ($bad None)))))
(: mm0:mmb:resolve-assertion (-> Atom Atom Number Atom Atom Atom %Undefined%))
(= (mm0:mmb:resolve-assertion $resolver (MM0:MMBTables $sorts $terms $theorems) $binary $local $isAxiom $codes)
   (case (mm0:data-at $theorems $binary)
     (((Some $entry)
