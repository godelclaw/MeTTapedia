         (((Some $after) (mm0:mmb:proof-run $resolver $tables $formal $mode $after (MM0:L $rest)))
          ($bad None))))
      ($bad None))))

(: mm0:mmb:resolve-term (-> Atom Atom Number Atom Atom %Undefined%))
(= (mm0:mmb:resolve-term $resolver (MM0:MMBTables $sorts $terms $theorems) $binary $local $codes)
   (case (mm0:data-at $terms $binary)
     (((Some (MM0:MMBTerm $sort $arguments $ret $value))
       (let* (($tables (MM0:MMBTables $sorts $terms $theorems))
              ($entry (MM0:MMBTerm $sort $arguments $ret $value))
              ($context (mm0:mmb:context $resolver $arguments))
              ($kind (case $value (((Some $unify) MM0:MMUDefinition) (None MM0:MMUTerm) ($bad MM0:Malformed))))
              ($introduced (mm0:mmb:introduce $resolver $kind $binary $local)))
         (case ($context $introduced)
           ((((Some (MM0:MMBContext $ctx $bound)) (Some (MM0:MMUIntroduced $after $index $expected)))
             (let $contextData (MM0:MMBContext $ctx $bound)
               (case (mm0:mmb:term-signature $resolver $contextData $entry)
                 (((Some $signature)
                   (case $value
                     ((None
                       (if (== $codes (MM0:L ()))
                         (Some (MM0:MMUResolved $after
                           (MM0:L (MM0:ProofDeclaration $local (MM0:L (MM0:AdmitTerm $index $signature))))))
                         None))
