; Scalar operations and list views used by the authored MM0 equations.
; MM0:L wraps list data; constructor expressions retain their own heads.
(: mm0:make-var (-> Number %Undefined%))
(= (mm0:make-var $index) (MM0:Var $index))
(: mm0:make-term (-> Number %Undefined%))
(= (mm0:make-term $index) (MM0:Term $index))
(: mm0:make-app (-> Atom Atom %Undefined%))
(= (mm0:make-app $function $argument) (MM0:App $function $argument))
(: mm0:list-view (-> Atom %Undefined%))
(= (mm0:list-view (MM0:L $items))
   (case $items
     ((() List:Nil)
      ((cons $first $rest) (List:Cons $first (MM0:L $rest))))))
(: mm0:list-cons (-> Atom Atom %Undefined%))
(= (mm0:list-cons $first $tail)
   (case ($first $tail)
     ((($item (MM0:L $rest))
       (let $items (cons $item $rest) (MM0:L $items)))
      (((MM0:L ($key $value)) (MM0:Table $space))
       (let $done (add-atom $space ($key $value)) (MM0:Table $space))))))

; Tables are private append-only spaces. Duplicate admission is checked before
; publication; checking reads the preceding theory without mutating it.
(: mm0:nat-table-get (-> Atom Number %Undefined%))
(= (mm0:nat-table-get $table $key)
   (case $table
     (((MM0:Table $space)
       (let $found (collapse (match $space ($key $value) $value))
         (case $found ((() None) (($value) (Some $value))
                       ($duplicates MM0:Malformed)))))
      ((MM0:L $entries) (mm0:table-scan $entries $key)))))
(: mm0:table-scan (-> Atom Number %Undefined%))
(= (mm0:table-scan $entries $key)
   (case $entries
     ((() None)
      ((cons (MM0:L ($stored $value)) $rest)
       (if (== $key $stored) (Some $value) (mm0:table-scan $rest $key))))))
(: mm0:declaration (-> Atom Number %Undefined%))
(= (mm0:declaration $table $index) (mm0:nat-table-get $table $index))

(: mm0:data-at (-> Atom Number %Undefined%))
(= (mm0:data-at $items $index)
   (case $items
     (((MM0:L $values)
       (if (< $index (size-atom $values))
           (let $value (index-atom $values $index) (Some $value)) None))
      ((MM0:Vector $space $size)
       (if (< $index $size)
         (let $found (collapse (match $space ($index $value) $value))
           (case $found ((($value) (Some $value)) ($bad MM0:Malformed))))
         None)))))

(: mm0:vector (-> Atom %Undefined%))
(= (mm0:vector (MM0:L $items))
   (let $space (get-state mm0-proof-store)
     (let $cleared (mm0:clear-space $space ($reset0 $reset1))
       (mm0:vector-load $space $items 0 (size-atom $items)))))
(: mm0:vector-load (-> Atom Atom Number Number %Undefined%))
(= (mm0:vector-load $space $items $index $size)
   (if (< $index $size)
     (let $value (index-atom $items $index)
       (let $done (add-atom $space ($index $value))
         (mm0:vector-load $space $items (+ $index 1) $size)))
     (MM0:Vector $space $size)))
(: mm0:vector-snoc (-> Atom Atom %Undefined%))
(= (mm0:vector-snoc (MM0:Vector $space $size) $value)
   (let $done (add-atom $space ($size $value))
     (MM0:Vector $space (+ $size 1))))

(: mm0:clear-space (-> Atom Atom %Undefined%))
(= (mm0:clear-space $space $pattern)
   (let $removed (remove-atom $space $pattern) True))
(: mm0:remove-rows (-> Atom Atom Number Number %Undefined%))
(= (mm0:remove-rows $space $rows $index $size)
   (if (< $index $size)
     (let $row (index-atom $rows $index)
       (let $removed (remove-atom $space $row)
         (mm0:remove-rows $space $rows (+ $index 1) $size)))
     True))
(: mm0:data-eq (-> Atom Atom %Undefined%))
(= (mm0:data-eq $first $second) (== $first $second))

; The term signature cannot change during a declaration's checks. The cache
; is renewed before the next declaration, including after a failed check.
(: mm0:infer (-> Atom Atom Atom %Undefined%))
(= (mm0:infer $terms $ctx $expression)
   (let $cache (get-state mm0-inference-cache)
     (let $found (collapse (match $cache ($terms $ctx $expression $value) $value))
       (case $found
         ((() (let $value (mm0:infer-uncached $terms $ctx $expression)
                (let $done (add-atom $cache ($terms $ctx $expression $value)) $value)))
          (($value) $value)
          ($bad MM0:Malformed))))))
(: mm0:nat-zero (-> Number %Undefined%))
(= (mm0:nat-zero $n) (== $n 0))
(: mm0:nat-pred (-> Number %Undefined%))
(= (mm0:nat-pred $n) (if (== $n 0) 0 (- $n 1)))
(: mm0:nat-add (-> Number Number %Undefined%))
(= (mm0:nat-add $a $b) (+ $a $b))
(: mm0:nat-monus (-> Number Number %Undefined%))
(= (mm0:nat-monus $a $b) (if (< $a $b) 0 (- $a $b)))
(: mm0:nat-max (-> Number Number %Undefined%))
(= (mm0:nat-max $a $b) (if (< $a $b) $b $a))
(: mm0:nat-le (-> Number Number %Undefined%))
(= (mm0:nat-le $a $b) (<= $a $b))
(: mm0:nat-lt (-> Number Number %Undefined%))
(= (mm0:nat-lt $a $b) (< $a $b))
(: mm0:nat-eq (-> Number Number %Undefined%))
(= (mm0:nat-eq $a $b) (== $a $b))
(: mm0:nat-mul (-> Number Number %Undefined%))
(= (mm0:nat-mul $a $b) (* $a $b))
(: mm0:nat-div (-> Number Number %Undefined%))
(= (mm0:nat-div $a $b) (// $a $b))
(: mm0:nat-mod (-> Number Number %Undefined%))
(= (mm0:nat-mod $a $b) (% $a $b))
