import Mettapedia.GraphTheory.Hypermap.Basic

/-!
# Connectivity of finite hypermaps

Component counts depend only on the permutations and their composite law.
This low-level API does not depend on gluing, genus, or a graph presentation.
-/

namespace Mettapedia.GraphTheory.Hypermap

open FourColor.GoertzelV24WordReachability FourColor.GoertzelV24PermutationOrbitSurgery

variable {D : Type*} [Fintype D] [DecidableEq D]

/-! ## Components -/

/-- The number of connected components: orbits of the group generated by all
three permutations. -/
noncomputable def compCount (H : Hypermap D) : ℕ :=
  wordOrbitCount [H.edge, H.node, H.face]

theorem eulerRhs_eq_card_add_two_mul_compCount (H : Hypermap D) :
    eulerRhs H = Fintype.card D + 2 * compCount H := rfl

theorem eulerLhs_eq_orbit_sum (H : Hypermap D) :
    eulerLhs H = orbitCount H.edge + orbitCount H.node + orbitCount H.face := rfl

/-- **The node permutation is redundant for connectivity.**  The composite law
makes `node` a word in `face` and `edge`, so dropping it changes nothing.  This
is what lets the pair-shaped disjoint-union laws apply to hypermaps. -/
theorem compCount_eq_pair (H : Hypermap D) :
    compCount H = wordOrbitCount [H.face, H.edge] := by
  have hEmem : H.edge ∈ [H.edge, H.node, H.face] := List.mem_cons_self
  have hFmem : H.face ∈ [H.edge, H.node, H.face] :=
    List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self)
  show wordOrbitCount [H.edge, H.node, H.face] = wordOrbitCount [H.face, H.edge]
  refine le_antisymm ?_ ?_
  · -- the pair sits inside the full family
    refine wordOrbitCount_le_of_le (fun u v huv => ?_)
    refine wordReachable_mono ?_ huv
    intro g hg
    rcases List.mem_cons.mp hg with rfl | hg1
    · exact hFmem
    rcases List.mem_cons.mp hg1 with rfl | hg2
    · exact hEmem
    · simp at hg2
  · -- and conversely every step of the full family is a walk in the pair
    refine wordOrbitCount_le_of_le (fun u v huv => ?_)
    refine wordReachable_absorb ?_ huv
    intro g hg z
    have hF : ∀ w : D, WordReachable [H.face, H.edge] w (H.face w) :=
      fun w => wordReachable_step List.mem_cons_self w
    have hE : ∀ w : D, WordReachable [H.face, H.edge] w (H.edge w) :=
      fun w => wordReachable_step (List.mem_cons_of_mem _ List.mem_cons_self) w
    rcases List.mem_cons.mp hg with rfl | hg1
    · exact hE z
    rcases List.mem_cons.mp hg1 with rfl | hg2
    · -- the node step is a face step after an edge step, reversed
      have hback : H.face (H.edge (H.node z)) = z :=
        H.node.injective (H.cancel3 (H.node z))
      have hchain : WordReachable [H.face, H.edge] (H.node z) z := by
        have h1 := hE (H.node z)
        have h2 := hF (H.edge (H.node z))
        rw [hback] at h2
        exact h1.trans h2
      exact hchain.symm
    rcases List.mem_cons.mp hg2 with rfl | hg3
    · exact hF z
    · simp at hg3


/-- Rotation and edge steps generate the same components as the three
hypermap permutations. No vertex-cyclicity or connectedness assumption is needed. -/
theorem ofRotationSystem_reachable_iff
    {V E : Type*} [Fintype V] [DecidableEq V] [Fintype E] [DecidableEq E]
    (RS : FourColor.RotationSystem V E) (x y : RS.D) :
    WordReachable [(ofRotationSystem RS).edge, (ofRotationSystem RS).node,
      (ofRotationSystem RS).face] x y ↔ WordReachable [RS.rho, RS.alpha] x y := by
  constructor
  · apply wordReachable_absorb
    intro g hg d
    simp only [ofRotationSystem_edge, ofRotationSystem_node, ofRotationSystem_face,
      List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl | rfl
    · exact wordReachable_step (by simp) d
    · have h := (wordReachable_step (L := [RS.rho, RS.alpha])
        (g := RS.rho) (by simp) (RS.rho⁻¹ d)).symm
      simpa using h
    · exact (wordReachable_step (L := [RS.rho, RS.alpha])
        (g := RS.alpha) (by simp) d).trans
        (wordReachable_step (g := RS.rho) (by simp) (RS.alpha d))
  · apply wordReachable_absorb
    intro g hg d
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hg
    rcases hg with rfl | rfl
    · have h := (wordReachable_step
        (L := [(ofRotationSystem RS).edge, (ofRotationSystem RS).node,
          (ofRotationSystem RS).face])
        (g := RS.rho⁻¹) (by simp) (RS.rho d)).symm
      simpa using h
    · exact wordReachable_step (by simp) d

theorem compCount_ofRotationSystem
    {V E : Type*} [Fintype V] [DecidableEq V] [Fintype E] [DecidableEq E]
    (RS : FourColor.RotationSystem V E) :
    compCount (ofRotationSystem RS) = wordOrbitCount [RS.rho, RS.alpha] := by
  unfold compCount wordOrbitCount
  exact Fintype.card_congr (Quotient.congr (Equiv.refl RS.D)
    (ofRotationSystem_reachable_iff RS))

end Mettapedia.GraphTheory.Hypermap
