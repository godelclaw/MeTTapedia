def upperEmpty : Fin 15 → Fin 7 :=
  ![6,6,6,4,4,6,6,6,6,6,6,6,6,3,3]

def upperLists (word : Fin 11 → Color) (v : Fin 7) : Finset Color :=
  Finset.univ.filter fun c => ∀ i : Fin 11,
    upper.graph.Adj (upperVertex v) (i.castAdd 7) → c ≠ word i

theorem upper_traces_valid : ∀ i : Fin 15,
    (∀ e ∈ upperTrace i, (core false).Adj e.1 e.2) ∧
    run (upperLists (upperWord i)) (upperTrace i) (upperEmpty i) = ∅ := by
  decide +kernel

theorem upper_no_extension (i : Fin 15) (C : upper.graph.Coloring Color)
    (boundary : ∀ j : Fin 11, C (j.castAdd 7) = upperWord i j) : False := by
  let D : (core false).Coloring Color :=
    .mk (fun v => C (upperVertex v)) (fun h => C.valid h)
  have fits (v : Fin 7) : D v ∈ upperLists (upperWord i) v := by
    simp only [upperLists, Finset.mem_filter, Finset.mem_univ, true_and]
    intro j hj
    change C (upperVertex v) ≠ upperWord i j
    simpa only [boundary j] using C.valid hj
  exact empty_refutes (upperLists (upperWord i)) (upperTrace i)
    (upper_traces_valid i).1 (upperEmpty i) (upper_traces_valid i).2 ⟨D, fits⟩

