def rows (r : Fin 84) : List (List ℕ) := NearLinearDiamondData.rows (source r)
def header (r : Fin 84) : List ℕ := (rows r).headD []
def size (r : Fin 84) : ℕ := (header r).getD 0 0
abbrev Vertex (r : Fin 84) := Fin (size r)
def row (r : Fin 84) (v : Vertex r) : List ℕ := (rows r).getD (v.val + 1) []
def lower (r : Fin 84) (v : Vertex r) : ℕ := (row r v).getD 1 0
def upper (r : Fin 84) (v : Vertex r) : ℕ := (row r v).getD 2 0
def neighbors (r : Fin 84) (v : Vertex r) : List ℕ := (row r v).drop 3
def amount (r : Fin 84) : ℕ := (header r).getD 3 0

theorem headers : ∀ r : Fin 84, 2 ≤ size r ∧ size r ≤ 12 ∧
    (header r).getD 1 0 = 1 ∧ (header r).getD 2 0 = 2 ∧ 0 < amount r := by
  intro r
  fin_cases r <;> decide +kernel

def sender (r : Fin 84) : Vertex r := ⟨0, by have := (headers r).1; omega⟩
def receiver (r : Fin 84) : Vertex r := ⟨1, by have := (headers r).1; omega⟩

theorem source_valid : ∀ r : Fin 84,
    (NearLinearDiamondData.parseRows (source r)).isSome = true ∧
    (rows r).length = size r + 1 ∧ (header r).length = 4 ∧
      ∀ v : Vertex r, (row r v).getD 0 0 = v.val + 1 ∧
        5 ≤ lower r v ∧ (upper r v = 0 ∨ lower r v ≤ upper r v) ∧
        (neighbors r v).Nodup ∧
        ∀ w ∈ neighbors r v, w ≤ size r ∧ w ≠ v.val + 1 := by
  intro r
  fin_cases r <;> decide +kernel

theorem adjacency_laws : ∀ r : Fin 84,
    (∀ v w : Vertex r, w.val + 1 ∈ neighbors r v → v.val + 1 ∈ neighbors r w) ∧
    (∀ v : Vertex r, v.val + 1 ∉ neighbors r v) := by
  intro r
  fin_cases r <;> decide +kernel

def graph (r : Fin 84) : SimpleGraph (Vertex r) where
  Adj v w := w.val + 1 ∈ neighbors r v
  symm := ⟨(adjacency_laws r).1⟩
  loopless := ⟨(adjacency_laws r).2⟩

instance (r : Fin 84) : DecidableRel (graph r).Adj :=
  fun _ _ => inferInstanceAs (Decidable (_ ∈ _))

def Turn (r : Fin 84) (v w z : Vertex r) : Prop :=
  (w.val + 1, z.val + 1) ∈ (neighbors r v).zip ((neighbors r v).rotate 1)

instance (r : Fin 84) (v w z : Vertex r) : Decidable (Turn r v w z) := by
  unfold Turn; infer_instance

theorem endpoint_edge : ∀ r : Fin 84, (graph r).Adj (sender r) (receiver r) := by
  intro r
  fin_cases r <;> decide +kernel

/-- All observations lie within two steps of either endpoint; any
intermediate vertex has prescribed degree at most eight. -/
theorem local_paths : ∀ r : Fin 84, ∀ b ∈ [sender r, receiver r], ∀ v : Vertex r,
    v = b ∨ (graph r).Adj b v ∨
      ∃ w : Vertex r, (graph r).Adj b w ∧ (graph r).Adj w v ∧
        upper r w ≠ 0 ∧ upper r w ≤ 8 := by
  intro r
  fin_cases r <;> decide +kernel

/-- Every rule observes an actual prescribed degree-five vertex. -/
theorem five_witness : ∀ r : Fin 84, ∃ v : Vertex r, lower r v = 5 ∧ upper r v = 5 := by
  intro r
  fin_cases r <;> decide +kernel

theorem sender_bound : ∀ r : Fin 84,
    upper r (sender r) ≠ 0 ∧ upper r (sender r) ≤ 8 := by
  intro r
  fin_cases r <;> decide +kernel

end FourColor.NearLinearRuleData
