import MettapediaFourColor.TwoStepCoreProgress
import Mettapedia.GraphTheory.Kempe.PairHistory

/-!
# Exact source obstructions for whole fixed-pair phases

Generated by `audit_pair_phase.py`. The component labels are the
program-checked boundary observations of the spherical exteriors.
Every subset is transported by an injective palette renaming to an
earlier rejection word or one of three additional words.
No bound on the length of a fixed-pair history is being assumed.
-/

namespace FourColor.PairPhaseCore

open Color FiveTriangleCollapseObstruction TwoStepCoreProgress
open SimpleGraph.ColoringListPropagation

def pairs : Fin 6 → Color × Color := ![(c0,c1),(c0,c2),(c0,c3),(c1,c2),(c1,c3),(c2,c3)]
def tag : Color → Nat | c0 => 0 | c1 => 1 | c2 => 2 | c3 => 3
def rename (code : Nat × List Color) (c : Color) : Color := code.2.getD (tag c) c0

def extraWord : Fin 3 → Fin 11 → Color :=
  ![![c0,c1,c2,c3,c2,c0,c2,c1,c0,c3,c2],
    ![c0,c1,c2,c3,c0,c2,c0,c1,c2,c3,c2],
    ![c0,c1,c0,c2,c0,c3,c0,c1,c0,c2,c3]]

theorem extra_empty : ∀ i : Fin 3, run (upperLists (extraWord i)) (upperTrace 0) 6 = ∅ := by
  decide +kernel

theorem extra_no_extension (i : Fin 3) (C : upper.graph.Coloring Color)
    (boundary : ∀ j : Fin 11, C (j.castAdd 7) = extraWord i j) : False := by
  let D : (TwoPortCoreElimination.core false).Coloring Color :=
    .mk (fun v => C (TwoPortCoreElimination.upperVertex v)) (fun h => C.valid h)
  have fits (v : Fin 7) : D v ∈ upperLists (extraWord i) v := by
    simp only [upperLists, Finset.mem_filter, Finset.mem_univ, true_and]
    intro j hj
    change C (TwoPortCoreElimination.upperVertex v) ≠ extraWord i j
    simpa only [boundary j] using C.valid hj
  exact empty_refutes (upperLists (extraWord i)) (upperTrace 0)
    (upper_traces_valid 0).1 6 (extra_empty i) ⟨D, fits⟩

def upperReference (i : Nat) : Fin 11 → Color :=
  if h : i < 15 then upperWord ⟨i, h⟩
  else extraWord ⟨(i - 15) % 3, Nat.mod_lt _ (by decide)⟩

theorem upper_reference_rejects (i : Nat) (C : upper.graph.Coloring Color)
    (boundary : ∀ j : Fin 11, C (j.castAdd 7) = upperReference i j) : False := by
  unfold upperReference at boundary
  split at boundary
  · exact upper_no_extension _ C boundary
  · exact extra_no_extension _ C boundary

def upperBlocks : Fin 6 → Fin 11 → Nat :=
  ![![4,4,4,0,0,4,0,4,0,0,0],
    ![4,2,4,4,1,4,0,0,0,4,0],
    ![1,4,2,4,0,0,0,4,3,4,1],
    ![4,0,4,0,4,4,4,0,4,0,4],
    ![0,4,0,0,4,0,4,4,4,1,4],
    ![0,0,0,4,4,2,4,1,4,4,4]]

def upperCounts : Fin 6 → Nat := ![1,3,4,1,2,3]

def upperTable : Fin 6 → List (Nat × List Color) :=
  ![[(0,[c0,c1,c2,c3]),(0,[c1,c0,c2,c3])],
    [(0,[c0,c1,c2,c3]),(2,[c0,c1,c2,c3]),(3,[c0,c1,c2,c3]),(4,[c2,c1,c0,c3]),(4,[c0,c1,c2,c3]),(3,[c2,c1,c0,c3]),(2,[c2,c1,c0,c3]),(0,[c2,c1,c0,c3])],
    [(0,[c0,c1,c2,c3]),(5,[c0,c1,c2,c3]),(6,[c0,c1,c2,c3]),(15,[c0,c3,c1,c2]),(7,[c0,c1,c2,c3]),(16,[c2,c3,c1,c0]),(17,[c0,c2,c1,c3]),(8,[c3,c1,c2,c0]),(8,[c0,c1,c2,c3]),(17,[c3,c2,c1,c0]),(16,[c0,c3,c1,c2]),(7,[c3,c1,c2,c0]),(15,[c2,c3,c1,c0]),(6,[c3,c1,c2,c0]),(5,[c3,c1,c2,c0]),(0,[c3,c1,c2,c0])],
    [(0,[c0,c1,c2,c3]),(0,[c0,c2,c1,c3])],
    [(0,[c0,c1,c2,c3]),(10,[c0,c1,c2,c3]),(10,[c0,c3,c2,c1]),(0,[c0,c3,c2,c1])],
    [(0,[c0,c1,c2,c3]),(12,[c0,c1,c2,c3]),(13,[c0,c1,c2,c3]),(14,[c0,c1,c3,c2]),(14,[c0,c1,c2,c3]),(13,[c0,c1,c3,c2]),(12,[c0,c1,c3,c2]),(0,[c0,c1,c3,c2])]]

def upperCode (p : Fin 6) (m : Fin 16) : Nat × List Color :=
  (upperTable p).getD (m.val % 2 ^ upperCounts p) (0, [c0,c1,c2,c3])

def upperPhase (p : Fin 6) (m : Fin 16) (j : Fin 11) : Color :=
  if m.val.testBit (upperBlocks p j) then
    Equiv.swap (pairs p).1 (pairs p).2 (upperWord 0 j) else upperWord 0 j

theorem upper_matches : ∀ p m, Function.Injective (rename (upperCode p m)) ∧
    ∀ j, rename (upperCode p m) (upperPhase p m j) = upperReference (upperCode p m).1 j := by
  decide +kernel

theorem upper_phase_rejects (p : Fin 6) (m : Fin 16) (C : upper.graph.Coloring Color)
    (boundary : ∀ j : Fin 11, C (j.castAdd 7) = upperPhase p m j) : False := by
  let f := rename (upperCode p m)
  let D : upper.graph.Coloring Color := .mk (fun v => f (C v)) (fun h =>
    fun eq => C.valid h ((upper_matches p m).1 eq))
  apply upper_reference_rejects (upperCode p m).1 D
  intro j
  change rename (upperCode p m) (C (j.castAdd 7)) = _
  rw [boundary j]
  exact (upper_matches p m).2 j

def lowerReference (i : Nat) : Fin 10 → Color :=
  lowerWord ⟨i % 14, Nat.mod_lt _ (by decide)⟩

theorem lower_reference_rejects (i : Nat) (C : lower.graph.Coloring Color)
    (boundary : ∀ j : Fin 10, C (j.castAdd 7) = lowerReference i j) : False := by
  exact lower_no_extension _ C boundary

def lowerBlocks : Fin 6 → Fin 10 → Nat :=
  ![![0,4,0,0,0,4,4,0,4,4],
    ![4,0,4,0,4,4,0,0,0,4],
    ![4,4,4,2,4,0,4,1,4,1],
    ![0,0,0,4,0,4,0,4,1,4],
    ![2,4,0,4,1,1,4,4,4,2],
    ![4,2,4,4,4,0,0,4,1,1]]

def lowerCounts : Fin 6 → Nat := ![1,1,3,2,3,3]

def lowerTable : Fin 6 → List (Nat × List Color) :=
  ![[(0,[c0,c1,c2,c3]),(0,[c1,c0,c2,c3])],
    [(0,[c0,c1,c2,c3]),(0,[c2,c1,c0,c3])],
    [(0,[c0,c1,c2,c3]),(3,[c0,c1,c2,c3]),(4,[c0,c1,c2,c3]),(5,[c3,c1,c2,c0]),(5,[c0,c1,c2,c3]),(4,[c3,c1,c2,c0]),(3,[c3,c1,c2,c0]),(0,[c3,c1,c2,c0])],
    [(0,[c0,c1,c2,c3]),(6,[c0,c1,c2,c3]),(6,[c0,c2,c1,c3]),(0,[c0,c2,c1,c3])],
    [(0,[c0,c1,c2,c3]),(8,[c0,c1,c2,c3]),(9,[c0,c1,c2,c3]),(10,[c0,c3,c2,c1]),(10,[c0,c1,c2,c3]),(9,[c0,c3,c2,c1]),(8,[c0,c3,c2,c1]),(0,[c0,c3,c2,c1])],
    [(0,[c0,c1,c2,c3]),(11,[c0,c1,c2,c3]),(12,[c0,c1,c2,c3]),(13,[c0,c1,c3,c2]),(13,[c0,c1,c2,c3]),(12,[c0,c1,c3,c2]),(11,[c0,c1,c3,c2]),(0,[c0,c1,c3,c2])]]

def lowerCode (p : Fin 6) (m : Fin 16) : Nat × List Color :=
  (lowerTable p).getD (m.val % 2 ^ lowerCounts p) (0, [c0,c1,c2,c3])

def lowerPhase (p : Fin 6) (m : Fin 16) (j : Fin 10) : Color :=
  if m.val.testBit (lowerBlocks p j) then
    Equiv.swap (pairs p).1 (pairs p).2 (lowerWord 0 j) else lowerWord 0 j

theorem lower_matches : ∀ p m, Function.Injective (rename (lowerCode p m)) ∧
    ∀ j, rename (lowerCode p m) (lowerPhase p m j) = lowerReference (lowerCode p m).1 j := by
  decide +kernel

theorem lower_phase_rejects (p : Fin 6) (m : Fin 16) (C : lower.graph.Coloring Color)
    (boundary : ∀ j : Fin 10, C (j.castAdd 7) = lowerPhase p m j) : False := by
  let f := rename (lowerCode p m)
  let D : lower.graph.Coloring Color := .mk (fun v => f (C v)) (fun h =>
    fun eq => C.valid h ((lower_matches p m).1 eq))
  apply lower_reference_rejects (lowerCode p m).1 D
  intro j
  change rename (lowerCode p m) (C (j.castAdd 7)) = _
  rw [boundary j]
  exact (lower_matches p m).2 j

def upperNearby : Fin 18 → Color :=
  ![c3,c1,c3,c1,c0,c3,c0,c2,c0,c1,c0,c1,c2,c1,c3,c0,c3,c2]

theorem upper_nearby_proper : ∀ x y, upper.graph.Adj x y →
    upperNearby x ≠ upperNearby y := by decide +kernel

theorem upper_nearby_one_port :
    (Finset.univ.filter fun j : Fin 11 => upperNearby (j.castAdd 7) ≠ upperWord 0 j).card = 1 := by
  decide +kernel

end FourColor.PairPhaseCore
