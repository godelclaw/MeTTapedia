  {
    "id": "he_ext_tv_conjunction_reduces",
    "tier": "extension_impl_target",
    "implementation_priority": "P1",
    "implementation_group": "pln_tv",
    "setup": [
      "(= (min $a $b) (if (< $a $b) $a $b))",
      "(= (s-tv (stv $s $c)) $s)",
      "(= (c-tv (stv $s $c)) $c)",
      "(= (TV $x) (match &self (.tv $x $stv) $stv))",
      "(= (TV (And $a $b)) (stv (min (s-tv (TV $a)) (s-tv (TV $b))) (min (c-tv (TV $a)) (c-tv (TV $b)))))",
      "(.tv aa (stv 0.5 0.8))",
      "(.tv bb (stv 0.3 0.9))"
    ],
    "query": "!(TV (And aa bb))",
    "expected": [
      "(stv 0.3 0.8)"
    ],
    "source_note": "Minimal witness extracted from he_c3_pln_stv.metta: conjunction truth-value reduction must re-enter nested TV/min projections applicatively"
  },
  {
    "id": "he_ext_tv_implication_reduces",
    "tier": "extension_impl_target",
    "implementation_priority": "P1",
    "implementation_group": "pln_tv",
    "setup": [
      "(= (s-tv (stv $s $c)) $s)",
      "(= (c-tv (stv $s $c)) $c)",
      "(= (TV $x) (match &self (.tv $x $stv) $stv))",
      "(= (TV $x) (match &self (.tv (Implication $y $x) (stv $s $c)) (stv (* $s (s-tv (TV $y))) (* $c (c-tv (TV $y))))))",
      "(.tv aa (stv 0.5 0.8))",
      "(.tv (Implication aa ff) (stv 0.8 1.0))"
    ],
    "query": "!(TV ff)",
    "expected": [
      "(stv 0.4 0.8)"
    ],
    "source_note": "Minimal witness extracted from he_c3_pln_stv.metta: implication truth-value reduction must recurse through antecedent TV lookup"
  },
