  {
    "id": "he_unify_selected_bindings_precede_equation_dispatch",
    "tier": "core_anchor",
    "lean_theorem": "Mettapedia.Languages.MeTTa.HE.Spec.Eval.Minimal.EquationFallbackControls.ordinary_unify_from_empty_materializes_before_call",
    "setup": [
      "(= (f A) Hit)"
    ],
    "query": "!(unify $x B (f $x) Fail)",
    "expected": [
      "(f B)"
    ],
    "source_note": "Successful primitive selection reads its template through the reached binding frame before the ordinary continuation. The incompatible equation does not discard the result."
  }
