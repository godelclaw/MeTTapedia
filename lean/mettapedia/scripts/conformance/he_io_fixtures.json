  {
    "id": "he_atom_demand_holds_embedded_source",
    "tier": "core_anchor",
    "lean_theorem": "Mettapedia.Languages.MeTTa.HE.Spec.Eval.Minimal.full_atom_expected_exact",
    "setup": [
