    "id": "he_equation_function_caller_raw",
    "tier": "core_anchor",
    "lean_theorem": "Mettapedia.Languages.MeTTa.HE.Spec.Eval.Minimal.InvocationCallerControls.raw_equation_keeps_invocation",
    "setup": [
      "(= (foo) (function (SomeValue)))"
    ],
    "query": "!(eval (foo))",
