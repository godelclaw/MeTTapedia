import Mettapedia.QuantumTheory.YangMills.HypercubicDimension16IncomingCommutatorTraceProjection

/-!
# OUR obstruction to a field-eight-only trace-quotient descent

The exact physical commutator column has a nonzero incoming eight-field
component.  This module isolates the precise consequence for the ordinary
derivative-free trace quotient: no linear map which both ignores every other
field sector and sends that literal eight-field component to its certified
trace class can annihilate the full physical relation range.

This is an obstruction to a direct sector-projection route.  It does not
rule out a genuinely joint construction retaining the coupled lower-field
components.
-/

set_option autoImplicit false
noncomputable section

namespace Mettapedia
namespace QuantumTheory
namespace YangMills
namespace HypercubicDimension16IncomingCommutatorTraceNoFieldEightDescent

open HypercubicDimension16PhysicalRelationOperator
open HypercubicDimension16PhysicalOrbitOperator
open HypercubicDimension16PhysicalRelationBlocks
open HypercubicDimension16FieldEightPhysicalTrace
open HypercubicDimension16IncomingCommutatorTraceCertificate
open HypercubicDimension16IncomingCommutatorTraceMismatch
open HypercubicDimension16IncomingCommutatorTraceProjection

/-- OUR full orbit-carrier column generated by the distinguished seven-field
covariant commutator. -/
def ourIncomingPhysicalColumn (policy : PhysicalRelationPolicy) :
    ExactFieldRelabelOrbitSpace :=
  orbitPhysicalRelationOperator policy
    (Finsupp.single (ourFieldSevenCommutatorGenerator policy) 1)

/-- OUR distinguished column belongs to the full physical relation range. -/
theorem ourIncomingPhysicalColumn_mem
    (policy : PhysicalRelationPolicy) :
    ourIncomingPhysicalColumn policy ∈ orbitPhysicalRelationSubmodule policy := by
  refine ⟨Finsupp.single (ourFieldSevenCommutatorGenerator policy) 1, ?_⟩
  rfl

/-- The field-eight filter of OUR distinguished full column is the exact
embedded literal incoming pair. -/
theorem ourIncomingPhysicalColumn_fieldEight
    (policy : PhysicalRelationPolicy) :
    orbitFieldFilter (fun fieldCount => fieldCount.1 = 8)
        (ourIncomingPhysicalColumn policy) =
      fieldEightExactEmbed literalIncomingCommutatorVector := by
  exact actualIncomingProjection_eq_fieldEightExactEmbed policy

/-- No field-eight-supported map which recognizes OUR literal incoming pair
as its nonzero ordinary trace class can descend across the full physical
relation range. -/
theorem no_fieldEight_supported_trace_quotient_descent
    (policy : PhysicalRelationPolicy)
    (candidate : ExactFieldRelabelOrbitSpace →ₗ[ℚ]
      FieldEightPhysicalTraceQuotient)
    (hsupported : candidate.comp
        (orbitFieldFilter (fun fieldCount => fieldCount.1 = 8)) = candidate)
    (hliteral : candidate
        (fieldEightExactEmbed literalIncomingCommutatorVector) =
      literalIncomingCommutatorClass) :
    ¬ orbitPhysicalRelationSubmodule policy ≤ LinearMap.ker candidate := by
  intro hdescent
  have hzero : candidate (ourIncomingPhysicalColumn policy) = 0 :=
    LinearMap.mem_ker.mp
      (hdescent (ourIncomingPhysicalColumn_mem policy))
  have hclass : literalIncomingCommutatorClass = 0 := by
    calc
      literalIncomingCommutatorClass =
          candidate (fieldEightExactEmbed literalIncomingCommutatorVector) :=
        hliteral.symm
      _ = candidate
          (orbitFieldFilter (fun fieldCount => fieldCount.1 = 8)
            (ourIncomingPhysicalColumn policy)) := by
        rw [ourIncomingPhysicalColumn_fieldEight]
      _ = (candidate.comp
          (orbitFieldFilter (fun fieldCount => fieldCount.1 = 8)))
          (ourIncomingPhysicalColumn policy) := rfl
      _ = candidate (ourIncomingPhysicalColumn policy) := by
        rw [hsupported]
      _ = 0 := hzero
  exact actualIncomingLiteralTraceClass_ne_zero hclass

#print axioms ourIncomingPhysicalColumn_mem
#print axioms ourIncomingPhysicalColumn_fieldEight
#print axioms no_fieldEight_supported_trace_quotient_descent

end HypercubicDimension16IncomingCommutatorTraceNoFieldEightDescent
end YangMills
end QuantumTheory
end Mettapedia
