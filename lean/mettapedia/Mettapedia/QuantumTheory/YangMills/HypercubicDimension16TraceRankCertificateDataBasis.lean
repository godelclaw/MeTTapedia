@[reducible] def decodeRationalSparseRow (values : Array Nat) : RationalSparseRow :=
  (List.range (values.size / 3)).toArray.map fun entry =>
    (values.getD (3 * entry + 0) 0, if values.getD (3 * entry + 1) 0 % 2 = 0 then Int.ofNat (values.getD (3 * entry + 1) 0 / 2) else -Int.ofNat ((values.getD (3 * entry + 1) 0 + 1) / 2), values.getD (3 * entry + 2) 0)

