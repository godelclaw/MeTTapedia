(chunk numbers without a payload are delegated to the decoder, which returns `#[]`). -/
def positiveRepresentativeWordTableChunk (chunk : Nat) : Array Nat :=
  match chunk with
  | 0 => positiveRepresentativeWordTable0.toArray
  | 1 => positiveRepresentativeWordTable1.toArray
  | 2 => positiveRepresentativeWordTable2.toArray
  | 3 => positiveRepresentativeWordTable3.toArray
  | 4 => positiveRepresentativeWordTable4.toArray
  | 5 => positiveRepresentativeWordTable5.toArray
  | 6 => positiveRepresentativeWordTable6.toArray
  | 7 => positiveRepresentativeWordTable7.toArray
  | 8 => positiveRepresentativeWordTable8.toArray
  | 9 => positiveRepresentativeWordTable9.toArray
  | 10 => positiveRepresentativeWordTable10.toArray
  | 11 => positiveRepresentativeWordTable11.toArray
  | n + 12 => decodedPositiveRepresentativeWordChunk (n + 12)

