import Mettapedia.QuantumTheory.YangMills.HypercubicDimension16PhysicalTracePublicConditioning
import Mettapedia.QuantumTheory.YangMills.HypercubicDimension16IncomingCommutatorTraceCertificate

/-!
# OUR coordinate transport for the incoming commutator class

This file identifies the literal incoming commutator class with the same
genuine Reynolds-normalized trace functional used by the independently
certified standard trace quotient.  It concerns only the isolated ordinary
derivative-free eight-field trace quotient.  It neither identifies that
bounded quotient with the full coordinate-free physical quotient nor asserts
that the complete physical relation space is generated by this literal pair.
-/

set_option autoImplicit false
noncomputable section

open scoped BigOperators

namespace Mettapedia
namespace QuantumTheory
namespace YangMills
namespace HypercubicDimension16IncomingCommutatorTraceCoordinateCore

open V14HypercubicFDCensus
open HypercubicRawFDCharacterCensus
open HypercubicDimension16LocalWordCarrier
open HypercubicDimension16PhysicalInvariantSpace
open HypercubicDimension16SignedOrbitCoinvariants
open HypercubicDimension16FieldEightPhysicalTrace
open HypercubicDimension16TraceEvaluation
open HypercubicDimension16PhysicalTraceEvaluationExecutable
open HypercubicDimension16PhysicalTraceEvaluationReynolds
open HypercubicDimension16PhysicalTracePublicConditioning
open HypercubicDimension16IncomingCommutatorTraceCertificate

/-- OUR unsigned-permutation contribution of one literal source at one
standard trace assignment. -/
def sourcePermutationContributionAt
    (assignment : Fin 98) (source : LabeledLocalWordSector 8 0)
    (permutation : Fin 24) : ℚ :=
  let h := decodedHypercubicCharacterElement permutation 0
  source.tensorSign h *
    labeledPlaneTraceEvaluation (encodedEvaluationMatrixAt assignment)
      (source.hypercubicAct h)

/-- OUR sixteen-reflection block above one unsigned coordinate permutation. -/
def sourceReflectionBlockAt
    (assignment : Fin 98) (source : LabeledLocalWordSector 8 0)
    (permutation : Fin 24) : ℚ :=
  ∑ reflectionMask : Fin 16,
    let h := decodedHypercubicCharacterElement permutation reflectionMask
    source.tensorSign h *
      labeledPlaneTraceEvaluation (encodedEvaluationMatrixAt assignment)
        (source.hypercubicAct h)

/-- OUR full Reynolds value of a literal source at a standard trace
assignment. -/
def sourceReynoldsTraceValueAt
    (assignment : Fin 98) (source : LabeledLocalWordSector 8 0) : ℚ :=
  (1 / 384 : ℚ) * ∑ h : Hypercubic4,
    source.tensorSign h *
      labeledPlaneTraceEvaluation (encodedEvaluationMatrixAt assignment)
        (source.hypercubicAct h)

/-- OUR unsigned numerator of the literal incoming trace functional. -/
def literalIncomingUnsignedEvaluation (assignment : Fin 98) : ℚ :=
  ∑ permutation : Fin 24,
    (sourcePermutationContributionAt assignment incomingAfterSource permutation -
      sourcePermutationContributionAt assignment incomingBeforeSource permutation)

theorem sourceReynoldsTraceValueAt_blocks
    (assignment : Fin 98) (source : LabeledLocalWordSector 8 0) :
    sourceReynoldsTraceValueAt assignment source =
      (1 / 384 : ℚ) * ∑ permutation : Fin 24,
        sourceReflectionBlockAt assignment source permutation := by
  unfold sourceReynoldsTraceValueAt
  let summand : Hypercubic4 → ℚ := fun h =>
    source.tensorSign h *
      labeledPlaneTraceEvaluation (encodedEvaluationMatrixAt assignment)
        (source.hypercubicAct h)
  change (1 / 384 : ℚ) * ∑ h : Hypercubic4, summand h = _
  calc
    (1 / 384 : ℚ) * ∑ h : Hypercubic4, summand h =
        (1 / 384 : ℚ) * ∑ code : Fin 24 × Fin 16,
          summand (hypercubicCharacterCodeEquiv code) := by
      rw [Equiv.sum_comp hypercubicCharacterCodeEquiv summand]
    _ = (1 / 384 : ℚ) * ∑ permutation : Fin 24,
        sourceReflectionBlockAt assignment source permutation := by
      simp [summand, hypercubicCharacterCodeEquiv,
        sourceReflectionBlockAt, Fintype.sum_prod_type]

theorem incomingBefore_reflection_term_at
    (assignment : Fin 98) (permutation : Fin 24) (reflectionMask : Fin 16) :
    let h := decodedHypercubicCharacterElement permutation reflectionMask
    incomingBeforeSource.tensorSign h *
      labeledPlaneTraceEvaluation (encodedEvaluationMatrixAt assignment)
        (incomingBeforeSource.hypercubicAct h) =
      sourcePermutationContributionAt assignment incomingBeforeSource permutation := by
  dsimp [sourcePermutationContributionAt]
  rw [incomingBefore_tensorSign_reflection_invariant]
  rw [incomingBefore_action_reflection_invariant]

theorem incomingBefore_block_factor_at
    (assignment : Fin 98) (permutation : Fin 24) :
    sourceReflectionBlockAt assignment incomingBeforeSource permutation =
      16 * sourcePermutationContributionAt assignment incomingBeforeSource permutation := by
  unfold sourceReflectionBlockAt
  simp_rw [incomingBefore_reflection_term_at]
  norm_num

theorem incomingAfter_reflection_term_at
    (assignment : Fin 98) (permutation : Fin 24) (reflectionMask : Fin 16) :
    let h := decodedHypercubicCharacterElement permutation reflectionMask
    incomingAfterSource.tensorSign h *
      labeledPlaneTraceEvaluation (encodedEvaluationMatrixAt assignment)
        (incomingAfterSource.hypercubicAct h) =
      sourcePermutationContributionAt assignment incomingAfterSource permutation := by
  dsimp [sourcePermutationContributionAt]
  rw [incomingAfter_tensorSign_reflection_invariant]
  rw [incomingAfter_action_reflection_invariant]

theorem incomingAfter_block_factor_at
    (assignment : Fin 98) (permutation : Fin 24) :
    sourceReflectionBlockAt assignment incomingAfterSource permutation =
      16 * sourcePermutationContributionAt assignment incomingAfterSource permutation := by
  unfold sourceReflectionBlockAt
  simp_rw [incomingAfter_reflection_term_at]
  norm_num

theorem sourceReynoldsTraceValueAt_before
    (assignment : Fin 98) :
    sourceReynoldsTraceValueAt assignment incomingBeforeSource =
      (1 / 24 : ℚ) * ∑ permutation : Fin 24,
        sourcePermutationContributionAt assignment incomingBeforeSource permutation := by
  rw [sourceReynoldsTraceValueAt_blocks]
  simp_rw [incomingBefore_block_factor_at]
  rw [← Finset.mul_sum]
  ring

theorem sourceReynoldsTraceValueAt_after
    (assignment : Fin 98) :
    sourceReynoldsTraceValueAt assignment incomingAfterSource =
      (1 / 24 : ℚ) * ∑ permutation : Fin 24,
        sourcePermutationContributionAt assignment incomingAfterSource permutation := by
  rw [sourceReynoldsTraceValueAt_blocks]
  simp_rw [incomingAfter_block_factor_at]
  rw [← Finset.mul_sum]
  ring

/-- The incoming literal's raw trace evaluation is its checked unsigned
numerator divided by the genuine Reynolds factor `24`. -/
theorem rawReynoldsTraceEvaluation_literalIncoming_eq_unsigned
    (assignment : Fin 98) :
    rawReynoldsTraceEvaluation assignment literalIncomingCommutatorVector =
      (1 / 24 : ℚ) * literalIncomingUnsignedEvaluation assignment := by
  unfold literalIncomingCommutatorVector literalIncomingUnsignedEvaluation
  simp only [LinearMap.map_add, LinearMap.map_neg]
  rw [rawReynoldsTraceEvaluation_single,
    rawReynoldsTraceEvaluation_single]
  simp only [FieldRelabelOrbitCarrier.tensorSign_mk,
    FieldRelabelOrbitCarrier.hypercubicAct_mk,
    orbitPlaneTraceEvaluation_mk]
  change -sourceReynoldsTraceValueAt assignment incomingBeforeSource +
      sourceReynoldsTraceValueAt assignment incomingAfterSource = _
  rw [sourceReynoldsTraceValueAt_before,
    sourceReynoldsTraceValueAt_after, Finset.sum_sub_distrib]
  ring

theorem fieldEightSignedOrbitCoinvariantEquivInvariant_mk
    (raw : FieldEightOrbitSpace) :
    fieldEightSignedOrbitCoinvariantEquivInvariant
        (Submodule.Quotient.mk raw) =
      fieldEightReynoldsToInvariant raw := by
  simp [fieldEightSignedOrbitCoinvariantEquivInvariant]

/-- The incoming signed-coinvariant functional is exactly the public
trace-evaluation functional on the common quotient carrier. -/
theorem incomingCoinvariantTraceEvaluation_eq_public
    (assignment : Fin 98) :
    incomingCoinvariantTraceEvaluation assignment =
      coinvariantTraceEvaluation assignment := by
  apply LinearMap.ext
  intro value
  refine Submodule.Quotient.induction_on _ value ?_
  intro raw
  change rawReynoldsTraceEvaluation assignment raw =
    invariantTraceEvaluation assignment
      (fieldEightSignedOrbitCoinvariantEquivInvariant
        (Submodule.Quotient.mk raw))
  rw [fieldEightSignedOrbitCoinvariantEquivInvariant_mk]
  rfl

/-- The incoming quotient functional is exactly the public trace-evaluation
functional after the common ordinary trace quotient. -/
theorem incomingQuotientTraceEvaluation_eq_public
    (assignment : Fin 98) :
    incomingQuotientTraceEvaluation assignment =
      quotientTraceEvaluation assignment := by
  apply LinearMap.ext
  intro value
  refine Submodule.Quotient.induction_on _ value ?_
  intro coinvariant
  change incomingCoinvariantTraceEvaluation assignment coinvariant =
    coinvariantTraceEvaluation assignment coinvariant
  rw [incomingCoinvariantTraceEvaluation_eq_public]

#print axioms rawReynoldsTraceEvaluation_literalIncoming_eq_unsigned
#print axioms incomingCoinvariantTraceEvaluation_eq_public
#print axioms incomingQuotientTraceEvaluation_eq_public

end HypercubicDimension16IncomingCommutatorTraceCoordinateCore
end YangMills
end QuantumTheory
end Mettapedia
