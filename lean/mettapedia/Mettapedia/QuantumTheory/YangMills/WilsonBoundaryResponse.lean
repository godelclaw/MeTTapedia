import Mettapedia.Analysis.CompactMeanContinuousRate
import Mathlib.Analysis.SpecialFunctions.Log.Deriv
import Mathlib.Analysis.Normed.Module.Seminorm.Basic

/-!
# Boundary free-energy response from an actual connected correlation

Two multiplicative changes of a positive Wilson density have a mixed
log-partition response controlled by their connected correlation in the
unchanged law. Lower bounds on the two factors give the normalization
constant explicitly. This identity retains all interactions generated by
interior integration.

Differentiating a marked expectation or covariance retains the action score
and the direct mark derivatives. Spatial response arrays carry a weighted
maximum-row seminorm, with an exponential-envelope summability criterion.
-/

set_option autoImplicit false
noncomputable section

open MeasureTheory
open scoped Topology

namespace Mettapedia.QuantumTheory.YangMills.WilsonBoundaryResponse

open WilsonBlockElimination WilsonSeparator

theorem log_sub_le_div_sub {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
    Real.log a - Real.log b ≤ (a - b) / b := by
  have h := Real.log_le_sub_one_of_pos (div_pos ha hb)
  rw [Real.log_div ha.ne' hb.ne'] at h
  convert h using 1
  field_simp

/-- A Lipschitz bound for the logarithm above a positive lower cutoff. -/
theorem abs_log_sub_le {a b l : ℝ} (hl : 0 < l) (hla : l ≤ a) (hlb : l ≤ b) :
    |Real.log a - Real.log b| ≤ |a - b| / l := by
  have ha := hl.trans_le hla
  have hb := hl.trans_le hlb
  by_cases hab : b ≤ a
  · rw [abs_of_nonneg (sub_nonneg.mpr (Real.log_le_log hb hab)),
      abs_of_nonneg (sub_nonneg.mpr hab)]
    exact (log_sub_le_div_sub ha hb).trans
      (div_le_div_of_nonneg_left (sub_nonneg.mpr hab) hl hlb)
  · have hba := le_of_lt (lt_of_not_ge hab)
    rw [abs_sub_comm (Real.log a), abs_sub_comm a,
      abs_of_nonneg (sub_nonneg.mpr (Real.log_le_log ha hba)),
      abs_of_nonneg (sub_nonneg.mpr hba)]
    exact (log_sub_le_div_sub hb ha).trans
      (div_le_div_of_nonneg_left (sub_nonneg.mpr hba) hl hla)

variable {X : Type*} [TopologicalSpace X] [CompactSpace X]
  [MeasurableSpace X] [BorelSpace X]
  (μ : Measure X) [IsProbabilityMeasure μ]

def logPartition (W : C(X, ℝ)) : ℝ := Real.log (∫ x, W x ∂μ)

/-- The mixed change caused by applying both density factors rather than
either one separately, with all four partition functions in the same volume. -/
def mixedResponse (W A B : C(X, ℝ)) : ℝ :=
  logPartition μ (W * (A * B)) + logPartition μ W -
    logPartition μ (W * A) - logPartition μ (W * B)

theorem expectation_pos (W A : C(X, ℝ)) (hW : ∀ x, 0 < W x) (hA : ∀ x, 0 < A x) :
    0 < expectation μ W A :=
  div_pos (partition_pos μ (W * A) (fun x => mul_pos (hW x) (hA x)))
    (partition_pos μ W hW)

/-- Exact identity relating the four partition functions to the two marked
observables in the unchanged law. -/
theorem mixedResponse_eq_log_expectations (W A B : C(X, ℝ))
    (hW : ∀ x, 0 < W x) (hA : ∀ x, 0 < A x) (hB : ∀ x, 0 < B x) :
    mixedResponse μ W A B =
      Real.log (expectation μ W (A * B)) -
        Real.log (expectation μ W A * expectation μ W B) := by
  have hZ := (partition_pos μ W hW).ne'
  have hZA := (partition_pos μ (W * A) (fun x => mul_pos (hW x) (hA x))).ne'
  have hZB := (partition_pos μ (W * B) (fun x => mul_pos (hW x) (hB x))).ne'
  have hZAB := (partition_pos μ (W * (A * B))
    (fun x => mul_pos (hW x) (mul_pos (hA x) (hB x)))).ne'
  rw [Real.log_mul (expectation_pos μ W A hW hA).ne'
    (expectation_pos μ W B hW hB).ne']
  simp only [expectation, mixedResponse, logPartition, ContinuousMap.mul_apply] at *
  rw [Real.log_div hZAB hZ, Real.log_div hZA hZ, Real.log_div hZB hZ]
  ring

/-- A lower pointwise bound survives the normalized positive density. -/
theorem lower_expectation (W A : C(X, ℝ)) (hW : ∀ x, 0 < W x)
    {l : ℝ} (hA : ∀ x, l ≤ A x) : l ≤ expectation μ W A := by
  simpa only [expectation_const μ W hW] using
    expectation_mono μ W (ContinuousMap.const X l) A hW hA

/-- The mixed boundary response is bounded by the actual covariance. The
normalization cost uses only lower bounds on the two boundary-change factors. -/
theorem abs_mixedResponse_le_covariance (W A B : C(X, ℝ))
    (hW : ∀ x, 0 < W x) {lA lB : ℝ} (hlA : 0 < lA) (hlB : 0 < lB)
    (hA : ∀ x, lA ≤ A x) (hB : ∀ x, lB ≤ B x) :
    |mixedResponse μ W A B| ≤ |covariance μ W A B| / (lA * lB) := by
  have hAp : ∀ x, 0 < A x := fun x => hlA.trans_le (hA x)
  have hBp : ∀ x, 0 < B x := fun x => hlB.trans_le (hB x)
  have hAB : lA * lB ≤ expectation μ W (A * B) :=
    lower_expectation μ W (A * B) hW (fun x => mul_le_mul (hA x) (hB x) hlB.le (hAp x).le)
  have hprod : lA * lB ≤ expectation μ W A * expectation μ W B :=
    mul_le_mul (lower_expectation μ W A hW hA) (lower_expectation μ W B hW hB)
      hlB.le (expectation_pos μ W A hW hAp).le
  rw [mixedResponse_eq_log_expectations μ W A B hW hAp hBp]
  exact abs_log_sub_le (mul_pos hlA hlB) hAB hprod

/-- Any established spatial covariance estimate transfers to the mixed
effective-action response with the explicit normalization factor. -/
theorem abs_mixedResponse_le_of_covariance (W A B : C(X, ℝ))
    (hW : ∀ x, 0 < W x) {lA lB C : ℝ} (hlA : 0 < lA) (hlB : 0 < lB)
    (hA : ∀ x, lA ≤ A x) (hB : ∀ x, lB ≤ B x)
    (hcov : |covariance μ W A B| ≤ C) :
    |mixedResponse μ W A B| ≤ C / (lA * lB) :=
  (abs_mixedResponse_le_covariance μ W A B hW hlA hlB hA hB).trans
    (div_le_div_of_nonneg_right hcov (mul_pos hlA hlB).le)

section DifferentialResponse

variable [Nonempty X]

/-- The logarithmic derivative of an actual positive density is the
expectation of its action score. Compactness supplies the domination needed
to differentiate the original reference-measure integral. -/
theorem hasDerivAt_logPartition (β : ℝ) (W A : ℝ → C(X, ℝ))
    (hW : Continuous (fun z : ℝ × X ↦ W z.1 z.2))
    (hA : Continuous (fun z : ℝ × X ↦ A z.1 z.2))
    (hd : ∀ r x, HasDerivAt (fun s ↦ W s x) (-β * (W r x * A r x)) r)
    (t : ℝ) (hpos : ∀ x, 0 < W t x) :
    HasDerivAt (fun s ↦ logPartition μ (W s))
      (-β * expectation μ (W t) (A t)) t := by
  have hi := Mettapedia.Analysis.CompactMeanContinuousRate.hasDerivAt_integral_of_continuous
    μ (fun r x ↦ W r x) (fun r x ↦ -β * (W r x * A r x))
    hW (continuous_const.mul (hW.mul hA)) hd t
  have h := hi.log (partition_pos μ (W t) hpos).ne'
  simpa only [logPartition, expectation, integral_const_mul, mul_div_assoc] using h

/-- Differentiating a normalized marked integral produces both the direct
mark derivative and its connected correlation with the density score. -/
theorem hasDerivAt_expectation (β : ℝ) (W A F B : ℝ → C(X, ℝ))
    (hW : Continuous (fun z : ℝ × X ↦ W z.1 z.2))
    (hA : Continuous (fun z : ℝ × X ↦ A z.1 z.2))
    (hF : Continuous (fun z : ℝ × X ↦ F z.1 z.2))
    (hB : Continuous (fun z : ℝ × X ↦ B z.1 z.2))
    (hdW : ∀ r x, HasDerivAt (fun s ↦ W s x) (-β * (W r x * A r x)) r)
    (hdF : ∀ r x, HasDerivAt (fun s ↦ F s x) (B r x) r)
    (t : ℝ) (hpos : ∀ x, 0 < W t x) :
    HasDerivAt (fun s ↦ expectation μ (W s) (F s))
      (expectation μ (W t) (B t) - β * covariance μ (W t) (F t) (A t)) t := by
  have hZ := Mettapedia.Analysis.CompactMeanContinuousRate.hasDerivAt_integral_of_continuous
    μ (fun r x ↦ W r x) (fun r x ↦ -β * (W r x * A r x))
    hW (continuous_const.mul (hW.mul hA)) hdW t
  have hN := Mettapedia.Analysis.CompactMeanContinuousRate.hasDerivAt_integral_of_continuous
    μ (fun r x ↦ W r x * F r x)
    (fun r x ↦ W r x * B r x - β * (W r x * (F r x * A r x)))
    (hW.mul hF) ((hW.mul hB).sub (continuous_const.mul (hW.mul (hF.mul hA))))
    (fun r x ↦ ((hdW r x).mul (hdF r x)).congr_deriv (by ring)) t
  have iB : Integrable (fun x ↦ W t x * B t x) μ :=
    CompactTransferGap.IntegralKernel.integrable_continuous_fun μ (by fun_prop)
  have iFA : Integrable (fun x ↦ W t x * (F t x * A t x)) μ :=
    CompactTransferGap.IntegralKernel.integrable_continuous_fun μ (by fun_prop)
  rw [integral_const_mul] at hZ
  rw [integral_sub iB (iFA.const_mul β), integral_const_mul] at hN
  have hzero := (partition_pos μ (W t) hpos).ne'
  apply (hN.div hZ hzero).congr_deriv
  simp only [expectation, covariance, ContinuousMap.mul_apply]
  field_simp
  ring

/-- Covariance differentiation retains both direct mark derivatives and
the third connected correlation with the original density score. -/
theorem hasDerivAt_covariance (β : ℝ) (W A F G B D : ℝ → C(X, ℝ))
    (hW : Continuous (fun z : ℝ × X ↦ W z.1 z.2))
    (hA : Continuous (fun z : ℝ × X ↦ A z.1 z.2))
    (hF : Continuous (fun z : ℝ × X ↦ F z.1 z.2))
    (hG : Continuous (fun z : ℝ × X ↦ G z.1 z.2))
    (hB : Continuous (fun z : ℝ × X ↦ B z.1 z.2))
    (hD : Continuous (fun z : ℝ × X ↦ D z.1 z.2))
    (hdW : ∀ r x, HasDerivAt (fun s ↦ W s x) (-β * (W r x * A r x)) r)
    (hdF : ∀ r x, HasDerivAt (fun s ↦ F s x) (B r x) r)
    (hdG : ∀ r x, HasDerivAt (fun s ↦ G s x) (D r x) r)
    (t : ℝ) (hpos : ∀ x, 0 < W t x) :
    HasDerivAt (fun s ↦ covariance μ (W s) (F s) (G s))
      (covariance μ (W t) (B t) (G t) + covariance μ (W t) (F t) (D t) -
        β * thirdCumulant μ (W t) (F t) (G t) (A t)) t := by
  have hFG := hasDerivAt_expectation μ β W A (fun s ↦ F s * G s)
    (fun s ↦ B s * G s + F s * D s) hW hA (hF.mul hG)
    ((hB.mul hG).add (hF.mul hD)) hdW
    (fun r x ↦ ((hdF r x).mul (hdG r x)).congr_deriv (by
      simp only [ContinuousMap.add_apply, ContinuousMap.mul_apply])) t hpos
  have hEF := hasDerivAt_expectation μ β W A F B hW hA hF hB hdW hdF t hpos
  have hEG := hasDerivAt_expectation μ β W A G D hW hA hG hD hdW hdG t hpos
  apply (hFG.sub (hEF.mul hEG)).congr_deriv
  rw [expectation_add]
  simp only [covariance, thirdCumulant, thirdMoment, smul_eq_mul]
  ring

/-- The mixed logarithmic response keeps the action's contact derivative.
Separated plaquette patches discharge this term by proving that their first
score is unchanged by the other boundary curve. -/
theorem hasDerivAt_logPartitionScore (β : ℝ) (W A B J : ℝ → C(X, ℝ))
    (hW : Continuous (fun z : ℝ × X ↦ W z.1 z.2))
    (hA : Continuous (fun z : ℝ × X ↦ A z.1 z.2))
    (hB : Continuous (fun z : ℝ × X ↦ B z.1 z.2))
    (hJ : Continuous (fun z : ℝ × X ↦ J z.1 z.2))
    (hdW : ∀ r x, HasDerivAt (fun s ↦ W s x) (-β * (W r x * B r x)) r)
    (hdA : ∀ r x, HasDerivAt (fun s ↦ A s x) (J r x) r)
    (t : ℝ) (hpos : ∀ x, 0 < W t x) :
    HasDerivAt (fun s ↦ -β * expectation μ (W s) (A s))
      (β ^ 2 * covariance μ (W t) (A t) (B t) - β * expectation μ (W t) (J t)) t := by
  apply ((hasDerivAt_expectation μ β W B A J hW hB hA hJ hdW hdA t hpos).const_mul
    (-β)).congr_deriv
  ring

end DifferentialResponse

section SpatialResponse

variable {ι : Type*} [Fintype ι] [PseudoMetricSpace ι]

/-- The total absolute influence on one coordinate, with a spatial
exponential weight. This is a seminorm on response arrays. -/
def weightedResponseRow (η : ℝ) (i : ι) : Seminorm ℝ (ι → ι → ℝ) :=
  Seminorm.of (fun H ↦ ∑ j, Real.exp (η * dist i j) * |H i j|)
    (fun H G ↦ by
      calc
        _ ≤ ∑ j, Real.exp (η * dist i j) * (|H i j| + |G i j|) :=
          Finset.sum_le_sum (fun j _ ↦
            mul_le_mul_of_nonneg_left (abs_add_le (H i j) (G i j)) (Real.exp_pos _).le)
        _ = _ := by simp only [mul_add, Finset.sum_add_distrib])
    (fun a H ↦ by
      simp only [Pi.smul_apply, smul_eq_mul, abs_mul, Real.norm_eq_abs, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      ring)

@[simp] theorem weightedResponseRow_apply (η : ℝ) (i : ι) (H : ι → ι → ℝ) :
    weightedResponseRow η i H = ∑ j, Real.exp (η * dist i j) * |H i j| := rfl

/-- Maximum weighted row sum. The finite supremum is zero on an empty
coordinate set and has the usual seminorm laws. -/
def weightedResponseSeminorm (η : ℝ) : Seminorm ℝ (ι → ι → ℝ) :=
  Finset.univ.sup (weightedResponseRow η)

theorem weightedResponseRow_le (η : ℝ) (i : ι) (H : ι → ι → ℝ) :
    weightedResponseRow η i H ≤ weightedResponseSeminorm η H :=
  Seminorm.le_finset_sup_apply (Finset.mem_univ i)

theorem weightedResponseSeminorm_le (η : ℝ) (H : ι → ι → ℝ)
    {C : ℝ} (hC : 0 ≤ C) (h : ∀ i, weightedResponseRow η i H ≤ C) :
    weightedResponseSeminorm η H ≤ C :=
  Seminorm.finset_sup_apply_le hC (fun i _ ↦ h i)

/-- A pointwise exponential envelope becomes a bound on total influence
once the exponentially weighted coordinate count has been bounded. -/
theorem weightedResponseSeminorm_le_of_envelope (η κ : ℝ) (H : ι → ι → ℝ)
    {M C : ℝ} (hM : 0 ≤ M) (hC : 0 ≤ C)
    (hH : ∀ i j, |H i j| ≤ M * Real.exp (-κ * dist i j))
    (hcount : ∀ i : ι, ∑ j, Real.exp (-(κ - η) * dist i j) ≤ C) :
    weightedResponseSeminorm η H ≤ M * C := by
  apply weightedResponseSeminorm_le η H (mul_nonneg hM hC)
  intro i
  calc
    _ ≤ ∑ j, Real.exp (η * dist i j) * (M * Real.exp (-κ * dist i j)) :=
      Finset.sum_le_sum (fun j _ ↦
        mul_le_mul_of_nonneg_left (hH i j) (Real.exp_pos _).le)
    _ = M * ∑ j, Real.exp (-(κ - η) * dist i j) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      rw [← mul_assoc, mul_comm (Real.exp _) M, mul_assoc, ← Real.exp_add]
      congr 2
      ring
    _ ≤ M * C := mul_le_mul_of_nonneg_left (hcount i) hM

end SpatialResponse

