import Mettapedia.QuantumTheory.YangMills.WilsonSeparator

/-!
# Boundary free-energy response from an actual connected correlation

Two multiplicative changes of a positive Wilson density have a mixed
log-partition response controlled by their connected correlation in the
unchanged law. Lower bounds on the two factors give the normalization
constant explicitly. This identity retains all interactions generated by
interior integration.
-/

set_option autoImplicit false
noncomputable section

open MeasureTheory
open scoped Topology

namespace Mettapedia.QuantumTheory.YangMills.WilsonBoundaryResponse

open WilsonBlockElimination WilsonSeparator

theorem log_sub_le_div_sub {a b : ℝ} (ha : 0 < a) (hb : 0 < b) :
    Real.log a - Real.log b ≤ (a - b) / b := by
  have h := Real.log_le_sub_one_of_pos (div_pos ha hb)
  rw [Real.log_div ha.ne' hb.ne'] at h
  convert h using 1
  field_simp

/-- A Lipschitz bound for the logarithm above a positive lower cutoff. -/
theorem abs_log_sub_le {a b l : ℝ} (hl : 0 < l) (hla : l ≤ a) (hlb : l ≤ b) :
    |Real.log a - Real.log b| ≤ |a - b| / l := by
  have ha := hl.trans_le hla
  have hb := hl.trans_le hlb
  by_cases hab : b ≤ a
  · rw [abs_of_nonneg (sub_nonneg.mpr (Real.log_le_log hb hab)),
      abs_of_nonneg (sub_nonneg.mpr hab)]
    exact (log_sub_le_div_sub ha hb).trans
      (div_le_div_of_nonneg_left (sub_nonneg.mpr hab) hl hlb)
  · have hba := le_of_lt (lt_of_not_ge hab)
    rw [abs_sub_comm (Real.log a), abs_sub_comm a,
      abs_of_nonneg (sub_nonneg.mpr (Real.log_le_log ha hba)),
      abs_of_nonneg (sub_nonneg.mpr hba)]
    exact (log_sub_le_div_sub hb ha).trans
      (div_le_div_of_nonneg_left (sub_nonneg.mpr hba) hl hla)

variable {X : Type*} [TopologicalSpace X] [CompactSpace X]
  [MeasurableSpace X] [BorelSpace X]
  (μ : Measure X) [IsProbabilityMeasure μ]

def logPartition (W : C(X, ℝ)) : ℝ := Real.log (∫ x, W x ∂μ)

/-- The mixed change caused by applying both density factors rather than
either one separately, with all four partition functions in the same volume. -/
def mixedResponse (W A B : C(X, ℝ)) : ℝ :=
  logPartition μ (W * (A * B)) + logPartition μ W -
    logPartition μ (W * A) - logPartition μ (W * B)

theorem expectation_pos (W A : C(X, ℝ)) (hW : ∀ x, 0 < W x) (hA : ∀ x, 0 < A x) :
    0 < expectation μ W A :=
  div_pos (partition_pos μ (W * A) (fun x => mul_pos (hW x) (hA x)))
    (partition_pos μ W hW)

/-- Exact identity relating the four partition functions to the two marked
observables in the unchanged law. -/
theorem mixedResponse_eq_log_expectations (W A B : C(X, ℝ))
    (hW : ∀ x, 0 < W x) (hA : ∀ x, 0 < A x) (hB : ∀ x, 0 < B x) :
    mixedResponse μ W A B =
      Real.log (expectation μ W (A * B)) -
        Real.log (expectation μ W A * expectation μ W B) := by
  have hZ := (partition_pos μ W hW).ne'
  have hZA := (partition_pos μ (W * A) (fun x => mul_pos (hW x) (hA x))).ne'
  have hZB := (partition_pos μ (W * B) (fun x => mul_pos (hW x) (hB x))).ne'
  have hZAB := (partition_pos μ (W * (A * B))
    (fun x => mul_pos (hW x) (mul_pos (hA x) (hB x)))).ne'
  rw [Real.log_mul (expectation_pos μ W A hW hA).ne'
    (expectation_pos μ W B hW hB).ne']
  simp only [expectation, mixedResponse, logPartition, ContinuousMap.mul_apply] at *
  rw [Real.log_div hZAB hZ, Real.log_div hZA hZ, Real.log_div hZB hZ]
  ring

/-- A lower pointwise bound survives the normalized positive density. -/
theorem lower_expectation (W A : C(X, ℝ)) (hW : ∀ x, 0 < W x)
    {l : ℝ} (hA : ∀ x, l ≤ A x) : l ≤ expectation μ W A := by
  simpa only [expectation_const μ W hW] using
    expectation_mono μ W (ContinuousMap.const X l) A hW hA

/-- The mixed boundary response is bounded by the actual covariance. The
normalization cost uses only lower bounds on the two boundary-change factors. -/
theorem abs_mixedResponse_le_covariance (W A B : C(X, ℝ))
    (hW : ∀ x, 0 < W x) {lA lB : ℝ} (hlA : 0 < lA) (hlB : 0 < lB)
    (hA : ∀ x, lA ≤ A x) (hB : ∀ x, lB ≤ B x) :
    |mixedResponse μ W A B| ≤ |covariance μ W A B| / (lA * lB) := by
  have hAp : ∀ x, 0 < A x := fun x => hlA.trans_le (hA x)
  have hBp : ∀ x, 0 < B x := fun x => hlB.trans_le (hB x)
  have hAB : lA * lB ≤ expectation μ W (A * B) :=
    lower_expectation μ W (A * B) hW (fun x => mul_le_mul (hA x) (hB x) hlB.le (hAp x).le)
  have hprod : lA * lB ≤ expectation μ W A * expectation μ W B :=
    mul_le_mul (lower_expectation μ W A hW hA) (lower_expectation μ W B hW hB)
      hlB.le (expectation_pos μ W A hW hAp).le
  rw [mixedResponse_eq_log_expectations μ W A B hW hAp hBp]
  exact abs_log_sub_le (mul_pos hlA hlB) hAB hprod

/-- Any established spatial covariance estimate transfers to the mixed
effective-action response with the explicit normalization factor. -/
theorem abs_mixedResponse_le_of_covariance (W A B : C(X, ℝ))
    (hW : ∀ x, 0 < W x) {lA lB C : ℝ} (hlA : 0 < lA) (hlB : 0 < lB)
    (hA : ∀ x, lA ≤ A x) (hB : ∀ x, lB ≤ B x)
    (hcov : |covariance μ W A B| ≤ C) :
    |mixedResponse μ W A B| ≤ C / (lA * lB) :=
  (abs_mixedResponse_le_covariance μ W A B hW hlA hlB hA hB).trans
    (div_le_div_of_nonneg_right hcov (mul_pos hlA hlB).le)

#print axioms mixedResponse_eq_log_expectations
#print axioms abs_mixedResponse_le_covariance

end Mettapedia.QuantumTheory.YangMills.WilsonBoundaryResponse
