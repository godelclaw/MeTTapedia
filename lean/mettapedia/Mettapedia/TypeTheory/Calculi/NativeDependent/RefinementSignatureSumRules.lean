/-!
# Complete native rule inclusions into a disjoint signature

All original local rules and their payloads are transported. Assumption
membership keeps its ordered position, and premise occurrences are unchanged.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.Calculi.NativeDependent.Refinement.SignatureSum

universe u
variable {S T : Symbols.{u}} {left : Signature S} {right : Signature T}

def hypothesisLeft :
    ∀ {n : Nat} {context : ContextExpr S n} {predicate : PropExpr S n},
      Hypothesis context predicate → Hypothesis (contextLeft (S := S) (T := T) context) (propLeft predicate)
  | _, _, _, .here context predicate => .here (contextLeft context) (propLeft predicate)
  | _, _, _, .assumptionThere member newer => .assumptionThere (hypothesisLeft member) (propLeft newer)
  | _, _, _, .variableThere member type => by
      simpa only [propLeft_rename, contextLeft] using
        Hypothesis.variableThere (hypothesisLeft member) (typeLeft type)

def judgmentLeft : Judgment S → Judgment (symbols S T)
  | .context context => .context (contextLeft context)
  | .type context type => .type (contextLeft context) (typeLeft type)
  | .term context term type => .term (contextLeft context) (termLeft term) (typeLeft type)
  | .substitution source target substitution => .substitution (contextLeft source) (contextLeft target) (substitutionLeft substitution)
  | .contextEq first second => .contextEq (contextLeft first) (contextLeft second)
  | .typeEq context first second => .typeEq (contextLeft context) (typeLeft first) (typeLeft second)
  | .termEq context first second type => .termEq (contextLeft context) (termLeft first) (termLeft second) (typeLeft type)
  | .substitutionEq source target first second => .substitutionEq (contextLeft source) (contextLeft target) (substitutionLeft first) (substitutionLeft second)
  | .predicate context predicate => .predicate (contextLeft context) (propLeft predicate)
  | .entails context predicate => .entails (contextLeft context) (propLeft predicate)
  | .predicateEq context first second => .predicateEq (contextLeft context) (propLeft first) (propLeft second)

