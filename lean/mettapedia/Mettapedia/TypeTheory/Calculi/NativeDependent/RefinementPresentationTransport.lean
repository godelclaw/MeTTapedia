import Mettapedia.TypeTheory.Calculi.NativeDependent.RefinementClassifyingEvidence
import Mettapedia.TypeTheory.Calculi.NativeDependent.RefinementSignatureExtensionFormation
import Mettapedia.TypeTheory.Calculi.NativeDependent.RefinementSignatureSumModel

/-!
# Restriction and transport along native presentation extensions

A presentation route is generated by identities, actual left-preserving
signature extensions and composition. Its syntax action uses the original
signature-sum inclusions; its derivation action retains every generated rule
and ordered premise. Restriction keeps each original primitive's full mixed
parameter scope, family, term section and predicate. Exact evaluator comparison
is earned from those local declaration projections.
-/

set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false

namespace Mettapedia.TypeTheory.Calculi.NativeDependent.Refinement.PresentationTransport

open _root_.CategoryTheory

universe u

variable {S T : Symbols.{u}} {C : Type u} [Category.{u} C]

/-- Retain the exact original declaration meanings, including dependent
values and satisfying assumption scopes. -/
def restrictLeft (model : ModelData (SignatureSum.symbols S T) C) : ModelData S C where
  typeParameters symbol := model.typeParameters (.inl symbol)
  typeFamily symbol := model.typeFamily (.inl symbol)
  termParameters symbol := model.termParameters (.inl symbol)
  termType symbol := model.termType (.inl symbol)
  termValue symbol := model.termValue (.inl symbol)
  predicateParameters symbol := model.predicateParameters (.inl symbol)
  predicateValue symbol := model.predicateValue (.inl symbol)

def restrictRight (model : ModelData (SignatureSum.symbols S T) C) : ModelData T C where
  typeParameters symbol := model.typeParameters (.inr symbol)
  typeFamily symbol := model.typeFamily (.inr symbol)
  termParameters symbol := model.termParameters (.inr symbol)
  termType symbol := model.termType (.inr symbol)
  termValue symbol := model.termValue (.inr symbol)
  predicateParameters symbol := model.predicateParameters (.inr symbol)
  predicateValue symbol := model.predicateValue (.inr symbol)

theorem recombine (model : ModelData (SignatureSum.symbols S T) C) :
    SignatureSum.model (restrictLeft model) (restrictRight model) = model := by
  cases model
  dsimp only [SignatureSum.model, restrictLeft, restrictRight]
  congr 1
  all_goals first
    | funext symbol; cases symbol <;> rfl
    | apply Function.hfunext rfl
      intro symbol other same
      cases eq_of_heq same
      cases symbol <;> rfl

variable (model : ModelData (SignatureSum.symbols S T) C)

theorem restrict_type {n : Nat} (expression : TypeExpr S n) (scope : Scope C n) :
    model.evaluateType scope (SignatureSum.typeLeft expression) =
      (restrictLeft model).evaluateType scope expression := by
  simpa only [recombine] using
    SignatureSum.evaluateType_left (restrictLeft model) (restrictRight model) expression scope

theorem restrict_term {n : Nat} (expression : TermExpr S n) (scope : Scope C n) :
    model.evaluateTerm scope (SignatureSum.termLeft expression) =
      (restrictLeft model).evaluateTerm scope expression := by
  simpa only [recombine] using
    SignatureSum.evaluateTerm_left (restrictLeft model) (restrictRight model) expression scope

theorem restrict_predicate {n : Nat} (expression : PropExpr S n) (scope : Scope C n) :
    model.evaluatePredicate scope (SignatureSum.propLeft expression) =
      (restrictLeft model).evaluatePredicate scope expression := by
  simpa only [recombine] using
    SignatureSum.evaluatePredicate_left (restrictLeft model) (restrictRight model) expression scope

theorem restrict_context {n : Nat} (expression : ContextExpr S n) :
    model.evaluateContext (SignatureSum.contextLeft expression) =
      (restrictLeft model).evaluateContext expression := by
  simpa only [recombine] using
    SignatureSum.evaluateContext_left (restrictLeft model) (restrictRight model) expression

variable {model}

theorem restrict_realization {source : Signature S}
    {target : Signature (SignatureSum.symbols S T)}
    (preserves : SignatureExtension.Preserves source target)
    (realization : SignatureRealization model target) :
    SignatureRealization (restrictLeft model) source where
  typeHeader symbol := by
    rw [← restrict_context, ← preserves.typeParameters]
    exact realization.typeHeader (.inl symbol)
  termHeader symbol := by
    rw [← restrict_context, ← preserves.termParameters]
    exact realization.termHeader (.inl symbol)
  predicateHeader symbol := by
    rw [← restrict_context, ← preserves.predicateParameters]
    exact realization.predicateHeader (.inl symbol)
  termResult symbol := by
    rw [← restrict_type, ← preserves.termResult]
    exact realization.termResult (.inl symbol)

structure Presentation where
  symbols : Symbols.{u}
  signature : Signature symbols

namespace Presentation

def of (signature : Signature S) : Presentation := ⟨S, signature⟩

end Presentation

/-- Routes retain the actual extension declarations rather than assuming
that two presentations have the same whole-expression semantics. -/
inductive Route : Presentation.{u} → Presentation.{u} → Type (u + 1) where
  | identity (source : Presentation) : Route source source
  | include (source : Presentation) (extra : Symbols.{u})
      (target : Signature (SignatureSum.symbols source.symbols extra))
      (preserves : SignatureExtension.Preserves source.signature target) :
      Route source ⟨SignatureSum.symbols source.symbols extra, target⟩
  | comp {source middle target : Presentation} (first : Route source middle)
      (second : Route middle target) : Route source target

namespace Route

variable {source middle target last : Presentation.{u}}

def type : {source target : Presentation.{u}} → Route source target → {n : Nat} → TypeExpr source.symbols n → TypeExpr target.symbols n
  | _, _, .identity _, _, expression => expression
  | _, _, .include _ _ _ _, _, expression => SignatureSum.typeLeft expression
  | _, _, .comp first second, _, expression => second.type (first.type expression)

def term : {source target : Presentation.{u}} → Route source target → {n : Nat} → TermExpr source.symbols n → TermExpr target.symbols n
  | _, _, .identity _, _, expression => expression
  | _, _, .include _ _ _ _, _, expression => SignatureSum.termLeft expression
  | _, _, .comp first second, _, expression => second.term (first.term expression)

def predicate : {source target : Presentation.{u}} → Route source target → {n : Nat} → PropExpr source.symbols n → PropExpr target.symbols n
  | _, _, .identity _, _, expression => expression
  | _, _, .include _ _ _ _, _, expression => SignatureSum.propLeft expression
  | _, _, .comp first second, _, expression => second.predicate (first.predicate expression)

def context : {source target : Presentation.{u}} → Route source target → {n : Nat} → ContextExpr source.symbols n → ContextExpr target.symbols n
  | _, _, .identity _, _, expression => expression
  | _, _, .include _ _ _ _, _, expression => SignatureSum.contextLeft expression
  | _, _, .comp first second, _, expression => second.context (first.context expression)

def judgment : {source target : Presentation.{u}} → Route source target → Judgment source.symbols → Judgment target.symbols
  | _, _, .identity _, expression => expression
  | _, _, .include _ _ _ _, expression => SignatureSum.judgmentLeft expression
  | _, _, .comp first second, expression => second.judgment (first.judgment expression)

def derivation : {source target : Presentation.{u}} → (route : Route source target) → {expression : Judgment source.symbols} →
    Derivation source.signature expression → Derivation target.signature (route.judgment expression)
  | _, _, .identity _, _, tree => tree
  | _, _, .include _ _ _ preserves, _, tree => SignatureExtension.derivation _ _ preserves tree
  | _, _, .comp first second, _, tree => second.derivation (first.derivation tree)

def restrict : {source target : Presentation.{u}} → Route source target → ModelData target.symbols C → ModelData source.symbols C
  | _, _, .identity _, model => model
  | _, _, .include _ _ _ _, model => restrictLeft model
  | _, _, .comp first second, model => first.restrict (second.restrict model)

theorem realization : {source target : Presentation.{u}} → (route : Route source target) → (model : ModelData target.symbols C) →
    SignatureRealization model target.signature → SignatureRealization (route.restrict model) source.signature
  | _, _, .identity _, _, realized => realized
  | _, _, .include _ _ _ preserves, _, realized => restrict_realization preserves realized
  | _, _, .comp first second, model, realized => first.realization _ (second.realization model realized)

theorem evaluateType : {source target : Presentation.{u}} → (route : Route source target) → (model : ModelData target.symbols C) →
    {n : Nat} → (expression : TypeExpr source.symbols n) → (scope : Scope C n) →
    model.evaluateType scope (route.type expression) = (route.restrict model).evaluateType scope expression
  | _, _, .identity _, _, _, _, _ => rfl
  | _, _, .include _ _ _ _, model, _, expression, scope => restrict_type model expression scope
  | _, _, .comp first second, model, _, expression, scope =>
      (second.evaluateType model (first.type expression) scope).trans
        (first.evaluateType (second.restrict model) expression scope)

theorem evaluateTerm : {source target : Presentation.{u}} → (route : Route source target) → (model : ModelData target.symbols C) →
    {n : Nat} → (expression : TermExpr source.symbols n) → (scope : Scope C n) →
    model.evaluateTerm scope (route.term expression) = (route.restrict model).evaluateTerm scope expression
  | _, _, .identity _, _, _, _, _ => rfl
  | _, _, .include _ _ _ _, model, _, expression, scope => restrict_term model expression scope
  | _, _, .comp first second, model, _, expression, scope =>
      (second.evaluateTerm model (first.term expression) scope).trans
        (first.evaluateTerm (second.restrict model) expression scope)

theorem evaluatePredicate : {source target : Presentation.{u}} → (route : Route source target) → (model : ModelData target.symbols C) →
    {n : Nat} → (expression : PropExpr source.symbols n) → (scope : Scope C n) →
    model.evaluatePredicate scope (route.predicate expression) =
      (route.restrict model).evaluatePredicate scope expression
  | _, _, .identity _, _, _, _, _ => rfl
  | _, _, .include _ _ _ _, model, _, expression, scope => restrict_predicate model expression scope
  | _, _, .comp first second, model, _, expression, scope =>
      (second.evaluatePredicate model (first.predicate expression) scope).trans
        (first.evaluatePredicate (second.restrict model) expression scope)

theorem evaluateContext : {source target : Presentation.{u}} → (route : Route source target) → (model : ModelData target.symbols C) →
    {n : Nat} → (expression : ContextExpr source.symbols n) →
    model.evaluateContext (route.context expression) = (route.restrict model).evaluateContext expression
  | _, _, .identity _, _, _, _ => rfl
  | _, _, .include _ _ _ _, model, _, expression => restrict_context model expression
  | _, _, .comp first second, model, _, expression =>
      (second.evaluateContext model (first.context expression)).trans
        (first.evaluateContext (second.restrict model) expression)

def substitution (route : Route source target) {n m : Nat}
    (mapping : Substitution source.symbols n m) : Substitution target.symbols n m :=
  fun position => route.term (mapping position)

theorem evaluateSubstitution (route : Route source target) (model : ModelData target.symbols C)
    {n m : Nat} (first : Scope C n) (last : Scope C m) (mapping : Substitution source.symbols m n) :
    model.evaluateSubstitution first last (route.substitution mapping) =
      (route.restrict model).evaluateSubstitution first last mapping := by
  unfold ModelData.evaluateSubstitution
  apply congrArg (ScopeData.assemble? last.2)
  funext position
  exact route.evaluateTerm model (mapping position) first

omit [Category C] in
@[simp] theorem judgment_term (route : Route source target) {n : Nat}
    (rawContext : ContextExpr source.symbols n) (rawTerm : TermExpr source.symbols n)
    (rawType : TypeExpr source.symbols n) :
    route.judgment (.term rawContext rawTerm rawType) =
      .term (route.context rawContext) (route.term rawTerm) (route.type rawType) := by
  induction route with
  | identity => rfl
  | «include» => rfl
  | comp first second earlier later =>
      simpa only [judgment, context, term, type] using
        (congrArg second.judgment (earlier rawContext rawTerm rawType)).trans
          (later (first.context rawContext) (first.term rawTerm) (first.type rawType))

def termDerivation (route : Route source target) {n : Nat}
    {rawContext : ContextExpr source.symbols n} {rawTerm : TermExpr source.symbols n}
    {rawType : TypeExpr source.symbols n}
    (tree : Derivation source.signature (.term rawContext rawTerm rawType)) :
    Derivation target.signature (.term (route.context rawContext) (route.term rawTerm) (route.type rawType)) :=
  cast (congrArg (Derivation target.signature) (judgment_term route rawContext rawTerm rawType))
    (route.derivation tree)

omit [Category C] in
@[simp] theorem type_identity {n : Nat} (expression : TypeExpr source.symbols n) :
    (identity source).type expression = expression := rfl

omit [Category C] in
@[simp] theorem term_identity {n : Nat} (expression : TermExpr source.symbols n) :
    (identity source).term expression = expression := rfl

omit [Category C] in
@[simp] theorem context_identity {n : Nat} (expression : ContextExpr source.symbols n) :
    (identity source).context expression = expression := rfl

@[simp] theorem restrict_identity (model : ModelData source.symbols C) :
    (identity source).restrict model = model := rfl

omit [Category C] in
@[simp] theorem type_comp (first : Route source middle) (second : Route middle target)
    {n : Nat} (expression : TypeExpr source.symbols n) :
    (first.comp second).type expression = second.type (first.type expression) := rfl

omit [Category C] in
@[simp] theorem term_comp (first : Route source middle) (second : Route middle target)
    {n : Nat} (expression : TermExpr source.symbols n) :
    (first.comp second).term expression = second.term (first.term expression) := rfl

omit [Category C] in
@[simp] theorem context_comp (first : Route source middle) (second : Route middle target)
    {n : Nat} (expression : ContextExpr source.symbols n) :
    (first.comp second).context expression = second.context (first.context expression) := rfl

@[simp] theorem restrict_comp (first : Route source middle) (second : Route middle target)
    (model : ModelData target.symbols C) :
    (first.comp second).restrict model = first.restrict (second.restrict model) := rfl

omit [Category C] in
theorem type_assoc (first : Route source middle) (second : Route middle target) (third : Route target last)
    {n : Nat} (expression : TypeExpr source.symbols n) :
    ((first.comp second).comp third).type expression =
      (first.comp (second.comp third)).type expression := rfl

theorem restrict_assoc (first : Route source middle) (second : Route middle target)
    (third : Route target last) (model : ModelData last.symbols C) :
    ((first.comp second).comp third).restrict model =
      (first.comp (second.comp third)).restrict model := rfl

section Classifying

noncomputable section

variable (route : Route source target) (model : ModelData target.symbols C)
    (realized : SignatureRealization model target.signature)
variable {n : Nat} (rawContext : ContextExpr source.symbols n) (rawTerm : TermExpr source.symbols n)
    (rawType : TypeExpr source.symbols n) (scope : Scope C n)
    (meaning : NativeLocalTypeFormers.NativeType scope.1)
    (contextRead : (route.restrict model).evaluateContext rawContext = some scope)
    (typeRead : (route.restrict model).evaluateType scope rawType = some meaning)
    {program : Cᵒᵖ ⥤ Type u} (interface : program ⟶ scope.1)

/-- Source interpretation is constructed by actual declaration restriction. -/
def sourceClient : RefinementPresheafCertificates.Interpretation
    source.signature rawContext rawTerm rawType program where
  model := route.restrict model
  realization := route.realization model realized
  semanticContext := scope
  semanticType := meaning
  contextRead := contextRead
  typeRead := typeRead
  interface := interface

/-- Target interpretation receives the translated source expression and the
same complete dependent semantic environment. -/
def targetClient : RefinementPresheafCertificates.Interpretation
    target.signature (route.context rawContext) (route.term rawTerm) (route.type rawType) program where
  model := model
  realization := realized
  semanticContext := scope
  semanticType := meaning
  contextRead := (route.evaluateContext model rawContext).trans contextRead
  typeRead := (route.evaluateType model rawType scope).trans typeRead
  interface := interface

/-- The full generated classifying interpretation is natural across the
presentation route. Its derivation translation is independent of evaluation. -/
theorem classifying_sections (sourceHeaders : HeaderFormation source.signature)
    (targetHeaders : HeaderFormation target.signature)
    (tree : Derivation source.signature (.term rawContext rawTerm rawType)) :
    (targetClient route model realized rawContext rawTerm rawType scope meaning contextRead typeRead interface).classifyingSection targetHeaders (route.termDerivation tree) =
    (sourceClient route model realized rawContext rawTerm rawType scope meaning contextRead typeRead interface).classifyingSection sourceHeaders tree := by
  rw [RefinementPresheafCertificates.Interpretation.classifyingSection_eq_nativeSection,
    RefinementPresheafCertificates.Interpretation.classifyingSection_eq_nativeSection]
  have firstRead := (targetClient route model realized rawContext rawTerm rawType scope meaning
    contextRead typeRead interface).nativeSection_readout (route.termDerivation tree)
  have secondRead := (sourceClient route model realized rawContext rawTerm rawType scope meaning
    contextRead typeRead interface).nativeSection_readout tree
  have same := Option.some.inj
    (firstRead.symm.trans ((route.evaluateTerm model rawTerm scope).trans secondRead))
  exact eq_of_heq (Sigma.mk.inj same).2

/-- The all-expression comparison includes arbitrary program clients and
retains the whole section, not merely membership of selected heads. -/
theorem classifying_client_sections (sourceHeaders : HeaderFormation source.signature)
    (targetHeaders : HeaderFormation target.signature)
    (tree : Derivation source.signature (.term rawContext rawTerm rawType)) :
    (targetClient route model realized rawContext rawTerm rawType scope meaning contextRead typeRead interface).classifyingValueSection targetHeaders (route.termDerivation tree) =
    (sourceClient route model realized rawContext rawTerm rawType scope meaning contextRead typeRead interface).classifyingValueSection sourceHeaders tree :=
  congrArg (DisplayedPresheafComprehension.reindexDisplayedSection interface meaning.decoded)
    (classifying_sections route model realized rawContext rawTerm rawType scope meaning
      contextRead typeRead interface sourceHeaders targetHeaders tree)

end
end Classifying

end Route
end Mettapedia.TypeTheory.Calculi.NativeDependent.Refinement.PresentationTransport
