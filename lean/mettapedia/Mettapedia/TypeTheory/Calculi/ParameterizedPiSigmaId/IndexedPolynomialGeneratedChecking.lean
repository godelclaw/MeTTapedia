import Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.IndexedPolynomialGeneratedReceipts
import Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.SchemaTableConversionCode

/-!
# Generated recursor rules in the common finite conversion checker

The table is the constructor inventory produced by the existing generator.
Its independently defined iota relation is exactly the support of those
schema instances. The common decoder consequently checks finite conversion
recipes for that relation, including occurrences below binders.

Root replay grants no typing or declaration admission. The annotated typed
receipts retain their separate telescope and declaration-policy obligations.
No indexed or mutual guest recursor is generated by this adapter.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
namespace IndexedPolynomialGenerated.Checking

open AlgebraicSchema TypedEquality Normalization Annotated

variable {Head : Type}

abbrev table (ctors : List (DeclName × List (Field Head))) (rec : DeclName) :
    SchemaTable Head := schemas ctors rec

/-- The generator's own computation relation is presented by its complete
finite inventory. The checker does not define that source relation. -/
theorem presents (ctors : List (DeclName × List (Field Head))) (rec : DeclName)
    {n : Nat} {left right : Tm Head n} :
    (iotaComputation rec ctors).step left right ↔
      SchemaStep (table ctors rec).family left right := by
  rw [iota_presents rec ctors]
  constructor
  · intro step
    cases step with
    | instantiate rule assignment =>
        exact .instantiate ((schemas_complete ctors rec _ _).mpr rule) assignment
  · intro step
    cases step with
    | instantiate rule assignment =>
        exact .instantiate ((schemas_complete ctors rec _ _).mp rule) assignment

def decoder (ctors : List (DeclName × List (Field Head))) (rec : DeclName) :
    StructuralConversionCode.RootDecoder (iotaComputation rec ctors) :=
  SchemaTableConversionCode.presentedDecoder (table ctors rec)
    (iotaComputation rec ctors) (presents ctors rec)

@[simp] theorem table_length (ctors : List (DeclName × List (Field Head))) (rec : DeclName) :
    (table ctors rec).length = ctors.length := by simp [table, schemas]

/-- Looking up a generated source occurrence recovers its actual schema,
including its original ordinal and fields. -/
theorem table_get {ctors : List (DeclName × List (Field Head))}
    (origin : Origin ctors) (rec : DeclName) :
    (table ctors rec).get ⟨origin.index, by simpa using origin.index_lt⟩ =
      origin.schema rec := by
  obtain ⟨index, name, fields, lookup⟩ := origin
  have row := (List.getElem?_eq_some_iff.mp lookup).2
  simp only [table, schemas, origins, List.get_eq_getElem, List.getElem_map,
    List.getElem_ofFn]
  exact congrArg (fun entry : DeclName × List (Field Head) =>
    (⟨1 + ctors.length + entry.2.length,
      iotaLeft rec entry.1 ctors.length entry.2.length,
      iotaRight rec ctors.length index entry.2⟩ : Schema Head)) row

/-- Serialize the generated receipt's source ordinal and complete assignment.
The argument list is in de Bruijn order, as required by common replay. -/
def receiptCode {ctors : List (DeclName × List (Field Head))} {n : Nat}
    (receipt : Receipt ctors n) : SchemaTableConversionCode.Code Head n :=
  ⟨receipt.origin.index, List.ofFn receipt.assignment⟩

theorem receiptCode_accepted {ctors : List (DeclName × List (Field Head))} {n : Nat}
    (receipt : Receipt ctors n) (rec : DeclName) :
    (decoder ctors rec).decode (receiptCode receipt) =
      some (receipt.left rec, receipt.right rec) := by
  change SchemaTableConversionCode.decode (table ctors rec) (fun _ => true)
    (receiptCode receipt) = _
  exact SchemaTableConversionCode.decode_at (table ctors rec) _
    ⟨receipt.origin.index, by simpa using receipt.origin.index_lt⟩ rfl
    (table_get receipt.origin rec) receipt.assignment

variable [DecidableEq Head]

abbrev Code (n : Nat) :=
  StructuralConversionCode.Code Head (SchemaTableConversionCode.Code Head) n

def check (ctors : List (DeclName × List (Field Head))) (rec : DeclName)
    {n : Nat} (code : Code (Head := Head) n) (left right : Tm Head n) : Bool :=
  code.check Eq (decoder ctors rec).decode left right

/-- Conversion is the existing beta/congruence closure with the generated
iota roots. This exactness concerns finite certificates, not proof search. -/
theorem conversion_iff_checked (ctors : List (DeclName × List (Field Head))) (rec : DeclName)
    {n : Nat} (left right : Tm Head n) :
    Conv Eq left right (iotaComputation rec ctors) ↔
      ∃ code, check ctors rec code left right = true :=
  StructuralConversionCode.Code.conversion_iff_checked (decoder ctors rec)

/-- A generated receipt becomes an ordinary common single-step recipe.
The row and assignment are preserved rather than searched for again. -/
def receiptRecipe {ctors : List (DeclName × List (Field Head))} {n : Nat}
    (receipt : Receipt ctors n) : Code (Head := Head) n :=
  .single (.root (receiptCode receipt))

theorem receiptRecipe_accepted {ctors : List (DeclName × List (Field Head))} {n : Nat}
    (receipt : Receipt ctors n) (rec : DeclName) :
    check ctors rec (receiptRecipe receipt) (receipt.left rec) (receipt.right rec) = true := by
  simp [check, receiptRecipe, StructuralConversionCode.Code.check,
    StructuralConversionCode.Code.decode, StructuralConversionCode.StepCode.decode,
    receiptCode_accepted]

end IndexedPolynomialGenerated.Checking
end Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
