import Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.TypedEquality.Annotated.JudgmentCode
import Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.TypedEquality.Annotated.SchemaTable

/-!
# Annotated root citations with their actual argument premises

A submission cites an original schema-table address and a finite list of
annotated arguments. Decoding retains lambda domains and returns the actual
premises generated by the existing schema annotation. Permissions and arity
are checked before any declaration step can be replayed.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
namespace TypedEquality.Annotated.SchemaJudgmentCode

open AlgebraicSchema
variable {Head : Type} {n : Nat}

structure Code (Head : Type) (n : Nat) where
  row : Nat
  arguments : List (CTm Head n)
  deriving DecidableEq

def argumentSub {arity : Nat} (arguments : List (CTm Head n))
    (length : arguments.length = arity) : CSub Head arity n :=
  fun index => arguments[index.val]'(by omega)

@[simp] theorem argumentSub_ofFn {arity : Nat} (substitution : CSub Head arity n) :
    argumentSub (List.ofFn substitution) (by simp) = substitution := by
  funext index
  simp [argumentSub]

structure Instance (table : AlgebraicSchema.SchemaTable Head)
    (enabled : Fin table.length → Bool) (n : Nat) where
  index : Fin table.length
  permitted : enabled index = true
  substitution : CSub Head (table.get index).1 n

def Instance.result (decls : DeclName → Option (CTm Head 0))
    {table : AlgebraicSchema.SchemaTable Head} {enabled : Fin table.length → Bool}
    (parsed : Instance table enabled n) : Checking.RootResult Head n :=
  ⟨(elabLeft decls (table.get parsed.index).2.1).subst parsed.substitution,
    (elabRight decls (table.get parsed.index).2.1 (table.get parsed.index).2.2).subst parsed.substitution,
    patternPremises decls (table.get parsed.index).2.1 parsed.substitution⟩

def decodeInstance (table : AlgebraicSchema.SchemaTable Head) (enabled : Fin table.length → Bool)
    (code : Code Head n) : Option (Instance table enabled n) :=
  if bound : code.row < table.length then
    let index : Fin table.length := ⟨code.row, bound⟩
    if permitted : enabled index = true then
      if length : code.arguments.length = (table.get index).1 then
        some ⟨index, permitted, argumentSub code.arguments length⟩
      else none
    else none
  else none

def decode (decls : DeclName → Option (CTm Head 0))
    (table : AlgebraicSchema.SchemaTable Head) (enabled : Fin table.length → Bool)
    (code : Code Head n) : Option (Checking.RootResult Head n) :=
  (decodeInstance table enabled code).map (Instance.result decls)

def encode (table : AlgebraicSchema.SchemaTable Head) (index : Fin table.length)
    (substitution : CSub Head (table.get index).1 n) : Code Head n :=
  ⟨index.val, List.ofFn substitution⟩

theorem decode_encode (decls : DeclName → Option (CTm Head 0))
    (table : AlgebraicSchema.SchemaTable Head) (enabled : Fin table.length → Bool)
    (index : Fin table.length) (permitted : enabled index = true)
    (substitution : CSub Head (table.get index).1 n) :
    decode decls table enabled (encode table index substitution) =
      some (Instance.result decls ⟨index, permitted, substitution⟩) := by
  simp [decode, decodeInstance, encode, index.isLt, permitted]

theorem Instance.sound (decls : DeclName → Option (CTm Head 0))
    {table : AlgebraicSchema.SchemaTable Head} {enabled : Fin table.length → Bool}
    (parsed : Instance table enabled n) :
    (elaboratedComputation decls (SchemaTableConversionCode.selectedFamily table enabled)).step
        (parsed.result decls).left (parsed.result decls).right ∧
      (elaboratedComputation decls (SchemaTableConversionCode.selectedFamily table enabled)).requires
        (parsed.result decls).left (parsed.result decls).right (parsed.result decls).premises := by
  have selected : SchemaTableConversionCode.selectedFamily table enabled
      (table.get parsed.index).2.1 (table.get parsed.index).2.2 :=
    ⟨parsed.index, parsed.permitted, rfl⟩
  exact ⟨.instantiate ⟨_, _, selected, rfl, rfl⟩ parsed.substitution,
    .instantiate selected parsed.substitution⟩

def decoder (decls : DeclName → Option (CTm Head 0))
    (table : AlgebraicSchema.SchemaTable Head) (enabled : Fin table.length → Bool) :
    Checking.RootDecoder (elaboratedComputation decls (SchemaTableConversionCode.selectedFamily table enabled)) where
  Code := Code Head
  decode := decode decls table enabled
  sound := by
    intro n code result accepted
    obtain ⟨parsed, _, rfl⟩ := Option.map_eq_some_iff.mp accepted
    exact parsed.sound decls
  complete := by
    intro n left right premises _ required
    cases required with
    | @instantiate arity L R selected substitution =>
        obtain ⟨index, permitted, row⟩ := selected
        have evidence : ∀ (schema : (arity : Nat) × (Tm Head arity × Tm Head arity))
            (same : table.get index = schema)
            (assignment : CSub Head schema.1 n),
            ∃ code, decode decls table enabled code = some
              ⟨(elabLeft decls schema.2.1).subst assignment,
                (elabRight decls schema.2.1 schema.2.2).subst assignment,
                patternPremises decls schema.2.1 assignment⟩ := by
          intro schema same assignment
          subst schema
          exact ⟨encode table index assignment, decode_encode decls table enabled index permitted assignment⟩
        exact evidence ⟨arity, L, R⟩ row substitution

#print axioms decode_encode
#print axioms decoder

end TypedEquality.Annotated.SchemaJudgmentCode
end Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
