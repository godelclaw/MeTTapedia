import Mettapedia.TypeTheory.Calculi.CumulativePiSigmaId.Declarations.NativeNaturalVectorComputationProfiles
import Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.TypedEquality.Annotated.SchemaTable
import Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.TypedEquality.Annotated.Validity

/-!
# The selected Nat/Vec roots in the existing annotated calculus

Opaque declarations and a root-free base expose exactly the selected schema
instances. Their Church annotation is generated by the maintained schema
interface. Nat's two patterns satisfy its uniform lifting condition; the
vector patterns repeat parameters and need a distinct coherence argument.

The comparison concerns root computation and its required premises. It does
not grant typed equality, subject preservation or normalization merely from
erasure or syntactic pattern classification.
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.Calculi.CumulativePiSigmaId.NativeNaturalVectorFamilies
namespace Programs.Annotated

open Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
open TypedEquality TypedEquality.Annotated

def family (enabled : ComputationProfiles.Selection) : AlgebraicSchema.SchemaFamily Tower.Head :=
  SchemaTableConversionCode.selectedFamily Checking.table enabled

theorem opaque_values (enabled : ComputationProfiles.Selection) (name : DeclName) :
    (ComputationProfiles.signature enabled).valueOf? name = none := by
  change (rawSignature.instantiateLevels levels iotaComputation).valueOf? name = none
  rw [Declaration.Signature.valueOf_instantiateLevels, rawSignature_valueOf_none]
  rfl

theorem presentation (enabled : ComputationProfiles.Selection) :
    Presents (ComputationProfiles.rules enabled).computation (family enabled) := by
  intro n left right
  exact (DeclarationConversionCode.opaque_roots_iff Tower.rules
    (ComputationProfiles.signature enabled) (fun impossible => impossible.elim)
    (opaque_values enabled)).trans (SchemaTableConversionCode.selected_roots_iff Checking.table enabled)

def church (enabled : ComputationProfiles.Selection) : ChurchRules (ComputationProfiles.rules enabled) :=
  ChurchRules.ofSchemas _ (family enabled) (presentation enabled)

/-- Changing root permissions retains the same annotated declarations. -/
theorem constantType_eq (enabled : ComputationProfiles.Selection) :
    (church enabled).constantType = (church (fun _ => false)).constantType := rfl

/-- Enlarging computation permissions preserves declarations, universe
policy and every original root premise through the common package interface. -/
theorem permissions_morphism {small large : ComputationProfiles.Selection}
    (included : ∀ index, small index = true → large index = true) :
    (church small).Morphism (church large) (fun head => head) := by
  apply ChurchRules.ofSchemas_morphism (presentation small) (presentation large)
    (Declaration.extensionMorphism Tower.rules (ComputationProfiles.permissions_mono included)) rfl
  rintro arity left right ⟨index, permitted, row⟩
  exact ⟨index, included index permitted, row⟩

/-- The complete statement, including context and displayed type, crosses
an admitted permission edge. No reverse transport is asserted. -/
theorem judgment_mono {small large : ComputationProfiles.Selection}
    (included : ∀ index, small index = true → large index = true)
    {statement : CStatement Tower.Head} (derived : CDerivable (church small) statement) :
    CDerivable (church large) statement := by
  simpa only [CStatement.mapHead_id] using derived.mapHead (permissions_morphism included)

theorem context_mono {small large : ComputationProfiles.Selection}
    (included : ∀ index, small index = true → large index = true)
    {n : Nat} {context : CCtx Tower.Head n} (formed : CCtxFormed (church small) context) :
    CCtxFormed (church large) context := by
  induction formed with
  | nil => exact .nil
  | snoc _ domain induction =>
    obtain ⟨u, isUniverse, typed⟩ := domain
    exact .snoc induction ⟨u, isUniverse, judgment_mono included typed⟩

theorem substitution_mono {small large : ComputationProfiles.Selection}
    (included : ∀ index, small index = true → large index = true)
    {n m : Nat} {source : CCtx Tower.Head n} {target : CCtx Tower.Head m}
    {assignment : CSub Tower.Head n m} (typed : CSubstMor (church small) source target assignment) :
    CSubstMor (church large) source target assignment :=
  fun index => judgment_mono included (typed index)

theorem erase_root (enabled : ComputationProfiles.Selection) {n : Nat}
    {left right : CTm Tower.Head n} (step : (church enabled).computation.step left right) :
    (ComputationProfiles.rules enabled).computation.step left.erase right.erase :=
  (church enabled).erase_step step

theorem natural_patterns_linear :
    SchemaTable.linearCheck Checking.table ComputationProfiles.naturalOnly = true := by decide

/-- Both natural rows lift at every annotated input, with annotations on
substituted arguments retained. No typing assumption is needed for this step. -/
theorem lift_natural_root {n : Nat} {left : CTm Tower.Head n} {right : Tower.Tm n}
    (step : (ComputationProfiles.rules ComputationProfiles.naturalOnly).computation.step
      left.erase right) :
    ∃ result, (church ComputationProfiles.naturalOnly).computation.step left result ∧
      result.erase = right :=
  SchemaTable.root_lift Checking.table ComputationProfiles.naturalOnly
    (presentation _) natural_patterns_linear step

theorem vector_nil_repeats_parameter :
    AlgebraicSchema.variableMultiplicity (3 : Fin 4) vecNilIotaLeft = 2 := by decide

theorem vector_cons_repeats_parameter :
    AlgebraicSchema.variableMultiplicity (6 : Fin 7) vecConsIotaLeft = 2 := by decide

theorem vector_cons_repeats_index :
    AlgebraicSchema.variableMultiplicity (2 : Fin 7) vecConsIotaLeft = 2 := by decide

def verdicts : List (String × Bool) := [
  ("natural checking roots meet annotation lifting condition",
    SchemaTable.linearCheck Checking.table ComputationProfiles.naturalOnly),
  ("vector execution roots need a different lifting argument",
    !(SchemaTable.linearCheck Checking.table (fun _ => true))),
  ("vector nil repeats its payload type parameter",
    decide (AlgebraicSchema.variableMultiplicity (3 : Fin 4) vecNilIotaLeft = 2)),
  ("vector cons repeats its payload type parameter",
    decide (AlgebraicSchema.variableMultiplicity (6 : Fin 7) vecConsIotaLeft = 2)),
  ("vector cons repeats its length index",
    decide (AlgebraicSchema.variableMultiplicity (2 : Fin 7) vecConsIotaLeft = 2))]

theorem all_verdicts : verdicts.all Prod.snd = true := by decide

end Programs.Annotated
end Mettapedia.TypeTheory.Calculi.CumulativePiSigmaId.NativeNaturalVectorFamilies
