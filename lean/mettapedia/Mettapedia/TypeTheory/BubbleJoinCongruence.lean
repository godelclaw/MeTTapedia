import Mettapedia.TypeTheory.BubbleJoin
import Mettapedia.TypeTheory.HypercubeBubbles
import Mettapedia.GSLT.LanguageDef.StructuralCoproduct
import Mettapedia.OSLF.MeTTaIL.DerivedContexts
import Mathlib.Data.Set.Disjoint

/-!
# Joins of bubbles in an abstract rewriting setting

A bubble is a relation of root steps; its definitional equality is the
equivalence closure of those steps taken at every position.  This module
states the join algebra of bubbles once, for any congruence closure, and
instantiates it on the three term representations that carry bubbles.

* `CongruenceClosure` axiomatizes "steps at every position": a root step is a
  step, the closure is monotone, a step of a union of rule relations is a step
  of one of them, and a closed equivalence is closed under the closure.
* Over any congruence closure: each bubble's conversion is a conversion of the
  join, the join is the least upper bound in the conversion order, and
  decisions compose when the first normal form respects the second bubble
  (`CongruenceClosure.join_normalizedBy`).  Every bubble is normalized by a
  choice of representatives (`CongruenceClosure.exists_normalizedBy`), so a
  normalization theorem is a statement about a particular function.
* `SubstitutiveClosure` adds a substitution action under which the closure of
  stable rules is stable; stability of joins follows (`join_stable`).
* Signatures: a schema mentions a symbol when the symbol occurs in each of its
  instances (`Mentions`); a bubble presented by a family of schemas has the
  symbols its inhabited schemas mention (`Signature`), bounded by the symbols
  of any one instance per schema (`signature_subset`).  A bubble is rooted in a
  set of symbols when every redex is headed by one of them (`RootedIn`).

Instances:

* the HOL core (`exprSubstitutive`): its closure is the bubble rewriting of
  `BubbleConversion`, and the abstract conversion, join and normalization are
  the existing ones.  The arithmetic recursion bubble has a signature
  disjoint from every bubble written in logical formers
  (`Arith.rule_disjoint_of_logical`), the logical bubble `¬⊤ ↦ ⊥` among them;
  the recursion bubble and the zero-swap bubble share addition.
* pure type systems (`ptermSubstitutive`): the type-level and term-level beta
  bubbles mention disjoint binder sorts, and their join is beta conversion
  (`join_typeBeta_termBeta_conv`).
* patterns of language definitions (`patternClosure`): the bubble of a
  structural coproduct is the join of the bubbles of its renamed summands, and
  the redexes of the two summands are headed by disjoint constructor images
  (`coproduct_bubbles_disjoint`).
-/

set_option autoImplicit false

namespace Mettapedia.TypeTheory.BubbleJoinCongruence

open Relation

universe u v w

/-! ## Congruence closures -/

/-- Steps of a root-rule relation at every position of a term. -/
structure CongruenceClosure (Term : Type u) where
  /-- One step of a rule relation at some position. -/
  step : (Term → Term → Prop) → Term → Term → Prop
  root : ∀ {rules : Term → Term → Prop} {source target : Term},
    rules source target → step rules source target
  mono : ∀ {small large : Term → Term → Prop},
    (∀ source target, small source target → large source target) →
      ∀ {source target : Term}, step small source target → step large source target
  /-- A step of a union of rule relations is a step of one of them. -/
  split : ∀ {first second : Term → Term → Prop} {source target : Term},
    step (fun left right => first left right ∨ second left right) source target →
      step first source target ∨ step second source target
  /-- The equivalence generated by the steps is closed under positions. -/
  congr : ∀ {rules : Term → Term → Prop} {source target : Term},
    step (EqvGen (step rules)) source target → EqvGen (step rules) source target

namespace CongruenceClosure

variable {Term : Type u} (closure : CongruenceClosure Term)

/-- The definitional equality of a bubble. -/
abbrev Conv (rules : Term → Term → Prop) : Term → Term → Prop :=
  EqvGen (closure.step rules)

/-- The join of two bubbles declares the steps of both. -/
def join (first second : Term → Term → Prop) : Term → Term → Prop :=
  fun left right => first left right ∨ second left right

variable {closure}

theorem conv_mono {small large : Term → Term → Prop}
    (included : ∀ source target, small source target → large source target)
    {source target : Term} (converted : closure.Conv small source target) :
    closure.Conv large source target :=
  EqvGen.mono (fun _ _ stepped => closure.mono included stepped) source target converted

/-- Conversions of one bubble are conversions of another once every root rule
of the first is a conversion of the second. -/
theorem conv_into {small large : Term → Term → Prop}
    (into : ∀ source target, small source target → closure.Conv large source target)
    {source target : Term} (converted : closure.Conv small source target) :
    closure.Conv large source target := by
  induction converted with
  | rel _ _ stepped => exact closure.congr (closure.mono into stepped)
  | refl => exact EqvGen.refl _
  | symm _ _ _ inductionHypothesis => exact EqvGen.symm _ _ inductionHypothesis
  | trans _ _ _ _ _ first second => exact EqvGen.trans _ _ _ first second

variable {first second : Term → Term → Prop}

theorem conv_join_left {source target : Term} (converted : closure.Conv first source target) :
    closure.Conv (join first second) source target :=
  conv_mono (fun _ _ rule => Or.inl rule) converted

theorem conv_join_right {source target : Term} (converted : closure.Conv second source target) :
    closure.Conv (join first second) source target :=
  conv_mono (fun _ _ rule => Or.inr rule) converted

/-- **The join is the least upper bound in the conversion order.** -/
theorem conv_join_least {large : Term → Term → Prop}
    (fromFirst : ∀ {source target : Term},
      closure.Conv first source target → closure.Conv large source target)
    (fromSecond : ∀ {source target : Term},
      closure.Conv second source target → closure.Conv large source target)
    {source target : Term} (converted : closure.Conv (join first second) source target) :
    closure.Conv large source target :=
  conv_into (fun _ _ rule => rule.elim
      (fun inFirst => fromFirst (EqvGen.rel _ _ (closure.root inFirst)))
      (fun inSecond => fromSecond (EqvGen.rel _ _ (closure.root inSecond))))
    converted

/-- A step of the join is a conversion of one of the two bubbles. -/
theorem step_join_cases {source target : Term}
    (stepped : closure.step (join first second) source target) :
    closure.Conv first source target ∨ closure.Conv second source target :=
  (closure.split stepped).imp (EqvGen.rel _ _) (EqvGen.rel _ _)

/-- A bubble is normalized by a function when every term converts to its image
and conversion keeps the image. -/
def NormalizedBy (closure : CongruenceClosure Term) (rules : Term → Term → Prop)
    (normal : Term → Term) : Prop :=
  (∀ term, closure.Conv rules term (normal term)) ∧
    ∀ term term', closure.Conv rules term term' → normal term = normal term'

/-- A bubble normalized by a function is decided by it. -/
theorem NormalizedBy.conv_iff {rules : Term → Term → Prop} {normal : Term → Term}
    (normalized : closure.NormalizedBy rules normal) {term term' : Term} :
    closure.Conv rules term term' ↔ normal term = normal term' :=
  ⟨normalized.2 term term', fun equal => EqvGen.trans _ _ _ (normalized.1 term)
    (EqvGen.symm _ _ (equal ▸ normalized.1 term'))⟩

/-- Every bubble is normalized by a choice of representatives of its
conversion classes.  Being normalized by a function is a property of that
function, not the existence of a decision procedure. -/
theorem exists_normalizedBy (rules : Term → Term → Prop) :
    ∃ normal, closure.NormalizedBy rules normal := by
  let classes : Setoid Term := ⟨closure.Conv rules, EqvGen.is_equivalence _⟩
  refine ⟨fun term => (Quotient.mk classes term).out, fun term => ?_,
    fun term term' converted => congrArg Quotient.out (Quotient.sound (s := classes) converted)⟩
  exact EqvGen.symm _ _ (Quotient.mk_out (s := classes) term)

/-- **Decisions compose when the first normal form respects the second
bubble.**  If each bubble is normalized by its own function and the first
function sends conversions of the second bubble to conversions of the second
bubble, the join is normalized by the composite. -/
theorem join_normalizedBy {normalFirst normalSecond : Term → Term}
    (byFirst : closure.NormalizedBy first normalFirst)
    (bySecond : closure.NormalizedBy second normalSecond)
    (respects : ∀ term term', closure.Conv second term term' →
      closure.Conv second (normalFirst term) (normalFirst term')) :
    closure.NormalizedBy (join first second) (fun term => normalSecond (normalFirst term)) := by
  refine ⟨fun term => EqvGen.trans _ _ _ (conv_join_left (byFirst.1 term))
    (conv_join_right (bySecond.1 (normalFirst term))), ?_⟩
  intro term term' converted
  induction converted with
  | rel _ _ stepped =>
      rcases step_join_cases stepped with inFirst | inSecond
      · exact congrArg normalSecond (byFirst.2 _ _ inFirst)
      · exact bySecond.2 _ _ (respects _ _ inSecond)
  | refl => rfl
  | symm _ _ _ inductionHypothesis => exact inductionHypothesis.symm
  | trans _ _ _ _ _ first second => exact first.trans second

end CongruenceClosure

/-! ## Substitution -/

/-- A congruence closure with a substitution action under which the closure of
substitution-stable rules is stable. -/
structure SubstitutiveClosure (Term : Type u) extends CongruenceClosure Term where
  Substitution : Type w
  substitute : Substitution → Term → Term
  substitute_step : ∀ {rules : Term → Term → Prop},
    (∀ substitution source target, rules source target →
      rules (substitute substitution source) (substitute substitution target)) →
    ∀ substitution {source target : Term}, step rules source target →
      step rules (substitute substitution source) (substitute substitution target)

namespace SubstitutiveClosure

variable {Term : Type u} (closure : SubstitutiveClosure.{u, w} Term)

/-- Rules stable under every substitution. -/
def Stable (rules : Term → Term → Prop) : Prop :=
  ∀ substitution source target, rules source target →
    rules (closure.substitute substitution source) (closure.substitute substitution target)

/-- **Stability under substitution composes.** -/
theorem join_stable {first second : Term → Term → Prop}
    (firstStable : closure.Stable first) (secondStable : closure.Stable second) :
    closure.Stable (CongruenceClosure.join first second) :=
  fun substitution _ _ rule => rule.elim
    (fun inFirst => Or.inl (firstStable substitution _ _ inFirst))
    (fun inSecond => Or.inr (secondStable substitution _ _ inSecond))

/-- Conversions of a stable bubble are stable. -/
theorem conv_substitute {rules : Term → Term → Prop} (stable : closure.Stable rules)
    (substitution : closure.Substitution) {source target : Term}
    (converted : closure.Conv rules source target) :
    closure.Conv rules (closure.substitute substitution source)
      (closure.substitute substitution target) := by
  induction converted with
  | rel _ _ stepped => exact EqvGen.rel _ _ (closure.substitute_step stable substitution stepped)
  | refl => exact EqvGen.refl _
  | symm _ _ _ inductionHypothesis => exact EqvGen.symm _ _ inductionHypothesis
  | trans _ _ _ _ _ first second => exact EqvGen.trans _ _ _ first second

end SubstitutiveClosure

/-! ## Signatures -/

section Signatures

variable {Term : Type u} {Symbol : Type v}

/-- A schema mentions a symbol when the symbol occurs in each of its
instances. -/
def Mentions (occurs : Symbol → Term → Prop) (schema : Term → Term → Prop)
    (symbol : Symbol) : Prop :=
  ∀ redex contractum, schema redex contractum → occurs symbol redex ∨ occurs symbol contractum

/-- The bubble presented by a family of schemas. -/
def Presented {Index : Type w} (schemas : Index → Term → Term → Prop) :
    Term → Term → Prop :=
  fun redex contractum => ∃ index, schemas index redex contractum

/-- The signature of a presented bubble: the symbols its inhabited schemas
mention.  An uninhabited schema contributes nothing. -/
def Signature {Index : Type w} (occurs : Symbol → Term → Prop)
    (schemas : Index → Term → Term → Prop) : Set Symbol :=
  {symbol | ∃ index, (∃ redex contractum, schemas index redex contractum) ∧
    Mentions occurs (schemas index) symbol}

/-- The signature is bounded by the symbols of one instance of each inhabited
schema. -/
theorem signature_subset {Index : Type w} {occurs : Symbol → Term → Prop}
    {schemas : Index → Term → Term → Prop} {bound : Set Symbol}
    (witness : ∀ index, (∃ redex contractum, schemas index redex contractum) →
      ∃ redex contractum, schemas index redex contractum ∧
        ∀ symbol, occurs symbol redex ∨ occurs symbol contractum → symbol ∈ bound) :
    Signature occurs schemas ⊆ bound := by
  rintro symbol ⟨index, inhabited, mentions⟩
  obtain ⟨redex, contractum, instance_, bounded⟩ := witness index inhabited
  exact bounded symbol (mentions redex contractum instance_)

/-- Every redex of the bubble is headed by a symbol of the set. -/
def RootedIn (head : Term → Option Symbol) (rules : Term → Term → Prop)
    (symbols : Set Symbol) : Prop :=
  ∀ redex contractum, rules redex contractum → ∃ symbol ∈ symbols, head redex = some symbol

end Signatures

/-! ## The HOL core -/

section Core

open Mettapedia.Logic.HOL
open Mettapedia.Logic.HOL.Embedding.SimpleSliceOfDependent
open Mettapedia.TypeTheory.BubbleConversion
open Expr

variable {Base : Type u} {Const : Ty Base → Type v}

/-- A step of a union of rule sets is a step of one of them. -/
theorem rewrite_split {first second : Expr Base Const → Expr Base Const → Prop}
    {source target : Expr Base Const}
    (stepped : Rewrite (fun left right => first left right ∨ second left right) source target) :
    Rewrite first source target ∨ Rewrite second source target := by
  induction stepped with
  | root rule => exact rule.imp Rewrite.root Rewrite.root
  | piDomain _ ih => exact ih.imp Rewrite.piDomain Rewrite.piDomain
  | piBody _ ih => exact ih.imp Rewrite.piBody Rewrite.piBody
  | lamDomain _ ih => exact ih.imp Rewrite.lamDomain Rewrite.lamDomain
  | lamBody _ ih => exact ih.imp Rewrite.lamBody Rewrite.lamBody
  | appFunction _ ih => exact ih.imp Rewrite.appFunction Rewrite.appFunction
  | appArgument _ ih => exact ih.imp Rewrite.appArgument Rewrite.appArgument
  | andLeft _ ih => exact ih.imp Rewrite.andLeft Rewrite.andLeft
  | andRight _ ih => exact ih.imp Rewrite.andRight Rewrite.andRight
  | orLeft _ ih => exact ih.imp Rewrite.orLeft Rewrite.orLeft
  | orRight _ ih => exact ih.imp Rewrite.orRight Rewrite.orRight
  | impLeft _ ih => exact ih.imp Rewrite.impLeft Rewrite.impLeft
  | impRight _ ih => exact ih.imp Rewrite.impRight Rewrite.impRight
  | notBody _ ih => exact ih.imp Rewrite.notBody Rewrite.notBody
  | eqLeft _ ih => exact ih.imp Rewrite.eqLeft Rewrite.eqLeft
  | eqRight _ ih => exact ih.imp Rewrite.eqRight Rewrite.eqRight
  | allDomain _ ih => exact ih.imp Rewrite.allDomain Rewrite.allDomain
  | allBody _ ih => exact ih.imp Rewrite.allBody Rewrite.allBody
  | exDomain _ ih => exact ih.imp Rewrite.exDomain Rewrite.exDomain
  | exBody _ ih => exact ih.imp Rewrite.exBody Rewrite.exBody

/-- Bubble rewriting of the HOL core as a congruence closure. -/
def exprClosure : CongruenceClosure (Expr Base Const) where
  step := Rewrite
  root := Rewrite.root
  mono := by
    intro small large included source target stepped
    exact rewrite_mono included stepped
  split := rewrite_split
  congr := fun stepped => rewrite_into (fun _ _ converted => converted) stepped

/-- Bubble rewriting of the HOL core with its de Bruijn substitution. -/
def exprSubstitutive : SubstitutiveClosure (Expr Base Const) where
  toCongruenceClosure := exprClosure
  Substitution := Nat × Expr Base Const
  substitute substitution := substAt substitution.1 substitution.2
  substitute_step := by
    intro rules stable substitution source target stepped
    exact rewrite_substAt
      (fun _ _ rule depth replacement => stable (depth, replacement) _ _ rule)
      stepped substitution.1 substitution.2

/-- The abstract conversion of the core is bubble conversion. -/
theorem exprClosure_conv (rules : Expr Base Const → Expr Base Const → Prop) :
    (exprClosure (Base := Base) (Const := Const)).Conv rules = Convertible rules :=
  rfl

/-- The abstract join is the bubble join of the core. -/
theorem exprClosure_join (first second : Expr Base Const → Expr Base Const → Prop) :
    CongruenceClosure.join first second = BubbleConversion.join first second :=
  rfl

/-- The abstract normalization of the core is bubble normalization. -/
theorem exprClosure_normalizedBy (rules : Expr Base Const → Expr Base Const → Prop)
    (normal : Expr Base Const → Expr Base Const) :
    (exprClosure (Base := Base) (Const := Const)).NormalizedBy rules normal ↔
      BubbleConversion.NormalizedBy rules normal :=
  Iff.rfl

/-- The abstract substitution stability of the core is `SubstitutionStable`. -/
theorem exprSubstitutive_stable (rules : Expr Base Const → Expr Base Const → Prop) :
    (exprSubstitutive (Base := Base) (Const := Const)).Stable rules ↔
      SubstitutionStable rules := by
  constructor
  · intro stable left right rule depth replacement
    exact stable (depth, replacement) left right rule
  · intro stable substitution left right rule
    exact stable left right rule substitution.1 substitution.2

/-- The non-variable formers of the core, with constants named. -/
inductive ExprSymbol (Base : Type u) (Const : Ty Base → Type v) : Type (max u v) where
  | univ
  | prop
  | base (b : Base)
  | pi
  | lam
  | app
  | const (τ : Ty Base) (c : Const τ)
  | tyFam (b : Base)
  | top
  | bot
  | and
  | or
  | imp
  | not
  | eq
  | all
  | ex

/-- The symbols occurring in an expression, with repetition. -/
def symbols : Expr Base Const → List (ExprSymbol Base Const)
  | .bvar _ => []
  | .univ => [.univ]
  | .prop => [.prop]
  | .base b => [.base b]
  | .pi A B => .pi :: (symbols A ++ symbols B)
  | .lam A b => .lam :: (symbols A ++ symbols b)
  | .app f a => .app :: (symbols f ++ symbols a)
  | .const τ c => [.const τ c]
  | .tyFam b => [.tyFam b]
  | .top => [.top]
  | .bot => [.bot]
  | .and p q => .and :: (symbols p ++ symbols q)
  | .or p q => .or :: (symbols p ++ symbols q)
  | .imp p q => .imp :: (symbols p ++ symbols q)
  | .not p => .not :: symbols p
  | .eq a b => .eq :: (symbols a ++ symbols b)
  | .all A b => .all :: (symbols A ++ symbols b)
  | .ex A b => .ex :: (symbols A ++ symbols b)

/-- A symbol occurs in an expression. -/
def ExprOccurs (symbol : ExprSymbol Base Const) (expression : Expr Base Const) : Prop :=
  symbol ∈ symbols expression

end Core

namespace Arith

open Mettapedia.Logic.HOL
open Mettapedia.Logic.HOL.Embedding.SimpleSliceOfDependent
open Mettapedia.TypeTheory.BubbleConversion
open Mettapedia.TypeTheory.BubbleConversion.Arith
open Expr

/-- The constant of addition as a symbol. -/
abbrev addSymbol : ExprSymbol Unit ArithConst := .const _ .add

/-- The two recursion equations of addition, as two schemas. -/
def ruleSchemas : Bool → AExpr → AExpr → Prop
  | false => fun redex contractum => ∃ t, redex = addE t zeroE ∧ contractum = t
  | true => fun redex contractum =>
      ∃ t u, redex = addE t (succE u) ∧ contractum = succE (addE t u)

/-- The zero-swap equation as one schema. -/
def zeroSwapSchemas : Unit → AExpr → AExpr → Prop :=
  fun _ redex contractum => ∃ t, redex = addE t zeroE ∧ contractum = addE zeroE t

/-- The logical equation `¬⊤ ↦ ⊥` as one schema. -/
def notTopSchemas : Unit → AExpr → AExpr → Prop :=
  fun _ redex contractum => redex = .not .top ∧ contractum = .bot

/-- The schemas present the recursion bubble. -/
theorem rule_presented : Presented ruleSchemas = Rule := by
  funext redex contractum
  apply propext
  constructor
  · rintro ⟨index, presented⟩
    cases index with
    | false =>
        obtain ⟨t, rfl, rfl⟩ := presented
        exact Rule.addZero _
    | true =>
        obtain ⟨t, u, rfl, rfl⟩ := presented
        exact Rule.addSucc _ _
  · intro rule
    cases rule with
    | addZero t => exact ⟨false, _, rfl, rfl⟩
    | addSucc t u => exact ⟨true, t, u, rfl, rfl⟩

/-- The schema presents the zero-swap bubble. -/
theorem zeroSwap_presented : Presented zeroSwapSchemas = ZeroSwap := by
  funext redex contractum
  apply propext
  constructor
  · rintro ⟨_, t, rfl, rfl⟩
    exact ZeroSwap.swap _
  · intro rule
    cases rule with
    | swap t => exact ⟨(), t, rfl, rfl⟩

/-- The schema presents the logical bubble. -/
theorem notTop_presented : Presented notTopSchemas = NotTop := by
  funext redex contractum
  apply propext
  constructor
  · rintro ⟨_, rfl, rfl⟩
    exact NotTop.notTop
  · intro rule
    cases rule
    exact ⟨(), rfl, rfl⟩

/-- Expressions built from variables, constants and application only. -/
inductive ApplicativeSkeleton : AExpr → Prop where
  | bvar (index : Nat) : ApplicativeSkeleton (.bvar index)
  | const (τ : Ty Unit) (c : ArithConst τ) : ApplicativeSkeleton (.const τ c)
  | app {function argument : AExpr} :
      ApplicativeSkeleton function → ApplicativeSkeleton argument →
        ApplicativeSkeleton (.app function argument)

/-- An applicative skeleton contains only application and constants. -/
theorem symbols_of_skeleton {expression : AExpr} (skeleton : ApplicativeSkeleton expression)
    {symbol : ExprSymbol Unit ArithConst} (occurs : symbol ∈ symbols expression) :
    symbol = .app ∨ ∃ (τ : Ty Unit) (c : ArithConst τ), symbol = .const τ c := by
  induction skeleton with
  | bvar index => simp [symbols] at occurs
  | const τ c =>
      simp only [symbols, List.mem_singleton] at occurs
      exact Or.inr ⟨τ, c, occurs⟩
  | app _ _ functionHypothesis argumentHypothesis =>
      simp only [symbols, List.mem_cons, List.mem_append] at occurs
      rcases occurs with isApp | inFunction | inArgument
      · exact Or.inl isApp
      · exact functionHypothesis inFunction
      · exact argumentHypothesis inArgument

/-- Every symbol the recursion bubble mentions is application or a constant. -/
theorem rule_signature {symbol : ExprSymbol Unit ArithConst}
    (mentioned : symbol ∈ Signature ExprOccurs ruleSchemas) :
    symbol = .app ∨ ∃ (τ : Ty Unit) (c : ArithConst τ), symbol = .const τ c := by
  obtain ⟨index, _, mentions⟩ := mentioned
  cases index with
  | false =>
      have occurs := mentions (addE (.bvar 0) zeroE) (.bvar 0) ⟨.bvar 0, rfl, rfl⟩
      rcases occurs with inRedex | inContractum
      · exact symbols_of_skeleton (.app (.app (.const _ _) (.bvar 0)) (.const _ _)) inRedex
      · exact symbols_of_skeleton (.bvar 0) inContractum
  | true =>
      have occurs := mentions (addE (.bvar 0) (succE (.bvar 0)))
        (succE (addE (.bvar 0) (.bvar 0))) ⟨.bvar 0, .bvar 0, rfl, rfl⟩
      rcases occurs with inRedex | inContractum
      · exact symbols_of_skeleton
          (.app (.app (.const _ _) (.bvar 0)) (.app (.const _ _) (.bvar 0))) inRedex
      · exact symbols_of_skeleton
          (.app (.const _ _) (.app (.app (.const _ _) (.bvar 0)) (.bvar 0))) inContractum

/-- The logical formers: truth, falsity, the connectives, equality and the
quantifiers. -/
def isLogical : ExprSymbol Unit ArithConst → Bool
  | .top | .bot | .and | .or | .imp | .not | .eq | .all | .ex => true
  | _ => false

/-- The set of logical formers. -/
def logicalSymbols : Set (ExprSymbol Unit ArithConst) :=
  {symbol | isLogical symbol = true}

theorem const_not_logical (τ : Ty Unit) (c : ArithConst τ) :
    ExprSymbol.const τ c ∉ logicalSymbols :=
  Bool.false_ne_true

/-- An instance written in logical formers, checked by evaluation. -/
theorem logical_of_symbols {redex contractum : AExpr}
    (checked : (symbols redex ++ symbols contractum).all isLogical = true) :
    ∀ symbol, ExprOccurs symbol redex ∨ ExprOccurs symbol contractum →
      symbol ∈ logicalSymbols :=
  fun symbol occurs => List.all_eq_true.mp checked symbol (List.mem_append.mpr occurs)

/-- The logical bubble is written in logical formers. -/
theorem notTop_signature : Signature ExprOccurs notTopSchemas ⊆ logicalSymbols :=
  signature_subset fun _ _ => ⟨_, _, ⟨rfl, rfl⟩, logical_of_symbols rfl⟩

/-- A bubble written in logical formers has a signature disjoint from the
recursion bubble's. -/
theorem rule_disjoint_of_logical {Index : Type} {schemas : Index → AExpr → AExpr → Prop}
    (logical : Signature ExprOccurs schemas ⊆ logicalSymbols) :
    Disjoint (Signature ExprOccurs ruleSchemas) (Signature ExprOccurs schemas) := by
  rw [Set.disjoint_left]
  intro symbol inRule inOther
  have isLogical := logical inOther
  rcases rule_signature inRule with rfl | ⟨τ, c, rfl⟩
  · exact Bool.false_ne_true isLogical
  · exact const_not_logical τ c isLogical

/-- **The recursion bubble and the logical bubble have disjoint signatures.** -/
theorem rule_notTop_disjoint :
    Disjoint (Signature ExprOccurs ruleSchemas) (Signature ExprOccurs notTopSchemas) :=
  rule_disjoint_of_logical notTop_signature

/-- Addition is mentioned by the first recursion equation. -/
theorem add_mentioned_by_rule : addSymbol ∈ Signature ExprOccurs ruleSchemas := by
  refine ⟨false, ⟨_, _, ⟨.bvar 0, rfl, rfl⟩⟩, ?_⟩
  rintro _ _ ⟨t, rfl, rfl⟩
  left
  simp [ExprOccurs, symbols, addE, addSymbol]

/-- Addition is mentioned by the zero-swap equation. -/
theorem add_mentioned_by_zeroSwap : addSymbol ∈ Signature ExprOccurs zeroSwapSchemas := by
  refine ⟨(), ⟨_, _, ⟨.bvar 0, rfl, rfl⟩⟩, ?_⟩
  rintro _ _ ⟨t, rfl, rfl⟩
  left
  simp [ExprOccurs, symbols, addE, addSymbol]

/-- **The recursion bubble and the zero-swap bubble share a symbol.** -/
theorem rule_zeroSwap_not_disjoint :
    ¬ Disjoint (Signature ExprOccurs ruleSchemas) (Signature ExprOccurs zeroSwapSchemas) := by
  rw [Set.not_disjoint_iff]
  exact ⟨addSymbol, add_mentioned_by_rule, add_mentioned_by_zeroSwap⟩

end Arith

/-! ## Pure type systems -/

section PureTypeSystems

open Mettapedia.GSLT.Dedukti
open Mettapedia.GSLT.LanguageDef.LF (Srt)
open Mettapedia.TypeTheory.HypercubeBubbles

/-- A step of a union of step relations is a step of one of them. -/
theorem congruence_split {first second : PTerm → PTerm → Prop} {source target : PTerm}
    (stepped : Congruence (fun left right => first left right ∨ second left right)
      source target) :
    Congruence first source target ∨ Congruence second source target := by
  induction stepped with
  | root holds => exact holds.imp Congruence.root Congruence.root
  | piDomain _ ih => exact ih.imp Congruence.piDomain Congruence.piDomain
  | piBody _ ih => exact ih.imp Congruence.piBody Congruence.piBody
  | lamDomain _ ih => exact ih.imp Congruence.lamDomain Congruence.lamDomain
  | lamBody _ ih => exact ih.imp Congruence.lamBody Congruence.lamBody
  | appFunction _ ih => exact ih.imp Congruence.appFunction Congruence.appFunction
  | appArgument _ ih => exact ih.imp Congruence.appArgument Congruence.appArgument

private theorem eqvGen_map {α : Type*} {r : α → α → Prop} (function : α → α)
    (preserves : ∀ {source target}, r source target → r (function source) (function target))
    {source target : α} (related : EqvGen r source target) :
    EqvGen r (function source) (function target) := by
  induction related with
  | rel _ _ step => exact EqvGen.rel _ _ (preserves step)
  | refl => exact EqvGen.refl _
  | symm _ _ _ ih => exact EqvGen.symm _ _ ih
  | trans _ _ _ _ _ first second => exact EqvGen.trans _ _ _ first second

/-- The equivalence generated by congruence steps is closed under positions. -/
theorem congruence_congr {steps : PTerm → PTerm → Prop} {source target : PTerm}
    (stepped : Congruence (EqvGen (Congruence steps)) source target) :
    EqvGen (Congruence steps) source target := by
  induction stepped with
  | root holds => exact holds
  | piDomain _ ih => exact eqvGen_map _ (fun step => .piDomain step) ih
  | piBody _ ih => exact eqvGen_map _ (fun step => .piBody step) ih
  | lamDomain _ ih => exact eqvGen_map _ (fun step => .lamDomain step) ih
  | lamBody _ ih => exact eqvGen_map _ (fun step => .lamBody step) ih
  | appFunction _ ih => exact eqvGen_map _ (fun step => .appFunction step) ih
  | appArgument _ ih => exact eqvGen_map _ (fun step => .appArgument step) ih

/-- Bubble conversion of annotated terms as a congruence closure. -/
def ptermClosure : CongruenceClosure PTerm where
  step := Congruence
  root := Congruence.root
  mono := by
    intro small large included source target stepped
    exact congruence_mono (fun holds => included _ _ holds) stepped
  split := congruence_split
  congr := congruence_congr

/-- Congruence steps of substitution-stable steps are substitution-stable. -/
theorem congruence_subst {steps : PTerm → PTerm → Prop}
    (stable : ∀ (substitution : Nat × PTerm) source target, steps source target →
      steps (PTerm.subst substitution.1 substitution.2 source)
        (PTerm.subst substitution.1 substitution.2 target))
    {source target : PTerm} (stepped : Congruence steps source target) :
    ∀ (index : Nat) (replacement : PTerm),
      Congruence steps (PTerm.subst index replacement source)
        (PTerm.subst index replacement target) := by
  induction stepped with
  | root holds => exact fun index replacement => .root (stable (index, replacement) _ _ holds)
  | piDomain _ ih => exact fun index replacement => .piDomain (ih index replacement)
  | piBody _ ih =>
      exact fun index replacement => .piBody (ih (index + 1) (PTerm.lift 1 0 replacement))
  | lamDomain _ ih => exact fun index replacement => .lamDomain (ih index replacement)
  | lamBody _ ih =>
      exact fun index replacement => .lamBody (ih (index + 1) (PTerm.lift 1 0 replacement))
  | appFunction _ ih => exact fun index replacement => .appFunction (ih index replacement)
  | appArgument _ ih => exact fun index replacement => .appArgument (ih index replacement)

/-- Bubble conversion of annotated terms with substitution. -/
def ptermSubstitutive : SubstitutiveClosure PTerm where
  toCongruenceClosure := ptermClosure
  Substitution := Nat × PTerm
  substitute substitution := PTerm.subst substitution.1 substitution.2
  substitute_step := by
    intro rules stable substitution source target stepped
    exact congruence_subst stable stepped substitution.1 substitution.2

theorem ptermClosure_conv (steps : PTerm → PTerm → Prop) :
    ptermClosure.Conv steps = bubbleConv steps :=
  rfl

/-- **The two sort-separated beta bubbles join to the beta bubble.**  A
beta redex abstracts over a type or over a kind, and nothing else. -/
theorem join_typeBeta_termBeta : CongruenceClosure.join typeBeta termBeta = betaRoot := by
  funext source target
  apply propext
  constructor
  · rintro (holds | holds)
    · exact typeBeta_le_betaRoot holds
    · exact termBeta_le_betaRoot holds
  · rintro ⟨level, domain, body, argument, rfl, rfl⟩
    cases level with
    | type => exact Or.inr ⟨domain, body, argument, rfl, rfl⟩
    | kind => exact Or.inl ⟨domain, body, argument, rfl, rfl⟩

/-- **Their joint conversion is beta conversion of the pure type system.** -/
theorem join_typeBeta_termBeta_conv :
    ptermClosure.Conv (CongruenceClosure.join typeBeta termBeta) = PTerm.Conv := by
  rw [join_typeBeta_termBeta, ptermClosure_conv, bubbleConv_betaRoot]

/-- A binder sort occurs in a term when an abstraction over that sort does. -/
inductive AbstractsOver (level : Srt) : PTerm → Prop where
  | here {domain body : PTerm} : AbstractsOver level (.lam level domain body)
  | piDomain {rule : Mettapedia.GSLT.LanguageDef.LFProfile.ProductRule}
      {domain body : PTerm} :
      AbstractsOver level domain → AbstractsOver level (.pi rule domain body)
  | piBody {rule : Mettapedia.GSLT.LanguageDef.LFProfile.ProductRule}
      {domain body : PTerm} :
      AbstractsOver level body → AbstractsOver level (.pi rule domain body)
  | lamDomain {other : Srt} {domain body : PTerm} :
      AbstractsOver level domain → AbstractsOver level (.lam other domain body)
  | lamBody {other : Srt} {domain body : PTerm} :
      AbstractsOver level body → AbstractsOver level (.lam other domain body)
  | appFunction {function argument : PTerm} :
      AbstractsOver level function → AbstractsOver level (.app function argument)
  | appArgument {function argument : PTerm} :
      AbstractsOver level argument → AbstractsOver level (.app function argument)

/-- Variables abstract over nothing. -/
theorem not_abstractsOver_var (level : Srt) (index : Nat) :
    ¬ AbstractsOver level (.var index) := by
  intro abstracts
  cases abstracts

/-- The type-level beta bubble mentions exactly the sort of kinds. -/
theorem typeBeta_signature (level : Srt) :
    level ∈ Signature AbstractsOver (fun _ : Unit => typeBeta) ↔ level = .kind := by
  constructor
  · rintro ⟨_, _, mentions⟩
    have occurs := mentions (.app (.lam .kind (.var 0) (.var 0)) (.var 0))
      (PTerm.subst0 (.var 0) (.var 0)) ⟨.var 0, .var 0, .var 0, rfl, rfl⟩
    rcases occurs with redexOccurs | contractumOccurs
    · cases redexOccurs with
      | appFunction inner =>
          cases inner with
          | here => rfl
          | lamDomain inner => exact absurd inner (not_abstractsOver_var _ _)
          | lamBody inner => exact absurd inner (not_abstractsOver_var _ _)
      | appArgument inner => exact absurd inner (not_abstractsOver_var _ _)
    · exact absurd contractumOccurs (by
        simp only [PTerm.subst0, PTerm.subst]
        exact not_abstractsOver_var _ _)
  · rintro rfl
    refine ⟨(), ⟨_, _, ⟨.var 0, .var 0, .var 0, rfl, rfl⟩⟩, ?_⟩
    rintro _ _ ⟨domain, body, argument, rfl, rfl⟩
    exact Or.inl (.appFunction .here)

/-- The term-level beta bubble mentions exactly the sort of types. -/
theorem termBeta_signature (level : Srt) :
    level ∈ Signature AbstractsOver (fun _ : Unit => termBeta) ↔ level = .type := by
  constructor
  · rintro ⟨_, _, mentions⟩
    have occurs := mentions (.app (.lam .type (.var 0) (.var 0)) (.var 0))
      (PTerm.subst0 (.var 0) (.var 0)) ⟨.var 0, .var 0, .var 0, rfl, rfl⟩
    rcases occurs with redexOccurs | contractumOccurs
    · cases redexOccurs with
      | appFunction inner =>
          cases inner with
          | here => rfl
          | lamDomain inner => exact absurd inner (not_abstractsOver_var _ _)
          | lamBody inner => exact absurd inner (not_abstractsOver_var _ _)
      | appArgument inner => exact absurd inner (not_abstractsOver_var _ _)
    · exact absurd contractumOccurs (by
        simp only [PTerm.subst0, PTerm.subst]
        exact not_abstractsOver_var _ _)
  · rintro rfl
    refine ⟨(), ⟨_, _, ⟨.var 0, .var 0, .var 0, rfl, rfl⟩⟩, ?_⟩
    rintro _ _ ⟨domain, body, argument, rfl, rfl⟩
    exact Or.inl (.appFunction .here)

/-- **The two beta bubbles have disjoint signatures: they live at different
binder sorts.** -/
theorem typeBeta_termBeta_disjoint :
    Disjoint (Signature AbstractsOver (fun _ : Unit => typeBeta))
      (Signature AbstractsOver (fun _ : Unit => termBeta)) := by
  rw [Set.disjoint_left]
  intro level inType inTerm
  rw [typeBeta_signature] at inType
  rw [termBeta_signature] at inTerm
  rw [inType] at inTerm
  cases inTerm

end PureTypeSystems

/-! ## Patterns of language definitions -/

section Patterns

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.Match
open Mettapedia.OSLF.MeTTaIL.DerivedContexts
open Mettapedia.GSLT.LanguageDef
open Mettapedia.GSLT.LanguageDef.StructuralCoproduct

/-- Root steps at the hole of a one-hole context. -/
def patternStep (rules : Pattern → Pattern → Prop) (source target : Pattern) : Prop :=
  ∃ (context : OneHoleContext) (redex contractum : Pattern),
    rules redex contractum ∧ context.fill redex = source ∧ context.fill contractum = target

private theorem patternStep_fill {rules : Pattern → Pattern → Prop}
    (context : OneHoleContext) {source target : Pattern}
    (stepped : patternStep rules source target) :
    patternStep rules (context.fill source) (context.fill target) := by
  obtain ⟨inner, redex, contractum, rule, rfl, rfl⟩ := stepped
  exact ⟨context.comp inner, redex, contractum, rule, OneHoleContext.fill_comp _ _ _,
    OneHoleContext.fill_comp _ _ _⟩

/-- Pattern rewriting at every position as a congruence closure. -/
def patternClosure : CongruenceClosure Pattern where
  step := patternStep
  root := fun rule => ⟨.hole, _, _, rule, rfl, rfl⟩
  mono := by
    intro small large included source target stepped
    obtain ⟨context, redex, contractum, rule, sourceEq, targetEq⟩ := stepped
    exact ⟨context, redex, contractum, included _ _ rule, sourceEq, targetEq⟩
  split := by
    intro first second source target stepped
    obtain ⟨context, redex, contractum, rule, sourceEq, targetEq⟩ := stepped
    exact rule.imp (fun inFirst => ⟨context, redex, contractum, inFirst, sourceEq, targetEq⟩)
      (fun inSecond => ⟨context, redex, contractum, inSecond, sourceEq, targetEq⟩)
  congr := by
    intro rules source target stepped
    obtain ⟨context, redex, contractum, converted, rfl, rfl⟩ := stepped
    induction converted with
    | rel _ _ inner => exact EqvGen.rel _ _ (patternStep_fill context inner)
    | refl => exact EqvGen.refl _
    | symm _ _ _ ih => exact EqvGen.symm _ _ ih
    | trans _ _ _ _ _ first second => exact EqvGen.trans _ _ _ first second

/-- The bubble of a language definition: its premise-free rewrite rules,
applied at the root. -/
def languageBubble (language : LanguageDef) (redex contractum : Pattern) : Prop :=
  contractum ∈ rewriteStep language redex

/-- **The bubble of a structural coproduct is the join of the bubbles of its
renamed summands.** -/
theorem rawCoproduct_bubble (name : String) (leftSymbols rightSymbols : LanguageDefSymbolMap)
    (left right : LanguageDef) :
    languageBubble (rawCoproduct name leftSymbols rightSymbols left right) =
      CongruenceClosure.join
        (languageBubble (renameLanguage (name ++ ".left") leftSymbols left))
        (languageBubble (renameLanguage (name ++ ".right") rightSymbols right)) := by
  funext redex contractum
  simp [languageBubble, CongruenceClosure.join, rewriteStep, rawCoproduct, renameLanguage,
    List.flatMap_append]

/-- The constructor heading a pattern. -/
def patternHead : Pattern → Option String
  | .apply constructor _ => some constructor
  | _ => none

private theorem matchPattern_apply_head {constructor : String} {arguments : List Pattern}
    {term : Pattern} (matched : matchPattern (.apply constructor arguments) term ≠ []) :
    patternHead term = some constructor := by
  cases term with
  | apply termConstructor termArguments =>
      by_cases same : constructor = termConstructor
      · subst same
        rfl
      · exfalso
        apply matched
        simp [matchPattern, same]
  | bvar index => exact absurd (by simp [matchPattern]) matched
  | fvar variableName => exact absurd (by simp [matchPattern]) matched
  | lambda binder body => exact absurd (by simp [matchPattern]) matched
  | multiLambda arity binders body => exact absurd (by simp [matchPattern]) matched
  | subst body replacement => exact absurd (by simp [matchPattern]) matched
  | collection collectionType elements rest => exact absurd (by simp [matchPattern]) matched

/-- A renamed summand whose rules are constructor-rooted has its redexes headed
by renamed constructors. -/
theorem renamed_bubble_rooted (renamedName : String) (symbols : LanguageDefSymbolMap)
    (language : LanguageDef)
    (rooted : ∀ rewrite ∈ language.rewrites, ConstructorRooted rewrite) :
    RootedIn patternHead (languageBubble (renameLanguage renamedName symbols language))
      (Set.range symbols.constructor) := by
  intro redex contractum stepped
  simp only [languageBubble, rewriteStep, renameLanguage, List.flatMap_map,
    List.mem_flatMap] at stepped
  obtain ⟨rule, member, applied⟩ := stepped
  obtain ⟨constructor, arguments, leftEquation⟩ := rooted rule member
  refine ⟨symbols.constructor constructor, ⟨constructor, rfl⟩, ?_⟩
  apply matchPattern_apply_head (arguments := arguments.map (mapPattern symbols))
  intro empty
  simp only [applyRule, mapRewriteRule, leftEquation, mapPattern, mapPatternList_eq_map,
    empty, List.map_nil] at applied
  split at applied <;> simp at applied

/-- **Two bubbles from a structural coproduct are disjoint**: their redexes are
headed by the two disjoint constructor images. -/
theorem coproduct_bubbles_disjoint {name : String}
    {leftSymbols rightSymbols : LanguageDefSymbolMap} {left right : ValidatedLanguageDef}
    (compatible : Compatibility name leftSymbols rightSymbols left right) :
    RootedIn patternHead
        (languageBubble (renameLanguage (name ++ ".left") leftSymbols left.language))
        (Set.range leftSymbols.constructor) ∧
      RootedIn patternHead
        (languageBubble (renameLanguage (name ++ ".right") rightSymbols right.language))
        (Set.range rightSymbols.constructor) ∧
      Disjoint (Set.range leftSymbols.constructor) (Set.range rightSymbols.constructor) := by
  refine ⟨renamed_bubble_rooted _ _ _ compatible.leftRewritesRooted,
    renamed_bubble_rooted _ _ _ compatible.rightRewritesRooted, ?_⟩
  rw [Set.disjoint_left]
  rintro _ ⟨leftName, rfl⟩ ⟨rightName, sameImage⟩
  exact compatible.symbolImagesDisjoint.constructor leftName rightName sameImage.symm

end Patterns

