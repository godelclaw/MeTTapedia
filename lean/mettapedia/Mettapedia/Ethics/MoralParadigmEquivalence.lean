import Mettapedia.Ethics.JudgmentRealization
import Mettapedia.Ethics.TargetCenteredVirtue
import Mettapedia.Ethics.UtilitarianToValue
import Mettapedia.Ethics.VirtueToValue

/-!
# Moral Paradigm Equivalence

The Moral Paradigm Equivalence conjecture says that, for each ordered pair of
ethical paradigms, every theory in the source paradigm has a theory in the
target paradigm with the same moral judgments. This module proves two exact
versions: equality at the Formal Ethics Ontology's `evaluateTheory` boundary,
and equality of model classes for set-of-sentences theories under explicitly
aligned semantics.

The theorem does **not** identify the internal structures of the paradigms.
Instead it gives explicit constructions:

* a deontic theory uses guarded obligation/prohibition/permission rules;
* a utilitarian theory uses integer utilities and sign classification; and
* a target-centered virtue theory uses virtues with field, basis, mode, and
  target.

All six ordered translations preserve the complete judgment function, and a
second six-way theorem preserves model satisfaction. The
constructions also expose where an unusual encoding lives: arbitrary source
judgments appear in rule guards, utility values, or virtue targets.  Questions
of computability, succinctness, naturalness, and learnability are therefore
separate refinements of exact semantic expressibility.
-/

set_option autoImplicit false

namespace Mettapedia.Ethics.MoralParadigmEquivalence

open Mettapedia.Ethics
open Mettapedia.Ethics.TargetCenteredVirtue

universe uAgent uSituation uAction

/-- A fully evaluated ethical theory assigns one moral verdict to each
agent/situation/action triple. -/
abbrev MoralJudgment
    (Agent : Type uAgent) (Situation : Type uSituation)
    (Action : Type uAction) :=
  Agent → Situation → Action → MoralValueAttribute

variable {Agent : Type uAgent} {Situation : Type uSituation}
  {Action : Type uAction}

/-- Pointwise equality of evaluated ethical theories. -/
def JudgmentEquivalent
    (left right : MoralJudgment Agent Situation Action) : Prop :=
  ∀ agent situation action,
    left agent situation action = right agent situation action

theorem JudgmentEquivalent.refl
    (judgment : MoralJudgment Agent Situation Action) :
    JudgmentEquivalent judgment judgment := fun _ _ _ => rfl

theorem JudgmentEquivalent.symm
    {left right : MoralJudgment Agent Situation Action}
    (equivalent : JudgmentEquivalent left right) :
    JudgmentEquivalent right left := fun agent situation action =>
  (equivalent agent situation action).symm

theorem JudgmentEquivalent.trans
    {first second third : MoralJudgment Agent Situation Action}
    (firstSecond : JudgmentEquivalent first second)
    (secondThird : JudgmentEquivalent second third) :
    JudgmentEquivalent first third := fun agent situation action =>
  (firstSecond agent situation action).trans (secondThird agent situation action)

/-- Pointwise verdict agreement is equality of the supplied judgment maps. -/
theorem judgmentEquivalent_iff_eq {left right : MoralJudgment Agent Situation Action} :
    JudgmentEquivalent left right ↔ left = right :=
  ⟨fun same => funext fun a => funext fun s => funext fun c => same a s c,
    fun same a s c => congrFun (congrFun (congrFun same a) s) c⟩

/-! ## Theory and model semantics -/

/-- A deontic sentence theory in the source ontology's set-of-sentences
sense. This is distinct from the guarded operational rule theory below. -/
abbrev DeonticSentenceTheory (World : Type uAgent) : Type (max uAgent 1) :=
  Theory (DeonticSentence World)

/-- The four semantic readings needed to compare theory languages. Each
non-value reading is required to commute with its explicit sentence map into
the common value-judgment language. -/
structure AlignedParadigmSemantics (World : Type uAgent) where
  deontic : DeonticSemantics World
  value : ValueSemantics World
  utility : UtilityAssignmentSemantics World
  virtueTarget : VirtueTargetSemantics World
  deontic_to_value :
    ∀ world sentence,
      (deonticSemantics World deontic).Sat world sentence ↔
        (valueJudgmentSemantics World value).Sat world sentence.toValue
  utility_to_value :
    ∀ world sentence,
      (utilityAssignmentSemantics World utility).Sat world sentence ↔
        (valueJudgmentSemantics World value).Sat world sentence.toValue
  virtueTarget_to_value :
    ∀ world sentence,
      (virtueTargetSemantics World virtueTarget).Sat world sentence ↔
        (valueJudgmentSemantics World value).Sat world sentence.toValue

section SentenceSemantics

variable {World : Type uAgent}

/-- Canonical non-vacuous alignment generated by one empirical utility
semantics. Deontic and virtue-target sentences read the sign-classified value
of the same world/formula score; no theorem assumes the four readings align
without constructing or supplying this evidence. -/
def AlignedParadigmSemantics.ofUtility
    (utility : UtilityAssignmentSemantics World) :
    AlignedParadigmSemantics World where
  deontic :=
    { deontic := fun tag formula =>
        (valueSemanticsOfUtility World utility).morally
          (deonticToMoralValue tag) formula }
  value := valueSemanticsOfUtility World utility
  utility := utility
  virtueTarget :=
    { targets := fun aspect formula =>
        (valueSemanticsOfUtility World utility).morally
          (virtueAspectToMoralValue aspect) formula }
  deontic_to_value _ _ := Iff.rfl
  utility_to_value _ _ := Iff.rfl
  virtueTarget_to_value _ _ := Iff.rfl

/-- Two theories in different sentence languages have the same models. -/
def ModelsEquivalentAcross
    {Sentence₁ : Type uAgent} {Sentence₂ : Type uSituation}
    {Model : Type uAction}
    (semantics₁ : Semantics Sentence₁ Model)
    (semantics₂ : Semantics Sentence₂ Model)
    (theory₁ : Theory Sentence₁) (theory₂ : Theory Sentence₂) : Prop :=
  ∀ model, Models semantics₁ model theory₁ ↔ Models semantics₂ model theory₂

/-! ### Explicit sentence and theory translations -/

def deonticToUtilitySentence
    (sentence : DeonticSentence World) : UtilityAssignmentSentence World :=
  sentence.toValue.toUtilityAssignment

def deonticToVirtueTargetSentence
    (sentence : DeonticSentence World) : VirtueTargetSentence World :=
  sentence.toValue.toVirtueTarget

def utilityToDeonticSentence
    (sentence : UtilityAssignmentSentence World) : DeonticSentence World :=
  sentence.toValue.toDeontic

def utilityToVirtueTargetSentence
    (sentence : UtilityAssignmentSentence World) : VirtueTargetSentence World :=
  sentence.toValue.toVirtueTarget

def virtueTargetToDeonticSentence
    (sentence : VirtueTargetSentence World) : DeonticSentence World :=
  sentence.toValue.toDeontic

def virtueTargetToUtilitySentence
    (sentence : VirtueTargetSentence World) : UtilityAssignmentSentence World :=
  sentence.toValue.toUtilityAssignment

def deonticToUtilityTheory
    (theory : DeonticSentenceTheory World) : UtilityAssignmentTheory World :=
  Theory.map deonticToUtilitySentence theory

def deonticToVirtueTargetTheory
    (theory : DeonticSentenceTheory World) : VirtueTargetTheory World :=
  Theory.map deonticToVirtueTargetSentence theory

def utilityToDeonticTheory
    (theory : UtilityAssignmentTheory World) : DeonticSentenceTheory World :=
  Theory.map utilityToDeonticSentence theory

def utilityToVirtueTargetTheory
    (theory : UtilityAssignmentTheory World) : VirtueTargetTheory World :=
  Theory.map utilityToVirtueTargetSentence theory

def virtueTargetToDeonticTheory
    (theory : VirtueTargetTheory World) : DeonticSentenceTheory World :=
  Theory.map virtueTargetToDeonticSentence theory

def virtueTargetToUtilityTheory
    (theory : VirtueTargetTheory World) : UtilityAssignmentTheory World :=
  Theory.map virtueTargetToUtilitySentence theory

variable (alignment : AlignedParadigmSemantics World)

/-! ### Satisfaction commutation -/

theorem AlignedParadigmSemantics.value_to_deontic
    (world : World) (sentence : ValueJudgmentSentence World) :
    (valueJudgmentSemantics World alignment.value).Sat world sentence ↔
      (deonticSemantics World alignment.deontic).Sat world sentence.toDeontic := by
  simpa only [ValueJudgmentSentence.toDeontic_toValue] using
    (alignment.deontic_to_value world sentence.toDeontic).symm

theorem AlignedParadigmSemantics.value_to_utility
    (world : World) (sentence : ValueJudgmentSentence World) :
    (valueJudgmentSemantics World alignment.value).Sat world sentence ↔
      (utilityAssignmentSemantics World alignment.utility).Sat world
        sentence.toUtilityAssignment := by
  simpa only [ValueJudgmentSentence.toUtilityAssignment_toValue] using
    (alignment.utility_to_value world sentence.toUtilityAssignment).symm

theorem AlignedParadigmSemantics.value_to_virtueTarget
    (world : World) (sentence : ValueJudgmentSentence World) :
    (valueJudgmentSemantics World alignment.value).Sat world sentence ↔
      (virtueTargetSemantics World alignment.virtueTarget).Sat world
        sentence.toVirtueTarget := by
  simpa only [ValueJudgmentSentence.toVirtueTarget_toValue] using
    (alignment.virtueTarget_to_value world sentence.toVirtueTarget).symm

theorem AlignedParadigmSemantics.deontic_to_utility
    (world : World) (sentence : DeonticSentence World) :
    (deonticSemantics World alignment.deontic).Sat world sentence ↔
      (utilityAssignmentSemantics World alignment.utility).Sat world
        (deonticToUtilitySentence sentence) :=
  (alignment.deontic_to_value world sentence).trans
    (alignment.value_to_utility world sentence.toValue)

theorem AlignedParadigmSemantics.deontic_to_virtueTarget
    (world : World) (sentence : DeonticSentence World) :
    (deonticSemantics World alignment.deontic).Sat world sentence ↔
      (virtueTargetSemantics World alignment.virtueTarget).Sat world
        (deonticToVirtueTargetSentence sentence) :=
  (alignment.deontic_to_value world sentence).trans
    (alignment.value_to_virtueTarget world sentence.toValue)

theorem AlignedParadigmSemantics.utility_to_deontic
    (world : World) (sentence : UtilityAssignmentSentence World) :
    (utilityAssignmentSemantics World alignment.utility).Sat world sentence ↔
      (deonticSemantics World alignment.deontic).Sat world
        (utilityToDeonticSentence sentence) :=
  (alignment.utility_to_value world sentence).trans
    (alignment.value_to_deontic world sentence.toValue)

theorem AlignedParadigmSemantics.utility_to_virtueTarget
    (world : World) (sentence : UtilityAssignmentSentence World) :
    (utilityAssignmentSemantics World alignment.utility).Sat world sentence ↔
      (virtueTargetSemantics World alignment.virtueTarget).Sat world
        (utilityToVirtueTargetSentence sentence) :=
  (alignment.utility_to_value world sentence).trans
    (alignment.value_to_virtueTarget world sentence.toValue)

theorem AlignedParadigmSemantics.virtueTarget_to_deontic
    (world : World) (sentence : VirtueTargetSentence World) :
    (virtueTargetSemantics World alignment.virtueTarget).Sat world sentence ↔
      (deonticSemantics World alignment.deontic).Sat world
        (virtueTargetToDeonticSentence sentence) :=
  (alignment.virtueTarget_to_value world sentence).trans
    (alignment.value_to_deontic world sentence.toValue)

theorem AlignedParadigmSemantics.virtueTarget_to_utility
    (world : World) (sentence : VirtueTargetSentence World) :
    (virtueTargetSemantics World alignment.virtueTarget).Sat world sentence ↔
      (utilityAssignmentSemantics World alignment.utility).Sat world
        (virtueTargetToUtilitySentence sentence) :=
  (alignment.virtueTarget_to_value world sentence).trans
    (alignment.value_to_utility world sentence.toValue)

/-! ### All six model-class equivalences -/

theorem models_deonticToUtilityTheory_iff
    (theory : DeonticSentenceTheory World) (model : World) :
    Models (deonticSemantics World alignment.deontic) model theory ↔
      Models (utilityAssignmentSemantics World alignment.utility) model
        (deonticToUtilityTheory theory) :=
  models_map_iff _ _ deonticToUtilitySentence alignment.deontic_to_utility model theory

theorem models_deonticToVirtueTargetTheory_iff
    (theory : DeonticSentenceTheory World) (model : World) :
    Models (deonticSemantics World alignment.deontic) model theory ↔
      Models (virtueTargetSemantics World alignment.virtueTarget) model
        (deonticToVirtueTargetTheory theory) :=
  models_map_iff _ _ deonticToVirtueTargetSentence alignment.deontic_to_virtueTarget model theory

theorem models_utilityToDeonticTheory_iff
    (theory : UtilityAssignmentTheory World) (model : World) :
    Models (utilityAssignmentSemantics World alignment.utility) model theory ↔
      Models (deonticSemantics World alignment.deontic) model
        (utilityToDeonticTheory theory) :=
  models_map_iff _ _ utilityToDeonticSentence alignment.utility_to_deontic model theory

theorem models_utilityToVirtueTargetTheory_iff
    (theory : UtilityAssignmentTheory World) (model : World) :
    Models (utilityAssignmentSemantics World alignment.utility) model theory ↔
      Models (virtueTargetSemantics World alignment.virtueTarget) model
        (utilityToVirtueTargetTheory theory) :=
  models_map_iff _ _ utilityToVirtueTargetSentence alignment.utility_to_virtueTarget model theory

theorem models_virtueTargetToDeonticTheory_iff
    (theory : VirtueTargetTheory World) (model : World) :
    Models (virtueTargetSemantics World alignment.virtueTarget) model theory ↔
      Models (deonticSemantics World alignment.deontic) model
        (virtueTargetToDeonticTheory theory) :=
  models_map_iff _ _ virtueTargetToDeonticSentence alignment.virtueTarget_to_deontic model theory

theorem models_virtueTargetToUtilityTheory_iff
    (theory : VirtueTargetTheory World) (model : World) :
    Models (virtueTargetSemantics World alignment.virtueTarget) model theory ↔
      Models (utilityAssignmentSemantics World alignment.utility) model
        (virtueTargetToUtilityTheory theory) :=
  models_map_iff _ _ virtueTargetToUtilitySentence alignment.virtueTarget_to_utility model theory

/-- Strong theory-semantic MPE: under a declared alignment of the four
semantics, every theory in each native sentence language has a translated
theory in each other language with exactly the same model class. -/
def ExactTheorySemanticMPE
    (alignment : AlignedParadigmSemantics World) : Prop :=
  (∀ theory : DeonticSentenceTheory World,
      ModelsEquivalentAcross
        (deonticSemantics World alignment.deontic)
        (utilityAssignmentSemantics World alignment.utility)
        theory (deonticToUtilityTheory theory) ∧
      ModelsEquivalentAcross
        (deonticSemantics World alignment.deontic)
        (virtueTargetSemantics World alignment.virtueTarget)
        theory (deonticToVirtueTargetTheory theory)) ∧
  (∀ theory : UtilityAssignmentTheory World,
      ModelsEquivalentAcross
        (utilityAssignmentSemantics World alignment.utility)
        (deonticSemantics World alignment.deontic)
        theory (utilityToDeonticTheory theory) ∧
      ModelsEquivalentAcross
        (utilityAssignmentSemantics World alignment.utility)
        (virtueTargetSemantics World alignment.virtueTarget)
        theory (utilityToVirtueTargetTheory theory)) ∧
  (∀ theory : VirtueTargetTheory World,
      ModelsEquivalentAcross
        (virtueTargetSemantics World alignment.virtueTarget)
        (deonticSemantics World alignment.deontic)
        theory (virtueTargetToDeonticTheory theory) ∧
      ModelsEquivalentAcross
        (virtueTargetSemantics World alignment.virtueTarget)
        (utilityAssignmentSemantics World alignment.utility)
        theory (virtueTargetToUtilityTheory theory))

theorem exact_theory_semantic_mpe
    (alignment : AlignedParadigmSemantics World) :
    ExactTheorySemanticMPE alignment :=
  ⟨fun theory => ⟨models_deonticToUtilityTheory_iff alignment theory,
      models_deonticToVirtueTargetTheory_iff alignment theory⟩,
    fun theory => ⟨models_utilityToDeonticTheory_iff alignment theory,
      models_utilityToVirtueTargetTheory_iff alignment theory⟩,
    fun theory => ⟨models_virtueTargetToDeonticTheory_iff alignment theory,
      models_virtueTargetToUtilityTheory_iff alignment theory⟩⟩

theorem exact_theory_semantic_mpe_ofUtility
    (utility : UtilityAssignmentSemantics World) :
    ExactTheorySemanticMPE (AlignedParadigmSemantics.ofUtility utility) :=
  exact_theory_semantic_mpe _

end SentenceSemantics

/-- Exact semantic translation need not preserve the source's incidental
numeric encoding. A utility of seven and its canonical moral-value round trip
have the same sign classification but different utility tags. -/
def utilitySevenSentence : UtilityAssignmentSentence Unit where
  tag := 7
  formula _ := True

theorem utilitySeven_roundtrip_changes_tag :
    utilitySevenSentence.toValue.toUtilityAssignment.tag ≠
      utilitySevenSentence.tag := by
  norm_num [utilitySevenSentence, UtilityAssignmentSentence.toValue,
    ValueJudgmentSentence.toUtilityAssignment, utilityToMoralValue,
    moralValueToUtility]

/-! ## Guarded deontic theories -/

/-- A deontic rule has a normative force and a guard specifying the cases in
which that force applies. -/
structure DeonticRule
    (Agent : Type uAgent) (Situation : Type uSituation)
    (Action : Type uAction) where
  force : DeonticAttribute
  guard : Agent → Situation → Action → Prop

/-- A deontic theory is a set of guarded rules. -/
structure DeonticTheory
    (Agent : Type uAgent) (Situation : Type uSituation)
    (Action : Type uAction) where
  rules : Set (DeonticRule Agent Situation Action)

namespace DeonticTheory

/-- A deontic theory supports a verdict when an applicable rule has the
corresponding normative force.  Multiple supported verdicts remain visible. -/
def SupportsVerdict
    (theory : DeonticTheory Agent Situation Action)
    (agent : Agent) (situation : Situation) (action : Action)
    (verdict : MoralValueAttribute) : Prop :=
  ∃ rule, rule ∈ theory.rules ∧
    rule.guard agent situation action ∧
    deonticToMoralValue rule.force = verdict

/-- A deontic theory is determinate when exactly one verdict is supported for
every case. -/
def Determinate
    (theory : DeonticTheory Agent Situation Action) : Prop :=
  ∀ agent situation action,
    ∃! verdict, theory.SupportsVerdict agent situation action verdict

/-- The guarded rule corresponding to one verdict of an arbitrary evaluated
theory. -/
def classifierRule
    (judgment : MoralJudgment Agent Situation Action)
    (verdict : MoralValueAttribute) :
    DeonticRule Agent Situation Action where
  force := moralValueToDeontic verdict
  guard agent situation action :=
    judgment agent situation action = verdict

/-- Exact deontic encoding of an arbitrary evaluated theory. -/
def ofJudgment
    (judgment : MoralJudgment Agent Situation Action) :
    DeonticTheory Agent Situation Action where
  rules := Set.range (classifierRule judgment)

theorem ofJudgment_supportsVerdict_iff
    (judgment : MoralJudgment Agent Situation Action)
    (agent : Agent) (situation : Situation) (action : Action)
    (verdict : MoralValueAttribute) :
    (ofJudgment judgment).SupportsVerdict agent situation action verdict ↔
      judgment agent situation action = verdict := by
  simp [SupportsVerdict, ofJudgment, classifierRule,
    deonticToMoralValue_moralValueToDeontic]

theorem ofJudgment_determinate
    (judgment : MoralJudgment Agent Situation Action) :
    (ofJudgment judgment).Determinate := by
  intro agent situation action
  simp only [ofJudgment_supportsVerdict_iff, existsUnique_eq']

end DeonticTheory

/-- A determinate deontic theory carries the exactness condition needed to
extract its evaluated moral judgments. -/
structure DeterminateDeonticTheory
    (Agent : Type uAgent) (Situation : Type uSituation)
    (Action : Type uAction) where
  theory : DeonticTheory Agent Situation Action
  determinate : theory.Determinate

namespace DeterminateDeonticTheory

/-- The unique verdict supported by a determinate deontic theory. -/
noncomputable def judgment
    (theory : DeterminateDeonticTheory Agent Situation Action) :
    MoralJudgment Agent Situation Action :=
  fun agent situation action =>
    Classical.choose (theory.determinate agent situation action)

theorem supportsVerdict_iff_judgment_eq
    (theory : DeterminateDeonticTheory Agent Situation Action)
    (agent : Agent) (situation : Situation) (action : Action)
    (verdict : MoralValueAttribute) :
    theory.theory.SupportsVerdict agent situation action verdict ↔
      theory.judgment agent situation action = verdict :=
  (theory.determinate agent situation action).choose_eq_iff.symm

/-- Package the exact guarded-rule encoding as a determinate theory. -/
def ofJudgment
    (source : MoralJudgment Agent Situation Action) :
    DeterminateDeonticTheory Agent Situation Action where
  theory := DeonticTheory.ofJudgment source
  determinate := DeonticTheory.ofJudgment_determinate source

theorem ofJudgment_judgmentEquivalent
    (source : MoralJudgment Agent Situation Action) :
    JudgmentEquivalent (ofJudgment source).judgment source := by
  intro agent situation action
  exact (supportsVerdict_iff_judgment_eq _ _ _ _ _).1
    ((DeonticTheory.ofJudgment_supportsVerdict_iff _ _ _ _ _).2 rfl)

end DeterminateDeonticTheory

/-! ## Integer-utility theories -/

/-- A utility theory assigns an integer utility to every case.  Its moral
judgment is the sign classification used by the source ontology's canonical
value/utility translations. -/
structure UtilityTheory
    (Agent : Type uAgent) (Situation : Type uSituation)
    (Action : Type uAction) where
  utility : Agent → Situation → Action → Int

namespace UtilityTheory

def judgment
    (theory : UtilityTheory Agent Situation Action) :
    MoralJudgment Agent Situation Action :=
  fun agent situation action =>
    utilityToMoralValue (theory.utility agent situation action)

def SupportsVerdict
    (theory : UtilityTheory Agent Situation Action)
    (agent : Agent) (situation : Situation) (action : Action)
    (verdict : MoralValueAttribute) : Prop :=
  theory.judgment agent situation action = verdict

/-- Exact utility encoding of an arbitrary evaluated theory. -/
def ofJudgment
    (source : MoralJudgment Agent Situation Action) :
    UtilityTheory Agent Situation Action where
  utility agent situation action :=
    moralValueToUtility (source agent situation action)

@[simp] theorem ofJudgment_judgment
    (source : MoralJudgment Agent Situation Action)
    (agent : Agent) (situation : Situation) (action : Action) :
    (ofJudgment source).judgment agent situation action =
      source agent situation action := by
  simp [ofJudgment, judgment, utilityToMoralValue_moralValueToUtility]

theorem ofJudgment_judgmentEquivalent
    (source : MoralJudgment Agent Situation Action) :
    JudgmentEquivalent (ofJudgment source).judgment source :=
  ofJudgment_judgment source

/-- The exact encoding uses only the canonical `-1`, `0`, and `1` utilities.
This is the explicit utility-side quirk rather than an implicit oracle. -/
theorem ofJudgment_utility_is_canonical
    (source : MoralJudgment Agent Situation Action)
    (agent : Agent) (situation : Situation) (action : Action) :
    (ofJudgment source).utility agent situation action = -1 ∨
      (ofJudgment source).utility agent situation action = 0 ∨
      (ofJudgment source).utility agent situation action = 1 := by
  cases verdict : source agent situation action <;>
    simp [ofJudgment, verdict, moralValueToUtility]

end UtilityTheory

/-! ## Complete target-centered virtue theories -/

abbrev TargetVirtueTheory
    (Agent : Type uAgent) (Situation : Type uSituation)
    (Action : Type uAction) :=
  TargetCenteredVirtue.Theory MoralValueAttribute Agent Situation Action
    MoralValueAttribute

namespace TargetVirtueTheory

/-- The virtue corresponding to a verdict.  Every aspect is explicit:
the field and mode are unrestricted, the basis is the verdict itself, and the
target asks whether the source theory returns that verdict. -/
def classifierVirtue
    (source : MoralJudgment Agent Situation Action)
    (verdict : MoralValueAttribute) :
    VirtueSpec Agent Situation Action MoralValueAttribute where
  valence := CharacterValence.ofMoralValue verdict
  field _ := True
  basis := {verdict}
  basis_nonempty := ⟨verdict, by simp⟩
  mode _ _ _ := True
  target agent situation action :=
    source agent situation action = verdict

/-- Exact target-centered virtue encoding of an arbitrary evaluated theory. -/
def ofJudgment
    (source : MoralJudgment Agent Situation Action) :
    TargetVirtueTheory Agent Situation Action where
  included := Set.univ
  spec := classifierVirtue source

theorem ofJudgment_supportsVerdict_iff
    (source : MoralJudgment Agent Situation Action)
    (agent : Agent) (situation : Situation) (action : Action)
    (verdict : MoralValueAttribute) :
    (ofJudgment source).SupportsVerdict agent situation action verdict ↔
      source agent situation action = verdict := by
  simp [TargetCenteredVirtue.Theory.SupportsVerdict, ofJudgment,
    classifierVirtue, VirtueSpec.ActionHitsTarget]

def Determinate
    (theory : TargetVirtueTheory Agent Situation Action) : Prop :=
  ∀ agent situation action,
    ∃! verdict, theory.SupportsVerdict agent situation action verdict

theorem ofJudgment_determinate
    (source : MoralJudgment Agent Situation Action) :
    (ofJudgment source).Determinate := by
  intro agent situation action
  simp only [ofJudgment_supportsVerdict_iff, existsUnique_eq']

end TargetVirtueTheory

structure DeterminateTargetVirtueTheory
    (Agent : Type uAgent) (Situation : Type uSituation)
    (Action : Type uAction) where
  theory : TargetVirtueTheory Agent Situation Action
  determinate : theory.Determinate

namespace DeterminateTargetVirtueTheory

noncomputable def judgment
    (theory : DeterminateTargetVirtueTheory Agent Situation Action) :
    MoralJudgment Agent Situation Action :=
  fun agent situation action =>
    Classical.choose (theory.determinate agent situation action)

theorem supportsVerdict_iff_judgment_eq
    (theory : DeterminateTargetVirtueTheory Agent Situation Action)
    (agent : Agent) (situation : Situation) (action : Action)
    (verdict : MoralValueAttribute) :
    theory.theory.SupportsVerdict agent situation action verdict ↔
      theory.judgment agent situation action = verdict :=
  (theory.determinate agent situation action).choose_eq_iff.symm

def ofJudgment
    (source : MoralJudgment Agent Situation Action) :
    DeterminateTargetVirtueTheory Agent Situation Action where
  theory := TargetVirtueTheory.ofJudgment source
  determinate := TargetVirtueTheory.ofJudgment_determinate source

theorem ofJudgment_judgmentEquivalent
    (source : MoralJudgment Agent Situation Action) :
    JudgmentEquivalent (ofJudgment source).judgment source := by
  intro agent situation action
  exact (supportsVerdict_iff_judgment_eq _ _ _ _ _).1
    ((TargetVirtueTheory.ofJudgment_supportsVerdict_iff _ _ _ _ _).2 rfl)

end DeterminateTargetVirtueTheory

/-! ## Canonical realizations

The readout forgets rule, virtue, or utility data beyond the evaluated verdict.
The encoders above choose representatives of those verdicts; they do not recover
all of the original theory. The determinate families retain their uniqueness
premises when supplying these readouts.
-/

noncomputable def DeterminateDeonticTheory.realization :
    JudgmentRealization (DeterminateDeonticTheory Agent Situation Action)
      (MoralJudgment Agent Situation Action) where
  readout := DeterminateDeonticTheory.judgment
  realize := DeterminateDeonticTheory.ofJudgment
  readout_realize source := judgmentEquivalent_iff_eq.mp
    (DeterminateDeonticTheory.ofJudgment_judgmentEquivalent source)

def UtilityTheory.realization :
    JudgmentRealization (UtilityTheory Agent Situation Action)
      (MoralJudgment Agent Situation Action) where
  readout := UtilityTheory.judgment
  realize := UtilityTheory.ofJudgment
  readout_realize source := judgmentEquivalent_iff_eq.mp
    (UtilityTheory.ofJudgment_judgmentEquivalent source)

noncomputable def DeterminateTargetVirtueTheory.realization :
    JudgmentRealization (DeterminateTargetVirtueTheory Agent Situation Action)
      (MoralJudgment Agent Situation Action) where
  readout := DeterminateTargetVirtueTheory.judgment
  realize := DeterminateTargetVirtueTheory.ofJudgment
  readout_realize source := judgmentEquivalent_iff_eq.mp
    (DeterminateTargetVirtueTheory.ofJudgment_judgmentEquivalent source)

/-! ## All six ordered translations -/

namespace DeterminateDeonticTheory

variable (source : DeterminateDeonticTheory Agent Situation Action)

noncomputable def toUtility : UtilityTheory Agent Situation Action :=
  UtilityTheory.ofJudgment source.judgment

noncomputable def toTargetVirtue : DeterminateTargetVirtueTheory Agent Situation Action :=
  DeterminateTargetVirtueTheory.ofJudgment source.judgment

theorem toUtility_exact :
    JudgmentEquivalent source.toUtility.judgment source.judgment :=
  judgmentEquivalent_iff_eq.mpr (realization.readout_translateTo UtilityTheory.realization source)

theorem toTargetVirtue_exact :
    JudgmentEquivalent source.toTargetVirtue.judgment source.judgment :=
  judgmentEquivalent_iff_eq.mpr
    (realization.readout_translateTo DeterminateTargetVirtueTheory.realization source)

end DeterminateDeonticTheory

namespace UtilityTheory

variable (source : UtilityTheory Agent Situation Action)

def toDeontic : DeterminateDeonticTheory Agent Situation Action :=
  DeterminateDeonticTheory.ofJudgment source.judgment

def toTargetVirtue : DeterminateTargetVirtueTheory Agent Situation Action :=
  DeterminateTargetVirtueTheory.ofJudgment source.judgment

theorem toDeontic_exact :
    JudgmentEquivalent source.toDeontic.judgment source.judgment :=
  judgmentEquivalent_iff_eq.mpr
    (realization.readout_translateTo DeterminateDeonticTheory.realization source)

theorem toTargetVirtue_exact :
    JudgmentEquivalent source.toTargetVirtue.judgment source.judgment :=
  judgmentEquivalent_iff_eq.mpr
    (realization.readout_translateTo DeterminateTargetVirtueTheory.realization source)

end UtilityTheory

namespace DeterminateTargetVirtueTheory

variable (source : DeterminateTargetVirtueTheory Agent Situation Action)

noncomputable def toDeontic : DeterminateDeonticTheory Agent Situation Action :=
  DeterminateDeonticTheory.ofJudgment source.judgment

noncomputable def toUtility : UtilityTheory Agent Situation Action :=
  UtilityTheory.ofJudgment source.judgment

theorem toDeontic_exact :
    JudgmentEquivalent source.toDeontic.judgment source.judgment :=
  judgmentEquivalent_iff_eq.mpr
    (realization.readout_translateTo DeterminateDeonticTheory.realization source)

theorem toUtility_exact :
    JudgmentEquivalent source.toUtility.judgment source.judgment :=
  judgmentEquivalent_iff_eq.mpr (realization.readout_translateTo UtilityTheory.realization source)

end DeterminateTargetVirtueTheory

/-- Strong evaluation-level Moral Paradigm Equivalence: every theory in each
of the three determinate theory families has exact translations into both
other families. -/
def ExactMoralParadigmEquivalence : Prop :=
  (∀ (Agent : Type uAgent) (Situation : Type uSituation)
      (Action : Type uAction)
      (source : DeterminateDeonticTheory Agent Situation Action),
      JudgmentEquivalent source.toUtility.judgment source.judgment ∧
      JudgmentEquivalent source.toTargetVirtue.judgment source.judgment) ∧
  (∀ (Agent : Type uAgent) (Situation : Type uSituation)
      (Action : Type uAction)
      (source : UtilityTheory Agent Situation Action),
      JudgmentEquivalent source.toDeontic.judgment source.judgment ∧
      JudgmentEquivalent source.toTargetVirtue.judgment source.judgment) ∧
  (∀ (Agent : Type uAgent) (Situation : Type uSituation)
      (Action : Type uAction)
      (source : DeterminateTargetVirtueTheory Agent Situation Action),
      JudgmentEquivalent source.toDeontic.judgment source.judgment ∧
      JudgmentEquivalent source.toUtility.judgment source.judgment)

theorem exact_moral_paradigm_equivalence :
    ExactMoralParadigmEquivalence :=
  ⟨fun _ _ _ source => ⟨source.toUtility_exact, source.toTargetVirtue_exact⟩,
    fun _ _ _ source => ⟨source.toDeontic_exact, source.toTargetVirtue_exact⟩,
    fun _ _ _ source => ⟨source.toDeontic_exact, source.toUtility_exact⟩⟩

/-! ## Positive and negative specimens -/

inductive RescueSituation : Type
  | ordinary
  | emergency
  deriving DecidableEq, Repr

inductive RescueAction : Type
  | wait
  | cross
  deriving DecidableEq, Repr

def rescueJudgment : MoralJudgment Unit RescueSituation RescueAction
  | _, .emergency, .cross => .MorallyGood
  | _, .ordinary, .cross => .MorallyBad
  | _, _, .wait => .MorallyPermissible

def rescueDeonticTheory :=
  DeterminateDeonticTheory.ofJudgment rescueJudgment

def rescueUtilityTheory :=
  UtilityTheory.ofJudgment rescueJudgment

def rescueVirtueTheory :=
  DeterminateTargetVirtueTheory.ofJudgment rescueJudgment

theorem rescue_all_paradigms_agree :
    JudgmentEquivalent rescueDeonticTheory.judgment rescueJudgment ∧
      JudgmentEquivalent rescueUtilityTheory.judgment rescueJudgment ∧
      JudgmentEquivalent rescueVirtueTheory.judgment rescueJudgment :=
  ⟨DeterminateDeonticTheory.ofJudgment_judgmentEquivalent rescueJudgment,
    UtilityTheory.ofJudgment_judgmentEquivalent rescueJudgment,
    DeterminateTargetVirtueTheory.ofJudgment_judgmentEquivalent rescueJudgment⟩

def allGoodJudgment : MoralJudgment Unit RescueSituation RescueAction :=
  fun _ _ _ => .MorallyGood

/-- MPE does not say that distinct theories are equivalent.  The rescue theory
and the all-good theory disagree on ordinary crossing. -/
theorem rescue_not_equivalent_allGood :
    ¬ JudgmentEquivalent rescueJudgment allGoodJudgment := by
  intro equivalent
  have := equivalent () .ordinary .cross
  cases this

end Mettapedia.Ethics.MoralParadigmEquivalence
