import Mettapedia.FluidDynamics.NavierStokes.OneFormFrameCalculus

/-!
# The frozen-strain vorticity model and its uniform-depletion counterexample

The linear "frozen strain" model for three-dimensional vorticity stretching:
freeze the strain matrix at the axisymmetric traceless value
`A = diag(2γ, −γ, −γ)` and evolve a vorticity wave packet by the linear
vorticity equation

`∂_t ω + (Ax · ∇) ω = A ω + ν Δ ω`.

For the divergence-free packet `ω₀ = a₀ sin(k₀ x₁) e₀` (vorticity along the
expanding axis, wave vector along a compressive axis — the "pancake"
configuration), the model has the exact solution

* wave number `k(t) = k₀ e^{γt}` (compression raises the frequency), and
* amplitude `a(t) = a₀ exp(2γt − ν k₀² (e^{2γt} − 1)/(2γ))`,

machine-checked below (`frozenStrainVorticity_solves`).

## The two headline consequences

1. `frozenStrain_no_uniform_amplification_bound`: over the strain family
   `γ`, the peak amplification admits **no** uniform bound — at the time
   `t* = log(2γ/(νk₀²))/(2γ)` the amplification equals
   `(2γ/(νk₀²)) · e^{1/g − 1}`, which is unbounded as `γ/(νk₀²) → ∞`.
   Consequently any unconditional claim of the form "vorticity aligned with
   an expanding strain direction and compressed in wave vector always
   acquires diffusive decay at rate `ν λ²` uniformly over the local strain"
   is **false** in this model: diffusive depletion loses to stretching for
   `γ ≫ ν k₀²` on the coherent time window.  Any proof of a stretching gate
   must therefore use structure beyond frozen local strain plus covariance
   (e.g. the self-consistency of the strain generated by the actual
   Navier–Stokes solution).  The failure is one of *uniformity over the
   strain family*: for each fixed `γ` the solution is transient, but the
   transient peak is unbounded in `γ`.

2. `anisotropic_coverage_gap`: in the frequency-localized angular analysis
   of a stretching gate, the stretch–diffusion (covariance) mechanism
   fails on angular apertures up to `√(γ/ν)/λ` around the compressive
   direction, while anisotropic Bernstein estimates control apertures up to
   `λ^{−1/2}`.  The inequality `λ^{−1/2} < √(γ/ν)/λ` — an uncovered band of
   apertures claimed by neither mechanism — holds **iff** `ν λ < γ`.  Strong
   local strain (`γ` up to `∼ ν λ²` in near-singular regimes) therefore
   leaves a nonempty uncovered band, so the two mechanisms do not by
   themselves exhaust the sphere of directions.

## Context

Under the stochastic-Lagrangian representation of the Navier–Stokes
equations (P. Constantin, G. Iyer, Comm. Pure Appl. Math. **61** (2008),
330–345, arXiv:math/0511067) the continuation gate is the integrated flow
Jacobian `∫₀ᵀ 𝔼‖DX_t‖_∞ dt` (Beale–Kato–Majda-type criterion via the
averaged Cauchy vorticity formula; J. T. Beale, T. Kato, A. Majda, Comm.
Math. Phys. **94** (1984), 61–66).  This file pins down, in the standard
frozen-strain regression model, exactly what stochastic averaging alone
cannot deliver for that gate.  It proves no statement about actual
Navier–Stokes solutions; the model is linear with prescribed strain, and is
labeled as such.
-/

set_option autoImplicit false

noncomputable section

namespace Mettapedia
namespace FluidDynamics
namespace NavierStokes

open scoped RealInnerProductSpace BigOperators

/-- Three-dimensional coordinate space for the frozen-strain model. -/
local notation "R3" => EuclideanSpace ℝ (Fin 3)

section ModelData

/-- The axisymmetric traceless frozen strain `diag(2γ, −γ, −γ)`, as a linear
vector field: expanding along `e₀`, compressing along `e₁` and `e₂`. -/
def frozenStrainDiag (γ : ℝ) : R3 → R3 := fun x =>
  (2 * γ * ⟪(EuclideanSpace.single 0 1 : R3), x⟫) • EuclideanSpace.single 0 1 +
  (-γ * ⟪(EuclideanSpace.single 1 1 : R3), x⟫) • EuclideanSpace.single 1 1 +
  (-γ * ⟪(EuclideanSpace.single 2 1 : R3), x⟫) • EuclideanSpace.single 2 1

/-- Wave number of the compressed packet: `k(t) = k₀ e^{γt}`. -/
def frozenStrainWaveNumber (k₀ γ t : ℝ) : ℝ := k₀ * Real.exp (γ * t)

/-- Exponent of the amplitude law:
`E(t) = 2γt − ν k₀² (e^{2γt} − 1)/(2γ)` — linear stretching against the
diffusive damping accumulated along the exponentially growing frequency. -/
def frozenStrainExponent (ν k₀ γ t : ℝ) : ℝ :=
  2 * γ * t - ν * k₀ ^ 2 * (Real.exp (2 * γ * t) - 1) / (2 * γ)

/-- Normalized amplification factor `a(t)/a₀ = exp E(t)`. -/
def frozenStrainAmplification (ν k₀ γ t : ℝ) : ℝ :=
  Real.exp (frozenStrainExponent ν k₀ γ t)

/-- Amplitude of the packet. -/
def frozenStrainAmplitude (a₀ ν k₀ γ t : ℝ) : ℝ :=
  a₀ * frozenStrainAmplification ν k₀ γ t

/-- The evolving pancake wave packet
`ω(t, x) = a(t) sin(k(t) x₁) e₀`: vorticity along the expanding axis,
wave vector along a compressive axis. -/
def frozenStrainVorticity (a₀ ν k₀ γ : ℝ) : ℝ → R3 → R3 := fun t =>
  profileMode (fun s => frozenStrainAmplitude a₀ ν k₀ γ t * Real.sin s)
    (frozenStrainWaveNumber k₀ γ t • EuclideanSpace.single 1 1)
    (EuclideanSpace.single 0 1)

/-- The linear frozen-strain vorticity equation, pointwise:
`∂_t ω + (Ax·∇)ω = Aω + νΔω` with `A = diag(2γ,−γ,−γ)`. -/
def SolvesFrozenStrainVorticityEq (γ ν : ℝ) (ω : ℝ → R3 → R3) : Prop :=
  ∀ t x, deriv (fun s => ω s x) t + fderiv ℝ (ω t) x (frozenStrainDiag γ x) =
    frozenStrainDiag γ (ω t x) + ν • coordLaplacian (ω t) x

end ModelData

section ModelIdentities

/-- Pointwise form of the packet through the scalar phase `⟪e₁, x⟫`. -/
theorem frozenStrainVorticity_apply (a₀ ν k₀ γ t : ℝ) (x : R3) :
    frozenStrainVorticity a₀ ν k₀ γ t x =
      (frozenStrainAmplitude a₀ ν k₀ γ t *
        Real.sin (frozenStrainWaveNumber k₀ γ t *
          ⟪(EuclideanSpace.single 1 1 : R3), x⟫)) •
        (EuclideanSpace.single 0 1 : R3) := by
  unfold frozenStrainVorticity profileMode
  rw [real_inner_smul_left]

/-- The strain field applied to a multiple of the expanding direction. -/
theorem frozenStrainDiag_smul_e0 (γ c : ℝ) :
    frozenStrainDiag γ (c • (EuclideanSpace.single 0 1 : R3)) =
      (2 * γ * c) • (EuclideanSpace.single 0 1 : R3) := by
  unfold frozenStrainDiag
  have h0 : ⟪(EuclideanSpace.single 0 1 : R3),
      c • (EuclideanSpace.single 0 1 : R3)⟫ = c := by
    rw [real_inner_smul_right]
    simp
  have h1 : ⟪(EuclideanSpace.single 1 1 : R3),
      c • (EuclideanSpace.single 0 1 : R3)⟫ = 0 := by
    rw [real_inner_smul_right]
    simp [EuclideanSpace.inner_single_left]
  have h2 : ⟪(EuclideanSpace.single 2 1 : R3),
      c • (EuclideanSpace.single 0 1 : R3)⟫ = 0 := by
    rw [real_inner_smul_right]
    simp [EuclideanSpace.inner_single_left]
  rw [h0, h1, h2]
  simp

/-- The compressive component of the strain field. -/
theorem inner_e1_frozenStrainDiag (γ : ℝ) (x : R3) :
    ⟪(EuclideanSpace.single 1 1 : R3), frozenStrainDiag γ x⟫ =
      -γ * ⟪(EuclideanSpace.single 1 1 : R3), x⟫ := by
  unfold frozenStrainDiag
  rw [inner_add_right, inner_add_right, real_inner_smul_right,
    real_inner_smul_right, real_inner_smul_right]
  have h10 : ⟪(EuclideanSpace.single 1 1 : R3),
      (EuclideanSpace.single 0 1 : R3)⟫ = 0 := by
    simp [EuclideanSpace.inner_single_left]
  have h11 : ⟪(EuclideanSpace.single 1 1 : R3),
      (EuclideanSpace.single 1 1 : R3)⟫ = 1 := by simp
  have h12 : ⟪(EuclideanSpace.single 1 1 : R3),
      (EuclideanSpace.single 2 1 : R3)⟫ = 0 := by
    simp [EuclideanSpace.inner_single_left]
  rw [h10, h11, h12]
  ring

end ModelIdentities

section ODEFacts

/-- The wave number solves `k' = γ k`. -/
theorem hasDerivAt_frozenStrainWaveNumber (k₀ γ t : ℝ) :
    HasDerivAt (frozenStrainWaveNumber k₀ γ)
      (γ * frozenStrainWaveNumber k₀ γ t) t := by
  have hlin : HasDerivAt (fun s : ℝ => γ * s) γ t := by
    simpa using (hasDerivAt_id t).const_mul γ
  have h := (hlin.exp).const_mul k₀
  have hval : k₀ * (Real.exp (γ * t) * γ) =
      γ * frozenStrainWaveNumber k₀ γ t := by
    unfold frozenStrainWaveNumber
    ring
  exact hval ▸ h

/-- The squared wave number in exponential form. -/
theorem frozenStrainWaveNumber_sq (k₀ γ t : ℝ) :
    frozenStrainWaveNumber k₀ γ t ^ 2 = k₀ ^ 2 * Real.exp (2 * γ * t) := by
  unfold frozenStrainWaveNumber
  rw [mul_pow, show (2 : ℝ) * γ * t = γ * t + γ * t by ring, Real.exp_add]
  ring

/-- The amplitude exponent solves `E' = 2γ − ν k(t)²`. -/
theorem hasDerivAt_frozenStrainExponent (ν k₀ : ℝ) {γ : ℝ} (hγ : γ ≠ 0)
    (t : ℝ) :
    HasDerivAt (frozenStrainExponent ν k₀ γ)
      (2 * γ - ν * frozenStrainWaveNumber k₀ γ t ^ 2) t := by
  have hlin : HasDerivAt (fun s : ℝ => 2 * γ * s) (2 * γ) t := by
    simpa using (hasDerivAt_id t).const_mul (2 * γ)
  have hsub : HasDerivAt (fun s : ℝ => Real.exp (2 * γ * s) - 1)
      (Real.exp (2 * γ * t) * (2 * γ)) t := (hlin.exp).sub_const 1
  have htotal := hlin.sub ((hsub.const_mul (ν * k₀ ^ 2)).div_const (2 * γ))
  have hval : 2 * γ - ν * k₀ ^ 2 * (Real.exp (2 * γ * t) * (2 * γ)) / (2 * γ) =
      2 * γ - ν * frozenStrainWaveNumber k₀ γ t ^ 2 := by
    rw [frozenStrainWaveNumber_sq]
    field_simp
  exact hval ▸ htotal

/-- The amplitude solves `a' = (2γ − ν k(t)²) a`. -/
theorem hasDerivAt_frozenStrainAmplitude (a₀ ν k₀ : ℝ) {γ : ℝ} (hγ : γ ≠ 0)
    (t : ℝ) :
    HasDerivAt (frozenStrainAmplitude a₀ ν k₀ γ)
      ((2 * γ - ν * frozenStrainWaveNumber k₀ γ t ^ 2) *
        frozenStrainAmplitude a₀ ν k₀ γ t) t := by
  have h := ((hasDerivAt_frozenStrainExponent ν k₀ hγ t).exp).const_mul a₀
  have hval : a₀ * (Real.exp (frozenStrainExponent ν k₀ γ t) *
      (2 * γ - ν * frozenStrainWaveNumber k₀ γ t ^ 2)) =
      (2 * γ - ν * frozenStrainWaveNumber k₀ γ t ^ 2) *
        frozenStrainAmplitude a₀ ν k₀ γ t := by
    unfold frozenStrainAmplitude frozenStrainAmplification
    ring
  exact hval ▸ h

end ODEFacts

section ExactSolution

/-- **The pancake packet is an exact solution of the frozen-strain vorticity
equation.**  The wave number is exponentially compressed (`k' = γk`) and the
amplitude balances stretching against accumulated diffusion
(`a' = (2γ − νk²) a`); the drift and phase-advection terms cancel. -/
theorem frozenStrainVorticity_solves (a₀ ν k₀ : ℝ) {γ : ℝ} (hγ : γ ≠ 0) :
    SolvesFrozenStrainVorticityEq γ ν (frozenStrainVorticity a₀ ν k₀ γ) := by
  intro t x
  set X : ℝ := ⟪(EuclideanSpace.single 1 1 : R3), x⟫ with hX
  set K : ℝ := frozenStrainWaveNumber k₀ γ t with hK
  set A : ℝ := frozenStrainAmplitude a₀ ν k₀ γ t with hA
  -- (1) The time derivative.
  have htime : deriv (fun s => frozenStrainVorticity a₀ ν k₀ γ s x) t =
      (A * (Real.cos (K * X) * (γ * K * X)) +
        Real.sin (K * X) * ((2 * γ - ν * K ^ 2) * A)) •
        (EuclideanSpace.single 0 1 : R3) := by
    have hfun : (fun s => frozenStrainVorticity a₀ ν k₀ γ s x) =
        fun s => (frozenStrainAmplitude a₀ ν k₀ γ s *
          Real.sin (frozenStrainWaveNumber k₀ γ s * X)) •
          (EuclideanSpace.single 0 1 : R3) := by
      funext s
      exact frozenStrainVorticity_apply a₀ ν k₀ γ s x
    rw [hfun]
    have hphase : HasDerivAt (fun s => frozenStrainWaveNumber k₀ γ s * X)
        (γ * K * X) t := by
      have h := (hasDerivAt_frozenStrainWaveNumber k₀ γ t).mul_const X
      have hval : γ * frozenStrainWaveNumber k₀ γ t * X = γ * K * X := by
        rw [hK]
      exact hval ▸ h
    have hsin :
        HasDerivAt (fun s => Real.sin (frozenStrainWaveNumber k₀ γ s * X))
          (Real.cos (K * X) * (γ * K * X)) t := by
      have h := hphase.sin
      have hval : frozenStrainWaveNumber k₀ γ t * X = K * X := by rw [hK]
      exact hval ▸ h
    have hscalar := (hasDerivAt_frozenStrainAmplitude a₀ ν k₀ hγ t).mul hsin
    have hvec : HasDerivAt
        (fun s => (frozenStrainAmplitude a₀ ν k₀ γ s *
          Real.sin (frozenStrainWaveNumber k₀ γ s * X)) •
          (EuclideanSpace.single 0 1 : R3))
        (((2 * γ - ν * frozenStrainWaveNumber k₀ γ t ^ 2) *
            frozenStrainAmplitude a₀ ν k₀ γ t *
            Real.sin (frozenStrainWaveNumber k₀ γ t * X) +
          frozenStrainAmplitude a₀ ν k₀ γ t *
            (Real.cos (K * X) * (γ * K * X))) •
          (EuclideanSpace.single 0 1 : R3)) t :=
      hscalar.smul_const _
    rw [hvec.deriv, ← hK, ← hA]
    match_scalars
    ring
  -- (2) The advection (drift) term.
  have hdrift : fderiv ℝ (frozenStrainVorticity a₀ ν k₀ γ t) x
      (frozenStrainDiag γ x) =
      (A * Real.cos (K * X) * (K * (-γ * X))) •
        (EuclideanSpace.single 0 1 : R3) := by
    unfold frozenStrainVorticity
    have hmode := hasFDerivAt_profileMode
      (φ := fun s => A * Real.sin s) (dφ := fun s => A * Real.cos s)
      (hasDerivAt_amp_sin A)
      (K • (EuclideanSpace.single 1 1 : R3)) (EuclideanSpace.single 0 1) x
    rw [hmode.fderiv]
    rw [ContinuousLinearMap.smulRight_apply, smul_apply, innerSL_apply_apply,
      smul_eq_mul]
    have hkdrift : ⟪K • (EuclideanSpace.single 1 1 : R3),
        frozenStrainDiag γ x⟫ = K * (-γ * X) := by
      rw [real_inner_smul_left, inner_e1_frozenStrainDiag]
    have hkx : ⟪K • (EuclideanSpace.single 1 1 : R3), x⟫ = K * X := by
      rw [real_inner_smul_left]
    rw [hkdrift, hkx]
  -- (3) The strain (stretching) term.
  have hstrain : frozenStrainDiag γ (frozenStrainVorticity a₀ ν k₀ γ t x) =
      (2 * γ * (A * Real.sin (K * X))) •
        (EuclideanSpace.single 0 1 : R3) := by
    rw [frozenStrainVorticity_apply]
    exact frozenStrainDiag_smul_e0 γ _
  -- (4) The viscous term.
  have hlap : coordLaplacian (frozenStrainVorticity a₀ ν k₀ γ t) x =
      (A * -Real.sin (K * X) * K ^ 2) •
        (EuclideanSpace.single 0 1 : R3) := by
    unfold frozenStrainVorticity
    rw [coordLaplacian_profileMode (dφ := fun s => A * Real.cos s)
      (ddφ := fun s => A * -Real.sin s)
      (hasDerivAt_amp_sin A) (hasDerivAt_amp_cos A) x]
    have hkk : ⟪K • (EuclideanSpace.single 1 1 : R3),
        K • (EuclideanSpace.single 1 1 : R3)⟫ = K ^ 2 := by
      rw [real_inner_smul_left, real_inner_smul_right]
      simp [pow_two]
    have hkx : ⟪K • (EuclideanSpace.single 1 1 : R3), x⟫ = K * X := by
      rw [real_inner_smul_left]
    rw [hkk, hkx]
  -- Assemble: the equation reduces to scalar trigonometric algebra.
  rw [htime, hdrift, hstrain, hlap]
  match_scalars
  ring

end ExactSolution

section UniformDepletionCounterexample

/-- Value of the amplification at the peak time
`t* = log g / (2γ)` for the normalized strain `g = 2γ/(νk₀²)`:
exactly `g · e^{1/g − 1}`. -/
theorem frozenStrainAmplification_peak {ν k₀ γ g : ℝ} (hν : 0 < ν)
    (hk₀ : 0 < k₀) (hg : 1 < g) (hγ : 2 * γ = ν * k₀ ^ 2 * g) :
    frozenStrainAmplification ν k₀ γ (Real.log g / (2 * γ)) =
      g * Real.exp (1 / g - 1) := by
  have hgpos : 0 < g := lt_trans one_pos hg
  have h2γ : (0 : ℝ) < 2 * γ := by
    rw [hγ]
    positivity
  have h2γne : (2 * γ) ≠ 0 := ne_of_gt h2γ
  unfold frozenStrainAmplification frozenStrainExponent
  have hphase : 2 * γ * (Real.log g / (2 * γ)) = Real.log g := by
    rw [mul_comm]
    exact div_mul_cancel₀ _ h2γne
  rw [hphase, Real.exp_log hgpos]
  have hcoeff : ν * k₀ ^ 2 * (g - 1) / (2 * γ) = (g - 1) / g := by
    rw [hγ]
    have hk2 : ν * k₀ ^ 2 ≠ 0 := by positivity
    field_simp
  rw [hcoeff]
  rw [show Real.log g - (g - 1) / g = Real.log g + (1 / g - 1) by
    field_simp
    ring]
  rw [Real.exp_add, Real.exp_log hgpos]

/-- **No uniform amplification bound over the strain family.**  For every
`ν > 0`, `k₀ > 0` and every proposed bound `C`, some frozen strain `γ > 0`
and time `t > 0` drive the amplification of the pancake packet above `C`.

In particular the unconditional claim "a vorticity packet aligned with an
expanding strain axis and compressed in wave vector always acquires
diffusive (covariance) decay at rate `ν λ²` uniformly over the local strain"
is false in the frozen-strain model: no `γ`-uniform bound of any kind
survives, because the coherent stretching window closes only after the
amplification has reached `≈ 2γ/(e ν k₀²)`. -/
theorem frozenStrain_no_uniform_amplification_bound (ν k₀ : ℝ)
    (hν : 0 < ν) (hk₀ : 0 < k₀) (C : ℝ) :
    ∃ γ t : ℝ, 0 < γ ∧ 0 < t ∧
      C < frozenStrainAmplification ν k₀ γ t := by
  set g : ℝ := max (Real.exp 1 * (C + 1)) 2 with hgdef
  have hg2 : (2 : ℝ) ≤ g := le_max_right _ _
  have hg1 : (1 : ℝ) < g := lt_of_lt_of_le one_lt_two hg2
  have hgpos : (0 : ℝ) < g := lt_trans one_pos hg1
  set γ : ℝ := ν * k₀ ^ 2 * g / 2 with hγdef
  have hγpos : 0 < γ := by positivity
  have h2γ : 2 * γ = ν * k₀ ^ 2 * g := by
    rw [hγdef]
    ring
  set t : ℝ := Real.log g / (2 * γ) with htdef
  have htpos : 0 < t := by
    apply div_pos (Real.log_pos hg1)
    positivity
  refine ⟨γ, t, hγpos, htpos, ?_⟩
  rw [htdef, frozenStrainAmplification_peak hν hk₀ hg1 h2γ]
  -- `g e^{1/g − 1} ≥ g e^{−1} ≥ C + 1 > C`.
  have hexp_mono : Real.exp (-1) ≤ Real.exp (1 / g - 1) := by
    apply Real.exp_le_exp.mpr
    have : 0 < 1 / g := by positivity
    linarith
  have hge : Real.exp 1 * (C + 1) ≤ g := le_max_left _ _
  have hepos : (0 : ℝ) < Real.exp 1 := Real.exp_pos 1
  have hC1 : C + 1 ≤ g * Real.exp (-1) := by
    rw [Real.exp_neg]
    have h1 : Real.exp 1 * (C + 1) * (Real.exp 1)⁻¹ ≤ g * (Real.exp 1)⁻¹ :=
      mul_le_mul_of_nonneg_right hge (inv_nonneg.mpr hepos.le)
    have h2 : Real.exp 1 * (C + 1) * (Real.exp 1)⁻¹ = C + 1 := by
      field_simp
    linarith
  calc C < C + 1 := lt_add_one C
    _ ≤ g * Real.exp (-1) := hC1
    _ ≤ g * Real.exp (1 / g - 1) :=
        mul_le_mul_of_nonneg_left hexp_mono (le_of_lt hgpos)

/-- **The aperture coverage gap.**  In the frequency-localized angular
analysis of a stretching gate, stretch–diffusion (covariance) arguments fail
on angular apertures up to `√(γ/ν)/λ` about the compressive direction, while
anisotropic Bernstein estimates cover apertures up to `λ^{−1/2}`.  The band
of apertures claimed by neither mechanism, `(λ^{−1/2}, √(γ/ν)/λ)`, is
nonempty **iff** the local strain exceeds `ν λ`. -/
theorem anisotropic_coverage_gap {γ ν lam : ℝ} (hν : 0 < ν)
    (hlam : 0 < lam) :
    (Real.sqrt lam)⁻¹ < Real.sqrt (γ / ν) / lam ↔ ν * lam < γ := by
  have hsqrtlam : 0 < Real.sqrt lam := Real.sqrt_pos.mpr hlam
  constructor
  · intro h
    have h1 : (Real.sqrt lam)⁻¹ * lam < Real.sqrt (γ / ν) := by
      rw [lt_div_iff₀ hlam] at h
      linarith [h]
    have h2 : Real.sqrt lam < Real.sqrt (γ / ν) := by
      have hval : (Real.sqrt lam)⁻¹ * lam = Real.sqrt lam := by
        rw [inv_mul_eq_div, Real.div_sqrt]
      rw [hval] at h1
      exact h1
    have h3 : lam < γ / ν := by
      by_contra hcon
      have hcon' : γ / ν ≤ lam := not_lt.mp hcon
      have := Real.sqrt_le_sqrt hcon'
      linarith
    rw [lt_div_iff₀ hν] at h3
    linarith
  · intro h
    have h3 : lam < γ / ν := by
      rw [lt_div_iff₀ hν]
      linarith
    have h2 : Real.sqrt lam < Real.sqrt (γ / ν) :=
      Real.sqrt_lt_sqrt (le_of_lt hlam) h3
    rw [lt_div_iff₀ hlam]
    have hval : (Real.sqrt lam)⁻¹ * lam = Real.sqrt lam := by
      rw [inv_mul_eq_div, Real.div_sqrt]
    rw [hval]
    exact h2

end UniformDepletionCounterexample

end NavierStokes
end FluidDynamics
