import Mettapedia.FluidDynamics.NavierStokes.StochasticLagrangian.PancakeMaterialTransportCommutator

/-!
# Moving-point evolution of the hard pancake block

The fixed-point block derivative differentiates only its Fourier
coefficients.  Along a spatial path, the Fourier characters also vary.  This
file proves the exact product rule for a finite reconstruction, takes its real
part, and inserts that derivative into the same nonzero-block direction law.

The character-rate term is kept explicit.  For a fluid trajectory it is the
positive advection of the projected block; the companion material-commutator
module identifies its cancellation with the projected PDE transport as a
pure frequency-boundary transfer.
-/

set_option autoImplicit false

noncomputable section

namespace Mettapedia
namespace FluidDynamics
namespace NavierStokes
namespace PancakeMovingBlockEvolution

open scoped BigOperators RealInnerProductSpace
open PeriodicFourierTriad
open PancakePeriodicCoherentSplit
open PancakeBilinearPeriodization
open PancakeFrameCovariance
open PancakeArbitraryDataBlocks
open PancakeTransverseEnergyFreezing
open PancakeDyadicDirectionEvolution
open PancakePeriodicVorticityEquation
open PancakeFiniteFourierLocalization
open PancakeMaterialTransportCommutator
open DirectionEvolutionTilting

local notation "R3" => EuclideanSpace ℝ (Fin 3)

/-- The exact derivative vector of a moving finite Fourier reconstruction:
character rate times coefficient plus character times coefficient rate. -/
def movingFiniteFourierDerivative
    (s : Finset Wavevector) (omega omegaDot : FourierVelocity)
  (phaseDot : Wavevector → ℂ) (x : UnitAddTorus (Fin 3)) :
    VelocityCoefficient :=
  ∑ k ∈ s,
    (phaseDot k • omega k + UnitAddTorus.mFourier k x • omegaDot k)

/-- Product rule for a finite Fourier reconstruction whose coefficients and
spatial observation point both vary in time.  The geometry of the spatial
path is represented by the exact derivative of each selected character. -/
theorem hasDerivAt_moving_finiteFourierReconstruction
    (s : Finset Wavevector)
    (omegaPath : ℝ → FourierVelocity) (omegaDot : FourierVelocity)
    (xPath : ℝ → UnitAddTorus (Fin 3))
    (phaseDot : Wavevector → ℂ) (t : ℝ)
    (hcoeff : ∀ k ∈ s, ∀ i,
      HasDerivAt (fun tau ↦ omegaPath tau k i) (omegaDot k i) t)
    (hphase : ∀ k ∈ s,
      HasDerivAt (fun tau ↦ UnitAddTorus.mFourier k (xPath tau))
        (phaseDot k) t) :
    HasDerivAt
      (fun tau ↦ finiteFourierReconstruction s (omegaPath tau) (xPath tau))
      (movingFiniteFourierDerivative
        s (omegaPath t) omegaDot phaseDot (xPath t)) t := by
  unfold finiteFourierReconstruction movingFiniteFourierDerivative
  induction s using Finset.induction_on with
  | empty =>
      simpa using (hasDerivAt_const
        (x := t) (c := (0 : VelocityCoefficient)))
  | @insert k s hk ih =>
      simp only [Finset.sum_insert hk]
      have hterm : HasDerivAt
          (fun tau ↦
            UnitAddTorus.mFourier k (xPath tau) • omegaPath tau k)
          (phaseDot k • omegaPath t k +
            UnitAddTorus.mFourier k (xPath t) • omegaDot k) t := by
        have homega : HasDerivAt (fun tau ↦ omegaPath tau k) (omegaDot k) t :=
          hasDerivAt_pi.mpr fun i ↦
            hcoeff k (Finset.mem_insert_self k s) i
        have hprod := (((hphase k
          (Finset.mem_insert_self k s)).hasFDerivAt.smul
            homega.hasFDerivAt).hasDerivAt)
        convert hprod using 1
        all_goals first | rfl | simp [add_comm]
      exact hterm.add
        (ih (fun l hl i ↦ hcoeff l (Finset.mem_insert_of_mem hl) i)
          (fun l hl ↦ hphase l (Finset.mem_insert_of_mem hl)))

/-! ## The character rate generated by the finite velocity field -/

/-- The rate of the `receiver` Fourier character along the finite velocity
field generated by `sourceModes`, written directly as a finite pair sum.
Each source contribution is
`(2 pi i) (receiver dot u_source) exp(2 pi i (source+receiver) dot x)`. -/
def finiteFluidCharacterRate
    (sourceModes : Finset Wavevector) (omega : FourierVelocity)
    (receiver : Wavevector) (x : UnitAddTorus (Fin 3)) : ℂ :=
  ∑ source ∈ sourceModes,
    unitTorusDerivativePhase *
      modeDot receiver (unitTorusBiotSavartAmp source (omega source)) *
      UnitAddTorus.mFourier (source + receiver) x

/-- Collecting the finite negative-transport coefficients by output mode and
then reconstructing gives the original source/receiver pair polynomial. -/
theorem finiteFourierReconstruction_negativeTransportCoeff
    (sourceModes receiverModes : Finset Wavevector)
    (omega eta : FourierVelocity) (x : UnitAddTorus (Fin 3)) :
    finiteFourierReconstruction
        (finiteCutoffOutputModes sourceModes receiverModes)
        (finiteUnitTorusNegativeTransportCoeff
          sourceModes receiverModes omega eta) x =
      ∑ source ∈ sourceModes, ∑ receiver ∈ receiverModes,
        UnitAddTorus.mFourier (source + receiver) x •
          unitTorusNegativeTransportAmp source receiver
            (omega source) (eta receiver) := by
  classical
  let pairs := sourceModes ×ˢ receiverModes
  let output := finiteCutoffOutputModes sourceModes receiverModes
  let addPair : Wavevector × Wavevector → Wavevector :=
    fun sr ↦ sr.1 + sr.2
  have hmaps : ∀ sr ∈ pairs, addPair sr ∈ output := by
    intro sr hsr
    rcases Finset.mem_product.mp hsr with ⟨hsource, hreceiver⟩
    exact (mem_finiteCutoffOutputModes_iff
      sourceModes receiverModes (addPair sr)).mpr
        ⟨sr.1, hsource, sr.2, hreceiver, rfl⟩
  change
    (∑ q ∈ output,
      UnitAddTorus.mFourier q x •
        ∑ sr ∈ pairs with addPair sr = q,
          unitTorusNegativeTransportAmp sr.1 sr.2
            (omega sr.1) (eta sr.2)) = _
  calc
    _ = ∑ q ∈ output, ∑ sr ∈ pairs with addPair sr = q,
        UnitAddTorus.mFourier (addPair sr) x •
          unitTorusNegativeTransportAmp sr.1 sr.2
            (omega sr.1) (eta sr.2) := by
      apply Finset.sum_congr rfl
      intro q hq
      rw [Finset.smul_sum]
      apply Finset.sum_congr rfl
      intro sr hsr
      have hadd : addPair sr = q := (Finset.mem_filter.mp hsr).2
      rw [hadd]
    _ = ∑ sr ∈ pairs,
        UnitAddTorus.mFourier (addPair sr) x •
          unitTorusNegativeTransportAmp sr.1 sr.2
            (omega sr.1) (eta sr.2) := by
      exact Finset.sum_fiberwise_of_maps_to hmaps
        (fun sr : Wavevector × Wavevector ↦
          (UnitAddTorus.mFourier (addPair sr) x •
            unitTorusNegativeTransportAmp sr.1 sr.2
              (omega sr.1) (eta sr.2) : VelocityCoefficient))
    _ = _ := by
      rw [Finset.sum_product]

/-- The moving-character contribution is exactly positive advection of the
hard-projected receiver field, hence the negative of the PDE's
negative-transport polynomial. -/
theorem sum_finiteFluidCharacterRate_smul_eq_neg_transport
    (sourceModes receiverModes : Finset Wavevector)
    (omega eta : FourierVelocity) (x : UnitAddTorus (Fin 3)) :
    ∑ receiver ∈ receiverModes,
        finiteFluidCharacterRate sourceModes omega receiver x • eta receiver =
      -finiteFourierReconstruction
        (finiteCutoffOutputModes sourceModes receiverModes)
        (finiteUnitTorusNegativeTransportCoeff
          sourceModes receiverModes omega eta) x := by
  rw [finiteFourierReconstruction_negativeTransportCoeff]
  classical
  ext i
  simp only [finiteFluidCharacterRate, unitTorusNegativeTransportAmp,
    Finset.sum_apply, Pi.smul_apply, Pi.neg_apply, Finset.sum_smul]
  rw [Finset.sum_comm]
  rw [← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro source hsource
  rw [← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro receiver hreceiver
  ring

/-- With the fluid-generated character rate, the moving reconstruction
derivative is the fixed-point coefficient derivative plus positive advection
of the projected receiver field. -/
theorem movingFiniteFourierDerivative_fluidRate_eq
    (sourceModes receiverModes : Finset Wavevector)
    (omega eta omegaDot : FourierVelocity)
    (x : UnitAddTorus (Fin 3)) :
    movingFiniteFourierDerivative receiverModes eta omegaDot
        (fun receiver ↦
          finiteFluidCharacterRate sourceModes omega receiver x) x =
      finiteFourierReconstruction receiverModes omegaDot x -
        finiteFourierReconstruction
          (finiteCutoffOutputModes sourceModes receiverModes)
          (finiteUnitTorusNegativeTransportCoeff
            sourceModes receiverModes omega eta) x := by
  unfold movingFiniteFourierDerivative finiteFourierReconstruction
  rw [Finset.sum_add_distrib,
    sum_finiteFluidCharacterRate_smul_eq_neg_transport]
  simp only [finiteFourierReconstruction]
  abel

/-! ## The complete material block residual -/

/-- If the ambient receiver support contains the hard block, filtering it by
membership in that block returns the block itself. -/
theorem receiverModesInside_eq_block
    (receiverModes blockModes : Finset Wavevector)
    (hsub : blockModes ⊆ receiverModes) :
    receiverModesInside receiverModes blockModes = blockModes := by
  ext q
  simp only [receiverModesInside, Finset.mem_filter]
  constructor
  · exact fun h ↦ h.2
  · exact fun h ↦ ⟨hsub h, h⟩

/-- Coefficient of the material derivative of the hard block after
subtracting the stretching of the hard block itself.  The first term is the
projected vorticity PDE, while the other two terms are positive advection and
the comparison stretching field. -/
def finiteMovingBlockMaterialResidualCoeff
    (sourceModes receiverModes blockModes : Finset Wavevector)
    (omega eta : FourierVelocity) (nu : ℝ) (q : Wavevector) :
    VelocityCoefficient :=
  (if q ∈ blockModes then
      finiteUnitTorusVorticityRHS
        sourceModes receiverModes omega eta nu q
    else 0) -
  finiteUnitTorusNegativeTransportCoeff
    sourceModes blockModes omega eta q -
  finiteUnitTorusStretchingCoeff
    sourceModes blockModes omega eta q

/-- Exact coefficient-level material cancellation.  Once the receiver
support contains the hard block, the residual is precisely the nonlinear
frequency-boundary transfer plus viscosity projected to the block. -/
theorem finiteMovingBlockMaterialResidualCoeff_eq_boundary_add_viscosity
    (sourceModes receiverModes blockModes : Finset Wavevector)
    (omega eta : FourierVelocity) (nu : ℝ) (q : Wavevector)
    (hsub : blockModes ⊆ receiverModes) :
    finiteMovingBlockMaterialResidualCoeff
        sourceModes receiverModes blockModes omega eta nu q =
      finiteMaterialNonlinearBoundaryCoeff
          sourceModes receiverModes blockModes omega eta q +
        if q ∈ blockModes then
          unitTorusViscousVorticityCoeff nu eta q
        else 0 := by
  have hinside : receiverModesInside receiverModes blockModes = blockModes :=
    receiverModesInside_eq_block receiverModes blockModes hsub
  unfold finiteMovingBlockMaterialResidualCoeff
    finiteUnitTorusVorticityRHS finiteUnitTorusNonstretchingCoeff
    finiteMaterialNonlinearBoundaryCoeff
    finiteMaterialTransportCommutatorCoeff
    finiteStretchingProjectionCommutatorCoeff
  rw [hinside]
  by_cases hq : q ∈ blockModes
  · simp only [if_pos hq]
    abel
  · simp only [if_neg hq]
    abel

/-- Physical stretching of the receiver field after its Fourier support is
restricted to `blockModes`. -/
def finiteProjectedBlockStretchingField
    (sourceModes blockModes : Finset Wavevector)
    (omega eta : FourierVelocity) (x : UnitAddTorus (Fin 3)) :
    VelocityCoefficient :=
  finiteFourierReconstruction
    (finiteCutoffOutputModes sourceModes blockModes)
    (finiteUnitTorusStretchingCoeff sourceModes blockModes omega eta) x

/-- The complete finite material residual field before taking real parts:
project the vorticity PDE to the hard block, add positive advection of that
block, and subtract the stretching of the projected block. -/
def finiteMovingBlockMaterialResidualField
    (sourceModes receiverModes blockModes : Finset Wavevector)
    (omega eta : FourierVelocity) (nu : ℝ)
    (x : UnitAddTorus (Fin 3)) : VelocityCoefficient :=
  finiteFourierReconstruction blockModes
      (finiteUnitTorusVorticityRHS
        sourceModes receiverModes omega eta nu) x -
    finiteFourierReconstruction
      (finiteCutoffOutputModes sourceModes blockModes)
      (finiteUnitTorusNegativeTransportCoeff
        sourceModes blockModes omega eta) x -
    finiteProjectedBlockStretchingField
      sourceModes blockModes omega eta x

/-- The exact moving derivative under the finite vorticity equation splits
into material boundary/viscous forcing and stretching of the projected
block. -/
theorem movingFiniteFourierDerivative_vorticityRHS_eq_material_add_stretching
    (sourceModes receiverModes blockModes : Finset Wavevector)
    (omega eta : FourierVelocity) (nu : ℝ)
    (x : UnitAddTorus (Fin 3)) :
    movingFiniteFourierDerivative blockModes eta
        (finiteUnitTorusVorticityRHS
          sourceModes receiverModes omega eta nu)
        (fun receiver ↦
          finiteFluidCharacterRate sourceModes omega receiver x) x =
      finiteMovingBlockMaterialResidualField
          sourceModes receiverModes blockModes omega eta nu x +
        finiteProjectedBlockStretchingField
          sourceModes blockModes omega eta x := by
  rw [movingFiniteFourierDerivative_fluidRate_eq]
  unfold finiteMovingBlockMaterialResidualField
  abel

/-- The discrepancy between physical stretching of the projected block and
the selected pointwise real strain action. -/
def finiteMovingBlockStretchingProjectionDefect
    (S : R3 →L[ℝ] R3) (sourceModes blockModes : Finset Wavevector)
    (omega eta : FourierVelocity) (r : ℝ) (xi : R3)
    (x : UnitAddTorus (Fin 3)) : R3 :=
  complexRealPartEuclidean
      (finiteProjectedBlockStretchingField
        sourceModes blockModes omega eta x) -
    r • S xi

/-- Taking coordinatewise real part commutes with the moving-block
derivative. -/
theorem hasDerivAt_real_moving_finiteFourierReconstruction
    (s : Finset Wavevector)
    (omegaPath : ℝ → FourierVelocity) (omegaDot : FourierVelocity)
    (xPath : ℝ → UnitAddTorus (Fin 3))
    (phaseDot : Wavevector → ℂ) (t : ℝ)
    (hcoeff : ∀ k ∈ s, ∀ i,
      HasDerivAt (fun tau ↦ omegaPath tau k i) (omegaDot k i) t)
    (hphase : ∀ k ∈ s,
      HasDerivAt (fun tau ↦ UnitAddTorus.mFourier k (xPath tau))
        (phaseDot k) t) :
    HasDerivAt
      (fun tau ↦ complexRealPartEuclidean
        (finiteFourierReconstruction s (omegaPath tau) (xPath tau)))
      (complexRealPartEuclidean
        (movingFiniteFourierDerivative
          s (omegaPath t) omegaDot phaseDot (xPath t))) t := by
  exact hasDerivAt_complexRealPartEuclidean
    (hasDerivAt_moving_finiteFourierReconstruction
      s omegaPath omegaDot xPath phaseDot t hcoeff hphase)

/-- Residual of the moving hard pancake block relative to pure stretching by
the selected real strain operator. -/
def movingDyadicPancakeDirectionResidual
    (S : R3 →L[ℝ] R3) (F : OrientedFrameEquiv) (N : ℕ)
    (omega omegaDot : FourierVelocity) (phaseDot : Wavevector → ℂ)
    (r : ℝ) (xi : R3) (x : BilinearSpatialTorus) : R3 :=
  complexRealPartEuclidean
      (movingFiniteFourierDerivative
        (squareDyadicPancakeModes F N) omega omegaDot phaseDot x) -
    r • S xi

/-- Exact direction equation for the same hard pancake block observed along
a moving spatial path. -/
theorem movingDyadicPancakeDirectionDerivative_eq_strain_add_residual
    (S : R3 →L[ℝ] R3) (F : OrientedFrameEquiv) (N : ℕ)
    {omegaPath : ℝ → FourierVelocity} (omegaDot : FourierVelocity)
    {xPath : ℝ → BilinearSpatialTorus}
    (phaseDot : Wavevector → ℂ)
    {r : ℝ → ℝ} {xi : ℝ → R3}
    {xiDot : R3} {radialRate t : ℝ}
    (hcoeff : ∀ k ∈ squareDyadicPancakeModes F N, ∀ i,
      HasDerivAt (fun tau ↦ omegaPath tau k i) (omegaDot k i) t)
    (hphase : ∀ k ∈ squareDyadicPancakeModes F N,
      HasDerivAt (fun tau ↦ UnitAddTorus.mFourier k (xPath tau))
        (phaseDot k) t)
    (hr : HasDerivAt r radialRate t)
    (hxi : HasDerivAt xi xiDot t)
    (hfactor :
      (fun tau ↦ squareDyadicPancakeRealBlock
        F N (omegaPath tau) (xPath tau)) =
        fun tau ↦ r tau • xi tau)
    (hunit : ∀ tau, ⟪xi tau, xi tau⟫ = 1)
    (hrne : r t ≠ 0) :
    xiDot = transverseComponent (xi t) (S (xi t)) +
      (r t)⁻¹ • transverseComponent (xi t)
        (movingDyadicPancakeDirectionResidual S F N
          (omegaPath t) omegaDot phaseDot (r t) (xi t) (xPath t)) := by
  have hblock := hasDerivAt_real_moving_finiteFourierReconstruction
    (squareDyadicPancakeModes F N) omegaPath omegaDot xPath phaseDot t
    hcoeff hphase
  have hevolution : HasDerivAt
      (fun tau ↦ squareDyadicPancakeRealBlock
        F N (omegaPath tau) (xPath tau))
      (r t • S (xi t) +
        movingDyadicPancakeDirectionResidual S F N
          (omegaPath t) omegaDot phaseDot (r t) (xi t) (xPath t)) t := by
    convert hblock using 1
    · rfl
    · simp [movingDyadicPancakeDirectionResidual]
  exact directionDerivative_eq_stretching_diffusion_of_factorization
    S hevolution hr hxi hfactor hunit hrne

/-- The moving hard-block direction residual has exactly two pieces:
material boundary/viscous forcing and the physical stretching projection
defect. -/
theorem movingDyadicPancakeDirectionResidual_vorticityRHS_eq
    (S : R3 →L[ℝ] R3) (F : OrientedFrameEquiv) (N : ℕ)
    (sourceModes receiverModes : Finset Wavevector)
    (omega eta : FourierVelocity) (nu r : ℝ) (xi : R3)
    (x : BilinearSpatialTorus) :
    movingDyadicPancakeDirectionResidual S F N eta
        (finiteUnitTorusVorticityRHS
          sourceModes receiverModes omega eta nu)
        (fun receiver ↦
          finiteFluidCharacterRate sourceModes omega receiver x)
        r xi x =
      complexRealPartEuclidean
          (finiteMovingBlockMaterialResidualField sourceModes receiverModes
            (squareDyadicPancakeModes F N) omega eta nu x) +
        finiteMovingBlockStretchingProjectionDefect S sourceModes
          (squareDyadicPancakeModes F N) omega eta r xi x := by
  unfold movingDyadicPancakeDirectionResidual
    finiteMovingBlockStretchingProjectionDefect
  rw [movingFiniteFourierDerivative_vorticityRHS_eq_material_add_stretching]
  rw [← complexRealPartEuclideanCLM_apply, map_add,
    complexRealPartEuclideanCLM_apply, complexRealPartEuclideanCLM_apply]
  abel

/-- Route-facing finite material direction equation.  Along the fluid-rate
character path, the hard pancake direction turns by pointwise strain plus
only two explicit errors: nonlinear frequency-boundary/viscous forcing and
the stretching projection defect. -/
theorem movingDyadicPancakeDirectionDerivative_eq_material_channels
    (S : R3 →L[ℝ] R3) (F : OrientedFrameEquiv) (N : ℕ)
    (sourceModes receiverModes : Finset Wavevector)
    (omega eta : FourierVelocity) (nu : ℝ)
    {omegaPath : ℝ → FourierVelocity}
    {xPath : ℝ → BilinearSpatialTorus}
    {r : ℝ → ℝ} {xi : ℝ → R3}
    {xiDot : R3} {radialRate t : ℝ}
    (hstate : omegaPath t = eta)
    (hcoeff : ∀ k ∈ squareDyadicPancakeModes F N, ∀ i,
      HasDerivAt (fun tau ↦ omegaPath tau k i)
        (finiteUnitTorusVorticityRHS
          sourceModes receiverModes omega eta nu k i) t)
    (hphase : ∀ k ∈ squareDyadicPancakeModes F N,
      HasDerivAt (fun tau ↦ UnitAddTorus.mFourier k (xPath tau))
        (finiteFluidCharacterRate sourceModes omega k (xPath t)) t)
    (hr : HasDerivAt r radialRate t)
    (hxi : HasDerivAt xi xiDot t)
    (hfactor :
      (fun tau ↦ squareDyadicPancakeRealBlock
        F N (omegaPath tau) (xPath tau)) =
        fun tau ↦ r tau • xi tau)
    (hunit : ∀ tau, ⟪xi tau, xi tau⟫ = 1)
    (hrne : r t ≠ 0) :
    xiDot = transverseComponent (xi t) (S (xi t)) +
      (r t)⁻¹ • transverseComponent (xi t)
        (complexRealPartEuclidean
          (finiteMovingBlockMaterialResidualField sourceModes receiverModes
            (squareDyadicPancakeModes F N) omega eta nu (xPath t))) +
      (r t)⁻¹ • transverseComponent (xi t)
        (finiteMovingBlockStretchingProjectionDefect S sourceModes
          (squareDyadicPancakeModes F N) omega eta
          (r t) (xi t) (xPath t)) := by
  have hdirection :=
    movingDyadicPancakeDirectionDerivative_eq_strain_add_residual
      S F N
      (finiteUnitTorusVorticityRHS
        sourceModes receiverModes omega eta nu)
      (fun receiver ↦
        finiteFluidCharacterRate sourceModes omega receiver (xPath t))
      hcoeff hphase hr hxi hfactor hunit hrne
  rw [hstate,
    movingDyadicPancakeDirectionResidual_vorticityRHS_eq] at hdirection
  rw [transverseComponent_add, smul_add] at hdirection
  simpa only [add_assoc] using hdirection

end PancakeMovingBlockEvolution
