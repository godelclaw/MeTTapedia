import Mettapedia.FluidDynamics.NavierStokes.StochasticLagrangian.PancakeSpatialStrainEvolution

/-!
# Spectral-defect dynamics from the actual finite velocity equation

Strain, vorticity, material motion and both forcing terms are constructed
from finite Fourier velocity data. The abstract strain and vector ODE
hypotheses of the spectral-defect theorem are discharged from the physical
velocity equation and the real trajectory ODE.

The forcing is not assumed small. In particular, subtracting coherent
strain action identifies its exact mismatch; it is not an estimate of it.
-/

set_option autoImplicit false
noncomputable section

namespace Mettapedia.FluidDynamics.NavierStokes.PancakePhysicalSpectralDefect

open scoped BigOperators ComplexConjugate RealInnerProductSpace Matrix.Norms.Elementwise
open PeriodicFourierTriad PancakePeriodicCoherentSplit PancakePeriodicVorticityEquation
open PancakePeriodicComplexStretch
open PancakeFourierPressureStrain PancakeFilteredStrainDynamics PancakeBlockReality
open PancakeFrequencyProjectorCommutator PancakeFourierMaterialPaths PancakeSpatialStrainEvolution
open PancakeGalerkinKineticEnergy PancakeGalerkinVorticityBridge PancakeMovingBlockEvolution
open PancakeTransverseEnergyFreezing PancakeDyadicDirectionEvolution
open PancakeSpectralDefectEvolution PancakeSpectralProjectorRegularity
open PancakeSpectralProjectorRegularity.SymmetricStrain PancakeStrainSpectralFrame

local notation "R3" => EuclideanSpace ℝ (Fin 3)
local notation "T3" => UnitAddTorus (Fin 3)

def spatialVorticity (modes : Finset Wavevector) (u : FourierVelocity) (x : T3) : R3 :=
  complexRealPartEuclidean (finiteFourierReconstruction modes (fourierCurl u) x)

/-- Explicit vorticity rate: retained physical curl RHS plus transport
generated by the filtered velocity. No time derivative occurs in this definition. -/
def spatialVorticityMaterialRate (chi : Wavevector → ℂ) (modes : Finset Wavevector)
    (u : FourierVelocity) (nu : ℝ) (x : T3) : R3 :=
  complexRealPartEuclidean (movingFiniteFourierDerivative modes (fourierCurl u)
    (finiteUnitTorusVorticityRHS modes modes (fourierCurl u) (fourierCurl u) nu)
    (fun q ↦ finiteVelocityCharacterRate modes (filteredVelocity chi u) q x) x)

def spatialVorticityForcing (chi : Wavevector → ℂ) (modes : Finset Wavevector)
    (u : FourierVelocity) (nu : ℝ) (x : T3) : R3 :=
  spatialVorticityMaterialRate chi modes u nu x -
    (spatialStrain modes (filteredVelocity chi u) x).1 (spatialVorticity modes u x)

theorem hasDerivAt_spatialVorticity_material
    (chi : Wavevector → ℂ) (modes : Finset Wavevector)
    (u : ℝ → FourierVelocity) (X : ℝ → Fin 3 → ℝ) (nu t : ℝ)
    (hchir : ∀ q, chi (-q) = conj (chi q))
    (hs : ∀ k, -k ∈ modes ↔ k ∈ modes)
    (hr : ∀ q, u t (-q) = coefficientConjugate (u t q))
    (hk : ∀ k ∈ modes, frequencyVec k ≠ 0)
    (hu : ∀ k ∈ modes, modeDot k (u t k) = 0)
    (hd : ∀ p ∈ modes, ∀ k : Fin 3,
      HasDerivAt (fun tau ↦ u tau p k) (velocityRHS modes (u t) nu p k) t)
    (hX : ∀ i, HasDerivAt (fun tau ↦ X tau i)
      (finiteFourierReconstruction modes (filteredVelocity chi (u t)) (torusPoint (X t)) i).re t) :
    HasDerivAt (fun tau ↦ spatialVorticity modes (u tau) (torusPoint (X tau)))
      ((spatialStrain modes (filteredVelocity chi (u t)) (torusPoint (X t))).1
          (spatialVorticity modes (u t) (torusPoint (X t))) +
        spatialVorticityForcing chi modes (u t) nu (torusPoint (X t))) t := by
  have h := hasDerivAt_real_moving_finiteFourierReconstruction modes
    (fun tau ↦ fourierCurl (u tau))
    (finiteUnitTorusVorticityRHS modes modes (fourierCurl (u t)) (fourierCurl (u t)) nu)
    (fun tau ↦ torusPoint (X tau))
    (fun q ↦ finiteVelocityCharacterRate modes (filteredVelocity chi (u t)) q (torusPoint (X t))) t
    (fun q hq i ↦ hasDerivAt_vorticity_of_velocityRHS modes u nu t q hk hu (hd q hq) i)
    (fun q _ ↦ hasDerivAt_mFourier_of_materialPath modes (filteredVelocity chi (u t)) X q t hs
      (filteredVelocity_conjugate chi (u t) hchir hr) hX)
  apply h.congr_deriv
  change spatialVorticityMaterialRate chi modes (u t) nu (torusPoint (X t)) = _
  unfold spatialVorticityForcing
  abel

def physicalStrainPath (chi : Wavevector → ℂ) (modes : Finset Wavevector)
    (u : ℝ → FourierVelocity) (X : ℝ → Fin 3 → ℝ) : ℝ → SymmetricStrain :=
  fun t ↦ spatialStrain modes (filteredVelocity chi (u t)) (torusPoint (X t))

def physicalVorticityPath (modes : Finset Wavevector)
    (u : ℝ → FourierVelocity) (X : ℝ → Fin 3 → ℝ) : ℝ → R3 :=
  fun t ↦ spatialVorticity modes (u t) (torusPoint (X t))

def physicalSpectralDefect (chi : Wavevector → ℂ) (modes : Finset Wavevector)
    (u : FourierVelocity) (x : T3) : ℝ :=
  topSpectralDefect (spatialStrain modes (filteredVelocity chi u) x) (spatialVorticity modes u x)

theorem physicalSpectralDefect_nonneg (chi : Wavevector → ℂ) (modes : Finset Wavevector)
    (u : FourierVelocity) (x : T3) : 0 ≤ physicalSpectralDefect chi modes u x :=
  topSpectralDefect_nonneg _ _

/-- The cancellation is now a theorem about reconstructed physical fields
along a real material path. Only the original velocity/path ODEs occur
as evolution hypotheses. The forcing costs remain explicit and unbounded. -/
theorem hasDerivAt_physicalSpectralDefect
    (chi : Wavevector → ℂ) (modes outputs : Finset Wavevector)
    (u : ℝ → FourierVelocity) (X : ℝ → Fin 3 → ℝ) (nu t : ℝ)
    (hsub : modes ⊆ outputs)
    (hout : ∀ k ∈ modes, ∀ l ∈ modes, k + l ∈ outputs)
    (hchi : ∀ q, q ∉ modes → chi q = 0)
    (hchir : ∀ q, chi (-q) = conj (chi q))
    (hs : ∀ k, -k ∈ modes ↔ k ∈ modes)
    (hr : ∀ q, u t (-q) = coefficientConjugate (u t q))
    (hk : ∀ k ∈ modes, frequencyVec k ≠ 0)
    (hu : ∀ k ∈ modes, modeDot k (u t k) = 0)
    (hd : ∀ p ∈ modes, ∀ k : Fin 3,
      HasDerivAt (fun tau ↦ u tau p k) (velocityRHS modes (u t) nu p k) t)
    (hX : ∀ i, HasDerivAt (fun tau ↦ X tau i)
      (finiteFourierReconstruction modes (filteredVelocity chi (u t)) (torusPoint (X t)) i).re t)
    (hlambda : DifferentiableAt ℝ (fun tau ↦ topEigenvalue (physicalStrainPath chi modes u X tau)) t) :
    let S := physicalStrainPath chi modes u X t
    let w := physicalVorticityPath modes u X t
    let e := (orderedEigenframe S.1 S.2).eigenbasis 0
    let z := spectralResidual S.1 (topEigenvalue S) w
    let R := spatialStrainRemainder chi modes outputs (u t) nu (torusPoint (X t))
    let f := spatialVorticityForcing chi modes (u t) nu (torusPoint (X t))
    HasDerivAt (fun tau ↦ physicalSpectralDefect chi modes (u tau) (torusPoint (X tau)))
      (-‖z‖ ^ 2 + remainderAnisotropy R e w + 2 * ⟪z, f⟫) t := by
  exact hasDerivAt_topSpectralDefect_of_differentiableAt
    (physicalStrainPath chi modes u X) (physicalVorticityPath modes u X) _ _ t
    (hasDerivAt_spatialStrain_material chi modes outputs u X nu t hsub hout hchi hchir hs hr hk hu hd hX)
    (hasDerivAt_spatialVorticity_material chi modes u X nu t hchir hs hr hk hu hd hX) hlambda

theorem contDiffOn_characterPath (q : Wavevector) (X : ℝ → Fin 3 → ℝ)
    (domain : Set ℝ) (hX : ∀ i, ContDiffOn ℝ 1 (fun t ↦ X t i) domain) :
    ContDiffOn ℝ 1 (fun t ↦ UnitAddTorus.mFourier q (torusPoint (X t))) domain := by
  simp_rw [mFourier_torusPoint]
  have hr : ContDiffOn ℝ 1 (fun t ↦ realModeDot q (X t)) domain := by
    unfold realModeDot
    fun_prop
  exact (contDiffOn_const.mul (Complex.ofRealCLM.contDiff.comp_contDiffOn hr)).cexp

theorem contDiffOn_fourierCurl_coefficient (u : ℝ → FourierVelocity)
    (q : Wavevector) (domain : Set ℝ)
    (hu : ∀ i, ContDiffOn ℝ 1 (fun t ↦ u t q i) domain) (i : Fin 3) :
    ContDiffOn ℝ 1 (fun t ↦ fourierCurl (u t) q i) domain := by
  fin_cases i <;> simp [fourierCurl, coefficientCross] <;> fun_prop

theorem contDiffOn_realFourierPath (modes : Finset Wavevector)
    (w : ℝ → FourierVelocity) (X : ℝ → Fin 3 → ℝ) (domain : Set ℝ)
    (hw : ∀ q ∈ modes, ∀ i, ContDiffOn ℝ 1 (fun t ↦ w t q i) domain)
    (hX : ∀ i, ContDiffOn ℝ 1 (fun t ↦ X t i) domain) :
    ContDiffOn ℝ 1 (fun t ↦ complexRealPartEuclidean
      (finiteFourierReconstruction modes (w t) (torusPoint (X t)))) domain := by
  change ContDiffOn ℝ 1 (fun t ↦ complexRealPartEuclideanCLM
    (finiteFourierReconstruction modes (w t) (torusPoint (X t)))) domain
  apply complexRealPartEuclideanCLM.contDiff.comp_contDiffOn
  change ContDiffOn ℝ 1 (fun t i ↦ finiteFourierReconstruction modes (w t) (torusPoint (X t)) i) domain
  refine contDiffOn_pi.mpr (fun i ↦ ?_)
  simp only [finiteFourierReconstruction, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  apply ContDiffOn.sum
  intro q hq
  exact (contDiffOn_characterPath q X domain hX).mul (hw q hq i)

theorem contDiffOn_physicalVorticityPath (modes : Finset Wavevector)
    (u : ℝ → FourierVelocity) (X : ℝ → Fin 3 → ℝ) (domain : Set ℝ)
    (hu : ∀ q ∈ modes, ∀ i, ContDiffOn ℝ 1 (fun t ↦ u t q i) domain)
    (hX : ∀ i, ContDiffOn ℝ 1 (fun t ↦ X t i) domain) :
    ContDiffOn ℝ 1 (physicalVorticityPath modes u X) domain :=
  contDiffOn_realFourierPath modes (fun t ↦ fourierCurl (u t)) X domain
    (fun q hq ↦ contDiffOn_fourierCurl_coefficient u q domain (hu q hq)) hX

theorem contDiffOn_physicalStrainPath (chi : Wavevector → ℂ) (modes : Finset Wavevector)
    (u : ℝ → FourierVelocity) (X : ℝ → Fin 3 → ℝ) (domain : Set ℝ)
    (hu : ∀ q ∈ modes, ∀ i, ContDiffOn ℝ 1 (fun t ↦ u t q i) domain)
    (hX : ∀ i, ContDiffOn ℝ 1 (fun t ↦ X t i) domain) :
    ContDiffOn ℝ 1 (fun t ↦ (physicalStrainPath chi modes u X t).1) domain := by
  apply realMatrixOperatorCLM.contDiff.comp_contDiffOn
  change ContDiffOn ℝ 1 (fun t i j ↦
    matrixReconstruction modes (strainCoeff (filteredVelocity chi (u t))) (torusPoint (X t)) i j) domain
  refine contDiffOn_pi.mpr (fun i ↦ contDiffOn_pi.mpr (fun j ↦ ?_))
  simp only [matrixReconstruction_apply]
  apply ContDiffOn.sum
  intro q hq
  apply (contDiffOn_characterPath q X domain hX).mul
  simp only [strainCoeff, gradientCoeff, filteredVelocity, Matrix.smul_apply,
    Matrix.add_apply, Matrix.transpose_apply, Pi.smul_apply, smul_eq_mul]
  exact contDiffOn_const.mul
    ((contDiffOn_const.mul (contDiffOn_const.mul (hu q hq i))).add
      (contDiffOn_const.mul (contDiffOn_const.mul (hu q hq j))))

/-- Differentiability of the constructed largest eigenvalue is derived
almost everywhere from physical coefficient/path regularity; no gap or
eigenvector regularity is assumed. -/
theorem ae_differentiableAt_physical_topEigenvalue
    (chi : Wavevector → ℂ) (modes : Finset Wavevector)
    (u : ℝ → FourierVelocity) (X : ℝ → Fin 3 → ℝ) (a b : ℝ)
    (hu : ∀ q ∈ modes, ∀ i, ContDiffOn ℝ 1 (fun t ↦ u t q i) (Set.uIcc a b))
    (hX : ∀ i, ContDiffOn ℝ 1 (fun t ↦ X t i) (Set.uIcc a b)) :
    ∀ᵐ t ∂MeasureTheory.volume.restrict (Set.uIcc a b),
      DifferentiableAt ℝ (fun tau ↦ topEigenvalue (physicalStrainPath chi modes u X tau)) t := by
  have hAC := PancakeSpectralDefectBudget.absolutelyContinuousOnInterval_topEigenvalue
    (physicalStrainPath chi modes u X) a b
    (contDiffOn_physicalStrainPath chi modes u X (Set.uIcc a b) hu hX)
  rw [MeasureTheory.ae_restrict_iff' measurableSet_uIcc]
  exact hAC.ae_differentiableAt

/-- On a compact interval the explicitly identified vector forcing is
continuous once the vector path is C1 and the strain path is continuous.
Continuity is derived, including interval endpoints. -/
theorem continuousOn_forcing_of_evolution
    (S : ℝ → R3 →L[ℝ] R3) (w f : ℝ → R3) (a b : ℝ)
    (hS : ContinuousOn S (Set.uIcc a b))
    (hw : ContDiffOn ℝ 1 w (Set.uIcc a b))
    (hd : ∀ t ∈ Set.uIcc a b, HasDerivAt w (S t (w t) + f t) t) :
    ContinuousOn f (Set.uIcc a b) := by
  by_cases hab : a = b
  · subst b
    simp only [Set.uIcc_self]
    exact continuousOn_singleton f a
  · have huniq : UniqueDiffOn ℝ (Set.uIcc a b) := uniqueDiffOn_Icc (min_lt_max.mpr hab)
    apply ((hw.continuousOn_derivWithin huniq (by decide)).sub
      (hS.clm_apply hw.continuousOn)).congr
    intro t ht
    have h := (hd t ht).hasDerivWithinAt.derivWithin (huniq t ht)
    change f t = derivWithin w (Set.uIcc a b) t - S t (w t)
    rw [h, add_sub_cancel_left]

/-- The collision-safe signed budget for the constructed physical strain
and vorticity. Initial-data bounds for the displayed forcing integrals
remain separate estimates; no eigenvalue-gap hypothesis occurs. -/
theorem integrated_physicalSpectralDefect_budget
    (chi : Wavevector → ℂ) (modes outputs : Finset Wavevector)
    (u : ℝ → FourierVelocity) (X : ℝ → Fin 3 → ℝ) (nu a b theta : ℝ)
    (hab : a ≤ b) (htheta : 0 < theta)
    (hsub : modes ⊆ outputs)
    (hout : ∀ k ∈ modes, ∀ l ∈ modes, k + l ∈ outputs)
    (hchi : ∀ q, q ∉ modes → chi q = 0)
    (hchir : ∀ q, chi (-q) = conj (chi q))
    (hs : ∀ k, -k ∈ modes ↔ k ∈ modes)
    (hk : ∀ k ∈ modes, frequencyVec k ≠ 0)
    (huc : ∀ q ∈ modes, ∀ i, ContDiffOn ℝ 1 (fun t ↦ u t q i) (Set.uIcc a b))
    (hXc : ∀ i, ContDiffOn ℝ 1 (fun t ↦ X t i) (Set.uIcc a b))
    (hr : ∀ t ∈ Set.uIcc a b, ∀ q, u t (-q) = coefficientConjugate (u t q))
    (hu : ∀ t ∈ Set.uIcc a b, ∀ k ∈ modes, modeDot k (u t k) = 0)
    (hd : ∀ t ∈ Set.uIcc a b, ∀ p ∈ modes, ∀ k : Fin 3,
      HasDerivAt (fun tau ↦ u tau p k) (velocityRHS modes (u t) nu p k) t)
    (hX : ∀ t ∈ Set.uIcc a b, ∀ i, HasDerivAt (fun tau ↦ X tau i)
      (finiteFourierReconstruction modes (filteredVelocity chi (u t)) (torusPoint (X t)) i).re t) :
    let S := physicalStrainPath chi modes u X
    let w := physicalVorticityPath modes u X
    let R := fun t ↦ spatialStrainRemainder chi modes outputs (u t) nu (torusPoint (X t))
    let f := fun t ↦ spatialVorticityForcing chi modes (u t) nu (torusPoint (X t))
    let z := fun t ↦ spectralResidual (S t).1 (topEigenvalue (S t)) (w t)
    physicalSpectralDefect chi modes (u b) (torusPoint (X b)) +
      (1 - theta) * (∫ t in a..b, ‖z t‖ ^ 2) ≤
        physicalSpectralDefect chi modes (u a) (torusPoint (X a)) +
          (∫ t in a..b, PancakeSpectralDefectBudget.topRemainderAnisotropy (S t) (R t) (w t)) +
          (∫ t in a..b, ‖f t‖ ^ 2) / theta := by
  dsimp only
  let S := physicalStrainPath chi modes u X
  let w := physicalVorticityPath modes u X
  let R := fun t ↦ spatialStrainRemainder chi modes outputs (u t) nu (torusPoint (X t))
  let f := fun t ↦ spatialVorticityForcing chi modes (u t) nu (torusPoint (X t))
  have hSc : ContDiffOn ℝ 1 (fun t ↦ (S t).1) (Set.uIcc a b) :=
    contDiffOn_physicalStrainPath chi modes u X _ huc hXc
  have hwc : ContDiffOn ℝ 1 w (Set.uIcc a b) :=
    contDiffOn_physicalVorticityPath modes u X _ huc hXc
  have hdS : ∀ t ∈ Set.uIcc a b,
      HasDerivAt (fun tau ↦ (S tau).1) (-(S t).1 * (S t).1 + R t) t := fun t ht ↦
    hasDerivAt_spatialStrain_material chi modes outputs u X nu t hsub hout hchi hchir hs
      (hr t ht) hk (hu t ht) (hd t ht) (hX t ht)
  have hdw : ∀ t ∈ Set.uIcc a b, HasDerivAt w ((S t).1 (w t) + f t) t := fun t ht ↦
    hasDerivAt_spatialVorticity_material chi modes u X nu t hchir hs
      (hr t ht) hk (hu t ht) (hd t ht) (hX t ht)
  have hf := continuousOn_forcing_of_evolution (fun t ↦ (S t).1) w f a b hSc.continuousOn hwc hdw
  exact PancakeSpectralDefectBudget.integrated_topSpectralDefect_budget S w R f a b theta
    hab htheta hSc hwc hf hdS hdw

end Mettapedia.FluidDynamics.NavierStokes.PancakePhysicalSpectralDefect
