import Mettapedia.FluidDynamics.NavierStokes.StochasticLagrangian.PancakeCellAggregation

/-!
# Exact finite Fourier localization

Multiplication by a spatial cutoff is convolution in frequency.  This module
proves that statement exactly for the finite unit-torus reconstructions used
by the pancake sector development.  It records the output support as the
Minkowski sum of cutoff and field supports, making the frequency leakage in a
cell localization explicit rather than hiding it in a support premise.
-/

set_option autoImplicit false

noncomputable section

namespace Mettapedia
namespace FluidDynamics
namespace NavierStokes
namespace PancakeFiniteFourierLocalization

open scoped BigOperators
open PeriodicFourierTriad
open PancakeMisalignmentEnergyBridge
open PancakePeriodicCoherentSplit
open PancakeTransverseEnergyFreezing
open PancakeAnnularChartCutoff
open PancakeAnnularSectorProjector
open PancakeFrameCovariance
open PancakePhysicalFrameKernelTransfer
open PancakeRealCoherentPairEstimate
open MeasureTheory

local instance : MeasureSpace UnitAddCircle := ⟨AddCircle.haarAddCircle⟩
local instance : Measure.IsAddHaarMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (Measure.IsAddHaarMeasure AddCircle.haarAddCircle)
local instance : IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (IsProbabilityMeasure AddCircle.haarAddCircle)

/-- Frequencies that can occur when a finite cutoff support multiplies a
finite vector-field support. -/
def finiteCutoffOutputModes (cutoffModes fieldModes : Finset Wavevector) :
    Finset Wavevector :=
  (cutoffModes ×ˢ fieldModes).image fun pk ↦ pk.1 + pk.2

theorem mem_finiteCutoffOutputModes_iff
    (cutoffModes fieldModes : Finset Wavevector) (q : Wavevector) :
    q ∈ finiteCutoffOutputModes cutoffModes fieldModes ↔
      ∃ p ∈ cutoffModes, ∃ k ∈ fieldModes, p + k = q := by
  classical
  simp only [finiteCutoffOutputModes, Finset.mem_image,
    Finset.mem_product, Prod.exists]
  constructor
  · rintro ⟨p, k, ⟨hp, hk⟩, hpk⟩
    exact ⟨p, hp, k, hk, hpk⟩
  · rintro ⟨p, hp, k, hk, hpk⟩
    exact ⟨p, k, ⟨hp, hk⟩, hpk⟩

/-- The collected Fourier coefficient of a cutoff times a vector field.  The
fiber sum keeps every pair of input modes whose sum is the requested output
mode. -/
def finiteCutoffConvolutionCoeff
    (cutoffModes fieldModes : Finset Wavevector)
    (cutoffCoeff : Wavevector → ℂ) (omega : FourierVelocity)
    (q : Wavevector) : VelocityCoefficient :=
  ∑ pk ∈ cutoffModes ×ˢ fieldModes with pk.1 + pk.2 = q,
    cutoffCoeff pk.1 • omega pk.2

/-- Pair-indexed reconstruction of the frequency convolution generated by a
cutoff and a vector field.  Repeated output frequencies are deliberately kept
as repeated summands; collecting them is not needed for the exact product
identity. -/
def finiteCutoffLocalizedReconstruction
    (cutoffModes fieldModes : Finset Wavevector)
    (cutoffCoeff : Wavevector → ℂ) (omega : FourierVelocity)
    (x : UnitAddTorus (Fin 3)) : VelocityCoefficient :=
  ∑ p ∈ cutoffModes, ∑ k ∈ fieldModes,
    UnitAddTorus.mFourier (p + k) x • (cutoffCoeff p • omega k)

theorem continuous_finiteCutoffLocalizedReconstruction
    (cutoffModes fieldModes : Finset Wavevector)
    (cutoffCoeff : Wavevector → ℂ) (omega : FourierVelocity) :
    Continuous (finiteCutoffLocalizedReconstruction
      cutoffModes fieldModes cutoffCoeff omega) := by
  unfold finiteCutoffLocalizedReconstruction
  fun_prop

/-- Collecting equal output frequencies in the pair-indexed convolution gives
an ordinary finite Fourier reconstruction on the Minkowski-sum support. -/
theorem finiteFourierReconstruction_convolutionCoeff
    (cutoffModes fieldModes : Finset Wavevector)
    (cutoffCoeff : Wavevector → ℂ) (omega : FourierVelocity) :
    finiteFourierReconstruction
        (finiteCutoffOutputModes cutoffModes fieldModes)
        (finiteCutoffConvolutionCoeff
          cutoffModes fieldModes cutoffCoeff omega) =
      finiteCutoffLocalizedReconstruction
        cutoffModes fieldModes cutoffCoeff omega := by
  classical
  funext x
  let pairs := cutoffModes ×ˢ fieldModes
  let output := finiteCutoffOutputModes cutoffModes fieldModes
  let addPair : Wavevector × Wavevector → Wavevector :=
    fun pk ↦ pk.1 + pk.2
  have hmaps : ∀ pk ∈ pairs, addPair pk ∈ output := by
    intro pk hpk
    rcases Finset.mem_product.mp hpk with ⟨hp, hk⟩
    exact (mem_finiteCutoffOutputModes_iff
      cutoffModes fieldModes (addPair pk)).mpr
        ⟨pk.1, hp, pk.2, hk, rfl⟩
  change
    (∑ q ∈ output,
      UnitAddTorus.mFourier q x •
        ∑ pk ∈ pairs with addPair pk = q,
          cutoffCoeff pk.1 • omega pk.2) =
      ∑ p ∈ cutoffModes, ∑ k ∈ fieldModes,
        UnitAddTorus.mFourier (p + k) x •
          (cutoffCoeff p • omega k)
  calc
    _ = ∑ q ∈ output, ∑ pk ∈ pairs with addPair pk = q,
        UnitAddTorus.mFourier (addPair pk) x •
          (cutoffCoeff pk.1 • omega pk.2) := by
      apply Finset.sum_congr rfl
      intro q hq
      rw [Finset.smul_sum]
      apply Finset.sum_congr rfl
      intro pk hpk
      have hadd : addPair pk = q := (Finset.mem_filter.mp hpk).2
      rw [hadd]
    _ = ∑ pk ∈ pairs,
        UnitAddTorus.mFourier (addPair pk) x •
          (cutoffCoeff pk.1 • omega pk.2) := by
      exact Finset.sum_fiberwise_of_maps_to hmaps
        (fun pk : Wavevector × Wavevector ↦
          (UnitAddTorus.mFourier (addPair pk) x •
            (cutoffCoeff pk.1 • omega pk.2) : VelocityCoefficient))
    _ = _ := by
      rw [Finset.sum_product]

/-- **Exact cutoff convolution identity.**  Multiplying a finite vector
Fourier field by a finite scalar cutoff shifts each field mode `k` by every
cutoff mode `p`. -/
theorem finiteScalar_mul_finiteFourierReconstruction
    (cutoffModes fieldModes : Finset Wavevector)
    (cutoffCoeff : Wavevector → ℂ) (omega : FourierVelocity)
    (x : UnitAddTorus (Fin 3)) :
    finiteScalarFourierReconstruction cutoffModes cutoffCoeff x •
        finiteFourierReconstruction fieldModes omega x =
      finiteCutoffLocalizedReconstruction
        cutoffModes fieldModes cutoffCoeff omega x := by
  ext i
  simp only [finiteScalarFourierReconstruction,
    finiteFourierReconstruction, finiteCutoffLocalizedReconstruction,
    Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro p hp
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro k hk
  rw [UnitAddTorus.mFourier_add]
  ring

/-- Every possible localized output differs from one original field mode by
an actual cutoff frequency. -/
theorem outputMode_eq_cutoff_add_field
    {cutoffModes fieldModes : Finset Wavevector} {q : Wavevector}
    (hq : q ∈ finiteCutoffOutputModes cutoffModes fieldModes) :
    ∃ p ∈ cutoffModes, ∃ k ∈ fieldModes, q - k = p := by
  obtain ⟨p, hp, k, hk, rfl⟩ :=
    (mem_finiteCutoffOutputModes_iff cutoffModes fieldModes q).mp hq
  exact ⟨p, hp, k, hk, by simp⟩

/-! ## Quantitative chart thickening -/

/-- Coordinatewise normalized support allowed for a cutoff frequency. -/
def InNormalizedPancakeShift
    (transverseMargin axialMargin : ℝ) (v : RealVec3) : Prop :=
  |v.1| ≤ transverseMargin ∧
    |v.2.1| ≤ transverseMargin ∧
      |v.2.2| ≤ axialMargin

/-- The original normalized annulus enlarged by explicit transverse and
axial cutoff-frequency margins. -/
def InExpandedNormalizedPancakeAnnulus
    (transverseMargin axialMargin : ℝ) (v : RealVec3) : Prop :=
  |v.1| ≤ 2 + transverseMargin ∧
    |v.2.1| ≤ 2 + transverseMargin ∧
      3 / 4 - axialMargin ≤ |v.2.2| ∧
        |v.2.2| ≤ 2 + axialMargin

theorem euclideanWavevectorOfWavevector_add (p k : Wavevector) :
    euclideanWavevectorOfWavevector (p + k) =
      euclideanWavevectorOfWavevector p +
        euclideanWavevectorOfWavevector k := by
  apply WithLp.ofLp_injective 2
  funext i
  fin_cases i <;>
    simp [euclideanWavevectorOfWavevector]

/-- Square-dyadic oriented-frame normalization is additive in frequency. -/
theorem orientedFrameSquareDyadicNormalizedMode_add
    (F : OrientedFrameEquiv) (N : ℕ) (p k : Wavevector) :
    orientedFrameSquareDyadicNormalizedMode F N (p + k) =
      orientedFrameSquareDyadicNormalizedMode F N p +
        orientedFrameSquareDyadicNormalizedMode F N k := by
  rw [orientedFrameSquareDyadicNormalizedMode,
    orientedFrameSquareDyadicNormalizedMode,
    orientedFrameSquareDyadicNormalizedMode,
    euclideanWavevectorOfWavevector_add, map_add]
  apply Prod.ext
  · simp only [Prod.fst_add, WithLp.ofLp_add, Pi.add_apply]
    ring
  · apply Prod.ext <;>
      simp only [Prod.snd_add, Prod.fst_add, WithLp.ofLp_add,
        Pi.add_apply] <;>
      ring

/-- Adding a normalized cutoff shift to a mode in the original annulus lands
in the explicitly thickened annulus. -/
theorem add_mem_expandedNormalizedPancakeAnnulus
    {transverseMargin axialMargin : ℝ} {v w : RealVec3}
    (hv : InNormalizedPancakeAnnulus v)
    (hw : InNormalizedPancakeShift transverseMargin axialMargin w) :
    InExpandedNormalizedPancakeAnnulus
      transverseMargin axialMargin (v + w) := by
  obtain ⟨x, y, z⟩ := v
  obtain ⟨a, b, c⟩ := w
  change |x| ≤ 2 ∧ |y| ≤ 2 ∧ 3 / 4 ≤ |z| ∧ |z| ≤ 2 at hv
  change |a| ≤ transverseMargin ∧ |b| ≤ transverseMargin ∧
    |c| ≤ axialMargin at hw
  change |x + a| ≤ 2 + transverseMargin ∧
    |y + b| ≤ 2 + transverseMargin ∧
      3 / 4 - axialMargin ≤ |z + c| ∧
        |z + c| ≤ 2 + axialMargin
  have hx := abs_add_le x a
  have hy := abs_add_le y b
  have hzUpper := abs_add_le z c
  have hzLower : |z| ≤ |z + c| + |c| := by
    calc
      |z| = |(z + c) + (-c)| := by congr 1; ring
      _ ≤ |z + c| + |-c| := abs_add_le _ _
      _ = |z + c| + |c| := by rw [abs_neg]
  constructor
  · linarith [hv.1, hw.1]
  constructor
  · linarith [hv.2.1, hw.2.1]
  constructor
  · linarith [hv.2.2.1, hw.2.2]
  · linarith [hv.2.2.2, hw.2.2]

/-- **Localized support thickening.**  If every original field mode lies in
the normalized annulus and every cutoff mode lies in a normalized margin box,
then every Minkowski-sum output lies in the corresponding expanded annulus. -/
theorem outputMode_mem_expandedNormalizedPancakeAnnulus
    (F : OrientedFrameEquiv) (N : ℕ)
    {cutoffModes fieldModes : Finset Wavevector}
    {transverseMargin axialMargin : ℝ}
    (hfield : ∀ k ∈ fieldModes,
      InNormalizedPancakeAnnulus
        (orientedFrameSquareDyadicNormalizedMode F N k))
    (hcutoff : ∀ p ∈ cutoffModes,
      InNormalizedPancakeShift transverseMargin axialMargin
        (orientedFrameSquareDyadicNormalizedMode F N p))
    {q : Wavevector}
    (hq : q ∈ finiteCutoffOutputModes cutoffModes fieldModes) :
    InExpandedNormalizedPancakeAnnulus transverseMargin axialMargin
      (orientedFrameSquareDyadicNormalizedMode F N q) := by
  obtain ⟨p, hp, k, hk, hpk⟩ :=
    (mem_finiteCutoffOutputModes_iff cutoffModes fieldModes q).mp hq
  rw [← hpk, add_comm,
    orientedFrameSquareDyadicNormalizedMode_add]
  exact add_mem_expandedNormalizedPancakeAnnulus
    (hfield k hk) (hcutoff p hp)

/-- A constant cutoff has zero frequency leakage. -/
theorem zero_cutoff_outputModes (fieldModes : Finset Wavevector) :
    finiteCutoffOutputModes {0} fieldModes = fieldModes := by
  classical
  ext q
  simp [mem_finiteCutoffOutputModes_iff]

/-- Hermitian three-vector energy is multiplicative under a complex scalar. -/
theorem complexEuclideanNormSq_smul
    (c : ℂ) (u : VelocityCoefficient) :
    complexEuclideanNormSq (c • u) =
      Complex.normSq c * complexEuclideanNormSq u := by
  simp only [complexEuclideanNormSq, Pi.smul_apply, smul_eq_mul,
    Complex.normSq_mul]
  ring

/-- Exact pointwise energy identity for finite cutoff localization. -/
theorem complexEuclideanNormSq_finiteCutoffLocalizedReconstruction
    (cutoffModes fieldModes : Finset Wavevector)
    (cutoffCoeff : Wavevector → ℂ) (omega : FourierVelocity)
    (x : UnitAddTorus (Fin 3)) :
    complexEuclideanNormSq
        (finiteCutoffLocalizedReconstruction
          cutoffModes fieldModes cutoffCoeff omega x) =
      Complex.normSq
          (finiteScalarFourierReconstruction cutoffModes cutoffCoeff x) *
        complexEuclideanNormSq
          (finiteFourierReconstruction fieldModes omega x) := by
  rw [← finiteScalar_mul_finiteFourierReconstruction,
    complexEuclideanNormSq_smul]

/-- Pointwise `ℓ¹` bound for a finite scalar cutoff reconstruction. -/
theorem norm_finiteScalarFourierReconstruction_le
    (cutoffModes : Finset Wavevector) (cutoffCoeff : Wavevector → ℂ)
    (x : UnitAddTorus (Fin 3)) :
    ‖finiteScalarFourierReconstruction cutoffModes cutoffCoeff x‖ ≤
      ∑ p ∈ cutoffModes, ‖cutoffCoeff p‖ := by
  unfold finiteScalarFourierReconstruction
  calc
    ‖∑ p ∈ cutoffModes,
        UnitAddTorus.mFourier p x * cutoffCoeff p‖ ≤
        ∑ p ∈ cutoffModes,
          ‖UnitAddTorus.mFourier p x * cutoffCoeff p‖ :=
      norm_sum_le _ _
    _ = ∑ p ∈ cutoffModes, ‖cutoffCoeff p‖ := by
      apply Finset.sum_congr rfl
      intro p hp
      rw [norm_mul]
      simp only [UnitAddTorus.mFourier, fourier_apply,
        ContinuousMap.coe_mk, norm_prod, Circle.norm_coe,
        Finset.prod_const_one, one_mul]

/-- The localized field obeys the product of the cutoff and field Fourier
`ℓ¹` masses.  This estimate is deliberately elementary; the sharper `L²`
almost-orthogonality estimate is the next analytic obligation. -/
theorem norm_finiteCutoffLocalizedReconstruction_le
    (cutoffModes fieldModes : Finset Wavevector)
    (cutoffCoeff : Wavevector → ℂ) (omega : FourierVelocity)
    (x : UnitAddTorus (Fin 3)) :
    ‖finiteCutoffLocalizedReconstruction
        cutoffModes fieldModes cutoffCoeff omega x‖ ≤
      (∑ p ∈ cutoffModes, ‖cutoffCoeff p‖) *
        ∑ k ∈ fieldModes, ‖omega k‖ := by
  rw [← finiteScalar_mul_finiteFourierReconstruction]
  rw [norm_smul]
  exact mul_le_mul
    (norm_finiteScalarFourierReconstruction_le cutoffModes cutoffCoeff x)
    (norm_finiteFourierReconstruction_le fieldModes omega x)
    (norm_nonneg _) (Finset.sum_nonneg fun p _ ↦ norm_nonneg _)

/-- A cutoff bounded by `C` acts on finite Fourier fields with the sharp
physical-space `L²` energy factor `C²`.  Frequency leakage is explicit in the
reconstruction support above, but it does not create an energy loss. -/
theorem integral_localizedEnergy_le
    (cutoffModes fieldModes : Finset Wavevector)
    (cutoffCoeff : Wavevector → ℂ) (omega : FourierVelocity)
    (C : ℝ)
    (hcutoff : ∀ x : UnitAddTorus (Fin 3),
      ‖finiteScalarFourierReconstruction cutoffModes cutoffCoeff x‖ ≤ C) :
    (∫ x : UnitAddTorus (Fin 3),
      complexEuclideanNormSq
        (finiteCutoffLocalizedReconstruction
          cutoffModes fieldModes cutoffCoeff omega x)) ≤
      C ^ 2 * ∫ x : UnitAddTorus (Fin 3),
        complexEuclideanNormSq
          (finiteFourierReconstruction fieldModes omega x) := by
  have hlocalized : Continuous fun x : UnitAddTorus (Fin 3) ↦
      complexEuclideanNormSq
        (finiteCutoffLocalizedReconstruction
          cutoffModes fieldModes cutoffCoeff omega x) :=
    continuous_complexEuclideanNormSq_comp
      (continuous_finiteCutoffLocalizedReconstruction
        cutoffModes fieldModes cutoffCoeff omega)
  have hfield : Continuous fun x : UnitAddTorus (Fin 3) ↦
      complexEuclideanNormSq
        (finiteFourierReconstruction fieldModes omega x) :=
    continuous_complexEuclideanNormSq_comp
      (continuous_finiteFourierReconstruction fieldModes omega)
  have hlocalizedInt : Integrable (fun x : UnitAddTorus (Fin 3) ↦
      complexEuclideanNormSq
        (finiteCutoffLocalizedReconstruction
          cutoffModes fieldModes cutoffCoeff omega x)) :=
    by
      simpa only [integrableOn_univ] using
        hlocalized.continuousOn.integrableOn_compact isCompact_univ
  have hfieldInt : Integrable (fun x : UnitAddTorus (Fin 3) ↦
      complexEuclideanNormSq
        (finiteFourierReconstruction fieldModes omega x)) :=
    by
      simpa only [integrableOn_univ] using
        hfield.continuousOn.integrableOn_compact isCompact_univ
  calc
    (∫ x : UnitAddTorus (Fin 3),
      complexEuclideanNormSq
        (finiteCutoffLocalizedReconstruction
          cutoffModes fieldModes cutoffCoeff omega x)) ≤
        ∫ x : UnitAddTorus (Fin 3), C ^ 2 *
          complexEuclideanNormSq
            (finiteFourierReconstruction fieldModes omega x) := by
      apply integral_mono hlocalizedInt (hfieldInt.const_mul (C ^ 2))
      intro x
      dsimp only
      rw [complexEuclideanNormSq_finiteCutoffLocalizedReconstruction]
      apply mul_le_mul_of_nonneg_right _
        (complexEuclideanNormSq_nonneg _)
      rw [Complex.normSq_eq_norm_sq]
      exact pow_le_pow_left₀ (norm_nonneg _) (hcutoff x) 2
    _ = C ^ 2 * ∫ x : UnitAddTorus (Fin 3),
        complexEuclideanNormSq
          (finiteFourierReconstruction fieldModes omega x) := by
      rw [integral_const_mul]

end PancakeFiniteFourierLocalization
