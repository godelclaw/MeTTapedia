import Mettapedia.FluidDynamics.NavierStokes.StochasticLagrangian.PancakeAdaptiveFourierPartition
import Mettapedia.FluidDynamics.NavierStokes.StochasticLagrangian.PancakeSmoothCutoffFourierTail
import Mathlib.Algebra.MonoidAlgebra.Support

/-!
# Frequency support of quadratic Fourier localization weights

The adaptive Fourier partition uses weights of the form `normSq p`, where
`p` is a finite trigonometric polynomial.  This file explicitly collects the
Fourier coefficients of that quadratic weight.  Its frequencies lie in the
difference set of the original support, which is the precise finite margin
needed by buffered dyadic localization.
-/

set_option autoImplicit false

noncomputable section

namespace Mettapedia
namespace FluidDynamics
namespace NavierStokes
namespace PancakeQuadraticFourierSupport

open scoped BigOperators ComplexConjugate Pointwise
open PeriodicFourierTriad
open PancakeFrameCovariance
open PancakeFrozenFrameKernelTransfer
open PancakeAnnularSectorProjector
open PancakeFiniteFourierLocalization
open PancakeBufferedAnnularMultiplier
open PancakeSmoothCutoffFourierTail
open PancakeAdaptiveFourierPartition

/-- A convenient name for finite Fourier coefficient families. -/
abbrev FourierCoeff (d : Type*) := (d → ℤ) →₀ ℂ

/-- Evaluate finite coefficients as a trigonometric polynomial on the unit
torus. -/
def fourierPolynomial {d : Type*} [Fintype d]
    (coeff : FourierCoeff d) : C(UnitAddTorus d, ℂ) :=
  coeff.sum (fun k a ↦ a • UnitAddTorus.mFourier k)

/-- Fourier characters as the multiplicative map used by the universal
property of the additive monoid algebra. -/
def mFourierMonoidHom (d : Type*) [Fintype d] :
    Multiplicative (d → ℤ) →* C(UnitAddTorus d, ℂ) where
  toFun n := UnitAddTorus.mFourier n.toAdd
  map_one' := UnitAddTorus.mFourier_zero
  map_mul' m n := by
    ext x
    exact UnitAddTorus.mFourier_add

/-- Monoid-algebra evaluation is the concrete finite Fourier polynomial. -/
theorem addMonoidAlgebraLift_eq_fourierPolynomial
    {d : Type*} [Fintype d] (coeff : FourierCoeff d) :
    AddMonoidAlgebra.lift ℂ C(UnitAddTorus d, ℂ) (d → ℤ)
        (mFourierMonoidHom d) (AddMonoidAlgebra.ofCoeff coeff) =
      fourierPolynomial coeff := by
  rw [AddMonoidAlgebra.lift_apply]
  rfl

@[simp]
theorem fourierPolynomial_apply {d : Type*} [Fintype d]
    (coeff : FourierCoeff d) (x : UnitAddTorus d) :
    fourierPolynomial coeff x =
      coeff.sum (fun k a ↦ a * UnitAddTorus.mFourier k x) := by
  change (∑ k ∈ coeff.support,
      coeff k • UnitAddTorus.mFourier k) x =
    ∑ k ∈ coeff.support, coeff k * UnitAddTorus.mFourier k x
  change (ContinuousMap.evalCLM ℂ x)
      (∑ k ∈ coeff.support,
        coeff k • UnitAddTorus.mFourier k) = _
  rw [map_sum]
  simp only [map_smul, ContinuousMap.evalCLM_apply, smul_eq_mul]

/-- Reflect frequencies and conjugate amplitudes. -/
def conjugateReflect {d : Type*}
    (coeff : FourierCoeff d) : FourierCoeff d :=
  coeff.sum (fun k a ↦ Finsupp.single (-k) (conj a))

/-- Coefficients of the quadratic localization weight `conj(p) * p`. -/
def quadraticFourierCoeff {d : Type*}
    (coeff : FourierCoeff d) : FourierCoeff d :=
  AddMonoidAlgebra.coeff
    (AddMonoidAlgebra.ofCoeff (conjugateReflect coeff) *
      AddMonoidAlgebra.ofCoeff coeff :
        AddMonoidAlgebra ℂ (d → ℤ))

/-- Candidate frequencies generated by conjugating a polynomial. -/
def reflectedFrequencySet {d : Type*}
    (coeff : FourierCoeff d) : Finset (d → ℤ) := by
  classical
  exact coeff.support.image (fun k ↦ -k)

/-- The exact finite set of candidate frequency shifts generated by a
quadratic weight. -/
def quadraticFrequencySet {d : Type*}
    (coeff : FourierCoeff d) : Finset (d → ℤ) := by
  classical
  exact reflectedFrequencySet coeff + coeff.support

theorem conjugateReflect_support_subset {d : Type*}
    (coeff : FourierCoeff d) :
    (conjugateReflect coeff).support ⊆
      reflectedFrequencySet coeff := by
  classical
  rw [reflectedFrequencySet]
  intro m hm
  change m ∈
    (∑ k ∈ coeff.support,
      Finsupp.single (-k) (conj (coeff k))).support at hm
  obtain ⟨k, hk, hmk⟩ := Finsupp.mem_support_finsetSum m hm
  have hmk' : m = -k := by
    exact (Finsupp.mem_support_single _ _ _).mp hmk |>.1
  exact Finset.mem_image.mpr ⟨k, hk, hmk'.symm⟩

/-- Conjugating a finite trigonometric polynomial reflects its frequencies
and conjugates its amplitudes. -/
theorem fourierPolynomial_conjugateReflect {d : Type*} [Fintype d]
    (coeff : FourierCoeff d) (x : UnitAddTorus d) :
    fourierPolynomial (conjugateReflect coeff) x =
      conj (fourierPolynomial coeff x) := by
  classical
  rw [fourierPolynomial_apply, fourierPolynomial_apply]
  unfold conjugateReflect
  rw [Finsupp.sum_sum_index]
  · rw [map_finsuppSum]
    simp only [map_mul]
    apply Finsupp.sum_congr
    intro a b
    rw [Finsupp.sum_single_index (zero_mul _)]
    rw [UnitAddTorus.mFourier_neg]
  · intro
    simp
  · intro
    simp [add_mul]

/-- Fourier evaluation sends additive-monoid-algebra convolution to
pointwise multiplication. -/
theorem fourierPolynomial_convolutionCoeff {d : Type*} [Fintype d]
    (left right : FourierCoeff d) :
    fourierPolynomial
        (AddMonoidAlgebra.coeff
          (AddMonoidAlgebra.ofCoeff left * AddMonoidAlgebra.ofCoeff right :
            AddMonoidAlgebra ℂ (d → ℤ))) =
      fourierPolynomial left * fourierPolynomial right := by
  let evaluation :=
    AddMonoidAlgebra.lift ℂ C(UnitAddTorus d, ℂ) (d → ℤ)
      (mFourierMonoidHom d)
  calc
    fourierPolynomial
        (AddMonoidAlgebra.coeff
          (AddMonoidAlgebra.ofCoeff left * AddMonoidAlgebra.ofCoeff right :
            AddMonoidAlgebra ℂ (d → ℤ))) =
        evaluation
          (AddMonoidAlgebra.ofCoeff
            (AddMonoidAlgebra.coeff
              (AddMonoidAlgebra.ofCoeff left *
                AddMonoidAlgebra.ofCoeff right :
                  AddMonoidAlgebra ℂ (d → ℤ))) :
            AddMonoidAlgebra ℂ (d → ℤ)) := by
      symm
      exact addMonoidAlgebraLift_eq_fourierPolynomial _
    _ = evaluation
          (AddMonoidAlgebra.ofCoeff left *
            AddMonoidAlgebra.ofCoeff right) := by simp
    _ = evaluation (AddMonoidAlgebra.ofCoeff left) *
          evaluation (AddMonoidAlgebra.ofCoeff right) := by
      exact map_mul evaluation _ _
    _ = fourierPolynomial left * fourierPolynomial right := by
      rw [addMonoidAlgebraLift_eq_fourierPolynomial,
        addMonoidAlgebraLift_eq_fourierPolynomial]

/-- The collected quadratic coefficients evaluate exactly to the nonnegative
weight used by the adaptive partition. -/
theorem fourierPolynomial_quadraticFourierCoeff {d : Type*} [Fintype d]
    (coeff : FourierCoeff d) (x : UnitAddTorus d) :
    fourierPolynomial (quadraticFourierCoeff coeff) x =
      (Complex.normSq (fourierPolynomial coeff x) : ℂ) := by
  rw [quadraticFourierCoeff, fourierPolynomial_convolutionCoeff]
  change fourierPolynomial (conjugateReflect coeff) x *
      fourierPolynomial coeff x = _
  rw [fourierPolynomial_conjugateReflect]
  exact Complex.normSq_eq_conj_mul_self.symm

/-- Squaring a finite Fourier polynomial enlarges its frequency support only
to the difference set of its original support. -/
theorem quadraticFourierCoeff_support_subset {d : Type*}
    (coeff : FourierCoeff d) :
    (quadraticFourierCoeff coeff).support ⊆
      quadraticFrequencySet coeff := by
  classical
  rw [quadraticFrequencySet]
  exact (AddMonoidAlgebra.support_mul
      (AddMonoidAlgebra.ofCoeff (conjugateReflect coeff))
      (AddMonoidAlgebra.ofCoeff coeff)).trans
    (Finset.image₂_subset (conjugateReflect_support_subset coeff)
      (Finset.Subset.refl _))

/-- The candidate margin contains at most the square of the original number
of Fourier modes. -/
theorem card_quadraticFrequencySet_le {d : Type*}
    (coeff : FourierCoeff d) :
    (quadraticFrequencySet coeff).card ≤ coeff.support.card ^ 2 := by
  classical
  rw [quadraticFrequencySet, pow_two]
  calc
    (reflectedFrequencySet coeff + coeff.support).card ≤
        (reflectedFrequencySet coeff).card * coeff.support.card :=
      Finset.card_add_le
    _ ≤ coeff.support.card * coeff.support.card := by
      exact Nat.mul_le_mul_right coeff.support.card (by
        rw [reflectedFrequencySet]
        exact Finset.card_image_le
          (s := coeff.support) (f := fun k : d → ℤ ↦ -k))

/-- In particular the actually collected quadratic support has the same
quadratic cardinality bound. -/
theorem card_quadraticFourierCoeff_support_le {d : Type*}
    (coeff : FourierCoeff d) :
    (quadraticFourierCoeff coeff).support.card ≤ coeff.support.card ^ 2 := by
  exact (Finset.card_le_card (quadraticFourierCoeff_support_subset coeff)).trans
    (card_quadraticFrequencySet_le coeff)

/-! ## Eventual dyadic margin compatibility -/

/-- The entire quadratic difference set fits inside the fixed normalized
localization margin at every sufficiently large dyadic scale, uniformly over
the frozen oriented frame. -/
theorem eventually_quadraticFrequencySet_mem_localizationShift_uniformFrame
    (coeff : FourierCoeff (Fin 3)) :
    ∃ N₀ : ℕ, 2 ≤ N₀ ∧
      ∀ (F : OrientedFrameEquiv) (N : ℕ), N₀ ≤ N →
        ∀ p ∈ quadraticFrequencySet coeff,
          InNormalizedPancakeShift
            localizationTransverseMargin localizationAxialMargin
            (orientedFrameSquareDyadicNormalizedMode F N p) := by
  exact eventually_finset_mem_localizationShift_uniformFrame
    (quadraticFrequencySet coeff)

/-- Hence the actually collected quadratic Fourier support obeys the same
uniform eventual margin. -/
theorem eventually_quadraticFourierCoeff_support_mem_localizationShift_uniformFrame
    (coeff : FourierCoeff (Fin 3)) :
    ∃ N₀ : ℕ, 2 ≤ N₀ ∧
      ∀ (F : OrientedFrameEquiv) (N : ℕ), N₀ ≤ N →
        ∀ p ∈ (quadraticFourierCoeff coeff).support,
          InNormalizedPancakeShift
            localizationTransverseMargin localizationAxialMargin
            (orientedFrameSquareDyadicNormalizedMode F N p) := by
  obtain ⟨N₀, hN₀, hmargin⟩ :=
    eventually_quadraticFrequencySet_mem_localizationShift_uniformFrame coeff
  refine ⟨N₀, hN₀, ?_⟩
  intro F N hN p hp
  exact hmargin F N hN p
    (quadraticFourierCoeff_support_subset coeff hp)

/-- One finite candidate shift set for an entire adaptive family of
quadratic Fourier weights. -/
def familyQuadraticFrequencySet {ι : Type*} [Fintype ι]
    (coeff : ι → FourierCoeff (Fin 3)) : Finset Wavevector := by
  classical
  exact Finset.univ.biUnion (fun i ↦ quadraticFrequencySet (coeff i))

theorem quadratic_support_subset_familyQuadraticFrequencySet
    {ι : Type*} [Fintype ι]
    (coeff : ι → FourierCoeff (Fin 3)) (i : ι) :
    (quadraticFourierCoeff (coeff i)).support ⊆
      familyQuadraticFrequencySet coeff := by
  classical
  intro p hp
  rw [familyQuadraticFrequencySet, Finset.mem_biUnion]
  exact ⟨i, Finset.mem_univ i,
    quadraticFourierCoeff_support_subset (coeff i) hp⟩

/-- A single dyadic threshold works simultaneously for every adaptive cell,
every frequency in its collected quadratic support, and every frozen
oriented frame. -/
theorem eventually_familyQuadraticFourierCoeff_support_mem_localizationShift_uniformFrame
    {ι : Type*} [Fintype ι]
    (coeff : ι → FourierCoeff (Fin 3)) :
    ∃ N₀ : ℕ, 2 ≤ N₀ ∧
      ∀ (i : ι) (F : OrientedFrameEquiv) (N : ℕ), N₀ ≤ N →
        ∀ p ∈ (quadraticFourierCoeff (coeff i)).support,
          InNormalizedPancakeShift
            localizationTransverseMargin localizationAxialMargin
            (orientedFrameSquareDyadicNormalizedMode F N p) := by
  obtain ⟨N₀, hN₀, hmargin⟩ :=
    eventually_finset_mem_localizationShift_uniformFrame
      (familyQuadraticFrequencySet coeff)
  refine ⟨N₀, hN₀, ?_⟩
  intro i F N hN p hp
  exact hmargin F N hN p
    (quadratic_support_subset_familyQuadraticFrequencySet coeff i hp)

/-! ## Integrated adaptive Fourier package -/

/-- A finite adaptive partition has one family of nonnegative quadratic
Fourier weights that simultaneously retains coverage, has quantified
off-cell leakage, and fits the buffered multiplier margins above one common
dyadic threshold. -/
theorem exists_adaptiveQuadraticFourierPackage
    {ι : Type*} [Fintype ι]
    (weight : PartitionOfUnity ι (UnitAddTorus (Fin 3)))
    {delta : ℝ} (hdelta : 0 < delta)
    (hsmall :
      (Fintype.card ι : ℝ) * (delta * (delta + 2)) ≤ 1 / 2) :
    ∃ (coeff : ι → FourierCoeff (Fin 3)) (N₀ : ℕ),
      2 ≤ N₀ ∧
      (∀ x,
        1 / 2 ≤ ∑ i : ι,
          Complex.normSq (fourierPolynomial (coeff i) x) ∧
        (∑ i : ι,
          Complex.normSq (fourierPolynomial (coeff i) x)) ≤ 3 / 2) ∧
      (∀ i x, weight i x = 0 →
        Complex.normSq (fourierPolynomial (coeff i) x) < delta ^ 2) ∧
      (∀ (i : ι) (F : OrientedFrameEquiv) (N : ℕ), N₀ ≤ N →
        ∀ p ∈ (quadraticFourierCoeff (coeff i)).support,
          InNormalizedPancakeShift
            localizationTransverseMargin localizationAxialMargin
            (orientedFrameSquareDyadicNormalizedMode F N p)) := by
  obtain ⟨coeff, happrox, hleak⟩ :=
    exists_finsupp_mFourier_partition_normSq_approximation_with_leakage
      weight hdelta
  have happrox' : ∀ i x,
      |Complex.normSq (fourierPolynomial (coeff i) x) - weight i x| ≤
        delta * (delta + 2) := by
    simpa only [fourierPolynomial] using happrox
  have hleak' : ∀ i x, weight i x = 0 →
      Complex.normSq (fourierPolynomial (coeff i) x) < delta ^ 2 := by
    simpa only [fourierPolynomial] using hleak
  obtain ⟨N₀, hN₀, hmargin⟩ :=
    eventually_familyQuadraticFourierCoeff_support_mem_localizationShift_uniformFrame
      coeff
  refine ⟨coeff, N₀, hN₀, ?_, hleak', hmargin⟩
  intro x
  have hsum : (∑ i : ι, weight i x) = 1 := by
    simpa only [finsum_eq_sum_of_fintype] using
      weight.sum_eq_one (Set.mem_univ x)
  have hreplace :
      (∑ i : ι, Complex.normSq (fourierPolynomial (coeff i) x)) - 1 =
        (∑ i : ι, Complex.normSq (fourierPolynomial (coeff i) x)) -
          ∑ i : ι, weight i x := by
    exact congrArg
      (fun t : ℝ ↦
        (∑ i : ι,
          Complex.normSq (fourierPolynomial (coeff i) x)) - t)
      hsum |>.symm
  have habs :
      |(∑ i : ι, Complex.normSq (fourierPolynomial (coeff i) x)) - 1| ≤
        (Fintype.card ι : ℝ) * (delta * (delta + 2)) := by
    rw [hreplace, ← Finset.sum_sub_distrib]
    calc
      |(∑ i : ι,
          (Complex.normSq (fourierPolynomial (coeff i) x) - weight i x))| ≤
          ∑ i : ι,
            |Complex.normSq (fourierPolynomial (coeff i) x) - weight i x| :=
        Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _i : ι, delta * (delta + 2) := by
        exact Finset.sum_le_sum fun i hi ↦ happrox' i x
      _ = (Fintype.card ι : ℝ) * (delta * (delta + 2)) := by
        simp
  rw [abs_le] at habs
  constructor <;> linarith

