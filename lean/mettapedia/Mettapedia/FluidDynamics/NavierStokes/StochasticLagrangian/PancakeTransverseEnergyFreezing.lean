local notation "R3" => EuclideanSpace ℝ (Fin 3)

local instance : MeasureSpace UnitAddCircle := ⟨AddCircle.haarAddCircle⟩
local instance : Measure.IsAddHaarMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (Measure.IsAddHaarMeasure AddCircle.haarAddCircle)
local instance : IsProbabilityMeasure (volume : Measure UnitAddCircle) :=
  inferInstanceAs (IsProbabilityMeasure AddCircle.haarAddCircle)

section Generic

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]

/-- Squared energy of `u` transverse to the line generated by `e`. -/
def transverseLineEnergy (e u : E) : ℝ :=
  ‖u‖ ^ 2 - (inner ℝ u e) ^ 2

/-- The difference of transverse energies is the quadratic form of the
difference of the corresponding rank-one line projectors. -/
theorem transverseLineEnergy_sub_eq_inner_projector_sub
    (e f u : E) :
    transverseLineEnergy e u - transverseLineEnergy f u =
      inner ℝ u ((lineProjector f - lineProjector e) u) := by
  simp only [transverseLineEnergy, lineProjector, sub_apply,
    InnerProductSpace.rankOne_apply, inner_sub_right,
    real_inner_smul_right]
  rw [real_inner_comm f u, real_inner_comm e u]
  ring

/-- Transverse energy is Lipschitz in the sign-invariant line projector. -/
theorem abs_transverseLineEnergy_sub_le
    (e f u : E) :
    |transverseLineEnergy e u - transverseLineEnergy f u| ≤
      ‖lineProjector e - lineProjector f‖ * ‖u‖ ^ 2 := by
  rw [transverseLineEnergy_sub_eq_inner_projector_sub]
  calc
    |inner ℝ u ((lineProjector f - lineProjector e) u)| ≤
        ‖u‖ * ‖(lineProjector f - lineProjector e) u‖ :=
      abs_real_inner_le_norm _ _
    _ ≤ ‖u‖ * (‖lineProjector f - lineProjector e‖ * ‖u‖) := by
      gcongr
      exact ContinuousLinearMap.le_opNorm _ _
    _ = ‖lineProjector e - lineProjector f‖ * ‖u‖ ^ 2 := by
      rw [norm_sub_rev]
      ring

/-- One-sided form used when replacing a varying line by a frozen line. -/
theorem transverseLineEnergy_le_add_projectorError
    (e f u : E) :
    transverseLineEnergy e u ≤ transverseLineEnergy f u +
      ‖lineProjector e - lineProjector f‖ * ‖u‖ ^ 2 := by
  have h := abs_transverseLineEnergy_sub_le e f u
  rw [abs_le] at h
  linarith [h.2]

end Generic

theorem sub_lt_add_of_abs_sub_le_of_abs_sub_lt
    (a b c epsilon threshold : ℝ)
    (htop : |a - b| ≤ epsilon) (hcross : |a - c| < threshold) :
    b - c < threshold + epsilon := by
  calc
    b - c = (b - a) + (a - c) := by ring
    _ ≤ |b - a| + |a - c| :=
      add_le_add (le_abs_self _) (le_abs_self _)
    _ = |a - b| + |a - c| := by rw [abs_sub_comm]
    _ < epsilon + threshold := add_lt_add_of_le_of_lt htop hcross
    _ = threshold + epsilon := by ring

/-! ## Complex coefficient energy -/

/-- Coordinatewise real part of a complex coefficient in mathlib's
Euclidean three-space. -/
def complexRealPartEuclidean (u : ComplexVec3) : R3 :=
  WithLp.toLp 2 (fun i ↦ (u i).re)

/-- Coordinatewise imaginary part of a complex coefficient in mathlib's
Euclidean three-space. -/
def complexImagPartEuclidean (u : ComplexVec3) : R3 :=
  WithLp.toLp 2 (fun i ↦ (u i).im)

/-- Sign-invariant Hermitian energy transverse to a real Euclidean line. -/
def complexTransverseLineEnergy (e : R3) (u : ComplexVec3) : ℝ :=
  transverseLineEnergy e (complexRealPartEuclidean u) +
    transverseLineEnergy e (complexImagPartEuclidean u)

theorem complexEuclideanNormSq_eq_parts (u : ComplexVec3) :
    complexEuclideanNormSq u =
      ‖complexRealPartEuclidean u‖ ^ 2 +
        ‖complexImagPartEuclidean u‖ ^ 2 := by
  rw [EuclideanSpace.real_norm_sq_eq, EuclideanSpace.real_norm_sq_eq]
  simp [complexEuclideanNormSq, complexRealPartEuclidean,
    complexImagPartEuclidean, Complex.normSq_apply,
    Fin.sum_univ_three]
  ring

theorem complexEuclideanNormSq_nonneg (u : ComplexVec3) :
    0 ≤ complexEuclideanNormSq u := by
  rw [complexEuclideanNormSq_eq_parts]
  positivity

/-- The complex transverse energy changes by at most the line-projector
oscillation times the full coefficient energy. -/
theorem complexTransverseLineEnergy_le_add_projectorError
    (e f : R3) (u : ComplexVec3) :
    complexTransverseLineEnergy e u ≤
      complexTransverseLineEnergy f u +
        ‖lineProjector e - lineProjector f‖ *
          complexEuclideanNormSq u := by
  have hre := transverseLineEnergy_le_add_projectorError e f
    (complexRealPartEuclidean u)
  have him := transverseLineEnergy_le_add_projectorError e f
    (complexImagPartEuclidean u)
  rw [complexEuclideanNormSq_eq_parts]
  unfold complexTransverseLineEnergy
  linarith [hre, him]

theorem realVec3OfEuclidean_complexRealPartEuclidean
    (u : ComplexVec3) :
    realVec3OfEuclidean (complexRealPartEuclidean u) =
      complexRealPartVec u := by
  rfl

theorem realVec3OfEuclidean_complexImagPartEuclidean
    (u : ComplexVec3) :
    realVec3OfEuclidean (complexImagPartEuclidean u) =
      complexImagPartVec u := by
  rfl

/-- A real vector's chart energy transverse to `e_x` is exactly its invariant
energy transverse to the physical expanding eigenline. -/
theorem fullStrainFrame_chartTransverseEnergy_eq
    (S : R3 →L[ℝ] R3)
    (hSsymm : ∀ (u v : R3), inner ℝ u (S v) = inner ℝ (S u) v)
    (u : R3) :
    normSq ((fullStrainFrame S hSsymm).toFun
        (realVec3OfEuclidean u)) -
      dot ex ((fullStrainFrame S hSsymm).toFun
        (realVec3OfEuclidean u)) ^ 2 =
      transverseLineEnergy
        ((orderedEigenframe S hSsymm).eigenbasis 0) u := by
  rw [(fullStrainFrame S hSsymm).map_normSq,
    normSq_realVec3OfEuclidean,
    dot_ex_fullStrainFrame_eq_inner_expanding]
  rfl

/-- The chart transverse energy used in the finite Parseval bridge is exactly
the sign-invariant physical transverse energy of the expanding strain line. -/
theorem complexTransverseEnergyEx_fullStrainFrame_eq
    (S : R3 →L[ℝ] R3)
    (hSsymm : ∀ (u v : R3), inner ℝ u (S v) = inner ℝ (S u) v)
    (u : ComplexVec3) :
    complexTransverseEnergyEx
        (orientedFrameComplexLinearMap (fullStrainFrame S hSsymm) u) =
      complexTransverseLineEnergy
        ((orderedEigenframe S hSsymm).eigenbasis 0) u := by
  rw [complexTransverseEnergyEx_eq_real_add_imag]
  simp only [orientedFrameComplexLinearMap,
    complexRealPartVec_complexifyRealLinearEquiv,
    complexImagPartVec_complexifyRealLinearEquiv]
  rw [← realVec3OfEuclidean_complexRealPartEuclidean,
    ← realVec3OfEuclidean_complexImagPartEuclidean]
  change
    (normSq ((fullStrainFrame S hSsymm).toFun
        (realVec3OfEuclidean (complexRealPartEuclidean u))) -
      dot ex ((fullStrainFrame S hSsymm).toFun
        (realVec3OfEuclidean (complexRealPartEuclidean u))) ^ 2) +
    (normSq ((fullStrainFrame S hSsymm).toFun
        (realVec3OfEuclidean (complexImagPartEuclidean u))) -
      dot ex ((fullStrainFrame S hSsymm).toFun
        (realVec3OfEuclidean (complexImagPartEuclidean u))) ^ 2) =
      transverseLineEnergy ((orderedEigenframe S hSsymm).eigenbasis 0)
          (complexRealPartEuclidean u) +
        transverseLineEnergy ((orderedEigenframe S hSsymm).eigenbasis 0)
          (complexImagPartEuclidean u)
  rw [
    fullStrainFrame_chartTransverseEnergy_eq,
    fullStrainFrame_chartTransverseEnergy_eq]

/-- Complexification of an oriented orthogonal frame preserves the Hermitian
Euclidean coefficient energy exactly. -/
theorem complexEuclideanNormSq_orientedFrameComplexLinearMap
    (F : OrientedFrameEquiv) (u : ComplexVec3) :
    complexEuclideanNormSq (orientedFrameComplexLinearMap F u) =
      complexEuclideanNormSq u := by
  rw [complexEuclideanNormSq_eq_real_add_imag,
    complexEuclideanNormSq_eq_real_add_imag]
  simp only [orientedFrameComplexLinearMap,
    complexRealPartVec_complexifyRealLinearEquiv,
    complexImagPartVec_complexifyRealLinearEquiv]
  change normSq (F.toFun (complexRealPartVec u)) +
      normSq (F.toFun (complexImagPartVec u)) =
    normSq (complexRealPartVec u) + normSq (complexImagPartVec u)
  rw [F.map_normSq, F.map_normSq]

theorem continuous_complexEuclideanNormSq_comp
    {X : Type*} [TopologicalSpace X] {u : X → ComplexVec3}
    (hu : Continuous u) :
    Continuous (fun x ↦ complexEuclideanNormSq (u x)) := by
  exact ((Complex.continuous_normSq.comp
      ((continuous_apply 0).comp hu)).add
    (Complex.continuous_normSq.comp
      ((continuous_apply 1).comp hu))).add
    (Complex.continuous_normSq.comp
      ((continuous_apply 2).comp hu))

theorem continuous_complexTransverseEnergyEx_comp
    {X : Type*} [TopologicalSpace X] {u : X → ComplexVec3}
    (hu : Continuous u) :
    Continuous (fun x ↦ complexTransverseEnergyEx (u x)) := by
  exact (Complex.continuous_normSq.comp
      ((continuous_apply 1).comp hu)).add
    (Complex.continuous_normSq.comp
      ((continuous_apply 2).comp hu))

/-- Exact conversion of the transverse energy of a framed finite Fourier
reconstruction back to the sign-invariant physical expanding-line energy. -/
theorem fullStrainFrame_transverseEnergy_finiteReconstruction_eq
    (S : R3 →L[ℝ] R3)
    (hSsymm : ∀ (u v : R3), inner ℝ u (S v) = inner ℝ (S u) v)
    (s : Finset Wavevector) (omega : FourierVelocity)
    (x : UnitAddTorus (Fin 3)) :
    complexTransverseEnergyEx
        (finiteFourierReconstruction s
          (fun k ↦ orientedFrameComplexLinearMap
            (fullStrainFrame S hSsymm) (omega k)) x) =
      complexTransverseLineEnergy
        ((orderedEigenframe S hSsymm).eigenbasis 0)
        (finiteFourierReconstruction s omega x) := by
  rw [← orientedFrameComplexLinearMap_finiteFourierReconstruction]
  exact complexTransverseEnergyEx_fullStrainFrame_eq S hSsymm _

/-! ## Instantiation for the constructed strain eigenframes -/

/-- The top eigenvalue of the constructed ordered frame dominates every unit
Rayleigh quotient. -/
theorem rayleigh_le_constructedTopEigenvalue
    (S : R3 →L[ℝ] R3)
    (hSsymm : ∀ (u v : R3), inner ℝ u (S v) = inner ℝ (S u) v)
    (u : R3) (hu : ‖u‖ = 1) :
    inner ℝ u (S u) ≤ (orderedEigenframe S hSsymm).eigenvalue 0 := by
  let F := orderedEigenframe S hSsymm
  have hparse := parseval_three F.eigenbasis u hu
  have hray := rayleigh_three S hSsymm F.eigenvalue F.eigenbasis
    F.apply_eigenbasis u
  have h01 : F.eigenvalue 1 ≤ F.eigenvalue 0 :=
    F.antitone_eigenvalue (by decide)
  have h02 : F.eigenvalue 2 ≤ F.eigenvalue 0 :=
    F.antitone_eigenvalue (by decide)
  change inner ℝ u (S u) ≤ F.eigenvalue 0
  calc
    inner ℝ u (S u) =
        F.eigenvalue 0 * (inner ℝ u (F.eigenbasis 0)) ^ 2 +
          F.eigenvalue 1 * (inner ℝ u (F.eigenbasis 1)) ^ 2 +
          F.eigenvalue 2 * (inner ℝ u (F.eigenbasis 2)) ^ 2 := hray
    _ ≤ F.eigenvalue 0 * (inner ℝ u (F.eigenbasis 0)) ^ 2 +
          F.eigenvalue 0 * (inner ℝ u (F.eigenbasis 1)) ^ 2 +
          F.eigenvalue 0 * (inner ℝ u (F.eigenbasis 2)) ^ 2 := by
      gcongr
    _ = F.eigenvalue 0 := by
      rw [← mul_add, ← mul_add, hparse, mul_one]

/-- Unit quadratic forms are bounded by the continuous-linear operator norm. -/
theorem abs_inner_clm_apply_le_opNorm
    (T : R3 →L[ℝ] R3) (u : R3) (hu : ‖u‖ = 1) :
    |inner ℝ u (T u)| ≤ ‖T‖ := by
  calc
    |inner ℝ u (T u)| ≤ ‖u‖ * ‖T u‖ := abs_real_inner_le_norm _ _
    _ ≤ ‖u‖ * (‖T‖ * ‖u‖) := by
      gcongr
      exact ContinuousLinearMap.le_opNorm T u
    _ = ‖T‖ := by rw [hu, one_mul, mul_one]

/-- Finite-dimensional Weyl estimate for the top eigenvalues selected by the
constructed ordered spectral frames. -/
theorem abs_constructedTopEigenvalue_sub_le
    (A B : R3 →L[ℝ] R3)
    (hAsymm : ∀ (u v : R3), inner ℝ u (A v) = inner ℝ (A u) v)
    (hBsymm : ∀ (u v : R3), inner ℝ u (B v) = inner ℝ (B u) v) :
    |(orderedEigenframe A hAsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 0| ≤ ‖A - B‖ := by
  let eA := (orderedEigenframe A hAsymm).eigenbasis 0
  let eB := (orderedEigenframe B hBsymm).eigenbasis 0
  have heA : ‖eA‖ = 1 :=
    (orderedEigenframe A hAsymm).eigenbasis.norm_eq_one 0
  have heB : ‖eB‖ = 1 :=
    (orderedEigenframe B hBsymm).eigenbasis.norm_eq_one 0
  have hAeA : inner ℝ eA (A eA) =
      (orderedEigenframe A hAsymm).eigenvalue 0 := by
    rw [(orderedEigenframe A hAsymm).apply_eigenbasis,
      real_inner_smul_right, real_inner_self_eq_norm_sq, heA]
    norm_num
  have hBeB : inner ℝ eB (B eB) =
      (orderedEigenframe B hBsymm).eigenvalue 0 := by
    rw [(orderedEigenframe B hBsymm).apply_eigenbasis,
      real_inner_smul_right, real_inner_self_eq_norm_sq, heB]
    norm_num
  have hB_at_eA := rayleigh_le_constructedTopEigenvalue B hBsymm eA heA
  have hA_at_eB := rayleigh_le_constructedTopEigenvalue A hAsymm eB heB
  have hpertA := abs_inner_clm_apply_le_opNorm (A - B) eB heB
  have hpertB := abs_inner_clm_apply_le_opNorm (B - A) eA heA
  have hBA : ‖B - A‖ = ‖A - B‖ := norm_sub_rev B A
  have hsplitA : inner ℝ eB ((A - B) eB) =
      inner ℝ eB (A eB) - inner ℝ eB (B eB) := by
    rw [sub_apply, inner_sub_right]
  have hsplitB : inner ℝ eA ((B - A) eA) =
      inner ℝ eA (B eA) - inner ℝ eA (A eA) := by
    rw [sub_apply, inner_sub_right]
  rw [abs_le]
  constructor
  · rw [hsplitA, hBeB] at hpertA
    have hp := (abs_le.mp hpertA).1
    linarith [hp, hA_at_eB]
  · rw [hBA, hsplitB, hAeA] at hpertB
    have hp := (abs_le.mp hpertB).1
    linarith [hp, hB_at_eA]

/-- The generic three-dimensional perturbation theorem specialized to the
most expanding lines of the two constructed ordered strain eigenframes. -/
theorem constructedExpandingLine_nearCollision_or_projectorClose
    (A B : R3 →L[ℝ] R3)
    (hAsymm : ∀ (u v : R3), inner ℝ u (A v) = inner ℝ (A u) v)
    (hBsymm : ∀ (u v : R3), inner ℝ u (B v) = inner ℝ (B u) v)
    (epsilon threshold : ℝ) (hthreshold : 0 < threshold)
    (hepsilon : 0 ≤ epsilon) (hAB : ‖A - B‖ ≤ epsilon) :
    |(orderedEigenframe A hAsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 1| < threshold ∨
      |(orderedEigenframe A hAsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 2| < threshold ∨
      ‖lineProjector ((orderedEigenframe A hAsymm).eigenbasis 0) -
          lineProjector ((orderedEigenframe B hBsymm).eigenbasis 0)‖ ≤
        4 * (epsilon / threshold) := by
  apply nearDegenerate_or_norm_matchedEigenline_sub_le
    A B
    ((orderedEigenframe A hAsymm).eigenbasis 0)
    ((orderedEigenframe B hBsymm).eigenbasis 0)
    ((orderedEigenframe B hBsymm).eigenbasis 1)
    ((orderedEigenframe B hBsymm).eigenbasis 2)
    ((orderedEigenframe A hAsymm).eigenvalue 0)
    ((orderedEigenframe B hBsymm).eigenvalue 1)
    ((orderedEigenframe B hBsymm).eigenvalue 2)
    epsilon threshold hBsymm
  · exact (orderedEigenframe A hAsymm).apply_eigenbasis 0
  · exact (orderedEigenframe B hBsymm).apply_eigenbasis 1
  · exact (orderedEigenframe B hBsymm).apply_eigenbasis 2
  · exact (orderedEigenframe A hAsymm).eigenbasis.norm_eq_one 0
  · exact (orderedEigenframe B hBsymm).eigenbasis.norm_eq_one 0
  · exact (orderedEigenframe B hBsymm).eigenbasis.norm_eq_one 1
  · exact (orderedEigenframe B hBsymm).eigenbasis.norm_eq_one 2
  · exact parseval_three (orderedEigenframe B hBsymm).eigenbasis
      ((orderedEigenframe A hAsymm).eigenbasis 0)
      ((orderedEigenframe A hAsymm).eigenbasis.norm_eq_one 0)
  · exact hthreshold
  · exact hepsilon
  · exact hAB

/-- The cross-strain collision alternatives can be converted into the actual
top-gap collision bands of the frozen strain `B`.  The price is the sharp
top-eigenvalue perturbation allowance `epsilon`. -/
theorem constructedExpandingLine_smallFrozenGap_or_projectorClose
    (A B : R3 →L[ℝ] R3)
    (hAsymm : ∀ (u v : R3), inner ℝ u (A v) = inner ℝ (A u) v)
    (hBsymm : ∀ (u v : R3), inner ℝ u (B v) = inner ℝ (B u) v)
    (epsilon threshold : ℝ) (hthreshold : 0 < threshold)
    (hepsilon : 0 ≤ epsilon) (hAB : ‖A - B‖ ≤ epsilon) :
    (orderedEigenframe B hBsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 1 <
          threshold + epsilon ∨
      (orderedEigenframe B hBsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 2 <
          threshold + epsilon ∨
      ‖lineProjector ((orderedEigenframe A hAsymm).eigenbasis 0) -
          lineProjector ((orderedEigenframe B hBsymm).eigenbasis 0)‖ ≤
        4 * (epsilon / threshold) := by
  have htop : |(orderedEigenframe A hAsymm).eigenvalue 0 -
      (orderedEigenframe B hBsymm).eigenvalue 0| ≤ epsilon :=
    (abs_constructedTopEigenvalue_sub_le A B hAsymm hBsymm).trans hAB
  rcases constructedExpandingLine_nearCollision_or_projectorClose
      A B hAsymm hBsymm epsilon threshold hthreshold hepsilon hAB with
    hnear₁ | hnear₂ | hfar
  · apply Or.inl
    calc
      (orderedEigenframe B hBsymm).eigenvalue 0 -
          (orderedEigenframe B hBsymm).eigenvalue 1 =
        ((orderedEigenframe B hBsymm).eigenvalue 0 -
          (orderedEigenframe A hAsymm).eigenvalue 0) +
        ((orderedEigenframe A hAsymm).eigenvalue 0 -
          (orderedEigenframe B hBsymm).eigenvalue 1) := by ring
      _ ≤ |(orderedEigenframe B hBsymm).eigenvalue 0 -
            (orderedEigenframe A hAsymm).eigenvalue 0| +
          |(orderedEigenframe A hAsymm).eigenvalue 0 -
            (orderedEigenframe B hBsymm).eigenvalue 1| :=
        add_le_add (le_abs_self _) (le_abs_self _)
      _ = |(orderedEigenframe A hAsymm).eigenvalue 0 -
            (orderedEigenframe B hBsymm).eigenvalue 0| +
          |(orderedEigenframe A hAsymm).eigenvalue 0 -
            (orderedEigenframe B hBsymm).eigenvalue 1| := by
        rw [abs_sub_comm]
      _ < epsilon + threshold := add_lt_add_of_le_of_lt htop hnear₁
      _ = threshold + epsilon := by ring
  · apply Or.inr (Or.inl ?_)
    calc
      (orderedEigenframe B hBsymm).eigenvalue 0 -
          (orderedEigenframe B hBsymm).eigenvalue 2 =
        ((orderedEigenframe B hBsymm).eigenvalue 0 -
          (orderedEigenframe A hAsymm).eigenvalue 0) +
        ((orderedEigenframe A hAsymm).eigenvalue 0 -
          (orderedEigenframe B hBsymm).eigenvalue 2) := by ring
      _ ≤ |(orderedEigenframe B hBsymm).eigenvalue 0 -
            (orderedEigenframe A hAsymm).eigenvalue 0| +
          |(orderedEigenframe A hAsymm).eigenvalue 0 -
            (orderedEigenframe B hBsymm).eigenvalue 2| :=
        add_le_add (le_abs_self _) (le_abs_self _)
      _ = |(orderedEigenframe A hAsymm).eigenvalue 0 -
            (orderedEigenframe B hBsymm).eigenvalue 0| +
          |(orderedEigenframe A hAsymm).eigenvalue 0 -
            (orderedEigenframe B hBsymm).eigenvalue 2| := by
        rw [abs_sub_comm]
      _ < epsilon + threshold := add_lt_add_of_le_of_lt htop hnear₂
      _ = threshold + epsilon := by ring
  · exact Or.inr (Or.inr hfar)

/-- Away from the explicit collision branches, freezing the expanding
eigenline changes a complex coefficient's transverse energy by at most
`4 * epsilon / threshold` times its full energy. -/
theorem constructedExpandingLine_nearCollision_or_complexTransverseEnergy_le
    (A B : R3 →L[ℝ] R3)
    (hAsymm : ∀ (u v : R3), inner ℝ u (A v) = inner ℝ (A u) v)
    (hBsymm : ∀ (u v : R3), inner ℝ u (B v) = inner ℝ (B u) v)
    (epsilon threshold : ℝ) (hthreshold : 0 < threshold)
    (hepsilon : 0 ≤ epsilon) (hAB : ‖A - B‖ ≤ epsilon)
    (u : ComplexVec3) :
    |(orderedEigenframe A hAsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 1| < threshold ∨
      |(orderedEigenframe A hAsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 2| < threshold ∨
      complexTransverseLineEnergy
          ((orderedEigenframe A hAsymm).eigenbasis 0) u ≤
        complexTransverseLineEnergy
            ((orderedEigenframe B hBsymm).eigenbasis 0) u +
          (4 * (epsilon / threshold)) * complexEuclideanNormSq u := by
  rcases constructedExpandingLine_nearCollision_or_projectorClose
      A B hAsymm hBsymm epsilon threshold hthreshold hepsilon hAB with
    hnear₁ | hnear₂ | hfar
  · exact Or.inl hnear₁
  · exact Or.inr (Or.inl hnear₂)
  · apply Or.inr (Or.inr ?_)
    refine (complexTransverseLineEnergy_le_add_projectorError
      ((orderedEigenframe A hAsymm).eigenbasis 0)
      ((orderedEigenframe B hBsymm).eigenbasis 0) u).trans ?_
    have henergy : 0 ≤ complexEuclideanNormSq u :=
      complexEuclideanNormSq_nonneg u
    gcongr

/-- Pointwise finite-reconstruction form of the frozen-to-varying line
estimate.  On the separated branch, the transverse energy computed in the
`A` strain chart is controlled by the energy transverse to the frozen `B`
expanding line plus the explicit projector perturbation error. -/
theorem fullStrainFrame_reconstruction_nearCollision_or_transverseEnergy_le
    (A B : R3 →L[ℝ] R3)
    (hAsymm : ∀ (u v : R3), inner ℝ u (A v) = inner ℝ (A u) v)
    (hBsymm : ∀ (u v : R3), inner ℝ u (B v) = inner ℝ (B u) v)
    (epsilon threshold : ℝ) (hthreshold : 0 < threshold)
    (hepsilon : 0 ≤ epsilon) (hAB : ‖A - B‖ ≤ epsilon)
    (s : Finset Wavevector) (omega : FourierVelocity)
    (x : UnitAddTorus (Fin 3)) :
    |(orderedEigenframe A hAsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 1| < threshold ∨
      |(orderedEigenframe A hAsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 2| < threshold ∨
      complexTransverseEnergyEx
          (finiteFourierReconstruction s
            (fun k ↦ orientedFrameComplexLinearMap
              (fullStrainFrame A hAsymm) (omega k)) x) ≤
        complexTransverseLineEnergy
            ((orderedEigenframe B hBsymm).eigenbasis 0)
            (finiteFourierReconstruction s omega x) +
          (4 * (epsilon / threshold)) *
            complexEuclideanNormSq
              (finiteFourierReconstruction s omega x) := by
  let U := finiteFourierReconstruction s omega x
  rcases
      constructedExpandingLine_nearCollision_or_complexTransverseEnergy_le
        A B hAsymm hBsymm epsilon threshold hthreshold hepsilon hAB U with
    hnear₁ | hnear₂ | hfar
  · exact Or.inl hnear₁
  · exact Or.inr (Or.inl hnear₂)
  · apply Or.inr (Or.inr ?_)
    calc
      complexTransverseEnergyEx
          (finiteFourierReconstruction s
            (fun k ↦ orientedFrameComplexLinearMap
              (fullStrainFrame A hAsymm) (omega k)) x) =
          complexTransverseEnergyEx
            (orientedFrameComplexLinearMap (fullStrainFrame A hAsymm) U) := by
        rw [orientedFrameComplexLinearMap_finiteFourierReconstruction]
      _ = complexTransverseLineEnergy
          ((orderedEigenframe A hAsymm).eigenbasis 0) U :=
        complexTransverseEnergyEx_fullStrainFrame_eq A hAsymm U
      _ ≤ complexTransverseLineEnergy
            ((orderedEigenframe B hBsymm).eigenbasis 0) U +
          (4 * (epsilon / threshold)) * complexEuclideanNormSq U := hfar

/-- Integrated finite-reconstruction freezing theorem.  Away from the two
collision branches, replacing the `A` expanding line by the frozen `B` line
costs at most `4 * epsilon / threshold` times the full physical `L²` energy. -/
theorem fullStrainFrame_integral_nearCollision_or_transverseEnergy_le
    (A B : R3 →L[ℝ] R3)
    (hAsymm : ∀ (u v : R3), inner ℝ u (A v) = inner ℝ (A u) v)
    (hBsymm : ∀ (u v : R3), inner ℝ u (B v) = inner ℝ (B u) v)
    (epsilon threshold : ℝ) (hthreshold : 0 < threshold)
    (hepsilon : 0 ≤ epsilon) (hAB : ‖A - B‖ ≤ epsilon)
    (s : Finset Wavevector) (omega : FourierVelocity) :
    |(orderedEigenframe A hAsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 1| < threshold ∨
      |(orderedEigenframe A hAsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 2| < threshold ∨
      (∫ x : UnitAddTorus (Fin 3),
          complexTransverseEnergyEx
            (finiteFourierReconstruction s
              (fun k ↦ orientedFrameComplexLinearMap
                (fullStrainFrame A hAsymm) (omega k)) x)) ≤
        (∫ x : UnitAddTorus (Fin 3),
          complexTransverseEnergyEx
            (finiteFourierReconstruction s
              (fun k ↦ orientedFrameComplexLinearMap
                (fullStrainFrame B hBsymm) (omega k)) x)) +
        (4 * (epsilon / threshold)) *
          ∫ x : UnitAddTorus (Fin 3),
            complexEuclideanNormSq
              (finiteFourierReconstruction s omega x) := by
  rcases constructedExpandingLine_nearCollision_or_projectorClose
      A B hAsymm hBsymm epsilon threshold hthreshold hepsilon hAB with
    hnear₁ | hnear₂ | hfar
  · exact Or.inl hnear₁
  · exact Or.inr (Or.inl hnear₂)
  · apply Or.inr (Or.inr ?_)
    let fieldA : UnitAddTorus (Fin 3) → ComplexVec3 :=
      finiteFourierReconstruction s
        (fun k ↦ orientedFrameComplexLinearMap
          (fullStrainFrame A hAsymm) (omega k))
    let fieldB : UnitAddTorus (Fin 3) → ComplexVec3 :=
      finiteFourierReconstruction s
        (fun k ↦ orientedFrameComplexLinearMap
          (fullStrainFrame B hBsymm) (omega k))
    let field : UnitAddTorus (Fin 3) → ComplexVec3 :=
      finiteFourierReconstruction s omega
    have hfieldA : Continuous fieldA :=
      continuous_finiteFourierReconstruction s _
    have hfieldB : Continuous fieldB :=
      continuous_finiteFourierReconstruction s _
    have hfield : Continuous field :=
      continuous_finiteFourierReconstruction s omega
    have hintA : Integrable (fun x ↦ complexTransverseEnergyEx (fieldA x)) := by
      have hcont := continuous_complexTransverseEnergyEx_comp hfieldA
      simpa only [integrableOn_univ] using
        hcont.continuousOn.integrableOn_compact
          (isCompact_univ : IsCompact
            (Set.univ : Set (UnitAddTorus (Fin 3))))
    have hintB : Integrable (fun x ↦ complexTransverseEnergyEx (fieldB x)) := by
      have hcont := continuous_complexTransverseEnergyEx_comp hfieldB
      simpa only [integrableOn_univ] using
        hcont.continuousOn.integrableOn_compact
          (isCompact_univ : IsCompact
            (Set.univ : Set (UnitAddTorus (Fin 3))))
    have hint : Integrable (fun x ↦ complexEuclideanNormSq (field x)) := by
      have hcont := continuous_complexEuclideanNormSq_comp hfield
      simpa only [integrableOn_univ] using
        hcont.continuousOn.integrableOn_compact
          (isCompact_univ : IsCompact
            (Set.univ : Set (UnitAddTorus (Fin 3))))
    have hpoint : ∀ x,
        complexTransverseEnergyEx (fieldA x) ≤
          complexTransverseEnergyEx (fieldB x) +
            (4 * (epsilon / threshold)) *
              complexEuclideanNormSq (field x) := by
      intro x
      rw [show complexTransverseEnergyEx (fieldA x) =
          complexTransverseLineEnergy
            ((orderedEigenframe A hAsymm).eigenbasis 0) (field x) by
        exact fullStrainFrame_transverseEnergy_finiteReconstruction_eq
          A hAsymm s omega x]
      rw [show complexTransverseEnergyEx (fieldB x) =
          complexTransverseLineEnergy
            ((orderedEigenframe B hBsymm).eigenbasis 0) (field x) by
        exact fullStrainFrame_transverseEnergy_finiteReconstruction_eq
          B hBsymm s omega x]
      refine (complexTransverseLineEnergy_le_add_projectorError
        ((orderedEigenframe A hAsymm).eigenbasis 0)
        ((orderedEigenframe B hBsymm).eigenbasis 0) (field x)).trans ?_
      gcongr
      exact complexEuclideanNormSq_nonneg (field x)
    change (∫ x, complexTransverseEnergyEx (fieldA x)) ≤
      (∫ x, complexTransverseEnergyEx (fieldB x)) +
        (4 * (epsilon / threshold)) *
          ∫ x, complexEuclideanNormSq (field x)
    calc
      (∫ x, complexTransverseEnergyEx (fieldA x)) ≤
          ∫ x, (complexTransverseEnergyEx (fieldB x) +
            (4 * (epsilon / threshold)) *
              complexEuclideanNormSq (field x)) := by
        exact integral_mono hintA
          (hintB.add (hint.const_mul _)) hpoint
      _ = (∫ x, complexTransverseEnergyEx (fieldB x)) +
          (4 * (epsilon / threshold)) *
            ∫ x, complexEuclideanNormSq (field x) := by
        rw [integral_add hintB (hint.const_mul _), integral_const_mul]

/-- **Frozen-cell control of the exact pancake remainder.**  For the genuine
physical square-dyadic sector selected by the strain `A`, either an explicit
top-eigenvalue collision occurs between `A` and the frozen strain `B`, or the
summed exact Fourier misalignment energy is bounded by the frozen-frame
physical transverse energy plus the quantitative strain-oscillation error. -/
theorem sectorMisalignment_nearCollision_or_le_frozenIntegral
    (A B : R3 →L[ℝ] R3)
    (hAsymm : ∀ (u v : R3), inner ℝ u (A v) = inner ℝ (A u) v)
    (hBsymm : ∀ (u v : R3), inner ℝ u (B v) = inner ℝ (B u) v)
    (epsilon threshold : ℝ) (hthreshold : 0 < threshold)
    (hepsilon : 0 ≤ epsilon) (hAB : ‖A - B‖ ≤ epsilon)
    {N : ℕ} (hN : 2 ≤ N) (support : Finset Wavevector)
    (omega : FourierVelocity) (hdiv : ∀ k, modeDot k (omega k) = 0) :
    |(orderedEigenframe A hAsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 1| < threshold ∨
      |(orderedEigenframe A hAsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 2| < threshold ∨
      (∑ k ∈ squareDyadicPancakeSectorModes
            (fullStrainFrame A hAsymm) N support,
          complexEuclideanNormSq
            (complexMisalignmentChartComponent
              (orientedFrameWavevectorCoordinates
                (fullStrainFrame A hAsymm) k)
              (orientedFrameComplexLinearMap
                (fullStrainFrame A hAsymm) (omega k)))) ≤
        (∫ x : UnitAddTorus (Fin 3),
          complexTransverseEnergyEx
            (finiteFourierReconstruction
              (squareDyadicPancakeSectorModes
                (fullStrainFrame A hAsymm) N support)
              (fun k ↦ orientedFrameComplexLinearMap
                (fullStrainFrame B hBsymm) (omega k)) x)) +
        (4 * (epsilon / threshold)) *
          ∫ x : UnitAddTorus (Fin 3),
            complexEuclideanNormSq
              (finiteFourierReconstruction
                (squareDyadicPancakeSectorModes
                  (fullStrainFrame A hAsymm) N support)
                omega x) := by
  let sA := squareDyadicPancakeSectorModes
    (fullStrainFrame A hAsymm) N support
  have hbase :=
    fullStrainFrame_sectorModes_sum_complexMisalignment_le_integral
      A hAsymm hN support omega hdiv
  rcases fullStrainFrame_integral_nearCollision_or_transverseEnergy_le
      A B hAsymm hBsymm epsilon threshold hthreshold hepsilon hAB sA omega with
    hnear₁ | hnear₂ | hfar
  · exact Or.inl hnear₁
  · exact Or.inr (Or.inl hnear₂)
  · apply Or.inr (Or.inr ?_)
    simpa [sA] using hbase.trans hfar

/-- Collision-safe form of the frozen-cell remainder theorem.  Its two
exceptional branches are now the ordinary top spectral gaps of the single
frozen strain `B`, exactly the gaps consumed by the existing alignment
coercivity dichotomy. -/
theorem sectorMisalignment_smallFrozenGap_or_le_frozenIntegral
    (A B : R3 →L[ℝ] R3)
    (hAsymm : ∀ (u v : R3), inner ℝ u (A v) = inner ℝ (A u) v)
    (hBsymm : ∀ (u v : R3), inner ℝ u (B v) = inner ℝ (B u) v)
    (epsilon threshold : ℝ) (hthreshold : 0 < threshold)
    (hepsilon : 0 ≤ epsilon) (hAB : ‖A - B‖ ≤ epsilon)
    {N : ℕ} (hN : 2 ≤ N) (support : Finset Wavevector)
    (omega : FourierVelocity) (hdiv : ∀ k, modeDot k (omega k) = 0) :
    (orderedEigenframe B hBsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 1 <
          threshold + epsilon ∨
      (orderedEigenframe B hBsymm).eigenvalue 0 -
        (orderedEigenframe B hBsymm).eigenvalue 2 <
          threshold + epsilon ∨
      (∑ k ∈ squareDyadicPancakeSectorModes
            (fullStrainFrame A hAsymm) N support,
          complexEuclideanNormSq
            (complexMisalignmentChartComponent
              (orientedFrameWavevectorCoordinates
                (fullStrainFrame A hAsymm) k)
              (orientedFrameComplexLinearMap
                (fullStrainFrame A hAsymm) (omega k)))) ≤
        (∫ x : UnitAddTorus (Fin 3),
          complexTransverseEnergyEx
            (finiteFourierReconstruction
              (squareDyadicPancakeSectorModes
                (fullStrainFrame A hAsymm) N support)
              (fun k ↦ orientedFrameComplexLinearMap
                (fullStrainFrame B hBsymm) (omega k)) x)) +
        (4 * (epsilon / threshold)) *
          ∫ x : UnitAddTorus (Fin 3),
            complexEuclideanNormSq
              (finiteFourierReconstruction
                (squareDyadicPancakeSectorModes
                  (fullStrainFrame A hAsymm) N support)
                omega x) := by
  have htop : |(orderedEigenframe A hAsymm).eigenvalue 0 -
      (orderedEigenframe B hBsymm).eigenvalue 0| ≤ epsilon :=
    (abs_constructedTopEigenvalue_sub_le A B hAsymm hBsymm).trans hAB
  rcases sectorMisalignment_nearCollision_or_le_frozenIntegral
      A B hAsymm hBsymm epsilon threshold hthreshold hepsilon hAB
      hN support omega hdiv with hnear₁ | hnear₂ | hfar
  · exact Or.inl (sub_lt_add_of_abs_sub_le_of_abs_sub_lt
      ((orderedEigenframe A hAsymm).eigenvalue 0)
      ((orderedEigenframe B hBsymm).eigenvalue 0)
      ((orderedEigenframe B hBsymm).eigenvalue 1)
      epsilon threshold htop hnear₁)
  · exact Or.inr (Or.inl (sub_lt_add_of_abs_sub_le_of_abs_sub_lt
      ((orderedEigenframe A hAsymm).eigenvalue 0)
      ((orderedEigenframe B hBsymm).eigenvalue 0)
      ((orderedEigenframe B hBsymm).eigenvalue 2)
      epsilon threshold htop hnear₂))
  · exact Or.inr (Or.inr hfar)

end PancakeTransverseEnergyFreezing
