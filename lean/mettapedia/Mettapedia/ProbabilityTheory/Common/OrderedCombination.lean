import KnuthSkilling.Additive.Axioms.OpIsAddition
import Mathlib.Algebra.Group.End

/-!
# Ordered combination: iterates, calibration and sequential actions

Natural iterates identify the submonoid generated by one positive element. They
are not a representation of the entire carrier. Global additive representations
come from the canonical Knuth–Skilling package with its existence hypotheses.
Once supplied, their remaining positive scale freedom is fixed by one anchor.

Sequential execution uses a homomorphism from the opposite monoid into state
endomorphisms: combination executes the left operand first. Observation by an
additive representation forgets order; the faithful regular action need not.
-/

namespace Mettapedia.ProbabilityTheory.OrderedCombination

open KnuthSkilling KnuthSkillingMonoidBase KnuthSkillingAlgebra KnuthSkilling.Additive

variable {α : Type*} [KnuthSkillingMonoidBase α]

/-- The actual generated values, rather than arbitrary coordinates on their indices. -/
def iterateEmbedding (a : α) (ha : ident < a) : ℕ ↪o α where
  toFun := iterate_op a
  inj' := (iterate_op_strictMono a ha).injective
  map_rel_iff' := (iterate_op_strictMono a ha).le_iff_le

/-- The iterate embedding is an order isomorphism onto precisely its range. -/
noncomputable def iterateRangeIso (a : α) (ha : ident < a) :
    ℕ ≃o Set.range (iterate_op a) :=
  OrderIso.ofSurjective
    { toFun := fun n => ⟨iterate_op a n, ⟨n, rfl⟩⟩
      inj' := fun _ _ h => (iterate_op_strictMono a ha).injective (congrArg Subtype.val h)
      map_rel_iff' := (iterate_op_strictMono a ha).le_iff_le }
    (fun ⟨_, n, hn⟩ => ⟨n, Subtype.ext hn⟩)

/-- No commutativity premise is needed to combine powers of the same element. -/
theorem iterate_combination (a : α) (ha : ident < a) (m n : ℕ) :
    op ((iterateEmbedding a ha) m)
      ((iterateEmbedding a ha) n) = iterate_op a (m + n) := by
  exact iterate_op_add a m n

/-- Strictly positive anchors have strictly positive represented values. -/
theorem anchor_pos (r : NormalizedRepresentationResult α) {a : α} (ha : ident < a) :
    0 < r.Θ a := by
  simpa [r.ident_zero] using (r.strict_order_preserving ident a).mp ha

/-- Fix the remaining scale freedom without changing the supplied interpretation. -/
noncomputable def calibrateAt (r : NormalizedRepresentationResult α)
    (a : α) (ha : ident < a) : NormalizedRepresentationResult α where
  Θ x := r.Θ x / r.Θ a
  order_preserving x y := (r.order_preserving x y).trans
    (div_le_div_iff_of_pos_right (anchor_pos r ha)).symm
  additive x y := by rw [r.additive, add_div]
  ident_zero := by simp [r.ident_zero]

@[simp] theorem calibrateAt_anchor (r : NormalizedRepresentationResult α)
    (a : α) (ha : ident < a) : (calibrateAt r a ha).Θ a = 1 :=
  div_self (ne_of_gt (anchor_pos r ha))

/-- Calibrating two independent additive representations at the same anchor agrees. -/
theorem calibrateAt_independent (r₁ r₂ : NormalizedRepresentationResult α)
    (a : α) (ha : ident < a) (x : α) :
    (calibrateAt r₁ a ha).Θ x = (calibrateAt r₂ a ha).Θ x := by
  obtain ⟨c, hc, h⟩ := KnuthSkilling.Additive.Axioms.OpIsAddition.representation_unique_up_to_scale
    α r₁.Θ r₂.Θ r₁.order_preserving r₂.order_preserving r₁.ident_zero r₂.ident_zero
    r₁.additive r₂.additive a ha
  change r₁.Θ x / r₁.Θ a = r₂.Θ x / r₂.Θ a
  rw [h x, h a, mul_div_mul_left _ _ (ne_of_gt hc)]

/-- A shared nonzero calibration removes positive scale ambiguity. -/
theorem calibrated_unique (r₁ r₂ : NormalizedRepresentationResult α)
    (a : α) (ha : ident < a) (hanchor : r₁.Θ a = r₂.Θ a) : r₁.Θ = r₂.Θ := by
  funext x
  have h := calibrateAt_independent r₁ r₂ a ha x
  change r₁.Θ x / r₁.Θ a = r₂.Θ x / r₂.Θ a at h
  rw [← hanchor] at h
  exact (div_left_inj' (ne_of_gt (anchor_pos r₁ ha))).mp h

/-- Additive readouts observe the independently defined canonical iterates. -/
theorem observe_iterate (r : NormalizedRepresentationResult α) (a : α) (n : ℕ) :
    r.Θ (iterate_op a n) = n * r.Θ a :=
  KnuthSkilling.Additive.Axioms.OpIsAddition.iterate_op_is_smul
    α r.Θ r.ident_zero r.additive a n

/-- An injective additive representation forces the operation to commute. -/
theorem commutative_of_representation {β : Type*} [KSSemigroupBase β]
    (r : RepresentationResult β) (x y : β) : op x y = op y x := by
  let _ : HasRepresentationTheorem β :=
    { exists_representation := ⟨r.Θ, r.order_preserving, r.additive⟩ }
  exact KnuthSkilling.Additive.op_comm_of_hasRepresentationTheorem β x y

/-- A one-sided identity is two-sided in the strictly ordered semigroup. -/
theorem right_identity_of_left {β : Type*} [KSSemigroupBase β] (e : β)
    (he : ∀ x, op e x = x) (x : β) : op x e = x := by
  apply (op_strictMono_left x).injective
  change op (op x e) x = op x x
  rw [op_assoc, he]

/-- Strict cancellation makes a left identity unique. -/
theorem left_identity_unique {β : Type*} [KSSemigroupBase β] (e₁ e₂ : β)
    (h₁ : ∀ x, op e₁ x = x) (h₂ : ∀ x, op e₂ x = x) : e₁ = e₂ :=
  (op_strictMono_left e₁).injective ((h₁ e₁).trans (h₂ e₁).symm)

section Execution
variable {M : Type*} [Monoid M]

/-- Right multiplication interprets combination as execution from left to right. -/
def rightRegular : Mᵐᵒᵖ →* Function.End M where
  toFun x s := s * x.unop
  map_one' := by funext s; exact mul_one s
  map_mul' x y := by funext s; exact (mul_assoc s y.unop x.unop).symm

@[simp] theorem rightRegular_apply (x s : M) :
    rightRegular (MulOpposite.op x) s = s * x := rfl

/-- Evaluating the action at the identity recovers the acting element. -/
theorem rightRegular_injective : Function.Injective (rightRegular (M := M)) := by
  intro x y h
  apply MulOpposite.unop_injective
  have h' : (1 : M) * x.unop = 1 * y.unop := congrFun h 1
  simpa only [one_mul] using h'

/-- Equal observed sums need not mean equal executions: actions commute exactly when values do. -/
theorem rightRegular_commute_iff (x y : M) :
    rightRegular (MulOpposite.op x) * rightRegular (MulOpposite.op y) =
      rightRegular (MulOpposite.op y) * rightRegular (MulOpposite.op x) ↔ x * y = y * x := by
  rw [← map_mul, ← map_mul, rightRegular_injective.eq_iff]
  exact MulOpposite.unop_injective.eq_iff.symm.trans eq_comm
end Execution

end Mettapedia.ProbabilityTheory.OrderedCombination
