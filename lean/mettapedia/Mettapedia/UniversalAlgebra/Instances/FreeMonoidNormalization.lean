import Mathlib.Tactic
import Mettapedia.Logic.CertificateConservativeExtension
import Mettapedia.UniversalAlgebra.CertificateSubstitution
import Mettapedia.UniversalAlgebra.Instances.MonoidWord
import Mettapedia.UniversalAlgebra.FreeModel

/-!
# Canonical words for the free monoid equation system

Terms in the monoid signature have a canonical word obtained by deleting
units and variableWording multiplication.  This file proves that word equality is
exactly the equational consequence generated by associativity and the two
unit laws.  The result supplies a decidable normalizer independently of the
generic equational replay checker.

Simultaneous substitution acts on words by `List.flatMap`.  Conversion is
therefore preserved by substitution, while the converse deliberately fails:
a substitution may identify two previously distinct variables.
-/

set_option autoImplicit false

namespace Mettapedia.UniversalAlgebra.Monoid.FreeNormalization

open Mettapedia.Logic
open Mettapedia.UniversalAlgebra

/-! ## Canonical words -/

private def mulLeft : Fin (signature.arity Operation.mul) :=
  ⟨0, by decide⟩

private def mulRight : Fin (signature.arity Operation.mul) :=
  ⟨1, by decide⟩

/-- Reify a word as a right-associated monoid term. -/
def reify : List Nat → Term signature
  | [] => one
  | index :: rest => mul (.var index) (reify rest)

@[simp] theorem variableWord_reify : ∀ word : List Nat,
    Term.variableWord (reify word) = word
  | [] => by simp [reify]
  | index :: rest => by simp [reify, variableWord_reify rest]

/-- Multiplying two reified words is convertible to their concatenation. -/
theorem mulReify : ∀ first second : List Nat,
    EquationalConsequence equationSystem
      (mul (reify first) (reify second), reify (first ++ second))
  | [], second => by
      simpa [reify] using leftUnit (reify second)
  | index :: rest, second => by
      have reassociate :=
        associativity (.var index) (reify rest) (reify second)
      have recurse := mulCongr
        (EquationalConsequence.refl equationSystem (.var index))
        (mulReify rest second)
      exact EquationalConsequence.trans reassociate (by
        simpa [reify] using recurse)

/-! ## Exactness of normalization -/

/-- A raw multiplication node is the named binary constructor. -/
private theorem opMul_eq_mul
    (arguments : Fin 2 → Term signature) :
    Term.op Operation.mul arguments =
      mul (arguments mulLeft) (arguments mulRight) := by
  unfold mul
  congr 1
  funext position
  fin_cases position <;> rfl

/-- A nullary unit node is the named unit constructor. -/
private theorem opOne_eq_one
    (arguments : Fin 0 → Term signature) :
    Term.op Operation.one arguments = one := by
  unfold one
  congr 1
  funext position
  exact Fin.elim0 position

/-- Every monoid term converts to the reification of its canonical word. -/
theorem normalizes : ∀ term : Term signature,
    EquationalConsequence equationSystem (term, reify (Term.variableWord term))
  | .var index => by
      simpa [Term.variableWord, reify] using
        (EquationalConsequence.symm (rightUnit (.var index)))
  | .op .one arguments => by
      rw [opOne_eq_one arguments]
      exact EquationalConsequence.refl equationSystem one
  | .op .mul arguments => by
      rw [opMul_eq_mul arguments]
      have components := mulCongr
        (normalizes (arguments mulLeft))
        (normalizes (arguments mulRight))
      exact EquationalConsequence.trans components (by
        simpa only [Term.variableWord_mul] using
          mulReify
            (Term.variableWord (arguments mulLeft))
            (Term.variableWord (arguments mulRight)))

/-- Equational consequence preserves canonical words. -/
theorem variableWord_eq_of_consequence {left right : Term signature}
    (derivation : EquationalConsequence equationSystem (left, right)) :
    Term.variableWord left = Term.variableWord right := by
  have sound := consequence_holds_in_monoid derivation (FreeMonoid Nat) FreeMonoid.of
  simpa [Term.toList_evaluate_freeMonoid] using congrArg FreeMonoid.toList sound

/-- Canonical word equality is complete for the monoid equation system. -/
theorem consequence_of_variableWord_eq {left right : Term signature}
    (wordsEqual : Term.variableWord left = Term.variableWord right) :
    EquationalConsequence equationSystem (left, right) := by
  have backwards := (normalizes right).symm
  rw [← wordsEqual] at backwards
  exact (normalizes left).trans backwards

/-- The normalization theorem in exact iff form. -/
theorem consequence_iff_variableWord_eq {left right : Term signature} :
    EquationalConsequence equationSystem (left, right) ↔
      Term.variableWord left = Term.variableWord right :=
  ⟨variableWord_eq_of_consequence, consequence_of_variableWord_eq⟩

/-- The abstract equational quotient is the concrete free monoid on variables.
Both maps preserve operations; the inverse reifies the supplied ordered word. -/
noncomputable def quotientWordIso :
    Model.Iso (TermQuotient.model equationSystem) (mathlibModel (FreeMonoid Nat)) where
  hom := TermQuotient.lift equationSystem (mathlibModel (FreeMonoid Nat))
    (mathlibModel_satisfies _) FreeMonoid.of
  inv :=
    { toFun := fun word => TermQuotient.classOf equationSystem (reify word.toList)
      map_operation := by
        intro operation arguments
        rw [TermQuotient.model_interpret_classOf]
        apply (TermQuotient.classOf_eq_iff equationSystem _ _).mpr
        apply consequence_of_variableWord_eq
        cases operation <;> simp [mathlibModel, Term.variableWord] }
  hom_inv_id value := by
    induction value using Quotient.inductionOn with
    | _ term =>
        change TermQuotient.classOf equationSystem
            (reify ((term.evaluate (mathlibModel (FreeMonoid Nat)) FreeMonoid.of).toList)) =
          TermQuotient.classOf equationSystem term
        simp only [Term.toList_evaluate_freeMonoid, FreeMonoid.toList_of, List.flatMap_singleton']
        exact (TermQuotient.classOf_eq_iff equationSystem _ _).mpr (normalizes term).symm
  inv_hom_id word := by
    change (reify word.toList).evaluate (mathlibModel (FreeMonoid Nat)) FreeMonoid.of = word
    apply FreeMonoid.toList.injective
    simp only [Term.toList_evaluate_freeMonoid, FreeMonoid.toList_of,
      List.flatMap_singleton', variableWord_reify]

/-- Decidable equality of canonical words decides monoid consequence. -/
def decideConversion (left right : Term signature) : Bool :=
  decide (Term.variableWord left = Term.variableWord right)

theorem decideConversion_eq_true_iff {left right : Term signature} :
    decideConversion left right = true ↔
      EquationalConsequence equationSystem (left, right) := by
  simp [decideConversion, consequence_iff_variableWord_eq]

/-! ## Explicit replay certificates -/

abbrev monoidInterface := equationalRuleInterface equationSystem

/-- A concrete one-node certificate for the right-unit normalization canary. -/
def rightUnitXCertificate : AcceptedCertificate monoidInterface
    (mul x one, x) := by
  exact AcceptedCertificate.node monoidInterface
    (.systemInstance
      (⟨2, by simp [equationSystem]⟩ : Fin equationSystem.equations.length)
      Term.var)
    (mul x one, x) Fin.elim0 (by
      simp [monoidInterface, equationalRuleInterface,
        EquationalRuleWitness.isInstance, equationSystem,
        Term.subst_variables])
    (fun position => Fin.elim0 position)

@[simp] theorem rightUnitXCertificate_nodeCount :
    rightUnitXCertificate.nodeCount = 1 := rfl

/-- Every equational consequence has a replayable certificate.  The result is
propositional because the generic completeness theorem intentionally does not
select one certificate among many. -/
theorem nonemptyAcceptedOfConsequence {equation : Equation signature}
    (derivation : EquationalConsequence equationSystem equation) :
    Nonempty
      (AcceptedCertificate (equationalRuleInterface equationSystem) equation) := by
  obtain ⟨certificate, accepted, concludes⟩ :=
    Derives.exists_derivation (equationalRuleInterface equationSystem) derivation
  exact ⟨⟨certificate, accepted, concludes⟩⟩

/-- Every accepted certificate denotes an equational consequence. -/
theorem consequenceOfAccepted {equation : Equation signature}
    (certificate :
      AcceptedCertificate (equationalRuleInterface equationSystem) equation) :
    EquationalConsequence equationSystem equation :=
  certificate.concludes ▸ Derivation.valid_sound
    (equationalRuleInterface equationSystem) certificate.certificate certificate.accepted

/-- Accepted replay certificates exist exactly for convertible monoid terms. -/
theorem nonemptyAccepted_iff {left right : Term signature} :
    Nonempty (AcceptedCertificate
      (equationalRuleInterface equationSystem) (left, right)) ↔
      EquationalConsequence equationSystem (left, right) :=
  ⟨fun ⟨certificate⟩ => consequenceOfAccepted certificate, nonemptyAcceptedOfConsequence⟩

/-! ## Substitution preserves but need not reflect conversion -/

theorem variableWord_eq_subst_of_variableWord_eq
    (substitution : Nat → Term signature) {left right : Term signature}
    (wordsEqual : Term.variableWord left = Term.variableWord right) :
    Term.variableWord (left.subst substitution) = Term.variableWord (right.subst substitution) := by
  rw [Term.variableWord_subst, Term.variableWord_subst, wordsEqual]

theorem consequence_subst {left right : Term signature}
    (derivation : EquationalConsequence equationSystem (left, right))
    (substitution : Nat → Term signature) :
    EquationalConsequence equationSystem
      (left.subst substitution, right.subst substitution) :=
  EquationalConsequence.subst derivation substitution

/-- Positive substitution control. -/
theorem rightUnit_substitution_control (substitution : Nat → Term signature) :
    decideConversion
      ((mul x one).subst substitution) (x.subst substitution) = true :=
  decideConversion_eq_true_iff.mpr
    (consequence_subst (rightUnit x) substitution)

/-- A substitution can identify previously distinct variables, so conversion
reflection under arbitrary substitution is false. -/
theorem substitution_not_reflecting :
    ∃ substitution : Nat → Term signature,
      decideConversion
          ((Term.var 0).subst substitution)
          ((Term.var 1).subst substitution) = true ∧
        decideConversion (Term.var 0) (Term.var 1) = false := by
  refine ⟨fun _index => one, ?_, ?_⟩
  · simp [decideConversion]
  · simp [decideConversion]

end Mettapedia.UniversalAlgebra.Monoid.FreeNormalization
