import Mettapedia.Logic.Derivation
import Mettapedia.UniversalAlgebra.EquationSystem
import Mettapedia.UniversalAlgebra.BoundedTerm

/-!
# Equational logic generated by an equation system

The rule predicate is kept separate from the input `EquationSystem`.  Its least
closure is `EquationalConsequence`.
-/

set_option autoImplicit false

namespace Mettapedia.UniversalAlgebra

open Mettapedia.Logic

universe u v

variable {S : Signature.{u}}

/-- Standard equational logic: substitution instances of system equations,
reflexivity, symmetry, transitivity, and operation congruence. -/
inductive EquationalRule (system : EquationSystem S) :
    List (Equation S) → Equation S → Prop where
  | systemInstance {equation : Equation S} (member : equation ∈ system)
      (substitution : Nat → Term S) :
      EquationalRule system []
        (equation.1.subst substitution, equation.2.subst substitution)
  | refl (term : Term S) : EquationalRule system [] (term, term)
  | symm (left right : Term S) :
      EquationalRule system [(left, right)] (right, left)
  | trans (left middle right : Term S) :
      EquationalRule system [(left, middle), (middle, right)] (left, right)
  | congruence (operation : S.Operation)
      (left right : Fin (S.arity operation) → Term S) :
      EquationalRule system
        (List.ofFn fun i => (left i, right i))
        (.op operation left, .op operation right)

/-- The deductive consequence relation generated by an equation system. -/
def EquationalConsequence (system : EquationSystem S)
    (equation : Equation S) : Prop :=
  Derives (EquationalRule system) equation

namespace EquationalConsequence

/-- Induction on generated consequence, with its five mathematical rule cases.
Premise-list bookkeeping is confined to this eliminator. -/
@[elab_as_elim] theorem induction_on {system : EquationSystem S} {equation : Equation S}
    (derivation : EquationalConsequence system equation) {P : Equation S → Prop}
    (of_instance : ∀ {equation}, equation ∈ system → ∀ substitution,
      P (equation.1.subst substitution, equation.2.subst substitution))
    (of_refl : ∀ term, P (term, term))
    (of_symm : ∀ left right, P (left, right) → P (right, left))
    (of_trans : ∀ left middle right,
      P (left, middle) → P (middle, right) → P (left, right))
    (of_operation : ∀ symbol left right,
      (∀ position, P (left position, right position)) →
        P (.op symbol left, .op symbol right)) : P equation := by
  apply Derives.least P ?_ derivation
  intro premises conclusion rule ih
  cases rule with
  | systemInstance member substitution => exact of_instance member substitution
  | refl term => exact of_refl term
  | symm left right => exact of_symm left right (ih _ (by simp))
  | trans left middle right =>
      exact of_trans left middle right (ih _ (by simp)) (ih _ (by simp))
  | congruence symbol left right =>
      exact of_operation symbol left right (fun position =>
        ih _ (List.mem_ofFn.mpr ⟨position, rfl⟩))

/-- Reflexivity as a generated consequence. -/
theorem refl (system : EquationSystem S) (term : Term S) :
    EquationalConsequence system (term, term) :=
  Derives.node [] _ (EquationalRule.refl term)
    (by intro premise member; cases member)

/-- Symmetry as a generated consequence. -/
theorem symm {system : EquationSystem S} {left right : Term S}
    (derivation : EquationalConsequence system (left, right)) :
    EquationalConsequence system (right, left) :=
  Derives.node [(left, right)] _ (EquationalRule.symm left right)
    (by simpa only [List.forall_mem_singleton, EquationalConsequence] using derivation)

/-- Transitivity as a generated consequence. -/
theorem trans {system : EquationSystem S} {first second third : Term S}
    (firstSecond : EquationalConsequence system (first, second))
    (secondThird : EquationalConsequence system (second, third)) :
    EquationalConsequence system (first, third) :=
  Derives.node [(first, second), (second, third)] _
    (EquationalRule.trans first second third)
    (by simpa [EquationalConsequence] using
      And.intro firstSecond secondThird)

/-- Operation congruence from pointwise generated consequences. -/
theorem operation {system : EquationSystem S} (symbol : S.Operation)
    (left right : Fin (S.arity symbol) → Term S)
    (components : ∀ position,
      EquationalConsequence system (left position, right position)) :
    EquationalConsequence system (.op symbol left, .op symbol right) :=
  Derives.node (List.ofFn fun position => (left position, right position)) _
    (EquationalRule.congruence symbol left right)
    (by simpa only [List.forall_mem_ofFn_iff, EquationalConsequence] using components)

/-- Substitution into a common term respects pointwise equational consequence. -/
theorem substitution_congr {system : EquationSystem S} (context : Term S)
    (left right : Nat → Term S)
    (components : ∀ index,
      EquationalConsequence system (left index, right index)) :
    EquationalConsequence system (context.subst left, context.subst right) := by
  induction context with
  | var index => exact components index
  | op symbol arguments ih => exact operation symbol _ _ ih

/-- Substitution is admissible for generated equational consequence, not only
for the input equation occurrences. -/
theorem subst {system : EquationSystem S} {equation : Equation S}
    (derivation : EquationalConsequence system equation)
    (substitution : Nat → Term S) :
    EquationalConsequence system (equation.subst substitution) := by
  refine derivation.induction_on
    (P := fun equation => EquationalConsequence system (equation.subst substitution))
    ?_ ?_ ?_ ?_ ?_
  · intro equation member instanceSubstitution
    have composedDerivation :=
      Derives.node [] _
        (EquationalRule.systemInstance member
          (fun variableIndex =>
            (instanceSubstitution variableIndex).subst substitution))
        (by intro premise premiseMem; cases premiseMem)
    simpa only [EquationalConsequence, Equation.subst, Term.subst_subst]
      using composedDerivation
  · intro term
    exact refl system (term.subst substitution)
  · intro _ _ derived
    exact symm derived
  · intro _ _ _ first second
    exact trans first second
  · intro operation left right components
    exact EquationalConsequence.operation operation _ _ components

/-- Every listed equation is a consequence of its own equation system. -/
theorem of_mem {system : EquationSystem S} {equation : Equation S}
    (member : equation ∈ system) :
    EquationalConsequence system equation := by
  have instanceDerivation : EquationalConsequence system
      (equation.subst Term.var) :=
    Derives.node [] _ (EquationalRule.systemInstance member Term.var)
      (by intro premise premiseMem; cases premiseMem)
  simpa only [Equation.subst, Term.subst_variables] using instanceDerivation

/-- If every input equation of `target` is already derivable from `source`,
then every consequence of `target` is a consequence of `source`. -/
theorem translate_axioms {source target : EquationSystem S}
    (axiomDerivable : ∀ equation, equation ∈ target →
      EquationalConsequence source equation)
    {conclusion : Equation S} :
    EquationalConsequence target conclusion →
      EquationalConsequence source conclusion := by
  intro derivation
  exact derivation.induction_on
    (fun member substitution => subst (axiomDerivable _ member) substitution)
    (refl source) (fun _ _ => symm) (fun _ _ _ => trans) operation


end EquationalConsequence

/-- Each equational rule preserves truth in every satisfying model. -/
theorem EquationalRule.holdsInModel {system : EquationSystem S}
    {premises : List (Equation S)} {conclusion : Equation S}
    (rule : EquationalRule system premises conclusion)
    {Carrier : Type v} (model : Model S Carrier) (satisfies : model.Satisfies system)
    (premiseHolds : ∀ premise ∈ premises, premise.Holds model) :
    conclusion.Holds model := by
  cases rule with
  | systemInstance member substitution =>
      intro valuation
      rw [Term.evaluate_subst, Term.evaluate_subst]
      exact satisfies _ member _
  | refl term =>
      intro valuation
      rfl
  | symm left right =>
      intro valuation
      exact (premiseHolds (left, right) (by simp) valuation).symm
  | trans left middle right =>
      intro valuation
      exact (premiseHolds (left, middle) (by simp) valuation).trans
        (premiseHolds (middle, right) (by simp) valuation)
  | congruence operation left right =>
      intro valuation
      simp only [Term.evaluate]
      refine congrArg (model.interpret operation) (funext fun position => ?_)
      exact premiseHolds (left position, right position) (by
        rw [List.mem_ofFn]
        exact ⟨position, rfl⟩) valuation

/-- Generated consequence is sound independently of the carrier universe. -/
theorem EquationalConsequence.holdsInModel
    {system : EquationSystem S} {equation : Equation S}
    (derivation : EquationalConsequence system equation)
    {Carrier : Type v} (model : Model S Carrier)
    (satisfies : model.Satisfies system) : equation.Holds model :=
  Derives.least (fun equation => equation.Holds model)
    (fun _ _ rule premises => rule.holdsInModel model satisfies premises) derivation

/-- Bounded consequences hold under finite valuations, including empty carriers. -/
theorem EquationalConsequence.evaluateBelow_eq
    {system : EquationSystem S} {left right : Term S}
    (derivation : EquationalConsequence system (left, right))
    {Carrier : Type v} (model : Model S Carrier) (satisfies : model.Satisfies system)
    {bound : Nat} (valuation : Fin bound → Carrier)
    (leftBounded : left.VariablesBelow bound) (rightBounded : right.VariablesBelow bound) :
    left.evaluateBelow model valuation leftBounded =
      right.evaluateBelow model valuation rightBounded :=
  Term.evaluateBelow_eq_of_evaluate_eq model model
    (derivation.holdsInModel model satisfies) valuation leftBounded rightBounded

/-- Every equational rule preserves truth in all models of the system. -/
theorem equationalRule_sound (system : EquationSystem S) :
    ∀ premises conclusion, EquationalRule system premises conclusion →
      (∀ premise ∈ premises, Entails system premise) →
      Entails system conclusion := by
  intro premises conclusion rule ih Carrier model satisfies
  exact rule.holdsInModel model satisfies
    (fun premise member => ih premise member Carrier model satisfies)

/-- Every generated equational consequence is valid in every model. -/
theorem equationalConsequence_sound {system : EquationSystem S}
    {equation : Equation S} (derivation : EquationalConsequence system equation) :
    Entails system equation :=
  Derives.least (Entails system) (equationalRule_sound system) derivation

/-- Inclusion of equation occurrences transports generated consequence. -/
theorem EquationalConsequence.mono {system system' : EquationSystem S}
    (inclusion : ∀ equation, equation ∈ system → equation ∈ system')
    {equation : Equation S} :
    EquationalConsequence system equation →
      EquationalConsequence system' equation := by
  apply Derives.mono
  intro premises conclusion rule
  cases rule with
  | systemInstance member substitution =>
      exact EquationalRule.systemInstance (inclusion _ member) substitution
  | refl term => exact EquationalRule.refl term
  | symm left right => exact EquationalRule.symm left right
  | trans left middle right => exact EquationalRule.trans left middle right
  | congruence operation left right =>
      exact EquationalRule.congruence operation left right

namespace EquationSystem

/-- Two equation systems have the same generated equational consequences. -/
def SameConsequences (left right : EquationSystem S) : Prop :=
  ∀ equation, EquationalConsequence left equation ↔
    EquationalConsequence right equation

end EquationSystem

end Mettapedia.UniversalAlgebra
