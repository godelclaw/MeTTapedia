import Mettapedia.Algorithms.Compression.LayeredSource

/-! Byte-level LM1 fixtures and finite positive/negative dependency controls.
The fixed wire fixture was generated by the independent framing implementation.
It tests transport; semantic source admission is a separate contract. -/

set_option autoImplicit false

namespace Mettapedia.Examples.Compression.LayeredSourceControls

open Algorithms.Compression Algorithms.Compression.LayeredSource
open Algorithms.WellFoundedServices

private def first : Layer := ⟨octets [76, 67, 49], octets [97]⟩
private def second : Layer := ⟨octets [76, 67, 50], octets [98]⟩
private def fixture : Payload :=
  ⟨[first, second], .node literalTag [.leaf symbolKind, .leaf (octets [98])]⟩

private def wire : KolmogorovComplexity.BinString := octets [
  215, 250, 5, 52, 148, 51, 31, 176, 152, 154, 99, 255, 179, 141, 126, 128,
  31, 64, 95, 254, 190, 53, 254, 195, 83, 236, 38, 38, 152, 131, 254, 224,
  107, 244, 0, 191, 236, 134, 175, 245, 134, 191, 64, 15, 160, 43, 251, 198,
  175, 216, 106, 125, 132, 196, 51, 16, 126, 131, 83, 208, 194, 0, 7, 250,
  195, 95, 160, 7, 208, 21, 253, 227, 87, 236, 53, 62, 194, 98, 25, 144,
  63, 65, 169, 232, 98, 0, 0, 0, 127, 180, 53, 250, 0, 125, 0, 255, 233,
  13, 95, 210, 53, 63, 96, 166, 242, 218, 196, 222, 216, 63, 65, 169, 232,
  98, 0, 0, 0]

set_option maxRecDepth 4096 in
set_option maxHeartbeats 1000000 in
theorem independent_wire_fixture : write fixture = wire := by
  simp only [write, fixture, first, second, toTree, layerTree,
    FramedTree.encode, List.map_cons, List.map_nil]
  decide +kernel

theorem independent_wire_decodes : read wire = some fixture := by
  rw [← independent_wire_fixture]
  exact read_write fixture

set_option maxRecDepth 4096 in
set_option maxHeartbeats 1000000 in
theorem descriptors_are_charged : byteCost fixture = 117 ∧
    byteCost ⟨[], fixture.source⟩ = 67 := by
  simp only [byteCost, fixture, first, second, toTree, layerTree,
    FramedTree.encode, List.map_cons, List.map_nil]
  decide +kernel

theorem descriptor_order_changes_the_wire :
    write fixture ≠ write ⟨[second, first], fixture.source⟩ := by
  intro same
  have equal := congrArg Payload.layers (write_injective same)
  have different : [first, second] ≠ [second, first] := by decide
  exact different equal

theorem extra_layer_field_is_rejected :
    (parseLayer (.node layerTag [.leaf first.codec, .leaf first.name, .leaf []])).isNone = true := by decide

theorem extra_stack_field_is_rejected :
    (fromTree (.node stackTag [.leaf version, .node [] [], fixture.source, .leaf []])).isNone = true := by decide

theorem wrong_stack_version_is_rejected :
    (fromTree (.node stackTag [.leaf (octets [76, 77, 50]), .node [] [], fixture.source])).isNone = true := by decide

theorem wrong_vector_marker_is_rejected :
    (fromTree (.node stackTag [.leaf version, .node [true] [], fixture.source])).isNone = true := by decide

theorem symbol_reference_is_found : mentions (octets [98]) fixture.source = true := by decide

theorem string_is_not_a_symbol_reference :
    mentions (octets [98]) (.node literalTag [.leaf (octets [83, 116, 114, 105, 110, 103]),
      .leaf (octets [98])]) = false := by decide

theorem opaque_leaf_is_not_a_reference : mentions (octets [98]) (.leaf (octets [98])) = false := rfl

private def chain : Catalogue Nat := ⟨[0, 1, 2, 3], fun name => match name with
  | 0 => [2]
  | 1 => [2]
  | 2 => [3]
  | _ => []⟩

private def cycle : Catalogue Nat := ⟨[0, 1], fun name => if name = 0 then [1] else [0]⟩
private def selfCycle : Catalogue Nat := ⟨[0], fun _ => [0]⟩

theorem dependency_waves_are_not_source_order :
    rounds chain 4 ⟨[], chain.items⟩ = some (.waves [[3], [2], [0, 1]]) := by decide

theorem a_completed_final_wave_needs_no_extra_budget :
    rounds chain 3 ⟨[], chain.items⟩ = some (.waves [[3], [2], [0, 1]]) := by decide

theorem unfinished_dag_is_not_declared_cyclic :
    rounds chain 2 ⟨[], chain.items⟩ = none := by decide

theorem two_cycle_is_blocked : rounds cycle 2 ⟨[], cycle.items⟩ = some (.blocked [0, 1]) := by decide

theorem self_cycle_is_blocked : rounds selfCycle 1 ⟨[], selfCycle.items⟩ = some (.blocked [0]) := by decide

theorem zero_budget_cannot_certify_a_cycle : rounds cycle 0 ⟨[], cycle.items⟩ = none := by decide

theorem checked_chain_has_no_cycle : ∀ name, ¬ Relation.TransGen chain.Uses name name :=
  checked_waves_acyclic chain (by decide) [[3], [2], [0, 1]] dependency_waves_are_not_source_order

private def undo (layer : Layer) (source : Nat) : Option Nat :=
  if layer = first then if source = 2 then some 1 else none
  else if layer = second then if source = 1 then some 0 else none
  else none

theorem decoder_order_is_observable :
    expand undo [first, second] 2 = some 0 ∧ expand undo [second, first] 2 = none := by decide

theorem intermediate_failure_is_not_a_partial_publication :
    expand undo [first, first, second] 2 = none := by decide

