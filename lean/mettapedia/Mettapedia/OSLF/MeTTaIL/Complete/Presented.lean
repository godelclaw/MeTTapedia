import Mettapedia.OSLF.MeTTaIL.Complete.Normalized
import Mettapedia.OSLF.MeTTaIL.CanonicalBags

/-!
# The presented GSLT: steps modulo equality in the model

A metavariable denotes an element of the theory's model, and a rule fires on an equivalence
class. Equality in the model is generated by the plan's equations and by its declared collection
and scope-extrusion laws, in every context (`CanonicalBags.StandardStep`): permutation of an
unordered collection, flattening of a nested collection of a flattening kind, removal of a
declared unit, and declared scope extrusion.

`gslt` is the plan's GSLT modulo that equality. Its steps are presentation invariant by
construction (`presentation_invariant`): equal presentations have the same steps, up to equality.

The normalized search, which takes a step and then the standard form of the declared laws,
takes presented steps (`step_of_normalized`), for every plan whose extrusions are over unordered
kinds that flatten: the standard form is sound (`CanonicalBags.to_standardForm`). Unlike
`Normalized.NormalizedStep`, this needs no restriction to languages without declared laws.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.MeTTaIL.Complete.Presented

open _root_.Mettapedia.OSLF.MeTTaIL.Syntax GeneralExecutionAdmission CanonicalBags

variable (plan : Plan) (bound : List TypeExpr) (expected : TypeExpr)

/-- One generating equality of the model: an equation of the plan, or a standard move of its
declared collection and scope-extrusion laws. -/
def ModelEquation (source target : Pattern) : Prop :=
  GeneralOccurrenceSemantics.Equation plan bound expected source target ∨
    StandardStep (Normalized.laws plan) (Normalized.extrusions plan) source target

/-- **The presented GSLT**: the plan's steps modulo equality in the model. -/
def gslt : Mettapedia.GSLT.GSLT :=
  Mettapedia.OSLF.Framework.FiniteEquationCoverage.moduloGSLT (ModelEquation plan bound expected)
    (GeneralOccurrenceSemantics.Primitive plan bound expected) GeneralRuleJobs.Receipt.target

/-- Equality in the model. -/
abbrev ModelEquiv (left right : Pattern) : Prop := Relation.EqvGen (ModelEquation plan bound expected) left right

/-- **Presentation invariance**: equal presentations have the same steps, up to equality. -/
theorem presentation_invariant {source source' target : Pattern}
    (equal : ModelEquiv plan bound expected source source')
    (stepped : (gslt plan bound expected).Step source target) :
    ∃ target', (gslt plan bound expected).Step source' target' ∧ ModelEquiv plan bound expected target target' :=
  (gslt plan bound expected).rewrites_resp_left equal stepped

/-- Steps are closed under equality of their results. -/
theorem step_resp_right {source target target' : Pattern}
    (stepped : (gslt plan bound expected).Step source target) (equal : ModelEquiv plan bound expected target target') :
    (gslt plan bound expected).Step source target' :=
  (gslt plan bound expected).rewrites_resp_right stepped equal

private theorem modelEquiv_of_equations {left right : Pattern}
    (related : Relation.EqvGen (GeneralOccurrenceSemantics.Equation plan bound expected) left right) :
    ModelEquiv plan bound expected left right := by
  induction related with
  | rel _ _ equation => exact .rel _ _ (.inl equation)
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

theorem modelEquiv_of_standard {left right : Pattern}
    (related : Relation.EqvGen (StandardStep (Normalized.laws plan) (Normalized.extrusions plan)) left right) :
    ModelEquiv plan bound expected left right := by
  induction related with
  | rel _ _ step => exact .rel _ _ (.inr step)
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

/-- Every step modulo the plan's equations is a presented step. -/
theorem step_of_gslt {source target : Pattern}
    (stepped : (GeneralOccurrenceSemantics.gslt plan bound expected).Step source target) :
    (gslt plan bound expected).Step source target := by
  obtain ⟨representative, receipt, before, valid, after⟩ := stepped
  exact ⟨representative, receipt, modelEquiv_of_equations plan bound expected before, valid,
    modelEquiv_of_equations plan bound expected after⟩

/-- **Every state is equal in the model to its standard form**, for a plan whose extrusions are
over unordered kinds that flatten. -/
theorem standard_equiv (flatten : ExtrusionsFlatten (Normalized.laws plan) (Normalized.extrusions plan))
    (pattern : Pattern) : ModelEquiv plan bound expected pattern (Normalized.standard plan pattern) :=
  modelEquiv_of_standard plan bound expected (to_standardForm _ _ flatten pattern)

/-- **Every state is equal in the model to its canonical form.** -/
theorem canon_equiv (pattern : Pattern) : ModelEquiv plan bound expected pattern (canon pattern) :=
  modelEquiv_of_standard plan bound expected
    (Relation.EqvGen.mono (fun _ _ step => .law (step.lawStep _)) _ _ (to_canon pattern))

/-- **Every state is equal in the model to its committed form**, for a plan whose extrusions are
over unordered kinds that flatten, and a commit modulo the declared laws alone. -/
theorem commit_equiv (flatten : ExtrusionsFlatten (Normalized.laws plan) (Normalized.extrusions plan))
    (mode : Normalized.Commit) (plain : mode.Plain) (pattern : Pattern) :
    ModelEquiv plan bound expected pattern (Normalized.commit plan mode pattern) := by
  cases mode with
  | standard => exact standard_equiv plan bound expected flatten pattern
  | canonical =>
    exact .trans _ _ _ (standard_equiv plan bound expected flatten pattern)
      (canon_equiv plan bound expected (Normalized.standard plan pattern))
  | reflective _ => exact plain.elim
  | model _ => exact plain.elim

/-- **The normalized search takes presented steps.** -/
theorem step_of_normalized (flatten : ExtrusionsFlatten (Normalized.laws plan) (Normalized.extrusions plan))
    {mode : Normalized.Commit} (plain : mode.Plain) {source target : Pattern}
    (stepped : Normalized.NormalizedStep plan bound expected mode source target) :
    (gslt plan bound expected).Step source target := by
  obtain ⟨reached, step, rfl⟩ := stepped
  exact step_resp_right plan bound expected (step_of_gslt plan bound expected step)
    (commit_equiv plan bound expected flatten mode plain reached)

/-- **Every normalized run is a chain of presented steps**, starting at the source. -/
theorem run_chain (flatten : ExtrusionsFlatten (Normalized.laws plan) (Normalized.extrusions plan))
    (source : Pattern) (ticks quantum : Nat) (mode : Normalized.Commit := .standard)
    (plain : mode.Plain := by trivial) :
    let machine := Mettapedia.Machines.ResumableSearchRunner.Machine.advance (Normalized.search plan bound expected mode)
      ticks quantum
      (Mettapedia.Machines.ResumableSearchRunner.Machine.begin (Normalized.search plan bound expected mode) source)
    machine.states.reverse.head? = some source ∧
      machine.states.reverse.IsChain (gslt plan bound expected).Step := by
  obtain ⟨starts, chained⟩ := Normalized.run_chain plan bound expected source ticks quantum mode
  exact ⟨starts, chained.imp (fun _ _ step => step_of_normalized plan bound expected flatten plain step)⟩

end Mettapedia.OSLF.MeTTaIL.Complete.Presented
