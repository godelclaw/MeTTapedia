open Mettapedia.Languages.ProcessCalculi.RhoCalculus.Reduction (Reduces)
open Mettapedia.GSLT.LanguageDef.GeneralTypedOccurrence GeneralTypedSites DerivedPresentationSyntax

/-! ## Congruence helpers -/

theorem forall₂_sc_middle {before after : List Pattern} {x y : Pattern} (related : StructuralCongruence x y) :
    List.Forall₂ StructuralCongruence (before ++ x :: after) (before ++ y :: after) :=
  List.rel_append (List.forall₂_same.mpr fun item _ => .refl item)
    (.cons related (List.forall₂_same.mpr fun item _ => .refl item))

theorem sc_apply {label : String} {items items' : List Pattern}
    (pointwise : List.Forall₂ StructuralCongruence items items') :
    StructuralCongruence (.apply label items) (.apply label items') :=
  .apply_cong label items items' (List.forall₂_iff_get.mp pointwise).1 (List.forall₂_iff_get.mp pointwise).2

theorem sc_collection {kind : CollType} {rest : Option String} {items items' : List Pattern}
    (pointwise : List.Forall₂ StructuralCongruence items items') :
    StructuralCongruence (.collection kind items rest) (.collection kind items' rest) :=
  .collection_general_cong kind items items' rest (List.forall₂_iff_get.mp pointwise).1
    (List.forall₂_iff_get.mp pointwise).2

/-- `{PZero, ys...} ≡ {ys...}`. -/
theorem sc_drop_zero (items : List Pattern) :
    StructuralCongruence (.collection .hashBag (.apply "PZero" [] :: items) none) (.collection .hashBag items none) :=
  .trans _ _ _ (.symm _ _ (.par_flatten [.apply "PZero" []] items)) (.par_nil_left _)

/-! ## Terms without sets

Rho's processes hold no set-kinded collection (`rhoProcWellSorted_hashSetFree`), so the model's set law
never applies to them, and every other move keeps them so. -/

theorem hashSetFreeList_iff : ∀ {items : List Pattern}, HashSetFreeList items ↔ ∀ item ∈ items, HashSetFree item
  | [] => by simp [HashSetFreeList]
  | item :: items => by simp [HashSetFreeList, hashSetFreeList_iff]

theorem hashSetFree_collection {kind : CollType} {elements : List Pattern} {rest : Option String} :
    HashSetFree (.collection kind elements rest) ↔ kind ≠ .hashSet ∧ ∀ element ∈ elements, HashSetFree element := by
  cases kind <;> simp [HashSetFree, hashSetFreeList_iff]

theorem hashSetFree_apply {label : String} {arguments : List Pattern} :
    HashSetFree (.apply label arguments) ↔ ∀ argument ∈ arguments, HashSetFree argument := by
  simp [HashSetFree, hashSetFreeList_iff]

/-- Every parallel-law move keeps a term without sets so, and makes none. -/
theorem _root_.Mettapedia.OSLF.MeTTaIL.CanonicalBags.LawStep.hashSetFree_iff {laws : List CollectionLaws.Laws}
    {left right : Pattern} (step : LawStep laws left right) :
    HashSetFree left ↔ HashSetFree right := by
  induction step with
  | permute _ permutation =>
    rw [hashSetFree_collection, hashSetFree_collection]
    exact and_congr Iff.rfl ⟨fun each x member => each x (permutation.symm.subset member),
      fun each x member => each x (permutation.subset member)⟩
  | members _ => simp [hashSetFree_collection]
  | flatten _ =>
    simp only [hashSetFree_collection, List.forall_mem_append, List.forall_mem_cons]
    tauto
  | unit _ _ =>
    simp only [hashSetFree_collection, List.forall_mem_append, List.forall_mem_cons, HashSetFree, HashSetFreeList]
    tauto
  | apply _ ih => simp only [hashSetFree_apply, List.forall_mem_append, List.forall_mem_cons, ih]
  | lambda _ ih => simpa [HashSetFree] using ih
  | multiLambda _ ih => simpa [HashSetFree] using ih
  | substBody _ ih => simp [HashSetFree, ih]
  | substReplacement _ ih => simp [HashSetFree, ih]
  | element _ ih => simp only [hashSetFree_collection, List.forall_mem_append, List.forall_mem_cons, ih]

/-- Every use of the name equation keeps a term without sets so, and makes none. -/
theorem _root_.Mettapedia.OSLF.MeTTaIL.QuoteDrop.QuoteDropStep.hashSetFree_iff {declaration : ReflectivePresentationDecl}
    {left right : Pattern} (step : QuoteDropStep declaration left right) :
    HashSetFree left ↔ HashSetFree right := by
  induction step with
  | collapse name => simp [HashSetFree, HashSetFreeList]
  | apply _ ih => simp only [hashSetFree_apply, List.forall_mem_append, List.forall_mem_cons, ih]
  | lambda _ ih => simpa [HashSetFree] using ih
  | multiLambda _ ih => simpa [HashSetFree] using ih
  | substBody _ ih => simp [HashSetFree, ih]
  | substReplacement _ ih => simp [HashSetFree, ih]
  | element _ ih => simp only [hashSetFree_collection, List.forall_mem_append, List.forall_mem_cons, ih]

/-! ## The generating equalities -/

/-- **Every parallel-law move of an object term without sets is a structural congruence.** -/
theorem lawStep_sc {left right : Pattern} (step : LawStep (Normalized.laws GeneralRho.Standard.plan) left right) :
    isObjectPattern left = true → HashSetFree left → StructuralCongruence left right := by
  induction step with
  | @permute kind elements permuted rest unordered permutation =>
    intro object pure
    have restNone : rest = none := by
      cases rest with
      | none => rfl
      | some _ => simp [isObjectPattern] at object
    subst restNone
    cases kind with
    | hashBag => exact .par_perm _ _ permutation
    | hashSet => exact .set_perm _ _ permutation
    | vec => simp [Unordered] at unordered
  | members _ =>
    intro _ pure
    exact absurd rfl (hashSetFree_collection.mp pure).1
  | @flatten kind law before inner after rest found =>
    intro object pure
    obtain ⟨rfl, rfl⟩ := laws_found found
    have restNone : rest = none := by
      cases rest with
      | none => rfl
      | some _ => simp [isObjectPattern] at object
    subst restNone
    refine .trans _ (.collection .hashBag ((before ++ after) ++ [.collection .hashBag inner none]) none) _
      (.par_perm _ _ ?_) (.trans _ (.collection .hashBag ((before ++ after) ++ inner) none) _
        (.par_flatten _ _) (.par_perm _ _ ?_))
    · exact List.perm_middle.trans (List.perm_append_comm (l₁ := [Pattern.collection .hashBag inner none]))
    · simpa only [List.append_assoc] using List.Perm.append_left before (List.perm_append_comm (l₁ := after) (l₂ := inner))
  | @unit kind law label before after rest found unit =>
    intro object pure
    obtain ⟨rfl, rfl⟩ := laws_found found
    simp only [Option.some.injEq] at unit
    subst unit
    have restNone : rest = none := by
      cases rest with
      | none => rfl
      | some _ => simp [isObjectPattern] at object
    subst restNone
    exact .trans _ _ _ (.par_perm _ _ List.perm_middle) (sc_drop_zero _)
  | @apply label before after argument changed _ ih =>
    intro object pure
    simp only [isObjectPattern, isObjectPatternList_eq_all, List.all_eq_true] at object
    exact sc_apply (forall₂_sc_middle (ih (object _ (by simp)) ((hashSetFree_apply.mp pure) _ (by simp))))
  | lambda _ ih =>
    intro object pure
    exact .lambda_cong _ _ _ (ih (by simpa [isObjectPattern] using object) (by simpa [HashSetFree] using pure))
  | multiLambda _ ih =>
    intro object pure
    exact .multiLambda_cong _ _ _ _ (ih (by simpa [isObjectPattern] using object) (by simpa [HashSetFree] using pure))
  | substBody _ _ =>
    intro object _
    simp [isObjectPattern] at object
  | substReplacement _ _ =>
    intro object _
    simp [isObjectPattern] at object
  | @element kind before after element changed rest _ ih =>
    intro object pure
    simp only [isObjectPattern, isObjectPatternList_eq_all, Bool.and_eq_true, List.all_eq_true] at object
    exact sc_collection (forall₂_sc_middle (ih (object.2 _ (by simp)) ((hashSetFree_collection.mp pure).2 _ (by simp))))

/-- **Every use of the name equation is a structural congruence.** -/
theorem quoteDropStep_sc {left right : Pattern} (step : QuoteDropStep RhoQuoteDrop.presentation left right) :
    StructuralCongruence left right := by
  induction step with
  | collapse name => exact .quote_drop name
  | apply _ ih => exact sc_apply (forall₂_sc_middle ih)
  | lambda _ ih => exact .lambda_cong _ _ _ ih
  | multiLambda _ ih => exact .multiLambda_cong _ _ _ _ ih
  | substBody _ ih => exact .subst_cong _ _ _ _ ih (.refl _)
  | substReplacement _ ih => exact .subst_cong _ _ _ _ (.refl _) ih
  | element _ ih => exact sc_collection (forall₂_sc_middle ih)

theorem modelEquation_sc {bound : List TypeExpr} {expected : TypeExpr} {left right : Pattern}
    (step : QuoteDropCoherence.ModelEquation GeneralRho.Standard.plan bound expected RhoQuoteDrop.presentation left right)
    (object : isObjectPattern left = true) (pure : HashSetFree left) : StructuralCongruence left right := by
  rcases step with equation | moved | quoteDrop
  · exact absurd equation (noEquations _ _ _ _)
  · rw [extrusions_eq] at moved
    exact lawStep_sc (Coherence.lawStep_of_standardStep moved) object pure
  · exact quoteDropStep_sc quoteDrop

theorem modelEquation_hashSetFree {bound : List TypeExpr} {expected : TypeExpr} {left right : Pattern}
    (step : QuoteDropCoherence.ModelEquation GeneralRho.Standard.plan bound expected RhoQuoteDrop.presentation left right) :
    HashSetFree left ↔ HashSetFree right := by
  rcases step with equation | moved | quoteDrop
  · exact absurd equation (noEquations _ _ _ _)
  · rw [extrusions_eq] at moved
    exact (Coherence.lawStep_of_standardStep moved).hashSetFree_iff
  · exact quoteDrop.hashSetFree_iff

theorem modelEquation_object {bound : List TypeExpr} {expected : TypeExpr} {left right : Pattern}
    (step : QuoteDropCoherence.ModelEquation GeneralRho.Standard.plan bound expected RhoQuoteDrop.presentation left right) :
    isObjectPattern left = isObjectPattern right := by
  rcases step with equation | moved | quoteDrop
  · exact absurd equation (noEquations _ _ _ _)
  · rw [extrusions_eq] at moved
    exact (Coherence.lawStep_of_standardStep moved).objectPattern_eq
  · exact quoteDrop.objectPattern_eq

/-- **Equality in rho's model with the name equation is structural congruence**, on object terms. -/
theorem modelEquiv_sc {bound : List TypeExpr} {expected : TypeExpr} {left right : Pattern}
    (equal : QuoteDropCoherence.ModelEquiv GeneralRho.Standard.plan bound expected RhoQuoteDrop.presentation left right)
    (object : isObjectPattern left = true) (pure : HashSetFree left) : StructuralCongruence left right := by
  have chain : Relation.ReflTransGen (Relation.SymmGen
      (QuoteDropCoherence.ModelEquation GeneralRho.Standard.plan bound expected RhoQuoteDrop.presentation)) left right := by
    rw [Relation.EqvGen.reflTransGen_symmGen]; exact equal
  clear equal
  suffices along : StructuralCongruence left right ∧ isObjectPattern right = true ∧ HashSetFree right from along.1
  induction chain with
  | refl => exact ⟨.refl _, object, pure⟩
  | tail _ step ih =>
    obtain ⟨toMiddle, middleObject, middlePure⟩ := ih
    rcases step with forward | backward
    · exact ⟨.trans _ _ _ toMiddle (modelEquation_sc forward middleObject middlePure),
        (modelEquation_object forward) ▸ middleObject, (modelEquation_hashSetFree forward).mp middlePure⟩
    · have nextObject := (modelEquation_object backward).symm ▸ middleObject
      have nextPure := (modelEquation_hashSetFree backward).mpr middlePure
      exact ⟨.trans _ _ _ toMiddle (.symm _ _ (modelEquation_sc backward nextObject nextPure)), nextObject, nextPure⟩

/-! ## Steps -/

/-- A well-sorted closed process of the plan is well-sorted in rho's own sorting. -/
theorem procWellSorted_of_sorted {pattern : Pattern}
    (sorted : OpenPatternWellSorted (GeneralPlanEnvironment.environment GeneralRho.Standard.plan).language
      GeneralRho.Standard.plan.snapshot.free [] (.base "Proc") pattern) :
    ProcWellSorted rhoReflectivePresentation FreeSortContext.empty [] pattern := by
  obtain ⟨typed, metadata, object, _⟩ := sorted
  apply Mettapedia.Languages.ProcessCalculi.RhoCalculus.LanguageDefTypingAgreement.languageDefHasSort_to_procWellSorted
    _ object metadata
  have freeEq : GeneralRho.Standard.plan.snapshot.free =
      Mettapedia.Languages.ProcessCalculi.RhoCalculus.LanguageDefTypingAgreement.liftFreeSortContext
        FreeSortContext.empty := by
    funext name
    simp [Snapshot.free, GeneralRho.Standard.plan, GeneralExecutionAdmission.compile, GeneralRho.snapshot,
      Mettapedia.Languages.ProcessCalculi.RhoCalculus.LanguageDefTypingAgreement.liftFreeSortContext,
      FreeSortContext.empty]
  rw [freeEq] at typed
  exact GeneralLanguageTyping.type_transport terms_eq typed

/-- **COMM at a closed well-sorted focus is a reference reduction.** -/
theorem rootFiring_reduces {bound : List TypeExpr} {type : TypeExpr} {source : Pattern} {index : Nat}
    {trace : List GeneralScopedMatchMachine.BagChoice} {captured completed : ScopedRuleMatching.Assignment}
    {history : List GeneralPremise.Event} {target : Pattern}
    (fired : GeneralPremise.RootFiring (GeneralPlanEnvironment.environment GeneralRho.Standard.plan) bound type source
      index trace captured completed history target)
    (closed : bound = []) (procType : type = .base "Proc") : Nonempty (Reduces source target) := by
  subst closed procType
  cases fired with
  | @fire _ _ _ _ _ rule spec _ _ _ _ ruleFound specFound _ sourceSorted matched _ premises reduct _ =>
    have zero : index = 0 := by
      rw [rewrites_eq] at ruleFound
      cases index with
      | zero => rfl
      | succ => simp at ruleFound
    subst zero
    obtain ⟨_, rfl, rfl⟩ := rule_at (declaration := GeneralRho.declaration) (by rw [rules_zipIdx]; exact .head _)
      ruleFound specFound
    have typed := procWellSorted_of_sorted sourceSorted
    have noPremises : GeneralRho.comm.premises = [] := rfl
    rw [noPremises] at premises
    cases premises
    obtain ⟨elements, inputIndex, outputIndex, channel, display, body, payload, rfl, inputAt, outputAt,
      _, capturedEq, _, _, _, residueSafe⟩ := GeneralRho.DepthOne.traced_comm_inv matched
    rw [capturedEq] at reduct
    obtain ⟨_, elementsTyped⟩ := Mettapedia.Languages.ProcessCalculi.RhoCalculus.CanonicalStepperCompleteness.rho_parallel_wellSorted_inv typed
    have inputTyped := Mettapedia.Languages.ProcessCalculi.RhoCalculus.CanonicalTyping.procListWellSorted_iff_forall_mem.mp
      elementsTyped _ (List.mem_of_getElem? inputAt)
    obtain ⟨rfl, _, bodyTyped⟩ := Mettapedia.Languages.ProcessCalculi.RhoCalculus.DerivedContextualStep.rho_input_wellSorted_inv inputTyped
    have outputTyped := Mettapedia.Languages.ProcessCalculi.RhoCalculus.CanonicalTyping.procListWellSorted_iff_forall_mem.mp
      elementsTyped _ (List.mem_of_mem_eraseIdx (List.mem_of_getElem? outputAt))
    obtain ⟨_, payloadTyped⟩ := Mettapedia.Languages.ProcessCalculi.RhoCalculus.DerivedContextualStep.rho_output_wellSorted_inv outputTyped
    have semantic := GeneralRho.reflective_reduct_semantic (channel := channel) bodyTyped payloadTyped residueSafe
    have localTarget := Option.some.inj (reduct.symm.trans semantic)
    subst localTarget
    obtain ⟨inputBound, inputEq⟩ := List.getElem?_eq_some_iff.mp inputAt
    obtain ⟨outputBound, outputEq⟩ := List.getElem?_eq_some_iff.mp outputAt
    have firstPerm := List.getElem_cons_eraseIdx_perm inputBound
    have secondPerm := List.getElem_cons_eraseIdx_perm outputBound
    rw [inputEq] at firstPerm
    rw [outputEq] at secondPerm
    have arranged : elements.Perm ([GeneralRho.output channel payload, .apply "PInput" [channel, .lambda none body]] ++
        (elements.eraseIdx inputIndex).eraseIdx outputIndex) :=
      firstPerm.symm.trans ((List.Perm.cons _ secondPerm.symm).trans (List.Perm.swap _ _ _))
    exact ⟨.equiv (.par_perm _ _ arranged) .comm (.refl _)⟩

/-- **The standard reduction contexts are nested parallel compositions**: a reduction at the focus
of a licensed site of a process is a reduction of the process. -/
theorem licensed_reduces {bound : List TypeExpr} {expected : TypeExpr} {source : Pattern} {site : SiteData}
    (licensed : Licensed (GeneralPlanEnvironment.environment GeneralRho.Standard.plan).language
      GeneralRho.Standard.plan.snapshot.free GeneralRho.Standard.plan.permissions.sites bound expected source site) :
    expected = .base "Proc" →
      site.focusBound = bound ∧ site.focusType = .base "Proc" ∧
        ∀ localTarget, Nonempty (Reduces site.focus localTarget) →
          Nonempty (Reduces source (site.context.fill localTarget)) := by
  induction licensed with
  | here _ _ _ =>
    intro procType
    exact ⟨rfl, procType, fun _ step => step⟩
  | application _ _ _ _ _ _ _ permitted _ _ =>
    intro _
    change GeneralRho.Standard.sites.allConstructorArguments = true ∨ _ ∈ GeneralRho.Standard.sites.constructorArguments
      at permitted
    simp [GeneralRho.Standard.sites] at permitted
  | lambda enabled _ _ =>
    intro _
    change GeneralRho.Standard.sites.underLambda = true at enabled
    simp [GeneralRho.Standard.sites] at enabled
  | multiLambda enabled _ _ =>
    intro _
    change GeneralRho.Standard.sites.underMultiLambda = true at enabled
    simp [GeneralRho.Standard.sites] at enabled
  | directCollection _ _ _ _ _ _ =>
    intro procType
    cases procType
  | @authoredCollection bound rule declarationIndex parameterName kind elements index element elementType inner
      declared shape permitted typed objects selected _ ih =>
    intro _
    obtain ⟨_, rfl, rfl⟩ := bare_rule (List.fst_mem_of_mem_zipIdx declared) shape
    obtain ⟨focusBound, focusType, lift⟩ := ih rfl
    refine ⟨focusBound, focusType, fun localTarget step => ?_⟩
    have split : elements = elements.take index ++ element :: elements.drop (index + 1) := by
      obtain ⟨inside, atIndex⟩ := List.getElem?_eq_some_iff.mp selected
      rw [← atIndex, ← List.drop_eq_getElem_cons inside, List.take_append_drop]
    obtain ⟨inner⟩ := lift localTarget step
    simp only [SiteData.wrapCollection, DerivedContexts.OneHoleContext.fill]
    rw [split]
    have moved := Reduces.par_any (before := elements.take index) (after := elements.drop (index + 1)) inner
    simp only [List.append_assoc, List.singleton_append] at moved
    have dropped : (elements.take index ++ element :: elements.drop (index + 1)).drop (index + 1) =
        elements.drop (index + 1) := by
      rw [← split]
    have taken : (elements.take index ++ element :: elements.drop (index + 1)).take index = elements.take index := by
      rw [← split]
    rw [taken, dropped]
    exact ⟨moved⟩

/-- **Every firing of the plan is a reference reduction.** -/
theorem primitive_reduces {source : Pattern} {receipt : GeneralRuleJobs.Receipt}
    (fired : GeneralOccurrenceSemantics.Primitive GeneralRho.Standard.plan [] (.base "Proc") source receipt) :
    Nonempty (Reduces source receipt.target) := by
  obtain ⟨⟨_, licensed⟩, rooted, _, endpoint, _⟩ := fired
  obtain ⟨focusBound, focusType, lift⟩ := licensed_reduces licensed rfl
  rw [endpoint]
  exact lift _ (rootFiring_reduces rooted focusBound focusType)

/-- The target of a firing holds no set. -/
theorem primitive_target_hashSetFree {source : Pattern} {receipt : GeneralRuleJobs.Receipt}
    (fired : GeneralOccurrenceSemantics.Primitive GeneralRho.Standard.plan [] (.base "Proc") source receipt) :
    HashSetFree receipt.target :=
  rhoProcWellSorted_hashSetFree (procWellSorted_of_sorted fired.2.2.2.2)

/-- **Every step modulo rho's model with the name equation is a reference reduction**, from an
object term. -/
theorem step_reduces {source target : Pattern} (object : isObjectPattern source = true) (pure : HashSetFree source)
    (stepped : (QuoteDropCoherence.gslt GeneralRho.Standard.plan [] (.base "Proc") RhoQuoteDrop.presentation).Step
      source target) :
    Nonempty (Reduces source target) := by
  obtain ⟨representative, receipt, before, fired, after⟩ := stepped
  obtain ⟨reduced⟩ := primitive_reduces fired
  have targetObject : isObjectPattern receipt.target = true := fired.2.2.2.2.2.2.1
  exact ⟨.equiv (modelEquiv_sc before object pure) reduced
    (modelEquiv_sc after targetObject (primitive_target_hashSetFree fired))⟩

/-! ## The gap: the wrapper laws -/

/-- The reference's wrapper laws, in every context: a singleton parallel composition is its element,
and the empty one is `PZero`. -/
inductive WrapperStep : Pattern → Pattern → Prop where
  | singleton (process : Pattern) : WrapperStep (.collection .hashBag [process] none) process
  | empty : WrapperStep (.collection .hashBag [] none) (.apply "PZero" [])
  | apply {label : String} {before after : List Pattern} {argument changed : Pattern} :
      WrapperStep argument changed →
      WrapperStep (.apply label (before ++ argument :: after)) (.apply label (before ++ changed :: after))
  | lambda {binder : Option String} {body changed : Pattern} :
      WrapperStep body changed → WrapperStep (.lambda binder body) (.lambda binder changed)
  | multiLambda {arity : Nat} {binders : List String} {body changed : Pattern} :
      WrapperStep body changed → WrapperStep (.multiLambda arity binders body) (.multiLambda arity binders changed)
  | substBody {body changed replacement : Pattern} :
      WrapperStep body changed → WrapperStep (.subst body replacement) (.subst changed replacement)
  | substReplacement {body replacement changed : Pattern} :
      WrapperStep replacement changed → WrapperStep (.subst body replacement) (.subst body changed)
  | element {kind : CollType} {before after : List Pattern} {element changed : Pattern} {rest : Option String} :
      WrapperStep element changed →
      WrapperStep (.collection kind (before ++ element :: after) rest) (.collection kind (before ++ changed :: after) rest)

/-- A law move of rho's model, or a wrapper law. -/
abbrev ReferenceStep (left right : Pattern) : Prop :=
  QuoteDropCoherence.LawMove GeneralRho.Standard.plan RhoQuoteDrop.presentation left right ∨ WrapperStep left right

theorem wrapperStep_sc {left right : Pattern} (step : WrapperStep left right) : StructuralCongruence left right := by
  induction step with
  | singleton process => exact .par_singleton process
  | empty => exact .par_empty
  | apply _ ih => exact sc_apply (forall₂_sc_middle ih)
  | lambda _ ih => exact .lambda_cong _ _ _ ih
  | multiLambda _ ih => exact .multiLambda_cong _ _ _ _ ih
  | substBody _ ih => exact .subst_cong _ _ _ _ ih (.refl _)
  | substReplacement _ ih => exact .subst_cong _ _ _ _ (.refl _) ih
  | element _ ih => exact sc_collection (forall₂_sc_middle ih)

theorem wrapperStep_object {left right : Pattern} (step : WrapperStep left right) :
    isObjectPattern left = isObjectPattern right := by
  induction step with
  | singleton process => simp [isObjectPattern, isObjectPatternList]
  | empty => simp [isObjectPattern, isObjectPatternList]
  | apply _ ih => simp [isObjectPattern, isObjectPatternList_eq_all, List.all_append, ih]
  | lambda _ ih => simpa [isObjectPattern] using ih
  | multiLambda _ ih => simpa [isObjectPattern] using ih
  | substBody _ _ => simp [isObjectPattern]
  | substReplacement _ _ => simp [isObjectPattern]
  | element _ ih => simp [isObjectPattern, isObjectPatternList_eq_all, List.all_append, ih]

theorem wrapperStep_hashSetFree {left right : Pattern} (step : WrapperStep left right) :
    HashSetFree left ↔ HashSetFree right := by
  induction step with
  | singleton process => simp [HashSetFree, HashSetFreeList]
  | empty => simp [HashSetFree, HashSetFreeList]
  | apply _ ih => simp only [hashSetFree_apply, List.forall_mem_append, List.forall_mem_cons, ih]
  | lambda _ ih => simpa [HashSetFree] using ih
  | multiLambda _ ih => simpa [HashSetFree] using ih
  | substBody _ ih => simp [HashSetFree, ih]
  | substReplacement _ ih => simp [HashSetFree, ih]
  | element _ ih => simp only [hashSetFree_collection, List.forall_mem_append, List.forall_mem_cons, ih]

/-- Every reference step lifts through a context that lifts each kind of step. -/
theorem referenceEquiv_lift {f : Pattern → Pattern}
    (lawLift : ∀ {a b}, StandardStep (Normalized.laws GeneralRho.Standard.plan)
      (Normalized.extrusions GeneralRho.Standard.plan) a b →
      StandardStep (Normalized.laws GeneralRho.Standard.plan) (Normalized.extrusions GeneralRho.Standard.plan) (f a) (f b))
    (quoteLift : ∀ {a b}, QuoteDropStep RhoQuoteDrop.presentation a b → QuoteDropStep RhoQuoteDrop.presentation (f a) (f b))
    (wrapperLift : ∀ {a b}, WrapperStep a b → WrapperStep (f a) (f b))
    {a b : Pattern} (related : Relation.EqvGen ReferenceStep a b) : Relation.EqvGen ReferenceStep (f a) (f b) := by
  induction related with
  | rel _ _ step =>
    rcases step with (moved | quoteDrop) | wrapped
    · exact .rel _ _ (.inl (.inl (lawLift moved)))
    · exact .rel _ _ (.inl (.inr (quoteLift quoteDrop)))
    · exact .rel _ _ (.inr (wrapperLift wrapped))
  | refl => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second

theorem referenceEquiv_pointwise (wrap : List Pattern → Pattern)
    (lawLift : ∀ {before after : List Pattern} {a b}, StandardStep (Normalized.laws GeneralRho.Standard.plan)
      (Normalized.extrusions GeneralRho.Standard.plan) a b →
      StandardStep (Normalized.laws GeneralRho.Standard.plan) (Normalized.extrusions GeneralRho.Standard.plan)
        (wrap (before ++ a :: after)) (wrap (before ++ b :: after)))
    (quoteLift : ∀ {before after : List Pattern} {a b}, QuoteDropStep RhoQuoteDrop.presentation a b →
      QuoteDropStep RhoQuoteDrop.presentation (wrap (before ++ a :: after)) (wrap (before ++ b :: after)))
    (wrapperLift : ∀ {before after : List Pattern} {a b}, WrapperStep a b →
      WrapperStep (wrap (before ++ a :: after)) (wrap (before ++ b :: after))) :
    ∀ (before : List Pattern) {items items' : List Pattern}, List.Forall₂ (Relation.EqvGen ReferenceStep) items items' →
      Relation.EqvGen ReferenceStep (wrap (before ++ items)) (wrap (before ++ items'))
  | _, [], [], .nil => .refl _
  | before, item :: rest, item' :: rest', .cons head tail => by
    have here : Relation.EqvGen ReferenceStep (wrap (before ++ item :: rest)) (wrap (before ++ item' :: rest)) :=
      referenceEquiv_lift (f := fun x => wrap (before ++ x :: rest)) lawLift quoteLift wrapperLift head
    have later := referenceEquiv_pointwise wrap lawLift quoteLift wrapperLift (before ++ [item']) tail
    simp only [List.append_assoc, List.cons_append, List.nil_append] at later
    exact .trans _ _ _ here later

theorem forall₂_of_sc_ih {items items' : List Pattern} (length : items.length = items'.length)
    (pointwise : ∀ i h₁ h₂, Relation.EqvGen ReferenceStep (items.get ⟨i, h₁⟩) (items'.get ⟨i, h₂⟩)) :
    List.Forall₂ (Relation.EqvGen ReferenceStep) items items' :=
  List.forall₂_iff_get.mpr ⟨length, pointwise⟩

theorem bagLaw : CollectionLaws.lawFor (Normalized.laws GeneralRho.Standard.plan) .hashBag =
    some ⟨.hashBag, some "PZero"⟩ := by
  rw [laws_eq]; decide

theorem law_reference {left right : Pattern} (step : LawStep (Normalized.laws GeneralRho.Standard.plan) left right) :
    Relation.EqvGen ReferenceStep left right :=
  .rel _ _ (.inl (.inl (.law step)))

/-- **Structural congruence is generated by the model's law moves and the wrapper laws.** -/
theorem sc_reference {left right : Pattern} (related : StructuralCongruence left right) :
    Relation.EqvGen ReferenceStep left right := by
  induction related with
  | alpha p q same => subst same; exact .refl _
  | refl p => exact .refl _
  | symm _ _ _ ih => exact .symm _ _ ih
  | trans _ _ _ _ _ first second => exact .trans _ _ _ first second
  | par_singleton p => exact .rel _ _ (.inr (.singleton p))
  | par_nil_left p =>
    exact .trans _ _ _ (law_reference (.unit (before := []) (after := [p]) (rest := none) bagLaw rfl))
      (.rel _ _ (.inr (.singleton p)))
  | par_nil_right p =>
    exact .trans _ _ _ (law_reference (.unit (before := [p]) (after := []) (rest := none) bagLaw rfl))
      (.rel _ _ (.inr (.singleton p)))
  | par_comm p q => exact law_reference (.permute rfl (List.Perm.swap q p []))
  | par_assoc p q r =>
    exact .trans _ _ _ (law_reference (.flatten (before := []) (after := [r]) (rest := none) bagLaw))
      (.symm _ _ (law_reference (.flatten (before := [p]) (after := []) (rest := none) bagLaw)))
  | par_cong ps qs length _ ih =>
    exact referenceEquiv_pointwise (fun items => .collection .hashBag items none) (fun step => .element step)
      (fun step => .element step) (fun step => .element step) [] (forall₂_of_sc_ih length ih)
  | par_flatten ps qs =>
    simpa using law_reference (.flatten (before := ps) (inner := qs) (after := []) (rest := none) bagLaw)
  | par_perm _ _ permutation => exact law_reference (.permute rfl permutation)
  | set_perm _ _ permutation => exact law_reference (.permute rfl permutation)
  | set_cong elems₁ elems₂ length _ ih =>
    exact referenceEquiv_pointwise (fun items => .collection .hashSet items none) (fun step => .element step)
      (fun step => .element step) (fun step => .element step) [] (forall₂_of_sc_ih length ih)
  | lambda_cong binder _ _ _ ih =>
    exact referenceEquiv_lift (f := fun x => .lambda binder x) (fun step => .lambda step) (fun step => .lambda step)
      (fun step => .lambda step) ih
  | apply_cong label args₁ args₂ length _ ih =>
    exact referenceEquiv_pointwise (fun items => .apply label items) (fun step => .apply step)
      (fun step => .apply step) (fun step => .apply step) [] (forall₂_of_sc_ih length ih)
  | collection_general_cong kind elems₁ elems₂ rest length _ ih =>
    exact referenceEquiv_pointwise (fun items => .collection kind items rest) (fun step => .element step)
      (fun step => .element step) (fun step => .element step) [] (forall₂_of_sc_ih length ih)
  | multiLambda_cong arity binders _ _ _ ih =>
    exact referenceEquiv_lift (f := fun x => .multiLambda arity binders x) (fun step => .multiLambda step)
      (fun step => .multiLambda step) (fun step => .multiLambda step) ih
  | subst_cong body body' replacement replacement' _ _ bodyIH replacementIH =>
    exact .trans _ _ _
      (referenceEquiv_lift (f := fun x => .subst x replacement) (fun step => .substBody step)
        (fun step => .substBody step) (fun step => .substBody step) bodyIH)
      (referenceEquiv_lift (f := fun x => .subst body' x) (fun step => .substReplacement step)
        (fun step => .substReplacement step) (fun step => .substReplacement step) replacementIH)
  | quote_drop n => exact .rel _ _ (.inl (.inr (.collapse n)))
  | par_empty => exact .rel _ _ (.inr .empty)

/-- **On object terms, structural congruence is the equality generated by the model's law moves and
the wrapper laws.** -/
theorem sc_iff_reference {left right : Pattern} (object : isObjectPattern left = true) (pure : HashSetFree left) :
    StructuralCongruence left right ↔ Relation.EqvGen ReferenceStep left right := by
  refine ⟨sc_reference, fun related => ?_⟩
  have chain : Relation.ReflTransGen (Relation.SymmGen ReferenceStep) left right := by
    rw [Relation.EqvGen.reflTransGen_symmGen]; exact related
  clear related
  have stepSc : ∀ {a b}, ReferenceStep a b → isObjectPattern a = true → HashSetFree a → StructuralCongruence a b := by
    intro a b step objectA pureA
    rcases step with moved | wrapped
    · exact modelEquation_sc (bound := []) (expected := .base "Proc") (.inr moved) objectA pureA
    · exact wrapperStep_sc wrapped
  have stepObject : ∀ {a b}, ReferenceStep a b → isObjectPattern a = isObjectPattern b := by
    intro a b step
    rcases step with moved | wrapped
    · exact modelEquation_object (bound := []) (expected := .base "Proc") (.inr moved)
    · exact wrapperStep_object wrapped
  have stepPure : ∀ {a b}, ReferenceStep a b → (HashSetFree a ↔ HashSetFree b) := by
    intro a b step
    rcases step with moved | wrapped
    · exact modelEquation_hashSetFree (bound := []) (expected := .base "Proc") (.inr moved)
    · exact wrapperStep_hashSetFree wrapped
  suffices along : StructuralCongruence left right ∧ isObjectPattern right = true ∧ HashSetFree right from along.1
  induction chain with
  | refl => exact ⟨.refl _, object, pure⟩
  | tail _ step ih =>
    obtain ⟨toMiddle, middleObject, middlePure⟩ := ih
    rcases step with forward | backward
    · exact ⟨.trans _ _ _ toMiddle (stepSc forward middleObject middlePure), (stepObject forward) ▸ middleObject,
        (stepPure forward).mp middlePure⟩
    · have nextObject := (stepObject backward).symm ▸ middleObject
      have nextPure := (stepPure backward).mpr middlePure
      exact ⟨.trans _ _ _ toMiddle (.symm _ _ (stepSc backward nextObject nextPure)), nextObject, nextPure⟩

/-- **The gap, by example**: sending on `@{}` and on `@0` are structurally congruent, but not equal in
rho's model with the name equation. -/
theorem emptyWrapper_gap :
    StructuralCongruence (RhoQuoteDrop.send (.apply "NQuote" [.collection .hashBag [] none]))
        (RhoQuoteDrop.send RhoQuoteDrop.quotedZero) ∧
      ¬ QuoteDropCoherence.ModelEquiv GeneralRho.Standard.plan [] (.base "Proc") RhoQuoteDrop.presentation
        (RhoQuoteDrop.send (.apply "NQuote" [.collection .hashBag [] none])) (RhoQuoteDrop.send RhoQuoteDrop.quotedZero) := by
  refine ⟨wrapperStep_sc (.apply (before := []) (after := [RhoQuoteDrop.zero]) (.apply (before := []) (after := []) .empty)),
    fun equal => RhoQuoteDrop.emptyWrapper_separates ?_⟩
  have normalizer := QuoteDropCoherence.normalizer (plan := GeneralRho.Standard.plan) extrusions_eq RhoQuoteDrop.distinct
  apply normalizer.eqvGen_eq
  refine Relation.EqvGen.mono (fun a b step => ?_) _ _ equal
  rcases step with equation | moved
  · exact absurd equation (noEquations _ _ _ _)
  · exact moved

/-! ## Deciding structural congruence -/

/-- Rho's reference wrapper steps are the declared algebra's wrapper steps. -/
theorem wrapperStep_declared {left right : Pattern} (step : WrapperStep left right) :
    Wrappers.WrapperStep (Normalized.laws GeneralRho.Standard.plan) left right := by
  induction step with
  | singleton process => exact .singleton bagLaw
  | empty => exact .empty bagLaw rfl
  | apply _ ih => exact .apply ih
  | lambda _ ih => exact .lambda ih
  | multiLambda _ ih => exact .multiLambda ih
  | substBody _ ih => exact .substBody ih
  | substReplacement _ ih => exact .substReplacement ih
  | element _ ih => exact .element ih

/-- The declared algebra's wrapper steps for rho are the reference's. -/
theorem wrapperStep_reference {left right : Pattern}
    (step : Wrappers.WrapperStep (Normalized.laws GeneralRho.Standard.plan) left right) : WrapperStep left right := by
  induction step with
  | singleton found => obtain ⟨rfl, rfl⟩ := laws_found found; exact .singleton _
  | empty found unit =>
    obtain ⟨rfl, rfl⟩ := laws_found found
    simp only [Option.some.injEq] at unit
    subst unit
    exact .empty
  | apply _ ih => exact .apply ih
  | lambda _ ih => exact .lambda ih
  | multiLambda _ ih => exact .multiLambda ih
  | substBody _ ih => exact .substBody ih
  | substReplacement _ ih => exact .substReplacement ih
  | element _ ih => exact .element ih

theorem referenceStep_iff_modelMove (left right : Pattern) :
    ReferenceStep left right ↔
      Wrappers.ModelMove (Normalized.laws GeneralRho.Standard.plan) RhoQuoteDrop.presentation left right := by
  constructor
  · rintro ((moved | quoteDrop) | wrapped)
    · rw [extrusions_eq] at moved
      exact .inl (Coherence.lawStep_of_standardStep moved)
    · exact .inr (.inl quoteDrop)
    · exact .inr (.inr (wrapperStep_declared wrapped))
  · rintro (lawMove | quoteDrop | wrapped)
    · exact .inl (.inl (.law lawMove))
    · exact .inl (.inr quoteDrop)
    · exact .inr (wrapperStep_reference wrapped)

/-- **The model's canonical form decides rho's structural congruence**, on object terms. -/
theorem sc_iff_modelCanon {left right : Pattern} (object : isObjectPattern left = true) (pure : HashSetFree left) :
    StructuralCongruence left right ↔
      Wrappers.modelCanon (Normalized.laws GeneralRho.Standard.plan) RhoQuoteDrop.presentation left =
        Wrappers.modelCanon (Normalized.laws GeneralRho.Standard.plan) RhoQuoteDrop.presentation right := by
  rw [sc_iff_reference object pure, Wrappers.modelCanon_iff RhoQuoteDrop.distinct]
  constructor
  · exact Relation.EqvGen.mono (fun a b step => (referenceStep_iff_modelMove a b).mp step) _ _
  · exact Relation.EqvGen.mono (fun a b step => (referenceStep_iff_modelMove a b).mpr step) _ _

/-- **Example**: sending on `@{}` and on `@0` have one canonical form. -/
theorem emptyWrapper_decided :
    Wrappers.modelCanon (Normalized.laws GeneralRho.Standard.plan) RhoQuoteDrop.presentation
        (RhoQuoteDrop.send (.apply "NQuote" [.collection .hashBag [] none])) =
      Wrappers.modelCanon (Normalized.laws GeneralRho.Standard.plan) RhoQuoteDrop.presentation
        (RhoQuoteDrop.send RhoQuoteDrop.quotedZero) :=
  (sc_iff_modelCanon (by decide) (by simp [RhoQuoteDrop.send, RhoQuoteDrop.zero, HashSetFree, HashSetFreeList])).mp
    emptyWrapper_gap.1

