import Mettapedia.OSLF.Framework.SortedInstrumentCongruenceLogic

/-!
# Controls: replication with its unfolding law

The signature has an inert process, an atom, parallel composition and
replication. Its one equation is the unfolding law `!P = !P | P`. The law
changes the root constructor and the size of a term, and it is not
associativity, commutativity or a unit law. Classes are told apart by an
interpretation that satisfies the law.

Positive controls: a replicated atom answers the probe for parallel
composition, through its own unfolding and through a larger representative;
the unfolded term is bisimilar to it; its characteristic formula holds of a
term with a different root.

Negative controls: the complete kit separates the atom from the inert
process, while the empty kit and the kit holding only the parallel probe do
not; a kit holding only the probe for the atom does. With an authored step
from the atom, the empty kit distinguishes the two terms although no
structural formula is admitted at all, so the authored diamond is necessary.

Two controls concern a partial kit and the root of a term. The parallel
probe reads a replicated atom, whose root it does not hold, through the
unfolding law. The atom probe cannot reach an atom beneath replication, so
it relates two unequal terms.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Framework.SortedInstrumentCongruence.Controls

open Mettapedia.OSLF.SortedConstructors

inductive Symbol where
  | stop
  | atom
  | par
  | bang
  deriving DecidableEq

abbrev signature : Signature.{0,0} where
  Srt := Unit
  Constructor := Symbol
  arity constructor :=
    match constructor with
    | .stop => 0
    | .atom => 0
    | .par => 2
    | .bang => 1
  input _ _ := ()
  output _ := ()

abbrev Process := Term signature ()

def stop : Process := Term.node (signature := signature) Symbol.stop (fun position => position.elim0)

def atom : Process := Term.node (signature := signature) Symbol.atom (fun position => position.elim0)

/-- The two arguments of a parallel composition. -/
def pair (left right : Process) :
    (position : Fin (signature.arity Symbol.par)) →
      Term signature (signature.input Symbol.par position) :=
  fun position => if position.1 = 0 then left else right

def par (left right : Process) : Process :=
  Term.node (signature := signature) Symbol.par (pair left right)

def bang (body : Process) : Process :=
  Term.node (signature := signature) Symbol.bang (fun _ => body)

/-- The unfolding law, as its instances. -/
inductive Unfolding : (sort : signature.Srt) → Term signature sort → Term signature sort → Prop where
  | replicate (body : Process) : Unfolding () (bang body) (par (bang body) body)

/-- The equation theory generated by the unfolding law. -/
def theory : Congruence signature := Congruence.generated Unfolding

theorem unfolding (body : Process) : theory.Rel (bang body) (par (bang body) body) :=
  Generated.generator (Unfolding.replicate body)

theorem pair_rel {left left' right right' : Process} (first : theory.Rel left left')
    (second : theory.Rel right right') (position : Fin (signature.arity Symbol.par)) :
    theory.Rel (pair left right position) (pair left' right' position) := by
  unfold pair
  split
  · exact first
  · exact second

theorem par_rel {left left' right right' : Process} (first : theory.Rel left left')
    (second : theory.Rel right right') : theory.Rel (par left right) (par left' right') :=
  theory.node Symbol.par (pair_rel first second)

/-! ## Telling classes apart -/

inductive Shape where
  | stop
  | atom
  | compound
  deriving DecidableEq

/-- An interpretation that keeps the two constants apart and forgets
everything about a compound. -/
def shape : Algebra.{0,0,0} signature where
  Carrier _ := Shape
  operation constructor _ :=
    match (constructor : Symbol) with
    | .stop => Shape.stop
    | .atom => Shape.atom
    | .par => Shape.compound
    | .bang => Shape.compound

theorem shape_satisfies (sort : signature.Srt) (left right : Term signature sort)
    (instance' : Unfolding sort left right) : shape.evaluate left = shape.evaluate right := by
  cases instance' with
  | replicate body => rfl

theorem shape_eq {left right : Process} (equation : theory.Rel left right) :
    shape.evaluate left = shape.evaluate right :=
  shape.evaluate_eq_of_generated shape_satisfies equation

theorem atom_ne_stop : ¬ theory.Rel atom stop := by
  intro equation
  have same : Shape.atom = Shape.stop := shape_eq equation
  cases same

theorem atom_not_parallel
    (arguments : (position : Fin (signature.arity Symbol.par)) →
      Term signature (signature.input Symbol.par position)) :
    ¬ theory.Rel atom (Term.node (signature := signature) Symbol.par arguments) := by
  intro equation
  have same : Shape.atom = Shape.compound := shape_eq equation
  cases same

theorem stop_not_parallel
    (arguments : (position : Fin (signature.arity Symbol.par)) →
      Term signature (signature.input Symbol.par position)) :
    ¬ theory.Rel stop (Term.node (signature := signature) Symbol.par arguments) := by
  intro equation
  have same : Shape.stop = Shape.compound := shape_eq equation
  cases same

theorem bang_not_atom (body : Process)
    (arguments : (position : Fin (signature.arity Symbol.atom)) →
      Term signature (signature.input Symbol.atom position)) :
    ¬ theory.Rel (bang body) (Term.node (signature := signature) Symbol.atom arguments) := by
  intro equation
  have same : Shape.compound = Shape.atom := shape_eq equation
  cases same

/-- Whether an atom occurs. Replication keeps the answer and parallel
composition joins the two answers, so the unfolding law is satisfied. -/
def mentionsAtom : Algebra.{0,0,0} signature where
  Carrier _ := Bool
  operation constructor arguments :=
    match (constructor : Symbol), arguments with
    | .stop, _ => false
    | .atom, _ => true
    | .par, arguments => arguments ⟨0, by decide⟩ || arguments ⟨1, by decide⟩
    | .bang, arguments => arguments ⟨0, by decide⟩

theorem mentionsAtom_satisfies (sort : signature.Srt) (left right : Term signature sort)
    (instance' : Unfolding sort left right) :
    mentionsAtom.evaluate left = mentionsAtom.evaluate right := by
  cases instance' with
  | replicate body => exact (Bool.or_self (mentionsAtom.evaluate body)).symm

theorem bang_atom_ne_bang_stop : ¬ theory.Rel (bang atom) (bang stop) := by
  intro equation
  have same : true = false :=
    mentionsAtom.evaluate_eq_of_generated mentionsAtom_satisfies equation
  cases same

/-! ## Openings through the equation -/

abbrev silent : BaseSystem.{0,0,0,0} theory := BaseSystem.silent theory

/-- Every constructor admitted. -/
def complete : signature.Constructor → Prop := fun _ => True

/-- A replicated atom answers the probe for parallel composition, although
its own root is replication. -/
theorem bang_answers_parallel_probe :
    Act silent complete (Label.ask Symbol.par) (.term (bang atom))
      (.bundle Symbol.par (pair (bang atom) atom)) :=
  Act.ask (base := silent) (opened := complete) Symbol.par trivial
    (source := bang atom) (arguments := pair (bang atom) atom) (unfolding atom)

/-- It answers again through a representative three constructors larger.
The reconstruction never chooses among these. -/
theorem bang_answers_through_larger_representative :
    Act silent complete (Label.ask Symbol.par) (.term (bang atom))
      (.bundle Symbol.par (pair (par (bang atom) atom) atom)) :=
  Act.ask (base := silent) (opened := complete) Symbol.par trivial
    (source := bang atom) (arguments := pair (par (bang atom) atom) atom)
    (theory.trans (unfolding atom) (par_rel (unfolding atom) (theory.refl atom)))

theorem unfolded_bisimilar :
    Bisimilar silent complete (.term (bang atom)) (.term (par (bang atom) atom)) :=
  bisimilar_of_rel (unfolding atom)

theorem complete_kit_separates :
    ¬ Bisimilar silent complete (.term atom) (.term stop) :=
  fun related => atom_ne_stop ((bisimilar_iff_rel (fun _ => trivial) atom stop).mp related)

/-! ## The dial -/

/-- With no authored step and no authored observation, all terms of a sort
are bisimilar in the authored system. -/
theorem silent_bisimilar (left right : Process) :
    silent.Bisimilar ⟨(), left⟩ ⟨(), right⟩ := by
  refine ⟨fun first second => first.1 = second.1, ⟨?_, ?_, ?_, ?_⟩, rfl⟩
  · intro _ _ _ label
    exact label.elim
  · intro _ _ _ label
    exact label.elim
  · intro _ _ same
    exact same
  · intro _ _ _ observation
    exact observation.elim

/-- The empty kit relates the atom and the inert process; the complete kit
separates them. -/
theorem gap :
    Bisimilar silent (fun _ => False) (.term atom) (.term stop) ∧
      ¬ Bisimilar silent (fun _ => True) (.term atom) (.term stop) :=
  refinement_strict (silent_bisimilar atom stop) atom_ne_stop

/-- Only the probe for parallel composition. -/
def parallelOnly : signature.Constructor → Prop := fun constructor => constructor = Symbol.par

/-- Neither constant answers the parallel probe, so that kit alone cannot
separate them. -/
theorem parallel_probe_cannot_separate :
    Bisimilar silent parallelOnly (.term atom) (.term stop) := by
  refine ⟨fun source other => source = .term atom ∧ other = .term stop, ⟨?_, ?_, ?_⟩, rfl, rfl⟩
  · rintro _ _ ⟨rfl, rfl⟩ label source' step
    cases label with
    | proper authored => exact authored.elim
    | ask constructor =>
      obtain ⟨permission, value, arguments, sourceShape, -, decomposition⟩ := Act.ask_inv step
      cases permission
      obtain rfl : atom = value := State.term_injective sourceShape
      exact absurd decomposition (atom_not_parallel arguments)
    | get constructor position =>
      obtain ⟨-, arguments, value, sourceShape, -⟩ := Act.get_inv step
      cases sourceShape
    | build constructor =>
      obtain ⟨-, arguments, value, sourceShape, -⟩ := Act.build_inv step
      cases sourceShape
  · rintro _ _ ⟨rfl, rfl⟩ label other' step
    cases label with
    | proper authored => exact authored.elim
    | ask constructor =>
      obtain ⟨permission, value, arguments, sourceShape, -, decomposition⟩ := Act.ask_inv step
      cases permission
      obtain rfl : stop = value := State.term_injective sourceShape
      exact absurd decomposition (stop_not_parallel arguments)
    | get constructor position =>
      obtain ⟨-, arguments, value, sourceShape, -⟩ := Act.get_inv step
      cases sourceShape
    | build constructor =>
      obtain ⟨-, arguments, value, sourceShape, -⟩ := Act.build_inv step
      cases sourceShape
  · rintro _ _ ⟨rfl, rfl⟩ observation
    cases observation with
    | inl sort => exact Iff.rfl
    | inr authored => exact authored.elim

/-- Only the probe for the atom. -/
def atomOnly : signature.Constructor → Prop := fun constructor => constructor = Symbol.atom

theorem atom_supported : Supported atomOnly atom :=
  ⟨rfl, fun position => position.elim0⟩

/-- The atom is built from admitted constructors, so this one probe
separates it from every other class. -/
theorem atom_probe_separates :
    ¬ Bisimilar silent atomOnly (.term atom) (.term stop) :=
  fun related => atom_ne_stop ((bisimilar_iff_rel_of_supported atom_supported stop).mp related)

/-- The root of a replicated atom lies outside this kit. The kit still reads
the term, through the unfolding law, and separates it from the atom. -/
theorem parallel_probe_reads_across_equation :
    ¬ Bisimilar silent parallelOnly (.term (bang atom)) (.term atom) := by
  rintro ⟨relation, bisimulation, related⟩
  obtain ⟨matched, step, -⟩ := bisimulation.1 related (Label.ask Symbol.par)
    (Act.ask (base := silent) (opened := parallelOnly) Symbol.par rfl
      (source := bang atom) (arguments := pair (bang atom) atom) (unfolding atom))
  obtain ⟨-, value, arguments, sourceShape, -, decomposition⟩ := Act.ask_inv step
  obtain rfl : atom = value := State.term_injective sourceShape
  exact atom_not_parallel arguments decomposition

/-- The atom probe cannot reach beneath replication: neither term answers
it, so the kit relates them although they are unequal. -/
theorem atom_probe_blind_beneath_replication :
    Bisimilar silent atomOnly (.term (bang atom)) (.term (bang stop)) ∧
      ¬ theory.Rel (bang atom) (bang stop) := by
  refine ⟨⟨fun source other => source = .term (bang atom) ∧ other = .term (bang stop),
    ⟨?_, ?_, ?_⟩, rfl, rfl⟩, bang_atom_ne_bang_stop⟩
  · rintro _ _ ⟨rfl, rfl⟩ label source' step
    cases label with
    | proper authored => exact authored.elim
    | ask constructor =>
      obtain ⟨permission, value, arguments, sourceShape, -, decomposition⟩ := Act.ask_inv step
      cases permission
      obtain rfl : bang atom = value := State.term_injective sourceShape
      exact absurd decomposition (bang_not_atom atom arguments)
    | get constructor position =>
      obtain ⟨-, arguments, value, sourceShape, -⟩ := Act.get_inv step
      cases sourceShape
    | build constructor =>
      obtain ⟨-, arguments, value, sourceShape, -⟩ := Act.build_inv step
      cases sourceShape
  · rintro _ _ ⟨rfl, rfl⟩ label other' step
    cases label with
    | proper authored => exact authored.elim
    | ask constructor =>
      obtain ⟨permission, value, arguments, sourceShape, -, decomposition⟩ := Act.ask_inv step
      cases permission
      obtain rfl : bang stop = value := State.term_injective sourceShape
      exact absurd decomposition (bang_not_atom stop arguments)
    | get constructor position =>
      obtain ⟨-, arguments, value, sourceShape, -⟩ := Act.get_inv step
      cases sourceShape
    | build constructor =>
      obtain ⟨-, arguments, value, sourceShape, -⟩ := Act.build_inv step
      cases sourceShape
  · rintro _ _ ⟨rfl, rfl⟩ observation
    cases observation with
    | inl sort => exact Iff.rfl
    | inr authored => exact authored.elim

/-! ## The logic -/

/-- The characteristic formula of a replicated atom holds of a term whose
root is parallel composition. -/
theorem characteristic_crosses_roots :
    Holds silent (characteristic (bang atom)) (par (bang atom) atom) :=
  (holds_characteristic_iff silent (bang atom) _).mpr (theory.symm (unfolding atom))

theorem characteristic_separates : ¬ Holds silent (characteristic atom) stop :=
  fun holds => atom_ne_stop (theory.symm ((holds_characteristic_iff silent atom stop).mp holds))

/-- Constructors with no arguments. Each decomposes a term in one way. -/
def leaves : signature.Constructor → Prop := fun constructor => signature.arity constructor = 0

theorem leaves_finiteDecompositions : FiniteDecompositions theory leaves := by
  intro constructor permission whole
  have : IsEmpty (Fin (signature.arity constructor)) := by
    rw [show signature.arity constructor = 0 from permission]
    exact Fin.isEmpty
  exact ⟨Set.univ, Set.finite_univ,
    fun children _ => ⟨children, trivial, fun position => theory.refl _⟩⟩

theorem silent_finiteBranching : FiniteAuthoredBranching silent :=
  fun label => label.elim

/-- With finite conjunctions only, under the finite branching this kit has,
the logic still separates the atom from the inert process. -/
theorem finitary_logic_separates : ¬ FinitaryEquivalent silent leaves atom stop := by
  intro equivalent
  have related :=
    (finitaryEquivalent_iff_bisimilar silent_finiteBranching leaves_finiteDecompositions
      atom stop).mp equivalent
  have supported : Supported leaves atom := ⟨rfl, fun position => position.elim0⟩
  exact atom_ne_stop ((bisimilar_iff_rel_of_supported supported stop).mp related)

/-! ## An authored step, and why its diamond is needed -/

/-- One authored label: the atom, up to the equations, steps to the inert
process. -/
def ticking : BaseSystem.{0,0,0,0} theory where
  Atom := Empty
  observes observation := observation.elim
  observes_resp observation := observation.elim
  Label := Unit
  act _ _ _ start next := theory.Rel start atom ∧ theory.Rel next stop
  act_resp_left := by
    rintro _ _ _ left right next equation ⟨source, target⟩
    exact ⟨next, ⟨theory.trans (theory.symm equation) source, target⟩, theory.refl next⟩
  act_resp_right := by
    rintro _ _ _ start next next' ⟨source, target⟩ equation
    exact ⟨source, theory.trans (theory.symm equation) target⟩

theorem atom_ticks : ticking.act () atom stop := ⟨theory.refl atom, theory.refl stop⟩

theorem stop_is_inert (next : Process) : ¬ ticking.act () stop next :=
  fun step => atom_ne_stop (theory.symm step.1)

/-- A formula built from structural connectives alone uses an admitted
constructor at its root. With nothing admitted there is none. -/
theorem no_structural_formula_without_instruments {Atom Proper : Type}
    {sort : signature.Srt} (formula : Formula signature Atom Proper sort)
    (structural : formula.Structural) (allowed : formula.Allowed (fun _ => False)) : False := by
  cases formula with
  | conj parts => exact structural
  | neg inner => exact structural
  | atom observation => exact structural
  | proper label next inner => exact structural
  | node constructor arguments => exact allowed.1

/-- The authored diamond tells the two terms apart. -/
theorem authored_diamond_separates :
    Holds ticking (Formula.proper () () Formula.top) atom ∧
      ¬ Holds ticking (Formula.proper () () Formula.top) stop :=
  ⟨⟨stop, atom_ticks, holds_top ticking stop⟩,
    fun ⟨next, step, _⟩ => stop_is_inert next step⟩

/-- With nothing admitted, the two terms are not bisimilar, while every
admitted structural formula transfers between them because there is none.
Adequacy for a partial kit therefore needs the authored diamond. -/
theorem empty_kit_needs_authored_diamond :
    ¬ Bisimilar ticking (fun _ => False) (.term atom) (.term stop) ∧
      ∀ formula : Formula signature ticking.Atom ticking.Label (), formula.Structural →
        formula.Allowed (fun _ => False) → Holds ticking formula atom → Holds ticking formula stop := by
  refine ⟨fun related => ?_, fun formula structural allowed =>
    (no_structural_formula_without_instruments formula structural allowed).elim⟩
  have equivalent :=
    (logicallyEquivalent_iff_bisimilar ticking (fun _ => False) atom stop).mpr related
  have allowed : (Formula.proper () () Formula.top :
      Formula signature ticking.Atom ticking.Label ()).Allowed (fun _ => False) :=
    fun index => index.elim
  exact authored_diamond_separates.2 ((equivalent _ allowed).mp authored_diamond_separates.1)

end Mettapedia.OSLF.Framework.SortedInstrumentCongruence.Controls
