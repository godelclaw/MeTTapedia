import Mettapedia.OSLF.Framework.SuccessorFrontier
import Mathlib.Logic.Relation

/-!
# Checked finite equation classes and occurrence frontiers

A certificate supplies finite equation walks from one source. The checker
validates every walk and checks closure under independently enumerated equation
neighbors. Closure of these representatives under the equivalence generated by
the equations is then a theorem, not a certificate field.

Primitive occurrences are enumerated separately. Their source representatives
and authored receipts remain visible; endpoint observations forget that data.
Equation proof detours justify a representative and do not increment the count
of primitive occurrences. The modalities below concern outgoing successors,
not the incoming adjoint OSLF box.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.Framework.FiniteEquationCoverage

universe u v

variable {Term : Type u}

/-- A walk records successive equation-neighbor states after its initial state. -/
def walkEnd (source : Term) : List Term → Term
  | [] => source
  | next :: rest => walkEnd next rest

/-- Equation walks are checked against the supplied finite neighbor query. -/
def checkWalk [DecidableEq Term] (neighbors : Term → List Term)
    (source : Term) : List Term → Bool
  | [] => true
  | next :: rest => decide (next ∈ neighbors source) && checkWalk neighbors next rest

/-- A finite certificate retains equation walks, rather than merely endpoints. -/
structure Certificate (Term : Type u) where
  walks : List (List Term)
  deriving Repr

/-- The original source and all endpoints witnessed by the certificate. -/
def Certificate.representatives (certificate : Certificate Term)
    (source : Term) : List Term :=
  source :: certificate.walks.map (walkEnd source)

/-- Every represented state must have all its equation neighbors represented. -/
def checkClosure [DecidableEq Term] (neighbors : Term → List Term)
    (representatives : List Term) : Bool :=
  representatives.all (fun state =>
    (neighbors state).all (fun next => decide (next ∈ representatives)))

/-- Walk validity and finite equation closure are distinct executable checks. -/
def Certificate.check [DecidableEq Term] (certificate : Certificate Term)
    (neighbors : Term → List Term) (source : Term) : Bool :=
  certificate.walks.all (checkWalk neighbors source) &&
    checkClosure neighbors (certificate.representatives source)

/-- The two conditions tested by the executable certificate checker. -/
theorem check_spec [DecidableEq Term] (certificate : Certificate Term)
    (neighbors : Term → List Term) (source : Term) :
    certificate.check neighbors source = true ↔
      (∀ walk ∈ certificate.walks, checkWalk neighbors source walk = true) ∧
        (∀ representative ∈ certificate.representatives source,
          ∀ next ∈ neighbors representative, next ∈ certificate.representatives source) := by
  simp [Certificate.check, checkClosure, List.all_eq_true]

/-- An equation neighbor outside the certificate prevents completeness. -/
theorem omitted_neighbor_rejected [DecidableEq Term]
    (certificate : Certificate Term) (neighbors : Term → List Term)
    (source representative next : Term)
    (represented : representative ∈ certificate.representatives source)
    (neighbor : next ∈ neighbors representative)
    (omitted : next ∉ certificate.representatives source) :
    certificate.check neighbors source = false := by
  cases result : certificate.check neighbors source with
  | false => rfl
  | true =>
      have included := (check_spec certificate neighbors source).mp result
      exact False.elim (omitted (included.2 representative represented next neighbor))

@[simp] theorem source_mem_representatives (certificate : Certificate Term)
    (source : Term) : source ∈ certificate.representatives source := by
  simp [Certificate.representatives]

theorem checkWalk_sound [DecidableEq Term]
    (equation : Term → Term → Prop) (neighbors : Term → List Term)
    (neighbors_sound : ∀ source next, next ∈ neighbors source →
      equation source next ∨ equation next source)
    (source : Term) (walk : List Term)
    (checked : checkWalk neighbors source walk = true) :
    Relation.EqvGen equation source (walkEnd source walk) := by
  induction walk generalizing source with
  | nil => exact .refl source
  | cons next rest ih =>
      simp only [checkWalk, Bool.and_eq_true, decide_eq_true_eq] at checked
      have edge : Relation.EqvGen equation source next := by
        rcases neighbors_sound source next checked.1 with forward | reverse
        · exact .rel source next forward
        · exact .symm next source (.rel next source reverse)
      exact .trans source next _ edge (ih next checked.2)

theorem checkClosure_spec [DecidableEq Term]
    (neighbors : Term → List Term) (representatives : List Term) :
    checkClosure neighbors representatives = true ↔
      ∀ source ∈ representatives, ∀ next ∈ neighbors source,
        next ∈ representatives := by
  simp [checkClosure, List.all_eq_true]

/-- A closed finite set stays closed under every equation conversion, including
symmetry and arbitrarily long compositions. -/
theorem eqvGen_membership_of_closed
    (equation : Term → Term → Prop) (representatives : List Term)
    (closed : ∀ source ∈ representatives, ∀ next,
      equation source next ∨ equation next source → next ∈ representatives)
    {source next : Term} (conversion : Relation.EqvGen equation source next) :
    source ∈ representatives ↔ next ∈ representatives := by
  induction conversion with
  | rel source next edge =>
      constructor
      · intro member
        exact closed source member next (Or.inl edge)
      · intro member
        exact closed next member source (Or.inr edge)
  | refl => exact Iff.rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ first second => exact first.trans second

/-- Passing the checker establishes exactly the entire equation class. The
neighbor contract is independent one-step enumeration, not class completeness. -/
theorem representatives_spec [DecidableEq Term]
    (equation : Term → Term → Prop) (neighbors : Term → List Term)
    (neighbors_spec : ∀ source next, next ∈ neighbors source ↔
      equation source next ∨ equation next source)
    (certificate : Certificate Term) (source : Term)
    (checked : certificate.check neighbors source = true) (next : Term) :
    next ∈ certificate.representatives source ↔
      Relation.EqvGen equation source next := by
  have checked' := checked
  simp only [Certificate.check, Bool.and_eq_true, List.all_eq_true] at checked'
  constructor
  · intro member
    simp only [Certificate.representatives, List.mem_cons, List.mem_map] at member
    rcases member with equal | ⟨walk, member, equal⟩
    · subst next
      exact .refl source
    · subst next
      exact checkWalk_sound equation neighbors
        (fun initial target h => (neighbors_spec initial target).mp h)
        source walk (checked'.1 walk member)
  · intro conversion
    apply (eqvGen_membership_of_closed equation
      (certificate.representatives source) _ conversion).mp
        (source_mem_representatives certificate source)
    intro initial member target edge
    exact (checkClosure_spec neighbors _).mp checked'.2 initial member target
      ((neighbors_spec initial target).mpr edge)

/-- A partial provider need only be complete at the represented states. Sound
walk edges and local equation-neighbor completeness suffice for the full class. -/
theorem representatives_spec_of_local_complete [DecidableEq Term]
    (equation : Term → Term → Prop) (neighbors : Term → List Term)
    (neighbors_sound : ∀ source next, next ∈ neighbors source →
      equation source next ∨ equation next source)
    (certificate : Certificate Term) (source : Term)
    (checked : certificate.check neighbors source = true)
    (neighbors_complete : ∀ representative ∈ certificate.representatives source,
      ∀ next, equation representative next ∨ equation next representative →
        next ∈ neighbors representative) (next : Term) :
    next ∈ certificate.representatives source ↔
      Relation.EqvGen equation source next := by
  have conditions := (check_spec certificate neighbors source).mp checked
  constructor
  · intro member
    simp only [Certificate.representatives, List.mem_cons, List.mem_map] at member
    rcases member with equal | ⟨walk, walkMember, equal⟩
    · subst next
      exact .refl source
    · subst next
      exact checkWalk_sound equation neighbors neighbors_sound source walk
        (conditions.1 walk walkMember)
  · intro conversion
    apply (eqvGen_membership_of_closed equation
      (certificate.representatives source) _ conversion).mp
        (source_mem_representatives certificate source)
    intro representative member target edge
    exact conditions.2 representative member target
      (neighbors_complete representative member target edge)

/-- Primitive occurrence evidence is independent of the equation equivalence. -/
def ModuloStep {Occurrence : Type v} (equation : Term → Term → Prop)
    (enabled : Term → Occurrence → Prop) (target : Occurrence → Term)
    (source next : Term) : Prop :=
  ∃ representative occurrence,
    Relation.EqvGen equation source representative ∧
      enabled representative occurrence ∧
        Relation.EqvGen equation (target occurrence) next

/-- Equation saturation supplies the response laws of an actual GSLT. -/
def moduloGSLT {Occurrence : Type v} (equation : Term → Term → Prop)
    (enabled : Term → Occurrence → Prop) (target : Occurrence → Term) :
    Mettapedia.GSLT.GSLT where
  Term := Term
  equations := Relation.EqvGen.setoid equation
  rewrites := ModuloStep equation enabled target
  rewrites_resp_left := by
    intro source source' next equivalent step
    obtain ⟨representative, occurrence, before, firing, after⟩ := step
    exact ⟨next, ⟨representative, occurrence,
      .trans source' source representative (.symm source source' equivalent) before,
      firing, after⟩, .refl next⟩
  rewrites_resp_right := by
    intro source next next' step equivalent
    obtain ⟨representative, occurrence, before, firing, after⟩ := step
    exact ⟨representative, occurrence, before, firing,
      .trans _ next next' after equivalent⟩

/-- This finite occurrence list retains the source representative and the full
primitive receipt. Duplicate equation-walk endpoints are removed before firing
enumeration. Identifying occurrences across different equation representatives
requires a separately specified occurrence-equation relation. -/
def occurrenceFrontier [DecidableEq Term] {Occurrence : Type v}
    (certificate : Certificate Term) (source : Term)
    (occurrences : Term → List Occurrence) : List (Term × Occurrence) :=
  (certificate.representatives source).eraseDups.flatMap (fun representative =>
    (occurrences representative).map (fun occurrence => (representative, occurrence)))

/-- Endpoint readout leaves the retained occurrence frontier available separately. -/
def endpoints {Occurrence : Type v} (target : Occurrence → Term)
    (frontier : List (Term × Occurrence)) : List Term :=
  frontier.map (fun entry => target entry.2)

theorem mem_occurrenceFrontier [DecidableEq Term] {Occurrence : Type v}
    (certificate : Certificate Term) (source representative : Term)
    (occurrences : Term → List Occurrence) (occurrence : Occurrence) :
    (representative, occurrence) ∈ occurrenceFrontier certificate source occurrences ↔
      representative ∈ certificate.representatives source ∧
        occurrence ∈ occurrences representative := by
  simp [occurrenceFrontier, List.mem_flatMap, List.mem_map, Prod.mk.injEq]

/-- The occurrence contract retains the exact representative and authored
occurrence, rather than merely their common target class. -/
theorem occurrenceFrontier_spec [DecidableEq Term] {Occurrence : Type v}
    (equation : Term → Term → Prop) (neighbors : Term → List Term)
    (neighbors_spec : ∀ source next, next ∈ neighbors source ↔
      equation source next ∨ equation next source)
    (enabled : Term → Occurrence → Prop) (occurrences : Term → List Occurrence)
    (occurrences_spec : ∀ source occurrence,
      occurrence ∈ occurrences source ↔ enabled source occurrence)
    (certificate : Certificate Term) (source : Term)
    (checked : certificate.check neighbors source = true)
    (representative : Term) (occurrence : Occurrence) :
    (representative, occurrence) ∈ occurrenceFrontier certificate source occurrences ↔
      Relation.EqvGen equation source representative ∧ enabled representative occurrence := by
  rw [mem_occurrenceFrontier,
    representatives_spec equation neighbors neighbors_spec certificate source checked,
    occurrences_spec]

/-- Saturation of a primitive endpoint relation recovers the same occurrence
semantics. This comparison does not require an executable quotient equality. -/
theorem moduloStep_iff_saturated {Occurrence : Type v}
    (equation : Term → Term → Prop) (enabled : Term → Occurrence → Prop)
    (target : Occurrence → Term) (source next : Term) :
    ModuloStep equation enabled target source next ↔
      ∃ representative endpoint, Relation.EqvGen equation source representative ∧
        (∃ occurrence, enabled representative occurrence ∧ target occurrence = endpoint) ∧
        Relation.EqvGen equation endpoint next := by
  constructor
  · rintro ⟨representative, occurrence, before, firing, after⟩
    exact ⟨representative, target occurrence, before, ⟨occurrence, firing, rfl⟩, after⟩
  · rintro ⟨representative, endpoint, before, ⟨occurrence, firing, equal⟩, after⟩
    exact ⟨representative, occurrence, before, firing, equal ▸ after⟩

section Qualified

variable [DecidableEq Term] {Occurrence : Type v}
    (equation : Term → Term → Prop) (neighbors : Term → List Term)
    (neighbors_spec : ∀ source next, next ∈ neighbors source ↔
      equation source next ∨ equation next source)
    (enabled : Term → Occurrence → Prop) (occurrences : Term → List Occurrence)
    (occurrences_spec : ∀ source occurrence,
      occurrence ∈ occurrences source ↔ enabled source occurrence)
    (target : Occurrence → Term) (certificate : Certificate Term) (source : Term)
    (checked : certificate.check neighbors source = true)

include neighbors_spec occurrences_spec checked

/-- Every listed endpoint is an actual equation-saturated successor. -/
theorem endpoint_sound (entry : Term × Occurrence)
    (member : entry ∈ occurrenceFrontier certificate source occurrences) :
    ModuloStep equation enabled target source (target entry.2) := by
  have admitted := (occurrenceFrontier_spec equation neighbors neighbors_spec
    enabled occurrences occurrences_spec certificate source checked entry.1 entry.2).mp member
  exact ⟨entry.1, entry.2, admitted.1, admitted.2, .refl _⟩

/-- Every semantic successor has a listed occurrence whose target is in its
equation class. Target representatives need not themselves form a finite set. -/
theorem endpoint_coverage (next : Term) :
    (∃ entry ∈ occurrenceFrontier certificate source occurrences,
      Relation.EqvGen equation (target entry.2) next) ↔
        ModuloStep equation enabled target source next := by
  constructor
  · rintro ⟨⟨representative, occurrence⟩, member, after⟩
    have admitted := (occurrenceFrontier_spec equation neighbors neighbors_spec
      enabled occurrences occurrences_spec certificate source checked
      representative occurrence).mp member
    exact ⟨representative, occurrence, admitted.1, admitted.2, after⟩
  · rintro ⟨representative, occurrence, before, firing, after⟩
    exact ⟨(representative, occurrence), (occurrenceFrontier_spec equation neighbors
      neighbors_spec enabled occurrences occurrences_spec certificate source checked
      representative occurrence).mpr ⟨before, firing⟩, after⟩

/-- The actual quotient endpoint readout, retaining a separate physical frontier. -/
def classFrontier : List (Quotient (Relation.EqvGen.setoid equation)) :=
  (occurrenceFrontier certificate source occurrences).map
    (fun entry => Quotient.mk (Relation.EqvGen.setoid equation) (target entry.2))

/-- Quotient membership is exactly semantic outgoing successor membership. -/
theorem classFrontier_spec (next : Term) :
    Quotient.mk (Relation.EqvGen.setoid equation) next ∈
      classFrontier equation occurrences target certificate source ↔
        ModuloStep equation enabled target source next := by
  rw [← endpoint_coverage equation neighbors neighbors_spec enabled occurrences
    occurrences_spec target certificate source checked next]
  simp only [classFrontier, List.mem_map]
  constructor
  · rintro ⟨entry, member, equal⟩
    exact ⟨entry, member, Quotient.exact equal⟩
  · rintro ⟨entry, member, equivalent⟩
    exact ⟨entry, member, Quotient.sound equivalent⟩

/-- An equation-invariant predicate is computed existentially from the actual
frontier, with target conversion accounted for in the proof. -/
theorem any_iff_outgoingDiamond (test : Term → Bool)
    (invariant : ∀ initial next, Relation.EqvGen equation initial next →
      test initial = test next) :
    (endpoints target (occurrenceFrontier certificate source occurrences)).any test = true ↔
      ∃ next, ModuloStep equation enabled target source next ∧ test next = true := by
  rw [List.any_eq_true]
  constructor
  · rintro ⟨next, member, succeeds⟩
    obtain ⟨entry, entryMember, equal⟩ := List.mem_map.mp member
    subst next
    exact ⟨target entry.2, endpoint_sound equation neighbors neighbors_spec
      enabled occurrences occurrences_spec target certificate source checked entry entryMember,
      succeeds⟩
  · rintro ⟨next, step, succeeds⟩
    obtain ⟨entry, member, equivalent⟩ := (endpoint_coverage equation neighbors
      neighbors_spec enabled occurrences occurrences_spec target certificate source
      checked next).mpr step
    exact ⟨target entry.2, List.mem_map.mpr ⟨entry, member, rfl⟩,
      (invariant _ _ equivalent).trans succeeds⟩

/-- The same executable existential readout realizes the generated GSLT diamond. -/
theorem any_iff_gsltDiamond (test : Term → Bool)
    (invariant : ∀ initial next, Relation.EqvGen equation initial next →
      test initial = test next) :
    (endpoints target (occurrenceFrontier certificate source occurrences)).any test = true ↔
      Mettapedia.OSLF.Framework.GSLTTypeSynthesis.gsltDiamond
        (moduloGSLT equation enabled target) (fun next => test next = true) source := by
  have modal := Mettapedia.OSLF.Framework.GSLTTypeSynthesis.gsltDiamond_spec
    (moduloGSLT equation enabled target) (fun next : Term => test next = true) source
  exact (any_iff_outgoingDiamond equation neighbors neighbors_spec enabled occurrences
    occurrences_spec target certificate source checked test invariant).trans modal.symm

/-- Universal folding is the outgoing universal modality. Its finite proof is
valid even if the target equation classes contain infinitely many terms. -/
theorem all_iff_outgoingUniversal (test : Term → Bool)
    (invariant : ∀ initial next, Relation.EqvGen equation initial next →
      test initial = test next) :
    (endpoints target (occurrenceFrontier certificate source occurrences)).all test = true ↔
      ∀ next, ModuloStep equation enabled target source next → test next = true := by
  rw [List.all_eq_true]
  constructor
  · intro universal next step
    obtain ⟨entry, member, equivalent⟩ := (endpoint_coverage equation neighbors
      neighbors_spec enabled occurrences occurrences_spec target certificate source
      checked next).mpr step
    exact (invariant _ _ equivalent).symm.trans
      (universal _ (List.mem_map.mpr ⟨entry, member, rfl⟩))
  · intro universal next member
    obtain ⟨entry, entryMember, equal⟩ := List.mem_map.mp member
    subst next
    exact universal _ (endpoint_sound equation neighbors neighbors_spec
      enabled occurrences occurrences_spec target certificate source checked entry entryMember)

/-- Absence follows only after the finite equation closure and primitive
occurrence enumeration contracts have both been earned. -/
theorem empty_iff_no_step :
    occurrenceFrontier certificate source occurrences = [] ↔
      ¬ ∃ next, ModuloStep equation enabled target source next := by
  constructor
  · intro empty ⟨next, step⟩
    obtain ⟨entry, member, _⟩ := (endpoint_coverage equation neighbors neighbors_spec
      enabled occurrences occurrences_spec target certificate source checked next).mpr step
    simp [empty] at member
  · intro absent
    apply List.eq_nil_iff_forall_not_mem.mpr
    intro entry member
    exact absent ⟨target entry.2, endpoint_sound equation neighbors neighbors_spec
      enabled occurrences occurrences_spec target certificate source checked entry member⟩

end Qualified

end Mettapedia.OSLF.Framework.FiniteEquationCoverage
