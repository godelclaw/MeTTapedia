import Mettapedia.OSLF.Syntax.SortedConstructorContexts

/-!
# Congruences on closed sorted constructor terms

An equation theory on the closed terms of a many-sorted first-order
signature is a sorted equivalence that every constructor respects. The
theory generated by supplied equation instances is the least such relation.
The kernel of an interpretation is another, and it contains the generated
theory whenever the interpretation satisfies the instances; this is how two
terms are shown to lie in different classes.

A policy admits constructors. A term is supported when every constructor
occurring in it is admitted. No size measure, lean representative or
decomposition order is defined here: the results built on this module
recurse on the supplied term itself.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.SortedConstructors

universe u v w

/-- A sorted equivalence on closed terms that every constructor respects. -/
structure Congruence (signature : Signature.{u,v}) where
  Rel : {sort : signature.Srt} → Term signature sort → Term signature sort → Prop
  refl : ∀ {sort : signature.Srt} (term : Term signature sort), Rel term term
  symm : ∀ {sort : signature.Srt} {left right : Term signature sort},
    Rel left right → Rel right left
  trans : ∀ {sort : signature.Srt} {left middle right : Term signature sort},
    Rel left middle → Rel middle right → Rel left right
  node : ∀ (constructor : signature.Constructor)
    {left right : (position : Fin (signature.arity constructor)) →
      Term signature (signature.input constructor position)},
    (∀ position, Rel (left position) (right position)) →
      Rel (Term.node constructor left) (Term.node constructor right)

variable {signature : Signature.{u,v}}

/-- The least congruence containing the supplied equation instances. -/
inductive Generated
    (generators : (sort : signature.Srt) → Term signature sort → Term signature sort → Prop) :
    {sort : signature.Srt} → Term signature sort → Term signature sort → Prop where
  | refl {sort : signature.Srt} (term : Term signature sort) : Generated generators term term
  | generator {sort : signature.Srt} {left right : Term signature sort} :
      generators sort left right → Generated generators left right
  | symm {sort : signature.Srt} {left right : Term signature sort} :
      Generated generators left right → Generated generators right left
  | trans {sort : signature.Srt} {left middle right : Term signature sort} :
      Generated generators left middle → Generated generators middle right →
        Generated generators left right
  | node (constructor : signature.Constructor)
      {left right : (position : Fin (signature.arity constructor)) →
        Term signature (signature.input constructor position)} :
      (∀ position, Generated generators (left position) (right position)) →
        Generated generators (Term.node constructor left) (Term.node constructor right)

namespace Congruence

/-- The equation theory presented by a family of instances. -/
def generated
    (generators : (sort : signature.Srt) → Term signature sort → Term signature sort → Prop) :
    Congruence signature where
  Rel := Generated generators
  refl := Generated.refl
  symm := Generated.symm
  trans := Generated.trans
  node := Generated.node

/-- A congruence containing the instances contains the generated theory. -/
theorem generated_le (other : Congruence signature)
    {generators : (sort : signature.Srt) → Term signature sort → Term signature sort → Prop}
    (contains : ∀ sort left right, generators sort left right → other.Rel left right)
    {sort : signature.Srt} {left right : Term signature sort}
    (equation : (generated generators).Rel left right) : other.Rel left right := by
  induction equation with
  | refl term => exact other.refl term
  | generator supplied => exact contains _ _ _ supplied
  | symm _ inductionHypothesis => exact other.symm inductionHypothesis
  | trans _ _ first second => exact other.trans first second
  | node constructor _ inductionHypothesis => exact other.node constructor inductionHypothesis

/-- Equality is the finest congruence: the theory with no equations. -/
def equality (signature : Signature.{u,v}) : Congruence signature where
  Rel left right := left = right
  refl _ := rfl
  symm := Eq.symm
  trans := Eq.trans
  node constructor _ _ children := congrArg (Term.node constructor) (funext children)

end Congruence

/-- An interpretation of every constructor on a sorted family of carriers. -/
structure Algebra (signature : Signature.{u,v}) where
  Carrier : signature.Srt → Type w
  operation : (constructor : signature.Constructor) →
    ((position : Fin (signature.arity constructor)) →
      Carrier (signature.input constructor position)) →
    Carrier (signature.output constructor)

namespace Algebra

/-- The value of a closed term, computed from the values of its children. -/
def evaluate (algebra : Algebra.{u,v,w} signature) :
    {sort : signature.Srt} → Term signature sort → algebra.Carrier sort
  | _, .node constructor arguments =>
      algebra.operation constructor (fun position => evaluate algebra (arguments position))

@[simp]
theorem evaluate_node (algebra : Algebra.{u,v,w} signature) (constructor : signature.Constructor)
    (arguments : (position : Fin (signature.arity constructor)) →
      Term signature (signature.input constructor position)) :
    algebra.evaluate (Term.node constructor arguments) =
      algebra.operation constructor (fun position => algebra.evaluate (arguments position)) := rfl

/-- Terms with the same value. Every interpretation determines a congruence. -/
def kernel (algebra : Algebra.{u,v,w} signature) : Congruence signature where
  Rel left right := algebra.evaluate left = algebra.evaluate right
  refl _ := rfl
  symm := Eq.symm
  trans := Eq.trans
  node constructor _ _ children := by
    simp only [evaluate_node]
    exact congrArg (algebra.operation constructor) (funext children)

/-- An interpretation satisfying the instances separates no generated equation. -/
theorem evaluate_eq_of_generated (algebra : Algebra.{u,v,w} signature)
    {generators : (sort : signature.Srt) → Term signature sort → Term signature sort → Prop}
    (satisfies : ∀ sort left right, generators sort left right →
      algebra.evaluate left = algebra.evaluate right)
    {sort : signature.Srt} {left right : Term signature sort}
    (equation : (Congruence.generated generators).Rel left right) :
    algebra.evaluate left = algebra.evaluate right :=
  Congruence.generated_le algebra.kernel satisfies equation

end Algebra

/-- Every constructor occurring in the term is admitted by the policy. -/
def Supported (opened : signature.Constructor → Prop) :
    {sort : signature.Srt} → Term signature sort → Prop
  | _, .node constructor arguments =>
      opened constructor ∧ ∀ position, Supported opened (arguments position)

theorem supported_node (opened : signature.Constructor → Prop)
    (constructor : signature.Constructor)
    (arguments : (position : Fin (signature.arity constructor)) →
      Term signature (signature.input constructor position)) :
    Supported opened (Term.node constructor arguments) ↔
      opened constructor ∧ ∀ position, Supported opened (arguments position) := Iff.rfl

theorem Supported.mono {smaller larger : signature.Constructor → Prop}
    (inclusion : ∀ constructor, smaller constructor → larger constructor)
    {sort : signature.Srt} {term : Term signature sort}
    (supported : Supported smaller term) : Supported larger term := by
  induction term with
  | node constructor arguments inductionHypothesis =>
    exact ⟨inclusion constructor supported.1,
      fun position => inductionHypothesis position (supported.2 position)⟩

theorem supported_of_complete {opened : signature.Constructor → Prop}
    (complete : ∀ constructor, opened constructor)
    {sort : signature.Srt} (term : Term signature sort) : Supported opened term := by
  induction term with
  | node constructor arguments inductionHypothesis =>
    exact ⟨complete constructor, inductionHypothesis⟩

end Mettapedia.OSLF.SortedConstructors
