import Mettapedia.OSLF.NativeTypes.Generation.Schemas
import Mettapedia.GSLT.Examples.ScopedLamCongExecution

open Mettapedia.OSLF.Framework

/-!+# Scoped beta through the executable type-system generator

The input keeps the authored lambda grammar and its explicit dependency
metadata. Modal schemas are generated by typing descent. A concrete execution
then captures a lambda body in its dependency context, substitutes its actual
argument and emits a complete native occurrence receipt. The display-law
admission diagnostics are separate from this scoped operational execution.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.NativeTypes.Instances.Lambda.GeneratorConsumer

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL
open GeneralExecutionAdmission GeneralTypedSites
open Mettapedia.GSLT.LanguageDef.WellSorted
open Mettapedia.OSLF.NativeTypes.Generation.TypedOccurrences (Licensed)
open Mettapedia.GSLT.Examples.ScopedPremiseAuthoring (lambdaScoped)
open Mettapedia.GSLT.Examples.ScopedLamCongExecution (betaRule)
open Mettapedia.OSLF.NativeTypes.Modal.Rules (Schema)

def term : TypeExpr := .base "Term"

def language : LanguageDef := {lambdaScoped with rewrites := [betaRule]}

def snapshot : Snapshot :=
  ⟨language, [], {signatures := [], rows := [], dynamicRelations := []}⟩

def fragment : Mettapedia.OSLF.NativeTypes.Generation.LanguageFragment := {}

def chosen := Mettapedia.OSLF.NativeTypes.Generation.selectedSnapshot snapshot fragment

theorem chosen_language : chosen.language = language :=
  Mettapedia.OSLF.NativeTypes.Generation.unrestricted_signature language {}

def vertex : Mettapedia.OSLF.NativeTypes.SortProfiles.Derived.CubeVertex chosen.language :=
  (fun _ => .star, fun _ => .star)

def generated : Mettapedia.OSLF.NativeTypes.Generation.Generated :=
  Mettapedia.OSLF.NativeTypes.Generation.generate snapshot fragment Mettapedia.OSLF.NativeTypes.Structural.finiteLimitFragment vertex

theorem equation_cube_is_whole : Mettapedia.OSLF.NativeTypes.SortProfiles.Derived.center language = Finset.univ :=
  Mettapedia.OSLF.NativeTypes.SortProfiles.Derived.no_equations_whole_cube language (by rfl)

theorem all_generated_schemas_licensed {schema : Schema generated.plan}
    (member : schema ∈ generated.modalCatalogue) :
    schema.bound = [] ∧
      schema.programCarrier ∈ Mettapedia.OSLF.NativeTypes.Generation.Occurrences.sourceCandidates generated.plan.snapshot.language
        schema.declaration.rule ∧
      ∃ site, Licensed generated.plan.snapshot.language (Mettapedia.OSLF.NativeTypes.Generation.Occurrences.ruleFree schema.declaration.rule)
        .all [] schema.programCarrier schema.declaration.rule.left site ∧
        schema.position = site.address ∧ schema.focusBound = site.focusBound ∧
        schema.focusCarrier = site.focusType := by
  change schema ∈ Mettapedia.OSLF.NativeTypes.Generation.schemas generated.plan at member
  exact Mettapedia.OSLF.NativeTypes.Generation.schemas_sound member

theorem every_licensed_typing_descent_is_generated (declaration : RulePlan) (ordinal : Nat)
    (declared : (declaration, ordinal) ∈ generated.plan.rules.zipIdx) (carrier : TypeExpr)
    (candidate : carrier ∈ Mettapedia.OSLF.NativeTypes.Generation.Occurrences.sourceCandidates generated.plan.snapshot.language declaration.rule)
    (site : SiteData)
    (licensed : Licensed generated.plan.snapshot.language (Mettapedia.OSLF.NativeTypes.Generation.Occurrences.ruleFree declaration.rule)
      .all [] carrier declaration.rule.left site) :
    ∃ schema ∈ generated.modalCatalogue,
      schema.declaration = declaration ∧ schema.ordinal = ordinal ∧ schema.bound = [] ∧
      schema.programCarrier = carrier ∧ schema.position = site.address ∧
      schema.focusBound = site.focusBound ∧ schema.focusCarrier = site.focusType := by
  change ∃ schema ∈ Mettapedia.OSLF.NativeTypes.Generation.schemas generated.plan, _
  exact Mettapedia.OSLF.NativeTypes.Generation.schemas_complete declaration ordinal declared carrier candidate site licensed

def argument : Pattern := .apply "Lam" [.lambda none (.bvar 0)]

def body : Pattern := .apply "Lam" [.lambda none (.bvar 1)]

def source : Pattern := .apply "App" [.apply "Lam" [.lambda none body], argument]

def target : Pattern := .apply "Lam" [.lambda none argument]

def request := generated.request [] term source

def execution := generated.execute [] term source 40

def declaration : RulePlan :=
  ⟨0, betaRule, ⟨betaRule.bindings.getD ⟨[], []⟩, .authored⟩⟩

def runtimePlan : Plan :=
  ⟨snapshot, {}, [declaration], [], []⟩

theorem chosen_snapshot : chosen = snapshot := by
  change ({snapshot with language := Mettapedia.OSLF.NativeTypes.Generation.selectedLanguage language ⟨none, {}⟩} : Snapshot) = snapshot
  rw [Mettapedia.OSLF.NativeTypes.Generation.unrestricted_signature]
  rfl

theorem runtime_plan_actual : generated.plan = runtimePlan := by
  change compile chosen {} = runtimePlan
  rw [chosen_snapshot]
  cbv

def literalRequest : GeneralOccurrenceFrontier.Request := ⟨runtimePlan, [], term, source⟩

theorem actual_request : request = literalRequest := by
  change (⟨generated.plan, [], term, source⟩ : GeneralOccurrenceFrontier.Request) = literalRequest
  rw [runtime_plan_actual]
  rfl

theorem literal_start : GeneralOccurrenceFrontier.start literalRequest =
    {agenda := [.visit ⟨source, [], by
      rw [show literalRequest.root = source from
        Pattern.eraseBinderMetadata_eq_self_of_canonical (by decide +kernel)]
      exact .nil source⟩, .universe]} := by
  have canonical : source.eraseBinderMetadata = source :=
    Pattern.eraseBinderMetadata_eq_self_of_canonical (by decide +kernel)
  simp only [GeneralOccurrenceFrontier.start, GeneralOccurrenceFrontier.Request.root,
    literalRequest, runtimePlan, canonical, List.map_nil]
  change (if checkOpenPatternWellSorted language snapshot.free [] term source then _ else _) = _
  rw [show checkOpenPatternWellSorted language snapshot.free [] term source = true from by decide +kernel]
  rfl

structure Readout where
  declarationIndex : Nat
  address : List Nat
  body : Option RuleBinding.ContextualValue
  argument : Option RuleBinding.ContextualValue
  right : Pattern
  target : Pattern
  administration : Nat
  deriving DecidableEq, Repr

def rawReadout (receipt : GeneralOccurrenceSemantics.Receipt) : Readout :=
  ⟨receipt.firing.job.declaration.declarationIndex, receipt.firing.job.site.address,
    ScopedRuleMatching.lookup receipt.firing.completed "B",
    ScopedRuleMatching.lookup receipt.firing.completed "A",
    receipt.firing.job.declaration.rule.right, receipt.target, receipt.conversions.length⟩

def readouts (request : GeneralOccurrenceFrontier.Request) (budget : Nat) : List Readout :=
  (GeneralOccurrenceFrontier.run request budget (GeneralOccurrenceFrontier.start request)).answers.map
    fun receipt => rawReadout receipt.val

def expectedReadout : Readout :=
  ⟨0, [], some ⟨[term], 0, body⟩, some ⟨[], 0, argument⟩,
    .subst (.fvar "B") (.fvar "A"), target, 0⟩

theorem actual_beta_readout : readouts request 40 = [expectedReadout] := by
  rw [actual_request]
  unfold readouts
  rw [literal_start]
  decide +kernel

theorem source_is_typed : OpenPatternWellSorted generated.snapshot.language generated.snapshot.free
    [] term source := by
  exact checkOpenPatternWellSorted_sound (by decide +kernel)

theorem one_actual_answer : execution.answers.length = 1 := by
  have count := congrArg List.length actual_beta_readout
  simpa only [readouts, List.length_map, List.length_singleton, execution,
    Mettapedia.OSLF.NativeTypes.Generation.Generated.execute, request] using count

def receipt : GeneralOccurrenceFrontier.Answer request :=
  execution.answers[0]'(by rw [one_actual_answer]; decide)

theorem receipt_readout : rawReadout receipt.val = expectedReadout := by
  have member : receipt ∈ execution.answers := List.getElem_mem _
  have readoutMember : rawReadout receipt.val ∈ readouts request 40 :=
    List.mem_map.mpr ⟨receipt, member, rfl⟩
  rw [actual_beta_readout] at readoutMember
  exact List.mem_singleton.mp readoutMember

theorem actual_beta_target : receipt.val.target = target :=
  congrArg Readout.target receipt_readout

theorem actual_original_declaration : receipt.val.firing.job.declaration.authored = betaRule := by
  have selected := receipt.property.2.1.1
  change (receipt.val.firing.job.declaration, receipt.val.firing.job.ordinal) ∈ generated.plan.rules.zipIdx at selected
  rw [runtime_plan_actual] at selected
  have origin := List.fst_mem_of_mem_zipIdx selected
  have same : receipt.val.firing.job.declaration = declaration := List.mem_singleton.mp origin
  rw [same]
  rfl

theorem actual_beta_index : receipt.val.firing.job.declaration.declarationIndex = 0 :=
  congrArg Readout.declarationIndex receipt_readout

theorem actual_authored_right_hand_side :
    receipt.val.firing.job.declaration.rule.right = .subst (.fvar "B") (.fvar "A") :=
  congrArg Readout.right receipt_readout

theorem body_dependency_is_retained :
    ScopedRuleMatching.lookup receipt.val.firing.completed "B" =
      some ⟨[term], 0, body⟩ := congrArg Readout.body receipt_readout

theorem argument_is_retained :
    ScopedRuleMatching.lookup receipt.val.firing.completed "A" =
      some ⟨[], 0, argument⟩ := congrArg Readout.argument receipt_readout

theorem primitive_and_administrative_counts :
    (GeneralOccurrenceNativeReceipts.history generated.plan [] term receipt).length = 1 ∧
      GeneralOccurrenceNativeReceipts.administration generated.plan [] term receipt = 0 := by
  exact ⟨GeneralOccurrenceNativeReceipts.primitive_count _ _ _ _,
    congrArg Readout.administration receipt_readout⟩

theorem target_is_typed : OpenPatternWellSorted generated.snapshot.language generated.snapshot.free
    [] term target := by
  have typed := GeneralOccurrenceNativeReceipts.target_typed generated.plan [] term receipt
  dsimp only [Mettapedia.OSLF.NativeTypes.Generation.Generated.plan, GeneralExecutionAdmission.compile] at typed
  simpa only [actual_beta_target] using typed

theorem actual_generated_semantic_beta :
    (GeneralOccurrenceSemantics.gslt generated.plan [] term).Step source target := by
  have step := GeneralOccurrenceSemantics.Receipt.semantic_step generated.plan [] term receipt.property
  have root : request.root = source :=
    Pattern.eraseBinderMetadata_eq_self_of_canonical (by decide +kernel)
  simpa only [root, actual_beta_target] using step

theorem zero_budget_has_no_answer : (generated.execute [] term source 0).answers.length = 0 := by
  change (GeneralOccurrenceFrontier.start request).answers.length = 0
  rw [actual_request, literal_start]
  rfl

def disabledFragment : Mettapedia.OSLF.NativeTypes.Generation.LanguageFragment :=
  {operational := {ruleIndices := some []}}

def disabledChosen := Mettapedia.OSLF.NativeTypes.Generation.selectedSnapshot snapshot disabledFragment

def disabledVertex : Mettapedia.OSLF.NativeTypes.SortProfiles.Derived.CubeVertex disabledChosen.language :=
  (fun _ => .star, fun _ => .star)

def disabled := Mettapedia.OSLF.NativeTypes.Generation.generate snapshot disabledFragment
  Mettapedia.OSLF.NativeTypes.Structural.finiteLimitFragment disabledVertex

theorem disabled_rules_are_absent : disabled.plan.rules = [] := by
  change rules disabledChosen disabledFragment.operational = []
  simp [rules, selectedRules, selected, disabledFragment]

theorem disabled_has_no_receipt (receipt : GeneralOccurrenceFrontier.Answer
    (disabled.request [] term source)) : False := by
  have origin := receipt.property.2.1.1
  change (receipt.val.firing.job.declaration, receipt.val.firing.job.ordinal) ∈
    disabled.plan.rules.zipIdx at origin
  rw [disabled_rules_are_absent] at origin
  exact List.not_mem_nil origin

theorem disabled_execution_has_no_answers (budget : Nat) :
    (disabled.execute [] term source budget).answers = [] := by
  apply List.eq_nil_iff_forall_not_mem.mpr
  intro receipt _
  exact disabled_has_no_receipt receipt

theorem selecting_no_rules_changes_execution :
    (disabled.execute [] term source 40).answers.length = 0 ∧ execution.answers.length = 1 := by
  refine ⟨?_, one_actual_answer⟩
  rw [disabled_execution_has_no_answers]
  rfl

end Mettapedia.OSLF.NativeTypes.Instances.Lambda.GeneratorConsumer
