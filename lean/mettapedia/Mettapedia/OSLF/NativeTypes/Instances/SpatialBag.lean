import Mettapedia.OSLF.NativeTypes.Decision.Spatial.BagModel
import Mettapedia.OSLF.NativeTypes.Runtime.Search

/-!
# Installed finite answer-bag observation algebra

`Atom` is an abstract payload sort interpreted by existing `Pattern` values.
The declared `AnswerBag` former collects these payloads without interpreting
their internal object-language syntax. This installed model is the completed
answer observation, not a new implementation of the language that produced
the answers. Its source correspondence is supplied by each consumer.

The public runtime handles formula admission, one shared work budget and
resumption. Structural split candidates are generated by a delayed stream;
starting a session does not construct the exponential decomposition list.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.NativeTypes.Instances.SpatialBag

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.GeneralExecutionAdmission
open Mettapedia.OSLF.NativeTypes.Generation
open Mettapedia.OSLF.NativeTypes.Decision.Spatial
open Mettapedia.OSLF.NativeTypes.Decision.Reference
open Mettapedia.OSLF.NativeTypes.Decision.Machine
open Mettapedia.OSLF.NativeTypes.Decision.Scheduling
open Mettapedia.OSLF.NativeTypes.Runtime
open Mettapedia.OSLF.NativeTypes.Runtime.Description

def bagFormer : GrammarRule where
  label := "AnswerBag"
  category := "Answers"
  params := [.simple "items" (.collection .hashBag (.base "Atom"))]
  syntaxPattern := [.terminal "{", .nonTerminal "items", .terminal "}"]

def language : LanguageDef where
  name := "MeTTaAnswerBag"
  types := ["Atom", "Answers"]
  terms := [bagFormer]
  equations := []
  rewrites := []

def snapshot : Snapshot := ⟨language, [], ⟨[], [], []⟩⟩
def fragment : LanguageFragment := {operational := {sites := .rootOnly}}
def chosen : Snapshot := selectedSnapshot snapshot fragment
def vertex : Mettapedia.OSLF.NativeTypes.SortProfiles.Derived.CubeVertex chosen.language :=
  (fun _ => .star, fun _ => .star)
def generated : Generated :=
  generate snapshot fragment Mettapedia.OSLF.NativeTypes.Structural.heytingFragment vertex

theorem generated_language : generated.snapshot.language = language := by
  change (selectedSnapshot snapshot fragment).language = language
  simp only [selectedSnapshot, fragment, unrestricted_signature]
  rfl

theorem declared_bag_former : generated.snapshot.language.terms = [bagFormer] := by
  rw [generated_language]
  rfl

theorem no_operational_rules : generated.snapshot.language.rewrites = [] := by
  rw [generated_language]
  rfl

def decode : (raw : Pattern) → Except SourceIssue
    {items : List Pattern // True ∧ BagModel.encode items = raw}
  | .collection .hashBag items none => .ok ⟨items, trivial, rfl⟩
  | _ => .error .outsideProfile

theorem decode_complete (raw : Pattern)
    (represented : ∃ items : List Pattern, True ∧ BagModel.encode items = raw) :
    (decode raw).isOk = true := by
  obtain ⟨items, _, rfl⟩ := represented
  rfl

def leafAdmission : Mettapedia.OSLF.NativeTypes.Decision.Admission.LeafAdmission BagModel.Leaf where
  admitted _ := True
  probe _ := .ok ()
  exact _ := ⟨fun _ => trivial, fun _ => rfl⟩
  spatial index := index == 0

def driver : Driver where
  generated := generated
  expected := .collection .hashBag (.base "Atom")
  system := BagModel.system
  admitted _ := True
  render := BagModel.encode
  render_injective := by
    intro first second same
    exact (Pattern.collection.inj same).2.1
  decode := decode
  decode_complete := decode_complete
  backend := BagModel.backend
  Leaf := BagModel.Leaf
  tests := BagModel.tests
  leafAdmission := leafAdmission
  lookup name := if name = "emp" then some .emp else none
  spatial_admission := rfl
  spatialLookup name := if name = "bag" then some 0 else none

private def mapStream {α β : Type} (transform : α → β) : Stream α → Stream β
  | .done => .done
  | .pause next => .pause (fun _ => mapStream transform (next ()))
  | .yield value next => .yield (transform value) (fun _ => mapStream transform (next ()))

private theorem flatten_mapStream {α β : Type} (transform : α → β) (stream : Stream α) :
    (mapStream transform stream).flatten = stream.flatten.map transform := by
  induction stream with
  | done => rfl
  | pause next ih => exact ih ()
  | yield value next ih => exact congrArg (List.cons _) (ih ())

def splitStream : List Pattern → Stream (List Pattern × List Pattern)
  | [] => .yield ([], []) (fun _ => .done)
  | item :: rest => .pause fun _ =>
      (mapStream (fun pair => (item :: pair.1, pair.2)) (splitStream rest)).append
        (fun _ => mapStream (fun pair => (pair.1, item :: pair.2)) (splitStream rest))

theorem splitStream_exact (items : List Pattern) :
    (splitStream items).flatten = BagSplits.enumerate items := by
  induction items with
  | nil => rfl
  | cons item rest ih =>
    simp only [splitStream, Stream.flatten, Stream.flatten_append, flatten_mapStream, ih,
      BagSplits.enumerate]

def cursor : CursorBackend BagModel.system (fun _ => True) where
  Receipt _ := Empty
  target _ receipt := receipt.elim
  tasks _ := .done
  sound _ receipt _ := receipt.elim
  coverage _ _ _ impossible := impossible.elim
  target_admitted _ _ receipt _ := receipt.elim
  spatial := BagModel.splitBackend
  splitTasks index items := if index = 0 then splitStream items else .done
  splitTasks_exact index items := by
    by_cases selected : index = 0
    · simp only [selected, ↓reduceIte, splitStream_exact, BagModel.splitBackend]
    · simp only [selected, ↓reduceIte, Stream.flatten, BagModel.splitBackend]

def leaves : BagModel.Leaf → LeafBackend BagModel.system (fun _ => True) := fun leaf =>
  .ofBoolean (BagModel.predicate leaf) (BagModel.evalLeaf leaf) (BagModel.evalLeaf_exact leaf)

def engine : Engine driver where
  cursor := cursor
  leaves := leaves
  leaf_meaning _ := rfl
  spatial_meaning := rfl

def installed : Installed := ⟨driver, engine⟩

theorem admitted_profile : driver.profileAdmission = some true := rfl

theorem packet_formed (expected : List Pattern) :
    Mettapedia.OSLF.NativeTypes.Decision.Admission.Formed
      driver.generated.logicFragment driver.leafAdmission (BagModel.packet expected) := by
  induction expected with
  | nil => exact .atom BagModel.Leaf.emp trivial
  | cons value rest ih =>
    exact .separating rfl rfl (.atom (BagModel.Leaf.singleton value) trivial) ih

theorem atLeast_formed (value : Pattern) (count : Nat) :
    Mettapedia.OSLF.NativeTypes.Decision.Admission.Formed
      driver.generated.logicFragment driver.leafAdmission (BagModel.atLeast value count) := by
  induction count with
  | zero => exact .top rfl
  | succ count ih =>
    exact .separating rfl rfl (.atom (BagModel.Leaf.singleton value) trivial) ih

theorem meaning_at_bag (formula : Core.Formula BagModel.Leaf) (items : List Pattern) :
    Meaning driver formula (BagModel.encode items) ↔ BagModel.holds formula items := by
  exact meaning_at_decoded driver formula (BagModel.encode items) ⟨items, trivial, rfl⟩

end Mettapedia.OSLF.NativeTypes.Instances.SpatialBag
