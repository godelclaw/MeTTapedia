import Mettapedia.OSLF.Framework.RelationalAnswerTypeSynthesis
import Mettapedia.PLN.Bridges.GSLT.EvidenceCalculusSemantics

/-!
# Native answer types for guarded PLN evidence revision

This finite semantic consumer models the exact additive revision branch.
Proof origins identify stored derivations; observation IDs identify the
samples counted by those derivations. Distinct proof origins do not imply
disjoint evidence. Lookup, exact count summaries, evidence disjointness and a
fresh publication origin are checked before publishing a revision.

The behavioral type is generated by the existing relational-answer OSLF
construction. This module does not decode PeTTaChainer proof terms, implement
its confidence-based overlap fallback, or claim stochastic independence.
-/

set_option autoImplicit false

namespace Mettapedia.OSLF.NativeTypes.Consumers.PLNEvidence

open Mettapedia.GSLT.LanguageDef.FirstOrderCalculus
open Mettapedia.PLN.WorldModel EvidenceContracts EvidenceSpaces
open Mettapedia.GSLT.Dynamics.RelationalAnswerEvaluation
open Mettapedia.OSLF.Framework.GSLTTypeSynthesis
open Mettapedia.OSLF.Framework.RelationalAnswerTypeSynthesis
open Mettapedia.PLN.Bridges.GSLT.EvidenceCalculusModule
open Mettapedia.PLN.Bridges.GSLT.EvidenceCalculusSemantics

structure Proof (observations : Nat) where
  origin : Nat
  support : Finset (Fin observations)
  counts : Nat × Nat
  parents : List Nat
  deriving DecidableEq

structure State (observations : Nat) where
  truth : Fin observations → Bool
  proofs : List (Proof observations)

structure Request where
  first : Nat
  second : Nat
  publication : Nat
  deriving DecidableEq, Repr

variable {observations : Nat}

def lookup (state : State observations) (origin : Nat) : Option (Proof observations) :=
  state.proofs.find? fun proof => proof.origin == origin

def counts (state : State observations) (support : Finset (Fin observations)) : Nat × Nat :=
  let evidence := ledgerEvidence state.truth id support
  (evidence.pos, evidence.neg)

def Ready (state : State observations) (request : Request)
    (first second : Proof observations) : Prop :=
  first.counts = counts state first.support ∧ second.counts = counts state second.support ∧
    Disjoint first.support second.support ∧
    request.publication ∉ state.proofs.map Proof.origin

instance (state : State observations) (request : Request) (first second : Proof observations) :
    Decidable (Ready state request first second) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _))

def merge (request : Request) (first second : Proof observations) : Proof observations :=
  ⟨request.publication, first.support ∪ second.support,
    (first.counts.1 + second.counts.1, first.counts.2 + second.counts.2), [first.origin, second.origin]⟩

def publish (state : State observations) (proof : Proof observations) : State observations :=
  ⟨state.truth, state.proofs ++ [proof]⟩

/-- The publication relation is stated independently of the executable
lookup/check routine. Its count premises are the ledger reading of the PLN
module's two evidence judgments and disjointness contract. -/
inductive Revises : State observations → Request → State observations → List (Proof observations) → Prop where
  | revise {state : State observations} {request : Request} {first second : Proof observations} :
      lookup state request.first = some first → lookup state request.second = some second →
      Ready state request first second →
      Revises state request (publish state (merge request first second)) [merge request first second]

def revise? (state : State observations) (request : Request) : Option (State observations × Proof observations) := do
  let first ← lookup state request.first
  let second ← lookup state request.second
  if Ready state request first second then
    pure (publish state (merge request first second), merge request first second)
  else none

theorem revise?_exact (state : State observations) (request : Request)
    (final : State observations) (answer : Proof observations) :
    revise? state request = some (final, answer) ↔ Revises state request final [answer] := by
  constructor
  · intro computed
    unfold revise? at computed
    cases left : lookup state request.first with
    | none => simp [left] at computed
    | some first =>
      cases right : lookup state request.second with
      | none => simp [left, right] at computed
      | some second =>
        by_cases ready : Ready state request first second
        · simp [left, right, ready] at computed
          obtain ⟨rfl, rfl⟩ := computed
          exact .revise left right ready
        · simp [left, right, ready] at computed
  · intro execution
    cases execution with
    | revise left right ready => simp [revise?, left, right, ready]

theorem lookup_origin {state : State observations} {origin : Nat} {proof : Proof observations}
    (found : lookup state origin = some proof) : proof.origin = origin :=
  beq_iff_eq.mp (List.find?_some (p := fun entry : Proof observations => entry.origin == origin) found)

theorem merge_exact {state : State observations} {request : Request} {first second : Proof observations}
    (ready : Ready state request first second) :
    (merge request first second).counts = counts state (merge request first second).support := by
  have exact := congrArg (fun evidence : Evidence ℕ => (evidence.pos, evidence.neg))
    (ledgerEvidence_union_of_disjoint state.truth id ready.2.2.1)
  simp only [Evidence.add_pos, Evidence.add_neg] at exact
  simpa only [merge, ready.1, ready.2.1, counts] using exact.symm

def evidenceOf (summary : Nat × Nat) : Evidence ℕ := ⟨summary.1, summary.2⟩

/-- A finite identified-observation model of the existing calculus. The two
evidence variables retain the selected proofs' actual supports and stored
summaries, so malformed summaries do not become true by interpretation. -/
noncomputable def ledgerModel (state : State observations) (first second : Proof observations) :
    Ledger.Model :=
  { Id := Fin observations
    W := Bool
    world := state.truth
    interp :=
      { query := fun _ => id
        ledger := fun name => if name = "e1" then first.support else second.support
        summary := fun name => evidenceOf (if name = "e1" then first.counts else second.counts)
        priorStrength := 1
        priorStrength_pos := one_pos } }

/-- The executable guards discharge the actual declared PLN revision rule's
premises. Soundness is inherited from its independent ledger semantics. -/
theorem ready_module_revision {state : State observations} {request : Request}
    {first second : Proof observations} (ready : Ready state request first second) :
    Ledger.Model.holds (ledgerModel state first second) (evidenceRules[0]).conclusion := by
  apply revise_sound (evidenceRules[0]) (by simp [evidenceCalculus, evidenceRules]) rfl
  simp only [evidenceRules, List.getElem_cons_zero, rule, List.mem_cons,
    List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq]
  have firstExact : evidenceOf first.counts = ledgerEvidence state.truth id first.support := by
    rw [ready.1]
    rfl
  have secondExact : evidenceOf second.counts = ledgerEvidence state.truth id second.support := by
    rw [ready.2.1]
    rfl
  constructor
  · exact ⟨id, first.support, evidenceOf first.counts, rfl, rfl, rfl, firstExact⟩
  constructor
  · exact ⟨id, second.support, evidenceOf second.counts, rfl, rfl, rfl, secondExact⟩
  · exact ⟨first.support, second.support, rfl, rfl, ready.2.2.1⟩

def source : RelationalAnswerSource (State observations) Request (Proof observations) := ⟨Revises⟩

/-- The answer must have the requested fresh origin, retain the ordered
input origins, give exact counts, and occur in the published proof store. -/
def observation (initial : State observations) (request : Request) (final : State observations)
    (answer : Proof observations) : Prop :=
  answer.origin = request.publication ∧ answer.parents = [request.first, request.second] ∧
    answer.counts = counts initial answer.support ∧ answer ∈ final.proofs

theorem revision_observation {initial final : State observations} {request : Request}
    {answers : List (Proof observations)} (execution : Revises initial request final answers) :
    ∃ answer, answers = [answer] ∧ observation initial request final answer := by
  cases execution with
  | revise left right ready =>
    refine ⟨_, rfl, rfl, ?_, merge_exact ready, ?_⟩
    · simp only [merge, lookup_origin left, lookup_origin right]
    · simp [publish]

def nativeType (observations : Nat) :=
  producesAnswerNativeType (source (observations := observations)) observation

def check (state : State observations) (request : Request) : Bool := (revise? state request).isSome

theorem check_ready_exact {state : State observations} {request : Request}
    {first second : Proof observations}
    (left : lookup state request.first = some first)
    (right : lookup state request.second = some second) :
    check state request = true ↔ Ready state request first second := by
  by_cases ready : Ready state request first second <;>
    simp [check, revise?, left, right, ready]

theorem shared_evidence_rejected {state : State observations} {request : Request}
    {first second : Proof observations}
    (left : lookup state request.first = some first)
    (right : lookup state request.second = some second)
    (shared : ¬ Disjoint first.support second.support) :
    check state request = false := by
  apply Bool.eq_false_iff.mpr
  intro accepted
  exact shared ((check_ready_exact left right).mp accepted).2.2.1

/-- The finite guard decision computes membership in an actual generated
two-diamond native type, with independent publication/count observations. -/
theorem check_native_exact (state : State observations) (request : Request) :
    check state request = true ↔
      (gsltOSLF (evaluationGSLT (source (observations := observations)))).satisfies
        (.request state request) (nativeType observations).pred := by
  change (revise? state request).isSome = true ↔
    producesAnswerSatisfying source observation (.request state request)
  rw [producesAnswerSatisfying_request_iff]
  constructor
  · intro accepted
    obtain ⟨⟨final, answer⟩, computed⟩ := Option.isSome_iff_exists.mp accepted
    have execution := (revise?_exact state request final answer).mp computed
    obtain ⟨observed, same, holds⟩ := revision_observation execution
    refine ⟨final, [answer], ⟨0, by simp⟩, execution, ?_⟩
    cases List.singleton_inj.mp same
    exact holds
  · rintro ⟨final, answers, occurrence, execution, _⟩
    obtain ⟨answer, same, _⟩ := revision_observation execution
    subst answers
    exact Option.isSome_iff_exists.mpr ⟨(final, answer), (revise?_exact state request final answer).mpr execution⟩

/-- Membership gives actual selected proof origins whose disjoint evidence
satisfies the declared module rule, not just an accepted Boolean summary. -/
theorem native_module_sound {state : State observations} {request : Request}
    (member : (gsltOSLF (evaluationGSLT (source (observations := observations)))).satisfies
      (.request state request) (nativeType observations).pred) :
    ∃ first second, lookup state request.first = some first ∧
      lookup state request.second = some second ∧ Disjoint first.support second.support ∧
      Ledger.Model.holds (ledgerModel state first second) (evidenceRules[0]).conclusion := by
  change producesAnswerSatisfying source observation (.request state request) at member
  obtain ⟨final, answers, occurrence, execution, _⟩ :=
    (producesAnswerSatisfying_request_iff source observation state request).mp member
  cases execution with
  | revise left right ready =>
    exact ⟨_, _, left, right, ready.2.2.1, ready_module_revision ready⟩

end Mettapedia.OSLF.NativeTypes.Consumers.PLNEvidence
