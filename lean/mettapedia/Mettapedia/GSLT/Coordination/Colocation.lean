import Mettapedia.GSLT.Coordination.HomeLocation
import Mathlib.Logic.Relation

/-!
# Commits across owners by co-location: exactly how much must move together

A commit whose footprint lies at several homes can be made local by giving those regions one home.
This module says exactly which regions must share a home, and that moving a region does not
change the atomic store.

Labels are grouped into **shards** (`shard : R → G`), the unit of placement; a placement gives each
shard a home (`home : G → L`). A commit **touches** a shard when it takes or keeps an occurrence
there or queries a region that meets it.

## Which shards must share a home

* **A placement makes every commit local exactly when it is constant on the classes of the
  touch-together relation** (`homeable_iff`): two shards touched by one commit must share a home,
  and so must every two shards linked by a chain of commits. So the least co-location is the
  partition of shards into these classes, and every placement that makes the program local
  factors through it (`factors_through_classes`).
* **A local placement gives an atomic program** (`homedAt_of_homeable`): every commit is homed at
  its shards' home, so `HomeLocation.run_refines` applies.
* Control (`Controls.chain_forces`): commits touching `A, B` and `B, C` force `A` and `C` onto one
  home although no commit touches both.

## Moving a region

* **A move is invisible to the atomic store** (`move_whole`): moving every stored occurrence of a
  shard to a new home, after its messages in flight are delivered, leaves the union of all stores
  and messages unchanged, and the network invariant holds for the new placement
  (`move_inv`).
* **So a run with moves in between is an atomic run** (`moved_run_refines`, through
  `OccurrenceCommits.executable_append_iff`): the commits before the move and those after it, under
  their placements, form one executable run of the atomic semantics.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Coordination.Colocation

open Mettapedia.Languages.ProcessCalculi.MeTTaCalculus.OccurrenceCommits
open Mettapedia.GSLT.Coordination.ReplicaMerge
open Mettapedia.GSLT.Coordination.HomeLocation

universe u v w x

variable {O : Type u} [DecidableEq O] {R : Type v} {G : Type w} {L : Type x} [DecidableEq L]
variable (label : O → R) (shard : R → G)

/-- A commit touches a shard. -/
def Touches (c : Commit O R) (g : G) : Prop :=
  (∃ o ∈ c.taken ∪ c.kept, shard (label o) = g) ∨ ∃ read ∈ c.queries, ∃ r, read.region r = true ∧ shard r = g

/-- A placement makes a commit local: one home holds every shard it touches. -/
def Homeable (home : G → L) (c : Commit O R) : Prop := ∃ l, ∀ g, Touches label shard c g → home g = l

/-- Two shards touched by one commit of the program. -/
def CoTouch (program : List (Commit O R)) (g g' : G) : Prop :=
  ∃ c ∈ program, Touches label shard c g ∧ Touches label shard c g'

/-- Linked by a chain of commits: the equivalence generated by touching together. -/
def Linked (program : List (Commit O R)) : G → G → Prop :=
  Relation.EqvGen (CoTouch label shard program)

variable {label shard}

omit [DecidableEq L] in
/-- **A placement makes every commit local exactly when it is constant on linked shards.** -/
theorem homeable_iff (program : List (Commit O R)) (home : G → L) [Nonempty L] :
    (∀ c ∈ program, Homeable label shard home c) ↔
      ∀ g g', Linked label shard program g g' → home g = home g' := by
  constructor
  · intro homeable g g' linked
    induction linked with
    | rel a b coTouch =>
        obtain ⟨c, inProgram, touchA, touchB⟩ := coTouch
        obtain ⟨l, atL⟩ := homeable c inProgram
        rw [atL a touchA, atL b touchB]
    | refl => rfl
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂
  · intro constant c inProgram
    by_cases some : ∃ g, Touches label shard c g
    · obtain ⟨g₀, touch₀⟩ := some
      exact ⟨home g₀, fun g touch => constant g g₀ (Relation.EqvGen.rel _ _ ⟨c, inProgram, touch, touch₀⟩)⟩
    · push Not at some
      exact ⟨Classical.arbitrary L, fun g touch => absurd touch (some g)⟩

omit [DecidableEq L] in
/-- **Every local placement factors through the classes of linked shards.** -/
theorem factors_through_classes (program : List (Commit O R)) (home : G → L) [Nonempty L]
    (homeable : ∀ c ∈ program, Homeable label shard home c) :
    ∃ onClasses : Quot (Linked label shard program) → L, ∀ g, home g = onClasses (Quot.mk _ g) :=
  ⟨Quot.lift home fun g g' linked => (homeable_iff program home).mp homeable g g' linked,
    fun _ => rfl⟩

omit [DecidableEq L] in
/-- **A local placement makes the commit homed at its shards' home.** -/
theorem homedAt_of_homeable {home : G → L} {c : Commit O R} {l : L}
    (atL : ∀ g, Touches label shard c g → home g = l) :
    HomedAt label (home ∘ shard) ⟨c, l⟩ := by
  refine ⟨fun o member => atL _ (Or.inl ⟨o, member, rfl⟩), fun read member r inRegion => ?_⟩
  exact atL _ (Or.inr ⟨read, member, r, inRegion, rfl⟩)

/-! ## Moving a shard -/

section Move

variable [Fintype L]

variable (label) in
/-- Move every stored occurrence whose label passes `moving` to location `target`. -/
def move (moving : R → Bool) (target : L) (net : Net O L) : Net O L where
  store l := (net.store l).filter (fun o => moving (label o) = false) ∪
    (if l = target then Finset.univ.biUnion (fun l' => (net.store l').filter fun o => moving (label o) = true)
      else ∅)
  inflight := net.inflight
  used := net.used

theorem mem_move {moving : R → Bool} {target : L} {net : Net O L} {l : L} {o : O} :
    o ∈ (move label moving target net).store l ↔
      (o ∈ net.store l ∧ moving (label o) = false) ∨
        (l = target ∧ moving (label o) = true ∧ ∃ l', o ∈ net.store l') := by
  by_cases h : l = target
  · subst h
    simp only [move, if_true, Finset.mem_union, Finset.mem_filter, Finset.mem_biUnion,
      Finset.mem_univ, true_and]
    constructor
    · rintro (stays | ⟨l', inStore, isMoving⟩)
      · exact Or.inl stays
      · exact Or.inr ⟨isMoving, l', inStore⟩
    · rintro (stays | ⟨isMoving, l', inStore⟩)
      · exact Or.inl stays
      · exact Or.inr ⟨l', inStore, isMoving⟩
  · simp [move, h]

/-- **A move is invisible to the atomic store.** -/
theorem move_whole (moving : R → Bool) (target : L) (net : Net O L) :
    whole (move label moving target net) = whole net := by
  ext o
  rw [mem_whole, mem_whole]
  constructor
  · rintro (⟨l, inMoved⟩ | flying)
    · rcases mem_move.mp inMoved with ⟨inStore, _⟩ | ⟨_, _, l', inStore⟩
      · exact Or.inl ⟨l, inStore⟩
      · exact Or.inl ⟨l', inStore⟩
    · exact Or.inr flying
  · rintro (⟨l, inStore⟩ | flying)
    · cases isMoving : moving (label o)
      · exact Or.inl ⟨l, mem_move.mpr (Or.inl ⟨inStore, isMoving⟩)⟩
      · exact Or.inl ⟨target, mem_move.mpr (Or.inr ⟨rfl, isMoving, l, inStore⟩)⟩
    · exact Or.inr flying

/-- The new placement: moved labels live at the target. -/
def moveHome (home : R → L) (moving : R → Bool) (target : L) : R → L :=
  fun r => if moving r then target else home r

/-- **The network invariant holds for the new placement**, when no message for a moved label is in
flight and the new program reads nothing that is in flight. -/
theorem move_inv {home : R → L} {program program' : List (Placed O R L)} {net : Net O L}
    (inv : HomeLocation.Inv label home program net) (moving : R → Bool) (target : L)
    (drained : ∀ o ∈ net.inflight, moving (label o) = false)
    (unread' : ∀ o ∈ net.inflight, ∀ q ∈ program', ∀ read ∈ q.commit.queries, read.region (label o) = false) :
    HomeLocation.Inv label (moveHome home moving target) program' (move label moving target net) := by
  refine ⟨?_, fun l o member => ?_, fun l => ?_, unread'⟩
  · rw [move_whole]; exact inv.used
  · rcases mem_move.mp member with ⟨inStore, notMoving⟩ | ⟨isTarget, isMoving, _⟩
    · simp only [moveHome, notMoving]
      exact inv.homed l o inStore
    · simp [moveHome, isMoving, isTarget]
  · refine Finset.disjoint_left.mpr fun o inStore flying => ?_
    rcases mem_move.mp inStore with ⟨inStore, _⟩ | ⟨_, isMoving, _⟩
    · exact Finset.disjoint_left.mp (inv.apart l) inStore flying
    · rw [drained o flying] at isMoving
      cases isMoving

/-- The network invariant holds along a run of the program. -/
theorem inv_runNet {home : R → L} {program : List (Placed O R L)}
    (homedAll : ∀ p ∈ program, HomedAt label home p) (closed : ClosedQueries label program) :
    ∀ (events : List (Event O R L)), (∀ p, Event.commit p ∈ events → p ∈ program) →
      ∀ net : Net O L, HomeLocation.Inv label home program net → HomeLocation.Inv label home program (runNet label home net events) := by
  intro events
  induction events with
  | nil => exact fun _ _ inv => inv
  | cons e rest ih =>
      intro inProgram net inv
      have restProgram : ∀ p, Event.commit p ∈ rest → p ∈ program :=
        fun p member => inProgram p (List.mem_cons_of_mem _ member)
      cases e with
      | commit p =>
          by_cases accepts : Accepts label net p
          · exact ih restProgram _ (inv_commit homedAll closed inv (inProgram p (List.mem_cons_self ..)) accepts)
          · have same : step label home net (.commit p) = net := by simp [step, accepts]
            show HomeLocation.Inv label home program (runNet label home (step label home net (.commit p)) rest)
            rw [same]
            exact ih restProgram net inv
      | deliver o => exact ih restProgram _ (inv_deliver inv o)

/-- **A run with a move in between is an atomic run**: commits under the old placement, the move,
then commits under the new placement form one executable run of the atomic semantics. -/
theorem moved_run_refines {home : R → L} {program program' : List (Placed O R L)}
    {moving : R → Bool} {target : L}
    (homedAll : ∀ p ∈ program, HomedAt label home p) (closed : ClosedQueries label program)
    (homedAll' : ∀ p ∈ program', HomedAt label (moveHome home moving target) p)
    (closed' : ClosedQueries label program')
    (before after : List (Event O R L)) (inBefore : ∀ p, Event.commit p ∈ before → p ∈ program)
    (inAfter : ∀ p, Event.commit p ∈ after → p ∈ program') {net : Net O L}
    (inv : HomeLocation.Inv label home program net)
    (drained : ∀ o ∈ (runNet label home net before).inflight, moving (label o) = false)
    (unread' : ∀ o ∈ (runNet label home net before).inflight, ∀ q ∈ program', ∀ read ∈ q.commit.queries,
      read.region (label o) = false) :
    Executable label (whole net) (performedAll label home net before ++
      performedAll label (moveHome home moving target)
        (move label moving target (runNet label home net before)) after) := by
  obtain ⟨legalBefore, finalBefore⟩ := run_refines homedAll closed before inBefore net inv
  have invMid := inv_runNet homedAll closed before inBefore net inv
  have invMoved := move_inv invMid moving target drained unread'
  obtain ⟨legalAfter, _⟩ := run_refines homedAll' closed' after inAfter _ invMoved
  refine executable_append_iff.mpr ⟨legalBefore, ?_⟩
  rw [← finalBefore, ← move_whole moving target (runNet label home net before)]
  exact legalAfter

end Move

/-! ## Controls -/

namespace Controls

/-- Three shards. -/
inductive Shard where
  | a
  | b
  | c
  deriving DecidableEq

/-- Occurrence `0` in shard `a`, `1` in `b`, others in `c`. -/
def shardOf : ℕ → Shard
  | 0 => .a
  | 1 => .b
  | _ => .c

/-- Take from `a`, keep from `b`. -/
def ab : Commit ℕ ℕ := ⟨{0}, {1}, ∅, []⟩

/-- Take from `b`, keep from `c`. -/
def bc : Commit ℕ ℕ := ⟨{1}, {2}, ∅, []⟩

/-- **A chain forces co-location**: no commit touches both `a` and `c`, yet they are linked, so every
placement that makes the program local puts them on one home. -/
theorem chain_forces (home : Shard → Bool)
    (homeable : ∀ c ∈ [ab, bc], Homeable id shardOf home c) : home .a = home .c := by
  have linkedAB : Linked id shardOf [ab, bc] .a .b :=
    Relation.EqvGen.rel _ _ ⟨ab, by simp, Or.inl ⟨0, by simp [ab], rfl⟩, Or.inl ⟨1, by simp [ab], rfl⟩⟩
  have linkedBC : Linked id shardOf [ab, bc] .b .c :=
    Relation.EqvGen.rel _ _ ⟨bc, by simp, Or.inl ⟨1, by simp [bc], rfl⟩, Or.inl ⟨2, by simp [bc], rfl⟩⟩
  exact (homeable_iff [ab, bc] home).mp homeable _ _ (Relation.EqvGen.trans _ _ _ linkedAB linkedBC)

/-- No single commit touches both `a` and `c`. -/
theorem no_commit_touches_both : ¬ ∃ c ∈ [ab, bc], Touches id shardOf c .a ∧ Touches id shardOf c .c := by
  rintro ⟨c, member, touchA, touchC⟩
  simp only [List.mem_cons, List.not_mem_nil, or_false] at member
  rcases member with rfl | rfl
  · rcases touchC with ⟨o, inFoot, isC⟩ | ⟨read, inQueries, _⟩
    · simp only [ab, Finset.mem_union, Finset.mem_singleton] at inFoot
      rcases inFoot with rfl | rfl <;> cases isC
    · simp [ab] at inQueries
  · rcases touchA with ⟨o, inFoot, isA⟩ | ⟨read, inQueries, _⟩
    · simp only [bc, Finset.mem_union, Finset.mem_singleton] at inFoot
      rcases inFoot with rfl | rfl <;> cases isA
    · simp [bc] at inQueries

/-! ### Touching, co-touching, links and homes -/

/-- **Touches**: `ab` touches `a`, by its take, and not `c`. -/
theorem touches_controls : Touches id shardOf ab .a ∧ ¬ Touches id shardOf ab .c := by
  refine ⟨Or.inl ⟨0, by simp [ab], rfl⟩, ?_⟩
  rintro (⟨o, inFoot, isC⟩ | ⟨read, inQueries, _⟩)
  · simp only [ab, Finset.mem_union, Finset.mem_singleton] at inFoot
    rcases inFoot with rfl | rfl <;> cases isC
  · simp [ab] at inQueries

/-- **Co-touching**: `ab` touches `a` and `b` together; no commit touches `a` and `c`. -/
theorem coTouch_controls : CoTouch id shardOf [ab, bc] .a .b ∧ ¬ CoTouch id shardOf [ab, bc] .a .c :=
  ⟨⟨ab, by simp, Or.inl ⟨0, by simp [ab], rfl⟩, Or.inl ⟨1, by simp [ab], rfl⟩⟩,
    no_commit_touches_both⟩

/-- Without `bc`, nothing links `c` to another shard. -/
theorem linked_c_only {g g' : Shard} (linked : Linked id shardOf [ab] g g') : g = .c ↔ g' = .c := by
  induction linked with
  | rel x y touch =>
      obtain ⟨c, member, touchX, touchY⟩ := touch
      simp only [List.mem_singleton] at member
      subst member
      have notC : ∀ g, Touches id shardOf ab g → g ≠ .c := by
        rintro g (⟨o, inFoot, rfl⟩ | ⟨read, inQueries, _⟩)
        · simp only [ab, Finset.mem_union, Finset.mem_singleton] at inFoot
          rcases inFoot with rfl | rfl <;> decide
        · simp [ab] at inQueries
      exact ⟨fun h => absurd h (notC x touchX), fun h => absurd h (notC y touchY)⟩
  | refl => exact Iff.rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih ih' => exact ih.trans ih'

/-- **Links**: the chain links `a` to `c`; `ab` alone does not. -/
theorem linked_controls : Linked id shardOf [ab, bc] .a .c ∧ ¬ Linked id shardOf [ab] .a .c := by
  refine ⟨?_, fun linked => by simpa using (linked_c_only linked).mpr rfl⟩
  have linkedAB : Linked id shardOf [ab, bc] .a .b :=
    Relation.EqvGen.rel _ _ ⟨ab, by simp, Or.inl ⟨0, by simp [ab], rfl⟩, Or.inl ⟨1, by simp [ab], rfl⟩⟩
  have linkedBC : Linked id shardOf [ab, bc] .b .c :=
    Relation.EqvGen.rel _ _ ⟨bc, by simp, Or.inl ⟨1, by simp [bc], rfl⟩, Or.inl ⟨2, by simp [bc], rfl⟩⟩
  exact Relation.EqvGen.trans _ _ _ linkedAB linkedBC

/-- **Homes**: one home for every shard makes `ab` local; homing `a` apart from `b` does not. -/
theorem homeable_controls :
    Homeable id shardOf (fun _ => true) ab ∧ ¬ Homeable id shardOf (fun g => decide (g = .a)) ab := by
  refine ⟨⟨true, fun _ _ => rfl⟩, fun ⟨l, same⟩ => ?_⟩
  have atA := same .a (Or.inl ⟨0, by simp [ab], rfl⟩)
  have atB := same .b (Or.inl ⟨1, by simp [ab], rfl⟩)
  rw [← atA] at atB
  exact absurd atB (by decide)

end Controls

end Mettapedia.GSLT.Coordination.Colocation
