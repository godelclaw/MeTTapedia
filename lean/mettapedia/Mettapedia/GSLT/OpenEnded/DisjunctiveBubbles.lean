import Mettapedia.GSLT.OpenEnded.ComputationBubbles
import Mettapedia.GSLT.OpenEnded.CarrierBubbles
import Mathlib.Order.UpperLower.Closure
import Mathlib.Order.UpperLower.Principal
import Mathlib.Order.UpperLower.CompleteLattice
import Mathlib.Order.Antichain
import Mathlib.Data.Fintype.Powerset

/-!
# Disjunctive bubbles: the canonical object that always exists

A request may have no least sufficient bubble. It still determines a canonical
object: the bubbles lying above some sufficient bubble (`sufficiencyUpset`), a
point of the lattice of upper sets of the bubble order (for a finite bubble
order, the upper or Smyth powerdomain). Mathlib orders upper sets by reverse
inclusion, so a larger point is a more demanding request.

* **Same minimal bubbles.** The upset and the request have exactly the same
  minimal bubbles, whether or not sufficiency is monotone
  (`minimal_sufficiencyUpset_iff`). For monotone sufficiency the upset is the
  set of sufficient bubbles itself (`coe_sufficiencyUpset_of_monotone`); for
  non-monotone sufficiency it also contains insufficient bubbles above
  sufficient ones (`evaluation_upset_contains_insufficient`), so the upset is
  the canonical object for choosing a bubble, not a record of every failure.
* **Least iff principal.** A least sufficient bubble exists exactly when the
  upset is principal (`isLeast_iff_sufficiencyUpset_eq`,
  `exists_least_iff_principal`). Principal points are exactly the completely
  meet-prime points (`principal_iff_completelyMeetPrime`).
* **Antichains.** Over a well-founded bubble order the upset is generated by
  the antichain of minimal sufficient bubbles
  (`sufficiencyUpset_eq_upperClosure_minimal`), and upsets correspond exactly
  to antichains (`upsetAntichainEquiv`).
* **The disjunctive calculus.** Asking for both of two requests is the join of
  their points (intersection); asking for either is the meet (union). Both of
  two principal requests is principal, at the join of the bubbles
  (`sup_Ici`); either of two principal requests is principal only when the
  bubbles are comparable (`inf_Ici_principal_iff`). On antichains, either is
  the union and both is the set of pairwise joins (`upperClosure_union`,
  `upperClosure_sup_upperClosure`). Every point is the disjunction of the
  principal points of its members (`eq_iInf_Ici`).
* **Selection policies range over the minimal bubbles.** A selection policy
  picks a minimal bubble of every nonempty request. The bubbles that some
  policy can select are exactly the minimal ones (`selectable_eq_minimal`), so
  revising a policy can change which minimal bubble it picks and nothing else.
  All policies agree on a request exactly when its upset is principal
  (`policies_agree_iff_principal`).

The examples are the existing fixtures: typing by evaluation has the two-element
antichain `{declareRepair, computeRepair}` (`evaluation_minimal_iff`,
`evaluation_upset_eq`, `evaluation_selectable`), while the non-monotone
syntax-directed package of `SufficientBubbles` is principal (`pkg_upset_principal`);
in the diamond a single reachability observation is not principal and the full
observer is (`diamond_single_not_principal`, `diamond_full_principal`).
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.OpenEnded.DisjunctiveBubbles

open Set

universe u

/-! ## The canonical upset of a request -/

section Order

variable {B : Type u} [PartialOrder B]

/-- The canonical object of a request: the bubbles above some sufficient
bubble. -/
def sufficiencyUpset (Suff : B → Prop) : UpperSet B :=
  upperClosure {b | Suff b}

theorem mem_sufficiencyUpset {Suff : B → Prop} {b : B} :
    b ∈ sufficiencyUpset Suff ↔ ∃ a, Suff a ∧ a ≤ b :=
  mem_upperClosure

/-- For monotone sufficiency the upset is the set of sufficient bubbles. -/
theorem coe_sufficiencyUpset_of_monotone {Suff : B → Prop}
    (up : ∀ ⦃a b⦄, a ≤ b → Suff a → Suff b) :
    (sufficiencyUpset Suff : Set B) = {b | Suff b} :=
  IsUpperSet.upperClosure fun _ _ le member => up le member

/-- **The upset and the request have the same minimal bubbles.** -/
theorem minimal_sufficiencyUpset_iff {Suff : B → Prop} {b : B} :
    Minimal (· ∈ sufficiencyUpset Suff) b ↔ Minimal Suff b := by
  constructor
  · intro minimal
    obtain ⟨a, sufficient, le⟩ := mem_sufficiencyUpset.mp minimal.prop
    have same : a = b :=
      le_antisymm le (minimal.2 (mem_sufficiencyUpset.mpr ⟨a, sufficient, le_rfl⟩) le)
    exact ⟨same ▸ sufficient, fun c sufficientC below =>
      minimal.2 (mem_sufficiencyUpset.mpr ⟨c, sufficientC, le_rfl⟩) below⟩
  · intro minimal
    refine ⟨mem_sufficiencyUpset.mpr ⟨b, minimal.prop, le_rfl⟩, fun c member below => ?_⟩
    obtain ⟨a, sufficient, le⟩ := mem_sufficiencyUpset.mp member
    exact (minimal.2 sufficient (le.trans below)).trans le

/-- **A least sufficient bubble is exactly a principal upset.** -/
theorem isLeast_iff_sufficiencyUpset_eq {Suff : B → Prop} {m : B} :
    IsLeast {b | Suff b} m ↔ sufficiencyUpset Suff = UpperSet.Ici m := by
  constructor
  · rintro ⟨sufficient, lower⟩
    apply SetLike.ext
    intro b
    rw [mem_sufficiencyUpset, UpperSet.mem_Ici_iff]
    exact ⟨fun ⟨_, sufficientA, le⟩ => (lower sufficientA).trans le,
      fun le => ⟨m, sufficient, le⟩⟩
  · intro same
    have member : m ∈ sufficiencyUpset Suff := same ▸ UpperSet.mem_Ici_iff.mpr le_rfl
    obtain ⟨a, sufficient, le⟩ := mem_sufficiencyUpset.mp member
    have above : a ∈ sufficiencyUpset Suff := mem_sufficiencyUpset.mpr ⟨a, sufficient, le_rfl⟩
    rw [same, UpperSet.mem_Ici_iff] at above
    have equal : a = m := le_antisymm le above
    refine ⟨equal ▸ sufficient, fun b sufficientB => ?_⟩
    have memberB : b ∈ sufficiencyUpset Suff := mem_sufficiencyUpset.mpr ⟨b, sufficientB, le_rfl⟩
    rw [same, UpperSet.mem_Ici_iff] at memberB
    exact memberB

/-- **A least sufficient bubble exists exactly when the upset is principal.** -/
theorem exists_least_iff_principal {Suff : B → Prop} :
    (∃ m, IsLeast {b | Suff b} m) ↔ ∃ m, sufficiencyUpset Suff = UpperSet.Ici m :=
  exists_congr fun _ => isLeast_iff_sufficiencyUpset_eq

/-- The minimal sufficient bubbles form an antichain. -/
theorem minimal_isAntichain (Suff : B → Prop) : IsAntichain (· ≤ ·) {b | Minimal Suff b} :=
  setOfPred_minimal_antichain Suff

/-! ### Principal points are the points prime for disjunction -/

/-- Completely prime for meets: whenever a meet (a disjunction of requests)
lies below the point, one of the requests already does. -/
def CompletelyMeetPrime (U : UpperSet B) : Prop :=
  ∀ S : Set (UpperSet B), sInf S ≤ U → ∃ V ∈ S, V ≤ U

/-- **Principal points are exactly the completely prime points.** -/
theorem principal_iff_completelyMeetPrime (U : UpperSet B) :
    (∃ a, U = UpperSet.Ici a) ↔ CompletelyMeetPrime U := by
  constructor
  · rintro ⟨a, rfl⟩ S below
    have member : a ∈ (sInf S : UpperSet B) := UpperSet.le_Ici.mp below
    rw [← SetLike.mem_coe, UpperSet.coe_sInf, mem_iUnion₂] at member
    obtain ⟨V, memberV, inV⟩ := member
    exact ⟨V, memberV, UpperSet.le_Ici.mpr inV⟩
  · intro prime
    have cover : sInf (UpperSet.Ici '' (U : Set B)) ≤ U := by
      rw [← UpperSet.coe_subset_coe, UpperSet.coe_sInf]
      intro x member
      exact mem_iUnion₂.mpr ⟨UpperSet.Ici x, ⟨x, member, rfl⟩, UpperSet.mem_Ici_iff.mpr le_rfl⟩
    obtain ⟨_, ⟨a, memberA, rfl⟩, le⟩ := prime _ cover
    exact ⟨a, le_antisymm (UpperSet.le_Ici.mpr memberA) le⟩

/-! ### The disjunctive calculus -/

theorem mem_inf_Ici {a b x : B} :
    x ∈ UpperSet.Ici a ⊓ UpperSet.Ici b ↔ a ≤ x ∨ b ≤ x := by
  rw [← SetLike.mem_coe, UpperSet.coe_inf, mem_union, SetLike.mem_coe, SetLike.mem_coe,
    UpperSet.mem_Ici_iff, UpperSet.mem_Ici_iff]

/-- **Either of two principal requests is principal only for comparable
bubbles.** -/
theorem inf_Ici_principal_iff (a b : B) :
    (∃ c, UpperSet.Ici a ⊓ UpperSet.Ici b = UpperSet.Ici c) ↔ a ≤ b ∨ b ≤ a := by
  constructor
  · rintro ⟨c, same⟩
    have characterized : ∀ x, (a ≤ x ∨ b ≤ x) ↔ c ≤ x := fun x => by
      rw [← mem_inf_Ici, same, UpperSet.mem_Ici_iff]
    have ca : c ≤ a := (characterized a).mp (Or.inl le_rfl)
    have cb : c ≤ b := (characterized b).mp (Or.inr le_rfl)
    rcases (characterized c).mpr le_rfl with ac | bc
    · exact Or.inl (ac.trans cb)
    · exact Or.inr (bc.trans ca)
  · rintro (le | le)
    · refine ⟨a, SetLike.ext fun x => ?_⟩
      rw [mem_inf_Ici, UpperSet.mem_Ici_iff]
      exact ⟨fun h => h.elim id le.trans, Or.inl⟩
    · refine ⟨b, SetLike.ext fun x => ?_⟩
      rw [mem_inf_Ici, UpperSet.mem_Ici_iff]
      exact ⟨fun h => h.elim le.trans id, Or.inr⟩

/-- **Every point is the disjunction of the principal points of its
members.** -/
theorem eq_iInf_Ici (U : UpperSet B) : ⨅ b ∈ (U : Set B), UpperSet.Ici b = U := by
  rw [UpperSet.iInf_Ici, UpperSet.upperClosure]

/-! ### Selection policies -/

/-- A selection policy picks a minimal bubble of every nonempty request. -/
structure SelectionPolicy (B : Type u) [PartialOrder B] where
  select : (U : UpperSet B) → (U : Set B).Nonempty → B
  select_minimal : ∀ U nonempty, Minimal (· ∈ U) (select U nonempty)

theorem SelectionPolicy.select_mem (policy : SelectionPolicy B) (U : UpperSet B)
    (nonempty : (U : Set B).Nonempty) : policy.select U nonempty ∈ U :=
  (policy.select_minimal U nonempty).prop

open Classical in
/-- A policy revised at one request to prefer one of its minimal bubbles. -/
noncomputable def SelectionPolicy.prefer (policy : SelectionPolicy B) (U₀ : UpperSet B) (m : B)
    (minimal : Minimal (· ∈ U₀) m) : SelectionPolicy B where
  select U nonempty := if U = U₀ then m else policy.select U nonempty
  select_minimal U nonempty := by
    by_cases same : U = U₀
    · subst same
      rw [if_pos rfl]
      exact minimal
    · rw [if_neg same]
      exact policy.select_minimal U nonempty

theorem SelectionPolicy.prefer_select (policy : SelectionPolicy B) (U₀ : UpperSet B) (m : B)
    (minimal : Minimal (· ∈ U₀) m) (nonempty : (U₀ : Set B).Nonempty) :
    (policy.prefer U₀ m minimal).select U₀ nonempty = m := by
  classical
  simp [SelectionPolicy.prefer]

section WellFounded

variable [WellFoundedLT B]

/-- **Over a well-founded order every upset is generated by its minimal
elements.** -/
theorem upperClosure_minimal (U : UpperSet B) : upperClosure {b | Minimal (· ∈ U) b} = U := by
  apply SetLike.ext
  intro x
  rw [mem_upperClosure]
  constructor
  · rintro ⟨m, minimal, le⟩
    exact U.upper le minimal.prop
  · intro member
    obtain ⟨m, le, minimal⟩ := exists_minimal_le_of_wellFoundedLT (· ∈ U) x member
    exact ⟨m, minimal, le⟩

/-- **The upset of a request is generated by its minimal sufficient
bubbles.** -/
theorem sufficiencyUpset_eq_upperClosure_minimal (Suff : B → Prop) :
    sufficiencyUpset Suff = upperClosure {b | Minimal Suff b} := by
  conv_lhs => rw [← upperClosure_minimal (sufficiencyUpset Suff)]
  congr 1
  ext b
  exact minimal_sufficiencyUpset_iff

/-- **Upsets of a well-founded order are antichains.** -/
def upsetAntichainEquiv : UpperSet B ≃ {A : Set B // IsAntichain (· ≤ ·) A} where
  toFun U := ⟨{b | Minimal (· ∈ U) b}, setOfPred_minimal_antichain _⟩
  invFun A := upperClosure A.1
  left_inv U := upperClosure_minimal U
  right_inv A := Subtype.ext (Set.ext fun _ => A.2.minimal_mem_upperClosure_iff_mem)

/-- Some policy exists: pick any minimal element. -/
noncomputable def defaultPolicy : SelectionPolicy B where
  select U nonempty := Classical.choose (exists_minimal_of_wellFoundedLT (· ∈ U) nonempty)
  select_minimal U nonempty := Classical.choose_spec (exists_minimal_of_wellFoundedLT (· ∈ U) nonempty)

/-- **The selectable bubbles are exactly the minimal ones**: a policy can be
learned or revised to prefer any minimal bubble, and never selects anything
else. -/
theorem selectable_eq_minimal (U : UpperSet B) (nonempty : (U : Set B).Nonempty) :
    {b | ∃ policy : SelectionPolicy B, policy.select U nonempty = b} = {b | Minimal (· ∈ U) b} := by
  ext b
  constructor
  · rintro ⟨policy, rfl⟩
    exact policy.select_minimal U nonempty
  · intro minimal
    exact ⟨defaultPolicy.prefer U b minimal, defaultPolicy.prefer_select U b minimal nonempty⟩

/-- **All policies agree on a request exactly when its upset is principal.** -/
theorem policies_agree_iff_principal (U : UpperSet B) (nonempty : (U : Set B).Nonempty) :
    (∀ first second : SelectionPolicy B, first.select U nonempty = second.select U nonempty) ↔
      ∃ a, U = UpperSet.Ici a := by
  constructor
  · intro agree
    have minimal : Minimal (· ∈ U) ((defaultPolicy : SelectionPolicy B).select U nonempty) :=
      defaultPolicy.select_minimal U nonempty
    refine ⟨(defaultPolicy : SelectionPolicy B).select U nonempty,
      le_antisymm (UpperSet.le_Ici.mpr minimal.prop) ?_⟩
    rw [← UpperSet.coe_subset_coe]
    intro x member
    obtain ⟨m, le, minimalM⟩ := exists_minimal_le_of_wellFoundedLT (· ∈ U) x member
    have same := agree (defaultPolicy.prefer U m minimalM) defaultPolicy
    rw [defaultPolicy.prefer_select U m minimalM nonempty] at same
    exact UpperSet.mem_Ici_iff.mpr (same ▸ le)
  · rintro ⟨a, rfl⟩ first second
    have only : ∀ x, Minimal (· ∈ UpperSet.Ici a) x → x = a := fun x minimal =>
      le_antisymm (minimal.2 (UpperSet.mem_Ici_iff.mpr le_rfl) (UpperSet.mem_Ici_iff.mp minimal.prop))
        (UpperSet.mem_Ici_iff.mp minimal.prop)
    exact (only _ (first.select_minimal _ nonempty)).trans
      (only _ (second.select_minimal _ nonempty)).symm

end WellFounded

end Order

/-! ### Both requests: joins -/

section Lattice

variable {B : Type u} [SemilatticeSup B]

/-- **Both of two principal requests is principal, at the join.** -/
theorem sup_Ici (a b : B) : UpperSet.Ici a ⊔ UpperSet.Ici b = UpperSet.Ici (a ⊔ b) :=
  (UpperSet.Ici_sup a b).symm

/-- Both requests, on antichain presentations: the pairwise joins. -/
theorem upperClosure_sup_upperClosure (A A' : Set B) :
    upperClosure A ⊔ upperClosure A' = upperClosure (image2 (· ⊔ ·) A A') := by
  apply SetLike.ext
  intro x
  rw [← SetLike.mem_coe, UpperSet.coe_sup, mem_inter_iff, SetLike.mem_coe, SetLike.mem_coe,
    mem_upperClosure, mem_upperClosure, mem_upperClosure]
  constructor
  · rintro ⟨⟨a, memberA, le⟩, ⟨a', memberA', le'⟩⟩
    exact ⟨a ⊔ a', mem_image2_of_mem memberA memberA', sup_le le le'⟩
  · rintro ⟨_, ⟨a, memberA, a', memberA', rfl⟩, le⟩
    exact ⟨⟨a, memberA, le_sup_left.trans le⟩, ⟨a', memberA', le_sup_right.trans le⟩⟩

end Lattice

/-! ## The fixtures -/

section Fixtures

open ComputationBubbles

/-- **Typing by evaluation: exactly two minimal sufficient bubbles.** -/
theorem evaluation_minimal_iff (S : Set Gen) :
    Minimal (Suff TypedEv) S ↔ S = declareRepair ∨ S = computeRepair := by
  constructor
  · intro minimal
    obtain ⟨declared, unfold, midTyped, _⟩ := (suffEv_iff S).mp minimal.prop
    rcases midTyped with midDeclared | ⟨unfoldMid', lowDeclared⟩
    · have inside : declareRepair ⊆ S := by
        rintro g (rfl | rfl | rfl)
        · exact declared
        · exact unfold
        · exact midDeclared
      exact Or.inl (subset_antisymm (minimal.2 declareRepair_sufficient inside) inside)
    · have inside : computeRepair ⊆ S := by
        rintro g (rfl | rfl | rfl | rfl)
        · exact declared
        · exact unfold
        · exact unfoldMid'
        · exact lowDeclared
      exact Or.inr (subset_antisymm (minimal.2 computeRepair_sufficient inside) inside)
  · rintro (rfl | rfl)
    · exact evaluation_repairs_minimal.1
    · exact evaluation_repairs_minimal.2

/-- **The canonical object of typing by evaluation is a two-element
antichain.** -/
theorem evaluation_upset_eq :
    sufficiencyUpset (Suff TypedEv) = upperClosure {declareRepair, computeRepair} := by
  apply SetLike.ext
  intro S
  rw [mem_sufficiencyUpset, mem_upperClosure]
  constructor
  · rintro ⟨T, sufficient, inside⟩
    obtain ⟨declared, unfold, midTyped, _⟩ := (suffEv_iff T).mp sufficient
    rcases midTyped with midDeclared | ⟨unfoldMid', lowDeclared⟩
    · refine ⟨declareRepair, Or.inl rfl, fun g member => inside ?_⟩
      rcases member with rfl | rfl | rfl
      · exact declared
      · exact unfold
      · exact midDeclared
    · refine ⟨computeRepair, Or.inr rfl, fun g member => inside ?_⟩
      rcases member with rfl | rfl | rfl | rfl
      · exact declared
      · exact unfold
      · exact unfoldMid'
      · exact lowDeclared
  · rintro ⟨T, (rfl | rfl), inside⟩
    · exact ⟨_, declareRepair_sufficient, inside⟩
    · exact ⟨_, computeRepair_sufficient, inside⟩

theorem evaluation_upset_not_principal :
    ¬ ∃ m, sufficiencyUpset (Suff TypedEv) = UpperSet.Ici m :=
  fun principal => evaluation_no_least (exists_least_iff_principal.mpr principal)

/-- **For non-monotone sufficiency the upset contains insufficient
bubbles.** -/
theorem evaluation_upset_contains_insufficient :
    insert Gen.unfoldMid declareRepair ∈ sufficiencyUpset (Suff TypedEv) ∧
      ¬ Suff TypedEv (insert Gen.unfoldMid declareRepair) :=
  ⟨mem_sufficiencyUpset.mpr ⟨declareRepair, declareRepair_sufficient, subset_insert _ _⟩,
    evaluation_join_not_monotone.2⟩

instance : Finite Gen :=
  Finite.of_surjective
    (fun n : Fin 5 =>
      match n.val with
      | 0 => Gen.decl Const.top
      | 1 => Gen.decl Const.mid
      | 2 => Gen.decl Const.low
      | 3 => Gen.unfoldTop
      | _ => Gen.unfoldMid)
    (by
      intro g
      cases g with
      | decl c =>
          cases c
          · exact ⟨0, rfl⟩
          · exact ⟨1, rfl⟩
          · exact ⟨2, rfl⟩
      | unfoldTop => exact ⟨3, rfl⟩
      | unfoldMid => exact ⟨4, rfl⟩)

theorem evaluation_upset_nonempty :
    (sufficiencyUpset (Suff TypedEv) : Set (Set Gen)).Nonempty :=
  ⟨declareRepair, mem_sufficiencyUpset.mpr ⟨_, declareRepair_sufficient, subset_rfl⟩⟩

/-- **Selection learning for typing by evaluation ranges over exactly the two
repairs.** -/
theorem evaluation_selectable :
    {b | ∃ policy : SelectionPolicy (Set Gen),
        policy.select (sufficiencyUpset (Suff TypedEv)) evaluation_upset_nonempty = b} =
      {declareRepair, computeRepair} := by
  rw [selectable_eq_minimal]
  ext S
  change Minimal (· ∈ sufficiencyUpset (Suff TypedEv)) S ↔ S = declareRepair ∨ S = computeRepair
  rw [minimal_sufficiencyUpset_iff, evaluation_minimal_iff]

end Fixtures

section PackageFixture

open SufficientBubbles

/-- The non-monotone package request of `SufficientBubbles` is principal. -/
theorem pkg_upset_principal : sufficiencyUpset pkgSuff = UpperSet.Ici {PkgGen.sourceDecl} :=
  isLeast_iff_sufficiencyUpset_eq.mp pkgSuff_isLeast

end PackageFixture

section DiamondFixture

open CarrierBubbles

/-- A single reachability observation in the diamond is not principal. -/
theorem diamond_single_not_principal :
    ¬ ∃ m, sufficiencyUpset SingleSufficient = UpperSet.Ici m :=
  fun principal => single_no_least (exists_least_iff_principal.mpr principal)

/-- The full reachability observer of the diamond is principal, at the cone. -/
theorem diamond_full_principal :
    sufficiencyUpset (ReachSufficient (S := diamond) ({Node.a} : Set Node)) =
      UpperSet.Ici (cone diamond ({Node.a} : Set Node)) :=
  isLeast_iff_sufficiencyUpset_eq.mp full_isLeast.1

end DiamondFixture

