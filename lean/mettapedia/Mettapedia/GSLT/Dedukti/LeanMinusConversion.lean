import Mettapedia.GSLT.Dedukti.LeanMinus

/-!
# What the Dedukti theory of Lean⁻ identifies, and what it cannot

Statements about the transcription `LeanMinus.leanTheory` of the theory of
Blanqui and Vaishnav, and about its part `pureTheory` without universe
polymorphism.  Nothing here is a statement about Lean 4: the object is the
paper's theory, read as a theory of the λΠ-calculus modulo in the sense of
the paper's Section 1.4, whose conversion is generated by beta and by every
instance of every rule.

## The two rules on `v` make conversion total

`Σpoly` has the rules `v (inst l) _ ↪ l` and `v _ i ↪ Max (…i…)`.  Both apply
to `v (inst t) 0`, for every term `t`.  So every term is convertible to one
fixed term (`conv_levelVariable`), and any two terms are convertible
(`leanTheory_conv_all`).  Consequences: `Type : Type`
(`leanTheory_type_type`), and every formed type is inhabited by the constant
`zero` (`leanTheory_inhabited`).  The paper says that the two rules "must be
tried in the given order"; that is a reduction strategy, and the conversion of
Section 1.4 has no order.  The Dedukti checker implements the strategy, and
its conversion test does not identify `v (inst zero) 0` with the right side of
the second rule (checked with `dk`, see the report).

## The four rules that are not rewrite rules

Each is a statement "the theory joins every two terms that the rule
identifies", refuted by a pair of terms that the rule identifies and the
theory does not join.  Closed levels are written in normal form: `|0|` is
`Max (nil S_code)` (`levelZero`), `|1|` is
`Max (cons S_code (cst (nil N_code) (s 0)) (nil S_code))` (`levelOne`); the
translations reduce to them (`zero_reduces`, `one_reduces`).

| Rule | Witness | Theorem |
|---|---|---|
| (η-fun) | `f` and `λ x : ‖A‖. f x`, with `f : ‖A → B‖` | `etaFun_not_joinable_pure`, `etaFun_not_joinable_lean` |
| (PI) | two variables of type `‖A‖`, `A : Prop` | `proofIrrelevance_not_joinable_pure`, `proofIrrelevance_not_joinable_lean` |
| (η-unit) | a variable of type `‖PUnit.{1}‖` and `PUnit.unit` | `unitEta_not_joinable_lean` |
| (β-rec-K) | `Eq.rec … a e` with `e : a = a`, and its minor premise `h` | `kLike_not_joinable_lean` |

The first two need no Lean declaration and hold in `pureTheory` as well; the
last two use `PUnit` and `Eq`, whose declared types use `Σpoly`.

Which system identifies the pairs: Lean⁻ keeps (η-fun), so Lean⁻ identifies
the first pair.  Lean⁻ is Lean without (PI), (η-unit) and (β-rec-K); the
other three pairs are identified by Lean and not by Lean⁻, which replaces
each use of these rules by a transport along a propositional equality.  The
paper's Dedukti supports (η-fun) as a built-in conversion, not as a rule; the
proof of its Theorem 4, case (η-fun), uses that built-in.

For (η-fun), (PI) and (η-unit) more holds: in every theory whose rules are
headed by constants, two distinct variables are not joinable
(`headed_vars_not_joinable`), and a variable is not joinable with an
abstraction (`headed_var_lam_not_joinable`).  So no set of rules of the shape
Dedukti requires provides them on variables.  (β-rec-K) is different: the
rule without its side condition `v : S p t` is a rule headed by the
recursor; it is the condition, a typing condition, that a rewrite rule
cannot state.

A positive example, a Lean⁻ term typed at the translation of its type, is in
`LeanMinusExamples`.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Dedukti.LeanMinus

open Mettapedia.GSLT.LanguageDef
open Mettapedia.GSLT.LanguageDef.LF
open Mettapedia.GSLT.LanguageDef.LFTyping (Sig Decl sigT lookupType lookupBody lift subst subst0 Ctx)
open Mettapedia.GSLT.LanguageDef.LFProfile (ProductRule)
open Mettapedia.Logic.Relation (Confluent IsNormal)

/-! ## Facts about every theory whose rules are headed by constants -/

section Headed

variable {theory : Theory}

/-- A abstraction reduces only to an abstraction, when every rule is headed by
a constant. -/
theorem Reduces.lam_inv (headed : theory.Headed) {domain body target : Term}
    (reduces : Reduces theory (.lam domain body) target) :
    ∃ domain' body', target = .lam domain' body' := by
  induction reduces with
  | refl => exact ⟨domain, body, rfl⟩
  | tail _ step ih =>
      obtain ⟨domain', body', rfl⟩ := ih
      rcases step.lam_inv with root | ⟨next, _, rfl⟩ | ⟨next, _, rfl⟩
      · exact (RootStep.not_lam headed root).elim
      · exact ⟨next, body', rfl⟩
      · exact ⟨domain', next, rfl⟩

/-- **Two distinct variables are never joinable**, in a theory whose rules are
headed by constants. -/
theorem headed_vars_not_joinable (headed : theory.Headed) {first second : Nat}
    (distinct : first ≠ second) : ¬ Joinable theory (.var first) (.var second) :=
  not_joinable_of_normal (var_normal headed first) (var_normal headed second)
    fun same => distinct (Term.var.inj same)

/-- **A variable is never joinable with an abstraction**, in a theory whose
rules are headed by constants. -/
theorem headed_var_lam_not_joinable (headed : theory.Headed) (index : Nat) (domain body : Term) :
    ¬ Joinable theory (.var index) (.lam domain body) := by
  rintro ⟨common, leftReduces, rightReduces⟩
  have same := (var_normal headed index).reflTransGen_eq leftReduces
  obtain ⟨domain', body', shape⟩ := Reduces.lam_inv headed rightReduces
  rw [same] at shape
  cases shape

end Headed

/-! ## The two theories are headed, and their normal terms can be tested -/

theorem leanRules_headed : ∀ rule ∈ leanRules, (headConst rule.lhs).isSome = true := by
  decide

theorem leanTheory_headed : leanTheory.Headed := fun rule member => by
  have found := leanRules_headed rule member
  exact Option.isSome_iff_exists.mp found

theorem pureTheory_headed : pureTheory.Headed := fun rule member =>
  leanTheory_headed rule (pureTheory_extends.rule rule member)

/-- What a test for normal terms needs to know about `leanTheory`. -/
def leanCover : leanTheory.Cover where
  rigid := fun name => (lookupBody leanSig name).isNone
  rules := leanRules
  rigid_sound := fun _ rigid => Option.isNone_iff_eq_none.mp rigid
  rules_sound := fun _ member => member

/-- What a test for normal terms needs to know about `pureTheory`. -/
def pureCover : pureTheory.Cover where
  rigid := fun name => (lookupBody pureSig name).isNone
  rules := pureRules
  rigid_sound := fun _ rigid => Option.isNone_iff_eq_none.mp rigid
  rules_sound := fun _ member => member

/-! ## The collapse -/

/-- The level `Max (cons S_code (var (nil N_code) 0 0) (nil S_code))`: the
right side of the second rule on `v` at the numeral `0`. -/
def collapsePoint : Term := levelVariable zeroN

theorem instRule_mem : leanTheory.rule instRule := by
  show instRule ∈ leanRules
  decide

theorem variableRule_mem : leanTheory.rule variableRule := by
  show variableRule ∈ leanRules
  decide

/-- A rule instance at given sides, as a root step. -/
theorem rootStep_of_instance {theory : Theory} {rule : RewriteRule} (member : theory.rule rule)
    (assignment : Nat → Term) {source target : Term} (sourceEq : inst assignment rule.lhs = source)
    (targetEq : inst assignment rule.rhs = target) : RootStep theory source target :=
  sourceEq ▸ targetEq ▸ RootStep.rule assignment member

/-- The assignment of a list of terms to the pattern variables `0, 1, …`. -/
def assign (terms : List Term) (index : Nat) : Term := terms.getD index zeroN

theorem instRule_closed : instRule = ⟨ap "v" [instOf (.var 0), .var 1], .var 0⟩ := rfl

theorem variableRule_closed : variableRule = ⟨ap "v" [.var 0, .var 1], levelVariable (.var 1)⟩ := rfl

/-- `v (inst l) x ⟶ l`, by the first rule on `v`. -/
theorem instRule_step (level other : Term) : Step leanTheory (ap "v" [instOf level, other]) level :=
  Step.root (rootStep_of_instance instRule_mem (assign [level, other])
    (by rw [instRule_closed]; simp [assign, ap, apT, instOf])
    (by rw [instRule_closed]; simp [assign]))

/-- `v w i ⟶ Max (cons_S (var nil_N i 0) nil_S)`, by the second rule on `v`. -/
theorem variableRule_step (other index : Term) :
    Step leanTheory (ap "v" [other, index]) (levelVariable index) :=
  Step.root (rootStep_of_instance variableRule_mem (assign [other, index])
    (by rw [variableRule_closed]; simp [assign, ap, apT])
    (by rw [variableRule_closed]; simp [assign, levelVariable, ap, apT, zeroN]))

/-- **Every term is convertible to one level.**  `v (inst t) 0` reduces to `t`
by the first rule on `v` and to `collapsePoint` by the second. -/
theorem conv_levelVariable (term : Term) : Conv leanTheory term collapsePoint :=
  .trans _ _ _ (.symm _ _ (.rel _ _ (instRule_step term zeroN)))
    (.rel _ _ (variableRule_step (instOf term) zeroN))

/-- **The conversion of the paper's theory relates every two terms.** -/
theorem leanTheory_conv_all (left right : Term) : Conv leanTheory left right :=
  .trans _ _ _ (conv_levelVariable left) (.symm _ _ (conv_levelVariable right))

/-- **`Type : Type`** in the paper's theory. -/
theorem leanTheory_type_type (context : Ctx) :
    LambdaPiModulo leanTheory context (.srt .type) (.srt .type) :=
  .conv (.sort rfl) (leanTheory_conv_all _ _) (.sort rfl)

/-- **Every formed type is inhabited** in the paper's theory, by `zero`. -/
theorem leanTheory_inhabited (context : Ctx) {type : Term} {sort : Srt}
    (formed : LambdaPiModulo leanTheory context type (.srt sort)) :
    LambdaPiModulo leanTheory context zero type :=
  .conv (.con rfl) (leanTheory_conv_all _ _) formed

/-- **Every two types of one term are types of every term with a type.** -/
theorem leanTheory_typing_collapse (context : Ctx) {term type type' : Term} {sort : Srt}
    (typed : LambdaPiModulo leanTheory context term type)
    (formed : LambdaPiModulo leanTheory context type' (.srt sort)) :
    LambdaPiModulo leanTheory context term type' :=
  .conv typed (leanTheory_conv_all _ _) formed

/-! ## Closed levels in normal form -/

/-- `|0|` in normal form. -/
def levelZero : Term := ap "Max" [ap "nil" [.con "S_code"]]

/-- `|1|` in normal form. -/
def levelOne : Term :=
  ap "Max" [ap "cons" [.con "S_code", ap "cst" [ap "nil" [.con "N_code"], oneN], ap "nil" [.con "S_code"]]]

theorem levelZero_normal : IsNormal (Step leanTheory) levelZero :=
  normal_of_normalTest leanCover levelZero (by decide)

theorem levelOne_normal : IsNormal (Step leanTheory) levelOne :=
  normal_of_normalTest leanCover levelOne (by decide)

theorem pureRule_mem {rule : RewriteRule} (member : rule ∈ pureRules) : pureTheory.rule rule :=
  member

/-- A rule instance at the root, as a reduction. -/
theorem reduces_of_instance {theory : Theory} {rule : RewriteRule} (member : theory.rule rule)
    (assignment : Nat → Term) {source target : Term} (sourceEq : inst assignment rule.lhs = source)
    (targetEq : inst assignment rule.rhs = target) : Reduces theory source target :=
  .single (Step.root (rootStep_of_instance member assignment sourceEq targetEq))

/-- `|0| ⟶ Max (nil S_code)`. -/
theorem zero_reduces : Reduces pureTheory zero levelZero :=
  reduces_of_instance (rule := rulesI[0]) (pureRule_mem (by decide)) (assign []) (by decide)
    (by decide)

/-- `|1| ⟶* Max (cons S_code (cst (nil N_code) (s 0)) (nil S_code))`, in four
steps: `zero`, `succ`, `Incr`, `Add`. -/
theorem one_reduces : Reduces pureTheory (succ zero) levelOne := by
  have zeroStep : Reduces pureTheory (succ zero) (succ levelZero) :=
    (zero_reduces).plug (.appArgument (.con "succ") .hole)
  have succStep : Reduces pureTheory (succ levelZero)
      (ap "Max" [ap "Add" [ap "cst" [ap "nil" [.con "N_code"], oneN],
        ap "Incr" [ap "nil" [.con "S_code"]]]]) :=
    reduces_of_instance (rule := rulesI[1]) (pureRule_mem (by decide))
      (assign [ap "nil" [.con "S_code"]]) (by decide) (by decide)
  have incrStep : Reduces pureTheory
      (ap "Max" [ap "Add" [ap "cst" [ap "nil" [.con "N_code"], oneN],
        ap "Incr" [ap "nil" [.con "S_code"]]]])
      (ap "Max" [ap "Add" [ap "cst" [ap "nil" [.con "N_code"], oneN],
        ap "nil" [.con "S_code"]]]) :=
    (reduces_of_instance (rule := rulesE[0]) (pureRule_mem (by decide)) (assign [.con "S_code"])
      (by decide) (by decide)).plug
      (.appArgument (.con "Max") (.appArgument (ap "Add" [ap "cst" [ap "nil" [.con "N_code"], oneN]])
        .hole))
  have addStep : Reduces pureTheory
      (ap "Max" [ap "Add" [ap "cst" [ap "nil" [.con "N_code"], oneN], ap "nil" [.con "S_code"]]])
      levelOne :=
    (reduces_of_instance (rule := rulesE[2]) (pureRule_mem (by decide))
      (assign [ap "cst" [ap "nil" [.con "N_code"], oneN], .con "S_code"]) (by decide)
      (by decide)).plug (.appArgument (.con "Max") .hole)
  exact zeroStep.trans (succStep.trans (incrStep.trans addStep))

/-! ## The four rules that are not rewrite rules -/

/-- `‖A → B‖` for two propositions `A`, `B` of the context `[B, A]`, written
with the level in normal form. -/
def propArrow : Term := .pi (eps levelZero (.var 1)) (eps levelZero (.var 1))

/-- The context `A : Prop, B : Prop, f : A → B`, translated, innermost first. -/
def etaContext : Ctx := [propArrow, U levelZero, U levelZero]

/-- **(η-fun) is not a rule of the theory.**  The theory does not join every
function with its eta expansion: `f` and `λ x : ‖A‖. f x` are not joined. -/
theorem etaFun_not_joinable {theory : Theory} (headed : theory.Headed)
    (typed : LambdaPiModulo theory etaContext (.var 0)
      (.pi (eps levelZero (.var 2)) (eps levelZero (.var 2)))) :
    ¬ ∀ (context : Ctx) (function domain codomain : Term),
        LambdaPiModulo theory context function (.pi domain codomain) →
          Joinable theory function (.lam domain (.app (lift 1 0 function) (.var 0))) := by
  intro claimed
  exact headed_var_lam_not_joinable headed 0 _ _ (claimed etaContext (.var 0) _ _ typed)

theorem etaFun_typed_pure :
    LambdaPiModulo pureTheory etaContext (.var 0)
      (.pi (eps levelZero (.var 2)) (eps levelZero (.var 2))) :=
  .var rfl

/-- (η-fun), in the theory without universe polymorphism. -/
theorem etaFun_not_joinable_pure :
    ¬ ∀ (context : Ctx) (function domain codomain : Term),
        LambdaPiModulo pureTheory context function (.pi domain codomain) →
          Joinable pureTheory function (.lam domain (.app (lift 1 0 function) (.var 0))) :=
  etaFun_not_joinable pureTheory_headed etaFun_typed_pure

/-- (η-fun), in the paper's theory. -/
theorem etaFun_not_joinable_lean :
    ¬ ∀ (context : Ctx) (function domain codomain : Term),
        LambdaPiModulo leanTheory context function (.pi domain codomain) →
          Joinable leanTheory function (.lam domain (.app (lift 1 0 function) (.var 0))) :=
  etaFun_not_joinable leanTheory_headed (HasType.mono (LFProfile.Subsumed.refl _) pureTheory_extends
    etaFun_typed_pure)

/-- The context `A : Prop, v₁ : A, v₂ : A`, translated, innermost first. -/
def proofContext : Ctx := [eps levelZero (.var 1), eps levelZero (.var 0), U levelZero]

/-- **(PI) is not a rule of the theory**: two proofs of one proposition are not
joined. -/
theorem proofIrrelevance_not_joinable {theory : Theory} (headed : theory.Headed)
    (codeTyped : LambdaPiModulo theory proofContext (.var 2) (U levelZero))
    (firstTyped : LambdaPiModulo theory proofContext (.var 1) (eps levelZero (.var 2)))
    (secondTyped : LambdaPiModulo theory proofContext (.var 0) (eps levelZero (.var 2))) :
    ¬ ∀ (context : Ctx) (code first second : Term),
        LambdaPiModulo theory context code (U levelZero) →
        LambdaPiModulo theory context first (eps levelZero code) →
        LambdaPiModulo theory context second (eps levelZero code) →
          Joinable theory first second := by
  intro claimed
  exact headed_vars_not_joinable headed (by decide : (1 : Nat) ≠ 0)
    (claimed proofContext (.var 2) (.var 1) (.var 0) codeTyped firstTyped secondTyped)

theorem proofIrrelevance_not_joinable_pure :
    ¬ ∀ (context : Ctx) (code first second : Term),
        LambdaPiModulo pureTheory context code (U levelZero) →
        LambdaPiModulo pureTheory context first (eps levelZero code) →
        LambdaPiModulo pureTheory context second (eps levelZero code) →
          Joinable pureTheory first second :=
  proofIrrelevance_not_joinable pureTheory_headed (.var rfl) (.var rfl) (.var rfl)

theorem proofIrrelevance_not_joinable_lean :
    ¬ ∀ (context : Ctx) (code first second : Term),
        LambdaPiModulo leanTheory context code (U levelZero) →
        LambdaPiModulo leanTheory context first (eps levelZero code) →
        LambdaPiModulo leanTheory context second (eps levelZero code) →
          Joinable leanTheory first second :=
  proofIrrelevance_not_joinable leanTheory_headed (.var rfl) (.var rfl) (.var rfl)

/-- `‖PUnit.{1}‖`, with the level in normal form. -/
def unitType : Term := eps levelOne (ap "PUnit" [instOf levelOne])

/-- `PUnit.unit.{1}`, translated, with the level in normal form. -/
def unitValue : Term := ap "PUnit_unit" [instOf levelOne]

theorem unitValue_normal : IsNormal (Step leanTheory) unitValue :=
  normal_of_normalTest leanCover unitValue (by decide)

/-- An application whose type is computed. -/
theorem app_at {theory : Theory} {context : Ctx} {function argument domain body result : Term}
    (functionTyped : LambdaPiModulo theory context function (.pi domain body))
    (argumentTyped : LambdaPiModulo theory context argument domain)
    (same : subst0 argument body = result) :
    LambdaPiModulo theory context (.app function argument) result :=
  same ▸ HasType.app functionTyped argumentTyped

/-- A transparent definition, as a conversion. -/
theorem conv_delta {theory : Theory} {name : String} {body : Term}
    (defined : theory.body name = some body) : Conv theory (.con name) body :=
  .rel _ _ (Step.root (.delta defined))

/-- A rule instance at given sides, as a conversion. -/
theorem conv_of_instance {theory : Theory} {rule : RewriteRule} (member : theory.rule rule)
    (assignment : Nat → Term) {source target : Term} (sourceEq : inst assignment rule.lhs = source)
    (targetEq : inst assignment rule.rhs = target) : Conv theory source target :=
  .rel _ _ (Step.root (rootStep_of_instance member assignment sourceEq targetEq))

theorem leanRule_mem {rule : RewriteRule} (member : rule ∈ leanRules) : leanTheory.rule rule :=
  member

/-- `|1|` in normal form is a level. -/
theorem levelOne_typed (context : Ctx) : LambdaPiModulo leanTheory context levelOne L := by
  have nilN : LambdaPiModulo leanTheory context (ap "nil" [.con "N_code"]) G := by
    have applied : LambdaPiModulo leanTheory context (ap "nil" [.con "N_code"])
        (tauSet (.con "N_code")) := app_at (.con rfl) (.con rfl) rfl
    have unfold : Conv leanTheory G (tauSet (.con "N_code")) :=
      .trans _ _ _ (conv_delta rfl) (Conv.app (.refl _) (conv_delta rfl))
    exact .conv applied (.symm _ _ unfold) (.con rfl)
  have oneTyped : LambdaPiModulo leanTheory context oneN N := app_at (.con rfl) (.con rfl) rfl
  have cstTyped : LambdaPiModulo leanTheory context (ap "cst" [ap "nil" [.con "N_code"], oneN]) S :=
    app_at (app_at (.con rfl) nilN rfl) oneTyped rfl
  have tauS : LambdaPiModulo leanTheory context (tau (.con "S_code")) (.srt .type) :=
    app_at (.con rfl) (.con rfl) rfl
  have cstCode : LambdaPiModulo leanTheory context (ap "cst" [ap "nil" [.con "N_code"], oneN])
      (tau (.con "S_code")) := .conv cstTyped (conv_delta rfl) tauS
  have consTyped : LambdaPiModulo leanTheory context
      (ap "cons" [.con "S_code", ap "cst" [ap "nil" [.con "N_code"], oneN], ap "nil" [.con "S_code"]])
      (tauSet (.con "S_code")) :=
    app_at (app_at (app_at (.con rfl) (.con rfl) rfl) cstCode rfl) (app_at (.con rfl) (.con rfl) rfl) rfl
  have asE : LambdaPiModulo leanTheory context
      (ap "cons" [.con "S_code", ap "cst" [ap "nil" [.con "N_code"], oneN], ap "nil" [.con "S_code"]])
      E := .conv consTyped (.symm _ _ (conv_delta rfl)) (.con rfl)
  exact app_at (.con rfl) asE rfl

/-- `v (inst l) 0 ⟶ l`, as a conversion. -/
theorem conv_v_inst (level : Term) : Conv leanTheory (ap "v" [instOf level, zeroN]) level :=
  .rel _ _ (instRule_step level zeroN)

/-- `‖PUnit.{1}‖` is a type. -/
theorem unitType_formed (context : Ctx) : LambdaPiModulo leanTheory context unitType (.srt .type) := by
  have instTyped : LambdaPiModulo leanTheory context (instOf levelOne) L :=
    app_at (.con rfl) (levelOne_typed context) rfl
  have punit : LambdaPiModulo leanTheory context (ap "PUnit" [instOf levelOne])
      (U (ap "v" [instOf levelOne, zeroN])) := app_at (.con rfl) instTyped rfl
  have uFormed : LambdaPiModulo leanTheory context (U levelOne) (.srt .type) :=
    app_at (.con rfl) (levelOne_typed context) rfl
  have punitAt : LambdaPiModulo leanTheory context (ap "PUnit" [instOf levelOne]) (U levelOne) :=
    .conv punit (Conv.app (.refl _) (conv_v_inst levelOne)) uFormed
  exact app_at (app_at (.con rfl) (levelOne_typed context) rfl) punitAt rfl

/-- **`PUnit.unit` has the type `‖PUnit‖`**: its declared type at the level
`inst |1|` is reached by the first rule on `v`. -/
theorem unitValue_typed (context : Ctx) : LambdaPiModulo leanTheory context unitValue unitType := by
  have instTyped : LambdaPiModulo leanTheory context (instOf levelOne) L :=
    app_at (.con rfl) (levelOne_typed context) rfl
  have declared : LambdaPiModulo leanTheory context unitValue
      (eps (ap "v" [instOf levelOne, zeroN]) (ap "PUnit" [instOf (ap "v" [instOf levelOne, zeroN])])) :=
    app_at (.con rfl) instTyped rfl
  refine .conv declared ?_ (unitType_formed context)
  exact Conv.app (Conv.app (.refl _) (conv_v_inst levelOne))
    (Conv.app (.refl _) (Conv.app (.refl _) (conv_v_inst levelOne)))

/-- **(η-unit) is not a rule of the theory**: a variable of the unit type and
the unit are not joined. -/
theorem unitEta_not_joinable_lean :
    ¬ ∀ (context : Ctx) (first second : Term),
        LambdaPiModulo leanTheory context first unitType →
        LambdaPiModulo leanTheory context second unitType →
          Joinable leanTheory first second := by
  intro claimed
  exact not_joinable_of_normal (var_normal leanTheory_headed 0) unitValue_normal (by decide)
    (claimed [unitType] (.var 0) unitValue (.var rfl) (unitValue_typed _))

/-- `Eq[1] A x y`, with the level in normal form. -/
def eqOne (code first second : Term) : Term := ap "Eq" [instOf levelOne, code, first, second]

/-- `Eq.refl[1] A x`. -/
def reflOne (code element : Term) : Term := ap "Eq_refl" [instOf levelOne, code, element]

/-- The context `A : Type, a : A, Q : Π b : A, a = b → Prop, h : Q a rfl,
e : a = a`, translated with levels in normal form, innermost first. -/
def kContext : Ctx :=
  [eps levelZero (eqOne (.var 3) (.var 2) (.var 2)),
    eps levelZero (apT (.var 0) [.var 1, reflOne (.var 2) (.var 1)]),
    .pi (eps levelOne (.var 1)) (.pi (eps levelZero (eqOne (.var 2) (.var 1) (.var 0))) (U levelZero)),
    eps levelOne (.var 0),
    U levelOne]

/-- `Eq.rec.{0, 1} A a Q h a e`, translated, with levels in normal form. -/
def kRedex : Term :=
  ap "Eq_rec" [instOf levelOne, instOf levelZero, .var 4, .var 3, .var 2, .var 1, .var 3, .var 0]

theorem kRedex_normal : IsNormal (Step leanTheory) kRedex :=
  normal_of_normalTest leanCover kRedex (by decide)

/-- **(β-rec-K) is not a rule of the theory**: the recursor of `Eq` applied to
a proof `e : a = a` that is not `Eq.refl` is not joined with its minor
premise. -/
theorem kLike_not_joinable_lean :
    ¬ ∀ (context : Ctx) (code element motive minor proof : Term),
        LambdaPiModulo leanTheory context minor
          (eps levelZero (apT motive [element, reflOne code element])) →
        LambdaPiModulo leanTheory context proof (eps levelZero (eqOne code element element)) →
          Joinable leanTheory
            (ap "Eq_rec" [instOf levelOne, instOf levelZero, code, element, motive, minor, element, proof])
            minor := by
  intro claimed
  exact not_joinable_of_normal kRedex_normal (var_normal leanTheory_headed 1) (by decide)
    (claimed kContext (.var 4) (.var 3) (.var 2) (.var 1) (.var 0) (.var rfl) (.var rfl))

