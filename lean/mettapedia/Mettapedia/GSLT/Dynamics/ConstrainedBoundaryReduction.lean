import Mettapedia.GSLT.Dynamics.LinearBoundaryReduction

/-!
# Boundary elimination with internal compatibility

Schur elimination reconstructs the hidden state. Any constraint on that
state must be evaluated on the reconstruction, not dropped. In particular,
an internal load depending on the state remains a fixed-point condition.

The spaces may represent trajectories, but no differential operator is
inverted here. A dynamical application must supply its linear inverse,
initial conditions, and the actual nonlinear history constraint.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Dynamics.LinearBoundaryReduction.System

universe u v w

variable {K : Type u} [Field K]
variable {Boundary : Type v} [AddCommGroup Boundary] [Module K Boundary]
variable {Interior : Type w} [AddCommGroup Interior] [Module K Interior]
variable (system : System K Boundary Interior)

/-- An arbitrary predicate may inspect both the exposed and the hidden state. -/
theorem constrained_elimination
    (compatible : Boundary → Interior → Prop)
    (input response : Boundary) (forcing : Interior) :
    (∃ internal : Interior,
      system.inward input + system.internalBlock internal = forcing ∧
      system.boundaryBlock input + system.outward internal = response ∧
      compatible input internal) ↔
    system.reducedResponse input forcing = response ∧
      compatible input (system.interiorSolution input forcing) := by
  constructor
  · rintro ⟨internal, solves, observes, admissible⟩
    have he := system.interiorSolution_unique input forcing internal solves
    subst internal
    exact ⟨(system.response_eq_schur input forcing).symm.trans observes, admissible⟩
  · rintro ⟨observes, admissible⟩
    exact ⟨system.interiorSolution input forcing,
      system.interiorSolution_satisfies input forcing,
      (system.response_eq_schur input forcing).trans observes, admissible⟩

/-- The load is generated by the reconstructed state. Eliminating the linear
block does not make that load freely prescribable. Initial-data contributions
can be included in `load`, and history constraints in `compatible`. -/
theorem feedback_elimination
    (load : Boundary → Interior → Interior)
    (compatible : Boundary → Interior → Prop)
    (input response : Boundary) :
    (∃ internal : Interior,
      system.inward input + system.internalBlock internal = load input internal ∧
      system.boundaryBlock input + system.outward internal = response ∧
      compatible input internal) ↔
    ∃ forcing : Interior,
      forcing = load input (system.interiorSolution input forcing) ∧
      system.reducedResponse input forcing = response ∧
      compatible input (system.interiorSolution input forcing) := by
  constructor
  · rintro ⟨internal, solves, observes, admissible⟩
    have he := system.interiorSolution_unique input (load input internal) internal solves
    refine ⟨load input internal, ?_, ?_, ?_⟩
    · rw [← he]
    · rw [← system.response_eq_schur, ← he]
      exact observes
    · rw [← he]
      exact admissible
  · rintro ⟨forcing, closes, observes, admissible⟩
    refine ⟨system.interiorSolution input forcing, ?_, ?_, admissible⟩
    · exact (system.interiorSolution_satisfies input forcing).trans closes
    · exact (system.response_eq_schur input forcing).trans observes

/-- Distinct internal loads can be observationally identical precisely when
their difference is invisible through the reconstructed outward map. -/
theorem same_response_iff (input : Boundary) (first second : Interior) :
    system.reducedResponse input first = system.reducedResponse input second ↔
      system.outward (system.internalBlock.symm (first - second)) = 0 := by
  simp only [reducedResponse, add_right_inj, map_sub, sub_eq_zero]

end Mettapedia.GSLT.Dynamics.LinearBoundaryReduction.System
