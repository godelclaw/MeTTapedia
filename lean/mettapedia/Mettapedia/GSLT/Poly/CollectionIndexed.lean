import Mettapedia.GSLT.Poly.BindingLanguage
import Mettapedia.GSLT.Poly.RhoCalcControl
import Mathlib.Logic.Relation

/-!
# Collections inside the context-indexed polynomial

A parameter in this fragment is either a binder parameter or a `vec`,
`hashBag`, or `hashSet` of a base sort. A head at a context and a sort is an
operator together with its binder counts and one length for each collection
parameter. A collection of length `n` contributes `Fin n` directions, and each
of them lands at the same context and the element sort.

The tree congruence is the least equivalence closed under the tree
constructors and generated by permuting the children of one bag or set
parameter. A set parameter also identifies a child with a second copy of that
child. `vec` parameters are not quotiented.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.Poly.CollectionIndexed

open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.GSLT.LanguageDef.WellSorted
open Mettapedia.OSLF.Binding
open Mettapedia.GSLT.Poly.BindingLanguage
open Mettapedia.GSLT.Poly.BindingSignature
open IPFunctor

/-- A `vec`, `hashBag`, or `hashSet` whose elements have a base sort. -/
def baseCollection? : TermParam → Option (CollType × String)
  | .simple _ (.collection kind (.base sort)) => some (kind, sort)
  | _ => none

/-- Every parameter is a binder parameter or a base-sort collection. -/
def FragmentRule (rule : GrammarRule) : Prop :=
  ∀ parameter ∈ rule.params,
    (bindingDecl? parameter).isSome ∨ (baseCollection? parameter).isSome

theorem binding_not_collection {parameter : TermParam}
    (bound : (bindingDecl? parameter).isSome) : (baseCollection? parameter).isNone := by
  cases parameter with
  | simple name type =>
      cases type with
      | base _ => simp [baseCollection?]
      | collection _ element =>
          cases element <;> simp [bindingDecl?] at bound
      | arrow _ _ => simp [bindingDecl?] at bound
      | multiBinder _ => simp [bindingDecl?] at bound
  | abstractionNamed _ _ _ => simp [baseCollection?]
  | multiAbstractionNamed _ _ _ => simp [baseCollection?]

theorem collection_not_binding {parameter : TermParam} {kind : CollType} {sort : String}
    (shape : baseCollection? parameter = some (kind, sort)) :
    (bindingDecl? parameter).isNone := by
  cases parameter with
  | simple _ type =>
      cases type with
      | collection _ element =>
          cases element with
          | base _ =>
              simp only [baseCollection?, Option.some.injEq, Prod.mk.injEq] at shape
              obtain ⟨rfl, rfl⟩ := shape
              simp [bindingDecl?]
          | arrow _ _ => simp [baseCollection?] at shape
          | multiBinder _ => simp [baseCollection?] at shape
          | collection _ _ => simp [baseCollection?] at shape
      | base _ => simp [baseCollection?] at shape
      | arrow _ _ => simp [baseCollection?] at shape
      | multiBinder _ => simp [baseCollection?] at shape
  | abstractionNamed _ _ _ => simp [baseCollection?] at shape
  | multiAbstractionNamed _ _ _ => simp [baseCollection?] at shape

/-- Binder counts and collection lengths of one occurrence.

A parameter that is not a base-sort multi-binder stores the count zero. A
parameter that is not a base-sort collection stores the length zero. -/
structure HeadData (parameters : List TermParam) where
  counts : List Nat
  lengths : List Nat
  counts_length : counts.length = parameters.length
  lengths_length : lengths.length = parameters.length
  counts_fixed : ∀ index : Nat,
    (multiBase? (parameters.getD index missingParameter)).isNone → counts.getD index 0 = 0
  lengths_fixed : ∀ index : Nat,
    (baseCollection? (parameters.getD index missingParameter)).isNone →
      lengths.getD index 0 = 0

/-- How many polynomial directions one parameter contributes. -/
def directionsOf (parameter : TermParam) (_count length : Nat) : Nat :=
  match baseCollection? parameter with
  | some _ => length
  | none => 1

/-- Directions of a parameter list. -/
def slotCount : List TermParam → List Nat → List Nat → Nat
  | [], _, _ => 0
  | _, [], _ => 0
  | _, _, [] => 0
  | parameter :: parameters, count :: counts, length :: lengths =>
      directionsOf parameter count length + slotCount parameters counts lengths

/-- One collection of length `n` is `n` directions at the element sort.
Every other fragment parameter is one direction, landing where its binders open. -/
def expandParam (parameter : TermParam) (count length : Nat) : List (List String × String) :=
  match baseCollection? parameter with
  | some (_, sort) => List.replicate length ([], sort)
  | none => [slotBinders parameter count]

def expandSlots : List TermParam → List Nat → List Nat → List (List String × String)
  | [], _, _ => []
  | _, [], _ => []
  | _, _, [] => []
  | parameter :: parameters, count :: counts, length :: lengths =>
      expandParam parameter count length ++ expandSlots parameters counts lengths

theorem expandSlots_length (parameters : List TermParam) (counts lengths : List Nat) :
    (expandSlots parameters counts lengths).length = slotCount parameters counts lengths := by
  induction parameters generalizing counts lengths with
  | nil =>
      cases counts <;> cases lengths <;> rfl
  | cons parameter parameters inductionHypothesis =>
      cases counts with
      | nil => cases lengths <;> rfl
      | cons count counts =>
          cases lengths with
          | nil => rfl
          | cons length lengths =>
              simp only [expandSlots, slotCount, List.length_append, inductionHypothesis]
              cases reading : baseCollection? parameter with
              | none => simp [expandParam, directionsOf, reading]
              | some value =>
                  cases value
                  simp [expandParam, directionsOf, reading, List.length_replicate]

/-- The context-indexed signature. The head carries the operator, the binder
counts, and the collection lengths. -/
abbrev indexedSignature (language : LanguageDef) : Signature where
  Srt := String
  Op sort :=
    Σ rule : {rule : GrammarRule //
      rule ∈ language.terms ∧ FragmentRule rule ∧ rule.category = sort},
      HeadData rule.1.params
  arity operator :=
    expandSlots operator.1.1.params operator.2.counts operator.2.lengths

/-- A collection direction lands at the element sort in the same context. -/
theorem collection_direction_lands {language : LanguageDef} {Γ : List String} {sort : String}
    (operator : (indexedSignature language).Op sort)
    (direction : Fin ((indexedSignature language).arity operator).length)
    {element : String}
    (declaration :
      ((indexedSignature language).arity operator).get direction = ([], element)) :
    (polynomial (indexedSignature language)).src (Γ, sort) operator direction =
      (Γ, element) := by
  rw [polynomial_direction, declaration]
  simp

abbrev Tree (language : LanguageDef) :=
  IFreeM (polynomial (indexedSignature language)) (Vars (indexedSignature language))

/-- The single collection parameter of a bare collection constructor. A
wrapped constructor keeps its named application, so it has none. -/
def bareCollection? (rule : GrammarRule) : Option (CollType × String) :=
  match rule.params, rule.collectionRepresentation with
  | [.simple _ (.collection kind (.base element))], .bare => some (kind, element)
  | _, _ => none

theorem bareCollection_uses {rule : GrammarRule} {kind : CollType} {element : String}
    (shape : bareCollection? rule = some (kind, element)) :
    UsesBareCollection rule := by
  cases rule with
  | mk _ _ parameters _ _ _ representation =>
      cases parameters with
      | nil => simp [bareCollection?] at shape
      | cons parameter parameters =>
          cases parameters with
          | cons _ _ => simp [bareCollection?] at shape
          | nil =>
              cases parameter with
              | simple name type =>
                  cases type with
                  | collection collectionKind elementType =>
                      cases elementType with
                      | base elementSort =>
                          cases representation with
                          | bare => exact ⟨name, collectionKind, .base elementSort, rfl⟩
                          | wrapped => simp [bareCollection?] at shape
                      | arrow _ _ => simp [bareCollection?] at shape
                      | multiBinder _ => simp [bareCollection?] at shape
                      | collection _ _ => simp [bareCollection?] at shape
                  | base _ => simp [bareCollection?] at shape
                  | arrow _ _ => simp [bareCollection?] at shape
                  | multiBinder _ => simp [bareCollection?] at shape
              | abstractionNamed _ _ _ => simp [bareCollection?] at shape
              | multiAbstractionNamed _ _ _ => simp [bareCollection?] at shape

theorem not_bare_of_fragment {rule : GrammarRule}
    (fragment : FragmentRule rule) (shape : bareCollection? rule = none) :
    ¬ UsesBareCollection rule := by
  intro used
  rcases used with ⟨name, collectionType, elementType, paramsShape⟩
  obtain ⟨mode, paramsShape⟩ := (GrammarRule.bareParams_cons_iff _ _ _).mp paramsShape
  have inFragment :=
    fragment (.simple name (.collection collectionType elementType)) (by simp [paramsShape])
  cases elementType with
  | base element =>
      have bare : bareCollection? rule = some (collectionType, element) := by
        simp [bareCollection?, paramsShape, mode]
      simp [shape] at bare
  | arrow _ _ => simp [bindingDecl?, baseCollection?] at inFragment
  | multiBinder _ => simp [bindingDecl?, baseCollection?] at inFragment
  | collection _ _ => simp [bindingDecl?, baseCollection?] at inFragment

/-- `rhoCalc` lies in the fragment. `PPar` is a base-sort bag. `PInput`'s
abstraction is an arrow of base sorts. The algebra declaration on `PPar` is
not a parameter. -/
theorem rhoCalc_fragment : ∀ rule ∈ rhoCalc.terms, FragmentRule rule := by
  intro rule member
  simp only [rhoCalc, List.mem_cons, List.mem_nil_iff, or_false] at member
  rcases member with rfl | rfl | rfl | rfl | rfl | rfl
  · intro parameter member
    simp at member
  · intro parameter member
    simp only [List.mem_singleton] at member
    subst member
    simp [bindingDecl?, baseCollection?, TypeExpr.name, TypeExpr.baseType]
  · intro parameter member
    simp only [List.mem_singleton] at member
    subst member
    simp [bindingDecl?, baseCollection?, TypeExpr.proc, TypeExpr.baseType]
  · intro parameter member
    simp only [List.mem_singleton] at member
    subst member
    simp [bindingDecl?, baseCollection?, TypeExpr.bag, TypeExpr.proc, TypeExpr.baseType]
  · intro parameter member
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at member
    rcases member with rfl | rfl
    · simp [bindingDecl?, baseCollection?, TypeExpr.name, TypeExpr.baseType]
    · simp [bindingDecl?, baseCollection?, TypeExpr.proc, TypeExpr.baseType]
  · intro parameter member
    simp only [List.mem_cons, List.mem_nil_iff, or_false] at member
    rcases member with rfl | rfl
    · simp [bindingDecl?, baseCollection?, TypeExpr.name, TypeExpr.baseType]
    · simp [bindingDecl?, baseCollection?, TypeExpr.funType, TypeExpr.name, TypeExpr.proc,
        TypeExpr.baseType]

/-- Distinct constructor labels of `rhoCalc`. -/
theorem rhoCalc_labels : (rhoCalc.terms.map (·.label)).Nodup := by
  decide

theorem bare_slot_length {language : LanguageDef} {sort : String}
    (operator : (indexedSignature language).Op sort) {kind : CollType} {element : String}
    (shape : bareCollection? operator.1.1 = some (kind, element)) :
    ((indexedSignature language).arity operator).length = operator.2.lengths.headD 0 := by
  cases operator with
  | mk packed data =>
      cases packed with
      | mk rule _property =>
          cases rule with
          | mk label categoryName parameters syntaxPattern evalPolicy algebra representation =>
              cases parameters with
              | nil => simp [bareCollection?] at shape
              | cons parameter parameters =>
                  cases parameters with
                  | cons _ _ => simp [bareCollection?] at shape
                  | nil =>
                      cases parameter with
                      | abstractionNamed _ _ _ => simp [bareCollection?] at shape
                      | multiAbstractionNamed _ _ _ => simp [bareCollection?] at shape
                      | simple name type =>
                          cases type with
                          | base _ => simp [bareCollection?] at shape
                          | arrow _ _ => simp [bareCollection?] at shape
                          | multiBinder _ => simp [bareCollection?] at shape
                          | collection collectionKind elementType =>
                              cases elementType with
                              | arrow _ _ => simp [bareCollection?] at shape
                              | multiBinder _ => simp [bareCollection?] at shape
                              | collection _ _ => simp [bareCollection?] at shape
                              | base elementSort =>
                                  have mode : representation = .bare := by
                                    cases representation <;> simp_all [bareCollection?]
                                  subst mode
                                  simp only [bareCollection?, Option.some.injEq,
                                    Prod.mk.injEq] at shape
                                  obtain ⟨kindEq, elementEq⟩ := shape
                                  subst kindEq
                                  subst elementEq
                                  cases dataLengths : data.lengths with
                                  | nil =>
                                      have lengthEq := data.lengths_length
                                      rw [dataLengths] at lengthEq
                                      simp at lengthEq
                                  | cons length tail =>
                                      cases tail with
                                      | nil =>
                                          cases dataCounts : data.counts with
                                          | nil =>
                                              have countEq := data.counts_length
                                              rw [dataCounts] at countEq
                                              simp at countEq
                                          | cons count countsTail =>
                                              cases countsTail with
                                              | nil =>
                                                  simp [indexedSignature, dataLengths, dataCounts,
                                                    expandSlots, expandParam, baseCollection?]
                                              | cons _ _ =>
                                                  have countEq := data.counts_length
                                                  rw [dataCounts] at countEq
                                                  simp at countEq
                                      | cons _ _ =>
                                          have lengthEq := data.lengths_length
                                          rw [dataLengths] at lengthEq
                                          simp at lengthEq

/-- One printed direction, read by its numeric position.

The out-of-range arm is never used by a head that fits in `printed`. Keeping
the bound out of the pattern means two proofs that the same position fits
print the same child. -/
def nthPrinted {total : Nat} (printed : Fin total → Pattern) (index : Nat) : Pattern :=
  if indexBound : index < total then
    printed ⟨index, indexBound⟩
  else
    .bvar 0

theorem nthPrinted_of_lt {total : Nat} (printed : Fin total → Pattern) {index : Nat}
    (bound : index < total) :
    nthPrinted printed index = printed ⟨index, bound⟩ := by
  rw [nthPrinted, dif_pos bound]

/-- Assemble already-printed children into one pattern per parameter. -/
def assemblePrinted {total : Nat} (printed : Fin total → Pattern)
    (offset : Nat) (parameters : List TermParam) (counts lengths : List Nat) : List Pattern :=
  match parameters, counts, lengths with
  | [], _, _ => []
  | _, [], _ => []
  | _, _, [] => []
  | parameter :: parameters, count :: counts, length :: lengths =>
      match baseCollection? parameter with
      | some (kind, _) =>
          .collection kind
              (List.ofFn fun index : Fin length => nthPrinted printed (offset + index.val))
            none ::
            assemblePrinted printed (offset + length) parameters counts lengths
      | none =>
          printArgument parameter count (nthPrinted printed offset) ::
            assemblePrinted printed (offset + 1) parameters counts lengths
  termination_by parameters.length

/-- One operator node, once every direction has already been printed.

A bare collection is the list of its directions. Every other operator is an
application of its label. -/
def nodeOf {language : LanguageDef} {sort : String}
    (operator : (indexedSignature language).Op sort)
    (printed : Fin ((indexedSignature language).arity operator).length → Pattern) : Pattern :=
  match bareCollection? operator.1.1 with
  | some (kind, _element) =>
      .collection kind (List.ofFn printed) none
  | none =>
      .apply operator.1.1.label
        (assemblePrinted printed 0 operator.1.1.params operator.2.counts operator.2.lengths)

/-- A tree as a pattern. The free-monad recursor prints each child first.
Variables are de Bruijn indices. -/
def toPattern {language : LanguageDef} : {index : List String × String} →
    Tree language index → Pattern :=
  fun {_index} tree =>
    IFreeM.construct (P := polynomial (indexedSignature language))
      (X := Vars (indexedSignature language))
      (fun _ variable_ => .bvar (varIndex variable_))
      (fun _ operator _continuation printed => nodeOf operator printed)
      tree

theorem toPattern_pure {language : LanguageDef} {index : List String × String}
    (variable_ : Vars (indexedSignature language) index) :
    toPattern (IFreeM.pure (P := polynomial (indexedSignature language)) variable_) =
      .bvar (varIndex variable_) :=
  rfl

/-- Directions of one operator, each a tree in the context that direction opens. -/
abbrev Child (language : LanguageDef) (Γ : List String) (sort : String)
    (operator : (indexedSignature language).Op sort) :=
  (direction : Fin ((indexedSignature language).arity operator).length) →
    Tree language
      ((polynomial (indexedSignature language)).src (Γ, sort) operator direction)

theorem toPattern_liftBind {language : LanguageDef} {Γ : List String} {sort : String}
    (operator : (indexedSignature language).Op sort)
    (children : Child language Γ sort operator) :
    toPattern
        (IFreeM.liftBind (P := polynomial (indexedSignature language)) (s := (Γ, sort))
          operator children) =
      nodeOf operator (fun direction => toPattern (children direction)) :=
  rfl

/-- An object pattern typed at a base sort in a binding context. -/
abbrev ObjectPattern (language : LanguageDef) (Γ : List String) (sort : String) :=
  {pattern : Pattern //
    HasType language FreeTypeContext.empty (typeContext Γ) pattern (.base sort) ∧
      isObjectPattern pattern = true}

/-- A closed object pattern typed at a base sort. -/
abbrev ClosedObject (language : LanguageDef) (sort : String) :=
  ObjectPattern language [] sort

/-- Every collection parameter of the language is a `vec`. -/
def VecOnly (language : LanguageDef) : Prop :=
  ∀ rule ∈ language.terms, ∀ parameter ∈ rule.params, ∀ kind element,
    baseCollection? parameter = some (kind, element) → kind = .vec

/-- Read one collection direction as a tree at the element sort.

Every declaration in the segment is `([], element)`, so the direction's source
is the surrounding context at that element sort. -/
def atElement {language : LanguageDef} {Γ : List String} {sort element : String}
    (operator : (indexedSignature language).Op sort)
    (direction : Fin ((indexedSignature language).arity operator).length)
    (uniform : ((indexedSignature language).arity operator).get direction = ([], element))
    (children : Child language Γ sort operator) : Tree language (Γ, element) :=
  cast
    (by
      apply congrArg (Tree language)
      rw [polynomial_direction, uniform]
      rfl)
    (children direction)

def segmentChild {language : LanguageDef} {Γ : List String} {sort element : String}
    (operator : (indexedSignature language).Op sort) (start : Nat) {length : Nat}
    (index : Fin length)
    (fit : start + index.val < ((indexedSignature language).arity operator).length)
    (uniform :
      ((indexedSignature language).arity operator).get ⟨start + index.val, fit⟩ = ([], element))
    (children : Child language Γ sort operator) : Tree language (Γ, element) :=
  atElement operator ⟨start + index.val, fit⟩ uniform children

/-- The least equivalence on patterns closed under pattern constructors and
generated by permuting the children of one bag or set, and by deleting one
duplicate child of a set. A `vec` has no generator. -/
inductive PatternCong : Pattern → Pattern → Prop where
  | refl (pattern : Pattern) : PatternCong pattern pattern
  | symm {left right : Pattern} : PatternCong left right → PatternCong right left
  | trans {left mid right : Pattern} :
      PatternCong left mid → PatternCong mid right → PatternCong left right
  | bagPerm {elements swapped : List Pattern} :
      List.Perm elements swapped →
        PatternCong (.collection .hashBag elements none)
          (.collection .hashBag swapped none)
  | setPerm {elements swapped : List Pattern} :
      List.Perm elements swapped →
        PatternCong (.collection .hashSet elements none)
          (.collection .hashSet swapped none)
  | setDup {before : List Pattern} {element : Pattern} {after : List Pattern} :
      PatternCong
        (.collection .hashSet (before ++ element :: element :: after) none)
        (.collection .hashSet (before ++ element :: after) none)
  | applyAt {label : String} {before : List Pattern} {left right : Pattern}
      {after : List Pattern} :
      PatternCong left right →
        PatternCong (.apply label (before ++ left :: after))
          (.apply label (before ++ right :: after))
  | lambdaAt {binder : Option String} {left right : Pattern} :
      PatternCong left right →
        PatternCong (.lambda binder left) (.lambda binder right)
  | multiLambdaAt {arity : Nat} {binders : List String} {left right : Pattern} :
      PatternCong left right →
        PatternCong (.multiLambda arity binders left) (.multiLambda arity binders right)
  | collectionAt {kind : CollType} {before : List Pattern} {left right : Pattern}
      {after : List Pattern} {rest : Option String} :
      PatternCong left right →
        PatternCong (.collection kind (before ++ left :: after) rest)
          (.collection kind (before ++ right :: after) rest)

/-- Skip one source direction. Indices below it stay, and later indices move back by one. -/
def dropDirection {sourceLength : Nat} (removed : Nat) (_removed_lt : removed < sourceLength)
    (direction : Nat) (_direction_lt : direction + 1 < sourceLength) : Fin sourceLength :=
  if direction < removed then ⟨direction, by omega⟩ else ⟨direction + 1, by omega⟩

/-- Deleting one of two equal children from a single `hashSet` parameter.
The target arity is the source arity with that direction removed, and every
surviving direction agrees with the source child it came from. -/
structure SetDeletion (language : LanguageDef) (Γ : List String) (sort element : String)
    (source target : (indexedSignature language).Op sort)
    (sourceChildren : Child language Γ sort source)
    (targetChildren : Child language Γ sort target)
    (removed : Fin ((indexedSignature language).arity source).length)
    (parameterIndex segmentStart : Nat) : Prop where
  sameRule : source.1 = target.1
  sameCounts : source.2.counts = target.2.counts
  /-- Shorten the chosen set parameter by one and leave every other length. -/
  lengthsDrop :
    target.2.lengths =
      source.2.lengths.set parameterIndex (source.2.lengths.getD parameterIndex 0 - 1)
  lengthDrop :
    ((indexedSignature language).arity target).length + 1 =
      ((indexedSignature language).arity source).length
  successor : removed.val + 1 < ((indexedSignature language).arity source).length
  parameterBound : parameterIndex < source.1.1.params.length
  parameterShape :
    baseCollection? (source.1.1.params.get ⟨parameterIndex, parameterBound⟩) =
      some (.hashSet, element)
  inSegment :
    segmentStart ≤ removed.val ∧
      removed.val + 1 < segmentStart + source.2.lengths.getD parameterIndex 0
  segmentIsPrefix :
    segmentStart =
      slotCount (source.1.1.params.take parameterIndex) (source.2.counts.take parameterIndex)
        (source.2.lengths.take parameterIndex)
  removedDecl :
    ((indexedSignature language).arity source).get removed = ([], element)
  nextDecl :
    ((indexedSignature language).arity source).get ⟨removed.val + 1, successor⟩ = ([], element)
  duplicate :
    atElement source removed removedDecl sourceChildren =
      atElement source ⟨removed.val + 1, successor⟩ nextDecl sourceChildren
  arityErase :
    (indexedSignature language).arity target =
      ((indexedSignature language).arity source).eraseIdx removed.val
  kept :
    ∀ direction : Fin ((indexedSignature language).arity target).length,
      ∃ equal :
        (polynomial (indexedSignature language)).src (Γ, sort) target direction =
          (polynomial (indexedSignature language)).src (Γ, sort) source
            (dropDirection removed.val removed.isLt direction.val
              (by
                have directionBound := direction.isLt
                omega)),
        cast (congrArg (Tree language) equal) (targetChildren direction) =
          sourceChildren
            (dropDirection removed.val removed.isLt direction.val
              (by
                have directionBound := direction.isLt
                omega))

/-- The least equivalence on indexed trees closed under `liftBind` and generated
by permuting the directions of one bag or set parameter. A set parameter also
identifies a tree with the tree that drops one of two equal children. -/
inductive TreeCong (language : LanguageDef) :
    {index : List String × String} → Tree language index → Tree language index → Prop where
  | refl {index : List String × String} (tree : Tree language index) :
      TreeCong language tree tree
  | symm {index : List String × String} {left right : Tree language index} :
      TreeCong language left right → TreeCong language right left
  | trans {index : List String × String} {left mid right : Tree language index} :
      TreeCong language left mid → TreeCong language mid right → TreeCong language left right
  | congr {Γ : List String} {sort : String}
      (operator : (indexedSignature language).Op sort)
      (left right : Child language Γ sort operator)
      (changed : Fin ((indexedSignature language).arity operator).length)
      (step : TreeCong language (left changed) (right changed))
      (stable : ∀ direction, direction ≠ changed → left direction = right direction) :
      TreeCong language
        (IFreeM.liftBind (P := polynomial (indexedSignature language)) (s := (Γ, sort))
          operator left)
        (IFreeM.liftBind (P := polynomial (indexedSignature language)) (s := (Γ, sort))
          operator right)
  | bagPerm {Γ : List String} {sort element : String}
      (operator : (indexedSignature language).Op sort)
      (start length : Nat)
      (fit : start + length ≤ ((indexedSignature language).arity operator).length)
      (kind : CollType)
      (bagOrSet : kind = .hashBag ∨ kind = .hashSet)
      (parameterIndex : Nat)
      (parameterBound : parameterIndex < operator.1.1.params.length)
      (parameterShape :
        baseCollection? (operator.1.1.params.get ⟨parameterIndex, parameterBound⟩) =
          some (kind, element))
      (segmentStart :
        start =
          slotCount (operator.1.1.params.take parameterIndex)
            (operator.2.counts.take parameterIndex)
            (operator.2.lengths.take parameterIndex))
      (segmentLength : length = operator.2.lengths.getD parameterIndex 0)
      (uniform : ∀ index : Fin length,
        ((indexedSignature language).arity operator).get
            ⟨start + index.val, by omega⟩ = ([], element))
      (left right : Child language Γ sort operator)
      (outside : ∀ direction : Fin ((indexedSignature language).arity operator).length,
        direction.val < start ∨ start + length ≤ direction.val → left direction = right direction)
      (permuted : List.Perm
        (List.ofFn fun index : Fin length =>
          segmentChild operator start index (by omega) (uniform index) left)
        (List.ofFn fun index : Fin length =>
          segmentChild operator start index (by omega) (uniform index) right)) :
      TreeCong language
        (IFreeM.liftBind (P := polynomial (indexedSignature language)) (s := (Γ, sort))
          operator left)
        (IFreeM.liftBind (P := polynomial (indexedSignature language)) (s := (Γ, sort))
          operator right)
  | setDup {Γ : List String} {sort element : String}
      (source target : (indexedSignature language).Op sort)
      (sourceChildren : Child language Γ sort source)
      (targetChildren : Child language Γ sort target)
      (removed : Fin ((indexedSignature language).arity source).length)
      (parameterIndex segmentStart : Nat)
      (deletion : SetDeletion language Γ sort element source target sourceChildren targetChildren
        removed parameterIndex segmentStart) :
      TreeCong language
        (IFreeM.liftBind (P := polynomial (indexedSignature language)) (s := (Γ, sort))
          source sourceChildren)
        (IFreeM.liftBind (P := polynomial (indexedSignature language)) (s := (Γ, sort))
          target targetChildren)

end Mettapedia.GSLT.Poly.CollectionIndexed
