import Mettapedia.GSLT.LanguageDef.ModuleSource.InductiveMeTTaNaturalPackage

/-! # Executable inspection of the qualified Nat/Vec package data -/

namespace Mettapedia.GSLT.LanguageDef.ModuleSource.InductiveMeTTaPackageExport

open InductiveMeTTaPackageControls
open Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.Presentation
open Declaration.IndexedFamily
open InferenceCettaWire

def quoted (pattern : Mettapedia.OSLF.MeTTaIL.Syntax.Pattern) : String :=
  "(quote " ++ CettaTerm.render (encodePattern pattern) ++ ")"

def referenceRow (row : Data.Row Tower.Head) : String :=
  let code := Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.PatternCodec.WithScalars.encodeTm scalars heads
  let context := Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.PatternCodec.WithScalars.encodeCtx scalars heads
  "(quote (ComputationView " ++
    CettaTerm.render (encodePattern (scalars.natural.encode row.1)) ++ " " ++
    CettaTerm.render (encodePattern (context row.2.1)) ++ " " ++
    CettaTerm.render (encodePattern (code row.2.2.1)) ++ " " ++
    CettaTerm.render (encodePattern (code row.2.2.2.1)) ++ " " ++
    CettaTerm.render (encodePattern (code row.2.2.2.2)) ++ "))"

def referenceEntry (entry : DeclName × Declaration.Entry Tower.Head) : String :=
  "(quote (DeclarationView " ++
    CettaTerm.render (encodePattern (scalars.declaration.encode entry.1)) ++ " " ++
    CettaTerm.render (encodePattern
      (Mettapedia.TypeTheory.Calculi.ParameterizedPiSigmaId.PatternCodec.WithScalars.encodeTm
        scalars heads entry.2.type)) ++ " " ++
    CettaTerm.render (encodePattern (Data.valueData scalars heads entry.2.value?)) ++ "))"

def metta : String :=
  "; Generated by InductiveMeTTaPackageExport from qualified source packages.\n" ++
  "; These are inspectable data; no native datatype or conversion rule is installed.\n" ++
  "!(import! &self generated-family-views.metta)\n" ++
  "(= (sample:nat) " ++ quoted (Data.packageData scalars heads
    InductiveMeTTaNaturalPackage.naturalGenerated.1
    InductiveMeTTaNaturalPackage.naturalGenerated.2) ++ ")\n" ++
  "(= (sample:vec) " ++ quoted vectorPacket ++ ")\n" ++
  "!(assertEqual (family:count (family:entries (sample:nat))) 4)\n" ++
  "!(assertEqual (family:count (family:rows (sample:nat))) 2)\n" ++
  "!(assertEqual (family:count (family:entries (sample:vec))) 4)\n" ++
  "!(assertEqual (family:count (family:rows (sample:vec))) 2)\n" ++
  String.join ([("nat", naturalReference.1), ("vec", vectorReference.1)].map fun (name, entries) =>
    match entries[3]? with
    | none => ""
    | some entry =>
      "!(let (Some $entry) (family:at (family:entries (sample:" ++ name ++ ")) 3)\n" ++
      "   (assertEqual (family:entry-view $entry) " ++ referenceEntry entry ++ "))\n") ++
  String.join ([("nat", naturalReference.2), ("vec", vectorReference.2)].map fun (name, rows) =>
    String.join (rows.zipIdx.map fun (row, index) =>
      "!(let (Some $row) (family:at (family:rows (sample:" ++ name ++ ")) " ++ toString index ++ ")\n" ++
      "   (assertEqual (family:row-view $row) " ++ referenceRow row ++ "))\n")) ++
  "!(assertEqual (family:at (family:rows (sample:vec)) 2) None)\n" ++
  "!(assertEqual (family:at (family:entries (sample:vec)) 4) None)\n" ++
  "!(assertEqual (=alpha (family:drop-first-row (sample:vec)) (sample:vec)) False)\n" ++
  "!(assertEqual (family:count (family:rows (family:drop-first-row (sample:vec)))) 1)\n" ++
  "!(assertEqual (=alpha (family:at (family:entries (sample:vec)) 0)\n" ++
  "   (family:at (family:entries (sample:vec)) 3)) False)\n"

def main (arguments : List String) : IO UInt32 := do
  match arguments with
  | [output] => IO.FS.writeFile output metta; pure 0
  | _ => IO.eprintln "usage: InductiveMeTTaPackageExport <output.metta>"; pure 1

end Mettapedia.GSLT.LanguageDef.ModuleSource.InductiveMeTTaPackageExport

def main (arguments : List String) : IO UInt32 :=
  Mettapedia.GSLT.LanguageDef.ModuleSource.InductiveMeTTaPackageExport.main arguments
