import Mettapedia.GSLT.LanguageDef.RegexSourceSemantics

/-!
# Source executions and selected-capture compiler correspondence

An execution is generated by the structural source operations, independently of
the compiler and its graph. The correspondence maps owned target occurrences
to source occurrences while retaining every capture register, position and
priority bit. It reflects complete executions as well as preserving them.
-/

set_option autoImplicit false

namespace Mettapedia.GSLT.LanguageDef.RegexSelection.Source

open Mettapedia.Computability.RegularLanguages
open RegexTaggedGraph
open OrderedGraphSearch (Point Probe successor)
open RegexSelectionCorrespondence (Action)

universe u v

def mapThread {First : Type u} {Second : Type v} {length : Nat}
    (f : First → Second) (thread : Thread First length) : Thread Second length :=
  ⟨(f thread.point.1, thread.point.2), thread.registers, thread.choices⟩

def mapPoint {First : Type u} {Second : Type v} {length : Nat}
    (f : First → Second) (point : Point First length) : Point Second length :=
  (f point.1, point.2)

def mapAction {First : Type u} {Second : Type v} (f : First → Second) :
    Action First Unit → Action Second Unit
  | .accept tag => .accept tag
  | .dead => .dead
  | .next target => .next (f target)
  | .branch first second => .branch (f first) (f second)

theorem mapAction_accept_iff {First : Type u} {Second : Type v} (f : First → Second)
    (result : Action First Unit) : mapAction f result = .accept () ↔ result = .accept () := by
  cases result with
  | accept tag => cases tag; simp [mapAction]
  | dead | next _ | branch _ _ => simp [mapAction]

theorem mapAction_next_iff {First : Type u} {Second : Type v} (f : First → Second)
    (result : Action First Unit) (target : Second) :
    mapAction f result = .next target ↔ ∃ next, result = .next next ∧ f next = target := by
  cases result <;> simp [mapAction]

theorem mapAction_branch_iff {First : Type u} {Second : Type v} (f : First → Second)
    (result : Action First Unit) (left right : Second) :
    mapAction f result = .branch left right ↔
      ∃ first second, result = .branch first second ∧ f first = left ∧ f second = right := by
  cases result <;> simp [mapAction]

/-- Interpret one authorized source operation. No compiler or emitted program is
consulted. Saves persist unless a later save overwrites the same slot. -/
def perform {length : Nat} (probe : Probe Graph.CharacterClass String length)
    (operation : Operation) (thread : Thread Address length) : Action (Thread Address length) Unit :=
  match operation with
  | .accept tag => .accept tag
  | .dead => .dead
  | .jump target => .next (thread.at target)
  | .save slot target => .next (thread.saved target slot)
  | .choice first second => .branch (thread.branch first false) (thread.branch second true)
  | .consume class_ target =>
      if probe.contains class_ thread.point.2 then
        match successor thread.point.2 with
        | some position => .next { thread with point := (target, position) }
        | none => .dead
      else .dead
  | .assertion assertion_ target =>
      if probe.holds assertion_ thread.point.2 then .next (thread.at target) else .dead

/-- An actual source operation must authorize the action at its source
occurrence; supplying an arbitrary graph node is not evidence of a source step. -/
def Acts {length : Nat} (pattern : Pattern) (probe : Probe Graph.CharacterClass String length)
    (first : Thread Address length) (result : Action (Thread Address length) Unit) : Prop :=
  ∃ operation, Authorizes pattern first.point.1 operation ∧ perform probe operation first = result

inductive Trace {length : Nat} (pattern : Pattern)
    (probe : Probe Graph.CharacterClass String length) (eligible : Thread Address length → Bool) :
    Thread Address length → List Bool → List (Point Address length) → Thread Address length → Prop
  | done {first} : Acts pattern probe first (.accept ()) → eligible first = true →
      Trace pattern probe eligible first [] [first.point] first
  | next {first target code points last} : Acts pattern probe first (.next target) →
      Trace pattern probe eligible target code points last →
      Trace pattern probe eligible first code (first.point :: points) last
  | left {first left right code points last} : Acts pattern probe first (.branch left right) →
      Trace pattern probe eligible left code points last →
      Trace pattern probe eligible first (false :: code) (first.point :: points) last
  | right {first left right code points last} : Acts pattern probe first (.branch left right) →
      Trace pattern probe eligible right code points last →
      Trace pattern probe eligible first (true :: code) (first.point :: points) last

/-- Preferred source execution among point-simple executions. This is a source
selection judgment, not a call to the compiler or either executable search. -/
def Selected {length : Nat} (pattern : Pattern) (probe : Probe Graph.CharacterClass String length)
    (eligible : Thread Address length → Bool) (first last : Thread Address length) : Prop :=
  ∃ code points, Trace pattern probe eligible first code points last ∧ points.Nodup ∧
    ∀ otherCode otherPoints otherLast,
      Trace pattern probe eligible first otherCode otherPoints otherLast → otherPoints.Nodup →
        code = otherCode ∨ RegexMatchObservations.HigherPriority code otherCode

theorem perform_map {State : Type} {length : Nat} (f : State → Address)
    (graph : State → Node State Graph.CharacterClass String Unit)
    (probe : Probe Graph.CharacterClass String length) (thread : Thread State length) :
    perform probe (Graph.mapNode f (graph thread.point.1)) (mapThread f thread) =
      mapAction (mapThread f) (RegexSelectionCorrespondence.action graph probe thread) := by
  rcases thread with ⟨⟨state, position⟩, registers, choices⟩
  dsimp only [mapThread]
  cases node : graph state <;>
    simp only [perform, Graph.mapNode, RegexSelectionCorrespondence.action, node, mapAction]
  all_goals try rfl
  · cases test : probe.contains _ position <;> cases advanced : successor position <;>
      simp_all only [Bool.false_eq_true, ↓reduceIte, mapThread]
  · cases test : probe.holds _ position <;>
      simp_all only [Bool.false_eq_true, ↓reduceIte, mapThread, Thread.at]

def compiledGraph (pattern : Pattern) :
    Graph.Owned (compile pattern) →
      Node (Graph.Owned (compile pattern)) Graph.CharacterClass String Unit :=
  Graph.graphOf (Graph.checkedCompile pattern)

abbrev view {pattern : Pattern} {length : Nat}
    (thread : Thread (Graph.Owned (compile pattern)) length) : Thread Address length :=
  mapThread Subtype.val thread

theorem acts_iff_compiled {pattern : Pattern} {length : Nat}
    (probe : Probe Graph.CharacterClass String length)
    (first : Thread (Graph.Owned (compile pattern)) length)
    (result : Action (Thread Address length) Unit) :
    Acts pattern probe (view first) result ↔
      mapAction view (RegexSelectionCorrespondence.action (compiledGraph pattern) probe first) = result := by
  constructor
  · rintro ⟨operation, authorized, performed⟩
    have same := authorizes_unique pattern first.point.1.val operation
      (Graph.mapNode Subtype.val (compiledGraph pattern first.point.1)) authorized
      (checkedGraph_source pattern first.point.1)
    rw [same] at performed
    exact (perform_map Subtype.val (compiledGraph pattern) probe first).symm.trans performed
  · intro performed
    refine ⟨Graph.mapNode Subtype.val (compiledGraph pattern first.point.1),
      checkedGraph_source pattern first.point.1, ?_⟩
    exact (perform_map Subtype.val (compiledGraph pattern) probe first).trans performed

theorem compiled_trace_source {pattern : Pattern} {length : Nat}
    {probe : Probe Graph.CharacterClass String length} {eligible : Thread Address length → Bool}
    {first last : Thread (Graph.Owned (compile pattern)) length}
    {code : List Bool} {points : List (Point (Graph.Owned (compile pattern)) length)}
    {tag : Unit}
    (trace : RegexSelectionCorrespondence.Trace (compiledGraph pattern) probe
      (eligible ∘ view) first code points last tag) :
    Trace pattern probe eligible (view first) code (points.map (mapPoint Subtype.val)) (view last) := by
  induction trace with
  | done action eligible =>
      cases tag
      exact .done ((acts_iff_compiled _ _ _).mpr (by rw [action]; rfl)) eligible
  | next action _ ih =>
      exact .next ((acts_iff_compiled _ _ _).mpr (by rw [action]; rfl)) ih
  | left action _ ih =>
      exact .left ((acts_iff_compiled _ _ _).mpr (by rw [action]; rfl)) ih
  | right action _ ih =>
      exact .right ((acts_iff_compiled _ _ _).mpr (by rw [action]; rfl)) ih

/-- Every source execution beginning at a compiled occurrence lifts to the
actual compiled graph, including its final register valuation and exact path. -/
theorem source_trace_compiled {pattern : Pattern} {length : Nat}
    {probe : Probe Graph.CharacterClass String length} {eligible : Thread Address length → Bool}
    {first : Thread Address length} {code : List Bool} {points : List (Point Address length)}
    {last : Thread Address length} (trace : Trace pattern probe eligible first code points last) :
    ∀ initial : Thread (Graph.Owned (compile pattern)) length, view initial = first →
      ∃ final targetPoints,
        RegexSelectionCorrespondence.Trace (compiledGraph pattern) probe (eligible ∘ view)
          initial code targetPoints final () ∧
        view final = last ∧ targetPoints.map (mapPoint Subtype.val) = points := by
  induction trace with
  | done acted accepted =>
      intro initial same
      cases same
      rw [acts_iff_compiled] at acted
      have action := (mapAction_accept_iff _ _).mp acted
      exact ⟨initial, [initial.point], .done action accepted, rfl, rfl⟩
  | next acted _ ih =>
      intro initial same
      cases same
      rw [acts_iff_compiled] at acted
      obtain ⟨target, action, targetSame⟩ := (mapAction_next_iff _ _ _).mp acted
      obtain ⟨final, targetPoints, next, lastSame, pointsSame⟩ := ih target targetSame
      exact ⟨final, initial.point :: targetPoints, .next action next, lastSame,
        congrArg (mapPoint Subtype.val initial.point :: ·) pointsSame⟩
  | left acted _ ih =>
      intro initial same
      cases same
      rw [acts_iff_compiled] at acted
      obtain ⟨left, right, action, leftSame, _⟩ := (mapAction_branch_iff _ _ _ _).mp acted
      obtain ⟨final, targetPoints, next, lastSame, pointsSame⟩ := ih left leftSame
      exact ⟨final, initial.point :: targetPoints, .left action next, lastSame,
        congrArg (mapPoint Subtype.val initial.point :: ·) pointsSame⟩
  | right acted _ ih =>
      intro initial same
      cases same
      rw [acts_iff_compiled] at acted
      obtain ⟨left, right, action, _, rightSame⟩ := (mapAction_branch_iff _ _ _ _).mp acted
      obtain ⟨final, targetPoints, next, lastSame, pointsSame⟩ := ih right rightSame
      exact ⟨final, initial.point :: targetPoints, .right action next, lastSame,
        congrArg (mapPoint Subtype.val initial.point :: ·) pointsSame⟩

theorem mapPoint_injective {First : Type u} {Second : Type v} {length : Nat}
    {f : First → Second} (injective : Function.Injective f) :
    Function.Injective (@mapPoint First Second length f) := by
  intro first second same
  apply Prod.ext
  · exact injective (congrArg Prod.fst same)
  · exact congrArg (fun point : Point Second length => point.2) same

theorem mapThread_injective {First : Type u} {Second : Type v} {length : Nat}
    {f : First → Second} (injective : Function.Injective f) :
    Function.Injective (@mapThread First Second length f) := by
  intro first second same
  cases first with
  | mk firstPoint firstRegisters firstChoices =>
      cases second with
      | mk secondPoint secondRegisters secondChoices =>
          have pointSame := mapPoint_injective injective (congrArg Thread.point same)
          have registersSame := congrArg Thread.registers same
          have choicesSame := congrArg Thread.choices same
          cases pointSame
          cases registersSame
          cases choicesSame
          rfl

theorem view_injective {pattern : Pattern} {length : Nat} :
    Function.Injective (@view pattern length) := mapThread_injective Subtype.val_injective

/-- Exact preservation and reflection includes the entire control-point path,
all branch bits, and the final capture registers. -/
theorem compiled_trace_iff_source {pattern : Pattern} {length : Nat}
    {probe : Probe Graph.CharacterClass String length} {eligible : Thread Address length → Bool}
    (first last : Thread (Graph.Owned (compile pattern)) length)
    (code : List Bool) (points : List (Point (Graph.Owned (compile pattern)) length)) :
    RegexSelectionCorrespondence.Trace (compiledGraph pattern) probe (eligible ∘ view)
      first code points last () ↔
      Trace pattern probe eligible (view first) code (points.map (mapPoint Subtype.val)) (view last) := by
  constructor
  · exact compiled_trace_source
  · intro source
    obtain ⟨final, targetPoints, trace, finalSame, pointsSame⟩ := source_trace_compiled source first rfl
    have finals : final = last := view_injective finalSame
    have pointLists : targetPoints = points :=
      (List.map_injective_iff.mpr (mapPoint_injective Subtype.val_injective)) pointsSame
    simpa only [finals, pointLists] using trace

/-- The independently selected source execution is exactly the independently
least simple execution of the actual compiled graph. The observation includes
every capture register; no recognition-only quotient occurs in this theorem. -/
theorem compiled_selected_iff_source {pattern : Pattern} {length : Nat}
    (probe : Probe Graph.CharacterClass String length) (eligible : Thread Address length → Bool)
    (first last : Thread (Graph.Owned (compile pattern)) length) :
    RegexSelectionCorrespondence.LeastSimple (compiledGraph pattern) probe (eligible ∘ view) first last ↔
      Selected pattern probe eligible (view first) (view last) := by
  constructor
  · rintro ⟨code, points, tag, trace, simple, least⟩
    refine ⟨code, points.map (mapPoint Subtype.val), compiled_trace_source trace,
      simple.map (mapPoint_injective Subtype.val_injective), ?_⟩
    intro otherCode otherPoints otherLast otherTrace otherSimple
    obtain ⟨final, targetPoints, lifted, _, pointsSame⟩ :=
      source_trace_compiled otherTrace first rfl
    have liftedSimple : targetPoints.Nodup := by
      apply (List.nodup_map_iff (mapPoint_injective Subtype.val_injective)).mp
      simpa only [pointsSame] using otherSimple
    exact least otherCode targetPoints final () lifted liftedSimple
  · rintro ⟨code, points, trace, simple, least⟩
    obtain ⟨final, targetPoints, lifted, finalSame, pointsSame⟩ :=
      source_trace_compiled trace first rfl
    have finals : final = last := view_injective finalSame
    subst final
    refine ⟨code, targetPoints, (), lifted, ?_, ?_⟩
    · apply (List.nodup_map_iff (mapPoint_injective Subtype.val_injective)).mp
      simpa only [pointsSame] using simple
    · intro otherCode otherPoints otherLast otherTag otherTrace otherSimple
      exact least otherCode (otherPoints.map (mapPoint Subtype.val)) (view otherLast)
        (compiled_trace_source otherTrace) (otherSimple.map (mapPoint_injective Subtype.val_injective))

namespace Controls

private def emptyProbe : Probe Graph.CharacterClass String 0 :=
  ⟨fun _ _ => false, fun _ _ => false⟩

private def emptyFirst : Thread Address 0 := ⟨(.root, 0), fun _ => none, []⟩

/-- The empty word succeeds through an actual source continuation step. -/
theorem epsilon_execution :
    Trace .epsilon emptyProbe (fun _ => true) emptyFirst []
      [(.root, 0), (.ending, 0)] (emptyFirst.at .ending) := by
  refine .next ⟨.jump .ending, .inside (.epsilon _ _), rfl⟩ ?_
  exact .done ⟨.accept (), .finish, rfl⟩ rfl

private def opened : Thread Address 0 := emptyFirst.saved (.body .root) 0
private def beforeClose : Thread Address 0 := opened.at (.close .root)
private def closed : Thread Address 0 := beforeClose.saved .ending 1

/-- Participating empty captures write both boundaries; an untouched group
remains absent rather than acquiring an empty span. -/
theorem empty_capture_execution :
    Trace (.capture 0 .epsilon) emptyProbe (fun _ => true) emptyFirst []
      [(.root, 0), (.body .root, 0), (.close .root, 0), (.ending, 0)] closed ∧
    closed.registers 0 = some 0 ∧ closed.registers 1 = some 0 ∧ closed.registers 2 = none := by
  constructor
  · refine .next ⟨.save 0 (.body .root), .inside (.captureEntry _ _ _ _), rfl⟩ ?_
    refine .next ⟨.jump (.close .root), .inside (.captureBody (.epsilon _ _)), rfl⟩ ?_
    refine .next ⟨.save 1 .ending, .inside (.captureClose _ _ _ _), rfl⟩ ?_
    exact .done ⟨.accept (), .finish, rfl⟩ rfl
  · decide

/-- A failed source assertion has no accepting source execution. -/
theorem failed_assertion_no_execution :
    ¬ ∃ code points last,
      Trace (.assertion "word-boundary") emptyProbe (fun _ => true) emptyFirst code points last := by
  have dead : ∀ result, Acts (.assertion "word-boundary") emptyProbe emptyFirst result → result = .dead := by
    intro result acted
    obtain ⟨operation, authorized, performed⟩ := acted
    have actual : Authorizes (.assertion "word-boundary") .root
        (.assertion "word-boundary" .ending) := .inside (.assertion _ _ _)
    have same := authorizes_unique _ _ _ _ authorized actual
    simpa only [same, perform, emptyProbe, Bool.false_eq_true, ↓reduceIte] using performed.symm
  rintro ⟨code, points, last, trace⟩
  cases trace with
  | done acted _ => cases dead _ acted
  | next acted _ => cases dead _ acted
  | left acted _ => cases dead _ acted
  | right acted _ => cases dead _ acted

end Controls

end Mettapedia.GSLT.LanguageDef.RegexSelection.Source
