import Mathlib.Data.List.Basic

/-!
# Traces, reachability and trace invariants

An execution is a trace, the list of everything that has happened, oldest first. A protocol
running against its attacker is a transition system whose atomic steps append a block of
events to the current trace; the reachable traces are those obtained from the empty trace by
such steps (`Reachable`). Participants act atomically, as in the state-machine semantics of
DyLean (Wallez, Cremers, IACR ePrint 2026/1493, §2.3, §2.5) and the message exchanges of LeanDY
(Jeanteur, Veronese, Solitro, Maffei, arXiv:2607.03406, §3.2).

Security properties are proved with trace invariants. An *entry invariant* `inv pre e` judges
an event `e` against the trace `pre` that preceded it, and a trace satisfies it when every
entry does (`Holds`); equivalently, every decomposition `pre ++ e :: post` of the trace has
`inv pre e` (`holds_iff`). This is the shape of the trace invariant of DY* and DyLean (§3.2):
messages on the network were publishable when sent, stored states satisfied the state
invariant, protocol events satisfied their predicates. An invariant that holds initially and
is preserved by every step holds on every reachable trace (`Reachable.invariant`).

A proof may need *ghost state* that the specification does not contain. DyLean chooses the
security label of each freshly generated value during the proof, keeps it in a proof trace, and
erases it to recover the execution trace; this keeps specifications free of proof artifacts.
`Reachable.exists_ghost` is DyLean's key reachability theorem (§3.3): if each step of an
execution can be matched by a step of the proof trace that keeps the invariant, every reachable
execution trace is the erasure of a proof trace satisfying the invariant.
-/

namespace Mettapedia.Protocols.Symbolic

variable {Ev : Type}

/-- Traces reachable from the empty trace by atomic steps; `step τ new` allows appending the
block `new` to the trace `τ`. -/
inductive Reachable (step : List Ev → List Ev → Prop) : List Ev → Prop
  | nil : Reachable step []
  | extend {τ new : List Ev} : Reachable step τ → step τ new → Reachable step (τ ++ new)

/-- An invariant that holds initially and is preserved by every step holds on every reachable
trace. -/
theorem Reachable.invariant {step : List Ev → List Ev → Prop} {I : List Ev → Prop}
    (h0 : I []) (hstep : ∀ τ new, Reachable step τ → I τ → step τ new → I (τ ++ new))
    {τ : List Ev} (h : Reachable step τ) : I τ := by
  induction h with
  | nil => exact h0
  | extend hr hs ih => exact hstep _ _ hr ih hs

/-- DyLean's key reachability theorem, with ghost state: `erase` forgets the ghost part of a
proof-trace entry. If every step of the execution from the erasure of a proof trace satisfying
`I` can be matched by ghost entries that keep `I`, then every reachable trace is the erasure of
a proof trace satisfying `I`. -/
theorem Reachable.exists_ghost {Gv : Type} {step : List Ev → List Ev → Prop}
    (erase : Gv → Ev) (I : List Gv → Prop) (h0 : I [])
    (hstep : ∀ τg new, I τg → step (τg.map erase) new →
      ∃ newg : List Gv, newg.map erase = new ∧ I (τg ++ newg))
    {τ : List Ev} (h : Reachable step τ) : ∃ τg : List Gv, τg.map erase = τ ∧ I τg := by
  induction h with
  | nil => exact ⟨[], rfl, h0⟩
  | extend _ hs ih =>
      obtain ⟨τg, rfl, hI⟩ := ih
      obtain ⟨newg, rfl, hI'⟩ := hstep τg _ hI hs
      exact ⟨τg ++ newg, List.map_append, hI'⟩

/-! ## Entry invariants -/

/-- Every entry of the block `τ`, judged against all entries before it, the earlier trace
`pre` included. -/
def HoldsFrom (inv : List Ev → Ev → Prop) : List Ev → List Ev → Prop
  | _, [] => True
  | pre, e :: rest => inv pre e ∧ HoldsFrom inv (pre ++ [e]) rest

/-- The trace invariant generated by the entry invariant `inv`: every entry satisfies `inv`
with respect to the trace that preceded it. -/
def Holds (inv : List Ev → Ev → Prop) (τ : List Ev) : Prop := HoldsFrom inv [] τ

variable {inv : List Ev → Ev → Prop}

@[simp] theorem holdsFrom_nil (pre : List Ev) : HoldsFrom inv pre [] := trivial

@[simp] theorem holdsFrom_cons (pre : List Ev) (e : Ev) (rest : List Ev) :
    HoldsFrom inv pre (e :: rest) ↔ inv pre e ∧ HoldsFrom inv (pre ++ [e]) rest := Iff.rfl

theorem holdsFrom_append (pre l₁ l₂ : List Ev) :
    HoldsFrom inv pre (l₁ ++ l₂) ↔ HoldsFrom inv pre l₁ ∧ HoldsFrom inv (pre ++ l₁) l₂ := by
  induction l₁ generalizing pre with
  | nil => simp
  | cons e l₁ ih => simp [ih, and_assoc]

@[simp] theorem holds_nil : Holds inv [] := trivial

/-- A trace extended by a block satisfies the invariant when the trace does and every entry
of the block does. -/
theorem holds_append (τ new : List Ev) :
    Holds inv (τ ++ new) ↔ Holds inv τ ∧ HoldsFrom inv τ new := by
  simpa [Holds] using holdsFrom_append (inv := inv) [] τ new

theorem holds_snoc (τ : List Ev) (e : Ev) : Holds inv (τ ++ [e]) ↔ Holds inv τ ∧ inv τ e := by
  simp [holds_append]

theorem holdsFrom_iff (pre τ : List Ev) :
    HoldsFrom inv pre τ ↔ ∀ l e r, τ = l ++ e :: r → inv (pre ++ l) e := by
  induction τ generalizing pre with
  | nil => simp
  | cons e₀ τ ih =>
      rw [holdsFrom_cons, ih]
      constructor
      · rintro ⟨h₀, h⟩ l e r hτ
        rcases l with _ | ⟨x, l⟩
        · simp only [List.nil_append, List.cons.injEq] at hτ
          obtain ⟨rfl, rfl⟩ := hτ
          simpa using h₀
        · simp only [List.cons_append, List.cons.injEq] at hτ
          obtain ⟨rfl, rfl⟩ := hτ
          simpa using h l e r rfl
      · intro h
        refine ⟨by simpa using h [] e₀ τ rfl, fun l e r hτ => ?_⟩
        simpa [hτ] using h (e₀ :: l) e r (by simp [hτ])

/-- A trace satisfies the invariant exactly when every entry satisfies it with respect to
its prefix. -/
theorem holds_iff (τ : List Ev) :
    Holds inv τ ↔ ∀ pre e post, τ = pre ++ e :: post → inv pre e := by
  simpa [Holds] using holdsFrom_iff (inv := inv) [] τ

/-- An entry of a trace satisfying the invariant satisfies it with respect to its prefix. -/
theorem Holds.entry {τ pre post : List Ev} {e : Ev} (h : Holds inv τ)
    (he : τ = pre ++ e :: post) : inv pre e :=
  (holds_iff τ).mp h pre e post he

/-- Prefixes of a trace satisfying the invariant satisfy it. -/
theorem Holds.of_prefix {τ τ' : List Ev} (h : Holds inv τ') (hp : τ <+: τ') : Holds inv τ := by
  obtain ⟨rest, rfl⟩ := hp
  exact ((holds_append τ rest).mp h).1

end Mettapedia.Protocols.Symbolic
