import Mathlib.Order.Closure
import Mathlib.Data.Set.Image

/-!
# Dolev–Yao knowledge

The attacker of symbolic (Dolev–Yao) protocol analysis knows what it has observed and
whatever it can compute from that with the operations it may apply. Here this is
modelled for an arbitrary *deduction system*: a relation `R ps m` saying that one step
computes `m` from the premises `ps`. The knowledge generated by a set of observations `K`
is the least superset of `K` closed under the rules (`Deducible R K`). Concrete rules come
from a message algebra: the attacker applies public function symbols
(`Symbolic.Equational`, `Symbolic.Message`).

Knowledge is a closure operator on sets of messages (`knowledgeClosure`): extensive,
monotone and idempotent, and it is the least rule-closed superset of the observations
(`Deducible.mem_of_closed`). That last property is the induction principle behind the
secrecy proofs of this development: a property of all observations that every rule
preserves holds of everything the attacker knows. Secrecy of `m` is non-deducibility
(`Secret`), and the way to prove it is to exhibit a rule-closed over-approximation of the
observations that excludes `m` (`secret_of_closed`).

`Deducible.map` transfers deductions along a map that sends each rule to a derivation.
`Symbolic.Equational` uses it to show that deduction in the symbolic term model modulo an
equational theory is reflected in every algebra satisfying the theory.

The attacker as an inductive predicate closed under constructors and destructors is
LeanDY's `AttackerKnows` (Jeanteur, Veronese, Solitro, Maffei, *LeanDY: Type-Based and
Trace-Based Symbolic Protocol Verification in Lean*, arXiv:2607.03406); attacker knowledge
as the least fixpoint over user-chosen attacker functions is DyLean's (Wallez, Cremers,
*Bob DyLean: A Framework for the Symbolic Analysis of Cryptographic Protocols in Lean*,
IACR ePrint 2026/1493, §2.4). Both are instances of `Deducible`.
-/

namespace Mettapedia.Protocols.Symbolic

/-- A deduction system on messages `M`: `R ps m` means that one step computes `m` from the
premises `ps`. -/
abbrev Rules (M : Type) := List M → M → Prop

/-- The messages deducible from the observations `K`: the least set containing `K` and
closed under the rules. -/
inductive Deducible {M : Type} (R : Rules M) (K : Set M) : M → Prop
  /-- Everything observed is known. -/
  | known {m : M} : m ∈ K → Deducible R K m
  /-- A rule applied to known premises yields known conclusions. -/
  | rule {ps : List M} {m : M} : R ps m → (∀ p ∈ ps, Deducible R K p) → Deducible R K m

/-- A set of messages closed under the rules. -/
def Closed {M : Type} (R : Rules M) (X : Set M) : Prop :=
  ∀ ⦃ps : List M⦄ ⦃m : M⦄, R ps m → (∀ p ∈ ps, p ∈ X) → m ∈ X

namespace Deducible

variable {M M' : Type} {R : Rules M} {R' : Rules M'} {K K' X : Set M} {m : M}

/-- Knowledge is extensive: observations are known. -/
theorem of_mem (h : m ∈ K) : Deducible R K m := known h

/-- Knowledge is contained in every rule-closed set that contains the observations. -/
theorem mem_of_closed (hK : K ⊆ X) (hX : Closed R X) (h : Deducible R K m) : m ∈ X := by
  induction h with
  | known hm => exact hK hm
  | rule hr _ ih => exact hX hr ih

/-- Knowledge is closed under the rules. -/
theorem closed : Closed R {m | Deducible R K m} :=
  fun _ _ hr hps => rule hr hps

/-- Knowledge is monotone in the observations. -/
theorem mono (hK : K ⊆ K') (h : Deducible R K m) : Deducible R K' m :=
  mem_of_closed (fun _ hx => known (hK hx)) closed h

/-- Cut: what is deducible from deducible messages is deducible. -/
theorem trans (hK' : ∀ x ∈ K', Deducible R K x) (h : Deducible R K' m) : Deducible R K m :=
  mem_of_closed hK' closed h

/-- Knowledge is idempotent. -/
theorem idem : Deducible R {x | Deducible R K x} m ↔ Deducible R K m :=
  ⟨trans fun _ hx => hx, mono fun _ hx => known hx⟩

/-- More rules deduce more. -/
theorem mono_rules {R₂ : Rules M} (hR : ∀ ⦃ps m⦄, R ps m → R₂ ps m)
    (h : Deducible R K m) : Deducible R₂ K m := by
  induction h with
  | known hm => exact known hm
  | rule hr _ ih => exact rule (hR hr) ih

/-- Deductions transfer along a map that sends every rule instance to a derivation from the
images of its premises. -/
theorem map (φ : M → M')
    (hφ : ∀ ⦃ps : List M⦄ ⦃m : M⦄, R ps m → Deducible R' {x | ∃ p ∈ ps, φ p = x} (φ m))
    (h : Deducible R K m) : Deducible R' (φ '' K) (φ m) := by
  induction h with
  | known hm => exact known ⟨_, hm, rfl⟩
  | rule hr _ ih =>
      refine trans ?_ (hφ hr)
      rintro _ ⟨p, hp, rfl⟩
      exact ih p hp

end Deducible

/-- Attacker knowledge as a closure operator on sets of messages; its closed sets are the
rule-closed sets. -/
def knowledgeClosure {M : Type} (R : Rules M) : ClosureOperator (Set M) :=
  ClosureOperator.ofPred (fun K => {m | Deducible R K m}) (Closed R)
    (fun _ _ hm => Deducible.known hm) (fun _ => Deducible.closed)
    (fun _ _ hK hX _ hm => Deducible.mem_of_closed hK hX hm)

theorem knowledgeClosure_apply {M : Type} (R : Rules M) (K : Set M) :
    knowledgeClosure R K = {m | Deducible R K m} := rfl

theorem knowledgeClosure_isClosed {M : Type} (R : Rules M) (X : Set M) :
    (knowledgeClosure R).IsClosed X ↔ Closed R X := Iff.rfl

/-- `m` is secret: it cannot be deduced from the observations `K`. -/
def Secret {M : Type} (R : Rules M) (K : Set M) (m : M) : Prop := ¬ Deducible R K m

section Secret

variable {M M' : Type} {R : Rules M} {K K' X : Set M} {m : M}

/-- A rule-closed over-approximation of the observations that excludes `m` proves `m`
secret. -/
theorem secret_of_closed (hK : K ⊆ X) (hX : Closed R X) (hm : m ∉ X) : Secret R K m :=
  fun h => hm (h.mem_of_closed hK hX)

/-- Secrecy needs only a property preserved by the rules, true of the observations and
false of the secret. -/
theorem secret_of_invariant (P : M → Prop) (hK : ∀ x ∈ K, P x)
    (hR : ∀ ⦃ps : List M⦄ ⦃m : M⦄, R ps m → (∀ p ∈ ps, P p) → P m) (hm : ¬ P m) :
    Secret R K m :=
  secret_of_closed (X := {x | P x}) hK hR hm

/-- Fewer observations keep more secrets. -/
theorem Secret.anti (hK : K ⊆ K') (h : Secret R K' m) : Secret R K m :=
  fun hd => h (hd.mono hK)

/-- Secrecy of an image implies secrecy, for maps that send rules to derivations. -/
theorem Secret.of_map {R' : Rules M'} (φ : M → M')
    (hφ : ∀ ⦃ps : List M⦄ ⦃m : M⦄, R ps m → Deducible R' {x | ∃ p ∈ ps, φ p = x} (φ m))
    (h : Secret R' (φ '' K) (φ m)) : Secret R K m :=
  fun hd => h (hd.map φ hφ)

end Secret

end Mettapedia.Protocols.Symbolic
