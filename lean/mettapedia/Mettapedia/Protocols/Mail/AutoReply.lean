import Mettapedia.Protocols.Mail.Mailbox

/-!
# Automatic mail is not answered automatically

Internet mail has two mechanisms that keep automatic messages from answering
one another.
- RFC 5321 §6.1: a notification of a delivery failure goes to the envelope's
  return path and is sent with the null reverse-path `<>`, and no notification
  is sent when the return path is null. §4.5.5: automated processors do not
  reply to mail with a null reverse-path, and a forwarder does not give such
  mail a non-null one. §4.5.4: a queuing strategy never sends error messages in
  response to error messages.
- RFC 3834: an automatic response carries `Auto-Submitted: auto-replied`
  (§3.1.7). No automatic response answers mail whose `Auto-Submitted` field has a
  value other than `no`, and none goes to a null address (§2). A response goes
  to the return path (§4), and its own reverse-path may be `<>` (§3.3).

The model: a message in transit is a `Mail.Message` with an envelope (one
recipient and a reverse-path that may be null) and an optional `Auto-Submitted`
keyword. Each address has a responder, which answers a delivered message with at
most one message. Transit (forwarders and gateways) may rewrite mail on the way.
A system keeps a test of automatic mail when every responder skips the mail that
passes it, every answer passes it, and transit preserves it.

The theorems:
- `answer_unanswered`, `chain_le_one`: in a system that keeps a test, no answer
  is answered. A chain of automatic messages started by one message holds at
  most one automatic message.
- `run_quiesces`: such a system, started with `n` messages in flight, is quiet
  after `2 * n` deliveries.
- `rfc3834_keeps`, `marks_keeps`, `bounces_keeps`: three tests that systems
  keep. RFC 3834's (marked or null reverse-path) serves responders that follow
  it. The mark alone serves mail with no envelope. The null reverse-path alone
  serves notifications that go to the return path (`returns_skip_null`).
- Mutants, each refuting the conclusion: answers without the mark loop forever
  (`unmarked_loops`), and so do responders that answer marked mail
  (`unchecked_loops`) and a gateway that drops the mark (`stripping_loops`).
  Notifiers that answer only requests, with notices, keep the test "not a
  request" among themselves (`notifiers_keep`), yet loop with an agent that
  answers notices with requests (`alternating_loops`). A notifier that honours
  only the null reverse-path, next to a responder whose marked answers have a
  non-null one, makes a chain of two automatic messages (`mixed_chain_two`).
  With `<>` as the responder's reverse-path (RFC 3834 §3.3) the same pair keeps
  the null reverse-path test (`mixed_null_keeps`).

Not modelled: timing, a responder's memory (RFC 3834 §2's once-per-period rule
for personal responders), several envelope recipients, and message content.
-/

set_option autoImplicit false

namespace Mettapedia.Protocols.Mail.AutoReply

open Mettapedia.Protocols.Mail

/-- The keywords of the `Auto-Submitted` field (RFC 3834 §5.1). -/
inductive Keyword
  | no
  | autoGenerated
  | autoReplied
  | extension (token : String)
deriving DecidableEq, Repr

/-- A message in transit: its header, the envelope's recipient and reverse-path
(`none` is the null reverse-path `<>`), and its `Auto-Submitted` field. -/
structure MailObject where
  msg : Message
  recipient : Address
  reversePath : Option Address
  autoSubmitted : Option Keyword
deriving DecidableEq, Repr

namespace MailObject

/-- Marked automatic: an `Auto-Submitted` field with a value other than `no`
(RFC 3834 §2, §5.2). -/
def marked (m : MailObject) : Bool :=
  match m.autoSubmitted with
  | none => false
  | some .no => false
  | some _ => true

/-- The null reverse-path. -/
def nullPath (m : MailObject) : Bool := m.reversePath.isNone

/-- RFC 3834's test: marked, or a response would go to a null address (§2). -/
def automatic (m : MailObject) : Bool := m.marked || m.nullPath

end MailObject

/-- What an address answers automatically: at most one message per delivery. -/
abbrev Responder := MailObject → Option MailObject

/-- A mail system: each address's responder, and what transit does on the way. -/
structure System where
  respond : Address → Responder
  transit : MailObject → MailObject

namespace System

/-- After transit, `m` reaches its recipient, whose responder answers `r`. -/
def Answers (S : System) (m r : MailObject) : Prop :=
  S.respond (S.transit m).recipient (S.transit m) = some r

instance (S : System) (m r : MailObject) : Decidable (S.Answers m r) :=
  inferInstanceAs (Decidable (_ = _))

/-- The system keeps the test `t`: every responder skips mail that passes it,
every answer passes it, and transit preserves it. -/
structure Keeps (S : System) (t : MailObject → Bool) : Prop where
  skips : ∀ a m, t m = true → S.respond a m = none
  answers : ∀ a m r, S.respond a m = some r → t r = true
  transit : ∀ m, t m = true → t (S.transit m) = true

variable {S : System} {t : MailObject → Bool}

/-- No answer is answered. -/
theorem answer_unanswered (h : S.Keeps t) {m r : MailObject} (hr : S.Answers m r) (r' : MailObject) :
    ¬ S.Answers r r' := by
  intro hr'
  have : t (S.transit r) = true := h.transit r (h.answers _ _ _ hr)
  rw [Answers, h.skips _ _ this] at hr'
  cases hr'

/-- A chain of automatic messages started by one message holds at most one
automatic message: the chain has at most two messages. -/
theorem chain_le_one (h : S.Keeps t) {ms : List MailObject} (hc : ms.IsChain S.Answers) :
    ms.length ≤ 2 := by
  match ms, hc with
  | [], _ => simp
  | [_], _ => simp
  | [_, _], _ => simp
  | _ :: _ :: c :: _, hc =>
    simp only [List.isChain_cons_cons] at hc
    exact absurd hc.2.1 (answer_unanswered h hc.1 c)

/-! ## The system runs quiet -/

/-- Deliver the oldest message in flight; its answer, if any, joins the queue. -/
def step (S : System) : List MailObject → List MailObject
  | [] => []
  | m :: rest => rest ++ (S.respond (S.transit m).recipient (S.transit m)).toList

/-- `n` deliveries. -/
def run (S : System) : Nat → List MailObject → List MailObject
  | 0, q => q
  | n + 1, q => S.run n (S.step q)

/-- Mail that draws no answer weighs one, other mail two. -/
def weight (S : System) (t : MailObject → Bool) (m : MailObject) : Nat := if t (S.transit m) then 1 else 2

/-- The total weight of the mail in flight. -/
def load (S : System) (t : MailObject → Bool) (q : List MailObject) : Nat := (q.map (S.weight t)).sum

theorem weight_pos (m : MailObject) : 0 < S.weight t m := by
  unfold weight; split <;> omega

theorem load_le (q : List MailObject) : S.load t q ≤ 2 * q.length := by
  induction q with
  | nil => simp [load]
  | cons m q ih =>
    have : S.weight t m ≤ 2 := by unfold weight; split <;> omega
    simp only [load, List.map_cons, List.sum_cons, List.length_cons] at ih ⊢
    omega

/-- Each delivery lowers the load. -/
theorem load_step (h : S.Keeps t) {m : MailObject} {rest : List MailObject} :
    S.load t (S.step (m :: rest)) < S.load t (m :: rest) := by
  simp only [step, load, List.map_append, List.sum_append, List.map_cons, List.sum_cons]
  cases hr : S.respond (S.transit m).recipient (S.transit m) with
  | none => simp [weight_pos]
  | some r =>
    have hm : t (S.transit m) = false := by
      cases ht : t (S.transit m)
      · rfl
      · rw [h.skips _ _ ht] at hr; cases hr
    have hw : S.weight t r = 1 := by simp [weight, h.transit r (h.answers _ _ _ hr)]
    have hwm : S.weight t m = 2 := by simp [weight, hm]
    simp only [Option.toList_some, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil, hw, hwm]
    omega

theorem run_nil {n : Nat} : S.run n [] = [] := by
  induction n with
  | zero => rfl
  | succ n ih => simpa [run, step] using ih

theorem run_quiet (h : S.Keeps t) : ∀ (n : Nat) (q : List MailObject), S.load t q ≤ n → S.run n q = []
  | 0, [], _ => rfl
  | 0, m :: rest, hl => absurd hl (by
      have := weight_pos (S := S) (t := t) m
      simp only [load, List.map_cons, List.sum_cons] at *
      omega)
  | n + 1, [], _ => run_nil
  | n + 1, m :: rest, hl => by
    have := load_step (S := S) h (m := m) (rest := rest)
    exact run_quiet h n _ (by omega)

/-- Generation ends: started with `n` messages in flight, the system is quiet
after `2 * n` deliveries. -/
theorem run_quiesces (h : S.Keeps t) (q : List MailObject) : S.run (2 * q.length) q = [] :=
  run_quiet h _ q (load_le q)

/-- Mail that a responder always answers, keeping a property the answer has
too, keeps a system busy forever. -/
theorem run_busy {P : MailObject → Prop} (hp : ∀ m, P m → ∃ r, S.Answers m r ∧ P r) :
    ∀ (n : Nat) (m : MailObject), P m → ∃ m', S.run n [m] = [m'] ∧ P m'
  | 0, m, hm => ⟨m, rfl, hm⟩
  | n + 1, m, hm => by
    obtain ⟨r, hr, hpr⟩ := hp m hm
    have : S.step [m] = [r] := by
      have hr' : S.respond (S.transit m).recipient (S.transit m) = some r := hr
      simp [step, hr']
    simpa [run, this] using run_busy hp n r hpr

end System

/-! ## Tests that systems keep -/

/-- RFC 3834's responder: it skips automatic mail and marks its answers, or
sends them with the null reverse-path. -/
structure Rfc3834 (f : Responder) : Prop where
  skips : ∀ m, m.automatic = true → f m = none
  marks : ∀ m r, f m = some r → r.automatic = true

/-- Faithful transit: a relay changes no message data beyond trace fields (RFC
5321 §2.3.10), so it keeps the mark, and no forwarder makes a null reverse-path
non-null (§4.5.5). A gateway may rewrite header fields (§3.7.1);
`stripping_loops` shows the cost of dropping this one. -/
def Faithful (transit : MailObject → MailObject) : Prop :=
  ∀ m, (transit m).marked = m.marked ∧ (m.nullPath = true → (transit m).nullPath = true)

theorem faithful_automatic {tr : MailObject → MailObject} (h : Faithful tr) (m : MailObject)
    (hm : m.automatic = true) : (tr m).automatic = true := by
  simp only [MailObject.automatic, Bool.or_eq_true] at hm ⊢
  rcases hm with hm | hm
  · exact Or.inl ((h m).1 ▸ hm)
  · exact Or.inr ((h m).2 hm)

/-- Responders that follow RFC 3834, with faithful forwarders, keep its test. -/
theorem rfc3834_keeps {S : System} (hr : ∀ a, Rfc3834 (S.respond a)) (ht : Faithful S.transit) :
    S.Keeps MailObject.automatic :=
  ⟨fun a m h => (hr a).skips m h, fun a m r h => (hr a).marks m r h,
    fun m h => faithful_automatic ht m h⟩

/-- Without an envelope, the mark alone: responders skip marked mail and mark
their answers, and transit keeps the mark. -/
theorem marks_keeps {S : System} (skips : ∀ a m, m.marked = true → S.respond a m = none)
    (marks : ∀ a m r, S.respond a m = some r → r.marked = true)
    (ht : ∀ m, m.marked = true → (S.transit m).marked = true) : S.Keeps MailObject.marked :=
  ⟨skips, marks, ht⟩

/-- RFC 5321 §6.1: a notification goes to the return path of the mail it is about. -/
def Returns (f : Responder) : Prop := ∀ m r, f m = some r → m.reversePath = some r.recipient

/-- So mail with the null reverse-path draws no notification. -/
theorem returns_skip_null {f : Responder} (h : Returns f) (m : MailObject) (hm : m.nullPath = true) :
    f m = none := by
  cases hf : f m with
  | none => rfl
  | some r =>
    have := h m r hf
    simp [MailObject.nullPath, this] at hm

/-- Notifiers that send to the return path with the null reverse-path, with
forwarders that keep it null, keep the null reverse-path test. -/
theorem bounces_keeps {S : System} (ret : ∀ a, Returns (S.respond a))
    (nul : ∀ a m r, S.respond a m = some r → r.nullPath = true)
    (ht : ∀ m, m.nullPath = true → (S.transit m).nullPath = true) : S.Keeps MailObject.nullPath :=
  ⟨fun a m h => returns_skip_null (ret a) m h, nul, ht⟩

/-! ## Examples -/

/-- A message with one recipient, no parents and an empty body. -/
def note (id sender rcpt : String) : Message := ⟨id, sender, [rcpt], 0, "", [], [], ""⟩

/-- An RFC 3834 responder at `me`: it answers mail that is not automatic, at the
return path, marked `auto-replied`, with the reverse-path `back`. -/
def vacation (me : Address) (back : Option Address) : Responder := fun m =>
  if m.automatic then none
  else match m.reversePath with
    | none => none
    | some rp => some ⟨note "re" me rp, rp, back, some .autoReplied⟩

/-- A notifier as RFC 5321 §6.1 has it: every message with a return path is
bounced there, with the null reverse-path and no mark. -/
def bouncer (me : Address) : Responder := fun m =>
  match m.reversePath with
  | none => none
  | some rp => some ⟨note "bounce" me rp, rp, none, none⟩

theorem vacation_rfc3834 (me : Address) (back : Option Address) : Rfc3834 (vacation me back) := by
  refine ⟨fun m h => by simp [vacation, h], fun m r h => ?_⟩
  unfold vacation at h
  split at h
  · cases h
  · split at h
    · cases h
    · cases h; simp [MailObject.automatic, MailObject.marked]

/-- A responder at `b`, nothing at the other addresses, and no rewriting. -/
def oneResponder : System :=
  ⟨fun a => if a = "b" then vacation "b" (some "b") else fun _ => none, id⟩

/-- Mail from `a` to `b`, with `a` as its return path and no mark. -/
def hello : MailObject := ⟨note "m" "a" "b", "b", some "a", none⟩

/-- The hypotheses meet: the system keeps RFC 3834's test, and `hello` draws an
answer, so the chain `[hello, answer]` reaches the bound. -/
example : oneResponder.Keeps MailObject.automatic ∧ ∃ r, oneResponder.Answers hello r ∧
    [hello, r].IsChain oneResponder.Answers := by
  refine ⟨rfc3834_keeps (fun a => ?_) (fun m => ⟨rfl, id⟩), ?_⟩
  · by_cases ha : a = "b"
    · simpa [oneResponder, ha] using vacation_rfc3834 "b" (some "b")
    · simpa [oneResponder, ha] using
        (⟨fun _ _ => rfl, fun _ _ h => by cases h⟩ : Rfc3834 (fun _ => none))
  · refine ⟨⟨note "re" "b" "a", "a", some "b", some .autoReplied⟩, by decide, ?_⟩
    simp only [List.isChain_cons_cons, List.IsChain.singleton, and_true]
    decide

/-- One answer, then quiet. -/
example : oneResponder.run 1 [hello] ≠ [] ∧ oneResponder.run 2 [hello] = [] := by decide

/-! ## Mutants -/

/-- Answer the originator of any mail; `skip` decides whether marked mail is
skipped and `mark` whether the answer is marked. -/
def echo (me : Address) (skip mark : Bool) : Responder := fun m =>
  if skip && m.marked then none
  else some ⟨note "re" me m.msg.originator, m.msg.originator, some me,
    if mark then some .autoReplied else none⟩

/-- Two echoing addresses and no rewriting. -/
def pair (skip mark : Bool) (tr : MailObject → MailObject) : System :=
  ⟨fun a => echo a skip mark, tr⟩

/-- Answers without the mark loop forever, though each responder skips marked
mail. -/
theorem unmarked_loops : ∀ n, (pair true false id).run n [hello] ≠ [] := by
  intro n hn
  obtain ⟨m', hm', -⟩ := (pair true false id).run_busy (P := fun m => m.marked = false)
    (fun m hm => ⟨_, by simp [System.Answers, pair, echo, hm, id]; rfl, rfl⟩) n hello rfl
  rw [hm'] at hn
  cases hn

/-- Responders that answer marked mail loop forever, though every answer is
marked. -/
theorem unchecked_loops : ∀ n, (pair false true id).run n [hello] ≠ [] := by
  intro n hn
  obtain ⟨m', hm', -⟩ := (pair false true id).run_busy (P := fun _ => True)
    (fun m _ => ⟨_, by simp [System.Answers, pair, echo, id]; rfl, trivial⟩) n hello trivial
  rw [hm'] at hn
  cases hn

/-- A gateway that drops `Auto-Submitted` on the way. -/
def strip (m : MailObject) : MailObject := { m with autoSubmitted := none }

/-- Responders that skip marked mail and mark their answers loop forever behind a
gateway that drops the mark. -/
theorem stripping_loops : ∀ n, (pair true true strip).run n [hello] ≠ [] := by
  intro n hn
  obtain ⟨m', hm', -⟩ := (pair true true strip).run_busy (P := fun _ => True)
    (fun m _ => ⟨_, by simp [System.Answers, pair, echo, strip, MailObject.marked]; rfl, trivial⟩)
    n hello trivial
  rw [hm'] at hn
  cases hn

/-- A notifier at `a` and, at `b`, a responder whose reverse-path is `back`. -/
def mixed (back : Option Address) : System :=
  ⟨fun a => if a = "b" then vacation "b" back else bouncer a, id⟩

/-- With a non-null reverse-path on the marked answer, the notifier bounces it:
a chain of two automatic messages. -/
theorem mixed_chain_two : ∃ ms : List MailObject, ms.IsChain (mixed (some "b")).Answers ∧ ms.length = 3 :=
  ⟨[hello, ⟨note "re" "b" "a", "a", some "b", some .autoReplied⟩,
      ⟨note "bounce" "a" "b", "b", none, none⟩],
    by simp only [List.isChain_cons_cons, List.IsChain.singleton, and_true]; decide, rfl⟩

/-- With `<>` as the responder's reverse-path (RFC 3834 §3.3), the pair keeps the
null reverse-path test, so `chain_le_one` holds for it. -/
theorem mixed_null_keeps : (mixed none).Keeps MailObject.nullPath := by
  refine bounces_keeps (fun a => ?_) (fun a m r h => ?_) (fun m h => h)
  · intro m r h
    simp only [mixed] at h
    split at h
    · unfold vacation at h
      split at h
      · cases h
      · split at h
        · cases h
        · next rp hrp => cases h; exact hrp
    · unfold bouncer at h
      split at h
      · cases h
      · next rp hrp => cases h; exact hrp
  · simp only [mixed] at h
    split at h
    · unfold vacation at h
      split at h
      · cases h
      · split at h
        · cases h
        · cases h; rfl
    · unfold bouncer at h
      split at h
      · cases h
      · cases h; rfl

/-- Answer requests with notices, or notices with requests; a request is mail
whose subject is `request`. -/
def answering (fromRequest toRequest : Bool) (me : Address) : Responder := fun m =>
  if (m.msg.subject == "request") = fromRequest then
    some ⟨{ note "re" me m.msg.originator with subject := if toRequest then "request" else "" },
      m.msg.originator, some me, none⟩
  else none

/-- Notifiers that answer requests with notices keep the test "not a request"
among themselves. -/
theorem notifiers_keep :
    (⟨fun a => answering true false a, id⟩ : System).Keeps (fun m => m.msg.subject != "request") := by
  refine ⟨fun a m h => ?_, fun a m r h => ?_, fun m h => h⟩
  · simp only [bne_iff_ne, ne_eq] at h
    simp [answering, h]
  · simp only [answering] at h
    split at h
    · cases h; simp
    · cases h

/-- A notifier at `a`, and at `b` an agent that answers notices with requests. -/
def alternating : System :=
  ⟨fun a => if a = "a" then answering true false "a" else answering false true "b", id⟩

/-- A request from `b` to `a`. -/
def request : MailObject := ⟨{ note "m" "b" "a" with subject := "request" }, "a", some "b", none⟩

/-- With such an agent beside it, the notifier's notices are answered, and the
pair loops forever, though the notifiers alone keep their test. -/
theorem alternating_loops : ∀ n, alternating.run n [request] ≠ [] := by
  intro n hn
  obtain ⟨m', hm', -⟩ := alternating.run_busy
    (P := fun m => (m.recipient = "a" ∧ m.msg.subject = "request" ∧ m.msg.originator = "b") ∨
      (m.recipient = "b" ∧ m.msg.subject = "" ∧ m.msg.originator = "a"))
    (fun m hm => by
      rcases hm with ⟨h1, h2, h3⟩ | ⟨h1, h2, h3⟩
      · refine ⟨⟨{ note "re" "a" "b" with subject := "" }, "b", some "a", none⟩, ?_, Or.inr ⟨rfl, rfl, rfl⟩⟩
        simp [System.Answers, alternating, answering, h1, h2, h3]
      · refine ⟨⟨{ note "re" "b" "a" with subject := "request" }, "a", some "b", none⟩, ?_,
          Or.inl ⟨rfl, rfl, rfl⟩⟩
        simp [System.Answers, alternating, answering, h1, h2, h3])
    n request (Or.inl ⟨rfl, rfl, rfl⟩)
  rw [hm'] at hn
  cases hn

/-! ## The other tests' hypotheses meet -/

/-- Echoing responders that skip marked mail and mark their answers keep the mark
alone; `hello` draws an answer there too. -/
example : (pair true true id).Keeps MailObject.marked ∧ ∃ r, (pair true true id).Answers hello r := by
  refine ⟨marks_keeps (fun a m h => by simp [pair, echo, h]) (fun a m r h => ?_) (fun m h => h),
    _, rfl⟩
  simp only [pair, echo, Bool.true_and] at h
  split at h
  · cases h
  · cases h; rfl

/-- The notifier sends to the return path, and skips mail with the null
reverse-path; the pair with `<>` still answers `hello`. -/
example : Returns (bouncer "a") ∧ bouncer "a" ⟨note "n" "b" "a", "a", none, none⟩ = none ∧
    ∃ r, (mixed none).Answers hello r := by
  refine ⟨fun m r h => ?_, rfl, _, rfl⟩
  unfold bouncer at h
  split at h
  · cases h
  · next rp hrp => cases h; exact hrp

end Mettapedia.Protocols.Mail.AutoReply
