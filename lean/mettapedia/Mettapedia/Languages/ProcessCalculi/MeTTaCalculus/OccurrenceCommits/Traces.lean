import Mettapedia.Languages.ProcessCalculi.MeTTaCalculus.OccurrenceCommits.Waves

/-!
# Worlds up to trace equivalence

Under `each`, alternatives become worlds: runs of commits. Many runs differ only in the order of
commits that do not interact. Quotienting by that difference (Mazurkiewicz trace equivalence) is
the right object for exploring alternatives exactly when it loses nothing that the meaning keeps
and identifies every reordering that the meaning does not see.

## Trace equivalence

Two commits are **trace independent** when they are independent (`Exactness`) and neither makes
what the other uses: there is no causal order between them (`TraceIndependent`). Trace
equivalence is generated by swapping adjacent trace-independent commits (`TraceEq`).

* **It loses nothing the meaning keeps** (`TraceEq.executable`): trace-equivalent sequences are
  executable together and reach one store, and they are permutations of each other, so they
  give one bag of answers (`TraceEq.answers_eq`). The list of answers is not kept
  (`Controls.answer_order_not_kept`), as decision §11 says it should not be.
* **It identifies every reordering of a wave** (`wave_orders_traceEq`): any two executable orders
  of the commits of one snapshot are trace equivalent, with predicate queries included. So a wave of
  pairwise independent commits, which has `n!` executable orders, is one trace: one world.
* **It identifies every reordering of a run without predicate queries** (`positive_runs_traceEq`):
  with fresh identities, any two executable orders of the same commits are trace equivalent, though
  commits may use what earlier ones made. Trace equivalence keeps the order of dependent commits
  (`TraceEq.filter_eq`), so for these runs the quotient is exact: one trace per set of commits
  and causal order.

## Where the quotient is not enough: absence restored

In a run whose commits are matched at different stores, an absence read can be falsified by one
commit and restored by a later one: making an occurrence inside the region, then taking it. Then
two executable permutations reach the same store and are **not** trace equivalent
(`Controls.restored_absence_two_traces`): the commit that read the absence does not commute with
the maker, though the maker and the taker together leave its region as it was. Exploration by
traces stays sound (it never merges different outcomes) but keeps a redundant world. Absence over
regions that a run writes needs a frontier or an epoch, as elsewhere.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.ProcessCalculi.MeTTaCalculus.OccurrenceCommits

universe u v

variable {O : Type u} [DecidableEq O] {R : Type v}

/-- **Trace independence**: independent, and neither makes what the other uses. -/
def TraceIndependent (label : O → R) (c d : Commit O R) : Prop :=
  Independent label c d ∧ Disjoint c.made d.uses ∧ Disjoint d.made c.uses

theorem TraceIndependent.symm {label : O → R} {c d : Commit O R}
    (independent : TraceIndependent label c d) : TraceIndependent label d c :=
  ⟨independent.1.symm, independent.2.2, independent.2.1⟩

/-- **The swap.** Two adjacent trace-independent commits can be exchanged in an executable
sequence; the result is executable and reaches the same store. -/
theorem swap_executable {label : O → R} {store : Finset O} {c d : Commit O R}
    {rest : List (Commit O R)} (independent : TraceIndependent label c d)
    (executable : Executable label store (c :: d :: rest)) :
    Executable label store (d :: c :: rest) ∧
      fireList store (d :: c :: rest) = fireList store (c :: d :: rest) := by
  rw [executable_cons_iff, executable_cons_iff] at executable
  obtain ⟨enabledC, enabledD', after⟩ := executable
  obtain ⟨⟨noClash, noSpoilCD, noSpoilDC⟩, madeCApart, madeDApart⟩ := independent
  have noWriteC : ∀ read ∈ d.queries, ∀ o ∈ c.taken ∪ c.made, read.region (label o) = false := by
    intro read member o written
    by_contra inRegion
    exact noSpoilCD (Or.inr ⟨read, member, o, written, by simpa using inRegion⟩)
  have enabledD : Enabled label store d :=
    { taken_subset := fun o taken => by
        rcases mem_fire.mp (enabledD'.taken_subset taken) with ⟨inStore, _⟩ | made
        · exact inStore
        · exact absurd (Finset.mem_union_left _ taken)
            (Finset.disjoint_left.mp madeCApart made)
      kept_subset := fun o kept => by
        rcases mem_fire.mp (enabledD'.kept_subset kept) with ⟨inStore, _⟩ | made
        · exact inStore
        · exact absurd (Finset.mem_union_right _ kept)
            (Finset.disjoint_left.mp madeCApart made)
      apart := enabledD'.apart
      fresh := by
        refine Finset.disjoint_left.mpr fun o made inStore => ?_
        by_cases taken : o ∈ c.taken
        · exact Finset.disjoint_left.mp madeDApart made (Finset.mem_union_left _ taken)
        · exact Finset.disjoint_left.mp enabledD'.fresh made (mem_fire.mpr (Or.inl ⟨inStore, taken⟩))
      queries_hold := fun read member => by
        have holds := enabledD'.queries_hold read member
        unfold PredicateQuery.Holds at holds ⊢
        rwa [regionOf_fire_of_no_write (noWriteC read member)] at holds }
  have enabledCAfter : Enabled label (fire store d) c :=
    (enabled_fire_iff enabledC enabledD).mpr ⟨noClash, noSpoilDC⟩
  have same : fire (fire store d) c = fire (fire store c) d := (fire_comm enabledC enabledD).symm
  refine ⟨.cons enabledD (.cons enabledCAfter (same ▸ after)), ?_⟩
  simp only [fireList_cons, same]

/-! ## Trace equivalence -/

/-- One swap of adjacent trace-independent commits, anywhere in a sequence. -/
inductive SwapStep (label : O → R) : List (Commit O R) → List (Commit O R) → Prop
  | swap (pre post : List (Commit O R)) (c d : Commit O R) (independent : TraceIndependent label c d) :
      SwapStep label (pre ++ c :: d :: post) (pre ++ d :: c :: post)

/-- Trace equivalence: the swaps, any number of times. -/
def TraceEq (label : O → R) : List (Commit O R) → List (Commit O R) → Prop :=
  Relation.ReflTransGen (SwapStep label)

theorem SwapStep.symm {label : O → R} {l l' : List (Commit O R)} (step : SwapStep label l l') :
    SwapStep label l' l := by
  cases step with
  | swap pre post c d independent => exact .swap pre post d c independent.symm

theorem TraceEq.symm {label : O → R} {l l' : List (Commit O R)} (eq : TraceEq label l l') :
    TraceEq label l' l := by
  induction eq with
  | refl => exact .refl
  | tail _ step ih => exact Relation.ReflTransGen.head step.symm ih

theorem TraceEq.trans {label : O → R} {l l' l'' : List (Commit O R)} (first : TraceEq label l l')
    (second : TraceEq label l' l'') : TraceEq label l l'' :=
  Relation.ReflTransGen.trans first second

theorem TraceEq.cons {label : O → R} {l l' : List (Commit O R)} (eq : TraceEq label l l')
    (x : Commit O R) : TraceEq label (x :: l) (x :: l') := by
  induction eq with
  | refl => exact .refl
  | tail _ step ih =>
      cases step with
      | swap pre post c d independent =>
          exact ih.tail (by simpa using SwapStep.swap (x :: pre) post c d independent)

theorem SwapStep.perm {label : O → R} {l l' : List (Commit O R)} (step : SwapStep label l l') :
    l.Perm l' := by
  cases step with
  | swap pre post c d _ => exact List.Perm.append_left pre (List.Perm.swap d c post)

/-- Trace-equivalent sequences are permutations of each other. -/
theorem TraceEq.perm {label : O → R} {l l' : List (Commit O R)} (eq : TraceEq label l l') :
    l.Perm l' := by
  induction eq with
  | refl => exact List.Perm.refl _
  | tail _ step ih => exact ih.trans step.perm

theorem SwapStep.executable {label : O → R} {store : Finset O} {l l' : List (Commit O R)}
    (step : SwapStep label l l') (executable : Executable label store l) :
    Executable label store l' ∧ fireList store l' = fireList store l := by
  cases step with
  | swap pre post c d independent =>
      obtain ⟨first, second⟩ := executable_append_iff.mp executable
      obtain ⟨swapped, same⟩ := swap_executable independent second
      exact ⟨executable_append_iff.mpr ⟨first, swapped⟩, by rw [fireList_append, fireList_append, same]⟩

/-- **Trace-equivalent sequences are executable together and reach one store.** -/
theorem TraceEq.executable {label : O → R} {store : Finset O} {l l' : List (Commit O R)}
    (eq : TraceEq label l l') (executable : Executable label store l) :
    Executable label store l' ∧ fireList store l' = fireList store l := by
  induction eq with
  | refl => exact ⟨executable, rfl⟩
  | tail _ step ih =>
      obtain ⟨executableMid, sameMid⟩ := ih
      obtain ⟨executableEnd, sameEnd⟩ := step.executable executableMid
      exact ⟨executableEnd, sameEnd.trans sameMid⟩

/-- **Trace-equivalent sequences give one bag of answers**, for any answers the commits emit. -/
theorem TraceEq.answers_eq {label : O → R} {Answer : Type*} (answer : Commit O R → Answer)
    {l l' : List (Commit O R)} (eq : TraceEq label l l') :
    ((l.map answer : List Answer) : Multiset Answer) = (l'.map answer : List Answer) :=
  Multiset.coe_eq_coe.mpr (eq.perm.map answer)

/-- **Bubbling a commit to the front** past commits it is trace independent of. -/
theorem bubble {label : O → R} {c : Commit O R} {q : List (Commit O R)} :
    ∀ {p : List (Commit O R)}, (∀ d ∈ p, TraceIndependent label d c) →
      TraceEq label (p ++ c :: q) (c :: (p ++ q))
  | [], _ => .refl
  | d :: p, independent => by
      have rest := bubble (q := q) (fun x member => independent x (List.mem_cons_of_mem _ member))
      have front : SwapStep label ([] ++ d :: c :: (p ++ q)) ([] ++ c :: d :: (p ++ q)) :=
        .swap [] (p ++ q) d c (independent d List.mem_cons_self)
      exact (rest.cons d).tail (by simpa using front)

/-- **Every executable order of a wave is one trace.** Any two executable orders of the commits of
one snapshot, predicate queries included, are trace equivalent. -/
theorem wave_orders_traceEq {label : O → R} {store : Finset O} :
    ∀ {l₁ l₂ : List (Commit O R)} (pre : List (Commit O R)),
      (∀ c ∈ l₁, Enabled label store c) → MatchedAt store pre → l₁.Nodup → l₁.Perm l₂ →
      Executable label (fireList store pre) l₁ → Executable label (fireList store pre) l₂ →
      TraceEq label l₁ l₂
  | [], l₂, _, _, _, _, perm, _, _ => by
      rw [List.nil_perm.mp perm]
      exact .refl
  | c :: r₁, l₂, pre, enabled, matched, nodup, perm, executable₁, executable₂ => by
      have inL₂ : c ∈ l₂ := perm.subset List.mem_cons_self
      obtain ⟨p, q, split⟩ := List.append_of_mem inL₂
      subst split
      have nodup₂ : (p ++ c :: q).Nodup := perm.nodup_iff.mp nodup
      have cNotInP : c ∉ p := fun inP => by
        have := List.nodup_append.mp nodup₂
        exact this.2.2 c inP c List.mem_cons_self rfl
      have enabled₂ : ∀ x ∈ p ++ c :: q, Enabled label store x := fun x member =>
        enabled x (perm.symm.subset member)
      have pairwise₁ := ((executable_fireList_iff enabled pre matched).mp executable₁).2
      have pairwise₂ := ((executable_fireList_iff enabled₂ pre matched).mp executable₂).2
      -- Every commit before `c` in the second order is trace independent of `c`.
      have independent : ∀ d ∈ p, TraceIndependent label d c := by
        intro d inP
        have different : d ≠ c := fun equal => cNotInP (equal ▸ inP)
        have earlier : ¬ Clash c d ∧ ¬ Spoils label d c := by
          rw [List.pairwise_append] at pairwise₂
          exact pairwise₂.2.2 d inP c List.mem_cons_self
        have inR₁ : d ∈ r₁ := by
          have := perm.symm.subset (List.mem_append_left _ inP)
          rcases List.mem_cons.mp this with equal | inR
          · exact absurd equal different
          · exact inR
        have later : ¬ Clash d c ∧ ¬ Spoils label c d :=
          (List.pairwise_cons.mp pairwise₁).1 d inR₁
        have enabledC := enabled c List.mem_cons_self
        have enabledD := enabled d (List.mem_cons_of_mem _ inR₁)
        refine ⟨⟨later.1, earlier.2, later.2⟩, ?_, ?_⟩
        · refine Finset.disjoint_left.mpr fun o made used => ?_
          rcases Finset.mem_union.mp used with taken | kept
          · exact Finset.disjoint_left.mp enabledD.fresh made (enabledC.taken_subset taken)
          · exact Finset.disjoint_left.mp enabledD.fresh made (enabledC.kept_subset kept)
        · refine Finset.disjoint_left.mpr fun o made used => ?_
          rcases Finset.mem_union.mp used with taken | kept
          · exact Finset.disjoint_left.mp enabledC.fresh made (enabledD.taken_subset taken)
          · exact Finset.disjoint_left.mp enabledC.fresh made (enabledD.kept_subset kept)
      have bubbled := bubble (q := q) independent
      obtain ⟨executableFront, _⟩ := bubbled.executable executable₂
      rw [executable_cons_iff] at executable₁ executableFront
      have matchedNext : MatchedAt store (pre ++ [c]) := by
        intro e member
        rcases List.mem_append.mp member with inPre | inC
        · exact matched e inPre
        · rw [List.mem_singleton] at inC; subst inC
          exact ⟨(enabled e List.mem_cons_self).taken_subset, (enabled e List.mem_cons_self).fresh⟩
      have shift : fire (fireList store pre) c = fireList store (pre ++ [c]) := by
        rw [fireList_append]; rfl
      rw [shift] at executable₁ executableFront
      have permRest : r₁.Perm (p ++ q) :=
        (perm.trans List.perm_middle).cons_inv
      have ih := wave_orders_traceEq (pre ++ [c])
        (fun x member => enabled x (List.mem_cons_of_mem _ member)) matchedNext
        (List.nodup_cons.mp nodup).2 permRest executable₁.2 executableFront.2
      exact (ih.cons c).trans bubbled.symm
  termination_by l₁ => l₁.length

/-! ## Runs without predicate queries -/

/-- Fresh identities across a run: nothing it makes was in the start store, and no two commits
make one identity. -/
def GloballyFresh (store : Finset O) (l : List (Commit O R)) : Prop :=
  (∀ c ∈ l, Disjoint c.made store) ∧ l.Pairwise (fun c d => Disjoint c.made d.made)

/-- What a run reaches is the start store and what the run made. -/
theorem fireList_subset_union_madeOf (store : Finset O) (l : List (Commit O R)) :
    fireList store l ⊆ store ∪ madeOf l := by
  induction l generalizing store with
  | nil => exact Finset.subset_union_left
  | cons c rest ih =>
      intro o member
      rcases Finset.mem_union.mp (ih (fire store c) member) with inFire | made
      · rcases mem_fire.mp inFire with ⟨inStore, _⟩ | madeC
        · exact Finset.mem_union_left _ inStore
        · exact Finset.mem_union_right _ (mem_madeOf.mpr ⟨c, List.mem_cons_self, madeC⟩)
      · obtain ⟨d, inRest, madeD⟩ := mem_madeOf.mp made
        exact Finset.mem_union_right _ (mem_madeOf.mpr ⟨d, List.mem_cons_of_mem _ inRest, madeD⟩)

/-- **An absent occurrence that the run never makes is never used.** -/
theorem notMem_uses_of_absent {label : O → R} {store : Finset O} {l : List (Commit O R)}
    (executable : Executable label store l) {o : O} (absent : o ∉ store)
    (neverMade : ∀ e ∈ l, o ∉ e.made) : ∀ e ∈ l, o ∉ e.uses := by
  induction executable with
  | nil => intro e member; simp at member
  | @cons store c rest enabled _ ih =>
      intro e member used
      rcases List.mem_cons.mp member with rfl | inRest
      · rcases Finset.mem_union.mp used with taken | kept
        · exact absent (enabled.taken_subset taken)
        · exact absent (enabled.kept_subset kept)
      · refine ih ?_ (fun d inD => neverMade d (List.mem_cons_of_mem _ inD)) e inRest used
        intro inFire
        rcases mem_fire.mp inFire with ⟨inStore, _⟩ | made
        · exact absent inStore
        · exact neverMade c List.mem_cons_self made

/-- **Executable permutations of a run without predicate queries are one trace.** Any two
executable orders of the same commits, with fresh identities and no predicate queries, are trace
equivalent:
commits may use what earlier ones made, and the quotient still identifies every reordering the
store cannot see. With predicate queries this fails (`Controls.restored_absence_two_traces`). -/
theorem positive_runs_traceEq {label : O → R} :
    ∀ {store : Finset O} {l₁ l₂ : List (Commit O R)},
      (∀ c ∈ l₁, c.Positive) → GloballyFresh store l₁ → l₁.Nodup → l₁.Perm l₂ →
      Executable label store l₁ → Executable label store l₂ → TraceEq label l₁ l₂
  | _, [], l₂, _, _, _, perm, _, _ => by
      rw [List.nil_perm.mp perm]
      exact .refl
  | store, c :: r₁, l₂, positive, fresh, nodup, perm, executable₁, executable₂ => by
      have inL₂ : c ∈ l₂ := perm.subset List.mem_cons_self
      obtain ⟨p, q, split⟩ := List.append_of_mem inL₂
      subst split
      have nodup₂ : (p ++ c :: q).Nodup := perm.nodup_iff.mp nodup
      have cNotInP : c ∉ p := fun inP =>
        (List.nodup_append.mp nodup₂).2.2 c inP c List.mem_cons_self rfl
      have members : ∀ x, x ∈ p ++ c :: q → x ∈ c :: r₁ := fun x member => perm.symm.subset member
      have madeApart : ∀ x ∈ c :: r₁, ∀ y ∈ c :: r₁, x ≠ y → Disjoint x.made y.made := by
        intro x inX y inY different
        exact rel_of_mem_of_pairwise (fun apart => apart.symm) fresh.2 inX inY different
      have freshStore : ∀ x ∈ c :: r₁, Disjoint x.made store := fresh.1
      obtain ⟨enabledC, executableR₁⟩ := executable_cons_iff.mp executable₁
      have independent : ∀ d ∈ p, TraceIndependent label d c := by
        intro d inP
        have different : d ≠ c := fun equal => cNotInP (equal ▸ inP)
        have inD : d ∈ c :: r₁ := members d (List.mem_append_left _ inP)
        have inR₁ : d ∈ r₁ := by
          rcases List.mem_cons.mp inD with equal | inR
          · exact absurd equal different
          · exact inR
        obtain ⟨p₁, p₂, splitP⟩ := List.append_of_mem inP
        subst splitP
        have exec₂ := executable₂
        rw [List.append_assoc, List.cons_append] at exec₂
        obtain ⟨_, exec₂'⟩ := executable_append_iff.mp exec₂
        obtain ⟨enabledD, afterD⟩ := executable_cons_iff.mp exec₂'
        -- (a) what `c` takes is never used again in the first order
        have takenCNotUsedD : Disjoint c.taken d.uses := by
          refine Finset.disjoint_left.mpr fun o taken used => ?_
          have inStore := enabledC.taken_subset taken
          exact notMem_uses_of_absent executableR₁
            (fun inFire => Finset.disjoint_left.mp (disjoint_taken_fire enabledC) taken inFire)
            (fun e inE made => Finset.disjoint_left.mp
              (freshStore e (List.mem_cons_of_mem _ inE)) made inStore) d inR₁ used
        -- (b) what `d` takes is never used again in the second order
        have takenDNotUsedC : Disjoint d.taken c.uses := by
          refine Finset.disjoint_left.mpr fun o taken used => ?_
          have inStore : o ∈ store := by
            rcases Finset.mem_union.mp used with t | k
            · exact enabledC.taken_subset t
            · exact enabledC.kept_subset k
          exact notMem_uses_of_absent afterD
            (fun inFire => Finset.disjoint_left.mp (disjoint_taken_fire enabledD) taken inFire)
            (fun e inE made => Finset.disjoint_left.mp
              (freshStore e (members e (by simp at inE ⊢; tauto))) made inStore) c
            (by simp) used
        -- (c) what `c` makes is not there when `d` runs in the second order
        have madeCNotUsedD : Disjoint c.made d.uses := by
          refine Finset.disjoint_left.mpr fun o made used => ?_
          have present : o ∈ fireList store p₁ := by
            rcases Finset.mem_union.mp used with t | k
            · exact enabledD.taken_subset t
            · exact enabledD.kept_subset k
          rcases Finset.mem_union.mp (fireList_subset_union_madeOf store p₁ present) with
            inStore | madeEarlier
          · exact Finset.disjoint_left.mp (freshStore c List.mem_cons_self) made inStore
          · obtain ⟨e, inE, madeE⟩ := mem_madeOf.mp madeEarlier
            have eNotC : e ≠ c := fun equal => cNotInP (by rw [← equal]; simp [inE])
            exact Finset.disjoint_left.mp
              (madeApart e (members e (by simp [inE])) c List.mem_cons_self eNotC) madeE made
        -- (d) what `d` makes is not in the start store, where `c` reads
        have madeDNotUsedC : Disjoint d.made c.uses := by
          refine Finset.disjoint_left.mpr fun o made used => ?_
          rcases Finset.mem_union.mp used with t | k
          · exact Finset.disjoint_left.mp (freshStore d inD) made (enabledC.taken_subset t)
          · exact Finset.disjoint_left.mp (freshStore d inD) made (enabledC.kept_subset k)
        have noWrite : ∀ x : Commit O R, ∀ y : Commit O R, y.Positive → ¬ WritesInto label x y := by
          rintro x y positiveY ⟨read, member, -⟩
          simp [show y.queries = [] from positiveY] at member
        refine ⟨⟨?_, ?_, ?_⟩, madeDNotUsedC, madeCNotUsedD⟩
        · rintro (taken | made)
          · exact taken (Finset.disjoint_of_subset_right Finset.subset_union_left takenDNotUsedC)
          · exact made (madeApart d inD c List.mem_cons_self different)
        · rintro (kept | writes)
          · exact kept (Finset.disjoint_of_subset_right Finset.subset_union_right takenDNotUsedC)
          · exact noWrite d c (positive c List.mem_cons_self) writes
        · rintro (kept | writes)
          · exact kept (Finset.disjoint_of_subset_right Finset.subset_union_right takenCNotUsedD)
          · exact noWrite c d (positive d inD) writes
      have bubbled := bubble (q := q) independent
      obtain ⟨executableFront, _⟩ := bubbled.executable executable₂
      obtain ⟨_, executableRest⟩ := executable_cons_iff.mp executableFront
      have permRest : r₁.Perm (p ++ q) := (perm.trans List.perm_middle).cons_inv
      have freshNext : GloballyFresh (fire store c) r₁ := by
        refine ⟨fun x inX => ?_, (List.pairwise_cons.mp fresh.2).2⟩
        refine Finset.disjoint_left.mpr fun o made inFire => ?_
        rcases mem_fire.mp inFire with ⟨inStore, _⟩ | madeC
        · exact Finset.disjoint_left.mp (freshStore x (List.mem_cons_of_mem _ inX)) made inStore
        · exact Finset.disjoint_left.mp ((List.pairwise_cons.mp fresh.2).1 x inX) madeC made
      have ih := positive_runs_traceEq (fun x member => positive x (List.mem_cons_of_mem _ member))
        freshNext (List.nodup_cons.mp nodup).2 permRest executableR₁ executableRest
      exact (ih.cons c).trans bubbled.symm
  termination_by _ l₁ => l₁.length

/-- **Trace equivalence keeps the order of dependent commits.** Select commits by a decidable
key; if no two distinct selected members are trace independent, every trace-equivalent sequence
lists the selected commits in the same order. -/
theorem TraceEq.filter_eq {label : O → R} {l l' : List (Commit O R)} (eq : TraceEq label l l')
    (selected : Commit O R → Bool)
    (dependent : ∀ c ∈ l, ∀ d ∈ l, selected c = true → selected d = true → c ≠ d →
      ¬ TraceIndependent label c d) :
    l.filter selected = l'.filter selected := by
  induction eq with
  | refl => rfl
  | @tail mid next prefixEq step ih =>
      rw [ih]
      have members : ∀ x ∈ mid, x ∈ l := fun x member => (TraceEq.perm prefixEq).symm.subset member
      cases step with
      | swap pre post c d independent =>
          simp only [List.filter_append, List.filter_cons]
          congr 1
          have inC : c ∈ l := members c (by simp)
          have inD : d ∈ l := members d (by simp)
          by_cases hc : selected c = true <;> by_cases hd : selected d = true <;> simp only [hc, hd,
            if_true, if_false, Bool.false_eq_true]
          by_cases same : c = d
          · subst same; rfl
          · exact absurd independent (dependent c inC d inD hc hd same)

/-! ## Controls -/

namespace Controls

open Atom

/-- Answers of the two token readers. -/
def readerAnswer (c : Commit ℕ Atom) : ℕ := if c.made = {5} then 1 else 2

/-- **Order of answers is not kept; their bag is.** The two independent readers are trace
equivalent in either order; their answer lists differ, their answer bags agree. -/
theorem answer_order_not_kept :
    TraceEq label [reader, reader₂] [reader₂, reader] ∧
      [reader, reader₂].map readerAnswer ≠ [reader₂, reader].map readerAnswer ∧
      (([reader, reader₂].map readerAnswer : List ℕ) : Multiset ℕ) =
        ([reader₂, reader].map readerAnswer : List ℕ) := by
  have independent : TraceIndependent label reader reader₂ :=
    ⟨readers_independent, by decide, by decide⟩
  have eq : TraceEq label [reader, reader₂] [reader₂, reader] :=
    Relation.ReflTransGen.single (by simpa using SwapStep.swap [] [] reader reader₂ independent)
  exact ⟨eq, by decide, eq.answers_eq readerAnswer⟩

/-- Labels for the restored-absence control: `61` is a lock, `60` and `62` outputs. -/
def raceLabel : ℕ → Atom
  | 61 => lock
  | _ => out

/-- Read the absence of a lock, make output `60`. -/
def absenceReader : Commit ℕ Atom := ⟨∅, ∅, {60}, [⟨isLock, ∅⟩]⟩

/-- Make lock `61`. -/
def lockMaker₂ : Commit ℕ Atom := ⟨∅, ∅, {61}, []⟩

/-- Take lock `61`, make output `62`. -/
def lockTaker₂ : Commit ℕ Atom := ⟨{61}, ∅, {62}, []⟩

/-- **Absence restored: two executable permutations, one store, two traces.** From the empty
store, reading the absence of a lock first, or making a lock and taking it first, both execute and
reach `{60, 62}`; the two orders are not trace equivalent. -/
theorem restored_absence_two_traces :
    Executable raceLabel ∅ [absenceReader, lockMaker₂, lockTaker₂] ∧
      Executable raceLabel ∅ [lockMaker₂, lockTaker₂, absenceReader] ∧
      fireList ∅ [absenceReader, lockMaker₂, lockTaker₂] = {60, 62} ∧
      fireList ∅ [lockMaker₂, lockTaker₂, absenceReader] = {60, 62} ∧
      ¬ TraceEq raceLabel [absenceReader, lockMaker₂, lockTaker₂]
        [lockMaker₂, lockTaker₂, absenceReader] := by
  have absenceAt : ∀ store : Finset ℕ, (∀ o ∈ store, o ≠ 61) →
      ∀ read ∈ absenceReader.queries, read.Holds raceLabel store := by
    intro store noLock read member
    simp only [absenceReader, List.mem_singleton] at member
    subst member
    unfold PredicateQuery.Holds
    ext o
    simp only [mem_regionOf, Finset.notMem_empty, iff_false, not_and]
    intro inStore
    have := noLock o inStore
    unfold raceLabel isLock
    split <;> simp_all
  refine ⟨?_, ?_, by decide, by decide, ?_⟩
  · refine .cons ⟨by decide, by decide, by decide, by decide, absenceAt ∅ (by simp)⟩ ?_
    refine .cons ⟨by decide, by decide, by decide, by decide, by simp [lockMaker₂]⟩ ?_
    refine .cons ⟨by decide, by decide, by decide, by decide, by simp [lockTaker₂]⟩ (.nil _)
  · refine .cons ⟨by decide, by decide, by decide, by decide, by simp [lockMaker₂]⟩ ?_
    refine .cons ⟨by decide, by decide, by decide, by decide, by simp [lockTaker₂]⟩ ?_
    refine .cons ⟨by decide, by decide, by decide, by decide, absenceAt _ (by decide)⟩ (.nil _)
  · intro eq
    have notIndependent : ¬ TraceIndependent raceLabel absenceReader lockMaker₂ := by
      rintro ⟨⟨_, _, spoils⟩, _⟩
      exact spoils (Or.inr ⟨⟨isLock, ∅⟩, by simp [absenceReader], 61, by simp [lockMaker₂], rfl⟩)
    let selected : Commit ℕ Atom → Bool := fun x => decide (x.made = {60} ∨ x.made = {61})
    have same := eq.filter_eq selected (by
      intro c inC d inD selC selD different
      simp only [List.mem_cons, List.not_mem_nil, or_false] at inC inD
      rcases inC with rfl | rfl | rfl <;> rcases inD with rfl | rfl | rfl <;>
        first
        | exact absurd rfl different
        | exact notIndependent
        | exact fun independent => notIndependent independent.symm
        | (simp [selected, lockTaker₂] at selC selD))
    have := congrArg (List.map Commit.made) same
    revert this
    decide

/-! ### Trace independence, global freshness -/

/-- **Positive control**: two readers of one token are trace independent: independent, and
neither makes what the other uses. -/
theorem readers_traceIndependent : TraceIndependent label reader reader₂ := by
  unfold TraceIndependent Independent Clash Spoils WritesInto Commit.uses
  decide

/-- **Negative control**: a maker of occurrence `0` and a reader of `0` are independent (neither
takes, neither has a predicate query), but the maker makes what the reader uses, so the reader
cannot move before it: not trace independent. -/
theorem maker_reader_not_traceIndependent :
    Independent label (Commit.makeOne 0) reader ∧
      ¬ TraceIndependent label (Commit.makeOne 0) reader := by
  unfold TraceIndependent Independent Clash Spoils WritesInto Commit.uses
  decide

/-- **Positive control**: the two readers make `5` and `10`, fresh for `{0}` and apart. -/
theorem readers_globallyFresh : GloballyFresh {0} [reader, reader₂] := by
  unfold GloballyFresh; decide

/-- **Negative control**: running the reader twice claims the fresh identity `5` twice. -/
theorem reader_twice_not_globallyFresh : ¬ GloballyFresh {0} [reader, reader] := by
  unfold GloballyFresh; decide

end Controls

