import Mettapedia.GSLT.LanguageDef.ModuleSource.Commands
import Mettapedia.OSLF.MeTTaIL.CoreLanguageDef
import Mettapedia.OSLF.MeTTaIL.OrientationSettle
import Mettapedia.OSLF.MeTTaIL.DistributiveRecognition
import Mathlib.Data.ZMod.Basic

/-!
# Oriented processes, from their module

`metta/gslt/module/OrientedRho.module` writes Meredith's oriented processes as a member of the rho
family: rho as a type constructor whose data parameter is a group. Read here unchanged and elaborated,
it gives a language with processes, data and names; parallel composition from the commutative
monoid, chaos, idempotent summation over a set, names `@<P, d>` pairing a code with a datum, the
canonical receive binding a code and a datum, and the oriented communication rule gated on equal
codes. Its data are the group generated by one turn of order 3.

The orientation of the language names its data sort, the group's constructors and the action
constructor. With the reading of data in the cyclic group of order 3, the action multiplies every
datum on the left, inside quotations and messages; a variable bound inside the acted term keeps its
frame, and a free variable carries the action as a decoration until it is substituted.

Controls:
- the elaborated language has its three sorts, its constructors and rules, and is core;
- parallel composition declares the fold algebra of the commutative monoid it replaces;
  its wrapper-unit equations and summation's fixed-arity equations remain explicit;
- its core reading puts the summands of COMM's reduct in a set, the collection the summation
  constructor declares;
- automatic distributive normalization is not authorized: the fixed-arity summation equation
  does not establish unrestricted variadic flattening;
- the module prints as text that reads back to the same data;
- positive: a turn moves a fork's channel and message one step round the ring, also at depth two
  of quotation; three turns are no turn;
- positive: a free process variable is deferred, `X ↦ ^r X`, and decorations compose, `^r X ↦ ^(r r) X`;
  settling evaluates an action node on a process and keeps the one on a variable;
- negative: a turn leaves a bound datum variable in place, and a bound word `r · δ` in its frame,
  where left multiplication alone would give `r · r · δ`;
- positive: the action commutes with communication (`comm_equivariant`): acting by a turn on a receive
  and a message and then communicating is communicating and then acting; negative: acting on the
  receive's body without its frame does not commute;
- the authored reduct, its explicit substitutions executed and settled, is the reduct of communication
  (`settle_plainReduct`), on a settled body and payload; and acting on the pair before the authored
  communication is acting after it (`plainReduct_equivariant`);
- settling is idempotent (`settle_settle`): the action's parameters are a datum and a process, and an
  action node over a message settles to a term that settling fixes.
-/

open Mettapedia.GSLT.LanguageDef.ModuleSource.Commands
open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.GSLT.LanguageDef.ModuleSource (Error)

#module_file "../../../../artifacts/upstream-authoring-20261008/UnivAlg.module"
#module_file "../../../../../../metta/gslt/module/OrientedRho.module"

#module_roundtrip OrientedRho

namespace Mettapedia.Languages.ProcessCalculi.OrientedRho

open Mettapedia.OSLF.MeTTaIL Orientation

/-- The elaborated language. -/
def language : LanguageDef :=
  match _root_.OrientedRho.language with
  | .ok language => language
  | .error _ => LanguageDef.empty "unelaborated"

#guard (match _root_.OrientedRho.language with | .ok _ => true | .error _ => false)
#guard language.types.map (·.name) == ["Proc", "Data", "Name"]
#guard language.terms.map (·.label) ==
  ["PZero", "PPar", "PChaos", "PSum", "One", "Mult", "Inv", "Turn", "NQuote", "POutput", "PInput", "PAct"]
#guard (language.equations.length, language.rewrites.map (·.name)) == (14, ["RPar", "RSum", "RDiv", "RComm"])
#guard language.equations.map (·.name) ==
  ["Monoid:equation:1@2", "Monoid:equation:2@2", "ChaosSum:equation:0@5", "ChaosSum:equation:1@5",
    "ChaosSum:equation:2@5", "ChaosSum:equation:3@5", "ChaosSum:equation:4@5", "Monoid:equation:0@7",
    "Monoid:equation:1@7", "Monoid:equation:2@7", "Group:equation:0@8", "Group:equation:1@8",
    "Group:equation:2@8", "Cyclic3:equation:0@9"]
#guard (language.terms.find? (·.label == "PPar")).bind (·.algebra?) == some { flatten := true, unit := some "PZero" }
#guard (language.terms.find? (·.label == "PSum")).bind (·.algebra?) == none
#guard language.validate.isEmpty

/-- The core reading of the language. -/
def core : Option LanguageDef :=
  match language.toCore with
  | .ok core => some core.language
  | .error _ => none

#guard core.isSome

/-- Every collection kind occurring in a pattern. -/
partial def kinds : Pattern → List CollType
  | .apply _ arguments => arguments.flatMap kinds
  | .lambda _ body => kinds body
  | .multiLambda _ _ body => kinds body
  | .subst body replacement => kinds body ++ kinds replacement
  | .collection kind elements _ => kind :: elements.flatMap kinds
  | _ => []

/-! COMM's reduct in the core: the parallel bag holds the summation's set. -/
#guard (core.bind fun core => (core.rewrites.find? fun rule => rule.name == "RComm").map fun rule => kinds rule.right) ==
  some [.hashBag, .hashSet]

/-! Fixed-arity equations remain executable equations, but do not authorize
the stronger variadic distributive normalizer. -/
#guard (core.bind fun coreLanguage => Distributive.recognize coreLanguage "Proc") ==
  none

/-- The core language without its distributivity equation. -/
def withoutDistributivity (coreLanguage : LanguageDef) : LanguageDef :=
  { coreLanguage with «equations» := coreLanguage.equations.filter (·.name != "ChaosSum:equation:4@5") }

/-! **Negative**: without the distributivity equation the language declares no distributive structure. -/
#guard (core.bind fun coreLanguage => Distributive.recognize (withoutDistributivity coreLanguage) "Proc") == none

/-! ## The orientation by the cyclic group of order 3 -/

/-- The orientation of the language. -/
def orientation : OrientationDecl :=
  { dataSort := "Data", multiply := "Mult", inverse := "Inv", unit := "One", action := "PAct" }

/-- The data group: one turn of order 3. -/
abbrev Turns := Multiplicative (ZMod 3)

/-- The turn. -/
def turn : Turns := Multiplicative.ofAdd 1

/-- The canonical word of a number of turns. -/
def turnWord (x : Turns) : Pattern :=
  match (Multiplicative.toAdd x).val with
  | 0 => .apply "One" []
  | 1 => .apply "Turn" []
  | _ => .apply "Mult" [.apply "Turn" [], .apply "Turn" []]

/-- The reading of the data: `Turn` is the turn. -/
def reading : DataReading orientation Turns where
  constant := fun label => if label = "Turn" then some turn else none
  write := turnWord
  read_write := by
    intro x
    obtain ⟨k, rfl⟩ : ∃ k : ZMod 3, Multiplicative.ofAdd k = x := ⟨Multiplicative.toAdd x, rfl⟩
    fin_cases k <;> decide +kernel

/-- A datum's frame-normal action, then data and decorations in normal form. -/
def rotate (g : Pattern) (type : TypeExpr) (pattern : Pattern) : Pattern :=
  frameNormal language orientation reading type (frameAct language orientation g type pattern)

def zero : Pattern := .apply "PZero" []
def one : Pattern := .apply "One" []
def turnData : Pattern := .apply "Turn" []
def twoTurns : Pattern := .apply "Mult" [turnData, turnData]
def channel (code datum : Pattern) : Pattern := .apply "NQuote" [code, datum]
def send (channel payload datum : Pattern) : Pattern := .apply "POutput" [channel, payload, datum]
def receive (channel body : Pattern) : Pattern := .apply "PInput" [channel, .lambda none (.lambda none body)]

/-- A fork: a message on the channel `@<0, 1>`. -/
def fork : Pattern := send (channel zero one) zero one

/-! **Positive**: a turn moves the fork one step round the ring. -/
#guard rotate turnData (.base "Proc") fork == send (channel zero turnData) zero turnData

/-! **Positive**: the action reaches data at depth two of quotation. -/
#guard rotate turnData (.base "Proc") (send (channel fork one) zero one) ==
  send (channel (send (channel zero turnData) zero turnData) turnData) zero turnData

/-! **Positive**: three turns are no turn. -/
#guard rotate turnData (.base "Proc") (rotate turnData (.base "Proc") (rotate turnData (.base "Proc") fork)) == fork

/-! **Negative**: a turn leaves a bound datum variable in place. The receive binds a code (index 1)
and a datum (index 0); its message's datum is the bound datum, and stays the bound datum. In normal
form the bound code occurs decorated by the unit. -/
#guard rotate turnData (.base "Proc") (receive (channel zero one) (send (channel zero one) (.bvar 1) (.bvar 0))) ==
  receive (channel zero turnData) (send (channel zero turnData) (.apply "PAct" [one, .bvar 1]) (.bvar 0))

/-! The action acts on processes, not on data, so the group-action laws `frameAct_mul` and
`frameAct_one` apply. -/
#guard actionType language orientation == some (.base "Proc")

/-! **Positive**: a free process variable carries the action as a decoration. -/
#guard rotate turnData (.base "Proc") (send (channel zero one) (.fvar "X") one) ==
  send (channel zero turnData) (.apply "PAct" [turnData, .fvar "X"]) turnData

/-! **Positive**: decorations compose. -/
#guard rotate turnData (.base "Proc") (.apply "PAct" [turnData, .fvar "X"]) == .apply "PAct" [twoTurns, .fvar "X"]

/-! **Positive**: a decorated bound process variable is conjugated, which in this abelian group leaves it. -/
#guard rotate turnData (.base "Proc") (receive (channel zero one) (.apply "PAct" [turnData, .bvar 1])) ==
  receive (channel zero turnData) (.apply "PAct" [turnData, .bvar 1])

/-! **Negative**: the bound word `r · δ` keeps its frame; left multiplication alone, the earlier
action, gives `r · r · δ`. -/
#guard rotate turnData (.base "Proc")
    (receive (channel zero one) (send (channel zero one) (.bvar 1) (.apply "Mult" [turnData, .bvar 0]))) ==
  receive (channel zero turnData)
    (send (channel zero turnData) (.apply "PAct" [one, .bvar 1]) (.apply "Mult" [turnData, .bvar 0]))

/-! **Positive**: settling evaluates an action node on a process, and keeps one on a variable as a
decoration, composing two. -/
#guard orientNormal language orientation reading (.base "Proc") (.apply "PAct" [turnData, fork]) ==
  send (channel zero turnData) zero turnData
#guard orientNormal language orientation reading (.base "Proc") (.apply "PAct" [turnData, .apply "PAct" [turnData, .fvar "X"]]) ==
  .apply "PAct" [twoTurns, .fvar "X"]

/-! **Positive**: `X` and `^e X` have one normal form, every occurrence decorated. -/
#guard orientNormal language orientation reading (.base "Proc") (.fvar "X") == .apply "PAct" [one, .fvar "X"]
#guard orientNormal language orientation reading (.base "Proc") (.apply "PAct" [one, .fvar "X"]) ==
  .apply "PAct" [one, .fvar "X"]
#guard orientNormal language orientation reading (.base "Proc")
    (.apply "PAct" [turnData, .apply "PAct" [twoTurns, .fvar "X"]]) == .apply "PAct" [one, .fvar "X"]

/-! **Negative**: a non-trivial decoration is not dropped. -/
#guard orientNormal language orientation reading (.base "Proc") (.apply "PAct" [turnData, .fvar "X"]) !=
  orientNormal language orientation reading (.base "Proc") (.fvar "X")

/-- A receive's body under its binders `λX.λδ`: it resends what it receives, turned, on `@<0, r>`, with
the received datum turned. -/
def resendBody : Pattern :=
  send (channel zero turnData) (.apply "PAct" [turnData, .bvar 1]) (.apply "Mult" [turnData, .bvar 0])

/-- A payload: a message carrying a free process. -/
def payload : Pattern := send (channel zero one) (.fvar "X") one

/-- The summand `(a b⁻¹) · K` of communicating a receive on orientation `a` with a message on `b`, for
the body acted on from `depth` binders, the payload and the datum. -/
def summand (a b : Pattern) (depth : Nat) (body payload datum : Pattern) : Pattern :=
  frameAct language orientation (.apply "Mult" [a, .apply "Inv" [b]]) (.base "Proc")
    (commContinuation (language := language) (decl := orientation) (.base "Proc") (.base "Proc")
      (actWalkAt (language := language) (decl := orientation) turnData depth (.base "Proc") body) payload datum)

/-- The action of a turn on the summand of the unacted pair. -/
def actedSummand : Pattern :=
  frameNormal language orientation reading (.base "Proc")
    (frameAct language orientation turnData (.base "Proc")
      (frameAct language orientation (.apply "Mult" [one, .apply "Inv" [turnData]]) (.base "Proc")
        (commContinuation (language := language) (decl := orientation) (.base "Proc") (.base "Proc") resendBody
          payload turnData)))

/-! **Positive**: communicating the turned pair is turning the communication. -/
#guard frameNormal language orientation reading (.base "Proc")
    (summand (.apply "Mult" [turnData, one]) (.apply "Mult" [turnData, turnData]) 2 resendBody
      (frameAct language orientation turnData (.base "Proc") payload) (.apply "Mult" [turnData, turnData])) ==
  actedSummand

/-! The hypotheses of the authored theorems hold here: multiplication is not the action, and the body
and the payload are settled. -/
#guard orientation.multiply != orientation.action
#guard settledAt language orientation 0 (.base "Proc") resendBody
#guard settledAt language orientation 0 (.base "Proc") payload

/-! **Positive**: the authored reduct, settled, is the reduct of communication. -/
#guard settle language orientation (.base "Proc")
    (plainReduct (decl := orientation) .hashSet one turnData resendBody payload turnData) ==
  commReduct (language := language) (decl := orientation) .hashSet (.base "Proc") (.base "Proc") one turnData
    resendBody payload turnData

/-! **Positive**: the authored communication of the turned pair is the turned authored communication. -/
#guard frameNormal language orientation reading (.base "Proc")
    (settle language orientation (.base "Proc")
      (plainReduct (decl := orientation) .hashSet (.apply "Mult" [turnData, one])
        (.apply "Mult" [turnData, turnData])
        (actWalkAt (language := language) (decl := orientation) turnData 2 (.base "Proc") resendBody)
        (frameAct language orientation turnData (.base "Proc") payload) (.apply "Mult" [turnData, turnData]))) ==
  frameNormal language orientation reading (.base "Proc")
    (frameAct language orientation turnData (.base "Proc")
      (settle language orientation (.base "Proc")
        (plainReduct (decl := orientation) .hashSet one turnData resendBody payload turnData)))

/-- A body that is not settled: an action node on a message. -/
def unsettledBody : Pattern := .apply "PAct" [turnData, send (channel zero one) (.bvar 1) (.bvar 0)]

/-! The action's parameters are a datum and a process, and settling an action node over a message is
idempotent. -/
#guard paramTypes language orientation.action == some [.base "Data", .base "Proc"]
#guard actionsAtBody language orientation (.base "Proc") unsettledBody
#guard settle language orientation (.base "Proc") (settle language orientation (.base "Proc") unsettledBody) ==
  settle language orientation (.base "Proc") unsettledBody
#guard settle language orientation (.base "Proc") unsettledBody != unsettledBody

/-! **Negative**: on a body that is not settled, settling the authored reduct evaluates the action the
discharging continuation leaves in place, so the two differ. -/
#guard !settledAt language orientation 0 (.base "Proc") unsettledBody
#guard settle language orientation (.base "Proc")
    (plainReduct (decl := orientation) .hashSet one turnData unsettledBody payload turnData) !=
  commReduct (language := language) (decl := orientation) .hashSet (.base "Proc") (.base "Proc") one turnData
    unsettledBody payload turnData

/-! **Negative**: acting on the receive's body without its frame, from no binder, does not commute. -/
#guard frameNormal language orientation reading (.base "Proc")
    (summand (.apply "Mult" [turnData, one]) (.apply "Mult" [turnData, turnData]) 0 resendBody
      (frameAct language orientation turnData (.base "Proc") payload) (.apply "Mult" [turnData, turnData])) !=
  actedSummand

end Mettapedia.Languages.ProcessCalculi.OrientedRho
