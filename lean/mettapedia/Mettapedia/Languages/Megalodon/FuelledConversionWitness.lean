import Mettapedia.Languages.Megalodon.FuelledConversionProfile

/-!
# Independently checked conversion paths and additive edge budgets

Every path edge carries an actual reduction article of the existing definition
conversion kernel. Reversal changes the direction of conversion, not the
reduction article. Composition appends independently checked edges. Its bound
counts edges; it does not bound the work of checking the articles themselves.

The selected bounded recognizer follows named-definition unfoldings in either
direction. It is a concrete fragment, not the complete Megalodon converter.
-/

set_option autoImplicit false

namespace Mettapedia.Languages.Megalodon.FuelledConversionWitness
open MathdataKernel ConversionElaboration
open Mettapedia.GSLT.LanguageDef.InferenceChecker

structure Edge where
  reduction : Step
  reversed : Bool := false

def Edge.source (edge : Edge) : Tm := if edge.reversed then edge.reduction.target else edge.reduction.source
def Edge.target (edge : Edge) : Tm := if edge.reversed then edge.reduction.source else edge.reduction.target
def Edge.flip (edge : Edge) : Edge := { edge with reversed := !edge.reversed }

def checkEdge (declarations : List TermDecl) (edge : Edge) : Bool :=
  checkRaw DefinitionConversionKernel.validated
    (DefinitionConversionKernel.reduces (encoded declarations)
      (ETm edge.reduction.source) (ETm edge.reduction.target)) edge.reduction.article

def checkPath (declarations : List TermDecl) : Tm → Tm → List Edge → Bool
  | source, target, [] => decide (source = target)
  | source, target, edge :: rest =>
      decide (edge.source = source) && checkEdge declarations edge && checkPath declarations edge.target target rest

def CheckedReduction (declarations : List TermDecl) (source target : Tm) : Prop :=
  ∃ article, checkRaw DefinitionConversionKernel.validated
    (DefinitionConversionKernel.reduces (encoded declarations) (ETm source) (ETm target)) article = true

/-- Conversion generated by actual checked kernel reduction articles. -/
abbrev Conversion (declarations : List TermDecl) := Relation.EqvGen (CheckedReduction declarations)

theorem edge_sound (declarations : List TermDecl) (edge : Edge)
    (checked : checkEdge declarations edge = true) : Conversion declarations edge.source edge.target := by
  have forward : Conversion declarations edge.reduction.source edge.reduction.target :=
    Relation.EqvGen.rel _ _ ⟨edge.reduction.article, checked⟩
  cases direction : edge.reversed
  · simpa only [Edge.source, Edge.target, direction, Bool.false_eq_true, if_false] using forward
  · simpa only [Edge.source, Edge.target, direction, if_true] using Relation.EqvGen.symm _ _ forward

theorem checkPath_sound (declarations : List TermDecl) (source target : Tm) (edges : List Edge)
    (checked : checkPath declarations source target edges = true) : Conversion declarations source target := by
  induction edges generalizing source with
  | nil =>
      have same : source = target := of_decide_eq_true checked
      subst same
      exact Relation.EqvGen.refl _
  | cons edge rest ih =>
      simp only [checkPath, Bool.and_eq_true, decide_eq_true_eq] at checked
      rcases checked with ⟨⟨same, valid⟩, following⟩
      have first := edge_sound declarations edge valid
      rw [same] at first
      exact Relation.EqvGen.trans _ _ _ first (ih edge.target following)

theorem checkPath_append (declarations : List TermDecl) (source middle target : Tm)
    (first second : List Edge)
    (left : checkPath declarations source middle first = true)
    (right : checkPath declarations middle target second = true) :
    checkPath declarations source target (first ++ second) = true := by
  induction first generalizing source with
  | nil =>
      have same : source = middle := of_decide_eq_true left
      subst same
      exact right
  | cons edge rest ih =>
      simp only [checkPath, Bool.and_eq_true, decide_eq_true_eq] at left
      rcases left with ⟨⟨same, valid⟩, following⟩
      simp only [List.cons_append, checkPath, Bool.and_eq_true, decide_eq_true_eq]
      exact ⟨⟨same, valid⟩, ih edge.target following⟩

theorem flip_source (edge : Edge) : edge.flip.source = edge.target := by
  cases direction : edge.reversed <;> simp only [Edge.flip, Edge.source, Edge.target, direction] <;> rfl

theorem flip_target (edge : Edge) : edge.flip.target = edge.source := by
  cases direction : edge.reversed <;> simp only [Edge.flip, Edge.source, Edge.target, direction] <;> rfl

theorem checkEdge_flip (declarations : List TermDecl) (edge : Edge) :
    checkEdge declarations edge.flip = checkEdge declarations edge := rfl

/-- Symmetry preserves every independently checked reduction article. -/
theorem checkPath_reverse (declarations : List TermDecl) (source target : Tm) (edges : List Edge)
    (checked : checkPath declarations source target edges = true) :
    checkPath declarations target source (edges.reverse.map Edge.flip) = true := by
  induction edges generalizing source with
  | nil =>
      have same : source = target := of_decide_eq_true checked
      subst same
      exact decide_eq_true rfl
  | cons edge rest ih =>
      simp only [checkPath, Bool.and_eq_true, decide_eq_true_eq] at checked
      rcases checked with ⟨⟨aligned, valid⟩, following⟩
      simp only [List.reverse_cons, List.map_append, List.map_cons, List.map_nil]
      apply checkPath_append declarations target edge.target source _ _ (ih edge.target following)
      simp only [checkPath, flip_source, flip_target, checkEdge_flip, Bool.and_eq_true, decide_eq_true_eq]
      exact ⟨⟨True.intro, valid⟩, aligned⟩

def checkBounded (declarations : List TermDecl) (budget : Nat) (source target : Tm) (edges : List Edge) :
    Option Bool := if edges.length ≤ budget then some (checkPath declarations source target edges) else none

theorem bounded_accepted_iff (declarations : List TermDecl) (budget : Nat) (source target : Tm) (edges : List Edge) :
    checkBounded declarations budget source target edges = some true ↔
      edges.length ≤ budget ∧ checkPath declarations source target edges = true := by
  simp [checkBounded]

theorem bounded_reverse (declarations : List TermDecl) (budget : Nat) (source target : Tm) (edges : List Edge)
    (accepted : checkBounded declarations budget source target edges = some true) :
    checkBounded declarations budget target source (edges.reverse.map Edge.flip) = some true := by
  obtain ⟨fits, valid⟩ := (bounded_accepted_iff declarations _ _ _ _).mp accepted
  exact (bounded_accepted_iff declarations _ _ _ _).mpr
    ⟨by simpa only [List.length_map, List.length_reverse] using fits,
      checkPath_reverse declarations source target edges valid⟩

theorem bounded_mono (declarations : List TermDecl) (source target : Tm) (edges : List Edge)
    {first second : Nat} (increased : first ≤ second)
    (accepted : checkBounded declarations first source target edges = some true) :
    checkBounded declarations second source target edges = some true := by
  obtain ⟨fits, valid⟩ := (bounded_accepted_iff declarations _ _ _ _).mp accepted
  exact (bounded_accepted_iff declarations _ _ _ _).mpr ⟨fits.trans increased, valid⟩

/-- Explicit witnesses compose with the sum of their bounds. No reuse of the
same smaller bound is promised. -/
theorem bounded_compose (declarations : List TermDecl) (source middle target : Tm)
    (first second : List Edge) (firstBudget secondBudget : Nat)
    (left : checkBounded declarations firstBudget source middle first = some true)
    (right : checkBounded declarations secondBudget middle target second = some true) :
    checkBounded declarations (firstBudget + secondBudget) source target (first ++ second) = some true := by
  obtain ⟨firstFits, firstValid⟩ := (bounded_accepted_iff declarations _ _ _ _).mp left
  obtain ⟨secondFits, secondValid⟩ := (bounded_accepted_iff declarations _ _ _ _).mp right
  exact (bounded_accepted_iff declarations _ _ _ _).mpr
    ⟨by simpa only [List.length_append] using Nat.add_le_add firstFits secondFits,
      checkPath_append declarations source middle target first second firstValid secondValid⟩

def nextDelta (environment : Environment) : Tm → Option Step
  | .named name => do
      let declaration ← environment.lookupTerm? name
      let body ← declaration.definition
      some (deltaStep environment.terms name declaration.type body)
  | _ => none

theorem nextDelta_valid (environment : Environment) (term : Tm) (step : Step)
    (next : nextDelta environment term = some step) : step.source = term ∧ step.Valid environment.terms := by
  cases term <;> simp only [nextDelta] at next <;> try { cases next }
  rename_i name
  cases lookup : environment.lookupTerm? name with
  | none =>
      rw [lookup] at next
      cases next
  | some declaration =>
      rcases declaration with ⟨found, type, definition⟩
      cases definition with
      | none =>
          rw [lookup] at next
          cases next
      | some body =>
          rw [lookup] at next
          change some (deltaStep environment.terms name type body) = some step at next
          cases next
          exact ⟨rfl, deltaStep_valid environment.terms lookup⟩

inductive SearchResult where
  | exhausted
  | refused
  | found (edges : List Edge)

def seek (environment : Environment) : Nat → Tm → Tm → SearchResult
  | 0, source, target =>
      if source = target then .found [] else
      match nextDelta environment source with
      | none => .refused
      | some _ => .exhausted
  | remaining + 1, source, target =>
      if source = target then .found [] else
      match nextDelta environment source with
      | none => .refused
      | some step => match seek environment remaining step.target target with
        | .found rest => .found (⟨step, false⟩ :: rest)
        | .exhausted => .exhausted
        | .refused => .refused

theorem seek_sound (environment : Environment) (budget : Nat) (source target : Tm) (edges : List Edge)
    (found : seek environment budget source target = .found edges) :
    edges.length ≤ budget ∧ checkPath environment.terms source target edges = true := by
  induction budget generalizing source edges with
  | zero =>
      simp only [seek] at found
      split at found
      · cases found
        exact ⟨Nat.zero_le _, decide_eq_true ‹source = target›⟩
      · cases next : nextDelta environment source <;> simp only [next] at found <;> cases found
  | succ budget ih =>
      simp only [seek] at found
      split at found
      · cases found
        exact ⟨Nat.zero_le _, decide_eq_true ‹source = target›⟩
      · cases next : nextDelta environment source with
        | none =>
            rw [next] at found
            cases found
        | some step =>
            cases rest : seek environment budget step.target target with
            | exhausted =>
                simp only [next, rest] at found
                cases found
            | refused =>
                simp only [next, rest] at found
                cases found
            | found following =>
                simp only [next, rest] at found
                cases found
                obtain ⟨fits, checked⟩ := ih step.target following rest
                obtain ⟨aligned, valid⟩ := nextDelta_valid environment source step next
                refine ⟨Nat.succ_le_succ fits, ?_⟩
                simp only [checkPath, Edge.source, Edge.target, Bool.and_eq_true, decide_eq_true_eq]
                exact ⟨⟨aligned, valid⟩, checked⟩

/-- A completed bounded search keeps the same concrete witness or refusal at
larger bounds. Exhaustion carries no such conclusion. -/
theorem seek_completed_succ (environment : Environment) (budget : Nat) (source target : Tm)
    (completed : seek environment budget source target ≠ .exhausted) :
    seek environment (budget + 1) source target = seek environment budget source target := by
  induction budget generalizing source with
  | zero =>
      by_cases same : source = target
      · simp only [seek, if_pos same]
      · cases next : nextDelta environment source with
        | none => simp only [seek, if_neg same, next]
        | some step =>
            simp only [seek, if_neg same, next] at completed
            exact False.elim (completed rfl)
  | succ budget ih =>
      by_cases same : source = target
      · simp only [seek, if_pos same]
      · cases next : nextDelta environment source with
        | none => simp only [seek, if_neg same, next]
        | some step =>
            have child : seek environment budget step.target target ≠ .exhausted := by
              intro exhausted
              simp only [seek, if_neg same, next, exhausted] at completed
              exact completed rfl
            conv_lhs => rw [seek, if_neg same, next]
            conv_rhs => rw [seek, if_neg same, next]
            change (match seek environment (budget + 1) step.target target with
              | .found rest => SearchResult.found (⟨step, false⟩ :: rest)
              | .exhausted => SearchResult.exhausted
              | .refused => SearchResult.refused) = _
            rw [ih step.target child]

theorem seek_completed_mono (environment : Environment) (source target : Tm) {first second : Nat}
    (increased : first ≤ second) (completed : seek environment first source target ≠ .exhausted) :
    seek environment second source target = seek environment first source target := by
  obtain ⟨extra, rfl⟩ := Nat.exists_eq_add_of_le increased
  clear increased
  induction extra with
  | zero => rfl
  | succ extra ih =>
      simpa only [Nat.add_assoc] using
        (seek_completed_succ environment (first + extra) source target (by rwa [ih])).trans ih

def completion (environment : Environment) (source target : Tm) (budget : Nat) : Option (Option (List Edge)) :=
  match seek environment budget source target with
  | .exhausted => none
  | .refused => some none
  | .found edges => some (some edges)

/-- The exact partial algorithm retries this selected definition-unfolding
search. A returned `none` is a completed refusal; absence of a Part result is
not a refusal. -/
def partialSearch (environment : Environment) (source target : Tm) : Part (Option (List Edge)) :=
  Nat.rfindOpt (completion environment source target)

theorem completion_mono (environment : Environment) (source target : Tm) {first second : Nat}
    {result : Option (List Edge)} (increased : first ≤ second)
    (completed : completion environment source target first = some result) :
    completion environment source target second = some result := by
  have finished : seek environment first source target ≠ .exhausted := by
    intro exhausted
    simp only [completion, exhausted] at completed
    cases completed
  simpa only [completion, seek_completed_mono environment source target increased finished] using completed

theorem partialSearch_result_iff (environment : Environment) (source target : Tm) (result : Option (List Edge)) :
    result ∈ partialSearch environment source target ↔
      ∃ budget, completion environment source target budget = some result := by
  constructor
  · intro accepted
    obtain ⟨budget, completed⟩ := Nat.rfindOpt_spec accepted
    exact ⟨budget, by simpa only [Option.mem_def] using completed⟩
  · rintro ⟨budget, completed⟩
    have domain : (partialSearch environment source target).Dom := by
      rw [partialSearch, Nat.rfindOpt_dom]
      exact ⟨budget, result, by simpa only [Option.mem_def] using completed⟩
    obtain ⟨actual, accepted⟩ := Part.dom_iff_mem.mp domain
    obtain ⟨first, observed⟩ := Nat.rfindOpt_spec accepted
    have observedEq : completion environment source target first = some actual := by
      simpa only [Option.mem_def] using observed
    have one := completion_mono environment source target (le_max_left first budget) observedEq
    have two := completion_mono environment source target (le_max_right first budget) completed
    have same : actual = result := Option.some.inj (one.symm.trans two)
    simpa only [same] using accepted

theorem partialSearch_found_sound (environment : Environment) (source target : Tm) (edges : List Edge)
    (accepted : some edges ∈ partialSearch environment source target) :
    checkPath environment.terms source target edges = true := by
  obtain ⟨budget, completed⟩ := (partialSearch_result_iff environment source target (some edges)).mp accepted
  cases result : seek environment budget source target with
  | exhausted | refused => simp only [completion, result] at completed; cases completed
  | found actual =>
      simp only [completion, result, Option.some.injEq] at completed
      subst actual
      exact (seek_sound environment budget source target edges result).2


def recognizes (environment : Environment) (budget : Nat) (left right : Tm) : Bool :=
  match seek environment budget left right, seek environment budget right left with
  | .found _, _ | _, .found _ => true
  | _, _ => false

theorem recognizes_mono (environment : Environment) (left right : Tm) {first second : Nat}
    (increased : first ≤ second) (recognized : recognizes environment first left right = true) :
    recognizes environment second left right = true := by
  cases one : seek environment first left right with
  | found edges =>
      have more := seek_completed_mono environment left right increased (by rw [one]; intro impossible; cases impossible)
      simp only [recognizes, more, one]
  | exhausted | refused =>
      cases two : seek environment first right left with
      | found edges =>
          have more := seek_completed_mono environment right left increased (by rw [two]; intro impossible; cases impossible)
          cases third : seek environment second left right <;> simp only [recognizes, third, more, two]
      | exhausted | refused => simp only [recognizes, one, two, Bool.false_eq_true] at recognized

theorem recognizes_sound (environment : Environment) (budget : Nat) (left right : Tm)
    (recognized : recognizes environment budget left right = true) : Conversion environment.terms left right := by
  cases first : seek environment budget left right with
  | found edges => exact checkPath_sound environment.terms left right edges (seek_sound environment budget left right edges first).2
  | exhausted | refused =>
      cases second : seek environment budget right left with
      | found edges =>
          exact Relation.EqvGen.symm _ _
            (checkPath_sound environment.terms right left edges (seek_sound environment budget right left edges second).2)
      | exhausted | refused => simp [recognizes, first, second] at recognized

namespace Controls

def environment : Environment := { terms := [
  ⟨"a", .prop, some (.named "b")⟩,
  ⟨"b", .prop, some (.named "c")⟩,
  ⟨"c", .prop, none⟩] }

def firstEdge : Edge := ⟨deltaStep environment.terms "a" .prop (.named "b"), false⟩
def secondEdge : Edge := ⟨deltaStep environment.terms "b" .prop (.named "c"), false⟩

theorem first_edge_checked : checkEdge environment.terms firstEdge = true :=
  deltaStep_valid environment.terms (by rfl)
theorem second_edge_checked : checkEdge environment.terms secondEdge = true :=
  deltaStep_valid environment.terms (by rfl)

theorem first_witness : checkBounded environment.terms 1 (.named "a") (.named "b") [firstEdge] = some true := by
  apply (bounded_accepted_iff _ _ _ _ _).mpr
  exact ⟨by decide, Bool.and_eq_true_iff.mpr ⟨Bool.and_eq_true_iff.mpr ⟨by decide, first_edge_checked⟩, by decide⟩⟩

theorem second_witness : checkBounded environment.terms 1 (.named "b") (.named "c") [secondEdge] = some true := by
  apply (bounded_accepted_iff _ _ _ _ _).mpr
  exact ⟨by decide, Bool.and_eq_true_iff.mpr ⟨Bool.and_eq_true_iff.mpr ⟨by decide, second_edge_checked⟩, by decide⟩⟩

theorem composed_witness :
    checkBounded environment.terms 2 (.named "a") (.named "c") [firstEdge, secondEdge] = some true :=
  bounded_compose environment.terms (.named "a") (.named "b") (.named "c")
    [firstEdge] [secondEdge] 1 1 first_witness second_witness

theorem composed_witness_low_budget :
    checkBounded environment.terms 1 (.named "a") (.named "c") [firstEdge, secondEdge] = none := by
  simp only [checkBounded, List.length_cons, List.length_nil, Nat.reduceAdd, Nat.reduceLeDiff, if_false]

theorem wrong_endpoint_refused :
    checkBounded environment.terms 1 (.named "a") (.named "c") [firstEdge] = some false := by
  change some ((decide (firstEdge.source = .named "a") && checkEdge environment.terms firstEdge) && false) = some false
  rw [Bool.and_false]

theorem exhausted_with_next_definition : seek environment 0 (.named "a") (.named "c") = .exhausted := by
  simp [seek, nextDelta, environment, Environment.lookupTerm?, lookupTermList?]

theorem refused_at_parameter : seek environment 0 (.named "c") (.named "a") = .refused := by
  simp [seek, nextDelta, environment, Environment.lookupTerm?, lookupTermList?]

theorem first_at_one : recognizes environment 1 (.named "a") (.named "b") = true := by
  simp [recognizes, seek, nextDelta, environment, Environment.lookupTerm?, lookupTermList?, deltaStep]
theorem second_at_one : recognizes environment 1 (.named "b") (.named "c") = true := by
  simp [recognizes, seek, nextDelta, environment, Environment.lookupTerm?, lookupTermList?, deltaStep]
theorem composite_not_at_one : recognizes environment 1 (.named "a") (.named "c") = false := by
  simp [recognizes, seek, nextDelta, environment, Environment.lookupTerm?, lookupTermList?, deltaStep]
theorem composite_at_two : recognizes environment 2 (.named "a") (.named "c") = true := by
  simp [recognizes, seek, nextDelta, environment, Environment.lookupTerm?, lookupTermList?, deltaStep]

theorem bounded_recognizer_not_transitive :
    ¬ IsTrans Tm (fun left right => recognizes environment 1 left right = true) := by
  intro transitive
  have recognized := transitive.trans (.named "a") (.named "b") (.named "c") first_at_one second_at_one
  change recognizes environment 1 (.named "a") (.named "c") = true at recognized
  rw [composite_not_at_one] at recognized
  cases recognized

end Controls
end Mettapedia.Languages.Megalodon.FuelledConversionWitness
