import Mettapedia.Languages.HOLLight.MeTTa.RuleData

/-! # Executable premise-inspection examples from the maintained HOL requests -/

namespace Mettapedia.Languages.HOLLight.MeTTa.RuleDataExport

open Mettapedia.Languages.MeTTa.OSLFCore (Atom)

def kinds : List InferenceKind :=
  [.refl, .trans, .mkComb, .abs, .beta, .assume, .eqMp, .deductAntisym, .instType, .inst]

theorem all_primitive_kinds (kind : InferenceKind) : kind ∈ kinds := by cases kind <;> decide
theorem exactly_ten_kinds : kinds.length = 10 ∧ kinds.Nodup := by decide

def inspection (kind : InferenceKind) (payload first second : Atom) : Atom :=
  .expression [.symbol "assertEqual",
    .expression [.symbol "hol-light:premises", Premises.request kind payload first second],
    Premises.keys (Premises.occurrences kind first second)]

def text : String :=
  let payload := Atom.symbol "payload"
  let first := Atom.grounded (.string "first")
  let second := Atom.grounded (.string "second")
  "; Generated by HOLLight.MeTTa.RuleDataExport from Premises.request and occurrences.\n" ++
  "; These requests inspect premise positions; rule admission is a separate check.\n" ++
  "!(import! &self ../../lib/hol_light/data.metta)\n" ++
  "!(import! &self ../../lib/hol_light/syntax.metta)\n" ++
  "!(import! &self ../../lib/hol_light/kernel.metta)\n" ++
  String.join (kinds.map fun kind => "!" ++ toString (inspection kind payload first second) ++ "\n") ++
  "!" ++ toString (inspection .trans payload first first) ++ "\n"

def main (arguments : List String) : IO UInt32 := do
  match arguments with
  | [output] => IO.FS.writeFile output text; pure 0
  | _ => IO.eprintln "usage: RuleDataExport <output.metta>"; pure 1

end Mettapedia.Languages.HOLLight.MeTTa.RuleDataExport

def main (arguments : List String) : IO UInt32 :=
  Mettapedia.Languages.HOLLight.MeTTa.RuleDataExport.main arguments
