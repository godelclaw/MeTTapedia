import Mettapedia.Cybernetics.DistinctionCalculus.Exclusion

/-!
# Learning a concept by exclusion

On Dignāga's account a word is learned from the instances it applies to and from the
instances it excludes, and what it signifies is the exclusion of the others (*apoha*).
For a symmetric exclusion relation and examples `pos` (instances of the word) and `neg`
(instances of other words):

* a **hypothesis** consistent with the examples is a concept by exclusion that contains
  every positive example and whose members exclude every negative example
  (`Consistent`);
* a hypothesis exists exactly when every positive example excludes every negative one
  (`exists_consistent_iff`), a condition symmetric in the two kinds of example
  (`separated_comm`);
* the consistent hypotheses are then exactly the concepts between the concept
  generated by the positive examples, the most specific hypothesis, and the exclusion
  of the negative examples, the most general (`consistent_iff`,
  `consistent_generated`, `consistent_excluded`).  The most general hypothesis depends
  only on what is excluded: it is the meaning as "exclusion of the other", and it is
  the largest consistent extension;
* more positive examples raise the lower end and more negative examples lower the upper
  end (`generated_mono`, `excluded_anti`);
* **with every excluded instance as a negative example the hypothesis is determined**:
  the only consistent hypothesis is the concept generated by the positive examples
  (`consistent_excluded_iff`).

**The six-hue circle** (`HueCircle`): six hues, each indistinguishable from itself and
its two neighbours, an observer without the metric law (`HueCircle.not_metric`).  From
the positive example `0` and the negative example `3`, the consistent hypotheses are
exactly `{0}`, `{0, 1}`, `{0, 5}` and `{0, 1, 5}` (`HueCircle.consistent_iff`).  The
most general is the resemblance class of `0` (`HueCircle.resemblance_zero`); the most
specific is `{0}`, the concept of `0` itself (`HueCircle.conceptOf_zero`).  With the
full exclusion of `0` as negative examples only `{0}` remains
(`HueCircle.consistent_full_exclusion_iff`).

References: M. Hattori, *Dignāga, On Perception* (1968), and S. Katsura, *The apoha
theory of Dignāga*, Journal of Indian and Buddhist Studies 28 (1979); T. Mitchell,
*Generalization as search*, Artificial Intelligence 18 (1982), for version spaces;
M. T. Bennett, *The optimal choice of hypothesis is the weakest, not the shortest*
(AGI 2023), for choosing the largest consistent extension.
-/

set_option autoImplicit false

namespace Mettapedia.Cybernetics.DistinctionCalculus.Exclusion

open Set

universe u

variable {V : Type u}

/-- A hypothesis consistent with the examples: a concept containing every positive
example, whose members exclude every negative example. -/
def Consistent (excludes : V → V → Prop) (pos neg S : Set V) : Prop :=
  IsConcept excludes S ∧ pos ⊆ S ∧ S ⊆ excluded excludes neg

/-- The examples are separated when every positive example excludes every negative
one. -/
def Separated (excludes : V → V → Prop) (pos neg : Set V) : Prop :=
  pos ⊆ excluded excludes neg

variable {excludes : V → V → Prop}

/-- More positive examples raise the most specific hypothesis. -/
theorem generated_mono {pos pos' : Set V} (included : pos ⊆ pos') :
    excluded excludes (excluded excludes pos) ⊆ excluded excludes (excluded excludes pos') :=
  excluded_anti (excluded_anti included)

section Symmetric

variable (symm : ∀ x y, excludes x y → excludes y x)
include symm

/-- Separation is symmetric in the two kinds of example. -/
theorem separated_comm {pos neg : Set V} : Separated excludes pos neg ↔ Separated excludes neg pos :=
  ⟨fun separated _ inNeg _ inPos => symm _ _ (separated inPos inNeg),
    fun separated _ inPos _ inNeg => symm _ _ (separated inNeg inPos)⟩

/-- **The consistent hypotheses are the concepts between the two ends.** -/
theorem consistent_iff {pos neg S : Set V} :
    Consistent excludes pos neg S ↔
      IsConcept excludes S ∧ excluded excludes (excluded excludes pos) ⊆ S ∧
        S ⊆ excluded excludes neg := by
  constructor
  · rintro ⟨concept, contains, excludesNeg⟩
    refine ⟨concept, ?_, excludesNeg⟩
    rw [← concept]
    exact generated_mono contains
  · rintro ⟨concept, generated, excludesNeg⟩
    exact ⟨concept, Subset.trans (subset_excluded_excluded symm pos) generated, excludesNeg⟩

/-- **A consistent hypothesis exists exactly when the examples are separated.** -/
theorem exists_consistent_iff {pos neg : Set V} :
    (∃ S, Consistent excludes pos neg S) ↔ Separated excludes pos neg := by
  constructor
  · rintro ⟨S, -, contains, excludesNeg⟩
    exact Subset.trans contains excludesNeg
  · intro separated
    exact ⟨excluded excludes neg, isConcept_excluded symm neg, separated, Subset.rfl⟩

/-- The most specific hypothesis: the concept generated by the positive examples. -/
theorem consistent_generated {pos neg : Set V} (separated : Separated excludes pos neg) :
    Consistent excludes pos neg (excluded excludes (excluded excludes pos)) := by
  refine ⟨isConcept_excluded symm _, subset_excluded_excluded symm pos, ?_⟩
  rw [← excluded_excluded_excluded symm neg]
  exact generated_mono separated

/-- The most general hypothesis: the exclusion of the negative examples. -/
theorem consistent_excluded {pos neg : Set V} (separated : Separated excludes pos neg) :
    Consistent excludes pos neg (excluded excludes neg) :=
  ⟨isConcept_excluded symm neg, separated, Subset.rfl⟩

/-- **With every excluded instance as a negative example, the hypothesis is
determined**: it is the concept generated by the positive examples. -/
theorem consistent_excluded_iff {pos S : Set V} :
    Consistent excludes pos (excluded excludes pos) S ↔
      S = excluded excludes (excluded excludes pos) := by
  rw [consistent_iff symm]
  constructor
  · rintro ⟨-, generated, excludesNeg⟩
    exact Subset.antisymm excludesNeg generated
  · rintro rfl
    exact ⟨isConcept_excluded symm _, Subset.rfl, Subset.rfl⟩

end Symmetric

/-! ## The six-hue circle -/

namespace HueCircle

/-- Neighbouring hues, cyclically. -/
def near (x y : Fin 6) : Prop :=
  x = y ∨ x = y + 1 ∨ y = x + 1

instance : DecidableRel near := fun x y => by
  unfold near
  infer_instance

/-- Neighbours are fully similar; others not at all. -/
def similarity (x y : Fin 6) : ℚ :=
  if near x y then 1 else 0

/-- Six hues, each indistinguishable from itself and its two neighbours. -/
def hues : DistinctionCalculus.Tolerance (Fin 6) where
  similarity := similarity
  nonnegative x y := by unfold similarity; split_ifs <;> norm_num
  bounded x y := by unfold similarity; split_ifs <;> norm_num
  reflexive x := by simp [similarity, near]
  symmetric x y := by fin_cases x <;> fin_cases y <;> simp [similarity, near]

theorem apart_iff (x y : Fin 6) : hues.Apart x y ↔ ¬ near x y := by
  simp only [DistinctionCalculus.Tolerance.Apart, DistinctionCalculus.Tolerance.distance, hues,
    similarity]
  split_ifs with neighbours <;> simp [neighbours]

/-- The observer fails the metric law: `0` and `2` are apart through the shared
neighbour `1`. -/
theorem not_metric : ¬ hues.Metric := by
  intro metric
  have triangle := metric 0 1 2
  simp only [DistinctionCalculus.Tolerance.distance, hues, similarity] at triangle
  rw [if_neg (show ¬ near 0 2 by decide), if_pos (show near 0 1 by decide),
    if_pos (show near 1 2 by decide)] at triangle
  norm_num at triangle

theorem excluded_zero : excluded hues.Apart {0} = {2, 3, 4} := by
  ext y
  rw [mem_excluded]
  fin_cases y <;> simp [apart_iff, near]

theorem excluded_three : excluded hues.Apart {3} = {0, 1, 5} := by
  ext y
  rw [mem_excluded]
  fin_cases y <;> simp [apart_iff, near]

theorem excluded_two_three_four : excluded hues.Apart {2, 3, 4} = {0} := by
  ext y
  rw [mem_excluded]
  fin_cases y <;> simp [apart_iff, near]

theorem excluded_three_four : excluded hues.Apart {3, 4} = {0, 1} := by
  ext y
  rw [mem_excluded]
  fin_cases y <;> simp [apart_iff, near]

theorem excluded_zero_one : excluded hues.Apart {0, 1} = {3, 4} := by
  ext y
  rw [mem_excluded]
  fin_cases y <;> simp [apart_iff, near]

theorem excluded_two_three : excluded hues.Apart {2, 3} = {0, 5} := by
  ext y
  rw [mem_excluded]
  fin_cases y <;> simp [apart_iff, near]

theorem excluded_zero_five : excluded hues.Apart {0, 5} = {2, 3} := by
  ext y
  rw [mem_excluded]
  fin_cases y <;> simp [apart_iff, near]

theorem excluded_zero_one_five : excluded hues.Apart {0, 1, 5} = {3} := by
  ext y
  rw [mem_excluded]
  fin_cases y <;> simp [apart_iff, near]

/-- The concept of `0` is `{0}`. -/
theorem conceptOf_zero : conceptOf hues.Apart 0 = {0} := by
  rw [conceptOf, excluded_zero, excluded_two_three_four]

/-- The resemblance class of `0`: the hues not apart from it. -/
theorem resemblance_zero : {y | ¬ hues.Apart 0 y} = {0, 1, 5} := by
  ext y
  fin_cases y <;> simp [apart_iff, near]

theorem isConcept_zero : IsConcept hues.Apart {0} := by
  rw [IsConcept, excluded_zero, excluded_two_three_four]

theorem isConcept_zero_one : IsConcept hues.Apart {0, 1} := by
  rw [IsConcept, excluded_zero_one, excluded_three_four]

theorem isConcept_zero_five : IsConcept hues.Apart {0, 5} := by
  rw [IsConcept, excluded_zero_five, excluded_two_three]

theorem isConcept_zero_one_five : IsConcept hues.Apart {0, 1, 5} := by
  rw [IsConcept, excluded_zero_one_five, excluded_three]

/-- **Learning from the positive example `0` and the negative example `3`**: the
consistent hypotheses are exactly the four concepts from `{0}` to `{0, 1, 5}`. -/
theorem consistent_iff (S : Set (Fin 6)) :
    Consistent hues.Apart {0} {3} S ↔ S = {0} ∨ S = {0, 1} ∨ S = {0, 5} ∨ S = {0, 1, 5} := by
  rw [Exclusion.consistent_iff (Tolerance.apart_symmetric hues), ← conceptOf, conceptOf_zero,
    excluded_three]
  constructor
  · rintro ⟨-, lower, upper⟩
    have zero : (0 : Fin 6) ∈ S := lower rfl
    have inside : ∀ x, x ∈ S → x = 0 ∨ x = 1 ∨ x = 5 := fun x member => upper member
    by_cases one : (1 : Fin 6) ∈ S <;> by_cases five : (5 : Fin 6) ∈ S
    · right; right; right
      ext x
      constructor
      · intro member
        exact inside x member
      · rintro (rfl | rfl | rfl) <;> assumption
    · right; left
      ext x
      constructor
      · intro member
        rcases inside x member with rfl | rfl | rfl
        · exact Or.inl rfl
        · exact Or.inr rfl
        · exact (five member).elim
      · rintro (rfl | rfl) <;> assumption
    · right; right; left
      ext x
      constructor
      · intro member
        rcases inside x member with rfl | rfl | rfl
        · exact Or.inl rfl
        · exact (one member).elim
        · exact Or.inr rfl
      · rintro (rfl | rfl) <;> assumption
    · left
      ext x
      constructor
      · intro member
        rcases inside x member with rfl | rfl | rfl
        · rfl
        · exact (one member).elim
        · exact (five member).elim
      · rintro rfl
        exact zero
  · rintro (rfl | rfl | rfl | rfl)
    · exact ⟨isConcept_zero, Subset.rfl, by intro x member; rw [member]; exact Or.inl rfl⟩
    · refine ⟨isConcept_zero_one, fun x member => Or.inl member, ?_⟩
      rintro x (rfl | rfl)
      · exact Or.inl rfl
      · exact Or.inr (Or.inl rfl)
    · refine ⟨isConcept_zero_five, fun x member => Or.inl member, ?_⟩
      rintro x (rfl | rfl)
      · exact Or.inl rfl
      · exact Or.inr (Or.inr rfl)
    · exact ⟨isConcept_zero_one_five, fun x member => Or.inl member, Subset.rfl⟩

/-- **With the full exclusion of `0` as negative examples only `{0}` remains.** -/
theorem consistent_full_exclusion_iff (S : Set (Fin 6)) :
    Consistent hues.Apart {0} {2, 3, 4} S ↔ S = {0} := by
  rw [← excluded_zero, consistent_excluded_iff (Tolerance.apart_symmetric hues), ← conceptOf,
    conceptOf_zero]

end HueCircle

end Mettapedia.Cybernetics.DistinctionCalculus.Exclusion
