import Mettapedia.Cybernetics.DistinctionCalculus.Basic
import Mathlib.Order.Concept

/-!
# Concepts by exclusion

An observer that draws distinctions also draws exclusions: two instances exclude each
other when the observer sets them apart.  Reading a class by what it excludes is
Dignāga's account of word meaning (*apoha*, exclusion of the other): a word signifies
by excluding whatever is not of its kind.

For a symmetric exclusion relation, the **exclusion** of a class `S` is the class of
instances that exclude every member of `S` (`excluded`, the polar of the relation in
`Mathlib.Order.Concept`).  Excluding twice is a closure operator (`exclusionClosure`,
the extent closure of the formal context whose incidence is exclusion).  Its closed
classes are the **concepts by exclusion** (`IsConcept`).

* **Treble negation is negation.**  Excluding three times is excluding once
  (`excluded_excluded_excluded`).
* **Mutual negation.**  A concept is the exclusion of its own exclusion (by
  definition), and every exclusion is a concept (`isConcept_excluded`).
* **Non-contradiction.**  For an irreflexive relation nothing lies in a class and in
  its exclusion (`inter_excluded_eq_empty`).
* **The conceptual dichotomy is complete.**  The concept generated by any class
  together with its exclusion is everything (`exclusionClosure_union_excluded`): in
  the lattice of concepts there is no third.
* **The particulars may lie between.**  Every instance lies in each concept or in its
  exclusion exactly when non-exclusion is transitive (`union_excluded_eq_univ_iff`).
* **Exclusion is not resemblance.**  The concept of an instance (its double
  exclusion, `conceptOf`) contains only instances that do not exclude it
  (`conceptOf_subset_not_excludes`); with transitive non-exclusion it is exactly
  that class (`conceptOf_eq_of_transitive`), but in general it can be strictly
  smaller (`Control.conceptOf_zero`).

**Distinction-calculus observers.**  For a tolerance, exclusion is witnessed
apartness (`Tolerance.Apart`) and non-exclusion is indistinguishability.  The metric
law makes indistinguishability transitive, so for a metric observer every concept and
its exclusion partition the instances and the concept of an instance is its
indistinguishability class (`Tolerance.union_excluded_eq_univ_of_metric`,
`Tolerance.conceptOf_eq_of_metric`).  `Control.tolerance` is a three-instance
observer without the metric law: the middle instance is indistinguishable from both
ends, which are apart; it belongs neither to the concept of one end nor to that
concept's exclusion (`Control.middle_in_neither`), although the two together
generate everything.

References: Dharmakīrti's characterisation of contradiction as complete and mutual
exclusion, with its corollaries of excluded middle and double and treble negation,
in Th. Stcherbatsky, *Buddhist Logic*, vol. 1 (1932), pp. 403–405 and 417–418;
R. Goldblatt, *Semantic analysis of orthologic*, J. Philos. Logic 3 (1974), for
closure under a symmetric irreflexive relation.
-/

set_option autoImplicit false

namespace Mettapedia.Cybernetics.DistinctionCalculus.Exclusion

open Set

universe u

variable {V : Type u}

/-- **The exclusion of a class**: the instances excluding every member. -/
def excluded (excludes : V → V → Prop) (S : Set V) : Set V :=
  lowerPolar excludes S

/-- A **concept by exclusion**: a class equal to the exclusion of its exclusion. -/
def IsConcept (excludes : V → V → Prop) (S : Set V) : Prop :=
  excluded excludes (excluded excludes S) = S

/-- The concept of an instance: what excludes everything that excludes it. -/
def conceptOf (excludes : V → V → Prop) (x : V) : Set V :=
  excluded excludes (excluded excludes {x})

/-- **Double exclusion as a closure operator**: the extent closure of the context
whose incidence is exclusion. -/
def exclusionClosure (excludes : V → V → Prop) : ClosureOperator (Set V) :=
  extentClosure excludes

variable {excludes : V → V → Prop}

theorem mem_excluded {S : Set V} {y : V} : y ∈ excluded excludes S ↔ ∀ x ∈ S, excludes y x :=
  ⟨fun member _ inS => member inS, fun all _ inS => all _ inS⟩

theorem excluded_anti {S T : Set V} (included : S ⊆ T) : excluded excludes T ⊆ excluded excludes S :=
  lowerPolar_anti excludes included

theorem excluded_union (S T : Set V) :
    excluded excludes (S ∪ T) = excluded excludes S ∩ excluded excludes T :=
  lowerPolar_union excludes S T

theorem excluded_empty : excluded excludes (∅ : Set V) = univ :=
  lowerPolar_empty excludes

section Symmetric

variable (symm : ∀ x y, excludes x y → excludes y x)
include symm

/-- Every class lies in the exclusion of its exclusion. -/
theorem subset_excluded_excluded (S : Set V) : S ⊆ excluded excludes (excluded excludes S) :=
  fun x inS y member => symm y x (member inS)

/-- With a symmetric relation the exclusion is both polars. -/
theorem excluded_eq_upperPolar (S : Set V) : excluded excludes S = upperPolar excludes S := by
  ext y
  exact ⟨fun member x inS => symm y x (member inS), fun member x inS => symm x y (member inS)⟩

/-- **Treble negation is negation.** -/
theorem excluded_excluded_excluded (S : Set V) :
    excluded excludes (excluded excludes (excluded excludes S)) = excluded excludes S :=
  Subset.antisymm (excluded_anti (subset_excluded_excluded symm S))
    (subset_excluded_excluded symm (excluded excludes S))

/-- Every exclusion is a concept. -/
theorem isConcept_excluded (S : Set V) : IsConcept excludes (excluded excludes S) :=
  excluded_excluded_excluded symm S

theorem isConcept_conceptOf (x : V) : IsConcept excludes (conceptOf excludes x) :=
  isConcept_excluded symm _

theorem mem_conceptOf_self (x : V) : x ∈ conceptOf excludes x :=
  subset_excluded_excluded symm {x} rfl

theorem exclusionClosure_apply (S : Set V) :
    exclusionClosure excludes S = excluded excludes (excluded excludes S) := by
  rw [exclusionClosure, extentClosure_apply, ← excluded_eq_upperPolar symm]
  rfl

/-- Concepts by exclusion are the closed classes of double exclusion. -/
theorem isConcept_iff_isClosed (S : Set V) :
    IsConcept excludes S ↔ (exclusionClosure excludes).IsClosed S := by
  rw [ClosureOperator.isClosed_iff]
  show _ ↔ exclusionClosure excludes S = S
  rw [exclusionClosure_apply symm]
  rfl

/-- **Concepts by exclusion are the extents of the exclusion context.** -/
theorem isConcept_iff_isExtent (S : Set V) : IsConcept excludes S ↔ Order.IsExtent excludes S := by
  constructor
  · intro concept
    exact ⟨excluded excludes S, concept⟩
  · rintro ⟨T, rfl⟩
    exact isConcept_excluded symm T

/-- **No intermediate exactly under transitive non-exclusion**: every instance lies in
each concept or in its exclusion exactly when non-exclusion is transitive. -/
theorem union_excluded_eq_univ_iff :
    (∀ S, IsConcept excludes S → S ∪ excluded excludes S = univ) ↔
      ∀ x y z, ¬ excludes x y → ¬ excludes y z → ¬ excludes x z := by
  constructor
  · intro cover x y z notXY notYZ excludesXZ
    have inConcept : y ∈ conceptOf excludes x ∪ excluded excludes (conceptOf excludes x) := by
      rw [cover _ (isConcept_conceptOf symm x)]
      trivial
    rcases inConcept with inside | outside
    · have zOut : z ∈ excluded excludes {x} := fun w equal => by
        rw [Set.mem_singleton_iff.mp equal]
        exact symm x z excludesXZ
      exact notYZ (inside zOut)
    · exact notXY (symm y x (outside (mem_conceptOf_self symm x)))
  · intro trans S concept
    apply eq_univ_of_forall
    intro y
    by_contra neither
    simp only [mem_union, not_or] at neither
    obtain ⟨notInS, notOut⟩ := neither
    apply notInS
    rw [← concept]
    intro z zOut
    by_contra notYZ
    apply notOut
    intro x inS
    by_contra notYX
    exact trans x y z (fun h => notYX (symm x y h)) notYZ (symm z x (zOut inS))

end Symmetric

section Irreflexive

variable (irrefl : ∀ x, ¬ excludes x x)
include irrefl

/-- **Non-contradiction.** -/
theorem inter_excluded_eq_empty (S : Set V) : S ∩ excluded excludes S = ∅ :=
  eq_empty_of_forall_notMem fun x ⟨inS, member⟩ => irrefl x (member inS)

/-- **The conceptual dichotomy is complete**: a class and its exclusion together
generate everything. -/
theorem exclusionClosure_union_excluded (S : Set V) :
    excluded excludes (excluded excludes (S ∪ excluded excludes S)) = univ := by
  have nothing : excluded excludes (S ∪ excluded excludes S) = ∅ := by
    rw [excluded_union]
    exact inter_excluded_eq_empty irrefl (excluded excludes S)
  rw [nothing, excluded_empty]

end Irreflexive

section Middle

variable (symm : ∀ x y, excludes x y → excludes y x) (irrefl : ∀ x, ¬ excludes x x)
include symm irrefl

/-- **The concept of an instance contains only instances that do not exclude it.** -/
theorem conceptOf_subset_not_excludes (x : V) : conceptOf excludes x ⊆ {y | ¬ excludes x y} := by
  intro y member excl
  have outside : y ∈ excluded excludes {x} := fun z equal => by
    rw [Set.mem_singleton_iff.mp equal]
    exact symm x y excl
  exact irrefl y (member outside)

/-- With transitive non-exclusion the concept of an instance is exactly the class of
instances that do not exclude it. -/
theorem conceptOf_eq_of_transitive
    (trans : ∀ x y z, ¬ excludes x y → ¬ excludes y z → ¬ excludes x z) (x : V) :
    conceptOf excludes x = {y | ¬ excludes x y} := by
  apply Subset.antisymm (conceptOf_subset_not_excludes symm irrefl x)
  intro y notXY z zOut
  by_contra notYZ
  exact trans x y z notXY notYZ (symm z x (zOut rfl))

end Middle

/-! ## Distinction-calculus observers -/

namespace Tolerance

open Mettapedia.Cybernetics.DistinctionCalculus

variable {W : Type u} {R : Type} [Field R] [LinearOrder R] [IsStrictOrderedRing R]

theorem apart_symmetric (a : DistinctionCalculus.Tolerance W R) (x y : W) :
    a.Apart x y → a.Apart y x :=
  fun h => a.apart_symm h

theorem apart_irrefl (a : DistinctionCalculus.Tolerance W R) (x : W) : ¬ a.Apart x x :=
  fun h => a.apart_implies_ne h rfl

/-- The metric law makes non-apartness transitive. -/
theorem not_apart_trans_of_metric (a : DistinctionCalculus.Tolerance W R) (metric : a.Metric)
    (x y z : W) : ¬ a.Apart x y → ¬ a.Apart y z → ¬ a.Apart x z := by
  intro xy yz
  rw [a.not_apart_iff_indistinguishable] at xy yz ⊢
  exact (a.zeroSetoid metric).iseqv.trans xy yz

/-- **For a metric observer every concept and its exclusion partition the
instances.** -/
theorem union_excluded_eq_univ_of_metric (a : DistinctionCalculus.Tolerance W R)
    (metric : a.Metric) (S : Set W) (concept : IsConcept a.Apart S) :
    S ∪ excluded a.Apart S = univ :=
  (union_excluded_eq_univ_iff (apart_symmetric a)).mpr (not_apart_trans_of_metric a metric) S
    concept

/-- For a metric observer the concept of an instance is its indistinguishability
class. -/
theorem conceptOf_eq_of_metric (a : DistinctionCalculus.Tolerance W R) (metric : a.Metric)
    (x : W) : conceptOf a.Apart x = {y | a.Indistinguishable x y} := by
  rw [conceptOf_eq_of_transitive (apart_symmetric a) (apart_irrefl a)
    (not_apart_trans_of_metric a metric)]
  ext y
  exact a.not_apart_iff_indistinguishable x y

end Tolerance

/-! ## Control: a tolerance with a middle instance -/

namespace Control

open Mettapedia.Cybernetics.DistinctionCalculus

/-- The two ends `0` and `2` are dissimilar; everything else is similar. -/
def similarity (x y : Fin 3) : ℚ :=
  if (x = 0 ∧ y = 2) ∨ (x = 2 ∧ y = 0) then 0 else 1

/-- Three instances: the middle one is similar to both ends, which are dissimilar. -/
def tolerance : DistinctionCalculus.Tolerance (Fin 3) where
  similarity := similarity
  nonnegative x y := by unfold similarity; split_ifs <;> norm_num
  bounded x y := by unfold similarity; split_ifs <;> norm_num
  reflexive x := by fin_cases x <;> simp [similarity]
  symmetric x y := by fin_cases x <;> fin_cases y <;> simp [similarity]

theorem apart_iff (x y : Fin 3) : tolerance.Apart x y ↔ (x = 0 ∧ y = 2) ∨ (x = 2 ∧ y = 0) := by
  fin_cases x <;> fin_cases y <;>
    simp [DistinctionCalculus.Tolerance.Apart, DistinctionCalculus.Tolerance.distance,
      tolerance, similarity]

/-- The observer fails the metric law. -/
theorem not_metric : ¬ tolerance.Metric := by
  intro metric
  have triangle := metric 0 1 2
  simp [DistinctionCalculus.Tolerance.distance, tolerance, similarity] at triangle
  norm_num at triangle

theorem excluded_zero : excluded tolerance.Apart {0} = {2} := by
  ext y
  rw [mem_excluded]
  fin_cases y <;> simp [apart_iff]

theorem excluded_two : excluded tolerance.Apart {2} = {0} := by
  ext y
  rw [mem_excluded]
  fin_cases y <;> simp [apart_iff]

/-- The concept of `0` is `{0}`. -/
theorem conceptOf_zero : conceptOf tolerance.Apart 0 = {0} := by
  rw [conceptOf, excluded_zero, excluded_two]

theorem isConcept_zero : IsConcept tolerance.Apart {0} := by
  rw [IsConcept, excluded_zero, excluded_two]

/-- **Exclusion is not resemblance**: the middle is indistinguishable from `0` but
outside the concept of `0`. -/
theorem middle_similar_not_in_concept :
    tolerance.Indistinguishable 0 1 ∧ (1 : Fin 3) ∉ conceptOf tolerance.Apart 0 := by
  refine ⟨?_, ?_⟩
  · simp [DistinctionCalculus.Tolerance.Indistinguishable, DistinctionCalculus.Tolerance.distance,
      tolerance, similarity]
  · rw [conceptOf_zero]
    decide

/-- **The middle instance lies in neither the concept nor its exclusion.** -/
theorem middle_in_neither :
    (1 : Fin 3) ∉ ({0} : Set (Fin 3)) ∪ excluded tolerance.Apart {0} := by
  rw [excluded_zero]
  decide

/-- Yet the concept and its exclusion together generate everything. -/
theorem zero_and_exclusion_generate_all :
    excluded tolerance.Apart (excluded tolerance.Apart ({0} ∪ excluded tolerance.Apart {0})) =
      univ :=
  exclusionClosure_union_excluded (Tolerance.apart_irrefl tolerance) {0}

end Control

end Mettapedia.Cybernetics.DistinctionCalculus.Exclusion
