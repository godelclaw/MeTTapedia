import Mettapedia.Logic.HOL.Soundness
import Mettapedia.Logic.HOL.TypeSubstitutionSemantics
import Mettapedia.Logic.HOL.ConstantSubstitutionSemantics

/-!
# Arithmetic relations generated by successor closure

`less` says that the upper endpoint belongs to every successor-closed
predicate containing the successor of the lower endpoint. In a full-domain
model with a successor-preserving natural-number equivalence this is exactly
strict natural order. No separate order constant or interpretation premise is
required.
-/

set_option autoImplicit false
namespace Mettapedia.Logic.HOL.SuccessorOrder
universe u v w
variable {Base : Type u} {Const : Ty Base → Type v} {number : Ty Base}

def less (successor : ClosedTerm Const (number ⇒ number)) :
    ClosedTerm Const (number ⇒ number ⇒ .prop) :=
  .lam (.lam (.all (σ := number ⇒ .prop) (.imp
    (.and (.app (.var .vz) (.app (weakenCtx _ successor) (.var (.vs (.vs .vz)))))
      (.all (σ := number) (.imp (.app (.var (.vs .vz)) (.var .vz))
        (.app (.var (.vs .vz)) (.app (weakenCtx _ successor) (.var .vz))))))
    (.app (.var .vz) (.var (.vs .vz))))))

variable (model : HenkinModel.{u,v,w} Base Const) (full : model.FullDomains)
  (successor : ClosedTerm Const (number ⇒ number)) (values : model.Valuation [])

include full

theorem less_denote (lower upper : Ty.denote model.Carrier number) :
    (model.denote (less successor) values lower upper).down ↔
      ∀ predicate : Ty.denote model.Carrier number → Prop,
        predicate (model.denote successor values lower) →
        (∀ value, predicate value → predicate (model.denote successor values value)) →
        predicate upper := by
  have admitted : ∀ type value, model.adm type value := full
  have weakened (context : Ctx Base) (later : model.Valuation context) :
      model.denote (weakenCtx context successor) later = model.denote successor values := by
    rw [model.denote_weakenCtx]
    apply congrArg (model.denote successor)
    funext type index
    exact nomatch index
  simp only [less, HenkinModel.denote, PreModel.denote, PreModel.extend]
  simp only [admitted, forall_true_left, weakened]
  constructor
  · intro valid predicate start closed
    exact valid (fun value => ULift.up (predicate value)) ⟨start, closed⟩
  · intro valid predicate premises
    exact valid (fun value => (predicate value).down) premises.1 premises.2

theorem less_iff (numbers : Nat ≃ Ty.denote model.Carrier number)
    (successor_preserved : ∀ n, model.denote successor values (numbers n) = numbers (n + 1))
    (lower upper : Ty.denote model.Carrier number) :
    (model.denote (less successor) values lower upper).down ↔ numbers.symm lower < numbers.symm upper := by
  rw [less_denote model full successor values]
  have next_index (value : Ty.denote model.Carrier number) :
      numbers.symm (model.denote successor values value) = numbers.symm value + 1 := by
    have same := successor_preserved (numbers.symm value)
    rw [numbers.apply_symm_apply] at same
    rw [same, numbers.symm_apply_apply]
  constructor
  · intro valid
    apply valid (fun value => numbers.symm lower < numbers.symm value)
    · rw [next_index]
      exact Nat.lt_succ_self _
    · intro value smaller
      rw [next_index]
      exact Nat.lt_succ_of_lt smaller
  · intro smaller predicate start closed
    have first : predicate (numbers (numbers.symm lower + 1)) := by
      have same := successor_preserved (numbers.symm lower)
      rw [numbers.apply_symm_apply] at same
      exact same ▸ start
    have reaches : ∀ n, numbers.symm lower + 1 ≤ n → predicate (numbers n) := by
      intro n above
      induction n, above using Nat.le_induction with
      | base => exact first
      | succ n _ hypotheses =>
          rw [← successor_preserved]
          exact closed _ hypotheses
    exact numbers.apply_symm_apply upper ▸ reaches (numbers.symm upper) smaller

/-- Addition as simultaneous successor closure of the input/output pair.
The definition needs no extra arithmetic constant or selected function. -/
def sum (zero : ClosedTerm Const number) (successor : ClosedTerm Const (number ⇒ number)) :
    ClosedTerm Const (number ⇒ number ⇒ number ⇒ .prop) :=
  .lam (.lam (.lam (.all (σ := number ⇒ number ⇒ .prop) (.imp
    (.and (.app (.app (.var .vz) (weakenCtx _ zero)) (.var (.vs (.vs (.vs .vz)))))
      (.all (σ := number) (.all (σ := number) (.imp
        (.app (.app (.var (.vs (.vs .vz))) (.var (.vs .vz))) (.var .vz))
        (.app (.app (.var (.vs (.vs .vz))) (.app (weakenCtx _ successor) (.var (.vs .vz))))
          (.app (weakenCtx _ successor) (.var .vz)))))))
    (.app (.app (.var .vz) (.var (.vs (.vs .vz)))) (.var (.vs .vz)))))))

theorem sum_denote (zero : ClosedTerm Const number)
    (first second result : Ty.denote model.Carrier number) :
    (model.denote (sum zero successor) values first second result).down ↔
      ∀ predicate : Ty.denote model.Carrier number → Ty.denote model.Carrier number → Prop,
        predicate (model.denote zero values) first →
        (∀ count value, predicate count value →
          predicate (model.denote successor values count) (model.denote successor values value)) →
        predicate second result := by
  have admitted : ∀ type value, model.adm type value := full
  have weakened {type : Ty Base} (term : ClosedTerm Const type) (context : Ctx Base)
      (later : model.Valuation context) :
      model.denote (weakenCtx context term) later = model.denote term values := by
    rw [model.denote_weakenCtx]
    apply congrArg (model.denote term)
    funext type index
    exact nomatch index
  simp only [sum, HenkinModel.denote, PreModel.denote, PreModel.extend]
  simp only [admitted, forall_true_left, weakened]
  constructor
  · intro valid predicate start closed
    exact valid (fun count value => ULift.up (predicate count value)) ⟨start, closed⟩
  · intro valid predicate premises
    exact valid (fun count value => (predicate count value).down) premises.1 premises.2

theorem sum_iff (zero : ClosedTerm Const number) (numbers : Nat ≃ Ty.denote model.Carrier number)
    (zero_preserved : model.denote zero values = numbers 0)
    (successor_preserved : ∀ n, model.denote successor values (numbers n) = numbers (n + 1))
    (first second result : Ty.denote model.Carrier number) :
    (model.denote (sum zero successor) values first second result).down ↔
      numbers.symm result = numbers.symm first + numbers.symm second := by
  rw [sum_denote model full successor values zero]
  have next_index (value : Ty.denote model.Carrier number) :
      numbers.symm (model.denote successor values value) = numbers.symm value + 1 := by
    have same := successor_preserved (numbers.symm value)
    rw [numbers.apply_symm_apply] at same
    rw [same, numbers.symm_apply_apply]
  constructor
  · intro valid
    apply valid (fun count value => numbers.symm value = numbers.symm first + numbers.symm count)
    · rw [zero_preserved, Equiv.symm_apply_apply, Nat.add_zero]
    · intro count value same
      rw [next_index, next_index, same, Nat.add_assoc]
  · intro resultIndex predicate start closed
    have reaches : ∀ n, predicate (numbers n) (numbers (numbers.symm first + n)) := by
      intro n
      induction n with
      | zero => simpa only [Nat.add_zero, Equiv.apply_symm_apply, zero_preserved] using start
      | succ n hypothesis =>
          have step := closed (numbers n) (numbers (numbers.symm first + n)) hypothesis
          simpa only [successor_preserved, Nat.add_assoc] using step
    have reached := reaches (numbers.symm second)
    rw [← resultIndex, Equiv.apply_symm_apply, Equiv.apply_symm_apply] at reached
    exact reached

#print axioms sum_denote
#print axioms sum_iff

#print axioms less_denote
#print axioms less_iff
end Mettapedia.Logic.HOL.SuccessorOrder
