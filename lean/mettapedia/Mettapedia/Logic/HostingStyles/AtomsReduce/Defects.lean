import Mettapedia.Logic.HostingStyles.AtomsReduce.Contexts
import Mettapedia.Logic.HostingStyles.AtomsReduce.Programs

/-!
# What the five recorded defects of the probe became

Five defects of the probe are on record: its header pins two, and the study
of it as a host found three more.  For each of them this module states
whether it is absent from the candidate in which atoms reduce, or remains.

| defect of the probe | in the candidate |
|---|---|
| reduction in a sort that no constructor takes | **absent**: `separateSort_absent`, `application_reduces_both` |
| the sort `Alternatives` has no constructor | **absent**: `alternatives_absent`, `sorts_inhabited`; a choice between two results is generated by two equations for one left side, `nondeterminism_generated` |
| the sort `Space` has no constructor | **absent**: `space_constructed`, `closed_run_reduces` |
| a critical pair between the equation of quotation and dropping and the rewrite of reflected demand | **remains, in a form that joins**: `criticalPair_remains`.  The rewrite of reflected demand is absent; the release of a dropped quotation reads the atom beneath a quotation too |
| an evaluator of the premises that reads how its subject is written | **absent from the candidate**, whose evaluator is fixed and respects the static equivalence, `evaluator_fixed`; **possible for the presentation**, which like every presentation takes any evaluator, `spellingEvaluator_not_respectsStatics_atomsReduce` |
-/

set_option autoImplicit false

namespace Mettapedia.Logic.HostingStyles.AtomsReduce

open Mettapedia.GSLT
open Mettapedia.GSLT.LanguageDef
open Mettapedia.GSLT.LanguageDef.WellSorted
open Mettapedia.GSLT.LanguageDef.EquationSemantics
open Mettapedia.GSLT.LanguageDef.Contexts (contextTheory termSetoid TermStep)
open Mettapedia.OSLF.MeTTaIL.Syntax
open Mettapedia.OSLF.MeTTaIL.Match
open Mettapedia.OSLF.MeTTaIL.ContextualStep
open Mettapedia.Languages.MeTTa
open Mettapedia.Languages.MeTTa.PrimeCandidates.LanguageDef
open Mettapedia.Languages.MeTTa.PrimeComparisons.HostingStyles
open Mettapedia.Logic.HostingStyles.ContextReadings

/-! ## 1. Reduction in a separate sort -/

/-- **Absent.**  In the candidate every rewrite is headed by a constructor of
atoms, constructors take atoms, and there is no sort of processes; in the
probe every rewrite is headed by a constructor of processes and no
constructor takes a process. -/
theorem separateSort_absent :
    (rewritesHeadedIn atomsReduce ["Atom"] = true ∧ takesNoneOf atomsReduce "Atom" = false ∧
      "Process" ∉ atomsReduce.typeNames) ∧
    (rewritesHeadedIn language ["Process"] = true ∧ takesNoneOf language "Process" = true) :=
  ⟨⟨atomsReduce_headedIn_atom, atomsReduce_takes_atoms, by decide⟩,
    language_headedIn_process, language_takesNoneOf_process⟩

/-! ## 2. A sort without a constructor -/

/-- The empty space, as a closed space of the candidate. -/
def emptySpaceTerm : Contexts.Term atomsReduce ⟨.base "Space", []⟩ :=
  ⟨emptySpace, checkOpenPatternWellSorted_sound (by decide +kernel)⟩

/-- **Every sort of the candidate has a closed term.** -/
theorem sorts_inhabited :
    ∀ sort ∈ atomsReduce.typeNames, Nonempty (Contexts.Term atomsReduce ⟨.base sort, []⟩) := by
  intro sort member
  rw [atomsReduce_typeNames] at member
  simp only [List.mem_cons, List.not_mem_nil, or_false] at member
  rcases member with rfl | rfl | rfl
  · exact ⟨unitTerm⟩
  · exact ⟨emptySpaceTerm⟩
  · exact ⟨quoteTerm unitTerm⟩

/-- **Absent.**  The candidate declares no sort of alternatives, and each of
its sorts has a constructor; the probe declares the sort and no constructor
of it. -/
theorem alternatives_absent :
    ("Alternatives" ∉ atomsReduce.typeNames ∧
      (atomsReduce.typeNames.all fun sort =>
        atomsReduce.terms.any fun rule => rule.category == sort) = true) ∧
    ("Alternatives" ∈ language.typeNames ∧
      language.terms.all (fun rule => !(rule.category == "Alternatives")) = true) := by
  decide

/-- **A choice between two results is generated**, by two equations for one
left side stored in a space: one closed atom has two transitions whose
results are apart. -/
theorem nondeterminism_generated :
    ∃ source left right : Contexts.Term atomsReduce closedAtom,
      atomsReduceTheory.rewrites source left ∧ atomsReduceTheory.rewrites source right ∧
        ¬ (atomsReduceTheory.equations closedAtom).r left right :=
  ⟨_, _, _, choice_left, choice_right, choice_apart⟩

/-! ## 3. The sort of spaces without a constructor -/

/-- **Absent.**  The candidate has the empty space and the addition of an
atom to a space; the probe has no constructor of spaces. -/
theorem space_constructed :
    (emptySpaceConstructor ∈ atomsReduce.terms ∧ addAtomConstructor ∈ atomsReduce.terms) ∧
      language.terms.all (fun rule => !(rule.category == "Space")) = true := by
  decide

/-- **A closed run reduces by an equation that its space stores**: the space
is a term, so a request is closed. -/
theorem closed_run_reduces :
    ∃ (rules : List Dedukti.RewriteRule) (source next : LF.Term),
      atomsReduceTheory.rewrites (runTermIn rules source) (runTermIn rules next) ∧
        ∀ target, ¬ atomsReduceTheory.rewrites (runTermIn [] source) target :=
  ⟨choiceRules, choiceQuery, heads, choice_left, fun target =>
    program_normal (rules := []) ⟨fun _ member => absurd member List.not_mem_nil,
      fun _ member => absurd member List.not_mem_nil⟩
      (Dedukti.normal_of_normalTest (programCover []) _ (by decide)) target⟩

/-! ## 4. The critical pair -/

/-- **Remains, in a form that joins.**  The rewrite of reflected demand is
not in the candidate.  The release reads the atom beneath a quotation, and
the equation gives a quotation two spellings: one closed atom has two
transitions whose results are apart, under every evaluator; the second
result has a transition to the first. -/
theorem criticalPair_remains (base : BasePremiseEvaluator) :
    reflectedDemandRewrite.name ∉ atomsReduce.rewrites.map (·.name) ∧
      (∃ source left right : Contexts.Term atomsReduce closedAtom,
        TermStep base atomsReduce source left ∧ TermStep base atomsReduce source right ∧
          ¬ (termSetoid base atomsReduce closedAtom).r left right ∧
            TermStep base atomsReduce right left) :=
  ⟨reflectedDemand_absent.1, droppedUnit, unitTerm, droppedUnit,
    (release_branches base).1, (release_branches base).2.1, (release_branches base).2.2,
    (release_branches base).1⟩

/-! ## 5. An evaluator that reads spelling -/

/-- **Absent from the candidate.**  Its evaluator is the matching evaluator:
it respects the static equivalence of the presentation and answers nothing
where the space stores no atom. -/
theorem evaluator_fixed :
    atomsReduceProbe.evaluator = matchingEvaluator ∧
      RespectsStatics atomsReduceProbe.evaluator atomsReduceProbe.presentation.language ∧
        RulesFromSpace atomsReduceProbe.evaluator :=
  ⟨rfl, atomsReduce_respectsStatics, matchingEvaluator_rulesFromSpace⟩

/-- **Possible for the presentation.**  The generated theory of a
presentation takes any evaluator of its premises; the evaluator that counts
the droppings of its subject answers the run premise of the candidate too,
and does not respect its static equivalence.  What excludes it is the
evaluator that the candidate fixes. -/
theorem spellingEvaluator_not_respectsStatics_atomsReduce :
    ¬ RespectsStatics (spellingEvaluator fanEnumeration.code fanEnumeration.reduct) atomsReduce := by
  intro respects
  have related : BindingsRelated
      (EquationEquiv (spellingEvaluator fanEnumeration.code fanEnumeration.reduct) atomsReduce)
      [("subject", spelledAtom 1 0)] [("subject", spelledAtom 0 0)] :=
    .cons ⟨rfl, atomsReduce_quoteDropOnly.equationEquiv_iff.mpr
      (by rw [contract_spelledAtom, contract_spelledAtom])⟩ .nil
  have answered : [("answer", spelledAtom 0 1), ("subject", spelledAtom 1 0)] ∈
      spellingEvaluator fanEnumeration.code fanEnumeration.reduct atomsReduce
        [("subject", spelledAtom 1 0)] runPremise := by
    show _ ∈ spellingAnswers fanEnumeration.code fanEnumeration.reduct _ (.fvar "subject") "answer"
    rw [spellingAnswers_eq fanEnumeration.injective fanEnumeration.reduct "answer"
      (term := (0 : Nat)) (by simp [applyBindings, contract_spelledAtom]; rfl)]
    have place : drops (applyBindings [("subject", spelledAtom 1 0)] (.fvar "subject")) - 1 = 1 := by
      simp [applyBindings, drops_spelledAtom]
    rw [place]
    refine List.mem_map.mpr ⟨(1 : Nat), ?_, rfl⟩
    show (1 : Nat) ∈ (some (1 : Nat)).toList
    exact List.mem_singleton.mpr rfl
  have premise : runPremise ∈ presentedPremises atomsReduce := by
    show runPremise ∈ atomsReduce.rewrites.flatMap (·.premises) ++
      atomsReduce.equations.flatMap (·.premises)
    rw [atomsReduce_rewrites]
    exact List.mem_append_left _ (List.mem_flatMap.mpr ⟨runRewrite, by simp, by
      show runPremise ∈ [runPremise]
      exact List.mem_singleton.mpr rfl⟩)
  obtain ⟨other, otherAnswered, otherRelated⟩ := respects runPremise premise related _ answered
  have otherAnswers : other ∈ spellingAnswers fanEnumeration.code fanEnumeration.reduct
      [("subject", spelledAtom 0 0)] (.fvar "subject") "answer" := otherAnswered
  rw [spellingAnswers_eq fanEnumeration.injective fanEnumeration.reduct "answer"
    (term := (0 : Nat)) (by simp [applyBindings, contract_spelledAtom]; rfl)] at otherAnswers
  have place : drops (applyBindings [("subject", spelledAtom 0 0)] (.fvar "subject")) - 1 = 0 := by
    simp [applyBindings, drops_spelledAtom]
  rw [place] at otherAnswers
  obtain ⟨next, member, rfl⟩ := List.mem_map.mp otherAnswers
  simp only [fanEnumeration, if_true] at member
  have zero : next = (0 : Nat) := List.mem_singleton.mp member
  cases otherRelated with
  | cons pair _ =>
      have same := (atomsReduce_quoteDropOnly.equiv pair.2).1
      rw [contract_spelledAtom, contract_spelledAtom, zero] at same
      exact absurd (spelledAtom_injective same) (by decide)

