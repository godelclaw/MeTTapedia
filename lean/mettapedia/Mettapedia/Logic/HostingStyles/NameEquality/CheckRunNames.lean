/-! ## The certificate that applies the axiom -/

/-- The table of terms of the control theory as data, written out. -/
theorem withAxiom_table :
    Mettapedia.Languages.MM0.Presentation.ComputationalTyping.encodeTable withAxiom.terms =
      .list [.list [natural 0, .list [.sym "MM0:TermDecl", .list [], natural 0, .list []]]] := by
  simp [withAxiom,
    Mettapedia.Languages.MM0.Presentation.ComputationalTyping.encodeTable,
    Mettapedia.Languages.MM0.Presentation.ComputationalContext.encodeDeclaration,
    Mettapedia.Languages.MM0.Presentation.ComputationalContext.encodeContext,
    Mettapedia.Languages.MM0.Presentation.ComputationalContext.encodeDependencies,
    Mettapedia.Languages.MM0.Presentation.ComputationalContext.encodeNaturals]

/-- The table of terms of the theory without the axiom is the same. -/
theorem withoutAxiom_table :
    Mettapedia.Languages.MM0.Presentation.ComputationalTyping.encodeTable withoutAxiom.terms =
      .list [.list [natural 0, .list [.sym "MM0:TermDecl", .list [], natural 0, .list []]]] := by
  simp [withoutAxiom,
    Mettapedia.Languages.MM0.Presentation.ComputationalTyping.encodeTable,
    Mettapedia.Languages.MM0.Presentation.ComputationalContext.encodeDeclaration,
    Mettapedia.Languages.MM0.Presentation.ComputationalContext.encodeContext,
    Mettapedia.Languages.MM0.Presentation.ComputationalContext.encodeDependencies,
    Mettapedia.Languages.MM0.Presentation.ComputationalContext.encodeNaturals]

