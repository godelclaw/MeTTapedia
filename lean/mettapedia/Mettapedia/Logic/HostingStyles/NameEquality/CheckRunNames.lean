set_option maxRecDepth 100000 in
/-- **Where the steps go**: 1062 steps, of which 73 by rules of equations, 62
by ordered rules, 38 by rules of the shared host, 827 by rules that compare
data, and 62 by the family.  The table begins with 223 rules of equations and
87 ordered rules (`checkNames_partSizes`). -/
theorem checkTraceNames_parts :
    checkTraceNames.length = 1062 ∧
      (checkTraceNames.countP fun step => partOf 223 87 step.2 = .equations) = 73 ∧
      (checkTraceNames.countP fun step => partOf 223 87 step.2 = .ordered) = 62 ∧
      (checkTraceNames.countP fun step => partOf 223 87 step.2 = .sharedHost) = 38 ∧
      (checkTraceNames.countP fun step => partOf 223 87 step.2 = .comparison) = 827 ∧
      (checkTraceNames.countP fun step => partOf 223 87 step.2 = .family) = 62 := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- The refused check: 320 steps, of which seventeen by the family. -/
theorem refusalTraceNames_parts :
    refusalTraceNames.length = 320 ∧
      (refusalTraceNames.countP fun step => partOf 223 87 step.2 = .family) = 17 := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- **Replaying the trace in the table with the family**: 1062 steps take the
check of the certificate that applies the axiom to `True`. -/
theorem checkNames_instance_replays :
    replayNamesCoded checkTableNames checkTraceNames
        (checkCall withAxiom (derivesJ [] [] constant)
          (Mettapedia.Languages.MM0.Presentation.Calculus.Witness.translate withAxiom 1 [] []
            (.theoremApp 0 [] []))) =
      some (verdictTerm true) := by
  rw [checkCall, request, theoryArguments, withAxiom_table]
  decide +kernel

set_option maxRecDepth 100000 in
/-- **Negative**: in the theory without the axiom, 320 steps take the check of
the same certificate to `False`. -/
theorem checkNames_refusal_replays :
    replayNamesCoded checkTableNames refusalTraceNames
        (checkCall withoutAxiom (derivesJ [] [] constant)
          (Mettapedia.Languages.MM0.Presentation.Calculus.Witness.translate withoutAxiom 1 [] []
            (.theoremApp 0 [] []))) =
      some (verdictTerm false) := by
  rw [checkCall, request, theoryArguments, withoutAxiom_table]
  decide +kernel

/-- **A reduction of exactly 1062 steps**, in the theory of the table with the
family, from the check of the certificate to `True`. -/
theorem checkNames_instance_steps :
    StepsIn (withNames checkTableNames) 1062
      (checkCall withAxiom (derivesJ [] [] constant)
        (Mettapedia.Languages.MM0.Presentation.Calculus.Witness.translate withAxiom 1 [] []
          (.theoremApp 0 [] [])))
      (verdictTerm true) := by
  have steps := replayNamesCoded_stepsIn checkNames_stored checkNames_instance_replays
  rwa [checkTraceNames_parts.1] at steps

/-- **The candidate takes exactly 1062 transitions** from the run of the check
to the accepting run, in the space that stores the table and the rules of the
family for the names of the request. -/
theorem checkNames_instance_run_steps :
    atomsReduceTheory.Steps 1062
      (checkRunNames withAxiom (derivesJ [] [] constant)
        (Mettapedia.Languages.MM0.Presentation.Calculus.Witness.translate withAxiom 1 [] []
          (.theoremApp 0 [] [])))
      (verdictRunNames withAxiom (derivesJ [] [] constant)
        (Mettapedia.Languages.MM0.Presentation.Calculus.Witness.translate withAxiom 1 [] []
          (.theoremApp 0 [] [])) true) :=
  localRun_steps checkNames_stores.runnable (namesFor_covers _ _) (namesFor_within _ _)
    checkNames_instance_steps

/-- **Negative**: the candidate takes exactly 320 transitions from the run of
the check without the axiom to the refusing run. -/
theorem checkNames_refusal_run_steps :
    atomsReduceTheory.Steps 320
      (checkRunNames withoutAxiom (derivesJ [] [] constant)
        (Mettapedia.Languages.MM0.Presentation.Calculus.Witness.translate withoutAxiom 1 [] []
          (.theoremApp 0 [] [])))
      (verdictRunNames withoutAxiom (derivesJ [] [] constant)
        (Mettapedia.Languages.MM0.Presentation.Calculus.Witness.translate withoutAxiom 1 [] []
          (.theoremApp 0 [] [])) false) := by
  have steps := replayNamesCoded_stepsIn checkNames_stored checkNames_refusal_replays
  rw [refusalTraceNames_parts.1] at steps
  exact localRun_steps checkNames_stores.runnable (namesFor_covers _ _) (namesFor_within _ _)
    steps

