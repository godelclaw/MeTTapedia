import Mathlib.Data.Finset.Image
import Mathlib.Data.Finset.Lattice.Fold
import Mathlib.Order.MinMax

/-!
# Derived results under dependency sets

A derived result is a claim together with the finite set of dependency atoms it rests on. An
atom is one of five sorts (`DependencySort`):

* a stated **assumption** of the claim;
* a rule of the conversion **profile** the checker used;
* the soundness lane of an **executor** whose run was admitted;
* a **hypothesis** under investigation;
* a **trust** promise accepted without checking.

The meaning is one law (`Sound`): in every world where every atom holds, the claim holds. A result
proved under stated assumptions and a profile, an admitted run, a hypothesized result and a
trusted one are therefore one shape. What tells them apart is which sorts of atoms remain
(`sortsOf`). The sorts present are a union homomorphism of the dependency set, so the kinds can
co-occur: one result can rest both on an executor and on a promise.

## The combination laws are forced

Each law below is derived from `Sound` by evaluating at the generic model, whose worlds are the
sets of atoms that hold (`generic`). A dependency set is sound for a combination in every model in
which the inputs are sound exactly when:

* **for a rule with two premises** (`premises_forced`): it contains the union of the premises'
  sets. A result proved under `A` and one proved under `B` give their conjunction under `A ∪ B`;
* **for alternatives of one claim** (`alternatives_forced`, `alternativesList_forced`): it
  contains the set of one alternative. The sound sets form the up-set generated by the
  alternatives: minimal-witness (positive Boolean) provenance, not lineage. Publishing the
  intersection is unsound unless the two sets are nested (`intersection_sound_iff`);
* **for strength** (`entails_iff`): one set entails another in every model exactly when it is
  contained in it. Fewer atoms is stronger. The order of strength is inclusion of dependency
  sets, a lattice, not a chain.

## What combination cannot do

* **No combination of conditional results is unconditional** (`premises_nonempty`,
  `alternatives_nonempty`, `not_alternatives_unconditional`).
* **A sort present in every input stays** (`premises_keep_sort`, `alternatives_keep_sort`). A
  promise, an executor lane or a hypothesis leaves a combination only when some alternative does
  not rest on it (`alternatives_lose_sort`), that is, when an independent check exists. In
  particular a trusted result never becomes checked, and an admitted run never becomes proved,
  by combining.
* **Dropping an atom is unsound** (`erase_unsound`). Discharge (`Sound.discharge`) replaces an
  atom by the dependencies of a proof of it; it is the only way an atom leaves.
* **No chain readout of the sorts is faithful** (`no_injective_chain_readout`): a readout into a
  linear order that turns union into maximum identifies some two different sets of sorts, so it
  cannot say what a discharge leaves (`Controls.rank_blind_to_second_sort`).
* **A counterexample refutes the dependencies, not the derivation** (`Sound.counterexample`): in a
  world where a sound result's claim fails, some atom fails.

## Controls

* An admitted run without the executor's lane is unsound: a faulty executor answers "even" on 3
  (`Controls.run_without_lane_unsound`); with the lane the result is sound
  (`Controls.run_with_lane_sound`), and the faulty run refutes the lane
  (`Controls.faulty_run_refutes_lane`). A proof of the lane for the verified code discharges it,
  and the run becomes a checked result (`Controls.lane_discharged`).
* A footprint-disjointness promise accepted without checking: the derived claim is sound under the
  promise (`Controls.trusted_sound`) and not without it (`Controls.untrusted_unsound`).
* Two alternatives under `{a}` and `{b}`: either is publishable, their intersection is not
  (`Controls.intersection_of_alternatives_unsound`).
-/

set_option autoImplicit false

namespace Mettapedia.Logic.EvidenceKinds

universe u v w

/-- What a dependency atom stands for. -/
inductive DependencySort where
  /-- A stated premise of the claim. -/
  | assumption
  /-- A rule of the conversion profile the checker used. -/
  | profile
  /-- The soundness lane of an executor whose run was admitted. -/
  | executor
  /-- A conjecture under investigation. -/
  | hypothesis
  /-- A promise accepted without checking. -/
  | trust
  deriving DecidableEq, Repr

/-! ## The meaning of a derived result -/

section Meaning

variable {World : Type v} {Dep : Type u}

/-- **A derived result is sound** for a claim under a dependency set: in every world where every
atom of the set holds, the claim holds. -/
def Sound (holdsAtom : World → Dep → Prop) (claim : World → Prop) (deps : Finset Dep) : Prop :=
  ∀ world, (∀ atom ∈ deps, holdsAtom world atom) → claim world

namespace Sound

variable {holdsAtom : World → Dep → Prop}

/-- **Weakening**: a result sound under a set is sound under every larger set. -/
theorem weaken {claim : World → Prop} {small large : Finset Dep} (sub : small ⊆ large)
    (sound : Sound holdsAtom claim small) : Sound holdsAtom claim large :=
  fun world holds => sound world fun atom member => holds atom (sub member)

/-- A result follows along an implication of claims. -/
theorem mono {claim conclusion : World → Prop} {deps : Finset Dep}
    (implies : ∀ world, claim world → conclusion world) (sound : Sound holdsAtom claim deps) :
    Sound holdsAtom conclusion deps :=
  fun world holds => implies world (sound world holds)

/-- **A rule with two premises**: the conclusion rests on the union of the premises' sets. -/
theorem rule [DecidableEq Dep] {first second conclusion : World → Prop} {firstDeps secondDeps : Finset Dep}
    (step : ∀ world, first world → second world → conclusion world)
    (firstSound : Sound holdsAtom first firstDeps) (secondSound : Sound holdsAtom second secondDeps) :
    Sound holdsAtom conclusion (firstDeps ∪ secondDeps) :=
  fun world holds => step world
    (firstSound world fun atom member => holds atom (Finset.mem_union_left _ member))
    (secondSound world fun atom member => holds atom (Finset.mem_union_right _ member))

/-- **Discharge**: a proof of an atom under other dependencies replaces the atom by them. -/
theorem discharge [DecidableEq Dep] {claim : World → Prop} {atom : Dep} {deps proofDeps : Finset Dep}
    (sound : Sound holdsAtom claim (insert atom deps))
    (proof : Sound holdsAtom (fun world => holdsAtom world atom) proofDeps) :
    Sound holdsAtom claim (deps ∪ proofDeps) := by
  intro world holds
  apply sound world
  intro other member
  rcases Finset.mem_insert.mp member with rfl | inDeps
  · exact proof world fun atom' inProof => holds atom' (Finset.mem_union_right _ inProof)
  · exact holds other (Finset.mem_union_left _ inDeps)

/-- **A counterexample refutes a dependency**: where a sound result's claim fails, some atom of its
set fails. -/
theorem counterexample {claim : World → Prop} {deps : Finset Dep} {world : World}
    (sound : Sound holdsAtom claim deps) (fails : ¬ claim world) :
    ∃ atom ∈ deps, ¬ holdsAtom world atom := by
  by_contra none
  push Not at none
  exact fails (sound world none)

/-- An unconditional result holds in every world. -/
theorem unconditional {claim : World → Prop} (sound : Sound holdsAtom claim ∅) (world : World) :
    claim world :=
  sound world fun _ member => absurd member (Finset.notMem_empty _)

end Sound

end Meaning

/-! ## The generic model -/

section Generic

variable {Dep : Type u}

/-- **The generic model**: a world is the set of atoms that hold in it. -/
def generic (world : Set Dep) (atom : Dep) : Prop := atom ∈ world

/-- The claim that every atom of a set holds. -/
def needs (deps : Finset Dep) (world : Set Dep) : Prop := ↑deps ⊆ world

/-- In the generic model, "every atom of `D` holds" is sound under `E` exactly when `D ⊆ E`. -/
theorem sound_needs_iff {D E : Finset Dep} : Sound generic (needs D) E ↔ D ⊆ E := by
  constructor
  · intro sound
    have := sound (↑E : Set Dep) fun atom member => member
    exact Finset.coe_subset.mp this
  · intro sub world holds atom member
    exact holds atom (sub member)

/-- **One set entails another in every model**: every claim sound under the first is sound under
the second. -/
def Entails (D E : Finset Dep) : Prop :=
  ∀ (World : Type u) (holdsAtom : World → Dep → Prop) (claim : World → Prop),
    Sound holdsAtom claim D → Sound holdsAtom claim E

/-- **The order of strength is inclusion.** -/
theorem entails_iff {D E : Finset Dep} : Entails D E ↔ D ⊆ E := by
  constructor
  · intro entails
    exact sound_needs_iff.mp (entails (Set Dep) generic (needs D) (sound_needs_iff.mpr subset_rfl))
  · intro sub _ _ _ sound
    exact sound.weaken sub

/-- **Dropping an atom is unsound.** -/
theorem erase_unsound [DecidableEq Dep] {atom : Dep} {deps : Finset Dep} (member : atom ∈ deps) :
    ¬ Entails deps (deps.erase atom) := by
  rw [entails_iff]
  intro sub
  exact Finset.notMem_erase atom deps (sub member)

/-- The sets under which the conjunction of two premises is sound in every model where the
premises are sound under `firstDeps` and `secondDeps`. -/
def PremisesSound (firstDeps secondDeps deps : Finset Dep) : Prop :=
  ∀ (World : Type u) (holdsAtom : World → Dep → Prop) (first second : World → Prop),
    Sound holdsAtom first firstDeps → Sound holdsAtom second secondDeps →
      Sound holdsAtom (fun world => first world ∧ second world) deps

/-- **A rule's conclusion needs the union of its premises' sets, and nothing more.** -/
theorem premises_forced [DecidableEq Dep] {firstDeps secondDeps deps : Finset Dep} :
    PremisesSound firstDeps secondDeps deps ↔ firstDeps ∪ secondDeps ⊆ deps := by
  constructor
  · intro forced
    have sound := forced (Set Dep) generic (needs firstDeps) (needs secondDeps)
      (sound_needs_iff.mpr subset_rfl) (sound_needs_iff.mpr subset_rfl)
    have both := sound (↑deps : Set Dep) fun atom member => member
    exact Finset.union_subset (Finset.coe_subset.mp both.1) (Finset.coe_subset.mp both.2)
  · intro sub _ _ first second firstSound secondSound
    exact (Sound.rule (fun _ h₁ h₂ => ⟨h₁, h₂⟩) firstSound secondSound).weaken sub

/-- The sets under which a claim is sound in every model where each listed alternative set is. -/
def AlternativesListSound (alternatives : List (Finset Dep)) (deps : Finset Dep) : Prop :=
  ∀ (World : Type u) (holdsAtom : World → Dep → Prop) (claim : World → Prop),
    (∀ alternative ∈ alternatives, Sound holdsAtom claim alternative) → Sound holdsAtom claim deps

/-- **Alternatives of one claim: a sound set contains one alternative's set.** -/
theorem alternativesList_forced {alternatives : List (Finset Dep)} {deps : Finset Dep} :
    AlternativesListSound alternatives deps ↔ ∃ alternative ∈ alternatives, alternative ⊆ deps := by
  constructor
  · intro forced
    have sound := forced (Set Dep) generic
      (fun world => ∃ alternative ∈ alternatives, needs alternative world)
      (fun alternative member world holds =>
        ⟨alternative, member, fun atom inAlternative => holds atom inAlternative⟩)
    obtain ⟨alternative, member, sub⟩ := sound (↑deps : Set Dep) fun atom member => member
    exact ⟨alternative, member, Finset.coe_subset.mp sub⟩
  · rintro ⟨alternative, member, sub⟩ _ _ _ sounds
    exact (sounds alternative member).weaken sub

/-- The binary case. -/
def AlternativesSound (firstDeps secondDeps deps : Finset Dep) : Prop :=
  ∀ (World : Type u) (holdsAtom : World → Dep → Prop) (claim : World → Prop),
    Sound holdsAtom claim firstDeps → Sound holdsAtom claim secondDeps → Sound holdsAtom claim deps

theorem alternativesSound_iff_list {firstDeps secondDeps deps : Finset Dep} :
    AlternativesSound firstDeps secondDeps deps ↔ AlternativesListSound [firstDeps, secondDeps] deps := by
  constructor
  · intro forced World holdsAtom claim sounds
    exact forced World holdsAtom claim (sounds _ (by simp)) (sounds _ (by simp))
  · intro forced World holdsAtom claim first second
    exact forced World holdsAtom claim fun alternative member => by
      simp only [List.mem_cons, List.not_mem_nil, or_false] at member
      rcases member with rfl | rfl
      · exact first
      · exact second

/-- **Two alternatives of one claim: a sound set contains one of them.** -/
theorem alternatives_forced {firstDeps secondDeps deps : Finset Dep} :
    AlternativesSound firstDeps secondDeps deps ↔ firstDeps ⊆ deps ∨ secondDeps ⊆ deps := by
  rw [alternativesSound_iff_list, alternativesList_forced]
  simp

/-- **Publishing the intersection of two alternatives is sound exactly when they are nested.** -/
theorem intersection_sound_iff [DecidableEq Dep] {firstDeps secondDeps : Finset Dep} :
    AlternativesSound firstDeps secondDeps (firstDeps ∩ secondDeps) ↔
      firstDeps ⊆ secondDeps ∨ secondDeps ⊆ firstDeps := by
  rw [alternatives_forced, Finset.subset_inter_iff, Finset.subset_inter_iff]
  simp

/-! ### No combination of conditional results is unconditional -/

theorem premises_nonempty [DecidableEq Dep] {firstDeps secondDeps deps : Finset Dep}
    (forced : PremisesSound firstDeps secondDeps deps) (nonempty : firstDeps.Nonempty) :
    deps.Nonempty :=
  (nonempty.mono Finset.subset_union_left).mono (premises_forced.mp forced)

theorem alternatives_nonempty {firstDeps secondDeps deps : Finset Dep}
    (forced : AlternativesSound firstDeps secondDeps deps) (firstNonempty : firstDeps.Nonempty)
    (secondNonempty : secondDeps.Nonempty) : deps.Nonempty := by
  rcases alternatives_forced.mp forced with sub | sub
  · exact firstNonempty.mono sub
  · exact secondNonempty.mono sub

/-- **Two conditional proofs of one claim do not make an unconditional one.** -/
theorem not_alternatives_unconditional {firstDeps secondDeps : Finset Dep}
    (firstNonempty : firstDeps.Nonempty) (secondNonempty : secondDeps.Nonempty) :
    ¬ AlternativesSound firstDeps secondDeps ∅ := fun forced =>
  Finset.not_nonempty_empty (alternatives_nonempty forced firstNonempty secondNonempty)

end Generic

/-! ## Sorts: what a result rests on -/

section Sorts

variable {Dep : Type u} (sort : Dep → DependencySort)

/-- The sorts of the atoms a result rests on. -/
def sortsOf (deps : Finset Dep) : Finset DependencySort := deps.image sort

/-- **The sorts present are a union homomorphism.** -/
theorem sortsOf_union [DecidableEq Dep] (first second : Finset Dep) :
    sortsOf sort (first ∪ second) = sortsOf sort first ∪ sortsOf sort second :=
  Finset.image_union _ _

theorem sortsOf_mono {first second : Finset Dep} (sub : first ⊆ second) :
    sortsOf sort first ⊆ sortsOf sort second :=
  Finset.image_subset_image sub

/-- A result rests on a sort when some atom of that sort remains in its set. -/
def RestsOn (s : DependencySort) (deps : Finset Dep) : Prop := s ∈ sortsOf sort deps

instance (s : DependencySort) (deps : Finset Dep) : Decidable (RestsOn sort s deps) := by
  unfold RestsOn
  infer_instance

/-- **Checked**: the result rests only on stated assumptions and profile rules, not on a run, a
hypothesis or a promise. -/
def Checked (deps : Finset Dep) : Prop :=
  ¬ RestsOn sort .executor deps ∧ ¬ RestsOn sort .hypothesis deps ∧ ¬ RestsOn sort .trust deps

instance (deps : Finset Dep) : Decidable (Checked sort deps) := by
  unfold Checked
  infer_instance

variable {sort}

/-- **A sort of a premise stays in the conclusion.** -/
theorem premises_keep_sort [DecidableEq Dep] {firstDeps secondDeps deps : Finset Dep}
    {s : DependencySort} (forced : PremisesSound firstDeps secondDeps deps)
    (rests : RestsOn sort s firstDeps) : RestsOn sort s deps :=
  sortsOf_mono sort (Finset.subset_union_left.trans (premises_forced.mp forced)) rests

/-- **A sort shared by every alternative stays.** -/
theorem alternatives_keep_sort {firstDeps secondDeps deps : Finset Dep} {s : DependencySort}
    (forced : AlternativesSound firstDeps secondDeps deps) (firstRests : RestsOn sort s firstDeps)
    (secondRests : RestsOn sort s secondDeps) : RestsOn sort s deps := by
  rcases alternatives_forced.mp forced with sub | sub
  · exact sortsOf_mono sort sub firstRests
  · exact sortsOf_mono sort sub secondRests

/-- **Only an alternative without a sort removes it**: an independent check. -/
theorem alternatives_lose_sort {firstDeps secondDeps deps : Finset Dep} {s : DependencySort}
    (forced : AlternativesSound firstDeps secondDeps deps) (lost : ¬ RestsOn sort s deps) :
    ¬ RestsOn sort s firstDeps ∨ ¬ RestsOn sort s secondDeps := by
  by_contra both
  push Not at both
  exact lost (alternatives_keep_sort forced both.1 both.2)

/-- **A trusted result never becomes checked by combination.** -/
theorem trusted_premise_not_checked [DecidableEq Dep] {firstDeps secondDeps deps : Finset Dep}
    (forced : PremisesSound firstDeps secondDeps deps) (trusted : RestsOn sort .trust firstDeps) :
    ¬ Checked sort deps :=
  fun checked => checked.2.2 (premises_keep_sort forced trusted)

/-- **An admitted run never becomes proved by combination with other runs.** -/
theorem runs_not_checked {firstDeps secondDeps deps : Finset Dep}
    (forced : AlternativesSound firstDeps secondDeps deps)
    (firstRun : RestsOn sort .executor firstDeps) (secondRun : RestsOn sort .executor secondDeps) :
    ¬ Checked sort deps :=
  fun checked => checked.1 (alternatives_keep_sort forced firstRun secondRun)

/-- **No chain readout of the sorts is faithful.** A readout into a linear order that turns union
into maximum identifies two different sets of sorts. -/
theorem no_injective_chain_readout {L : Type w} [LinearOrder L] (readout : Finset DependencySort → L)
    (union : ∀ first second, readout (first ∪ second) = max (readout first) (readout second)) :
    ¬ Function.Injective readout := by
  intro injective
  have pair : ({DependencySort.assumption, DependencySort.trust} : Finset DependencySort) =
      {DependencySort.assumption} ∪ {DependencySort.trust} := rfl
  rcases max_choice (readout {DependencySort.assumption}) (readout {DependencySort.trust}) with
    same | same
  · have := injective ((union _ _).trans same)
    rw [← pair] at this
    exact absurd this (by decide)
  · have := injective ((union _ _).trans same)
    rw [← pair] at this
    exact absurd this (by decide)

end Sorts

/-! ## Controls -/

namespace Controls

/-- The atoms of the examples. -/
inductive Atom where
  /-- The executor computes parity correctly. -/
  | parityLane
  /-- The run's record: on its input the executor answered "even". -/
  | saidEven
  /-- The promise that two footprints are disjoint. -/
  | disjointPromise
  /-- The executor that ran is the verified parity code. -/
  | verifiedCode
  | a
  | b
  deriving DecidableEq, Repr

/-- The sorts of the example atoms. -/
def Atom.sort : Atom → DependencySort
  | .parityLane => .executor
  | .saidEven => .assumption
  | .disjointPromise => .trust
  | .verifiedCode => .assumption
  | .a => .assumption
  | .b => .assumption

/-! ### An admitted run needs the executor's lane -/

/-- A world of the run: the executor and its input. -/
abbrev RunWorld := (ℕ → Bool) × ℕ

/-- What the run atoms mean. -/
def runHolds (world : RunWorld) : Atom → Prop
  | .parityLane => ∀ n, world.1 n = decide (n % 2 = 0)
  | .saidEven => world.1 world.2 = true
  | .verifiedCode => world.1 = fun n => decide (n % 2 = 0)
  | _ => True

/-- The claim the run is admitted for: its input is even. -/
def inputEven (world : RunWorld) : Prop := world.2 % 2 = 0

/-- **With the lane, the admitted run is sound.** -/
theorem run_with_lane_sound : Sound runHolds inputEven {.saidEven, .parityLane} := by
  intro world holds
  have lane : ∀ n, world.1 n = decide (n % 2 = 0) := holds .parityLane (by simp)
  have said : world.1 world.2 = true := holds .saidEven (by simp)
  rw [lane] at said
  show world.2 % 2 = 0
  exact of_decide_eq_true said

/-- An executor that answers "even" on every input. -/
def alwaysEven : ℕ → Bool := fun _ => true

/-- **Without the lane, the admitted run is unsound**: the faulty executor answers "even" on 3. -/
theorem run_without_lane_unsound : ¬ Sound runHolds inputEven {.saidEven} := by
  intro sound
  have := sound (alwaysEven, 3) fun atom member => by
    simp only [Finset.mem_singleton] at member
    subst member
    rfl
  exact absurd this (by unfold inputEven; decide)

/-- **The faulty run refutes the lane**: at the faulty world, the atom that fails is the lane. -/
theorem faulty_run_refutes_lane :
    ∃ atom ∈ ({.saidEven, .parityLane} : Finset Atom), ¬ runHolds (alwaysEven, 3) atom :=
  run_with_lane_sound.counterexample (by unfold inputEven; decide)

/-- The run rests on an executor, so it is not checked; erasing the lane is not an entailment. -/
theorem run_not_checked : ¬ Checked Atom.sort {.saidEven, .parityLane} := by
  intro checked
  exact checked.1 (by decide)

theorem lane_not_droppable : ¬ Entails ({.saidEven, .parityLane} : Finset Atom)
    (({.saidEven, .parityLane} : Finset Atom).erase .parityLane) :=
  erase_unsound (by simp)

/-- The lane is proved for the verified code. -/
theorem lane_of_verifiedCode :
    Sound runHolds (fun world => runHolds world .parityLane) {.verifiedCode} := by
  intro world holds n
  have code : world.1 = fun n => decide (n % 2 = 0) := holds .verifiedCode (by simp)
  rw [code]

/-- **Discharging the lane**: once the lane is proved for the verified code, the admitted run rests
on the run's record and the identity of the code, and it is checked. -/
theorem lane_discharged :
    Sound runHolds inputEven ({.saidEven} ∪ {.verifiedCode}) ∧
      Checked Atom.sort ({.saidEven} ∪ {.verifiedCode} : Finset Atom) := by
  refine ⟨?_, by decide⟩
  have withLane : Sound runHolds inputEven (insert .parityLane {.saidEven}) := by
    have same : (insert Atom.parityLane {Atom.saidEven} : Finset Atom) = {.saidEven, .parityLane} := by
      decide
    rw [same]
    exact run_with_lane_sound
  exact withLane.discharge lane_of_verifiedCode

/-! ### A trusted promise -/

/-- A world of the promise: the two footprints of a batch. -/
abbrev FootprintWorld := Finset ℕ × Finset ℕ

def promiseHolds (world : FootprintWorld) : Atom → Prop
  | .disjointPromise => Disjoint world.1 world.2
  | _ => True

/-- The claim derived from the promise: the footprints share no location. -/
def noSharedLocation (world : FootprintWorld) : Prop := world.1 ∩ world.2 = ∅

theorem trusted_sound : Sound promiseHolds noSharedLocation {.disjointPromise} := by
  intro world holds
  exact Finset.disjoint_iff_inter_eq_empty.mp (holds .disjointPromise (by simp))

theorem untrusted_unsound : ¬ Sound promiseHolds noSharedLocation ∅ := by
  intro sound
  have := sound.unconditional ({0}, {0})
  exact absurd this (by unfold noSharedLocation; decide)

theorem trusted_not_checked : ¬ Checked Atom.sort {.disjointPromise} :=
  fun checked => checked.2.2 (by decide)

/-! ### Alternatives and their intersection -/

/-- **Either alternative is publishable; their intersection is not.** -/
theorem intersection_of_alternatives_unsound :
    AlternativesSound ({.a} : Finset Atom) {.b} {.a} ∧ AlternativesSound ({.a} : Finset Atom) {.b} {.b} ∧
      ¬ AlternativesSound ({.a} : Finset Atom) {.b} ({.a} ∩ {.b}) := by
  refine ⟨alternatives_forced.mpr (Or.inl subset_rfl), alternatives_forced.mpr (Or.inr subset_rfl), ?_⟩
  rw [intersection_sound_iff]
  decide

/-- **The conjunction of results under `{a}` and `{b}` rests on `{a, b}`, and on no less.** -/
theorem conjunction_needs_both :
    PremisesSound ({.a} : Finset Atom) {.b} {.a, .b} ∧ ¬ PremisesSound ({.a} : Finset Atom) {.b} {.a} := by
  refine ⟨premises_forced.mpr (by decide), fun forced => ?_⟩
  have := premises_forced.mp forced
  exact absurd this (by decide)

/-! ### A chain readout cannot say what a discharge leaves -/

/-- A ranking of the sorts, weakest last. -/
def rank : DependencySort → ℕ
  | .assumption => 0
  | .profile => 1
  | .executor => 2
  | .hypothesis => 3
  | .trust => 4

/-- The rank of a set of sorts: its weakest member. -/
def rankOf (sorts : Finset DependencySort) : ℕ := sorts.sup rank

/-- **The rank is blind to a second sort.** `{promise}` and `{promise, lane}` have the same rank;
discharging the promise leaves nothing in one and an executor lane in the other. -/
theorem rank_blind_to_second_sort :
    rankOf (sortsOf Atom.sort {.disjointPromise}) = rankOf (sortsOf Atom.sort {.disjointPromise, .parityLane}) ∧
      sortsOf Atom.sort (({.disjointPromise} : Finset Atom).erase .disjointPromise) = ∅ ∧
      sortsOf Atom.sort (({.disjointPromise, .parityLane} : Finset Atom).erase .disjointPromise) = {.executor} := by
  decide

/-- **Entails, positive**: a result resting on `a` alone entails it resting on `a` and `b`; fewer
atoms is the stronger result. (`lane_not_droppable` is the negative control.) -/
theorem fewer_atoms_entail : Entails ({.a} : Finset Atom) {.a, .b} :=
  entails_iff.mpr (by decide)

/-- **Rests on, positive and negative**: the disjointness promise rests on trust; the parity run's
record and lane rest on assumption and executor, not on trust. -/
theorem promise_rests_on_trust :
    RestsOn Atom.sort .trust ({.disjointPromise} : Finset Atom) ∧
      ¬ RestsOn Atom.sort .trust ({.saidEven, .parityLane} : Finset Atom) := by
  decide

/-- **The generic model, positive and negative**: atom `a` holds in the world `{a}` and not in the
empty world. -/
theorem generic_controls : generic ({.a} : Set Atom) .a ∧ ¬ generic (∅ : Set Atom) .a := by
  simp [generic]

/-- **Needs, positive and negative**: the world `{a, b}` has every atom of `{a}`; the world `{a}`
lacks `b`. -/
theorem needs_controls :
    needs ({.a} : Finset Atom) {.a, .b} ∧ ¬ needs ({.a, .b} : Finset Atom) {.a} := by
  simp [needs]

end Controls

end Mettapedia.Logic.EvidenceKinds
