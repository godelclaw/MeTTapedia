    Mettapedia.Languages.HOLLight.ExactFormulaReadback.Controls.verdicts ++
    Mettapedia.Languages.HOLLight.RetainedAssemblyControls.verdicts ++
    Mettapedia.Languages.HOLLight.IndexedConstructorDefinitions.Controls.verdicts ++
    Mettapedia.Languages.HOLLight.RecursiveSpaceTypeInstantiation.Controls.verdicts ++
    Mettapedia.GSLT.LanguageDef.PositiveInductiveVectorTreeGuest.ResultFold.verdicts ++
    [("ordered inductive traversal retains complete payloads",
      Mettapedia.Languages.MeTTa.PeTTa.Bridges.IndexedContainerTraversal.Controls.modelChecks),
     ("compiled nested SearchTree fold retains complete answers",
      Mettapedia.Languages.MeTTa.PeTTa.Bridges.IndexedContainerTraversal.Folding.modelChecks),
     ("formed List and Vector bundles retain actual position witnesses",
      Mettapedia.Languages.MeTTa.Bridges.GSLT.FormationSensitiveBundleTraversal.modelChecks)] ++
    Mettapedia.GSLT.Logic.PropositionalLRAT.Controls.verdicts ++
    equationChecks ++ recipeChecks ++ hilbertChecks ++ hintChecks ++ refusalChecks ++ equalityChecks ++
    extensionChecks ++ intuitionisticChecks ++
    Mettapedia.Languages.VibeITP.CheckingMachine.CursorControls.verdicts ++
    Mettapedia.GSLT.KripkeTruth.Checking.Controls.verdicts ++
    [("sharing level three", Mettapedia.OSLF.NativeTypes.Certificates.Shared.checkJudgments
      (ProofSharingBounds.certificate 3) 3),
     ("sharing wrong level", !(Mettapedia.OSLF.NativeTypes.Certificates.Shared.checkJudgments
      (ProofSharingBounds.certificate 3) 4))]

end Mettapedia.Logic.CheckNativeInference

def main : IO UInt32 := do
  let checks := Mettapedia.Logic.CheckNativeInference.checks
  let mut failed := 0
  for (label, passed) in checks do
    unless passed do
      IO.eprintln s!"FAIL {label}"
      failed := failed + 1
  IO.println s!"Native inference integration: {checks.length - failed}/{checks.length} controls passed"
  return if failed = 0 then 0 else 1
