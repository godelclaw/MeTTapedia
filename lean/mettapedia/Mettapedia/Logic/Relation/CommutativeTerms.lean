import Mettapedia.Logic.Relation.NormalFormDecision
import Mathlib.Data.Nat.Pairing

/-!
# Commutativity: what decides it, and what cannot

Terms built from variables and one binary operator (`Bin`), and the
congruence generated by commutativity (`CommEq`).  Three ways to decide it,
compared on the same equation.

* **No equivariant rewrite relation decides it by normal forms**
  (`not_decidedOn_of_equivariant`).  A relation whose steps are carried to
  steps by the exchange of two variables (every relation given by rule
  schemas is), whose steps are commutativity steps, and whose conversion
  relates `x ∘ y` with `y ∘ x`, is decided by normal forms on no set
  containing those two terms: the class of `x ∘ y` is `{x ∘ y, y ∘ x}`
  (`commEq_op_vars`), the exchange preserves it, and neither member is fixed
  by it.
* **Ordered rewriting decides it by normal forms** (`orderedStep_decidedOn`,
  `orderedStep_conv_iff`).  Orient `a ∘ b ↦ b ∘ a` only when the code of `b`
  is smaller than that of `a` (a fixed numbering of terms, `encode`).  This
  relation normalizes every term to its sorted form, and its conversion is
  commutativity.  It is not equivariant (`orderedStep_not_equivariant`): it
  orients `x₁ ∘ x₀` and not `x₀ ∘ x₁`, so it is no rule schema.  The
  obstruction is exactly equivariance.
* **Comparison up to commutativity decides it with equivariant data**
  (`commEq_iff_sortForm_eq`, `decidedModuloOn_commEq`): with no rule and
  commutativity built into the comparison, every term is its own normal form
  and two terms are convertible exactly when they are equal up to
  commutativity, which the sorted form decides.  This is rewriting modulo
  commutativity (Peterson and Stickel 1981; Jouannaud and Kirchner 1986),
  with the empty rule set.

A checker that compares normal forms syntactically, with rules given by
schemas, is the first route; the λΠ-calculus modulo rewriting with
commutative symbols built into matching and comparison is the third; a
translation that encodes variables as closed codes, so that sorting them is
an ordinary computation, is the second.
-/

set_option autoImplicit false

namespace Mettapedia.Logic.Relation.CommutativeTerms

open _root_.Relation
open Mettapedia.Logic.Relation (IsNormal IsNormalFormOf DecidedOn DecidedModuloOn
  WeaklyNormalizingOn UniqueNormalFormsOn decidedOn_iff_uniqueNormalForms)

/-- Terms built from variables and one binary operator. -/
inductive Bin where
  | var : Nat → Bin
  | op : Bin → Bin → Bin
  deriving DecidableEq

open Bin

/-- Rename the variables. -/
def rename (f : Nat → Nat) : Bin → Bin
  | var n => var (f n)
  | op a b => op (rename f a) (rename f b)

/-- Exchange the variables `0` and `1`. -/
def swap01 (term : Bin) : Bin := rename (fun n => if n = 0 then 1 else if n = 1 then 0 else n) term

theorem swap01_swap01 (term : Bin) : swap01 (swap01 term) = term := by
  induction term with
  | var n =>
      by_cases zero : n = 0
      · subst zero; rfl
      · by_cases one : n = 1
        · subst one; rfl
        · simp [swap01, rename, zero, one]
  | op a b iha ihb =>
      simp only [swap01, rename] at iha ihb ⊢
      rw [iha, ihb]

/-- One commutativity step, at any position. -/
inductive CommStep : Bin → Bin → Prop where
  | root (a b : Bin) : CommStep (op a b) (op b a)
  | left {a a' : Bin} (b : Bin) : CommStep a a' → CommStep (op a b) (op a' b)
  | right (a : Bin) {b b' : Bin} : CommStep b b' → CommStep (op a b) (op a b')

/-- The commutativity congruence. -/
abbrev CommEq : Bin → Bin → Prop := EqvGen CommStep

/-! ## Codes and the sorted form -/

/-- An injective numbering of terms. -/
def encode : Bin → Nat
  | var n => 2 * n
  | op a b => 2 * Nat.pair (encode a) (encode b) + 1

theorem encode_injective : Function.Injective encode := by
  intro first
  induction first with
  | var n =>
      intro second same
      cases second with
      | var m => simp only [encode] at same; congr 1; omega
      | op a b => simp only [encode] at same; omega
  | op a b iha ihb =>
      intro second same
      cases second with
      | var m => simp only [encode] at same; omega
      | op c d =>
          simp only [encode] at same
          have paired : Nat.pair (encode a) (encode b) = Nat.pair (encode c) (encode d) := by omega
          obtain ⟨left, right⟩ := Nat.pair_eq_pair.mp paired
          rw [iha left, ihb right]

/-- Put two terms in the order of their codes. -/
def ordered (a b : Bin) : Bin := if encode b < encode a then op b a else op a b

theorem ordered_comm (a b : Bin) : ordered a b = ordered b a := by
  unfold ordered
  by_cases lt : encode b < encode a
  · have notLt : ¬ encode a < encode b := by omega
    simp [lt, notLt]
  · by_cases gt : encode a < encode b
    · simp [lt, gt]
    · have same : encode a = encode b := by omega
      have equal := encode_injective same
      subst equal
      rfl

/-- **The sorted form**: order the arguments of every operator by their
codes, bottom up. -/
def sortForm : Bin → Bin
  | var n => var n
  | op a b => ordered (sortForm a) (sortForm b)

theorem commStep_sortForm {a b : Bin} (step : CommStep a b) : sortForm a = sortForm b := by
  induction step with
  | root a b => exact ordered_comm _ _
  | left b _ ih => simp only [sortForm, ih]
  | right a _ ih => simp only [sortForm, ih]

theorem commEq_op (a b : Bin) : CommEq (op a b) (op b a) := EqvGen.rel _ _ (.root a b)

theorem commEq_congr {a a' b b' : Bin} (left : CommEq a a') (right : CommEq b b') :
    CommEq (op a b) (op a' b') := by
  have inLeft : ∀ {x x' : Bin} (y : Bin), CommEq x x' → CommEq (op x y) (op x' y) := by
    intro x x' y converted
    induction converted with
    | rel _ _ step => exact EqvGen.rel _ _ (.left y step)
    | refl => exact EqvGen.refl _
    | symm _ _ _ ih => exact EqvGen.symm _ _ ih
    | trans _ _ _ _ _ first second => exact EqvGen.trans _ _ _ first second
  have inRight : ∀ (x : Bin) {y y' : Bin}, CommEq y y' → CommEq (op x y) (op x y') := by
    intro x y y' converted
    induction converted with
    | rel _ _ step => exact EqvGen.rel _ _ (.right x step)
    | refl => exact EqvGen.refl _
    | symm _ _ _ ih => exact EqvGen.symm _ _ ih
    | trans _ _ _ _ _ first second => exact EqvGen.trans _ _ _ first second
  exact EqvGen.trans _ _ _ (inLeft b left) (inRight a' right)

theorem commEq_sortForm (term : Bin) : CommEq term (sortForm term) := by
  induction term with
  | var n => exact EqvGen.refl _
  | op a b iha ihb =>
      have inner := commEq_congr iha ihb
      unfold sortForm ordered
      split
      · exact EqvGen.trans _ _ _ inner (commEq_op _ _)
      · exact inner

/-- **Commutativity is decided by the sorted form.** -/
theorem commEq_iff_sortForm_eq {a b : Bin} : CommEq a b ↔ sortForm a = sortForm b := by
  constructor
  · intro converted
    induction converted with
    | rel _ _ step => exact commStep_sortForm step
    | refl => rfl
    | symm _ _ _ ih => exact ih.symm
    | trans _ _ _ _ _ first second => exact first.trans second
  · intro same
    exact EqvGen.trans _ _ _ (commEq_sortForm a)
      (EqvGen.symm _ _ (same ▸ commEq_sortForm b))

instance : DecidableRel CommEq := fun a b =>
  decidable_of_iff (sortForm a = sortForm b) commEq_iff_sortForm_eq.symm

/-! ## No equivariant rewrite relation decides it -/

theorem sortForm_eq_var_iff {term : Bin} {n : Nat} : sortForm term = var n ↔ term = var n := by
  cases term with
  | var m => simp [sortForm]
  | op a b =>
      simp only [sortForm, ordered]
      split <;> simp

/-- **The class of `x₀ ∘ x₁` is `{x₀ ∘ x₁, x₁ ∘ x₀}`.** -/
theorem commEq_op_vars {other : Bin} (converted : CommEq (op (var 0) (var 1)) other) :
    other = op (var 0) (var 1) ∨ other = op (var 1) (var 0) := by
  have same := (commEq_iff_sortForm_eq.mp converted).symm
  have code : encode (var 0) < encode (var 1) := by simp [encode]
  have target : sortForm (op (var 0) (var 1)) = op (var 0) (var 1) := by
    simp [sortForm, ordered, encode]
  rw [target] at same
  cases other with
  | var n => simp [sortForm] at same
  | op a b =>
      simp only [sortForm, ordered] at same
      split at same
      · simp only [op.injEq] at same
        obtain ⟨first, second⟩ := same
        rw [sortForm_eq_var_iff] at first second
        subst first second
        exact Or.inr rfl
      · simp only [op.injEq] at same
        obtain ⟨first, second⟩ := same
        rw [sortForm_eq_var_iff] at first second
        subst first second
        exact Or.inl rfl

/-- **No equivariant rewrite relation whose steps are commutativity steps and
whose conversion relates `x₀ ∘ x₁` with `x₁ ∘ x₀` decides its conversion by
normal forms on a set containing both.** -/
theorem not_decidedOn_of_equivariant {r : Bin → Bin → Prop}
    (equivariant : ∀ a b, r a b → r (swap01 a) (swap01 b)) (sound : ∀ a b, r a b → CommEq a b)
    (commutes : EqvGen r (op (var 0) (var 1)) (op (var 1) (var 0))) {S : Set Bin}
    (first : op (var 0) (var 1) ∈ S) (second : op (var 1) (var 0) ∈ S) : ¬ DecidedOn r S := by
  have soundConv : ∀ {a b : Bin}, EqvGen r a b → CommEq a b := by
    intro a b converted
    induction converted with
    | rel _ _ step => exact sound _ _ step
    | refl => exact EqvGen.refl _
    | symm _ _ _ ih => exact EqvGen.symm _ _ ih
    | trans _ _ _ _ _ ihFirst ihSecond => exact EqvGen.trans _ _ _ ihFirst ihSecond
  refine Mettapedia.Logic.Relation.not_decidedOn_of_symmetric_class (π := swap01) (σ := swap01)
    swap01_swap01 equivariant equivariant first (by simpa [swap01, rename] using second)
    (by simpa [swap01, rename] using EqvGen.symm _ _ commutes) ?_
  intro other converted fixed
  rcases commEq_op_vars (soundConv converted) with rfl | rfl <;> simp [swap01, rename] at fixed

/-- The rewrite relation of all commutativity steps is equivariant. -/
theorem commStep_equivariant (a b : Bin) (step : CommStep a b) : CommStep (swap01 a) (swap01 b) := by
  induction step with
  | root a b => exact .root _ _
  | left b _ ih => exact .left _ ih
  | right a _ ih => exact .right _ ih

theorem commStep_sound (a b : Bin) (step : CommStep a b) : CommEq a b := EqvGen.rel _ _ step

/-- **The relation of all commutativity steps is not decided by normal
forms.** -/
theorem commStep_not_decidedOn :
    ¬ DecidedOn CommStep {op (var 0) (var 1), op (var 1) (var 0)} :=
  not_decidedOn_of_equivariant commStep_equivariant commStep_sound (commEq_op _ _) (Or.inl rfl)
    (Or.inr rfl)

/-! ## Ordered rewriting decides it -/

/-- **Ordered commutation**: swap the arguments of an operator, at any
position, when the code of the second is smaller. -/
inductive OrderedStep : Bin → Bin → Prop where
  | root {a b : Bin} : encode b < encode a → OrderedStep (op a b) (op b a)
  | left {a a' : Bin} (b : Bin) : OrderedStep a a' → OrderedStep (op a b) (op a' b)
  | right (a : Bin) {b b' : Bin} : OrderedStep b b' → OrderedStep (op a b) (op a b')

theorem orderedStep_commStep {a b : Bin} (step : OrderedStep a b) : CommStep a b := by
  induction step with
  | root _ => exact .root _ _
  | left b _ ih => exact .left b ih
  | right a _ ih => exact .right a ih

theorem reduces_left {a a' : Bin} (b : Bin) (steps : ReflTransGen OrderedStep a a') :
    ReflTransGen OrderedStep (op a b) (op a' b) := by
  induction steps with
  | refl => exact .refl
  | tail _ step ih => exact ih.tail (.left b step)

theorem reduces_right (a : Bin) {b b' : Bin} (steps : ReflTransGen OrderedStep b b') :
    ReflTransGen OrderedStep (op a b) (op a b') := by
  induction steps with
  | refl => exact .refl
  | tail _ step ih => exact ih.tail (.right a step)

/-- Every term reduces to its sorted form. -/
theorem reduces_sortForm (term : Bin) : ReflTransGen OrderedStep term (sortForm term) := by
  induction term with
  | var n => exact .refl
  | op a b iha ihb =>
      have inner := (reduces_left b iha).trans (reduces_right (sortForm a) ihb)
      unfold sortForm ordered
      split
      · rename_i lt
        exact inner.tail (.root lt)
      · exact inner

/-- A normal term is its sorted form. -/
theorem sortForm_of_normal {term : Bin} (normal : IsNormal OrderedStep term) :
    sortForm term = term := by
  induction term with
  | var n => rfl
  | op a b iha ihb =>
      have normalA : IsNormal OrderedStep a := fun a' step => normal _ (.left b step)
      have normalB : IsNormal OrderedStep b := fun b' step => normal _ (.right a step)
      have notLt : ¬ encode b < encode a := fun lt => normal _ (.root lt)
      simp only [sortForm, iha normalA, ihb normalB, ordered, notLt, if_false]

/-- The sorted form is normal. -/
theorem sortForm_normal (term : Bin) : IsNormal OrderedStep (sortForm term) := by
  induction term with
  | var n => intro target step; cases step
  | op a b iha ihb =>
      intro target step
      unfold sortForm ordered at step
      split at step
      · rename_i lt
        cases step with
        | root lt' => omega
        | left _ inner => exact ihb _ inner
        | right _ inner => exact iha _ inner
      · rename_i notLt
        cases step with
        | root lt' => exact notLt lt'
        | left _ inner => exact iha _ inner
        | right _ inner => exact ihb _ inner

theorem orderedStep_conv_commEq {a b : Bin} (converted : EqvGen OrderedStep a b) : CommEq a b := by
  induction converted with
  | rel _ _ step => exact EqvGen.rel _ _ (orderedStep_commStep step)
  | refl => exact EqvGen.refl _
  | symm _ _ _ ih => exact EqvGen.symm _ _ ih
  | trans _ _ _ _ _ first second => exact EqvGen.trans _ _ _ first second

/-- **The conversion of ordered commutation is commutativity.** -/
theorem orderedStep_conv_iff {a b : Bin} : EqvGen OrderedStep a b ↔ CommEq a b := by
  refine ⟨orderedStep_conv_commEq, fun converted => ?_⟩
  have same := commEq_iff_sortForm_eq.mp converted
  exact EqvGen.trans _ _ _ (EqvGen.reflTransGen_le_eqvGen _ _ _ (reduces_sortForm a))
    (same ▸ EqvGen.symm _ _ (EqvGen.reflTransGen_le_eqvGen _ _ _ (reduces_sortForm b)))

/-- **Ordered commutation decides commutativity by normal forms, on every
term.** -/
theorem orderedStep_decidedOn : DecidedOn OrderedStep Set.univ := by
  refine decidedOn_iff_uniqueNormalForms.mpr ⟨fun term _ => ⟨sortForm term,
    reduces_sortForm term, sortForm_normal term⟩, ?_⟩
  intro _ _ _ _ n m normalN normalM converted
  have same := commEq_iff_sortForm_eq.mp (orderedStep_conv_commEq converted)
  rw [sortForm_of_normal normalN.2, sortForm_of_normal normalM.2] at same
  exact same

/-- **Ordered commutation is not equivariant**: it orients `x₁ ∘ x₀` and not
its exchange `x₀ ∘ x₁`. -/
theorem orderedStep_not_equivariant :
    OrderedStep (op (var 1) (var 0)) (op (var 0) (var 1)) ∧
      ¬ OrderedStep (swap01 (op (var 1) (var 0))) (swap01 (op (var 0) (var 1))) := by
  refine ⟨.root (by simp [encode]), fun step => ?_⟩
  simp only [swap01, rename] at step
  cases step with
  | root lt => simp [encode] at lt

/-! ## Comparison up to commutativity decides it with equivariant data -/

/-- With no rule and commutativity built into the comparison, conversion is
decided by normal forms up to commutativity. -/
theorem decidedModuloOn_commEq :
    DecidedModuloOn (fun _ _ : Bin => False) CommEq Set.univ := by
  refine ⟨fun term _ => ⟨term, .refl, fun _ step => step⟩, ?_⟩
  have noSteps : ∀ {x y : Bin}, ReflTransGen (fun _ _ : Bin => False) x y → y = x := by
    intro x y steps
    induction steps with
    | refl => rfl
    | tail _ step _ => exact step.elim
  have collapse : ∀ {x y : Bin},
      EqvGen (fun x y => (fun _ _ : Bin => False) x y ∨ CommEq x y) x y → CommEq x y := by
    intro x y converted
    induction converted with
    | rel _ _ step => exact step.elim (fun impossible => impossible.elim) id
    | refl => exact EqvGen.refl _
    | symm _ _ _ ih => exact EqvGen.symm _ _ ih
    | trans _ _ _ _ _ first second => exact EqvGen.trans _ _ _ first second
  intro a _ b _ n m normalA normalB
  have sameA : n = a := noSteps normalA.1
  have sameB : m = b := noSteps normalB.1
  subst sameA sameB
  exact ⟨collapse, fun converted => EqvGen.rel _ _ (Or.inr converted)⟩

