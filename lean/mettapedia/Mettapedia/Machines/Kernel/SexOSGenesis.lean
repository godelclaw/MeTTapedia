import Mettapedia.Machines.Kernel.SingleAddressSpace

/-!
# The SexOS boot genesis

Generated by `cesta/tools/genesis_lean.py` (SexOS fork, branch `cesta`) from the genesis table
`interfaces/kernel.data`, which the Cesta kernel compiles into its boot grants. Do not edit.

The domains are the protection domains of the boot image with their protection keys; the capabilities
are the ring grants of the table plus each domain's own ring at slot 2. The input ring, device leases,
the framebuffer and the key-14 shared buffers are outside this model.

Main results: `memory_readers_sound` (in every reachable state, a domain reaches another domain's frame
only if it is listed in `memoryReaders` of the owner) and its concrete readings, `sexdisplay_memory_private`,
`sexfiles_memory_confined`, `kaleidoscope_memory_confined`.
-/

set_option autoImplicit false

namespace Mettapedia.Machines.Kernel.SexOSGenesis

open Mettapedia.Machines.Kernel

inductive Dom where
  | sexdisplay
  | sexdrive
  | silk_shell
  | sexinput
  | sexusb
  | silkbar
  | linen
  | sexstore
  | quil
  | sexbell
  | sexfiles
  | spindle
  | sexnet
  | kaleidoscope
  deriving DecidableEq, Repr

/-- Protection keys, the table's id column. -/
def key : Dom → Nat
  | .sexdisplay => 1
  | .sexdrive => 2
  | .silk_shell => 3
  | .sexinput => 4
  | .sexusb => 5
  | .silkbar => 6
  | .linen => 7
  | .sexstore => 8
  | .quil => 9
  | .sexbell => 10
  | .sexfiles => 11
  | .spindle => 12
  | .sexnet => 13
  | .kaleidoscope => 15

theorem key_inj : ∀ a b, key a = key b → a = b := by
  intro a b h; cases a <;> cases b <;> first | rfl | (simp [key] at h)

def config : Config Dom where
  key := key
  key_inj := key_inj
  bound := 256

/-- The ring grants: holder, slot, target. -/
def rows : List (Dom × Nat × Dom) :=
  [(.silk_shell, 5, .sexdisplay), (.silk_shell, 6, .silk_shell), (.silk_shell, 7, .silkbar), (.silk_shell, 10, .sexstore), (.silk_shell, 12, .sexbell), (.sexinput, 6, .silk_shell), (.sexusb, 9, .sexinput), (.silkbar, 5, .sexdisplay), (.silkbar, 12, .sexbell), (.linen, 5, .sexdisplay), (.linen, 1, .sexfiles), (.silk_shell, 13, .linen), (.silk_shell, 11, .quil), (.quil, 5, .sexdisplay), (.quil, 1, .sexfiles), (.silk_shell, 14, .spindle), (.sexbell, 12, .sexbell), (.spindle, 5, .sexdisplay), (.spindle, 1, .sexfiles), (.spindle, 12, .sexbell), (.spindle, 13, .linen), (.spindle, 6, .silk_shell), (.sexfiles, 15, .sexdrive), (.kaleidoscope, 18, .sexnet)]

/-- The genesis tables: a domain's own ring at slot 2, the first matching row elsewhere. -/
def caps (d : Dom) (n : Nat) : Option (Cap Dom) :=
  if n = 2 then some ⟨.ring d, true⟩
  else (rows.find? fun r => r.1 = d ∧ r.2.1 = n).map fun r => ⟨.ring r.2.2, true⟩

theorem caps_no_frames : ∀ d n f w, caps d n ≠ some ⟨.frame f, w⟩ := by
  intro d n f w h
  unfold caps at h
  split at h
  · cases h
  · obtain ⟨r, -, hr⟩ := Option.map_eq_some_iff.mp h
    cases hr

theorem caps_ring {a b : Dom} {n : Nat} {w : Bool} (h : caps a n = some ⟨.ring b, w⟩) :
    b = a ∨ (a, n, b) ∈ rows := by
  unfold caps at h
  split at h
  · cases h; exact Or.inl rfl
  · obtain ⟨r, hr, he⟩ := Option.map_eq_some_iff.mp h
    cases he
    have hm := List.mem_of_find?_eq_some hr
    have hp := List.find?_some hr
    simp only [decide_eq_true_eq] at hp
    obtain ⟨h1, h2⟩ := hp
    right
    obtain ⟨x, y, z⟩ := r
    simp only at h1 h2
    subst h1 h2
    exact hm

/-- The domains that may ever reach memory owned by `e`: itself and the domains it can send to, which it
may lend frames to. -/
def memoryReaders (e : Dom) : List Dom := e :: (rows.filter fun r => r.1 = e).map fun r => r.2.2

theorem memory_readers_sound {s : State Dom} (hs : Reachable config (genesis config caps) s)
    {d e : Dom} {f : Nat} (hown : s.owner f = some e) (hacc : canAccess s d f = true) :
    d ∈ memoryReaders e := by
  by_cases hde : d = e
  · subst hde; exact List.mem_cons_self
  obtain ⟨n, w, h⟩ := (genesis_run config caps caps_no_frames hs).2.1 d e f hde hown hacc
  rcases caps_ring h with h' | h'
  · exact absurd h' hde
  · exact List.mem_cons_of_mem _ (List.mem_map.mpr ⟨(e, n, d), List.mem_filter.mpr ⟨h', by simp⟩, rfl⟩)

/-- The compositor sends to no one, so no other domain ever reaches its memory. -/
theorem sexdisplay_memory_private {s : State Dom} (hs : Reachable config (genesis config caps) s)
    {d : Dom} {f : Nat} (hown : s.owner f = some .sexdisplay) (hacc : canAccess s d f = true) :
    d = .sexdisplay := by
  have h := memory_readers_sound hs hown hacc
  simpa [memoryReaders, rows] using h

/-- The file server's memory is reached only by itself and the block driver it lends buffers to. -/
theorem sexfiles_memory_confined {s : State Dom} (hs : Reachable config (genesis config caps) s)
    {d : Dom} {f : Nat} (hown : s.owner f = some .sexfiles) (hacc : canAccess s d f = true) :
    d = .sexfiles ∨ d = .sexdrive := by
  have h := memory_readers_sound hs hown hacc
  simpa [memoryReaders, rows] using h

/-- The browser's memory is reached only by itself and the network server. -/
theorem kaleidoscope_memory_confined {s : State Dom} (hs : Reachable config (genesis config caps) s)
    {d : Dom} {f : Nat} (hown : s.owner f = some .kaleidoscope) (hacc : canAccess s d f = true) :
    d = .kaleidoscope ∨ d = .sexnet := by
  have h := memory_readers_sound hs hown hacc
  simpa [memoryReaders, rows] using h

end Mettapedia.Machines.Kernel.SexOSGenesis
