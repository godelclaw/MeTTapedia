import Mettapedia.GraphTheory.Hypermap.Walkup.OrbitCounts

/-!
# What deleting a dart does to the component count

Deleting `z` can only affect the component `z` was in.  Everything else is
untouched, so the whole question is: how many pieces does that one component
break into once `z` is removed?

The answer is *at most two*, and the reason is the **C-link**.  Connectivity of
a hypermap is generated by two steps — backwards along a node orbit, forwards
along a face orbit (`clinkGens`) — and not by three, because the composite law
makes the edge step a word in the other two.  A dart therefore has only two
C-successors, so the component of `z` minus `z` is covered by the two pieces
reachable from `node⁻¹ z` and from `face z`.  That is `zCompCount_le_two`, and
it is the entire content of the component identity

    compCount H + zCompCount H z = compCount (walkupE H z) + 1.

## When the two pieces are really one

Three separate conditions force the count down to one, and they are exactly the
conditions under which the Walkup transform preserves the genus:

* `z` is a **barb** — fixed by all three permutations.  Then its component is
  `{z}` and nothing survives: `zCompCount = 0`.
* `z` is **degenerate** but not a barb.  Then one of the two anchors coincides
  with the other or with `z` itself, by two-out-of-three on the fixed points.
* `z` is non-degenerate and **not cross-edge**.  This is the substantive case.
  Deleting `z` merges the edge cycles of `z` and `node z`, and the merged cycle
  is a path from `edge z` to the edge predecessor of `z` — which are C-adjacent
  to the two anchors.  So the anchors stay connected.

The last one is where the source spends its longest argument.  Here it is a
corollary of the transposition merge law, through
`walkupE_edge_eq_swap_mul`: the merged orbit contains both transposed darts,
and that is already proved in this tree.
-/

namespace Mettapedia.GraphTheory

open Mettapedia.GraphTheory.FourColor

open Equiv Equiv.Perm
open GoertzelV24PermutationOrbitSurgery GoertzelV24WordReachability
open Mettapedia.GraphTheory.OrbitCountSplitting

namespace Hypermap

variable {D : Type*} [Fintype D] [DecidableEq D]

omit [Fintype D] in
@[simp] theorem skipPerm_inv_apply_val (f : Perm D) (z : D) (u : {x : D // x ≠ z}) :
    (((skipPerm f z)⁻¹ u : {x : D // x ≠ z}) : D) = skipFun f⁻¹ z (u : D) := rfl

/-! ## Connectivity is generated by two steps -/

/-- The **C-link generators**: a backwards node step and a forwards face step. -/
def clinkGens (H : Hypermap D) : List (Perm D) := [H.node⁻¹, H.face]

theorem nodeInv_mem_clinkGens (H : Hypermap D) : H.node⁻¹ ∈ clinkGens H := List.mem_cons_self

theorem face_mem_clinkGens (H : Hypermap D) : H.face ∈ clinkGens H :=
  List.mem_cons_of_mem _ List.mem_cons_self

theorem clinkGens_cases {H : Hypermap D} {g : Perm D} (hg : g ∈ clinkGens H) :
    g = H.node⁻¹ ∨ g = H.face := by
  rcases List.mem_cons.mp hg with h | h1
  · exact Or.inl h
  · rcases List.mem_cons.mp h1 with h | h2
    · exact Or.inr h
    · simp at h2

/-- The edge step is a word in the two C-link steps. -/
theorem wordReachable_clinkGens_edge (H : Hypermap D) (u : D) :
    WordReachable (clinkGens H) u (H.edge u) := by
  have hface : H.face (H.edge u) = H.node⁻¹ u := by
    calc H.face (H.edge u) = H.node⁻¹ (H.node (H.face (H.edge u))) :=
          (inv_apply_apply _ _).symm
      _ = H.node⁻¹ u := by rw [H.cancel3 u]
  have hstep : H.edge u = H.face⁻¹ (H.node⁻¹ u) := by
    rw [← hface, inv_apply_apply]
  rw [hstep]
  exact (wordReachable_step (nodeInv_mem_clinkGens H) u).trans
    (wordReachable_inv_step (face_mem_clinkGens H) (H.node⁻¹ u))

theorem wordReachable_clinkGens_node (H : Hypermap D) (u : D) :
    WordReachable (clinkGens H) u (H.node u) := by
  have h := wordReachable_inv_step (nodeInv_mem_clinkGens H) u
  rwa [inv_inv] at h

theorem wordReachable_clinkGens_face (H : Hypermap D) (u : D) :
    WordReachable (clinkGens H) u (H.face u) :=
  wordReachable_step (face_mem_clinkGens H) u

/-- **The component count is the C-link component count.** -/
theorem compCount_eq_wordOrbitCount_clinkGens (H : Hypermap D) :
    compCount H = wordOrbitCount (clinkGens H) := by
  refine le_antisymm ?_ ?_
  · refine wordOrbitCount_le_of_le (fun u v huv => ?_)
    refine wordReachable_absorb ?_ huv
    intro g hg w
    rcases clinkGens_cases hg with rfl | rfl
    · exact wordReachable_inv_step
        (List.mem_cons_of_mem _ List.mem_cons_self : H.node ∈ [H.edge, H.node, H.face]) w
    · exact wordReachable_step
        (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ List.mem_cons_self)) w
  · refine wordOrbitCount_le_of_le (fun u v huv => ?_)
    refine wordReachable_absorb ?_ huv
    intro g hg w
    rcases List.mem_cons.mp hg with rfl | hg1
    · exact wordReachable_clinkGens_edge H w
    rcases List.mem_cons.mp hg1 with rfl | hg2
    · exact wordReachable_clinkGens_node H w
    rcases List.mem_cons.mp hg2 with rfl | hg3
    · exact wordReachable_clinkGens_face H w
    · simp at hg3

omit [DecidableEq D] in
/-- Sharing a cycle of a permutation whose every step is a walk gives a walk. -/
theorem wordReachable_of_sameCycle_of_steps {L : List (Perm D)} {g : Perm D}
    (hg : ∀ u, WordReachable L u (g u)) {x y : D} (h : g.SameCycle x y) :
    WordReachable L x y := by
  obtain ⟨n, hn⟩ := exists_nat_pow_apply_eq h
  have key : ∀ m : ℕ, WordReachable L x ((g ^ m) x) := by
    intro m
    induction m with
    | zero => simpa using WordReachable.refl L x
    | succ m ih =>
        have hpow : (g ^ (m + 1)) x = g ((g ^ m) x) := by rw [pow_succ', Perm.mul_apply]
        rw [hpow]
        exact ih.trans (hg _)
  have := key n
  rwa [hn] at this

/-! ## Lifting C-steps across the deletion -/

variable (H : Hypermap D) (z : D)

/-- A C-step that avoids the deleted dart is a C-step of the punctured map. -/
theorem wordStep_walkupE_of_ne {u v : {x : D // x ≠ z}}
    (h : (v : D) = H.node⁻¹ (u : D) ∨ (v : D) = H.face (u : D)) :
    WordStep (clinkGens (walkupE H z)) u v := by
  rcases h with h | h
  · refine ⟨(walkupE H z).node⁻¹, nodeInv_mem_clinkGens _, Subtype.ext ?_⟩
    show skipFun H.node⁻¹ z (u : D) = (v : D)
    rw [skipFun_of_ne (by rw [← h]; exact v.2), h]
  · refine ⟨(walkupE H z).face, face_mem_clinkGens _, Subtype.ext ?_⟩
    show skipFun H.face z (u : D) = (v : D)
    rw [skipFun_of_ne (by rw [← h]; exact v.2), h]

omit [Fintype D] in
/-- Any single step of a punctured permutation is a walk upstairs. -/
theorem wordReachable_skipFun {L : List (Perm D)} {f : Perm D} (hf : f ∈ L) (x : D) :
    WordReachable L x (skipFun f z x) := by
  unfold skipFun
  split
  · next hx =>
      have h2 := wordReachable_pow hf x 2
      have : (f ^ (2 : ℕ)) x = f z := by
        rw [pow_succ, Perm.mul_apply, pow_one, hx]
      rwa [this] at h2
  · exact wordReachable_step hf x

/-- Every C-step of the punctured map is a C-walk upstairs. -/
theorem wordReachable_val_of_wordStep {u v : {x : D // x ≠ z}}
    (h : WordStep (clinkGens (walkupE H z)) u v) :
    WordReachable (clinkGens H) (u : D) (v : D) := by
  obtain ⟨g, hg, rfl⟩ := h
  rcases clinkGens_cases hg with rfl | rfl
  · show WordReachable (clinkGens H) (u : D) (((skipPerm H.node z)⁻¹ u : {x : D // x ≠ z}) : D)
    rw [skipPerm_inv_apply_val]
    exact wordReachable_skipFun z (nodeInv_mem_clinkGens H) (u : D)
  · show WordReachable (clinkGens H) (u : D) ((skipPerm H.face z u : {x : D // x ≠ z}) : D)
    rw [skipPerm_apply_val]
    exact wordReachable_skipFun z (face_mem_clinkGens H) (u : D)

theorem wordReachable_val_of_wordReachable {u v : {x : D // x ≠ z}}
    (h : WordReachable (clinkGens (walkupE H z)) u v) :
    WordReachable (clinkGens H) (u : D) (v : D) := by
  induction h with
  | refl => exact WordReachable.refl _ _
  | tail _ hstep ih => exact ih.trans (wordReachable_val_of_wordStep H z hstep)

/-! ## The component of the deleted dart -/

/-- The C-component of `z`. -/
def zComp : Set D := {x | WordReachable (clinkGens H) z x}

theorem mem_zComp_self : z ∈ zComp H z := WordReachable.refl _ _

theorem zComp_invariant : ∀ g ∈ clinkGens H, ∀ x ∈ zComp H z, g x ∈ zComp H z :=
  fun _ hg x hx => hx.trans (wordReachable_step hg x)

theorem zComp_compl_invariant : ∀ g ∈ clinkGens H, ∀ x ∈ (zComp H z)ᶜ, g x ∈ (zComp H z)ᶜ := by
  intro g hg x hx hgx
  exact hx (hgx.trans (wordReachable_of_step hg x))

theorem not_mem_zComp_of_reachable {x y : D}
    (hx : x ∉ zComp H z) (h : WordReachable (clinkGens H) x y) : y ∉ zComp H z :=
  fun hy => hx (hy.trans h.symm)

/-- `z`'s component is the smallest step-closed set containing `z`. -/
theorem zComp_subset_of_closed {P : Set D} (hz : z ∈ P)
    (hstep : ∀ x ∈ P, ∀ g ∈ clinkGens H, g x ∈ P) : zComp H z ⊆ P := by
  intro x hx
  induction hx with
  | refl => exact hz
  | tail _ hstep' ih =>
      obtain ⟨g, hg, rfl⟩ := hstep'
      exact hstep _ ih g hg

/-- Upstairs, `z`'s component is a single class. -/
theorem wordOrbitCountOn_zComp : wordOrbitCountOn (clinkGens H) (zComp H z) = 1 := by
  have hsec := classCountOn_eq_card_of_section (s := wordSetoid (clinkGens H))
    (S := zComp H z) (A := Unit) (fun _ => z)
    (saturated_wordReachable_of_invariant (zComp_invariant H z))
    (fun _ => mem_zComp_self H z)
    (fun x hx => ⟨(), (hx : WordReachable (clinkGens H) z x).symm⟩)
    (fun a b => ⟨fun _ => Subsingleton.elim a b, fun _ => WordReachable.refl _ z⟩)
  rw [wordOrbitCountOn, hsec]
  simp

/-- Away from `z`'s component, nothing changes. -/
theorem classCountOn_compl_transport :
    classCountOn (wordSetoid (clinkGens H)) (zComp H z)ᶜ
      = classCountOn (wordSetoid (clinkGens (walkupE H z)))
          (Subtype.val ⁻¹' (zComp H z)ᶜ) := by
  refine classCountOn_preimage
    (saturated_wordReachable_of_invariant (zComp_compl_invariant H z)) ?_ ?_
  · intro x hx
    have hxz : x ≠ z := fun h => hx (h ▸ mem_zComp_self H z)
    exact ⟨⟨x, hxz⟩, WordReachable.refl _ x⟩
  · intro u v hu
    constructor
    · exact fun h => wordReachable_val_of_wordReachable H z h
    · intro h
      -- off `z`'s component every step of the walk avoids `z`, so it lifts
      have key : ∀ x y : D, x ∉ zComp H z → WordReachable (clinkGens H) x y →
          ∀ (hx' : x ≠ z) (hy' : y ≠ z),
            WordReachable (clinkGens (walkupE H z)) ⟨x, hx'⟩ ⟨y, hy'⟩ := by
        intro x y hx hxy
        induction hxy with
        | refl => intro hx' hy'; exact WordReachable.refl _ _
        | @tail b c hxb hstep ih =>
            intro hx' hy'
            have hbz : b ∉ zComp H z := not_mem_zComp_of_reachable H z hx hxb
            have hb' : b ≠ z := by
              intro hc
              exact hbz (by rw [hc]; exact mem_zComp_self H z)
            obtain ⟨g, hg, rfl⟩ := hstep
            refine Relation.ReflTransGen.tail (ih hx' hb') ?_
            refine wordStep_walkupE_of_ne H z ?_
            rcases clinkGens_cases hg with rfl | rfl
            · exact Or.inl rfl
            · exact Or.inr rfl
      exact key (u : D) (v : D) hu h u.2 v.2

/-! ## How many pieces survive -/

/-- The number of C-components of the punctured map that meet `z`'s old
component. -/
noncomputable def zCompCount : ℕ :=
  wordOrbitCountOn (clinkGens (walkupE H z)) (Subtype.val ⁻¹' zComp H z)

theorem zCompPreimage_invariant : ∀ g ∈ clinkGens (walkupE H z),
    ∀ u ∈ (Subtype.val ⁻¹' zComp H z : Set {x : D // x ≠ z}),
      g u ∈ (Subtype.val ⁻¹' zComp H z : Set {x : D // x ≠ z}) := by
  intro g hg u hu
  show ((g u : {x : D // x ≠ z}) : D) ∈ zComp H z
  exact (hu : WordReachable (clinkGens H) z (u : D)).trans
    (wordReachable_val_of_wordStep H z ⟨g, hg, rfl⟩)

/-- **The component identity.**  The pieces of `z`'s old component, counted
downstairs, plus the old count, equal the new count plus one. -/
theorem compCount_add_zCompCount :
    compCount H + zCompCount H z = compCount (walkupE H z) + 1 := by
  have hup := wordOrbitCount_eq_wordOrbitCountOn_add_compl (clinkGens H) (zComp_invariant H z)
  have hdown := wordOrbitCount_eq_wordOrbitCountOn_add_compl
    (clinkGens (walkupE H z)) (zCompPreimage_invariant H z)
  rw [wordOrbitCountOn_zComp] at hup
  have htrans := classCountOn_compl_transport H z
  rw [compCount_eq_wordOrbitCount_clinkGens, compCount_eq_wordOrbitCount_clinkGens,
    hup, hdown, zCompCount, wordOrbitCountOn, wordOrbitCountOn, wordOrbitCountOn,
    ← Set.preimage_compl, ← htrans]
  omega

/-! ## Bounding the number of surviving pieces

A dart has two C-successors, so `z`'s component minus `z` is covered by the
pieces of `node⁻¹ z` and of `face z`. -/

/-- **The covering.**  Every surviving dart of `z`'s component is
downstairs-reachable from one of the two anchors. -/
theorem zComp_covered (u : {x : D // x ≠ z}) (hu : (u : D) ∈ zComp H z) :
    (∃ h : H.node⁻¹ z ≠ z, WordReachable (clinkGens (walkupE H z)) u ⟨H.node⁻¹ z, h⟩) ∨
      (∃ h : H.face z ≠ z, WordReachable (clinkGens (walkupE H z)) u ⟨H.face z, h⟩) := by
  classical
  set P : Set D := {x | x = z ∨ ∃ hx : x ≠ z,
      (∃ h : H.node⁻¹ z ≠ z,
          WordReachable (clinkGens (walkupE H z)) ⟨x, hx⟩ ⟨H.node⁻¹ z, h⟩) ∨
        (∃ h : H.face z ≠ z,
          WordReachable (clinkGens (walkupE H z)) ⟨x, hx⟩ ⟨H.face z, h⟩)} with hP
  have hsub : zComp H z ⊆ P := by
    refine zComp_subset_of_closed H z (Or.inl rfl) ?_
    intro x hx g hg
    by_cases hyz : g x = z
    · exact Or.inl hyz
    · refine Or.inr ⟨hyz, ?_⟩
      rcases hx with rfl | ⟨hxz, hanc⟩
      · -- the first step out of `z` lands on an anchor
        rcases clinkGens_cases hg with rfl | rfl
        · exact Or.inl ⟨hyz, WordReachable.refl _ _⟩
        · exact Or.inr ⟨hyz, WordReachable.refl _ _⟩
      · -- one more step, taken downstairs
        have hstep : WordStep (clinkGens (walkupE H z))
            (⟨x, hxz⟩ : {y : D // y ≠ z}) ⟨g x, hyz⟩ := by
          refine wordStep_walkupE_of_ne H z ?_
          rcases clinkGens_cases hg with rfl | rfl
          · exact Or.inl rfl
          · exact Or.inr rfl
        have hfwd : WordReachable (clinkGens (walkupE H z))
            (⟨x, hxz⟩ : {y : D // y ≠ z}) ⟨g x, hyz⟩ :=
          Relation.ReflTransGen.single hstep
        have hback : WordReachable (clinkGens (walkupE H z))
            (⟨g x, hyz⟩ : {y : D // y ≠ z}) ⟨x, hxz⟩ := WordReachable.symm hfwd
        rcases hanc with ⟨h, hr⟩ | ⟨h, hr⟩
        · exact Or.inl ⟨h, hback.trans hr⟩
        · exact Or.inr ⟨h, hback.trans hr⟩
  rcases hsub hu with hz | ⟨hxz, hanc⟩
  · exact absurd hz u.2
  · rwa [Subtype.coe_eta] at hanc

/-- If every surviving dart of `z`'s component is downstairs-reachable from a
member of `A`, then at most `A.card` pieces survive. -/
theorem zCompCount_le_card {A : Finset {x : D // x ≠ z}}
    (hcov : ∀ u : {x : D // x ≠ z}, (u : D) ∈ zComp H z →
      ∃ a ∈ A, WordReachable (clinkGens (walkupE H z)) u a) :
    zCompCount H z ≤ A.card := by
  classical
  set s := wordSetoid (clinkGens (walkupE H z)) with hs
  have hsubset : classesOn s (Subtype.val ⁻¹' zComp H z) ⊆ (fun a => Quotient.mk s a) '' (A : Set _) := by
    rintro c ⟨u, hu, rfl⟩
    obtain ⟨a, haA, hra⟩ := hcov u hu
    exact ⟨a, haA, (Quotient.sound hra).symm⟩
  have hle : (classesOn s (Subtype.val ⁻¹' zComp H z)).ncard
      ≤ ((fun a => Quotient.mk s a) '' (A : Set _)).ncard :=
    Set.ncard_le_ncard hsubset (Set.toFinite _)
  have himg : ((fun a => Quotient.mk s a) '' (A : Set _)).ncard ≤ A.card := by
    refine le_trans (Set.ncard_image_le (Set.toFinite _)) ?_
    rw [Set.ncard_coe_finset]
  exact le_trans hle himg

theorem zCompCount_eq_zero_of_empty
    (hcov : ∀ u : {x : D // x ≠ z}, (u : D) ∉ zComp H z) : zCompCount H z = 0 := by
  classical
  refine Nat.le_zero.mp ?_
  have := zCompCount_le_card H z (A := (∅ : Finset {x : D // x ≠ z}))
    (fun u hu => absurd hu (hcov u))
  simpa using this

theorem zCompCount_le_one_of_cover (a : {x : D // x ≠ z})
    (hcov : ∀ u : {x : D // x ≠ z}, (u : D) ∈ zComp H z →
      WordReachable (clinkGens (walkupE H z)) u a) :
    zCompCount H z ≤ 1 := by
  classical
  have := zCompCount_le_card H z (A := ({a} : Finset {x : D // x ≠ z}))
    (fun u hu => ⟨a, Finset.mem_singleton_self a, hcov u hu⟩)
  simpa using this

theorem zCompCount_le_two_of_cover (a b : {x : D // x ≠ z})
    (hcov : ∀ u : {x : D // x ≠ z}, (u : D) ∈ zComp H z →
      WordReachable (clinkGens (walkupE H z)) u a ∨
        WordReachable (clinkGens (walkupE H z)) u b) :
    zCompCount H z ≤ 2 := by
  classical
  refine le_trans (zCompCount_le_card H z (A := ({a, b} : Finset {x : D // x ≠ z}))
    (fun u hu => ?_)) ?_
  · rcases hcov u hu with h | h
    · exact ⟨a, Finset.mem_insert_self a _, h⟩
    · exact ⟨b, Finset.mem_insert_of_mem (Finset.mem_singleton_self b), h⟩
  · calc ({a, b} : Finset {x : D // x ≠ z}).card ≤ ({b} : Finset {x : D // x ≠ z}).card + 1 :=
        Finset.card_insert_le _ _
      _ = 2 := by simp

/-! ### The case bounds -/

/-- With no surviving node anchor, at most one piece survives. -/
theorem zCompCount_le_one_of_nodeInv_fix (h1 : H.node⁻¹ z = z) : zCompCount H z ≤ 1 := by
  by_cases h2 : H.face z = z
  · rw [zCompCount_eq_zero_of_empty H z (fun u hu => by
      rcases zComp_covered H z u hu with ⟨h, _⟩ | ⟨h, _⟩
      · exact h h1
      · exact h h2)]
    norm_num
  · refine zCompCount_le_one_of_cover H z ⟨H.face z, h2⟩ (fun u hu => ?_)
    rcases zComp_covered H z u hu with ⟨h, _⟩ | ⟨_, hr⟩
    · exact absurd h1 h
    · exact hr

/-- With no surviving face anchor, at most one piece survives. -/
theorem zCompCount_le_one_of_face_fix (h2 : H.face z = z) : zCompCount H z ≤ 1 := by
  by_cases h1 : H.node⁻¹ z = z
  · exact zCompCount_le_one_of_nodeInv_fix H z h1
  · refine zCompCount_le_one_of_cover H z ⟨H.node⁻¹ z, h1⟩ (fun u hu => ?_)
    rcases zComp_covered H z u hu with ⟨_, hr⟩ | ⟨h, _⟩
    · exact hr
    · exact absurd h2 h

/-- **At most two pieces survive.**  A dart has only two C-successors. -/
theorem zCompCount_le_two : zCompCount H z ≤ 2 := by
  by_cases h1 : H.node⁻¹ z = z
  · exact le_trans (zCompCount_le_one_of_nodeInv_fix H z h1) (by norm_num)
  · by_cases h2 : H.face z = z
    · exact le_trans (zCompCount_le_one_of_face_fix H z h2) (by norm_num)
    · refine zCompCount_le_two_of_cover H z ⟨H.node⁻¹ z, h1⟩ ⟨H.face z, h2⟩ (fun u hu => ?_)
      rcases zComp_covered H z u hu with ⟨_, hr⟩ | ⟨_, hr⟩
      · exact Or.inl hr
      · exact Or.inr hr

theorem nodeInv_fix_of_node_fix (hn : H.node z = z) : H.node⁻¹ z = z := by
  have h := inv_apply_apply H.node z
  rwa [hn] at h

/-- **An isolated dart takes its whole component with it.** -/
theorem zCompCount_eq_zero_of_barb (hb : Barb H z) : zCompCount H z = 0 := by
  refine zCompCount_eq_zero_of_empty H z (fun u hu => ?_)
  have hsub : zComp H z ⊆ ({z} : Set D) := by
    refine zComp_subset_of_closed H z rfl ?_
    intro x hx g hg
    have hxz : x = z := hx
    rcases clinkGens_cases hg with rfl | rfl
    · show H.node⁻¹ x ∈ ({z} : Set D)
      rw [hxz]
      exact nodeInv_fix_of_node_fix H z hb.2.1
    · show H.face x ∈ ({z} : Set D)
      rw [hxz]
      exact hb.2.2
  exact u.2 (hsub hu)

/-- **A non-isolated dart leaves something behind.** -/
theorem one_le_zCompCount_of_not_barb (hb : ¬ Barb H z) : 1 ≤ zCompCount H z := by
  have hex : ∃ u : {x : D // x ≠ z}, (u : D) ∈ zComp H z := by
    by_cases hn : H.node z = z
    · by_cases hf : H.face z = z
      · exact absurd ⟨edge_fix_of_node_face hn hf, hn, hf⟩ hb
      · exact ⟨⟨H.face z, hf⟩, wordReachable_clinkGens_face H z⟩
    · exact ⟨⟨H.node z, hn⟩, wordReachable_clinkGens_node H z⟩
  obtain ⟨u, hu⟩ := hex
  have hpos : 0 < (classesOn (wordSetoid (clinkGens (walkupE H z)))
      (Subtype.val ⁻¹' zComp H z)).ncard := by
    rw [Set.ncard_pos (Set.toFinite _)]
    exact ⟨_, ⟨u, hu, rfl⟩⟩
  show 1 ≤ (classesOn (wordSetoid (clinkGens (walkupE H z)))
    (Subtype.val ⁻¹' zComp H z)).ncard
  omega

/-- **A degenerate dart never disconnects its component.**  Two of the three
fixed-point conditions force the third, so one anchor either vanishes or
coincides with the other. -/
theorem zCompCount_le_one_of_degenerate (hd : Degenerate H z) : zCompCount H z ≤ 1 := by
  rcases hd with he | hn | hf
  · -- `edge z = z` makes the two anchors the same dart
    have hfn : H.face z = H.node⁻¹ z := by
      have hc := H.cancel3 z
      rw [he] at hc
      have := inv_apply_apply H.node (H.face z)
      rw [hc] at this
      exact this.symm
    by_cases hf : H.face z = z
    · exact zCompCount_le_one_of_face_fix H z hf
    · refine zCompCount_le_one_of_cover H z ⟨H.face z, hf⟩ (fun u hu => ?_)
      rcases zComp_covered H z u hu with ⟨h, hr⟩ | ⟨_, hr⟩
      · rw [show (⟨H.node⁻¹ z, h⟩ : {x : D // x ≠ z}) = ⟨H.face z, hf⟩ from
          Subtype.ext hfn.symm] at hr
        exact hr
      · exact hr
  · exact zCompCount_le_one_of_nodeInv_fix H z (nodeInv_fix_of_node_fix H z hn)
  · exact zCompCount_le_one_of_face_fix H z hf

/-- **Without the cross-edge condition, the component stays connected.**  The
two anchors are C-adjacent to the two darts that the transposition merge law
puts on one edge cycle. -/
theorem zCompCount_le_one_of_not_crossEdge (hd : ¬ Degenerate H z) (hc : ¬ CrossEdge H z) :
    zCompCount H z ≤ 1 := by
  have hez := edge_ne_of_not_degenerate hd
  have hnz := node_ne_of_not_degenerate hd
  have hfz := face_ne_of_not_degenerate hd
  have hwz := pred_ne_of_not_degenerate hd
  have henz := edge_node_ne hd
  have h1 : H.node⁻¹ z ≠ z := fun h => hnz (by
    have := apply_inv_apply H.node z
    rwa [h] at this)
  -- the two darts the merge law joins
  have hmerge : (walkupE H z).edge.SameCycle (⟨H.edge z, hez⟩ : {x : D // x ≠ z})
      ⟨H.edge (H.node z), henz⟩ := by
    rw [walkupE_edge_eq_swap_mul hd]
    exact swap_mul_sameCycle_of_not_sameCycle
      (fun h => hc ((sameCycle_swap_points_iff hd).1 h))
  -- the edge predecessor of `z` is sent to `edge (node z)`
  have hpred : (walkupE H z).edge (⟨H.node (H.face z), hwz⟩ : {x : D // x ≠ z})
      = ⟨H.edge (H.node z), henz⟩ := by
    refine Subtype.ext ?_
    rw [walkupE_edge_apply, skipEdgeFun_of_edge_ne H z hez,
      if_neg (pred_ne_node hd), if_pos rfl]
  have hjoin : (walkupE H z).edge.SameCycle (⟨H.edge z, hez⟩ : {x : D // x ≠ z})
      ⟨H.node (H.face z), hwz⟩ := by
    refine hmerge.trans (SameCycle.symm ?_)
    rw [← hpred]
    exact sameCycle_step _ _
  have hreach : WordReachable (clinkGens (walkupE H z)) (⟨H.edge z, hez⟩ : {x : D // x ≠ z})
      ⟨H.node (H.face z), hwz⟩ :=
    wordReachable_of_sameCycle_of_steps (wordReachable_clinkGens_edge (walkupE H z)) hjoin
  -- the two anchors hang off those darts
  have hstepA : WordStep (clinkGens (walkupE H z)) (⟨H.edge z, hez⟩ : {x : D // x ≠ z})
      ⟨H.node⁻¹ z, h1⟩ := by
    refine wordStep_walkupE_of_ne H z (Or.inr ?_)
    show H.node⁻¹ z = H.face (H.edge z)
    have hc3 := H.cancel3 z
    have hinv := inv_apply_apply H.node (H.face (H.edge z))
    rw [hc3] at hinv
    exact hinv
  have hstepB : WordStep (clinkGens (walkupE H z))
      (⟨H.node (H.face z), hwz⟩ : {x : D // x ≠ z}) ⟨H.face z, hfz⟩ := by
    refine wordStep_walkupE_of_ne H z (Or.inl ?_)
    show H.face z = H.node⁻¹ (H.node (H.face z))
    exact (inv_apply_apply H.node (H.face z)).symm
  have hAB : WordReachable (clinkGens (walkupE H z)) (⟨H.node⁻¹ z, h1⟩ : {x : D // x ≠ z})
      ⟨H.face z, hfz⟩ :=
    (WordReachable.symm (Relation.ReflTransGen.single hstepA)).trans
      (hreach.trans (Relation.ReflTransGen.single hstepB))
  refine zCompCount_le_one_of_cover H z ⟨H.face z, hfz⟩ (fun u hu => ?_)
  rcases zComp_covered H z u hu with ⟨_, hr⟩ | ⟨_, hr⟩
  · exact hr.trans hAB
  · exact hr

end Hypermap

