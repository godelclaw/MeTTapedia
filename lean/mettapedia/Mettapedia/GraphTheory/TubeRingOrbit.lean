theorem zigzag6_range_7 : stabilizesRange 6 table6 700 100 = true := by decide +kernel

theorem zigzag6_stabilizes : stabilizes 6 = true := by
  unfold stabilizes; rw [table6_correct]
  apply stabilizesWith_of_ranges 6 table6 100 (by decide)
  intro c hc
  match c, hc with
  | 0, _ => exact zigzag6_range_0
  | 1, _ => exact zigzag6_range_1
  | 2, _ => exact zigzag6_range_2
  | 3, _ => exact zigzag6_range_3
  | 4, _ => exact zigzag6_range_4
  | 5, _ => exact zigzag6_range_5
  | 6, _ => exact zigzag6_range_6
  | 7, _ => exact zigzag6_range_7
  | c + 8, hc => exact absurd hc (by omega)

