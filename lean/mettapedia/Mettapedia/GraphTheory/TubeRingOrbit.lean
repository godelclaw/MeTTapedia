/-- word-range form of the stabilisation check -/
def stabilizesRange (k : Nat) (tab : List Nat) (lo len : Nat) : Bool :=
  (List.range' lo len).all fun w => iterSet tab k (1 <<< w) == iterSet tab (k - 1) (1 <<< w)

theorem stabilizesWith_of_ranges (k : Nat) (tab : List Nat) (len : Nat) (hlen : 0 < len)
    (h : ∀ c, c * len < 3 ^ k → stabilizesRange k tab (c * len) len = true) :
    stabilizesWith k tab = true := by
  unfold stabilizesWith
  rw [List.all_eq_true]
  intro w hw
  rw [List.mem_range] at hw
  have hle : w / len * len ≤ w := Nat.div_mul_le_self w len
  have hc := h (w / len) (Nat.lt_of_le_of_lt hle hw)
  unfold stabilizesRange at hc
  rw [List.all_eq_true] at hc
  apply hc
  rw [List.mem_range']
  have hdm : w / len * len + w % len = w := Nat.div_add_mod' w len
  have hmod := Nat.mod_lt w hlen
  refine ⟨w - w / len * len, ?_, ?_⟩
  · omega
  · omega

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem table6_correct : computedTable 6 = table6 := by decide +kernel

set_option maxHeartbeats 0 in
set_option maxRecDepth 100000 in
theorem zigzag6_range_0 : stabilizesRange 6 table6 0 100 = true := by decide +kernel

