theorem deletionCheck_eq_true (u v : Fin 20) : deletionCheck u v = true := by
  fin_cases u
  exacts [deletionCheck_0 v, deletionCheck_1 v, deletionCheck_2 v, deletionCheck_3 v,
    deletionCheck_4 v, deletionCheck_5 v, deletionCheck_6 v, deletionCheck_7 v,
    deletionCheck_8 v, deletionCheck_9 v, deletionCheck_10 v, deletionCheck_11 v,
    deletionCheck_12 v, deletionCheck_13 v, deletionCheck_14 v, deletionCheck_15 v,
    deletionCheck_16 v, deletionCheck_17 v, deletionCheck_18 v, deletionCheck_19 v]

set_option maxRecDepth 100000 in
/-- `G` is connected. -/
theorem cubicGraph_connected : cubicGraph.Connected := by
  rw [cubicGraph.connected_iff_reachSet_eq_univ (next := neighbours)
    (fun a b => mem_neighbours_iff a b) 0]
  decide +kernel

/-- **Deleting any one or two vertices of `G` leaves a connected graph.** -/
theorem cubicGraph_induce_compl_pair_connected (u v : Fin 20) :
    (cubicGraph.induce ({u, v}ᶜ : Set (Fin 20))).Connected := by
  have hset : ({u, v}ᶜ : Set (Fin 20)) = (survivors u v : Set (Fin 20)) := by
    ext x
    simp [survivors]
  rw [hset, cubicGraph.induce_connected_iff_subset_reachSet (next := fun a =>
      (neighbours a).filter (· ∈ survivors u v)) (fun a b => by
        rw [Finset.mem_filter, mem_neighbours_iff]) (startVertex_mem u v)]
  exact of_decide_eq_true (deletionCheck_eq_true u v)

