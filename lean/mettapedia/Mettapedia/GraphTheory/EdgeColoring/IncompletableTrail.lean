/-- The listed cubic graph. -/
def graphListing : Listing (Fin 20) where
  edges := graphEdges
  adj := graphAdj
  loopless := by decide +kernel
  nodup := by decide +kernel
  adj_lt := by decide +kernel
  mem_adj_iff := by decide +kernel

set_option maxRecDepth 100000 in
/-- The listed trail graph. -/
def trailListing : Listing (Fin 20) where
  edges := trailEdges
  adj := trailAdj
  loopless := by decide +kernel
  nodup := by decide +kernel
  adj_lt := by decide +kernel
  mem_adj_iff := by decide +kernel


/-- The cubic graph `G`. -/
abbrev cubicGraph : SimpleGraph (Fin 20) :=
  graphListing.graph

/-- The trail graph `G'`: `G` with the edge `3–8` deleted and its endpoints suppressed. -/
abbrev trailGraph : SimpleGraph (Fin 20) :=
  trailListing.graph

set_option maxRecDepth 100000 in
/-- `G` is `G'` with `0–7` subdivided by `3`, `9–14` subdivided by `8`, and `3` joined to
`8`. -/
theorem cubicGraph_adj_iff (u v : Fin 20) :
    cubicGraph.Adj u v ↔
      (trailGraph.Adj u v ∧ s(u, v) ≠ s(0, 7) ∧ s(u, v) ≠ s(9, 14)) ∨
        s(u, v) ∈ ({s(0, 3), s(3, 7), s(9, 8), s(8, 14), s(3, 8)} : Finset (Sym2 (Fin 20))) := by
  revert u v
  decide +kernel

set_option maxRecDepth 100000 in
/-- `G'` is cubic on the eighteen vertices other than `3` and `8`, which are isolated. -/
theorem trailGraph_degree (v : Fin 20) :
    trailGraph.degree v = if v = 3 ∨ v = 8 then 0 else 3 := by
  revert v
  decide +kernel

set_option maxRecDepth 100000 in
/-- `G` is cubic. -/
theorem cubicGraph_isRegular : cubicGraph.IsRegularOfDegree 3 := by
  intro v
  revert v
  decide +kernel

set_option maxRecDepth 100000 in
theorem graphColoring_proper : graphListing.ProperTable graphColoring := by
  decide +kernel

/-- **`G` is `3`-edge-colourable.** -/
theorem cubicGraph_edgeColorable : cubicGraph.EdgeColorable 3 :=
  ⟨graphListing.coloring _ graphColoring_proper⟩

/-- The position in `kempeBlocks` of an unordered pair of colours. -/
def pairIndex (a b : Fin 3) : ℕ :=
  if a = b then a else 2 + (min a b : ℕ) + (max a b : ℕ)

/-- The certified two-coloured components of the `i`-th colouring for the colours `a, b`. -/
def blocksOf (i : ℕ) (a b : Fin 3) : List (List ℕ × ℕ) :=
  (kempeBlocks.getD i []).getD (pairIndex a b) []

set_option maxRecDepth 100000 in
/-- The thirty-six colourings of `G'` and their two-coloured components form a Kempe
certificate. -/
theorem kempeCertificate : trailListing.KempeCertificate trailColorings blocksOf := by
  decide +kernel

set_option maxRecDepth 100000 in
/-- No certified block contains both `0–7` (position 25) and `9–14` (position 26). -/
theorem blocks_separate : ∀ i < trailColorings.length, ∀ a b : Fin 3, ∀ blk ∈ blocksOf i a b,
    25 ∈ blk.1 → 26 ∉ blk.1 := by
  decide +kernel

/-- The edge `0–7` of `G'`. -/
def edgeZeroSeven : trailGraph.edgeSet :=
  trailListing.edge (k := 25) (by decide)

/-- The edge `9–14` of `G'`. -/
def edgeNineFourteen : trailGraph.edgeSet :=
  trailListing.edge (k := 26) (by decide)

theorem edgeZeroSeven_val : (edgeZeroSeven : Sym2 (Fin 20)) = s(0, 7) := by
  decide +kernel

theorem edgeNineFourteen_val : (edgeNineFourteen : Sym2 (Fin 20)) = s(9, 14) := by
  decide +kernel

/-- The first certified colouring of `G'`. -/
noncomputable def baseColoring : trailGraph.EdgeColoring (Fin 3) :=
  trailListing.coloring _ (kempeCertificate.proper 0 (by decide))

/-- **No colouring Kempe-equivalent to `baseColoring` puts `0–7` and `9–14` in one
two-coloured component**: the trail is not completable by simple operations. -/
theorem not_kempeCompletableAcross :
    ¬ EdgeColoring.KempeCompletableAcross baseColoring edgeZeroSeven edgeNineFourteen :=
  EdgeTable.Listing.not_kempeCompletableAcross kempeCertificate (by decide) _ _ blocks_separate


/-! ### A spherical rotation system -/

/-- The successor of `v` in a cyclic order of three vertices. -/
def cyclicNext : List (Fin 20) → Fin 20 → Fin 20
  | [x, y, z], v => if v = x then y else if v = y then z else x
  | _, v => v

/-- The predecessor of `v` in a cyclic order of three vertices. -/
def cyclicPrev : List (Fin 20) → Fin 20 → Fin 20
  | [x, y, z], v => if v = x then z else if v = y then x else y
  | _, v => v

/-- The neighbour after `v` around `u`. -/
def nextNeighbour (u v : Fin 20) : Fin 20 :=
  cyclicNext (rotationTable.getD u []) v

/-- The neighbour before `v` around `u`. -/
def prevNeighbour (u v : Fin 20) : Fin 20 :=
  cyclicPrev (rotationTable.getD u []) v

set_option maxRecDepth 100000 in
theorem rotationTable_spec : ∀ u v : Fin 20, cubicGraph.Adj u v →
    cubicGraph.Adj u (nextNeighbour u v) ∧ cubicGraph.Adj u (prevNeighbour u v) ∧
      prevNeighbour u (nextNeighbour u v) = v ∧ nextNeighbour u (prevNeighbour u v) = v ∧
      ∀ w, cubicGraph.Adj u w →
        w = v ∨ w = nextNeighbour u v ∨ w = nextNeighbour u (nextNeighbour u v) := by
  decide +kernel

/-- Turn a dart once around its tail. -/
def rotateDart (d : cubicGraph.Dart) : cubicGraph.Dart :=
  ⟨(d.fst, nextNeighbour d.fst d.snd), (rotationTable_spec _ _ d.adj).1⟩

/-- Turn a dart back once around its tail. -/
def unrotateDart (d : cubicGraph.Dart) : cubicGraph.Dart :=
  ⟨(d.fst, prevNeighbour d.fst d.snd), (rotationTable_spec _ _ d.adj).2.1⟩

/-- The rotation system of the drawing of `G`. -/
def rotation : cubicGraph.RotationSystem where
  rotation :=
    { toFun := rotateDart
      invFun := unrotateDart
      left_inv := fun d => Dart.ext _ _ (Prod.ext rfl (rotationTable_spec _ _ d.adj).2.2.1)
      right_inv := fun d => Dart.ext _ _ (Prod.ext rfl (rotationTable_spec _ _ d.adj).2.2.2.1) }
  fst_rotation := fun _ => rfl
  sameCycle_of_fst_eq := by
    intro d d' h
    have hadj : cubicGraph.Adj d.fst d'.snd := h ▸ d'.adj
    obtain h' | h' | h' := (rotationTable_spec _ _ d.adj).2.2.2.2 _ hadj
    · rw [show d' = d from Dart.ext _ _ (Prod.ext h.symm h')]
    · rw [show d' = rotateDart d from Dart.ext _ _ (Prod.ext h.symm h')]
      exact (Equiv.Perm.SameCycle.refl _ d).apply_right
    · rw [show d' = rotateDart (rotateDart d) from Dart.ext _ _ (Prod.ext h.symm h')]
      exact (Equiv.Perm.SameCycle.refl _ d).apply_right.apply_right

/-- Darts indexed injectively by their two ends. -/
def dartIndex (d : cubicGraph.Dart) : ℕ :=
  20 * (d.fst : ℕ) + d.snd

theorem dartIndex_injective : Function.Injective dartIndex := by
  intro d d' h
  have h₁ := d.fst.isLt
  have h₂ := d.snd.isLt
  have h₃ := d'.fst.isLt
  have h₄ := d'.snd.isLt
  simp only [dartIndex] at h
  exact Dart.ext _ _ (Prod.ext (Fin.ext (by omega)) (Fin.ext (by omega)))

set_option maxRecDepth 100000 in
theorem rotation_faceCount : rotation.faceCount = 12 := by
  rw [RotationSystem.faceCount_eq_cycleCount _ dartIndex_injective]
  decide +kernel

set_option maxRecDepth 100000 in
theorem cubicGraph_card_edgeFinset : cubicGraph.edgeFinset.card = 30 := by
  decide +kernel

/-- **The rotation system of `G` is spherical**: its Euler characteristic is
`20 - 30 + 12 = 2`. -/
theorem rotation_isSpherical : rotation.IsSpherical := by
  rw [RotationSystem.IsSpherical, RotationSystem.eulerChar, rotation_faceCount,
    cubicGraph_card_edgeFinset]
  simp

theorem exists_rotationSystem_isSpherical : ∃ R : cubicGraph.RotationSystem, R.IsSpherical :=
  ⟨rotation, rotation_isSpherical⟩

/-! ### Three-connectivity -/

/-- The neighbours of a vertex of `G`. -/
def neighbours (u : Fin 20) : Finset (Fin 20) :=
  (neighbourTable.getD u []).toFinset

set_option maxRecDepth 100000 in
theorem mem_neighbours_iff : ∀ u v : Fin 20, v ∈ neighbours u ↔ cubicGraph.Adj u v := by
  decide +kernel

/-- The vertices other than `u` and `v`. -/
def survivors (u v : Fin 20) : Finset (Fin 20) :=
  Finset.univ.filter fun x => x ≠ u ∧ x ≠ v

/-- A vertex other than `u` and `v`. -/
def startVertex (u v : Fin 20) : Fin 20 :=
  if (0 : Fin 20) ≠ u ∧ (0 : Fin 20) ≠ v then 0
  else if (1 : Fin 20) ≠ u ∧ (1 : Fin 20) ≠ v then 1 else 2

theorem startVertex_mem : ∀ u v : Fin 20, startVertex u v ∈ survivors u v := by
  decide

/-- After deleting `u` and `v`, saturation from a remaining vertex reaches every remaining
vertex. -/
def deletionCheck (u v : Fin 20) : Bool :=
  decide (survivors u v ⊆
    Mettapedia.Logic.Relation.reachSet (fun a => (neighbours a).filter (· ∈ survivors u v))
      {startVertex u v})

set_option maxRecDepth 100000 in
theorem deletionCheck_0 : ∀ v, deletionCheck 0 v = true := by decide +kernel

