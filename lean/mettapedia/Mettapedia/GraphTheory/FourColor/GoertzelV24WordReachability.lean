import Mathlib.GroupTheory.Perm.Cycle.Basic
import Mathlib.Data.Fintype.Option
import Mathlib.Data.Fintype.Card

/-!
# Word reachability for permutation families

The genus bound for a permutation pair compares orbit counts of the
subgroup generated by varying generator families: stripping a transposition
from one generator and absorbing it into another must change the number of
connected components by a controlled amount.  This module provides that
bookkeeping in elementary form: reachability by steps of a finite list of
permutations, its orbit count, and three comparison laws —

* `wordOrbitCount_le_of_le` — a family whose reachability is contained in
  another's has at least as many components;
* `wordOrbitCount_le_cons_swap_add_one` — adjoining one transposition
  destroys at most one component;
* `wordOrbitCount_cons_swap_eq_of_reachable` — adjoining a transposition of
  two already-connected points destroys none.

On a finite carrier no inverses are needed: a generator's inverse is a
positive power, so step-reachability is already symmetric.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24WordReachability

open Equiv

variable {D : Type*}

/-- One step by some generator of the family. -/
def WordStep (L : List (Perm D)) (u v : D) : Prop :=
  ∃ g ∈ L, g u = v

/-- Reachability by generator steps.  Over a finite carrier this is the
orbit relation of the generated subgroup. -/
def WordReachable (L : List (Perm D)) : D → D → Prop :=
  Relation.ReflTransGen (WordStep L)

theorem WordReachable.refl (L : List (Perm D)) (u : D) :
    WordReachable L u u :=
  Relation.ReflTransGen.refl

theorem WordReachable.trans {L : List (Perm D)} {u v w : D}
    (huv : WordReachable L u v) (hvw : WordReachable L v w) :
    WordReachable L u w :=
  Relation.ReflTransGen.trans huv hvw

theorem wordReachable_step {L : List (Perm D)} {g : Perm D}
    (hg : g ∈ L) (u : D) : WordReachable L u (g u) :=
  Relation.ReflTransGen.single ⟨g, hg, rfl⟩

/-- Iterating one generator stays reachable. -/
theorem wordReachable_pow {L : List (Perm D)} {g : Perm D}
    (hg : g ∈ L) (u : D) (n : ℕ) : WordReachable L u ((g ^ n) u) := by
  induction n with
  | zero => simpa using WordReachable.refl L u
  | succ n ih =>
      have hpow : (g ^ (n + 1)) u = g ((g ^ n) u) := by
        rw [pow_succ', Perm.mul_apply]
      rw [hpow]
      exact ih.trans (wordReachable_step hg ((g ^ n) u))

/-- Reachability is monotone in the generator family. -/
theorem wordReachable_mono {L L' : List (Perm D)}
    (h : ∀ g ∈ L, g ∈ L') {u v : D}
    (huv : WordReachable L u v) : WordReachable L' u v := by
  induction huv with
  | refl => exact WordReachable.refl L' u
  | tail _huv hstep ih =>
      obtain ⟨g, hg, rfl⟩ := hstep
      exact ih.trans (wordReachable_step (h g hg) _)

/-- If every generator of `L'` moves points only within `L`-reachability,
then all of `L'`-reachability is contained in `L`-reachability. -/
theorem wordReachable_absorb {L L' : List (Perm D)}
    (h : ∀ g ∈ L', ∀ u : D, WordReachable L u (g u)) {u v : D}
    (huv : WordReachable L' u v) : WordReachable L u v := by
  induction huv with
  | refl => exact WordReachable.refl L u
  | tail _huv hstep ih =>
      obtain ⟨g, hg, rfl⟩ := hstep
      exact ih.trans (h g hg _)

/-- On a finite carrier a single step reverses: the inverse of a generator
is a positive power of it. -/
theorem wordReachable_of_step [Fintype D] {L : List (Perm D)} {g : Perm D}
    (hg : g ∈ L) (u : D) : WordReachable L (g u) u := by
  have horder : 0 < orderOf g := orderOf_pos g
  have hcycle : (g ^ (orderOf g - 1)) (g u) = u := by
    have hcompose : (g ^ (orderOf g - 1)) (g u) = (g ^ orderOf g) u := by
      have hsum : g ^ (orderOf g - 1) * g = g ^ orderOf g := by
        rw [← pow_succ, Nat.sub_add_cancel horder]
      rw [← Perm.mul_apply, hsum]
    rw [hcompose, pow_orderOf_eq_one]
    rfl
  have := wordReachable_pow hg (g u) (orderOf g - 1)
  rwa [hcycle] at this

theorem WordReachable.symm [Fintype D] {L : List (Perm D)} {u v : D}
    (h : WordReachable L u v) : WordReachable L v u := by
  induction h with
  | refl => exact WordReachable.refl L u
  | tail _huv hstep ih =>
      obtain ⟨g, hg, rfl⟩ := hstep
      exact (wordReachable_of_step hg _).trans ih

/-- The word-reachability setoid of a generator family. -/
def wordSetoid [Fintype D] (L : List (Perm D)) : Setoid D :=
  ⟨WordReachable L,
    ⟨fun u => WordReachable.refl L u,
      fun h => h.symm,
      fun h₁ h₂ => h₁.trans h₂⟩⟩

noncomputable instance wordQuotientFintype [Fintype D]
    (L : List (Perm D)) : Fintype (Quotient (wordSetoid L)) :=
  Fintype.ofFinite _

/-- The number of connected components of the family's action. -/
noncomputable def wordOrbitCount [Fintype D] (L : List (Perm D)) : ℕ :=
  Fintype.card (Quotient (wordSetoid L))

/-- Containment of reachability relations reverses on component counts:
the coarser partition has at most as many classes. -/
theorem wordOrbitCount_le_of_le [Fintype D] {L L' : List (Perm D)}
    (h : ∀ u v : D, WordReachable L u v → WordReachable L' u v) :
    wordOrbitCount L' ≤ wordOrbitCount L := by
  classical
  have hsurj : Function.Surjective
      (Quotient.lift
        (fun u => Quotient.mk (wordSetoid L') u)
        (fun u v huv => Quotient.sound (h u v huv)) :
        Quotient (wordSetoid L) → Quotient (wordSetoid L')) := by
    intro q
    obtain ⟨z, rfl⟩ := Quotient.exists_rep q
    exact ⟨Quotient.mk (wordSetoid L) z, rfl⟩
  exact Fintype.card_le_of_surjective _ hsurj

section Merge

variable {L : List (Perm D)} {a b : D}

/-- The relation obtained from `L`-reachability by additionally merging the
components of `a` and `b`. -/
def MergedReachable (L : List (Perm D)) (a b : D) (u v : D) : Prop :=
  WordReachable L u v ∨
    (WordReachable L u a ∧ WordReachable L b v) ∨
    (WordReachable L u b ∧ WordReachable L a v)

theorem MergedReachable.of_reachable {u v : D}
    (h : WordReachable L u v) : MergedReachable L a b u v :=
  Or.inl h

theorem mergedReachable_refl (u : D) : MergedReachable L a b u u :=
  Or.inl (WordReachable.refl L u)

/-- Transitivity of the merged relation: nine elementary cases, each closed
by composing reachabilities through `a` and `b`. -/
theorem MergedReachable.trans [Fintype D] {u v w : D}
    (huv : MergedReachable L a b u v) (hvw : MergedReachable L a b v w) :
    MergedReachable L a b u w := by
  rcases huv with huv | ⟨hua, hbv⟩ | ⟨hub, hav⟩
  · rcases hvw with hvw | ⟨hva, hbw⟩ | ⟨hvb, haw⟩
    · exact Or.inl (huv.trans hvw)
    · exact Or.inr (Or.inl ⟨huv.trans hva, hbw⟩)
    · exact Or.inr (Or.inr ⟨huv.trans hvb, haw⟩)
  · rcases hvw with hvw | ⟨hva, hbw⟩ | ⟨hvb, haw⟩
    · exact Or.inr (Or.inl ⟨hua, hbv.trans hvw⟩)
    · -- b ~ v ~ a joins the bridge ends, so one component remains
      exact Or.inl (hua.trans ((hbv.trans hva).symm.trans hbw))
    · -- u ~ a and a ~ w directly
      exact Or.inl (hua.trans haw)
  · rcases hvw with hvw | ⟨hva, hbw⟩ | ⟨hvb, haw⟩
    · exact Or.inr (Or.inr ⟨hub, hav.trans hvw⟩)
    · -- u ~ b and b ~ w directly
      exact Or.inl (hub.trans hbw)
    · -- a ~ v ~ b joins the bridge ends, so one component remains
      exact Or.inl (hub.trans ((hav.trans hvb).symm.trans haw))

/-- Steps of `swap a b` land inside the merged relation. -/
theorem mergedReachable_swap_step [DecidableEq D] (u : D) :
    MergedReachable L a b u (swap a b u) := by
  rcases eq_or_ne u a with rfl | hua
  · rw [swap_apply_left]
    exact Or.inr (Or.inl ⟨WordReachable.refl L u, WordReachable.refl L b⟩)
  · rcases eq_or_ne u b with rfl | hub
    · rw [swap_apply_right]
      exact Or.inr (Or.inr ⟨WordReachable.refl L u, WordReachable.refl L a⟩)
    · rw [swap_apply_of_ne_of_ne hua hub]
      exact mergedReachable_refl u

/-- Reachability of the swap-augmented family is contained in the merged
relation. -/
theorem mergedReachable_of_cons_swap [Fintype D] [DecidableEq D] {u v : D}
    (h : WordReachable (swap a b :: L) u v) : MergedReachable L a b u v := by
  induction h with
  | refl => exact mergedReachable_refl u
  | tail _huv hstep ih =>
      obtain ⟨g, hg, rfl⟩ := hstep
      rcases List.mem_cons.mp hg with rfl | hgL
      · exact ih.trans (mergedReachable_swap_step _)
      · exact ih.trans (MergedReachable.of_reachable (wordReachable_step hgL _))

/-- **At most one component dies.**  Adjoining a single transposition to a
generator family decreases the component count by at most one. -/
theorem wordOrbitCount_le_cons_swap_add_one
    [Fintype D] [DecidableEq D] (L : List (Perm D)) (a b : D) :
    wordOrbitCount L ≤ wordOrbitCount (swap a b :: L) + 1 := by
  classical
  let F : Quotient (wordSetoid L) → Quotient (wordSetoid (swap a b :: L)) :=
    Quotient.lift (fun u => Quotient.mk (wordSetoid (swap a b :: L)) u)
      (fun u v huv => Quotient.sound
        (wordReachable_mono (fun g hg => List.mem_cons_of_mem _ hg) huv))
  have hinj : Function.Injective
      (fun q : Quotient (wordSetoid L) =>
        if q = Quotient.mk (wordSetoid L) b then none else some (F q)) := by
    intro q₁ q₂ heq
    dsimp only at heq
    by_cases h₁ : q₁ = Quotient.mk (wordSetoid L) b
    · by_cases h₂ : q₂ = Quotient.mk (wordSetoid L) b
      · rw [h₁, h₂]
      · rw [if_pos h₁, if_neg h₂] at heq
        exact absurd heq.symm (Option.some_ne_none _)
    · by_cases h₂ : q₂ = Quotient.mk (wordSetoid L) b
      · rw [if_neg h₁, if_pos h₂] at heq
        exact absurd heq (Option.some_ne_none _)
      · rw [if_neg h₁, if_neg h₂, Option.some_inj] at heq
        obtain ⟨u, rfl⟩ := Quotient.exists_rep q₁
        obtain ⟨v, rfl⟩ := Quotient.exists_rep q₂
        have huv : WordReachable (swap a b :: L) u v := Quotient.exact heq
        rcases mergedReachable_of_cons_swap huv with huv' | ⟨_, hbv⟩ | ⟨hub, _⟩
        · exact Quotient.sound huv'
        · exact absurd (Quotient.sound hbv.symm) h₂
        · exact absurd (Quotient.sound hub) h₁
  have hcard := Fintype.card_le_of_injective _ hinj
  rwa [Fintype.card_option] at hcard

/-- **No component dies when the pair is already joined.**  Adjoining a
transposition of two `L`-connected points leaves the component count
unchanged. -/
theorem wordOrbitCount_cons_swap_eq_of_reachable
    [Fintype D] [DecidableEq D] {L : List (Perm D)} {a b : D}
    (hab : WordReachable L a b) :
    wordOrbitCount (swap a b :: L) = wordOrbitCount L := by
  refine le_antisymm ?_ ?_
  · exact wordOrbitCount_le_of_le
      (fun u v huv =>
        wordReachable_mono (fun g hg => List.mem_cons_of_mem _ hg) huv)
  · refine wordOrbitCount_le_of_le (fun u v huv => ?_)
    refine wordReachable_absorb ?_ huv
    intro g hg u
    rcases List.mem_cons.mp hg with rfl | hgL
    · rcases eq_or_ne u a with rfl | hua
      · rw [swap_apply_left]
        exact hab
      · rcases eq_or_ne u b with rfl | hub
        · rw [swap_apply_right]
          exact hab.symm
        · rw [swap_apply_of_ne_of_ne hua hub]
          exact WordReachable.refl L u
    · exact wordReachable_step hgL u

end Merge

end GoertzelV24WordReachability

end Mettapedia.GraphTheory.FourColor
