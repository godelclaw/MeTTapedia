/-- A homogeneous local step generated by a compact semantic Cell letter,
after existentially restoring the shared-rung terminal. -/
def LocalLayerCompressedReceiptStep
    (current next : BoundedCorridorCutProfile 2 0 3) : Prop :=
  ∃ incoming : BoundedCorridorCutProfile 2 1 3,
    forgetBoundedTerminals incoming = current ∧
      LocalLayerCompressedOneCellDecoderStep incoming next

/-- The same compact relation on the lossless `191184`-state codec. -/
def LocalLayerCompressedReceiptCodeStep
    (current next : BoundedWidthTwoPortIncidenceProfile 3) : Prop :=
  LocalLayerCompressedReceiptStep
    (decodePortIncidenceBounded current)
    (decodePortIncidenceBounded next)

/-- Compact steps refine the previously declared raw receipt
over-approximation. -/
theorem localLayerFiniteReceiptStep_of_compressed
    {current next : BoundedCorridorCutProfile 2 0 3}
    (hstep : LocalLayerCompressedReceiptStep current next) :
    LocalLayerFiniteReceiptStep current next := by
  rcases hstep with ⟨incoming, hforget, hcompact⟩
  refine ⟨incoming, hforget, ?_⟩
  exact receipt_of_exists_letter_decode_eq_some
    (localLayerFiniteOneCellDecoderStep_of_compressed hcompact)

/-- Exact transport of a semantic compact raw step to the executable profile
codec. -/
theorem localLayerCompressedReceiptCodeStep_of_raw
    (current next : BoundedCorridorCutProfile 2 0 3)
    (hcurrent : BoundedIsPortIncidenceSemantic current)
    (hnext : BoundedIsPortIncidenceSemantic next)
    (hstep : LocalLayerCompressedReceiptStep current next) :
    LocalLayerCompressedReceiptCodeStep
      (compressPortIncidenceBounded current hcurrent)
      (compressPortIncidenceBounded next hnext) := by
  simpa [LocalLayerCompressedReceiptCodeStep,
    decodePortIncidenceBounded_compressPortIncidenceBounded]

