def edgeAt (es : List (Nat × Nat)) (k : Nat) : Nat × Nat := es.getD k (0, 0)
def colourAt (c : List Nat) (k : Nat) : Nat := c.getD k 3
def incident (es : List (Nat × Nat)) (v : Nat) : List Nat :=
  (List.range es.length).filter fun k => (edgeAt es k).1 == v || (edgeAt es k).2 == v
def properAt (es : List (Nat × Nat)) (c : List Nat) (v : Nat) : Bool :=
  match (incident es v).map (colourAt c) with
  | [a, b, d] => a != b && b != d && a != d && a < 3 && b < 3 && d < 3
  | _ => false
def fullProper : Bool := (List.range 20).all fun v => properAt allEdges fullColouring v
def trailProper (c : List Nat) : Bool :=
  c.length == 29 && (List.range 20).all fun v =>
    if v == 3 || v == 8 then
      match (incident edges v).map (colourAt c) with
      | [a, b] => a == b && a < 3
      | _ => false
    else properAt edges c v

/-- an edge of the pair's colours joining `w` to some vertex of `pre` -/
def joined (c : List Nat) (a b : Nat) (pre : List Nat) (w : Nat) : Bool :=
  (List.range 29).any fun k =>
    let x := colourAt c k
    (x == a || x == b) &&
      ((edgeAt edges k).1 == w && (edgeAt edges k).2 ∈ pre ||
       (edgeAt edges k).2 == w && (edgeAt edges k).1 ∈ pre)

/-- the block is connected: each vertex after the first is joined to an earlier one -/
def connectedBlock (c : List Nat) (a b : Nat) : List Nat → Bool
  | [] => false
  | v :: rest => go [v] rest
where
  go (pre : List Nat) : List Nat → Bool
    | [] => true
    | w :: ws => joined c a b pre w && go (pre ++ [w]) ws

def switchBlock (c : List Nat) (a b : Nat) (blk : List Nat) : List Nat :=
  (List.range 29).map fun k =>
    let x := colourAt c k
    if (x == a || x == b) && (edgeAt edges k).1 ∈ blk then (if x == a then b else a) else x

/-- blocks partition the 20 vertices and contain both ends of every pair-coloured edge -/
def partitionOk (c : List Nat) (a b : Nat) (blocks : List (List Nat × Nat)) : Bool :=
  (List.range 20).all (fun v => (blocks.filter fun bl => v ∈ bl.1).length == 1) &&
  (List.range 29).all fun k =>
    let x := colourAt c k
    !(x == a || x == b) || blocks.any fun bl => (edgeAt edges k).1 ∈ bl.1 && (edgeAt edges k).2 ∈ bl.1

def pairOk (c : List Nat) (a b : Nat) (blocks : List (List Nat × Nat)) : Bool :=
  partitionOk c a b blocks &&
  blocks.all (fun bl => connectedBlock c a b bl.1 &&
    !(3 ∈ bl.1 && 8 ∈ bl.1) &&
    trail.getD bl.2 [] == switchBlock c a b bl.1)

def allOk : Bool :=
  fullProper && trail.length == 36 && cert.length == 36 &&
  (List.range 36).all fun i =>
    let c := trail.getD i []
    let pp := cert.getD i []
    trailProper c && pp.length == 3 &&
    pairOk c 0 1 (pp.getD 0 []) && pairOk c 0 2 (pp.getD 1 []) && pairOk c 1 2 (pp.getD 2 [])

set_option maxRecDepth 100000 in
set_option maxHeartbeats 0 in
theorem all_ok : allOk = true := by decide +kernel

end Mettapedia.GraphTheory.FourColor.KauffmanTrailCounterexample
