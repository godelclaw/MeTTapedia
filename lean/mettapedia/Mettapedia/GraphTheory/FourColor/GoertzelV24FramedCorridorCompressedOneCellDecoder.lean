import Mettapedia.GraphTheory.FourColor.GoertzelV24FiniteHexCellProfileCompression
import Mettapedia.GraphTheory.FourColor.GoertzelV24FramedCorridorFiniteOneCellDecoder

/-!
# A compact literal-Cell field for the deterministic one-Cell decoder

The existing terminal-aware decoder stores a raw six-edge Cell profile whose
three tracked-connectivity matrices are arbitrary Boolean functions.  This
module replaces only that field by the lossless graph-semantic Cell code.  It
reuses the existing decoder for all terminal, face-role, incidence, and capped
face-progress coordinates.

Every compact letter expands to an existing raw letter, so compact steps add
no behavior beyond the declared receipt over-approximation.  Conversely every
raw letter whose Cell profile obeys the proved graph laws compresses with the
same decoder result.  Arbitrary compact codes are not claimed geometrically
realizable, and no boundary-rebase composition, reachable closure, threshold,
or bounded base is asserted here.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24FramedTrail

open GoertzelV24BoundaryProfileFiniteState
open GoertzelV24FiniteHexCellProfileCompression

/-- The terminal-aware one-Cell alphabet with its raw Cell matrix replaced by
the flat, lossless semantic code. -/
structure LocalLayerCompressedOneCellLetterCode where
  inputCount : Fin 4
  cellCode : FiniteHexCellProfileCode
  geometry : LocalLayerFiniteConnectivityGeometryCode
  roleIndex : LocalLayerRightFaceRole ≃ Fin 3
  faceUpdate : LocalLayerFiniteFaceUpdateCode inputCount.val

noncomputable instance : DecidableEq LocalLayerCompressedOneCellLetterCode :=
  Classical.decEq _

private def localLayerCompressedOneCellLetterCodeEquiv :
    LocalLayerCompressedOneCellLetterCode ≃
      Σ inputCount : Fin 4,
        FiniteHexCellProfileCode ×
          LocalLayerFiniteConnectivityGeometryCode ×
          (LocalLayerRightFaceRole ≃ Fin 3) ×
          LocalLayerFiniteFaceUpdateCode inputCount.val where
  toFun code :=
    ⟨code.inputCount, code.cellCode, code.geometry, code.roleIndex,
      code.faceUpdate⟩
  invFun code :=
    { inputCount := code.1
      cellCode := code.2.1
      geometry := code.2.2.1
      roleIndex := code.2.2.2.1
      faceUpdate := code.2.2.2.2 }
  left_inv _ := rfl
  right_inv _ := rfl

noncomputable instance : Fintype LocalLayerCompressedOneCellLetterCode :=
  Fintype.ofEquiv _ localLayerCompressedOneCellLetterCodeEquiv.symm

/-- Expand the compact Cell field and reuse the established five-coordinate
decoder unchanged. -/
def LocalLayerCompressedOneCellLetterCode.toRaw
    (code : LocalLayerCompressedOneCellLetterCode) :
    LocalLayerFiniteOneCellLetterCode where
  inputCount := code.inputCount
  cellProfile := decode code.cellCode
  geometry := code.geometry
  roleIndex := code.roleIndex
  faceUpdate := code.faceUpdate

/-- Apply a compact letter through the established raw decoder. -/
noncomputable def LocalLayerCompressedOneCellLetterCode.decode
    (code : LocalLayerCompressedOneCellLetterCode)
    (input : BoundedCorridorCutProfile 2 1 3) :
    Option (BoundedCorridorCutProfile 2 0 3) :=
  code.toRaw.decode input

/-- The graph-free finite step generated by compact one-Cell letters. -/
def LocalLayerCompressedOneCellDecoderStep
    (input : BoundedCorridorCutProfile 2 1 3)
    (output : BoundedCorridorCutProfile 2 0 3) : Prop :=
  ∃ code : LocalLayerCompressedOneCellLetterCode,
    code.decode input = some output

/-- Compress one raw letter when its Cell field satisfies the exact graph
laws. -/
noncomputable def LocalLayerFiniteOneCellLetterCode.compress
    (code : LocalLayerFiniteOneCellLetterCode)
    (semantic : IsGraphSemantic code.cellProfile) :
    LocalLayerCompressedOneCellLetterCode where
  inputCount := code.inputCount
  cellCode := encode code.cellProfile semantic
  geometry := code.geometry
  roleIndex := code.roleIndex
  faceUpdate := code.faceUpdate

@[simp]
theorem LocalLayerFiniteOneCellLetterCode.toRaw_compress
    (code : LocalLayerFiniteOneCellLetterCode)
    (semantic : IsGraphSemantic code.cellProfile) :
    (code.compress semantic).toRaw = code := by
  cases code
  simp [LocalLayerFiniteOneCellLetterCode.compress,
    LocalLayerCompressedOneCellLetterCode.toRaw, decode_encode]

/-- Every compact step is already a step of the declared raw receipt
over-approximation. -/
theorem localLayerFiniteOneCellDecoderStep_of_compressed
    {input : BoundedCorridorCutProfile 2 1 3}
    {output : BoundedCorridorCutProfile 2 0 3}
    (hstep : LocalLayerCompressedOneCellDecoderStep input output) :
    LocalLayerFiniteOneCellDecoderStep input output := by
  rcases hstep with ⟨code, hdecode⟩
  exact ⟨code.toRaw, hdecode⟩

/-- A raw decoder witness with a semantic Cell field has an identical compact
witness.  This is the lossless direction used by later source coverage. -/
theorem localLayerCompressedOneCellDecoderStep_of_semantic_raw
    {input : BoundedCorridorCutProfile 2 1 3}
    {output : BoundedCorridorCutProfile 2 0 3}
    (code : LocalLayerFiniteOneCellLetterCode)
    (semantic : IsGraphSemantic code.cellProfile)
    (hdecode : code.decode input = some output) :
    LocalLayerCompressedOneCellDecoderStep input output := by
  refine ⟨code.compress semantic, ?_⟩
  simpa [LocalLayerCompressedOneCellLetterCode.decode] using hdecode

end GoertzelV24FramedTrail

end Mettapedia.GraphTheory.FourColor
