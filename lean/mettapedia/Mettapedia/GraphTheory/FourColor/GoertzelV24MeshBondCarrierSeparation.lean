import Mettapedia.GraphTheory.FourColor.GoertzelV24BondDepthObligation

/-!
# Which bonds of the ordered mesh can be compared at all

`GoertzelV24FacialBondLaminarity` compares two residual-site facial bonds only
when their alternating carriers are disjoint, and the mesh construction
`exists_exchangeRigid_with_facialBond_at_every_globalMeshStep` does not say
that they are.  This file settles when that hypothesis is available.

The carriers are equivalence classes: `ProperAlternatingComponentWitness`
records `carrier = alternatingComponent sigma tau first`, and
`alternatingComponent` is the class of `first` under the relation generated by
the two partner maps.  Two classes of **one** relation are equal or disjoint,
so two bonds built from the *same* second pairing `tau` are automatically
comparable unless they are literally the same carrier
(`bond_faces_crossFree_of_tau_eq_of_carrier_ne`).  That replaces an unsupplied
geometric hypothesis by a bookkeeping one.

But the second pairing is a field of the witness, not a global choice, and it
cannot be made global along a mesh row.  `tau` is a *perfect* matching — a
fixed-point-free involution — and it is central at the site, so
`tau.partner first = second`.  Two sites sharing a vertex therefore force
`tau.partner` to send that shared vertex to two different places, which an
involution cannot do: `tau_ne_of_shared_vertex_sites`.  Consecutive steps of a
mesh row share a vertex and have distinct outer endpoints
(`rowVertexInjective`), so `tau_ne_at_consecutive_globalRowSteps` shows the two
bonds there are built from genuinely different pairings and the comparability
criterion above does not reach them.

The consequence is exact, and it is a gap that sits *before* the combinatorial
one.  A family of mesh bonds that this mechanism compares at all must be
indexed by pairwise non-adjacent mesh steps, with one perfect matching central
at all of them simultaneously; the mesh construction chooses its second pairing
one step at a time and supplies no such common matching.  Even granting it, the
family would only be laminar, and laminarity by itself yields no chain — see
`CrossFreeLaminarChain.singletonFamily_chain_length_le_one`.  Two hypotheses are
therefore missing, not one.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24MeshBondCarrierSeparation

open Mettapedia.GraphTheory.CrossFreeLaminarChain
open GoertzelV24AlternatingMatchingComponent
open GoertzelV24FacialBondLaminarity
open GoertzelV24MeshIsoperimetry
open GoertzelV24OrderedInjectiveMeshWidthFactorization
open GoertzelV24OrderedMeshGlobalSites
open GoertzelV24OrderedMeshResidualSiteFacialBond
open GoertzelV24RotationMultigraphAdapter
open GoertzelV24TwoEdgeCutMinimality
open MatchingParity
open SimpleGraphDartRotation

noncomputable section

universe u

variable {V : Type u} [Fintype V] [DecidableEq V]
  {G : SimpleGraph V} [DecidableRel G.Adj] {a b : Nat}

/-! ## One second pairing makes its carriers comparable -/

/-- Alternating components of one pair of pairings are equivalence classes, so
two of them are equal or disjoint. -/
theorem alternatingComponent_eq_or_disjoint
    (sigma tau : Pairing V) (rootOne rootTwo : V) :
    alternatingComponent sigma tau rootOne =
        alternatingComponent sigma tau rootTwo ∨
      Disjoint (alternatingComponent sigma tau rootOne)
        (alternatingComponent sigma tau rootTwo) := by
  classical
  by_cases hshared :
      ∃ vertex : V,
        vertex ∈ alternatingComponent sigma tau rootOne ∧
          vertex ∈ alternatingComponent sigma tau rootTwo
  · obtain ⟨vertex, hone, htwo⟩ := hshared
    rw [mem_alternatingComponent_iff] at hone htwo
    have hlink : Relation.EqvGen (AlternatingStep sigma tau) rootOne rootTwo :=
      hone.trans _ _ _ htwo.symm
    refine Or.inl (Finset.ext fun target => ?_)
    rw [mem_alternatingComponent_iff, mem_alternatingComponent_iff]
    constructor
    · intro h
      exact (hlink.symm).trans _ _ _ h
    · intro h
      exact hlink.trans _ _ _ h
  · refine Or.inr (Finset.disjoint_left.mpr fun vertex hone htwo => ?_)
    exact hshared ⟨vertex, hone, htwo⟩

/-- Two residual-site bonds built from the same second pairing have carriers
that are equal or disjoint.  Nothing geometric is used: the carriers are
classes of one relation. -/
theorem carrier_eq_or_disjoint_of_tau_eq
    {rotation : Data G} {sigma : Pairing V}
    {firstOne secondOne firstTwo secondTwo : V}
    (bondOne : ProperAlternatingSiteFacialBondWitness rotation sigma
      firstOne secondOne)
    (bondTwo : ProperAlternatingSiteFacialBondWitness rotation sigma
      firstTwo secondTwo)
    (htau : bondOne.site.tau = bondTwo.site.tau) :
    bondOne.site.carrier = bondTwo.site.carrier ∨
      Disjoint bondOne.site.carrier bondTwo.site.carrier := by
  rw [bondOne.site.carrier_eq, bondTwo.site.carrier_eq, htau]
  exact alternatingComponent_eq_or_disjoint sigma bondTwo.site.tau firstOne firstTwo

/-- **The usable comparability criterion.**  Two residual-site facial bonds of
one global pairing that are built from the same second pairing and have
different carriers have cross-free face sets.  This discharges the geometric
disjointness hypothesis of `bond_faces_laminar_of_disjoint_carriers` from a
bookkeeping condition on the witnesses. -/
theorem bond_faces_crossFree_of_tau_eq_of_carrier_ne
    (rotation : Data G)
    (minimal : GraphBackedVertexMinimalTaitCounterexample rotation)
    {sigma : Pairing V} {firstOne secondOne firstTwo secondTwo : V}
    (bondOne : ProperAlternatingSiteFacialBondWitness rotation sigma
      firstOne secondOne)
    (bondTwo : ProperAlternatingSiteFacialBondWitness rotation sigma
      firstTwo secondTwo)
    (htau : bondOne.site.tau = bondTwo.site.tau)
    (hcarrier : bondOne.site.carrier ≠ bondTwo.site.carrier) :
    CrossFreePair bondOne.faces bondTwo.faces := by
  rcases carrier_eq_or_disjoint_of_tau_eq bondOne bondTwo htau with heq | hdisj
  · exact absurd heq hcarrier
  · exact bond_faces_laminar_of_disjoint_carriers rotation minimal
      bondOne bondTwo hdisj

/-! ## The second pairing cannot be shared along a row -/

/-- **The obstruction.**  A second pairing is central at its site, so it sends
the site's first vertex to its second.  Two sites sharing a vertex would make
the same involution send that vertex to two different places, which it cannot
do.  Hence bonds at two sites sharing a vertex are built from different second
pairings, and `bond_faces_crossFree_of_tau_eq_of_carrier_ne` does not apply to
them. -/
theorem tau_ne_of_shared_vertex_sites
    {rotation : Data G} {sigma : Pairing V} {left middle right : V}
    (bondOne : ProperAlternatingSiteFacialBondWitness rotation sigma left middle)
    (bondTwo : ProperAlternatingSiteFacialBondWitness rotation sigma middle right)
    (hne : left ≠ right) :
    bondOne.site.tau ≠ bondTwo.site.tau := by
  intro htau
  apply hne
  have hleft : bondTwo.site.tau.partner left = middle := by
    rw [← htau]; exact bondOne.site.central
  have hmiddle : bondTwo.site.tau.partner middle = right := bondTwo.site.central
  calc left = bondTwo.site.tau.partner (bondTwo.site.tau.partner left) :=
        (bondTwo.site.tau.partner_partner left).symm
    _ = bondTwo.site.tau.partner middle := by rw [hleft]
    _ = right := hmiddle

/-! ## Consecutive row steps of an ordered mesh -/

variable (rotation : Data G)
  (ordered : OrderedInjectiveMesh (toMultigraph rotation.toRotationSystem) a b)

/-- The forward step after `step` in the same row, when there is one. -/
def nextRowStep (row : Fin a) (step : Fin ((ordered.toMesh.row row).len))
    (hnext : (step : Nat) + 1 < (ordered.toMesh.row row).len) :
    Fin ((ordered.toMesh.row row).len) :=
  ⟨(step : Nat) + 1, hnext⟩

/-- Consecutive row steps share the middle vertex. -/
theorem globalSecondVertex_eq_globalFirstVertex_nextRowStep
    (row : Fin a) (step : Fin ((ordered.toMesh.row row).len))
    (hnext : (step : Nat) + 1 < (ordered.toMesh.row row).len) :
    globalSecondVertex rotation ordered (Sum.inl ⟨row, step⟩) =
      globalFirstVertex rotation ordered
        (Sum.inl ⟨row, nextRowStep rotation ordered row step hnext⟩) := by
  show (ordered.toMesh.row row).vert step.succ =
    (ordered.toMesh.row row).vert (nextRowStep rotation ordered row step hnext).castSucc
  exact congrArg _ (Fin.ext (by simp [nextRowStep]))

/-- Consecutive row steps have distinct outer endpoints, because the row path
visits distinct vertices. -/
theorem globalFirstVertex_ne_globalSecondVertex_nextRowStep
    (row : Fin a) (step : Fin ((ordered.toMesh.row row).len))
    (hnext : (step : Nat) + 1 < (ordered.toMesh.row row).len) :
    globalFirstVertex rotation ordered (Sum.inl ⟨row, step⟩) ≠
      globalSecondVertex rotation ordered
        (Sum.inl ⟨row, nextRowStep rotation ordered row step hnext⟩) := by
  intro heq
  have hindex :
      step.castSucc = (nextRowStep rotation ordered row step hnext).succ :=
    ordered.rowVertexInjective row heq
  have hval : (step : Nat) = (step : Nat) + 1 + 1 := by
    simpa [nextRowStep] using congrArg Fin.val hindex
  omega

/-- **The mesh-level obstruction.**  At two consecutive steps of one ordered
mesh row, any two residual-site facial bonds of one global pairing are built
from different second pairings.  So the comparability criterion of this file
never applies to a consecutive pair, and a family of mesh bonds it does reach
must be indexed by pairwise non-adjacent steps carrying one common perfect
matching. -/
theorem tau_ne_at_consecutive_globalRowSteps
    {sigma : Pairing V} (row : Fin a)
    (step : Fin ((ordered.toMesh.row row).len))
    (hnext : (step : Nat) + 1 < (ordered.toMesh.row row).len)
    (bondOne : ProperAlternatingSiteFacialBondWitness rotation sigma
      (globalFirstVertex rotation ordered (Sum.inl ⟨row, step⟩))
      (globalSecondVertex rotation ordered (Sum.inl ⟨row, step⟩)))
    (bondTwo : ProperAlternatingSiteFacialBondWitness rotation sigma
      (globalFirstVertex rotation ordered
        (Sum.inl ⟨row, nextRowStep rotation ordered row step hnext⟩))
      (globalSecondVertex rotation ordered
        (Sum.inl ⟨row, nextRowStep rotation ordered row step hnext⟩))) :
    bondOne.site.tau ≠ bondTwo.site.tau := by
  have hshared :=
    globalSecondVertex_eq_globalFirstVertex_nextRowStep rotation ordered row step hnext
  have hdistinct :=
    globalFirstVertex_ne_globalSecondVertex_nextRowStep rotation ordered row step hnext
  exact tau_ne_of_shared_vertex_sites (hshared ▸ bondOne) bondTwo hdistinct

end

end GoertzelV24MeshBondCarrierSeparation

end Mettapedia.GraphTheory.FourColor

