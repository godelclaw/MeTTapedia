import Mettapedia.GraphTheory.FourColor.GoertzelV24AnnularFrontierMenuCapComposed

/-!
# Literal cap restoration computes the composed relation

The composed relation was defined as a closure of two pairings.  The source's
lemma says that closure is not an abstraction: it is exactly connectivity in the
graph obtained by literally putting the five cap edges back.

The argument is an alternation.  A bichromatic walk in the restored graph runs
alternately through maximal stretches inside the open tangle and single restored
cap edges.  Every cap edge has both endpoints on the inner boundary, so each
tangle stretch begins and ends on the boundary -- that is, each stretch is a
generator of the open strand pairing, and each cap edge is a generator of the
cap pairing.

That observation is not about caps at all, so the first half of this file proves
it for an arbitrary union of two relations in which the second only ever touches
a distinguished boundary set.  The cap instance then only has to supply the fact
that a restored cap edge joins two boundary positions.

The second half identifies the literal cap connectivity with the block
description used by the transverse-chord criterion.  This needs care at one
point: the *inactive* position is not a dead end.  Its spoke colour lies outside
the selected pair, but both of its cap edges are selected, so a bichromatic walk
runs straight through it.  The literal cap components on all five positions are
therefore `{v+4, v, v+1}` and `{v+2, v+3}`, and only after deleting the inactive
position do they become the two blocks `{v+4, v+1}` and `{v+2, v+3}` that the
criterion pairs.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24AnnularFrontierMenuCapRestoration

open GoertzelV24AnnularFrontierMenuCapMatching
open GoertzelV24AnnularFrontierMenuCapComposed

/-! ## The generic alternation lemma -/

section Generic

variable {α : Type*} {R₁ R₂ : α → α → Prop} {B : α → Prop}

/-- One generator of the boundary-composed relation: a stretch of `R₁` between
two boundary points, or a single `R₂` step. -/
def BoundaryStep (R₁ R₂ : α → α → Prop) (B : α → Prop) (u w : α) : Prop :=
  (B u ∧ B w ∧ Relation.ReflTransGen R₁ u w) ∨ R₂ u w

/-- The relation generated by those stretches. -/
def BoundaryComposed (R₁ R₂ : α → α → Prop) (B : α → Prop) : α → α → Prop :=
  Relation.ReflTransGen (BoundaryStep R₁ R₂ B)

/-- **Decomposition.**  Anything reachable in the union is reachable by `R₁`
from a boundary point which the composed relation already identifies with the
start.  This is the invariant that makes the alternation argument an induction.
-/
theorem exists_boundary_of_reachable
    (hB : ∀ u w : α, R₂ u w → B u ∧ B w) {a b : α} (ha : B a)
    (h : Relation.ReflTransGen (fun u w => R₁ u w ∨ R₂ u w) a b) :
    ∃ c : α, B c ∧ BoundaryComposed R₁ R₂ B a c ∧ Relation.ReflTransGen R₁ c b := by
  induction h with
  | refl => exact ⟨a, ha, Relation.ReflTransGen.refl, Relation.ReflTransGen.refl⟩
  | tail hau huw ih =>
      obtain ⟨c, hc, hcomp, hrun⟩ := ih
      rcases huw with h1 | h2
      · exact ⟨c, hc, hcomp, hrun.tail h1⟩
      · obtain ⟨hu, hw⟩ := hB _ _ h2
        refine ⟨_, hw, ?_, Relation.ReflTransGen.refl⟩
        exact (hcomp.tail (Or.inl ⟨hc, hu, hrun⟩)).tail (Or.inr h2)

/-- **Literal reachability refines to the composed relation** between boundary
points. -/
theorem boundaryComposed_of_reachable
    (hB : ∀ u w : α, R₂ u w → B u ∧ B w) {a b : α} (ha : B a) (hb : B b)
    (h : Relation.ReflTransGen (fun u w => R₁ u w ∨ R₂ u w) a b) :
    BoundaryComposed R₁ R₂ B a b := by
  obtain ⟨c, hc, hcomp, hrun⟩ := exists_boundary_of_reachable hB ha h
  exact hcomp.tail (Or.inl ⟨hc, hb, hrun⟩)

/-- The converse is immediate: every generator is witnessed inside the union. -/
theorem reachable_of_boundaryComposed {a b : α}
    (h : BoundaryComposed R₁ R₂ B a b) :
    Relation.ReflTransGen (fun u w => R₁ u w ∨ R₂ u w) a b := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail hab hbc ih =>
      refine ih.trans ?_
      rcases hbc with ⟨-, -, hrun⟩ | hstep
      · exact hrun.mono fun _ _ hr => Or.inl hr
      · exact Relation.ReflTransGen.single (Or.inr hstep)

/-- **Cap restoration computes the closure.**  Between boundary points, literal
reachability in the union and the boundary-composed closure agree. -/
theorem boundaryComposed_iff_reachable
    (hB : ∀ u w : α, R₂ u w → B u ∧ B w) {a b : α} (ha : B a) (hb : B b) :
    BoundaryComposed R₁ R₂ B a b ↔
      Relation.ReflTransGen (fun u w => R₁ u w ∨ R₂ u w) a b :=
  ⟨reachable_of_boundaryComposed, boundaryComposed_of_reachable hB ha hb⟩

end Generic

/-! ## The cap instance -/

variable {v : Fin 5}

/-- A single restored cap edge, as a step between boundary positions.  Only the
selected cap edges carry the chosen colour pair, and by `selected_iff` those are
exactly the three at `v+4`, `v` and `v+2`. -/
def CapStep (v : Fin 5) (i j : Fin 5) : Prop :=
  (j = i + 1 ∧ (i = v + 4 ∨ i = v ∨ i = v + 2)) ∨
    (i = j + 1 ∧ (j = v + 4 ∨ j = v ∨ j = v + 2))

instance (v i j : Fin 5) : Decidable (CapStep v i j) := by unfold CapStep; infer_instance

/-- Literal connectivity through restored cap edges. -/
def CapConn (v : Fin 5) : Fin 5 → Fin 5 → Prop := Relation.ReflTransGen (CapStep v)

/-- The literal cap component containing the inactive position.  Unlike the
block used by the criterion this has three elements, because a bichromatic walk
passes straight through the inactive position. -/
def CapComponent (v : Fin 5) (i : Fin 5) : Prop := i = v + 4 ∨ i = v ∨ i = v + 1

instance (v i : Fin 5) : Decidable (CapComponent v i) := by
  unfold CapComponent; infer_instance

/-- A restored cap edge never leaves its literal component. -/
theorem capComponent_iff_of_capStep {i j : Fin 5} (h : CapStep v i j) :
    CapComponent v i ↔ CapComponent v j := by
  revert h
  have key : ∀ u i j : Fin 5,
      (((j = i + 1 ∧ (i = u + 4 ∨ i = u ∨ i = u + 2)) ∨
        (i = j + 1 ∧ (j = u + 4 ∨ j = u ∨ j = u + 2))) →
        ((i = u + 4 ∨ i = u ∨ i = u + 1) ↔ (j = u + 4 ∨ j = u ∨ j = u + 1))) := by decide
  exact key v i j

/-- Hence literal cap connectivity respects the components. -/
theorem capComponent_iff_of_capConn {i j : Fin 5} (h : CapConn v i j) :
    CapComponent v i ↔ CapComponent v j := by
  induction h with
  | refl => exact Iff.rfl
  | tail hab hbc ih => exact ih.trans (capComponent_iff_of_capStep hbc)

private theorem capStep_symm {i j : Fin 5} (h : CapStep v i j) : CapStep v j i := by
  rcases h with ⟨h1, h2⟩ | ⟨h1, h2⟩
  · exact Or.inr ⟨h1, h2⟩
  · exact Or.inl ⟨h1, h2⟩

theorem capConn_symm {i j : Fin 5} (h : CapConn v i j) : CapConn v j i := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail hab hbc ih =>
      exact Relation.ReflTransGen.trans
        (Relation.ReflTransGen.single (capStep_symm hbc)) ih

private theorem fin5_wrap (u : Fin 5) : u = u + 4 + 1 := by revert u; decide

private theorem fin5_succ (u : Fin 5) : u + 3 = u + 2 + 1 := by revert u; decide

private theorem not_capBlock_two (u : Fin 5) : ¬ CapBlock u (u + 2) := by
  have key : ∀ w : Fin 5, ¬ (w + 2 = w + 4 ∨ w + 2 = w + 1) := by decide
  exact key u

private theorem not_capBlock_three (u : Fin 5) : ¬ CapBlock u (u + 3) := by
  have key : ∀ w : Fin 5, ¬ (w + 3 = w + 4 ∨ w + 3 = w + 1) := by decide
  exact key u

/-- The literal cap walk `v+4 — v — v+1`, which runs *through* the inactive
position: its spoke colour is outside the pair, but both its cap edges are
selected. -/
theorem capConn_block_one (v : Fin 5) : CapConn v (v + 4) (v + 1) := by
  have h1 : CapStep v (v + 4) v := Or.inl ⟨fin5_wrap v, Or.inl rfl⟩
  have h2 : CapStep v v (v + 1) := Or.inl ⟨rfl, Or.inr (Or.inl rfl)⟩
  exact (Relation.ReflTransGen.single h1).tail h2

/-- The remaining selected cap edge. -/
theorem capConn_block_two (v : Fin 5) : CapConn v (v + 2) (v + 3) :=
  Relation.ReflTransGen.single (Or.inl ⟨fin5_succ v, Or.inr (Or.inr rfl)⟩)

/-- Every active position is cap-connected to the representative of its block. -/
theorem capConn_rep (v : Fin 5) {i : Fin 5} (hi : i ≠ v) :
    (CapBlock v i ∧ CapConn v i (v + 4)) ∨ (¬ CapBlock v i ∧ CapConn v i (v + 2)) := by
  have hcases : ∀ u a : Fin 5, a ≠ u →
      a = u + 4 ∨ a = u + 1 ∨ a = u + 2 ∨ a = u + 3 := by decide
  rcases hcases v i hi with rfl | rfl | rfl | rfl
  · exact Or.inl ⟨Or.inl rfl, Relation.ReflTransGen.refl⟩
  · exact Or.inl ⟨Or.inr rfl, capConn_symm (capConn_block_one v)⟩
  · exact Or.inr ⟨not_capBlock_two v, Relation.ReflTransGen.refl⟩
  · exact Or.inr ⟨not_capBlock_three v, capConn_symm (capConn_block_two v)⟩

/-- **Literal cap connectivity is the criterion's block relation, on the active
positions.**  The two descriptions differ only at the inactive position, which
the criterion never queries. -/
theorem capConn_iff_capPairRel {i j : Fin 5} (hi : i ≠ v) (hj : j ≠ v) :
    CapConn v i j ↔ CapPairRel v i j := by
  constructor
  · intro h
    have hcomp := capComponent_iff_of_capConn h
    have key : ∀ u a b : Fin 5, a ≠ u → b ≠ u →
        (((a = u + 4 ∨ a = u ∨ a = u + 1) ↔ (b = u + 4 ∨ b = u ∨ b = u + 1)) →
          ((a = u + 4 ∨ a = u + 1) ↔ (b = u + 4 ∨ b = u + 1))) := by decide
    exact key v i j hi hj hcomp
  · intro h
    rcases capConn_rep v hi with ⟨hbi, hci⟩ | ⟨hbi, hci⟩ <;>
      rcases capConn_rep v hj with ⟨hbj, hcj⟩ | ⟨hbj, hcj⟩
    · exact hci.trans (capConn_symm hcj)
    · exact absurd (h.mp hbi) hbj
    · exact absurd (h.mpr hbj) hbi
    · exact hci.trans (capConn_symm hcj)

/-! ## The restored graph, literally -/

/-- One bichromatic step in the graph with the five cap edges put back: either
a strand of the open tangle, or a restored cap edge. -/
def RestoredStep (strand : Fin 5 → Fin 5 → Prop) (v : Fin 5) (a b : Fin 5) : Prop :=
  (a ≠ v ∧ b ≠ v ∧ (strand a b ∨ strand b a)) ∨ CapStep v a b

/-- Literal bichromatic reachability in the restored graph. -/
def RestoredReachable (strand : Fin 5 → Fin 5 → Prop) (v : Fin 5) :
    Fin 5 → Fin 5 → Prop :=
  Relation.ReflTransGen (RestoredStep strand v)

theorem restoredReachable_of_capConn {strand : Fin 5 → Fin 5 → Prop} {i j : Fin 5}
    (h : CapConn v i j) : RestoredReachable strand v i j :=
  h.mono fun _ _ hs => Or.inr hs

theorem restoredReachable_symm {strand : Fin 5 → Fin 5 → Prop} {i j : Fin 5}
    (h : RestoredReachable strand v i j) : RestoredReachable strand v j i := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail hab hbc ih =>
      refine Relation.ReflTransGen.trans (Relation.ReflTransGen.single ?_) ih
      rcases hbc with ⟨h1, h2, h3⟩ | hcap
      · exact Or.inl ⟨h2, h1, h3.symm⟩
      · exact Or.inr (capStep_symm hcap)

/-- **Menu B, read on the restored graph.**  Two active positions that the
restored bichromatic reachability does not identify. -/
def RestoredMenuB (strand : Fin 5 → Fin 5 → Prop) (v : Fin 5) : Prop :=
  ∃ i j : Fin 5, i ≠ v ∧ j ≠ v ∧ ¬ RestoredReachable strand v i j

/-- On the active positions the literal cap component and the criterion's block
agree, so the component is the right invariant to carry along a restored walk. -/
theorem capComponent_iff_capBlock {i : Fin 5} (hi : i ≠ v) :
    CapComponent v i ↔ CapBlock v i := by
  revert hi
  have key : ∀ u a : Fin 5, a ≠ u →
      ((a = u + 4 ∨ a = u ∨ a = u + 1) ↔ (a = u + 4 ∨ a = u + 1)) := by decide
  exact key v i

/-- With no transverse chord, the literal cap component survives every restored
step -- cap edges by construction, strands because they stay inside a block. -/
theorem capComponent_iff_of_restoredReachable {strand : Fin 5 → Fin 5 → Prop}
    (hstrand : ∀ a b : Fin 5, strand a b → a ≠ v ∧ b ≠ v)
    (hno : ¬ TransverseChord strand v) {i j : Fin 5}
    (h : RestoredReachable strand v i j) :
    CapComponent v i ↔ CapComponent v j := by
  have hpres : ∀ a b : Fin 5, strand a b → (CapComponent v a ↔ CapComponent v b) := by
    intro a b hs
    obtain ⟨ha, hb⟩ := hstrand a b hs
    refine (capComponent_iff_capBlock ha).trans (Iff.trans ?_ (capComponent_iff_capBlock hb).symm)
    by_contra hcontra
    exact hno ⟨a, b, ha, hb, hs, hcontra⟩
  induction h with
  | refl => exact Iff.rfl
  | tail hab hbc ih =>
      refine ih.trans ?_
      rcases hbc with ⟨-, -, hs | hs⟩ | hcap
      · exact hpres _ _ hs
      · exact (hpres _ _ hs).symm
      · exact capComponent_iff_of_capStep hcap

/-- **The literal transverse-chord criterion.**  Menu B on the restored graph
holds exactly when no open strand joins the two blocks of the restored cap
matching.  This is the source's cap-restoration lemma and its criterion in the
form the terminal test uses: the whole condition is a property of the strand
pairing and the inactive position. -/
theorem restoredMenuB_iff_no_transverseChord {strand : Fin 5 → Fin 5 → Prop}
    (hstrand : ∀ a b : Fin 5, strand a b → a ≠ v ∧ b ≠ v) :
    RestoredMenuB strand v ↔ ¬ TransverseChord strand v := by
  constructor
  · rintro ⟨i, j, hi, hj, hne⟩ ⟨a, b, ha, hb, hs, hab⟩
    -- a transverse chord stitches the two blocks, so nothing stays apart
    have hjoin : RestoredReachable strand v (v + 4) (v + 2) := by
      rcases capConn_rep v ha with ⟨hba, hca⟩ | ⟨hba, hca⟩ <;>
        rcases capConn_rep v hb with ⟨hbb, hcb⟩ | ⟨hbb, hcb⟩
      · exact absurd (Iff.intro (fun _ => hbb) (fun _ => hba)) hab
      · exact ((restoredReachable_symm (restoredReachable_of_capConn hca)).tail
          (Or.inl ⟨ha, hb, Or.inl hs⟩)).trans (restoredReachable_of_capConn hcb)
      · exact (((restoredReachable_symm (restoredReachable_of_capConn hcb)).tail
          (Or.inl ⟨hb, ha, Or.inr hs⟩)).trans
          (restoredReachable_of_capConn hca))
      · exact absurd (Iff.intro (fun h' => absurd h' hba) (fun h' => absurd h' hbb)) hab
    have hall : ∀ k : Fin 5, k ≠ v → RestoredReachable strand v k (v + 4) := by
      intro k hk
      rcases capConn_rep v hk with ⟨-, hck⟩ | ⟨-, hck⟩
      · exact restoredReachable_of_capConn hck
      · exact (restoredReachable_of_capConn hck).trans (restoredReachable_symm hjoin)
    exact hne ((hall i hi).trans (restoredReachable_symm (hall j hj)))
  · intro hno
    obtain ⟨h1, h2, hcross⟩ := exists_active_cross v
    refine ⟨v + 1, v + 2, h1, h2, fun hrel => hcross ?_⟩
    exact ((capComponent_iff_capBlock h1).symm.trans
      (capComponent_iff_of_restoredReachable hstrand hno hrel)).trans
      (capComponent_iff_capBlock h2)

/-- **The abstract and literal Menu-B predicates agree.**  This is what the
source's cap-restoration lemma delivers operationally: the closure of the two
pairings may be evaluated on the finite profile, and it answers the question
about the literally restored graph.

Note the two predicates are *not* generator-by-generator identical.  The block
relation pairs the inactive position with the far block, while a literal cap
walk instead runs through it.  They agree only after restricting to the active
positions -- which is exactly where the source reads Menu B. -/
theorem restoredMenuB_iff_capComposedMenuB {strand : Fin 5 → Fin 5 → Prop}
    (hstrand : ∀ a b : Fin 5, strand a b → a ≠ v ∧ b ≠ v) :
    RestoredMenuB strand v ↔ CapComposedMenuB strand v :=
  (restoredMenuB_iff_no_transverseChord hstrand).trans
    (capComposedMenuB_iff_no_transverseChord hstrand).symm

/-- Total closure gives Menu B on the literally restored graph too. -/
theorem restoredMenuB_of_no_strand (v : Fin 5) :
    RestoredMenuB (fun _ _ => False) v :=
  (restoredMenuB_iff_no_transverseChord (fun _ _ h => h.elim)).mpr
    (fun htr => htr.choose_spec.choose_spec.2.2.1)

/-- And a single transverse strand still gives Menu A. -/
theorem not_restoredMenuB_of_single_transverse (v : Fin 5) :
    ¬ RestoredMenuB
      (fun i j => (i = v + 1 ∧ j = v + 2) ∨ (i = v + 2 ∧ j = v + 1)) v := by
  have hactive : ∀ a b : Fin 5,
      ((a = v + 1 ∧ b = v + 2) ∨ (a = v + 2 ∧ b = v + 1)) → a ≠ v ∧ b ≠ v := by
    obtain ⟨h1, h2, -⟩ := exists_active_cross v
    rintro a b (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · exact ⟨h1, h2⟩
    · exact ⟨h2, h1⟩
  intro hmenu
  obtain ⟨h1, h2, hcross⟩ := exists_active_cross v
  exact (restoredMenuB_iff_no_transverseChord hactive).mp hmenu
    ⟨v + 1, v + 2, h1, h2, Or.inl ⟨rfl, rfl⟩, hcross⟩

end GoertzelV24AnnularFrontierMenuCapRestoration

end Mettapedia.GraphTheory.FourColor
