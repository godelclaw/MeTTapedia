import Mettapedia.GraphTheory.FourColor.GoertzelV24InterfaceExteriorLabelCapFactor
import Mettapedia.GraphTheory.FourColor.GoertzelV24RotationFaceRegionalDartGraph

/-!
# Deletion-stable exterior weights for a regional face graph

A regional face graph is a subgraph of the undirected cycle generated by the
face permutation.  Consequently every possible edge from a represented dart
to the strict exterior is one of two explicit incidences: the forward or the
backward face neighbour.

This file specializes the generic weighted interface/exterior factor to those
two incidences.  Its labels are the underlying primal edges, so every live
incidence records the cap at five of the distinct primal edges in the exterior
face fragment it enters.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24RotationFaceInterfaceExteriorLabelCap

open GoertzelV24InterfaceDeletionComponentFactor
open GoertzelV24InterfaceExteriorLabelCapFactor
open GoertzelV24RotationFaceRegionalDartGraph
open SimpleGraphDartRotation

variable {V E Interface : Type*} [Fintype V] [DecidableEq V]
  [Fintype E] [DecidableEq E]

noncomputable section

/-- The two literal face-neighbour incidences of every interface slot. -/
abbrev FaceInterfaceIncidence (Interface : Type*) := Interface × Bool

/-- `false` selects the predecessor under `phi`; `true` selects the successor.
-/
def faceInterfaceIncidenceVertex (RS : RotationSystem V E)
    (interfaceVertex : Interface → RS.D)
    (incidence : FaceInterfaceIncidence Interface) : RS.D :=
  if incidence.2 then RS.phi (interfaceVertex incidence.1)
  else RS.phi.symm (interfaceVertex incidence.1)

@[simp] theorem faceInterfaceIncidenceVertex_false
    (RS : RotationSystem V E) (interfaceVertex : Interface → RS.D)
    (slot : Interface) :
    faceInterfaceIncidenceVertex RS interfaceVertex (slot, false) =
      RS.phi.symm (interfaceVertex slot) :=
  rfl

@[simp] theorem faceInterfaceIncidenceVertex_true
    (RS : RotationSystem V E) (interfaceVertex : Interface → RS.D)
    (slot : Interface) :
    faceInterfaceIncidenceVertex RS interfaceVertex (slot, true) =
      RS.phi (interfaceVertex slot) :=
  rfl

/-- Exact deletion-stable connectivity and exterior edge caps for a regional
face graph on one represented interface. -/
noncomputable def exactFaceInterfaceExteriorLabelCapCode
    (RS : RotationSystem V E) (region : Finset E)
    (interfaceVertex : Interface → RS.D) :
    BoundedInterfaceExteriorLabelCapCode Interface
      (FaceInterfaceIncidence Interface) :=
  exactInterfaceExteriorLabelCapCode
    (faceRegionalDartGraph RS region) interfaceVertex
    (fun dart => RS.edgeOf dart ∈ region) Prod.fst
    (faceInterfaceIncidenceVertex RS interfaceVertex) RS.edgeOf

@[simp] theorem exactFaceInterfaceExteriorLabelCapCode_connectivity
    (RS : RotationSystem V E) (region : Finset E)
    (interfaceVertex : Interface → RS.D) :
    (exactFaceInterfaceExteriorLabelCapCode RS region interfaceVertex
      ).connectivity =
        exactInterfaceExteriorCode (faceRegionalDartGraph RS region)
          interfaceVertex :=
  rfl

@[simp] theorem exactFaceInterfaceExteriorLabelCapCode_interfacePresent_iff
    (RS : RotationSystem V E) (region : Finset E)
    (interfaceVertex : Interface → RS.D) (slot : Interface) :
    (exactFaceInterfaceExteriorLabelCapCode RS region interfaceVertex
      ).interfacePresent slot = true ↔
        RS.edgeOf (interfaceVertex slot) ∈ region := by
  exact exactInterfaceExteriorLabelCapCode_interfacePresent_iff
    (faceRegionalDartGraph RS region) interfaceVertex
    (fun dart => RS.edgeOf dart ∈ region) Prod.fst
    (faceInterfaceIncidenceVertex RS interfaceVertex) RS.edgeOf slot

@[simp] theorem exactFaceInterfaceExteriorLabelCapCode_incidencePresent_iff
    (RS : RotationSystem V E) (region : Finset E)
    (interfaceVertex : Interface → RS.D)
    (incidence : FaceInterfaceIncidence Interface) :
    (exactFaceInterfaceExteriorLabelCapCode RS region interfaceVertex
      ).incidencePresent incidence = true ↔
      OutsideInterface interfaceVertex
          (faceInterfaceIncidenceVertex RS interfaceVertex incidence) ∧
        (faceRegionalDartGraph RS region).Adj
          (interfaceVertex incidence.1)
          (faceInterfaceIncidenceVertex RS interfaceVertex incidence) := by
  exact exactInterfaceExteriorLabelCapCode_incidencePresent_iff
    (faceRegionalDartGraph RS region) interfaceVertex
    (fun dart => RS.edgeOf dart ∈ region) Prod.fst
    (faceInterfaceIncidenceVertex RS interfaceVertex) RS.edgeOf incidence

/-- Every regional-face edge from an interface dart to a strict exterior dart
is represented by one of the two fixed incidence directions. -/
theorem exists_faceInterfaceIncidence_of_adj_outside
    (RS : RotationSystem V E) (region : Finset E)
    (interfaceVertex : Interface → RS.D) (slot : Interface) (outside : RS.D)
    (hadj : (faceRegionalDartGraph RS region).Adj
      (interfaceVertex slot) outside)
    (houtside : OutsideInterface interfaceVertex outside) :
    ∃ direction : Bool,
      faceInterfaceIncidenceVertex RS interfaceVertex (slot, direction) =
          outside ∧
        ExteriorIncidencePresent (faceRegionalDartGraph RS region)
          interfaceVertex Prod.fst
          (faceInterfaceIncidenceVertex RS interfaceVertex)
          (slot, direction) := by
  rcases (faceRegionalDartGraph_adj RS region _ _).1 hadj with
    ⟨hne, hstep, hleftRegion, hrightRegion⟩
  rcases hstep with hforward | hbackward
  · have hvertex :
        faceInterfaceIncidenceVertex RS interfaceVertex (slot, true) =
          outside := by
      simpa using hforward.symm
    refine ⟨true, hvertex, ?_⟩
    unfold ExteriorIncidencePresent
    rw [hvertex]
    exact ⟨houtside, hadj⟩
  · have hvertex :
        faceInterfaceIncidenceVertex RS interfaceVertex (slot, false) =
          outside := by
      apply RS.phi.injective
      simp [hbackward]
    refine ⟨false, hvertex, ?_⟩
    unfold ExteriorIncidencePresent
    rw [hvertex]
    exact ⟨houtside, hadj⟩

/-- The stored exterior cap is exactly the cap at five of the distinct primal
edges in the entered strict-exterior face component. -/
@[simp] theorem exactFaceInterfaceExteriorLabelCapCode_incidenceCap_val
    (RS : RotationSystem V E) (region : Finset E)
    (interfaceVertex : Interface → RS.D)
    (incidence : FaceInterfaceIncidence Interface) :
    ((exactFaceInterfaceExteriorLabelCapCode RS region interfaceVertex
      ).incidenceCap incidence).val =
      min (exteriorIncidenceLabelSupport (faceRegionalDartGraph RS region)
        interfaceVertex Prod.fst
        (faceInterfaceIncidenceVertex RS interfaceVertex) RS.edgeOf incidence
        ).card 5 :=
  rfl

end

end GoertzelV24RotationFaceInterfaceExteriorLabelCap

end Mettapedia.GraphTheory.FourColor
