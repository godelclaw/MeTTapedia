import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Data.Fintype.Powerset
import Mathlib.Data.Fintype.Pigeonhole

/-!
# Support dynamics of a nonnegative Count row, and finite synchronization

Three elementary facts the compositional route relies on, none of which needs
anything about graphs.

* **The support action of a positive Count letter.**  Multiplying a cumulative
  row vector by a Count matrix acts on supports by the Boolean relational
  image of the matrix's positive-entry relation.  Both directions are the same
  observation about the naturals: a finite sum is positive exactly when a
  summand is, and a product is positive exactly when both factors are.
* **Determinized support-state deletion.**  Running a word of Count letters
  through the support action gives a sequence of support sets.  If two of them
  coincide, deleting the intervening block leaves every later support
  unchanged, hence the final support and its intersection with any accepting
  set.  With more positions than reachable supports, pigeonhole supplies a
  deletable nonempty block.  No self-loop and no accepting witness is used.
* **The finite synchronization criterion.**  For a finite monoid, every
  nonempty product of generators lies in an accepting set exactly when the
  closure generated by those generators does, and any element of that closure
  is witnessed by an explicit nonempty generator word — the predecessor
  reconstruction.

Supports are carried as `Finset`s throughout, since positivity of a natural
number is decidable and that keeps every set here computable.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24CountSupportSynchronization

variable {Q : Type*} [Fintype Q] [DecidableEq Q]

/-! ## The support action -/

/-- The support of a cumulative Count row vector. -/
def rowSupport (x : Q → ℕ) : Finset Q :=
  Finset.univ.filter fun state => 0 < x state

@[simp] theorem mem_rowSupport {x : Q → ℕ} {state : Q} :
    state ∈ rowSupport x ↔ 0 < x state := by
  simp [rowSupport]

/-- The relational image of a support under a Count letter's positive-entry
relation. -/
def supportImage (letter : Q → Q → ℕ) (support : Finset Q) : Finset Q :=
  Finset.univ.filter fun target =>
    ∃ source ∈ support, 0 < letter source target

@[simp] theorem mem_supportImage {letter : Q → Q → ℕ} {support : Finset Q}
    {target : Q} :
    target ∈ supportImage letter support ↔
      ∃ source ∈ support, 0 < letter source target := by
  simp [supportImage]

/-- One physical letter applied to a cumulative row vector. -/
def rowMul (x : Q → ℕ) (letter : Q → Q → ℕ) : Q → ℕ :=
  fun target => ∑ source, x source * letter source target

/-- **The support action of a positive Count letter.**  The support of `x·Mₐ`
is exactly the relational image of the support of `x`. -/
theorem rowSupport_rowMul (x : Q → ℕ) (letter : Q → Q → ℕ) :
    rowSupport (rowMul x letter) = supportImage letter (rowSupport x) := by
  classical
  ext target
  rw [mem_rowSupport, mem_supportImage, rowMul]
  constructor
  · intro hpos
    by_contra hcon
    push_neg at hcon
    have hzero : ∀ source ∈ (Finset.univ : Finset Q),
        x source * letter source target = 0 := by
      intro source _
      rcases Nat.eq_zero_or_pos (x source) with hx | hx
      · simp [hx]
      · have := hcon source (mem_rowSupport.mpr hx)
        simp [Nat.le_zero.mp this]
    exact absurd (Finset.sum_eq_zero hzero) hpos.ne'
  · rintro ⟨source, hsource, hletter⟩
    have hx : 0 < x source := mem_rowSupport.mp hsource
    have hpos : 0 < x source * letter source target := Nat.mul_pos hx hletter
    have hsplit := Finset.add_sum_erase (Finset.univ : Finset Q)
      (fun s => x s * letter s target) (Finset.mem_univ source)
    omega

/-! ## Determinized support-state deletion -/

/-- Run a word of Count letters through the support action. -/
def runSupport : List (Q → Q → ℕ) → Finset Q → Finset Q
  | [], support => support
  | letter :: rest, support => runSupport rest (supportImage letter support)

@[simp] theorem runSupport_nil (support : Finset Q) :
    runSupport ([] : List (Q → Q → ℕ)) support = support := rfl

@[simp] theorem runSupport_cons (letter : Q → Q → ℕ)
    (rest : List (Q → Q → ℕ)) (support : Finset Q) :
    runSupport (letter :: rest) support =
      runSupport rest (supportImage letter support) := rfl

theorem runSupport_append (first second : List (Q → Q → ℕ))
    (support : Finset Q) :
    runSupport (first ++ second) support =
      runSupport second (runSupport first support) := by
  induction first generalizing support with
  | nil => rfl
  | cons letter rest ih => simpa using ih (supportImage letter support)

/-- **Determinized support-state deletion.**  If the support after a prefix
equals the support after that prefix followed by a block, then deleting the
block leaves the final support unchanged, whatever the suffix. -/
theorem runSupport_delete_block (prefixWord block suffix : List (Q → Q → ℕ))
    (initial : Finset Q)
    (hequal : runSupport prefixWord initial =
      runSupport (prefixWord ++ block) initial) :
    runSupport (prefixWord ++ suffix) initial =
      runSupport (prefixWord ++ block ++ suffix) initial := by
  rw [runSupport_append] at hequal
  simp only [runSupport_append]
  rw [← hequal]

/-- Acceptance is likewise unchanged: the final support meets an accepting set
after the deletion exactly when it did before. -/
theorem accepting_iff_of_delete_block (prefixWord block suffix :
      List (Q → Q → ℕ)) (initial accepting : Finset Q)
    (hequal : runSupport prefixWord initial =
      runSupport (prefixWord ++ block) initial) :
    ((runSupport (prefixWord ++ suffix) initial) ∩ accepting).Nonempty ↔
      ((runSupport (prefixWord ++ block ++ suffix) initial) ∩
        accepting).Nonempty := by
  rw [runSupport_delete_block prefixWord block suffix initial hequal]

/-- **The pigeonhole.**  More prefix positions than reachable supports forces
two equal supports at distinct positions. -/
theorem exists_repeated_support {n : ℕ} (supports : Fin n → Finset Q)
    (hcard : Fintype.card (Finset Q) < n) :
    ∃ i j : Fin n, i ≠ j ∧ supports i = supports j := by
  obtain ⟨i, j, hij, heq⟩ :=
    Fintype.exists_ne_map_eq_of_card_lt supports (by simpa using hcard)
  exact ⟨i, j, hij, heq⟩

/-! ## Finite synchronization -/

section Synchronization

variable {P : Type*} [Monoid P]

/-- The nonempty products of generators. -/
inductive PlusClosure (generators : Set P) : P → Prop
  | base {g : P} (hg : g ∈ generators) : PlusClosure generators g
  | step {p g : P} (hp : PlusClosure generators p) (hg : g ∈ generators) :
      PlusClosure generators (p * g)

/-- The product of a nonempty generator word, given as a head and a tail. -/
def wordProduct (head : P) (tail : List P) : P := tail.foldl (· * ·) head

@[simp] theorem wordProduct_nil (head : P) : wordProduct head ([] : List P) = head :=
  rfl

theorem wordProduct_concat (head : P) (tail : List P) (last : P) :
    wordProduct head (tail ++ [last]) = wordProduct head tail * last := by
  simp [wordProduct, List.foldl_append]

/-- Every nonempty generator word lands in the closure. -/
theorem plusClosure_wordProduct {generators : Set P} {head : P}
    (hhead : head ∈ generators) :
    ∀ tail : List P, (∀ x ∈ tail, x ∈ generators) →
      PlusClosure generators (wordProduct head tail) := by
  intro tail
  induction tail using List.reverseRecOn with
  | nil => intro _; exact PlusClosure.base hhead
  | append_singleton rest last ih =>
      intro hmem
      rw [wordProduct_concat]
      exact PlusClosure.step
        (ih fun x hx => hmem x (List.mem_append_left _ hx))
        (hmem last (List.mem_append_right _ (List.mem_singleton_self _)))

/-- **Predecessor reconstruction.**  Every element of the closure is the
product of an explicit nonempty generator word. -/
theorem exists_word_of_plusClosure {generators : Set P} {p : P}
    (hp : PlusClosure generators p) :
    ∃ head ∈ generators, ∃ tail : List P,
      (∀ x ∈ tail, x ∈ generators) ∧ wordProduct head tail = p := by
  induction hp with
  | base hg => exact ⟨_, hg, [], by simp, rfl⟩
  | @step p g _hp hg ih =>
      obtain ⟨head, hhead, tail, htail, rfl⟩ := ih
      refine ⟨head, hhead, tail ++ [g], ?_, ?_⟩
      · intro x hx
        rcases List.mem_append.1 hx with hx | hx
        · exact htail x hx
        · rw [List.mem_singleton.1 hx]; exact hg
      · exact wordProduct_concat head tail g

/-- **The finite synchronization criterion.**  Every nonempty generator word
composes into the accepting set exactly when the generated closure is
contained in it. -/
theorem wordProduct_mem_iff_plusClosure_subset (generators accepting : Set P) :
    (∀ head ∈ generators, ∀ tail : List P, (∀ x ∈ tail, x ∈ generators) →
        wordProduct head tail ∈ accepting) ↔
      ∀ p, PlusClosure generators p → p ∈ accepting := by
  constructor
  · intro hword p hp
    obtain ⟨head, hhead, tail, htail, rfl⟩ := exists_word_of_plusClosure hp
    exact hword head hhead tail htail
  · intro hclosure head hhead tail htail
    exact hclosure _ (plusClosure_wordProduct hhead tail htail)

end Synchronization

end GoertzelV24CountSupportSynchronization

end Mettapedia.GraphTheory.FourColor
