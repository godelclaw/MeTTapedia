import Mettapedia.GraphTheory.FourColor.Compositional.ResidualCircuitParity

/-!
# Physical reachability of residual circuit-partition orbits

The residual graph before an exchange is exactly the common off-cycle
residual material together with the local `tau` edges on the alternating
carrier.  After the exchange, the same common material is completed by the
local `sigma` edges instead.  This file proves those two adjacency
decompositions and identifies the equivalence relation generated by the two
abstract pairings with physical residual reachability between carrier
vertices.  Thus the finite circuit partition is not merely an approximation:
it is exactly the boundary trace of the ambient residual components.
-/

namespace Mettapedia.GraphTheory.FourColor.Compositional

namespace ResidualCircuitPhysicalReachability

open GoertzelV24OrderedMeshResidualSiteMatching
open GoertzelV24AlternatingMatchingComponent
open GoertzelV24ResidualReturnCycleOrder
open GoertzelV24ResidualReturnPairing
open GoertzelV24ResidualTwoFactor
open MatchingParity
open ResidualCircuitParity
open SimpleGraph

attribute [-instance]
  GoertzelV24RetainedVertexRotationSplice.retainedVertexFintype
  GoertzelV24SeamFaceArcPartition.hitPointFintype

noncomputable section

universe u w

variable {V : Type u} [Fintype V] [DecidableEq V]
  {G : SimpleGraph V} [DecidableRel G.Adj]

/-- Before the exchange, every residual edge is either common to both states
or is the local `tau` edge at a carrier vertex. -/
theorem oldResidualGraph_adj_iff_common_or_tau
    (sigma : Pairing V) {first second left right : V}
    (site : ProperAlternatingSiteWitness G sigma first second) :
    (residualGraph G sigma).Adj left right ↔
      (commonResidualGraph G sigma site).Adj left right ∨
        (left ∈ site.carrier ∧ site.tau.partner left = right) := by
  constructor
  · intro hold
    by_cases hnew :
        (residualGraph G
          (sigma.exchange site.tau site.carrier
            site.sigma_closed site.tau_closed)).Adj left right
    · exact Or.inl <| (commonResidualGraph_adj sigma site).2
        ⟨hold.1, hold.2, hnew.2⟩
    · have hswitched :
          (sigma.exchange site.tau site.carrier
            site.sigma_closed site.tau_closed).partner left = right := by
        by_contra hne
        exact hnew ⟨hold.1, hne⟩
      have hleft : left ∈ site.carrier := by
        by_contra houtside
        rw [Pairing.exchange_of_notMem sigma site.tau site.carrier
          site.sigma_closed site.tau_closed houtside] at hswitched
        exact hold.2 hswitched
      refine Or.inr ⟨hleft, ?_⟩
      rw [Pairing.exchange_of_mem sigma site.tau site.carrier
        site.sigma_closed site.tau_closed hleft] at hswitched
      exact hswitched
  · intro hcases
    rcases hcases with hcommon | ⟨hleft, htau⟩
    · have hdata := (commonResidualGraph_adj sigma site).1 hcommon
      exact ⟨hdata.1, hdata.2.1⟩
    · refine ⟨?_, ?_⟩
      · rw [← htau]
        exact site.tau_supported left
      · rw [← htau]
        exact site.disagree_on_carrier left hleft

/-- After the exchange, every residual edge is either common to both states
or is the local `sigma` edge at a carrier vertex. -/
theorem newResidualGraph_adj_iff_common_or_sigma
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second left right : V}
    (site : ProperAlternatingSiteWitness G sigma first second) :
    (residualGraph G
      (sigma.exchange site.tau site.carrier
        site.sigma_closed site.tau_closed)).Adj left right ↔
      (commonResidualGraph G sigma site).Adj left right ∨
        (left ∈ site.carrier ∧ sigma.partner left = right) := by
  constructor
  · intro hnew
    by_cases hold : (residualGraph G sigma).Adj left right
    · exact Or.inl <| (commonResidualGraph_adj sigma site).2
        ⟨hnew.1, hold.2, hnew.2⟩
    · have hsigma : sigma.partner left = right := by
        by_contra hne
        exact hold ⟨hnew.1, hne⟩
      have hleft : left ∈ site.carrier := by
        by_contra houtside
        have houtside := Pairing.exchange_of_notMem sigma site.tau
          site.carrier site.sigma_closed site.tau_closed houtside
        apply hnew.2
        rw [houtside, hsigma]
      exact Or.inr ⟨hleft, hsigma⟩
  · intro hcases
    rcases hcases with hcommon | ⟨hleft, hsigma⟩
    · have hdata := (commonResidualGraph_adj sigma site).1 hcommon
      exact ⟨hdata.1, hdata.2.2⟩
    · refine ⟨?_, ?_⟩
      · rw [← hsigma]
        exact hSigma left
      · rw [Pairing.exchange_of_mem sigma site.tau site.carrier
          site.sigma_closed site.tau_closed hleft, ← hsigma]
        exact (site.disagree_on_carrier left hleft).symm

/-- One abstract old-state circuit step is physically reachable: first cross
the local `tau` edge and then traverse the common residual return path. -/
theorem oldResidual_step_reachable
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    (position : CyclePosition sigma site) :
    (residualGraph G sigma).Reachable
      (cycleVertexOrder sigma site position).1
      (cycleVertexOrder sigma site
        (CircuitPartition.step
          (orderedSiteReturnPairing hG sigma hSigma site)
          (orderedSiteTauPairing sigma site) position)).1 := by
  have hlocal : (residualGraph G sigma).Adj
      (cycleVertexOrder sigma site position).1
      (cycleVertexOrder sigma site
        ((orderedSiteTauPairing sigma site).partner position)).1 := by
    apply (oldResidualGraph_adj_iff_common_or_tau sigma site).2
    refine Or.inr ⟨(cycleVertexOrder sigma site position).2, ?_⟩
    have hcoordinate := congrArg Subtype.val
      (cycleVertexOrder_orderedSiteTauPairing_partner sigma site position)
    change
      (cycleVertexOrder sigma site
        ((orderedSiteTauPairing sigma site).partner position)).1 =
        site.tau.partner (cycleVertexOrder sigma site position).1 at hcoordinate
    exact hcoordinate.symm
  have hreturn := orderedSiteReturnPairing_reachable hG sigma hSigma site
    ((orderedSiteTauPairing sigma site).partner position)
  have hreturnOld : (residualGraph G sigma).Reachable
      (cycleVertexOrder sigma site
        ((orderedSiteTauPairing sigma site).partner position)).1
      (cycleVertexOrder sigma site
        ((orderedSiteReturnPairing hG sigma hSigma site).partner
          ((orderedSiteTauPairing sigma site).partner position))).1 :=
    hreturn.map (SimpleGraph.Hom.ofLE
      (show commonResidualGraph G sigma site ≤ residualGraph G sigma from
        inf_le_left))
  simpa only [CircuitPartition.step_apply] using
    hlocal.reachable.trans hreturnOld

/-- One abstract new-state circuit step is physically reachable: first cross
the local `sigma` edge and then traverse the same common return path. -/
theorem newResidual_step_reachable
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    (position : CyclePosition sigma site) :
    (residualGraph G
      (sigma.exchange site.tau site.carrier
        site.sigma_closed site.tau_closed)).Reachable
      (cycleVertexOrder sigma site position).1
      (cycleVertexOrder sigma site
        (CircuitPartition.step
          (orderedSiteReturnPairing hG sigma hSigma site)
          (orderedSiteSigmaPairing sigma site) position)).1 := by
  have hlocal : (residualGraph G
      (sigma.exchange site.tau site.carrier
        site.sigma_closed site.tau_closed)).Adj
      (cycleVertexOrder sigma site position).1
      (cycleVertexOrder sigma site
        ((orderedSiteSigmaPairing sigma site).partner position)).1 := by
    apply (newResidualGraph_adj_iff_common_or_sigma sigma hSigma site).2
    refine Or.inr ⟨(cycleVertexOrder sigma site position).2, ?_⟩
    have hcoordinate := congrArg Subtype.val
      (cycleVertexOrder_orderedSiteSigmaPairing_partner sigma site position)
    change
      (cycleVertexOrder sigma site
        ((orderedSiteSigmaPairing sigma site).partner position)).1 =
        sigma.partner (cycleVertexOrder sigma site position).1 at hcoordinate
    exact hcoordinate.symm
  have hreturn := orderedSiteReturnPairing_reachable hG sigma hSigma site
    ((orderedSiteSigmaPairing sigma site).partner position)
  have hreturnNew : (residualGraph G
      (sigma.exchange site.tau site.carrier
        site.sigma_closed site.tau_closed)).Reachable
      (cycleVertexOrder sigma site
        ((orderedSiteSigmaPairing sigma site).partner position)).1
      (cycleVertexOrder sigma site
        ((orderedSiteReturnPairing hG sigma hSigma site).partner
          ((orderedSiteSigmaPairing sigma site).partner position))).1 :=
    hreturn.map (SimpleGraph.Hom.ofLE
      (show commonResidualGraph G sigma site ≤
          residualGraph G
            (sigma.exchange site.tau site.carrier
              site.sigma_closed site.tau_closed) from inf_le_right))
  simpa only [CircuitPartition.step_apply] using
    hlocal.reachable.trans hreturnNew

omit [Fintype V] [DecidableEq V] in
/-- A relation containing every forward step of a finite permutation contains
its whole cycle relation. -/
private theorem reachable_of_sameCycle_of_step_reachable
    {W : Type w} [Finite W] {H : SimpleGraph V}
    (permutation : Equiv.Perm W) (embed : W → V)
    (hstep : ∀ point : W,
      H.Reachable (embed point) (embed (permutation point)))
    {root other : W} (hsame : permutation.SameCycle root other) :
    H.Reachable (embed root) (embed other) := by
  rcases hsame.exists_nat_pow_eq with ⟨steps, hsteps⟩
  have hpow : ∀ count : Nat,
      H.Reachable (embed root) (embed ((permutation ^ count) root)) := by
    intro count
    induction count with
    | zero => exact SimpleGraph.Reachable.rfl
    | succ count ih =>
        rw [pow_succ']
        exact ih.trans (hstep ((permutation ^ count) root))
  simpa only [hsteps] using hpow steps

/-- Every old-state oriented orbit lies in one physical old residual
component. -/
theorem oldResidual_reachable_of_sameCycle
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    {root other : CyclePosition sigma site}
    (hsame : (CircuitPartition.step
      (orderedSiteReturnPairing hG sigma hSigma site)
      (orderedSiteTauPairing sigma site)).SameCycle root other) :
    (residualGraph G sigma).Reachable
      (cycleVertexOrder sigma site root).1
      (cycleVertexOrder sigma site other).1 :=
  reachable_of_sameCycle_of_step_reachable
    (CircuitPartition.step
      (orderedSiteReturnPairing hG sigma hSigma site)
      (orderedSiteTauPairing sigma site))
    (fun position => (cycleVertexOrder sigma site position).1)
    (oldResidual_step_reachable hG sigma hSigma site) hsame

/-- Every new-state oriented orbit lies in one physical new residual
component. -/
theorem newResidual_reachable_of_sameCycle
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    {root other : CyclePosition sigma site}
    (hsame : (CircuitPartition.step
      (orderedSiteReturnPairing hG sigma hSigma site)
      (orderedSiteSigmaPairing sigma site)).SameCycle root other) :
    (residualGraph G
      (sigma.exchange site.tau site.carrier
        site.sigma_closed site.tau_closed)).Reachable
      (cycleVertexOrder sigma site root).1
      (cycleVertexOrder sigma site other).1 :=
  reachable_of_sameCycle_of_step_reachable
    (CircuitPartition.step
      (orderedSiteReturnPairing hG sigma hSigma site)
      (orderedSiteSigmaPairing sigma site))
    (fun position => (cycleVertexOrder sigma site position).1)
    (newResidual_step_reachable hG sigma hSigma site) hsame

/-- A common-residual path between two carrier positions either returns to
its starting position or reaches its unique return partner. -/
theorem eq_or_eq_orderedReturnPartner_of_commonResidual_reachable
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    (start finish : CyclePosition sigma site)
    (hreach : (commonResidualGraph G sigma site).Reachable
      (cycleVertexOrder sigma site start).1
      (cycleVertexOrder sigma site finish).1) :
    finish = start ∨
      finish =
        (orderedSiteReturnPairing hG sigma hSigma site).partner start := by
  by_cases hsame : finish = start
  · exact Or.inl hsame
  · have hne : cycleVertexOrder sigma site finish ≠
        cycleVertexOrder sigma site start := by
      intro heq
      exact hsame ((cycleVertexOrder sigma site).injective heq)
    have hphysical := siteReturnPairing_eq_of_reachable
      hG sigma hSigma site
      (cycleVertexOrder sigma site start)
      (cycleVertexOrder sigma site finish) hne hreach
    have hordered :
        (orderedSiteReturnPairing hG sigma hSigma site).partner start =
          finish := by
      apply (cycleVertexOrder sigma site).injective
      rw [cycleVertexOrder_orderedSiteReturnPairing_partner]
      exact hphysical
    exact Or.inr hordered.symm

/-- Generic contraction principle for the carrier component.  If every edge
of a completed physical graph is either a common-residual edge or one local
matching edge, then physical reachability between carrier positions contracts
to the equivalence relation generated by the return and local pairings. -/
private theorem eqvGen_of_completed_reachable
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    (localPairing : Pairing (CyclePosition sigma site))
    {physicalGraph : SimpleGraph V}
    (hadj : ∀ {left right : V}, physicalGraph.Adj left right →
      (commonResidualGraph G sigma site).Adj left right ∨
        ∃ position : CyclePosition sigma site,
          (cycleVertexOrder sigma site position).1 = left ∧
          (cycleVertexOrder sigma site
            (localPairing.partner position)).1 = right)
    {root finish : CyclePosition sigma site}
    (hreach : physicalGraph.Reachable
      (cycleVertexOrder sigma site root).1
      (cycleVertexOrder sigma site finish).1) :
    Relation.EqvGen
      (AlternatingStep
        (orderedSiteReturnPairing hG sigma hSigma site) localPairing)
      root finish := by
  let returns := orderedSiteReturnPairing hG sigma hSigma site
  have hpath := (SimpleGraph.reachable_iff_reflTransGen _ _).mp hreach
  have hstateOf : ∀ {current : V},
      Relation.ReflTransGen physicalGraph.Adj
        (cycleVertexOrder sigma site root).1 current →
      ∃ position : CyclePosition sigma site,
        Relation.EqvGen (AlternatingStep returns localPairing) root position ∧
        (commonResidualGraph G sigma site).Reachable
          (cycleVertexOrder sigma site position).1 current := by
    intro current path
    induction path with
    | refl =>
        exact ⟨root, Relation.EqvGen.refl _, SimpleGraph.Reachable.rfl⟩
    | @tail middle right hprefix hedge ih =>
        rcases ih with ⟨position, habstract, hcommon⟩
        rcases hadj hedge with hcommonEdge |
          ⟨boundaryPosition, hboundaryLeft, hboundaryRight⟩
        · exact ⟨position, habstract,
            hcommon.trans hcommonEdge.reachable⟩
        · have htoBoundary : (commonResidualGraph G sigma site).Reachable
              (cycleVertexOrder sigma site position).1
              (cycleVertexOrder sigma site boundaryPosition).1 := by
            simpa only [hboundaryLeft] using hcommon
          have hboundaryCases :=
            eq_or_eq_orderedReturnPartner_of_commonResidual_reachable
              hG sigma hSigma site position boundaryPosition htoBoundary
          have habstractBoundary : Relation.EqvGen
              (AlternatingStep returns localPairing) root boundaryPosition := by
            rcases hboundaryCases with hsame | hreturn
            · simpa only [hsame] using habstract
            · exact Relation.EqvGen.trans root position boundaryPosition
                habstract (Relation.EqvGen.rel _ _
                  (Or.inl hreturn))
          have habstractLocal : Relation.EqvGen
              (AlternatingStep returns localPairing) root
              (localPairing.partner boundaryPosition) :=
            Relation.EqvGen.trans root boundaryPosition
              (localPairing.partner boundaryPosition) habstractBoundary
              (Relation.EqvGen.rel _ _ (Or.inr rfl))
          refine ⟨localPairing.partner boundaryPosition,
            habstractLocal, ?_⟩
          rw [hboundaryRight]
  have hstate : ∃ position : CyclePosition sigma site,
      Relation.EqvGen (AlternatingStep returns localPairing) root position ∧
      (commonResidualGraph G sigma site).Reachable
        (cycleVertexOrder sigma site position).1
        (cycleVertexOrder sigma site finish).1 :=
    hstateOf hpath
  rcases hstate with ⟨position, habstract, hcommon⟩
  have hfinishCases :=
    eq_or_eq_orderedReturnPartner_of_commonResidual_reachable
      hG sigma hSigma site position finish hcommon
  rcases hfinishCases with hsame | hreturn
  · simpa only [hsame] using habstract
  · exact Relation.EqvGen.trans root position finish habstract
      (Relation.EqvGen.rel _ _ (Or.inl hreturn))

/-- Physical reachability between carrier positions in the old residual graph
is exactly generated by the return pairing and the local `tau` pairing. -/
theorem eqvGen_of_oldResidual_reachable
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    {root finish : CyclePosition sigma site}
    (hreach : (residualGraph G sigma).Reachable
      (cycleVertexOrder sigma site root).1
      (cycleVertexOrder sigma site finish).1) :
    Relation.EqvGen
      (AlternatingStep
        (orderedSiteReturnPairing hG sigma hSigma site)
        (orderedSiteTauPairing sigma site)) root finish := by
  refine eqvGen_of_completed_reachable hG sigma hSigma site
    (orderedSiteTauPairing sigma site) ?_ hreach
  intro left right hedge
  rcases (oldResidualGraph_adj_iff_common_or_tau sigma site).1 hedge with
    hcommon | ⟨hleft, htau⟩
  · exact Or.inl hcommon
  · let position : CyclePosition sigma site :=
      (cycleVertexOrder sigma site).symm ⟨left, hleft⟩
    have hposition : cycleVertexOrder sigma site position =
        (⟨left, hleft⟩ : BoundaryVertex site.carrier) :=
      (cycleVertexOrder sigma site).apply_symm_apply ⟨left, hleft⟩
    refine Or.inr ⟨position, congrArg Subtype.val hposition, ?_⟩
    have hpartner := congrArg Subtype.val
      (cycleVertexOrder_orderedSiteTauPairing_partner sigma site position)
    change
      (cycleVertexOrder sigma site
        ((orderedSiteTauPairing sigma site).partner position)).1 = right
    calc
      _ = site.tau.partner (cycleVertexOrder sigma site position).1 := by
        change _ = ((siteTauPairing sigma site).partner
          (cycleVertexOrder sigma site position)).1
        exact hpartner
      _ = site.tau.partner left := by rw [congrArg Subtype.val hposition]
      _ = right := htau

/-- Physical reachability between carrier positions in the new residual graph
is exactly generated by the return pairing and the local `sigma` pairing. -/
theorem eqvGen_of_newResidual_reachable
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    {root finish : CyclePosition sigma site}
    (hreach : (residualGraph G
      (sigma.exchange site.tau site.carrier
        site.sigma_closed site.tau_closed)).Reachable
      (cycleVertexOrder sigma site root).1
      (cycleVertexOrder sigma site finish).1) :
    Relation.EqvGen
      (AlternatingStep
        (orderedSiteReturnPairing hG sigma hSigma site)
        (orderedSiteSigmaPairing sigma site)) root finish := by
  refine eqvGen_of_completed_reachable hG sigma hSigma site
    (orderedSiteSigmaPairing sigma site) ?_ hreach
  intro left right hedge
  rcases (newResidualGraph_adj_iff_common_or_sigma sigma hSigma site).1 hedge with
    hcommon | ⟨hleft, hsigma⟩
  · exact Or.inl hcommon
  · let position : CyclePosition sigma site :=
      (cycleVertexOrder sigma site).symm ⟨left, hleft⟩
    have hposition : cycleVertexOrder sigma site position =
        (⟨left, hleft⟩ : BoundaryVertex site.carrier) :=
      (cycleVertexOrder sigma site).apply_symm_apply ⟨left, hleft⟩
    refine Or.inr ⟨position, congrArg Subtype.val hposition, ?_⟩
    have hpartner := congrArg Subtype.val
      (cycleVertexOrder_orderedSiteSigmaPairing_partner sigma site position)
    change
      (cycleVertexOrder sigma site
        ((orderedSiteSigmaPairing sigma site).partner position)).1 = right
    calc
      _ = sigma.partner (cycleVertexOrder sigma site position).1 := by
        change _ = ((siteSigmaPairing sigma site).partner
          (cycleVertexOrder sigma site position)).1
        exact hpartner
      _ = sigma.partner left := by rw [congrArg Subtype.val hposition]
      _ = right := hsigma

omit [Fintype V] [DecidableEq V] in
/-- A graph that realizes both generating pairings realizes their entire
equivalence closure. -/
private theorem reachable_of_eqvGen
    {W : Type w} {H : SimpleGraph V}
    (returns localPairing : Pairing W) (embed : W → V)
    (hreturn : ∀ position : W,
      H.Reachable (embed position) (embed (returns.partner position)))
    (hlocal : ∀ position : W,
      H.Reachable (embed position) (embed (localPairing.partner position)))
    {root finish : W}
    (hreach : Relation.EqvGen
      (AlternatingStep returns localPairing) root finish) :
    H.Reachable (embed root) (embed finish) := by
  induction hreach with
  | rel left right step =>
      rcases step with hstep | hstep
      · subst right
        exact hreturn left
      · subst right
        exact hlocal left
  | refl point => exact SimpleGraph.Reachable.rfl
  | symm left right relation inductionHypothesis =>
      exact inductionHypothesis.symm
  | trans left middle right first second firstIH secondIH =>
      exact firstIH.trans secondIH

/-- Every equivalence generated by the return and local `tau` pairings is
realized inside the old residual graph. -/
theorem oldResidual_reachable_of_eqvGen
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    {root finish : CyclePosition sigma site}
    (hreach : Relation.EqvGen
      (AlternatingStep
        (orderedSiteReturnPairing hG sigma hSigma site)
        (orderedSiteTauPairing sigma site)) root finish) :
    (residualGraph G sigma).Reachable
      (cycleVertexOrder sigma site root).1
      (cycleVertexOrder sigma site finish).1 := by
  apply reachable_of_eqvGen
    (orderedSiteReturnPairing hG sigma hSigma site)
    (orderedSiteTauPairing sigma site)
    (fun position => (cycleVertexOrder sigma site position).1)
  · intro position
    exact (orderedSiteReturnPairing_reachable hG sigma hSigma site position).map
      (SimpleGraph.Hom.ofLE
        (show commonResidualGraph G sigma site ≤ residualGraph G sigma from
          inf_le_left))
  · intro position
    apply SimpleGraph.Adj.reachable
    apply (oldResidualGraph_adj_iff_common_or_tau sigma site).2
    refine Or.inr ⟨(cycleVertexOrder sigma site position).2, ?_⟩
    have hcoordinate := congrArg Subtype.val
      (cycleVertexOrder_orderedSiteTauPairing_partner sigma site position)
    exact hcoordinate.symm
  · exact hreach

/-- Every equivalence generated by the return and local `sigma` pairings is
realized inside the new residual graph. -/
theorem newResidual_reachable_of_eqvGen
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    {root finish : CyclePosition sigma site}
    (hreach : Relation.EqvGen
      (AlternatingStep
        (orderedSiteReturnPairing hG sigma hSigma site)
        (orderedSiteSigmaPairing sigma site)) root finish) :
    (residualGraph G
      (sigma.exchange site.tau site.carrier
        site.sigma_closed site.tau_closed)).Reachable
      (cycleVertexOrder sigma site root).1
      (cycleVertexOrder sigma site finish).1 := by
  apply reachable_of_eqvGen
    (orderedSiteReturnPairing hG sigma hSigma site)
    (orderedSiteSigmaPairing sigma site)
    (fun position => (cycleVertexOrder sigma site position).1)
  · intro position
    exact (orderedSiteReturnPairing_reachable hG sigma hSigma site position).map
      (SimpleGraph.Hom.ofLE
        (show commonResidualGraph G sigma site ≤
            residualGraph G
              (sigma.exchange site.tau site.carrier
                site.sigma_closed site.tau_closed) from inf_le_right))
  · intro position
    apply SimpleGraph.Adj.reachable
    apply (newResidualGraph_adj_iff_common_or_sigma sigma hSigma site).2
    refine Or.inr ⟨(cycleVertexOrder sigma site position).2, ?_⟩
    have hcoordinate := congrArg Subtype.val
      (cycleVertexOrder_orderedSiteSigmaPairing_partner sigma site position)
    exact hcoordinate.symm
  · exact hreach

/-- Exact boundary-component identification for the old residual graph. -/
theorem oldResidual_reachable_iff_eqvGen
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    (root finish : CyclePosition sigma site) :
    (residualGraph G sigma).Reachable
        (cycleVertexOrder sigma site root).1
        (cycleVertexOrder sigma site finish).1 ↔
      Relation.EqvGen
        (AlternatingStep
          (orderedSiteReturnPairing hG sigma hSigma site)
          (orderedSiteTauPairing sigma site)) root finish :=
  ⟨eqvGen_of_oldResidual_reachable hG sigma hSigma site,
    oldResidual_reachable_of_eqvGen hG sigma hSigma site⟩

/-- Exact boundary-component identification for the new residual graph. -/
theorem newResidual_reachable_iff_eqvGen
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    (root finish : CyclePosition sigma site) :
    (residualGraph G
      (sigma.exchange site.tau site.carrier
        site.sigma_closed site.tau_closed)).Reachable
        (cycleVertexOrder sigma site root).1
        (cycleVertexOrder sigma site finish).1 ↔
      Relation.EqvGen
        (AlternatingStep
          (orderedSiteReturnPairing hG sigma hSigma site)
          (orderedSiteSigmaPairing sigma site)) root finish :=
  ⟨eqvGen_of_newResidual_reachable hG sigma hSigma site,
    newResidual_reachable_of_eqvGen hG sigma hSigma site⟩

/-- Finset membership spelling of old-orbit physical reachability. -/
theorem oldResidual_reachable_of_mem_orientedOrbit
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    (root other : CyclePosition sigma site)
    (hmem : other ∈ CircuitPartition.orientedOrbit
      (orderedSiteReturnPairing hG sigma hSigma site)
      (orderedSiteTauPairing sigma site) root) :
    (residualGraph G sigma).Reachable
      (cycleVertexOrder sigma site root).1
      (cycleVertexOrder sigma site other).1 :=
  oldResidual_reachable_of_sameCycle hG sigma hSigma site
    ((CircuitPartition.mem_orientedOrbit _ _ _ _).1 hmem)

/-- Finset membership spelling of new-orbit physical reachability. -/
theorem newResidual_reachable_of_mem_orientedOrbit
    (hG : HasCubicIncidentEdgeTriples G)
    (sigma : Pairing V) (hSigma : sigma.SupportedBy G)
    {first second : V}
    (site : ProperAlternatingSiteWitness G sigma first second)
    (root other : CyclePosition sigma site)
    (hmem : other ∈ CircuitPartition.orientedOrbit
      (orderedSiteReturnPairing hG sigma hSigma site)
      (orderedSiteSigmaPairing sigma site) root) :
    (residualGraph G
      (sigma.exchange site.tau site.carrier
        site.sigma_closed site.tau_closed)).Reachable
      (cycleVertexOrder sigma site root).1
      (cycleVertexOrder sigma site other).1 :=
  newResidual_reachable_of_sameCycle hG sigma hSigma site
    ((CircuitPartition.mem_orientedOrbit _ _ _ _).1 hmem)

end

end ResidualCircuitPhysicalReachability

end Mettapedia.GraphTheory.FourColor.Compositional
