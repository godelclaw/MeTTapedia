import Mettapedia.GraphTheory.FourColor.InducedCycleLayer
import Mettapedia.GraphTheory.FourColor.FaceRegionPatch

/-!
# Ring layers on actual facial boundaries

The two sides of an oriented boundary cycle are read from the ambient face
orbits. Its retained degrees determine the vertex rotations. When the
selected and complementary face regions are connected, the complete outer
boundary is this cycle; the region's interior then supplies the input side
of the ring layer.
-/

namespace Mettapedia.GraphTheory.FourColor.FacialCycleLayer

open InducedCycleLayer SimpleGraphDartRotation ZigzagRing
open GoertzelV24FaceOrbitIncidence GoertzelV24FaceDualConnectedness
open GoertzelV24PrimalCycleFacialBond GoertzelV24TwoEdgeCutMinimality
open PhysicalForkCodeFaces PhysicalForkCodeCut FaceRegionDegree EdgeShoreRotation
open PlanePatchCurvature FaceRegionBoundary

noncomputable section
attribute [local instance] Classical.propDecidable
set_option backward.isDefEq.respectTransparency false

variable {V : Type*} [Fintype V] [DecidableEq V]
variable {G : SimpleGraph V} [DecidableRel G.Adj] [G.LocallyFinite]
variable {k : ℕ} [NeZero k] (C : Cycle G k) (hk : 2 ≤ k)
  (hG : G.IsRegularOfDegree 3) (data : Data G)

local instance : Fintype G.edgeSet := SimpleGraph.fintypeEdgeSet G
local instance : DecidableEq G.edgeSet := Subtype.instDecidableEq

abbrev RS := data.toRotationSystem

omit [Fintype V] [DecidableRel G.Adj] in
theorem star_forward_symm (v : Vtx k) :
    (C.star hk hG v 1).symm = C.star hk hG (next k v) 2 := by
  apply SimpleGraph.Dart.ext
  simp [Cycle.star, prev_next]

omit [Fintype V] [DecidableRel G.Adj] in
theorem star_backward_symm (v : Vtx k) :
    (C.star hk hG v 2).symm = C.star hk hG (prev k v) 1 := by
  apply SimpleGraph.Dart.ext
  simp [Cycle.star, next_prev]

variable (R : Finset (OrbitFace (RS data)))

/-- The cycle is oriented with selected faces on its forward darts and
unselected faces on its backward darts. These are actual quotient faces. -/
structure BoundsFaces : Prop where
  forward : ∀ v, dartOrbitFace (RS data) (C.star hk hG v 1) ∈ R
  backward : ∀ v, dartOrbitFace (RS data) (C.star hk hG v 2) ∉ R

/-- The degree in the literal edge restriction generated by the faces. -/
def retainedDegree (v : V) : ℕ :=
  (((RS data).dartsAt v).filter fun d => (RS data).edgeOf d ∈ edges (RS data) R).card

/-- The ring pattern is a statement about retained graph degrees. -/
def AlternatingDegrees : Prop :=
  (∀ i, retainedDegree data R (C.vertex (.inl i)) = 3) ∧
  (∀ i, retainedDegree data R (C.vertex (.inr i)) = 2)

/-- Vertices wholly inside the selected face region, on the original
vertex carrier. Boundary vertices have an unselected incident sector. -/
def Interior (v : V) : Prop :=
  ∀ d : G.Dart, d.fst = v → dartOrbitFace (RS data) d ∈ R

variable {C hk hG data R}

namespace BoundsFaces

variable (h : BoundsFaces C hk hG data R)

include h

theorem forward_retained (v : Vtx k) :
    (RS data).edgeOf (C.star hk hG v 1) ∈ edges (RS data) R :=
  (edge_mem_iff _ _ _).mpr (Or.inl (h.forward v))

theorem backward_retained (v : Vtx k) :
    (RS data).edgeOf (C.star hk hG v 2) ∈ edges (RS data) R := by
  apply (edge_mem_iff _ _ _).mpr
  right
  change dartOrbitFace (RS data) (C.star hk hG v 2).symm ∈ R
  rw [star_backward_symm]
  exact h.forward _

def boundaryDart (v : Vtx k) : EdgeShoreRotation.Dart (RS data) (edges (RS data) R) :=
  ⟨C.star hk hG v 2, h.backward_retained v⟩

def outer : EdgeShoreRotation.Dart (RS data) (edges (RS data) R) := h.boundaryDart (.inl 0)

abbrev patchMap := toMap (RS data) (edges (RS data) R) h.outer

theorem boundary_phi (hC : Cubic3 (RS data)) (v : Vtx k) :
    h.patchMap.phi (h.boundaryDart v) = h.boundaryDart (prev k v) := by
  apply outside_vertex_injective hC
  · exact (outside_phi_iff h.outer (h.boundaryDart v)).mpr (h.backward v)
  · exact h.backward _
  · have hv := congrArg Subtype.val
      (h.patchMap.vert_phi_eq_vert_alpha (h.boundaryDart v))
    exact hv.trans rfl

/-- Every occurrence on the chosen exterior orbit is one of the cycle's
backward darts. Completeness follows from the orbit, not a supplied list. -/
theorem outerDart_range (hC : Cubic3 (RS data))
    (d : EdgeShoreRotation.Dart (RS data) (edges (RS data) R))
    (hd : d ∈ outerDarts h.patchMap) : ∃ v, d = h.boundaryDart v := by
  have hh : h.patchMap.phi.SameCycle h.outer d :=
    Quotient.exact ((mem_orbitFaceDarts_iff _ _ _).mp hd).symm
  obtain ⟨n, rfl⟩ := hh.exists_nat_pow_eq
  clear hd hh
  induction n with
  | zero => exact ⟨.inl 0, rfl⟩
  | succ n ih =>
    obtain ⟨v, hv⟩ := ih
    refine ⟨prev k v, ?_⟩
    rw [pow_succ', Equiv.Perm.mul_apply, hv, h.boundary_phi hC]

omit h in
theorem dartsAt_eq (v : Vtx k) :
    (RS data).dartsAt (C.vertex v) =
      ({C.star hk hG v 0, C.star hk hG v 1, C.star hk hG v 2} : Finset G.Dart) := by
  ext d
  simp only [RotationSystem.dartsAt, Finset.mem_filter, Finset.mem_univ, true_and,
    Finset.mem_insert, Finset.mem_singleton]
  constructor
  · intro hd
    obtain ⟨j, hj⟩ := C.star_surjective_at hk hG v d hd
    fin_cases j <;> simp_all
  · rintro (rfl | rfl | rfl) <;> exact C.star_fst hk hG v _

omit h [Fintype V] [DecidableRel G.Adj] in
theorem star_ne (v : Vtx k) {i j : Fin 3} (hne : i ≠ j) :
    C.star hk hG v i ≠ C.star hk hG v j := by
  intro he
  exact hne (congrArg Prod.snd
    (C.star_injective hk hG (a₁ := (v, i)) (a₂ := (v, j)) he))

/-- Both cycle edges are retained, so the actual degree detects exactly
whether the third edge is retained. -/
theorem degree_eq (v : Vtx k) :
    retainedDegree data R (C.vertex v) =
      if (RS data).edgeOf (C.star hk hG v 0) ∈ edges (RS data) R then 3 else 2 := by
  unfold retainedDegree
  rw [dartsAt_eq (C := C) (hk := hk) (hG := hG)]
  have h01 := star_ne (C := C) (hk := hk) (hG := hG) v (i := 0) (j := 1) (by decide)
  have h02 := star_ne (C := C) (hk := hk) (hG := hG) v (i := 0) (j := 2) (by decide)
  have h12 := star_ne (C := C) (hk := hk) (hG := hG) v (i := 1) (j := 2) (by decide)
  by_cases hp : (RS data).edgeOf (C.star hk hG v 0) ∈ edges (RS data) R <;>
    simp only [Finset.filter_insert, Finset.filter_singleton, hp, h.forward_retained v,
      h.backward_retained v, ite_true, ite_false] <;>
    simp [h01, h02, h12]

theorem port_retained_iff (v : Vtx k) :
    (RS data).edgeOf (C.star hk hG v 0) ∈ edges (RS data) R ↔
      retainedDegree data R (C.vertex v) = 3 := by
  rw [h.degree_eq]
  split_ifs <;> simp_all

omit h [G.LocallyFinite] in
private theorem three_cycle (hC : Cubic3 (RS data))
    {a b c : (RS data).D}
    (hv : (RS data).vertOf c = (RS data).vertOf a)
    (hca : c ≠ a) (hcb : c ≠ b) (hab : (RS data).rho a = b) :
    (RS data).rho b = c ∧ (RS data).rho c = a := by
  have hc : c = (RS data).rho ((RS data).rho a) := by
    rcases hC.fiber a c hv with he | he | he
    · exact (hca he).elim
    · exact (hcb (he.trans hab)).elim
    · exact he
  constructor
  · simpa only [hab] using hc.symm
  · rw [hc, hC.cube]

/-- Only the two cyclic orientations of the three actual darts are
possible. The retained degree chooses between them. -/
theorem rotation_at (hC : Cubic3 (RS data)) (v : Vtx k) :
    (retainedDegree data R (C.vertex v) = 3 ∧
      (RS data).rho (C.star hk hG v 0) = C.star hk hG v 1 ∧
      (RS data).rho (C.star hk hG v 1) = C.star hk hG v 2 ∧
      (RS data).rho (C.star hk hG v 2) = C.star hk hG v 0) ∨
    (retainedDegree data R (C.vertex v) = 2 ∧
      (RS data).rho (C.star hk hG v 0) = C.star hk hG v 2 ∧
      (RS data).rho (C.star hk hG v 1) = C.star hk hG v 0 ∧
      (RS data).rho (C.star hk hG v 2) = C.star hk hG v 1) := by
  have h01 := star_ne (C := C) (hk := hk) (hG := hG) v (i := 0) (j := 1) (by decide)
  have h02 := star_ne (C := C) (hk := hk) (hG := hG) v (i := 0) (j := 2) (by decide)
  have h12 := star_ne (C := C) (hk := hk) (hG := hG) v (i := 1) (j := 2) (by decide)
  have hfp : dartOrbitFace (RS data) ((RS data).rho (C.star hk hG v 1)) ∉ R := by
    rw [← dartOrbitFace_alpha_eq_dartOrbitFace_rho]
    change dartOrbitFace (RS data) (C.star hk hG v 1).symm ∉ R
    rw [star_forward_symm]
    exact h.backward _
  have hbp : dartOrbitFace (RS data) ((RS data).rho (C.star hk hG v 2)) ∈ R := by
    rw [← dartOrbitFace_alpha_eq_dartOrbitFace_rho]
    change dartOrbitFace (RS data) (C.star hk hG v 2).symm ∈ R
    rw [star_backward_symm]
    exact h.forward _
  obtain ⟨j, hj⟩ := C.star_surjective_at hk hG v
    ((RS data).rho (C.star hk hG v 1))
    ((RS data).vert_rho _ |>.trans (C.star_fst hk hG v 1))
  fin_cases j
  · have ha := three_cycle hC (a := C.star hk hG v 1)
      (b := C.star hk hG v 0) (c := C.star hk hG v 2)
      (by simp only [RS, Data.toRotationSystem_vertOf, Cycle.star_fst])
      h12.symm h02.symm hj.symm
    right
    refine ⟨?_, ha.1, hj.symm, ha.2⟩
    rw [h.degree_eq]
    have hp : (RS data).edgeOf (C.star hk hG v 0) ∉ edges (RS data) R := by
      rw [← hj] at hfp
      rw [edge_mem_iff_sectors, ha.1]
      exact not_or.mpr ⟨hfp, h.backward v⟩
    simp only [hp, ite_false]
  · exact (hC.moves _ hj.symm).elim
  · have ha := three_cycle hC (a := C.star hk hG v 1)
      (b := C.star hk hG v 2) (c := C.star hk hG v 0)
      (by simp only [RS, Data.toRotationSystem_vertOf, Cycle.star_fst])
      h01 h02 hj.symm
    left
    refine ⟨?_, ha.2, hj.symm, ha.1⟩
    apply (h.port_retained_iff v).mp
    apply (edge_mem_iff _ _ _).mpr
    left
    rwa [ha.1] at hbp

/-- The actual ambient rotation agrees with the literal ring rotation;
the conclusion was not part of the graph or face-boundary data. -/
theorem embedding_rho (hC : Cubic3 (RS data))
    (ha : AlternatingDegrees C data R) (d : AllDart k) :
    (RS data).rho (C.embedding hk hG d) = C.embedding hk hG ((rho k) d) := by
  have hl (i : Fin k) := (h.rotation_at hC (.inl i)).resolve_right
    (fun hh => by have := ha.1 i; omega)
  have hr (i : Fin k) := (h.rotation_at hC (.inr i)).resolve_left
    (fun hh => by have := ha.2 i; omega)
  rcases d with (⟨i, _ | _⟩ | ⟨i, _ | _⟩) | (i | i)
  · change (RS data).rho (C.star hk hG (.inl i) 1) =
      C.star hk hG (.inl ((i - 1) + 1)) 2
    simpa only [sub_add_cancel] using (hl i).2.2.1
  · exact (hr i).2.2.2
  · exact (hr i).2.2.1
  · exact (hl (i + 1)).2.2.2
  · exact (hl i).2.1
  · exact (hr i).2.1

theorem port_faces (hC : Cubic3 (RS data)) (v : Vtx k) :
    (dartOrbitFace (RS data) (C.star hk hG v 0) ∈ R ↔
      retainedDegree data R (C.vertex v) = 3) ∧
    (dartOrbitFace (RS data) (C.star hk hG v 0).symm ∈ R ↔
      retainedDegree data R (C.vertex v) = 3) := by
  rcases h.rotation_at hC v with ⟨hd, hp, hf, hb⟩ | ⟨hd, hp, hf, hb⟩
  · have hport : dartOrbitFace (RS data) (C.star hk hG v 0) ∈ R := by
      rw [← hb, ← dartOrbitFace_alpha_eq_dartOrbitFace_rho]
      change dartOrbitFace (RS data) (C.star hk hG v 2).symm ∈ R
      rw [star_backward_symm]
      exact h.forward _
    have hfar : dartOrbitFace (RS data) (C.star hk hG v 0).symm ∈ R := by
      change dartOrbitFace (RS data) ((RS data).alpha (C.star hk hG v 0)) ∈ R
      rw [dartOrbitFace_alpha_eq_dartOrbitFace_rho, hp]
      exact h.forward _
    simp only [hport, hfar, hd, iff_self, and_self]
  · have hport : dartOrbitFace (RS data) (C.star hk hG v 0) ∉ R := by
      rw [← hf, ← dartOrbitFace_alpha_eq_dartOrbitFace_rho]
      change dartOrbitFace (RS data) (C.star hk hG v 1).symm ∉ R
      rw [star_forward_symm]
      exact h.backward _
    have hfar : dartOrbitFace (RS data) (C.star hk hG v 0).symm ∉ R := by
      change dartOrbitFace (RS data) ((RS data).alpha (C.star hk hG v 0)) ∉ R
      rw [dartOrbitFace_alpha_eq_dartOrbitFace_rho, hp]
      exact h.backward _
    simp [hport, hfar, hd]

theorem row_not_interior (v : Vtx k) : ¬ Interior data R (C.vertex v) :=
  fun hi => h.backward v (hi (C.star hk hG v 2) (C.star_fst hk hG v 2))

theorem port_not_interior (hC : Cubic3 (RS data)) (v : Vtx k)
    (hd : retainedDegree data R (C.vertex v) = 2) :
    ¬ Interior data R (C.port hk hG v) := by
  intro hi
  have hh := (h.port_faces hC v).2.mp (hi (C.star hk hG v 0).symm rfl)
  omega

variable (ambient : BridgelessSphericalCubicMapData (RS data))
  (hR : ((orbitFaceDualGraph data).induce (R : Set _)).Connected)
  (hRc : ((orbitFaceDualGraph data).induce (R : Set _)ᶜ).Connected)

include ambient hR hRc

/-- The connected facial shores force every mixed vertex onto this row.
No completeness of its listed vertices is assumed. -/
theorem mixed_on_cycle {v : V}
    (hin : ∃ d : G.Dart, d.fst = v ∧ dartOrbitFace (RS data) d ∈ R)
    (hout : ∃ d : G.Dart, d.fst = v ∧ dartOrbitFace (RS data) d ∉ R) :
    ∃ w, v = C.vertex w := by
  have hC := cubic3_of (RS data) ambient.spherical.cubic ambient.vertexRotationCyclic
  obtain ⟨d, hd, hf⟩ := exists_outside_at_vertex hC v hin hout
  have hm := (FaceRegionPatch.mem_outerDarts_iff data R ambient h.outer
    (h.backward (.inl 0)) hR hRc d).mpr hf
  obtain ⟨w, hw⟩ := h.outerDart_range hC d hm
  refine ⟨w, ?_⟩
  rw [hw] at hd
  exact hd.symm

theorem interior_of_off_cycle {v : V}
    (hv : ∀ w, v ≠ C.vertex w)
    (hin : ∃ d : G.Dart, d.fst = v ∧ dartOrbitFace (RS data) d ∈ R) :
    Interior data R v := by
  intro d hd
  by_contra hf
  obtain ⟨w, hw⟩ := h.mixed_on_cycle ambient hR hRc hin ⟨d, hd, hf⟩
  exact hv w hw

theorem port_interior (v : Vtx k)
    (hd : retainedDegree data R (C.vertex v) = 3) :
    Interior data R (C.port hk hG v) := by
  have hC := cubic3_of (RS data) ambient.spherical.cubic ambient.vertexRotationCyclic
  apply h.interior_of_off_cycle ambient hR hRc (C.port_not_cycle hk hG v)
  exact ⟨(C.star hk hG v 0).symm, rfl, (h.port_faces hC v).2.mpr hd⟩

/-- The interior and the row exhaust the vertices touched by the selected
faces. This identifies the enlarged side on the original graph. -/
theorem interior_or_cycle_iff_touched (v : V) :
    (Interior data R v ∨ ∃ w, v = C.vertex w) ↔
      v ∈ touched (RS data) (edges (RS data) R) := by
  rw [touched_iff]
  constructor
  · rintro (hi | ⟨w, rfl⟩)
    · have hc := ambient.spherical.cubic v
      have hp : 0 < ((RS data).dartsAt v).card := by omega
      obtain ⟨d, hd⟩ := Finset.card_pos.mp hp
      have hdv : (RS data).vertOf d = v := (Finset.mem_filter.mp hd).2
      exact ⟨d, hdv, hi d hdv⟩
    · exact ⟨C.star hk hG w 1, C.star_fst hk hG w 1, h.forward w⟩
  · intro hin
    by_cases hi : Interior data R v
    · exact Or.inl hi
    · right
      unfold Interior at hi
      push Not at hi
      exact h.mixed_on_cycle ambient hR hRc hin hi

/-- Alternating retained degrees derive every input/output attachment
condition. The old region is the actual interior of the selected faces. -/
theorem attachment (ha : AlternatingDegrees C data R) :
    C.Attachment (Interior data R) := by
  have hC := cubic3_of (RS data) ambient.spherical.cubic ambient.vertexRotationCyclic
  have hlow (i : Fin k) : ∀ w, G.Adj (C.vertex (.inr i)) w → ¬ Interior data R w := by
    intro w hw
    rcases (C.adjacent_iff hk hG (.inr i) w).mp hw with he | he | he
    · exact he ▸ h.port_not_interior hC (.inr i) (ha.2 i)
    · exact he ▸ h.row_not_interior _
    · exact he ▸ h.row_not_interior _
  refine ⟨h.row_not_interior, ?_, hlow, ?_⟩
  · intro i
    exact ⟨C.port hk hG (.inl i), h.port_interior ambient hR hRc (.inl i) (ha.1 i),
      (C.port_spec hk hG (.inl i)).1⟩
  · intro u w hu hw huw
    let d : G.Dart := ⟨(u, w), huw⟩
    have hf : dartOrbitFace (RS data) ((RS data).rho d.symm) ∈ R := by
      rw [← dartOrbitFace_alpha_eq_dartOrbitFace_rho]
      exact hu d rfl
    have hin : ∃ a : G.Dart, a.fst = w ∧ dartOrbitFace (RS data) a ∈ R :=
      ⟨(RS data).rho d.symm, (RS data).vert_rho d.symm, hf⟩
    have hout : ∃ a : G.Dart, a.fst = w ∧ dartOrbitFace (RS data) a ∉ R := by
      by_contra hn
      apply hw
      intro a ha
      by_contra hf
      exact hn ⟨a, ha, hf⟩
    obtain ⟨v, hv⟩ := h.mixed_on_cycle ambient hR hRc hin hout
    rcases v with i | i
    · exact ⟨i, hv⟩
    · exact (hlow i u (hv ▸ huw.symm) hu).elim

def toSlab (ha : AlternatingDegrees C data R) :
    TubeSlab.ZigzagSlab (RS data) k (Interior data R) :=
  C.toSlab hk hG data (h.attachment ambient hR hRc ha)

theorem toSlab_inner_iff (ha : AlternatingDegrees C data R) (v : V) :
    (h.toSlab ambient hR hRc ha).inner' v ↔
      v ∈ touched (RS data) (edges (RS data) R) :=
  h.interior_or_cycle_iff_touched ambient hR hRc v

/-- Exact witness composition for the facially recognized ring, with the
interior side and all ports derived from the selected region. -/
def colouringEquiv (ha : AlternatingDegrees C data R) :
    TubeSlab.SideColoring (RS data) (h.toSlab ambient hR hRc ha).inner' ≃
      (h.toSlab ambient hR hRc ha).CompatibleColorings :=
  (h.toSlab ambient hR hRc ha).colouringEquiv

end BoundsFaces
end
end Mettapedia.GraphTheory.FourColor.FacialCycleLayer
