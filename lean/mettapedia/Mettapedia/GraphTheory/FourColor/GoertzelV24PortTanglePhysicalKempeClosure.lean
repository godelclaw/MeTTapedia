import Mettapedia.GraphTheory.FourColor.GoertzelV24HexagonSingleOrbitReplacement
import Mettapedia.GraphTheory.FourColor.GoertzelV24PortTangleKempeEndpoints

/-!
# Physical support invariance and common-web endpoint matching

The six-port boundary audit uses two necessary properties of the exact support
of one literal cubic port tangle.  First, its support is invariant under a
global permutation of the three nonzero Tait colours.  Second, for a fixed
proper colouring and a fixed colour pair, every active boundary port has one
unique other boundary port in the same physical bichromatic component.

This file proves those facts directly on `PortTangle`.  No boundary matching
is chosen independently: it is extracted from the one common dart web of the
given tangle and colouring.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24PortTanglePhysicalKempeClosure

open SimpleGraph
open GoertzelV24HexagonPairingTargetAwareBoundary
open GoertzelV24HexagonSingleOrbitReplacement
open GoertzelV24PortTangleCommonKempeWeb
open GoertzelV24PortTangleCutParity
open GoertzelV24PortTangleGluing
open GoertzelV24PortTangleGluing.PortTangle
open GoertzelV24PortTangleKempeEndpoints

universe u

variable {V I P : Type u}

/-! ## Global colour relabelling -/

/-- Relabel every dart colour by one equivalence fixing zero. -/
def relabelColoring (T : PortTangle V I P) (relabel : Color ≃ Color)
    (coloring : Coloring T) : Coloring T where
  color dart := relabel (coloring.color dart)
  invariant dart := by
    rw [coloring.invariant]

/-- A zero-fixing colour relabelling preserves proper Tait colourings. -/
theorem relabelColoring_isProper
    (T : PortTangle V I P) (relabel : Color ≃ Color)
    (hzero : relabel 0 = 0) (coloring : Coloring T)
    (hproper : IsProper coloring) :
    IsProper (relabelColoring T relabel coloring) := by
  constructor
  · intro dart h
    apply hproper.1 dart
    apply relabel.injective
    change relabel (coloring.color dart) = 0 at h
    calc
      relabel (coloring.color dart) = 0 := h
      _ = relabel 0 := hzero.symm
  · intro first second hvert hne
    exact relabel.injective.ne (hproper.2 first second hvert hne)

/-- Relabelling commutes with reading the boundary word. -/
theorem word_relabelColoring
    (T : PortTangle V I P) (relabel : Color ≃ Color)
    (coloring : Coloring T) :
    word (relabelColoring T relabel coloring) =
      fun port => relabel (word coloring port) := by
  rfl

/-- The induced relabelling of genuine nonzero boundary words. -/
def relabelTaitWord (relabel : Color ≃ Color) (hzero : relabel 0 = 0)
    (boundary : P → {color : Color // color ≠ 0}) :
    P → {color : Color // color ≠ 0} :=
  fun port =>
    ⟨relabel (boundary port).1, fun h =>
      (boundary port).2 (relabel.injective (h.trans hzero.symm))⟩

/-- Exact physical support is invariant under every global zero-fixing colour
relabel. -/
theorem relabelTaitWord_mem_taitSupport_iff
    [Fintype V] [Fintype I] [Fintype P]
    [DecidableEq V] [DecidableEq I] [DecidableEq P]
    (T : PortTangle V I P) (relabel : Color ≃ Color)
    (hzero : relabel 0 = 0)
    (boundary : P → {color : Color // color ≠ 0}) :
    relabelTaitWord relabel hzero boundary ∈ taitSupport T ↔
      boundary ∈ taitSupport T := by
  constructor
  · rintro ⟨coloring, hproper, hword⟩
    let pulled := relabelColoring T relabel.symm coloring
    have hzeroSymm : relabel.symm 0 = 0 :=
      symm_apply_zero_of_apply_zero relabel hzero
    refine ⟨pulled,
      relabelColoring_isProper T relabel.symm hzeroSymm coloring hproper, ?_⟩
    funext port
    have hport := congrFun hword port
    change relabel.symm (coloring.color (Sum.inr port)) = (boundary port).1
    change coloring.color (Sum.inr port) =
      relabel (boundary port).1 at hport
    rw [hport]
    exact relabel.symm_apply_apply _
  · rintro ⟨coloring, hproper, hword⟩
    refine ⟨relabelColoring T relabel coloring,
      relabelColoring_isProper T relabel hzero coloring hproper, ?_⟩
    funext port
    have hport := congrFun hword port
    change relabel (coloring.color (Sum.inr port)) =
      (relabelTaitWord relabel hzero boundary port).1
    change coloring.color (Sum.inr port) = (boundary port).1 at hport
    rw [hport]
    change relabel (boundary port).1 = relabel (boundary port).1
    rfl

/-! ## The two physical boundary endpoints of one common-web component -/

section Finite

variable [Fintype V] [Fintype I] [Fintype P]
  [DecidableEq V] [DecidableEq I] [DecidableEq P]

/-- Connectivity in the finite active-web graph is exactly the common-web
equivalence generated by the local dart steps. -/
theorem activeWeb_reachable_iff_kempeConnected
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair)
    (first second : ActiveDart T coloring pair) :
    (activeWeb T coloring pair).Reachable first second ↔
      KempeConnected T coloring pair first.1 second.1 := by
  constructor
  · intro h
    rw [reachable_iff_reflTransGen] at h
    induction h with
    | refl => exact Relation.EqvGen.refl _
    | @tail middle last hprefix hadj ih =>
        exact Relation.EqvGen.trans _ _ _ ih
          (Relation.EqvGen.rel _ _ hadj.2)
  · intro h
    let R : (I ⊕ P) → (I ⊕ P) → Prop := fun x y =>
      (pairActiveDart coloring pair x ↔ pairActiveDart coloring pair y) ∧
        ∀ (hx : pairActiveDart coloring pair x)
          (hy : pairActiveDart coloring pair y),
          (activeWeb T coloring pair).Reachable ⟨x, hx⟩ ⟨y, hy⟩
    have hR : Equivalence R := by
      constructor
      · intro x
        refine ⟨Iff.rfl, ?_⟩
        intro hx hy
        simpa using
          (SimpleGraph.Reachable.refl (⟨x, hx⟩ : ActiveDart T coloring pair))
      · intro x y hxy
        exact ⟨hxy.1.symm, fun hy hx => (hxy.2 hx hy).symm⟩
      · intro x y z hxy hyz
        refine ⟨hxy.1.trans hyz.1, ?_⟩
        intro hx hz
        have hy : pairActiveDart coloring pair y := hxy.1.mp hx
        exact (hxy.2 hx hy).trans (hyz.2 hy hz)
    have hstep : ∀ x y, KempeStep T coloring pair x y → R x y := by
      intro x y hxy
      refine ⟨iff_of_true hxy.1 hxy.2.1, ?_⟩
      intro hx hy
      by_cases heq : x = y
      · subst y
        simpa using
          (SimpleGraph.Reachable.refl (⟨x, hx⟩ : ActiveDart T coloring pair))
      · rw [reachable_iff_reflTransGen]
        exact Relation.ReflTransGen.tail Relation.ReflTransGen.refl
          ⟨by simpa using heq, hxy⟩
    have hEqv : Relation.EqvGen R first.1 second.1 :=
      Relation.EqvGen.mono hstep h
    exact (hR.eqvGen_iff.mp hEqv).2 first.2 second.2

/-- Boundary ports in the physical bichromatic component of one active root
port.  This carrier forgets the proof-heavy connected-component subtypes and
remembers only the actual port index. -/
def PhysicalComponentPort
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (root : P)
    (hroot : pairActiveDart coloring pair (Sum.inr root)) :=
  {port : P //
    pairActiveDart coloring pair (Sum.inr port) ∧
      KempeConnected T coloring pair (Sum.inr root) (Sum.inr port)}

/-- The root port belongs to its own physical boundary component. -/
def rootPhysicalComponentPort
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (root : P)
    (hroot : pairActiveDart coloring pair (Sum.inr root)) :
    PhysicalComponentPort T coloring pair root hroot :=
  ⟨root, hroot, Relation.EqvGen.refl _⟩

/-- Extract the port index from an active dart known to be a boundary dart. -/
noncomputable def portOfIsPort
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (dart : ActiveDart T coloring pair)
    (hport : IsPortActiveDart dart) : P :=
  Classical.choose hport

theorem activeDart_eq_boundary_portOfIsPort
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (dart : ActiveDart T coloring pair)
    (hport : IsPortActiveDart dart) :
    dart.1 = Sum.inr (portOfIsPort T coloring pair dart hport) :=
  Classical.choose_spec hport

/-- The boundary-port carrier above is equivalent to the port-dart finset in
the graph-theoretic connected component. -/
noncomputable def physicalComponentPortEquiv
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (root : P)
    (hroot : pairActiveDart coloring pair (Sum.inr root)) :
    PhysicalComponentPort T coloring pair root hroot ≃
      {dart // dart ∈ componentPortDarts T coloring pair
        (⟨Sum.inr root, hroot⟩ : ActiveDart T coloring pair)} where
  toFun port := by
    let rootDart : ActiveDart T coloring pair := ⟨Sum.inr root, hroot⟩
    let portDart : ActiveDart T coloring pair :=
      ⟨Sum.inr port.1, port.2.1⟩
    have hreach : (activeWeb T coloring pair).Reachable rootDart portDart :=
      (activeWeb_reachable_iff_kempeConnected T coloring pair
        rootDart portDart).2 port.2.2
    have hmem : portDart ∈
        (activeComponent T coloring pair rootDart).supp := by
      rw [SimpleGraph.ConnectedComponent.mem_supp_iff,
        SimpleGraph.ConnectedComponent.eq]
      exact hreach.symm
    let inComponent : activeComponent T coloring pair rootDart :=
      ⟨portDart, hmem⟩
    refine ⟨inComponent, ?_⟩
    simp only [componentPortDarts, Finset.mem_filter, Finset.mem_univ,
      true_and]
    exact ⟨port.1, rfl⟩
  invFun dart := by
    have hport : IsPortActiveDart dart.1.1 := by
      simpa only [componentPortDarts, Finset.mem_filter, Finset.mem_univ,
        true_and] using dart.2
    let port := portOfIsPort T coloring pair dart.1.1 hport
    have hdart : dart.1.1.1 = Sum.inr port :=
      activeDart_eq_boundary_portOfIsPort T coloring pair dart.1.1 hport
    have hactive : pairActiveDart coloring pair (Sum.inr port) := by
      rw [← hdart]
      exact dart.1.1.2
    have hreach : (activeWeb T coloring pair).Reachable
        (⟨Sum.inr root, hroot⟩ : ActiveDart T coloring pair)
        ⟨Sum.inr port, hactive⟩ := by
      have hcomponentEq :
          (activeWeb T coloring pair).connectedComponentMk dart.1.1 =
            (activeWeb T coloring pair).connectedComponentMk
              (⟨Sum.inr root, hroot⟩ : ActiveDart T coloring pair) :=
        dart.1.2
      have hback : (activeWeb T coloring pair).Reachable dart.1.1
          (⟨Sum.inr root, hroot⟩ : ActiveDart T coloring pair) :=
        SimpleGraph.ConnectedComponent.eq.mp hcomponentEq
      have hdartSubtype : dart.1.1 =
          (⟨Sum.inr port, hactive⟩ : ActiveDart T coloring pair) :=
        Subtype.ext hdart
      rw [← hdartSubtype]
      exact hback.symm
    exact ⟨port, hactive,
      (activeWeb_reachable_iff_kempeConnected T coloring pair _ _).1 hreach⟩
  left_inv port := by
    apply Subtype.ext
    simp [portOfIsPort, activeDart_eq_boundary_portOfIsPort]
  right_inv dart := by
    apply Subtype.ext
    apply Subtype.ext
    apply Subtype.ext
    exact (activeDart_eq_boundary_portOfIsPort T coloring pair dart.1.1
      (by simpa only [componentPortDarts, Finset.mem_filter,
        Finset.mem_univ, true_and] using dart.2)).symm

/-- Exactly two physical boundary ports lie in the bichromatic component of
an active root port. -/
theorem card_physicalComponentPort_eq_two
    (T : PortTangle V I P) (hcubic : IsCubic T)
    (coloring : Coloring T) (hproper : IsProper coloring)
    (pair : TaitColorPair) (root : P)
    (hroot : pairActiveDart coloring pair (Sum.inr root)) :
    Nat.card (PhysicalComponentPort T coloring pair root hroot) = 2 := by
  rw [Nat.card_congr
    (physicalComponentPortEquiv T coloring pair root hroot),
    Nat.card_eq_fintype_card, Fintype.card_coe]
  exact card_componentPortDarts_eq_two T hcubic coloring hproper pair root hroot

/-- There is a unique other boundary port in the physical component of an
active root. -/
theorem existsUnique_otherPhysicalComponentPort
    (T : PortTangle V I P) (hcubic : IsCubic T)
    (coloring : Coloring T) (hproper : IsProper coloring)
    (pair : TaitColorPair) (root : P)
    (hroot : pairActiveDart coloring pair (Sum.inr root)) :
    ∃! other : PhysicalComponentPort T coloring pair root hroot,
      other ≠ rootPhysicalComponentPort T coloring pair root hroot :=
  (Nat.card_eq_two_iff'
    (rootPhysicalComponentPort T coloring pair root hroot)).mp
      (card_physicalComponentPort_eq_two T hcubic coloring hproper
        pair root hroot)

/-- The actual boundary mate supplied by the common bichromatic component.
Inactive ports are fixed. -/
noncomputable def physicalMate
    (T : PortTangle V I P) (hcubic : IsCubic T)
    (coloring : Coloring T) (hproper : IsProper coloring)
    (pair : TaitColorPair) : P → P := fun root =>
  if hroot : pairActiveDart coloring pair (Sum.inr root) then
    (Classical.choose
      (existsUnique_otherPhysicalComponentPort T hcubic coloring hproper
        pair root hroot)).1
  else root

theorem physicalMate_eq_self_of_inactive
    (T : PortTangle V I P) (hcubic : IsCubic T)
    (coloring : Coloring T) (hproper : IsProper coloring)
    (pair : TaitColorPair) (root : P)
    (hroot : ¬ pairActiveDart coloring pair (Sum.inr root)) :
    physicalMate T hcubic coloring hproper pair root = root := by
  simp [physicalMate, hroot]

/-- Characterization of the physical mate at an active port. -/
theorem physicalMate_eq_iff_of_active
    (T : PortTangle V I P) (hcubic : IsCubic T)
    (coloring : Coloring T) (hproper : IsProper coloring)
    (pair : TaitColorPair) (root other : P)
    (hroot : pairActiveDart coloring pair (Sum.inr root)) :
    physicalMate T hcubic coloring hproper pair root = other ↔
      other ≠ root ∧
        pairActiveDart coloring pair (Sum.inr other) ∧
        KempeConnected T coloring pair (Sum.inr root) (Sum.inr other) := by
  let chosen := Classical.choose
    (existsUnique_otherPhysicalComponentPort T hcubic coloring hproper
      pair root hroot)
  have hchosen := Classical.choose_spec
    (existsUnique_otherPhysicalComponentPort T hcubic coloring hproper
      pair root hroot)
  have hmate : physicalMate T hcubic coloring hproper pair root = chosen.1 := by
    simp [physicalMate, hroot, chosen]
  constructor
  · intro heq
    rw [hmate] at heq
    subst other
    refine ⟨?_, chosen.2⟩
    intro hEq
    apply hchosen.1
    apply Subtype.ext
    exact hEq
  · rintro ⟨hne, hactive, hconnected⟩
    let candidate : PhysicalComponentPort T coloring pair root hroot :=
      ⟨other, hactive, hconnected⟩
    have hcandidateNe : candidate ≠
        rootPhysicalComponentPort T coloring pair root hroot := by
      intro hEq
      exact hne (congrArg Subtype.val hEq)
    have hcandEq : candidate = chosen := hchosen.2 candidate hcandidateNe
    rw [hmate]
    exact congrArg Subtype.val hcandEq.symm

theorem physicalMate_active_iff
    (T : PortTangle V I P) (hcubic : IsCubic T)
    (coloring : Coloring T) (hproper : IsProper coloring)
    (pair : TaitColorPair) (root : P) :
    pairActiveDart coloring pair
        (Sum.inr (physicalMate T hcubic coloring hproper pair root)) ↔
      pairActiveDart coloring pair (Sum.inr root) := by
  constructor
  · intro hmateActive
    by_contra hroot
    rw [physicalMate_eq_self_of_inactive T hcubic coloring hproper pair
      root hroot] at hmateActive
    exact hroot hmateActive
  · intro hroot
    exact ((physicalMate_eq_iff_of_active T hcubic coloring hproper pair
      root _ hroot).1 rfl).2.1

theorem physicalMate_ne_of_active
    (T : PortTangle V I P) (hcubic : IsCubic T)
    (coloring : Coloring T) (hproper : IsProper coloring)
    (pair : TaitColorPair) (root : P)
    (hroot : pairActiveDart coloring pair (Sum.inr root)) :
    physicalMate T hcubic coloring hproper pair root ≠ root :=
  ((physicalMate_eq_iff_of_active T hcubic coloring hproper pair
    root _ hroot).1 rfl).1

theorem physicalMate_involutive
    (T : PortTangle V I P) (hcubic : IsCubic T)
    (coloring : Coloring T) (hproper : IsProper coloring)
    (pair : TaitColorPair) (root : P) :
    physicalMate T hcubic coloring hproper pair
        (physicalMate T hcubic coloring hproper pair root) = root := by
  by_cases hroot : pairActiveDart coloring pair (Sum.inr root)
  · let other := physicalMate T hcubic coloring hproper pair root
    have hspec := (physicalMate_eq_iff_of_active T hcubic coloring hproper
      pair root other hroot).1 rfl
    apply (physicalMate_eq_iff_of_active T hcubic coloring hproper pair
      other root hspec.2.1).2
    exact ⟨hspec.1.symm, hroot, Relation.EqvGen.symm _ _ hspec.2.2⟩
  · rw [physicalMate_eq_self_of_inactive T hcubic coloring hproper
      pair root hroot]
    exact physicalMate_eq_self_of_inactive T hcubic coloring hproper
      pair root hroot

/-! ## Switching a selected union of physical components -/

/-- The union of all physical components rooted at selected active ports. -/
def selectedPhysicalComponents
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (selected : Finset P) (dart : I ⊕ P) : Prop :=
  ∃ root ∈ selected,
    pairActiveDart coloring pair (Sum.inr root) ∧
      KempeConnected T coloring pair (Sum.inr root) dart

noncomputable instance selectedPhysicalComponentsDecidable
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (selected : Finset P) :
    DecidablePred (selectedPhysicalComponents T coloring pair selected) :=
  Classical.decPred _

/-- An arbitrary union of literal common-web components is a valid Kempe
region. -/
theorem selectedPhysicalComponents_kempeRegion
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (selected : Finset P) :
    KempeRegion T coloring pair
      (selectedPhysicalComponents T coloring pair selected) := by
  constructor
  · intro dart hdart
    rcases hdart with ⟨root, _, hroot, hconnected⟩
    exact pairActiveDart_of_kempeConnected T coloring pair hroot hconnected
  · intro dart
    constructor
    · rintro ⟨root, hrootMem, hroot, hconnected⟩
      refine ⟨root, hrootMem, hroot, ?_⟩
      exact (component_kempeRegion T coloring pair (Sum.inr root) hroot
        |>.alpha_closed dart).1 hconnected
    · rintro ⟨root, hrootMem, hroot, hconnected⟩
      refine ⟨root, hrootMem, hroot, ?_⟩
      exact (component_kempeRegion T coloring pair (Sum.inr root) hroot
        |>.alpha_closed dart).2 hconnected
  · intro first second hfirst hsecond hvert
    constructor
    · rintro ⟨root, hrootMem, hroot, hconnected⟩
      refine ⟨root, hrootMem, hroot, ?_⟩
      exact (component_kempeRegion T coloring pair (Sum.inr root) hroot
        |>.vertex_closed first second hfirst hsecond hvert).1 hconnected
    · rintro ⟨root, hrootMem, hroot, hconnected⟩
      refine ⟨root, hrootMem, hroot, ?_⟩
      exact (component_kempeRegion T coloring pair (Sum.inr root) hroot
        |>.vertex_closed first second hfirst hsecond hvert).2 hconnected

/-- If `selected` is closed under the physical mate involution, the boundary
ports of its selected physical components are exactly its active members. -/
theorem selectedPhysicalComponents_boundary_iff
    (T : PortTangle V I P) (hcubic : IsCubic T)
    (coloring : Coloring T) (hproper : IsProper coloring)
    (pair : TaitColorPair) (selected : Finset P)
    (hunion : ∀ port,
      port ∈ selected ↔
        physicalMate T hcubic coloring hproper pair port ∈ selected)
    (port : P) :
    selectedPhysicalComponents T coloring pair selected (Sum.inr port) ↔
      port ∈ selected ∧ pairActiveDart coloring pair (Sum.inr port) := by
  constructor
  · rintro ⟨root, hrootMem, hrootActive, hconnected⟩
    have hportActive := pairActiveDart_of_kempeConnected T coloring pair
      hrootActive hconnected
    refine ⟨?_, hportActive⟩
    by_cases heq : port = root
    · simpa [heq] using hrootMem
    · have hmate : physicalMate T hcubic coloring hproper pair root = port :=
        (physicalMate_eq_iff_of_active T hcubic coloring hproper pair
          root port hrootActive).2 ⟨heq, hportActive, hconnected⟩
      have := (hunion root).mp hrootMem
      simpa [hmate] using this
  · rintro ⟨hportMem, hportActive⟩
    exact ⟨port, hportMem, hportActive, Relation.EqvGen.refl _⟩

end Finite

/-! ## The induced exact six-port closure witness -/

section SixPorts

variable {V₀ I₀ : Type}
  [Fintype V₀] [Fintype I₀]
  [DecidableEq V₀] [DecidableEq I₀]

theorem activePort_properBoundaryWord_iff
    (T : PortTangle V₀ I₀ (Fin 6)) (coloring : Coloring T)
    (hproper : IsProper coloring) (pair : TaitColorPair) (port : Fin 6) :
    activePort (properBoundaryWord coloring hproper) pair port ↔
      pairActiveDart coloring pair (Sum.inr port) := by
  rfl

/-- The physical mate is an active matching in the exact sense used by the
finite six-port audit. -/
theorem physicalMate_isActiveMatching
    (T : PortTangle V₀ I₀ (Fin 6)) (hcubic : IsCubic T)
    (coloring : Coloring T) (hproper : IsProper coloring)
    (pair : TaitColorPair) :
    IsActiveMatching (properBoundaryWord coloring hproper) pair
      (physicalMate T hcubic coloring hproper pair) := by
  intro port
  refine ⟨?_, physicalMate_involutive T hcubic coloring hproper pair port,
    ?_, ?_⟩
  · rw [activePort_properBoundaryWord_iff,
      activePort_properBoundaryWord_iff]
    exact (physicalMate_active_iff T hcubic coloring hproper pair port).symm
  · intro hactive
    exact physicalMate_ne_of_active T hcubic coloring hproper pair port
      ((activePort_properBoundaryWord_iff T coloring hproper pair port).1
        hactive)
  · intro hinactive
    exact physicalMate_eq_self_of_inactive T hcubic coloring hproper pair port
      (fun h => hinactive
        ((activePort_properBoundaryWord_iff T coloring hproper pair port).2 h))

theorem pairSwap_eq_self_of_not_active
    (pair : TaitColorPair) (color : Color)
    (hinactive : ¬ pairActiveColor pair color) :
    Color.swap pair.colors.1 pair.colors.2 color = color := by
  apply Color.swap_ne
  · intro h
    exact hinactive (Or.inl h)
  · intro h
    exact hinactive (Or.inr h)

/-- Every selected union of physical matched components induces the literal
boundary switch and stays inside the exact Tait support. -/
theorem swapBoundaryWord_mem_taitSupport_of_isComponentUnion
    (T : PortTangle V₀ I₀ (Fin 6)) (hcubic : IsCubic T)
    (coloring : Coloring T) (hproper : IsProper coloring)
    (pair : TaitColorPair) (selected : Finset (Fin 6))
    (hunion : IsComponentUnion
      (physicalMate T hcubic coloring hproper pair) selected) :
    swapBoundaryWord (properBoundaryWord coloring hproper) pair selected ∈
      taitSupport T := by
  let selectedDarts := selectedPhysicalComponents T coloring pair selected
  let region := selectedPhysicalComponents_kempeRegion
    T coloring pair selected
  let switched := switchRegion T coloring pair selectedDarts region
  let switchedProper := switchRegion_isProper
    T coloring hproper pair selectedDarts region
  have hmem : properBoundaryWord switched switchedProper ∈ taitSupport T :=
    properBoundaryWord_switchRegion_mem_taitSupport
      T coloring hproper pair selectedDarts region
  have hboundary := properBoundaryWord_switchRegion_eq
    T coloring hproper pair selectedDarts region
  change properBoundaryWord
    (switchRegion T coloring pair selectedDarts region) _ ∈ taitSupport T at hmem
  rw [hboundary] at hmem
  have hwords : swapBoundaryWord (properBoundaryWord coloring hproper)
      pair selected =
      (fun port =>
        if port ∈ selectedPorts selectedDarts then
          ⟨Color.swap pair.colors.1 pair.colors.2
              (properBoundaryWord coloring hproper port).1,
            pairSwap_ne_zero pair
              (properBoundaryWord coloring hproper port).2⟩
        else properBoundaryWord coloring hproper port) := by
    funext port
    have hselectedDart : selectedDarts (Sum.inr port) ↔
        port ∈ selected ∧ pairActiveDart coloring pair (Sum.inr port) :=
      selectedPhysicalComponents_boundary_iff T hcubic coloring hproper pair
        selected hunion port
    have hselectedPort : port ∈ selectedPorts selectedDarts ↔
        port ∈ selected ∧ pairActiveDart coloring pair (Sum.inr port) := by
      simpa [selectedPorts] using hselectedDart
    by_cases hport : port ∈ selected
    · by_cases hactive : pairActiveDart coloring pair (Sum.inr port)
      · simp [swapBoundaryWord, hport, hselectedPort, hactive]
      · have hswap : Color.swap pair.colors.1 pair.colors.2
            (properBoundaryWord coloring hproper port).1 =
            (properBoundaryWord coloring hproper port).1 :=
          pairSwap_eq_self_of_not_active pair _ hactive
        apply Subtype.ext
        simpa [swapBoundaryWord, hport, hselectedPort, hactive] using hswap
    · simp [swapBoundaryWord, hport, hselectedPort]
  rw [hwords]
  exact hmem

noncomputable instance taitSupportDecidablePredSix
    (T : PortTangle V₀ I₀ (Fin 6)) :
    DecidablePred (fun word : HexagonTaitWord => word ∈ taitSupport T) :=
  Classical.decPred _

/-- Once planarity supplies noncrossing of the physical mate, all other fields
of the boundary Kempe witness follow from the literal common web. -/
theorem properBoundaryWord_hasBoundaryKempeWitness
    (T : PortTangle V₀ I₀ (Fin 6)) (hcubic : IsCubic T)
    (coloring : Coloring T) (hproper : IsProper coloring)
    (pair : TaitColorPair)
    (hnoncrossing : IsNoncrossingMatching
      (physicalMate T hcubic coloring hproper pair)) :
    @HasBoundaryKempeWitness (taitSupport T)
      (taitSupportDecidablePredSix T)
      (properBoundaryWord coloring hproper) pair := by
  refine ⟨physicalMate T hcubic coloring hproper pair,
    physicalMate_isActiveMatching T hcubic coloring hproper pair,
    hnoncrossing, ?_⟩
  intro selected hunion
  exact swapBoundaryWord_mem_taitSupport_of_isComponentUnion
    T hcubic coloring hproper pair selected hunion

/-- Consumer-facing closure theorem: if every proper colouring of the tangle
has a noncrossing physical common-web matching, then its exact six-port support
is `BoundaryKempeClosed`. -/
theorem boundaryKempeClosed_taitSupport_of_physical_noncrossing
    (T : PortTangle V₀ I₀ (Fin 6)) (hcubic : IsCubic T)
    (hnoncrossing : ∀ (coloring : Coloring T) (hproper : IsProper coloring)
      (pair : TaitColorPair),
      IsNoncrossingMatching
        (physicalMate T hcubic coloring hproper pair)) :
    @BoundaryKempeClosed (taitSupport T)
      (taitSupportDecidablePredSix T) := by
  intro boundary hboundary pair
  rcases hboundary with ⟨coloring, hproper, hword⟩
  have hboundaryEq : properBoundaryWord coloring hproper = boundary := by
    funext port
    apply Subtype.ext
    exact congrFun hword port
  rw [← hboundaryEq]
  exact properBoundaryWord_hasBoundaryKempeWitness T hcubic coloring hproper
    pair (hnoncrossing coloring hproper pair)

end SixPorts

