import Mettapedia.GraphTheory.FourColor.GoertzelV24AnnularCrosscutSemanticBridge
import Mettapedia.GraphTheory.FourColor.GoertzelV24AnnularCrosscutComplementProfileBoundaryWord

/-!
# Finite profile audit for a source-crosscut seam

The literal source crosscut already has two generated `Count` matrices: one
for the retained open tangle and one for the complementary tangle.  This file
turns their diagonal seam supports into two *finite* sets of words, after
projecting the complete color/connectivity/face profiles to their boundary
color coordinate.

Thus the remaining transfer obligation for reverse completion is an equality
of finite, generated supports.  It is not a semantic extension axiom and it
does not introduce a configuration catalogue.  Once the corridor calculation
establishes this finite equality, the existing literal gluing theorem supplies
`SemanticProfileBridge.complete_of_outer_word`.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24AnnularCrosscut

open GoertzelV24FaceOrbitIncidence
open GoertzelV24RotationCutDartDecomposition
open GoertzelV24RotationVertexCutProfile
open GoertzelV24SpliceUnification
open GoertzelV24SpliceUnification.OrderedCutSpliceData
open SimpleGraph
open SimpleGraphDartRotation

variable {V : Type*} [Fintype V] [DecidableEq V]
  {G : SimpleGraph V} [DecidableRel G.Adj]

noncomputable section

attribute [local instance] graphEdgeSetDecidableEq

namespace SeparatedAlignedSimpleDualCrosscuts

/-- The finite seam-word support generated by the retained open tangle's
complete profile-count matrix.  A word is retained exactly when some positive
matrix entry has that word on both source interfaces (with the proved width
alignment on the right). -/
noncomputable def sourceCrosscutLiteralOpenSeamProfileWords
    (data : Data G)
    {start finish : AmbientFace
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    {hunique : PairwiseUniqueSharedInteriorEdges
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    (pair : SeparatedAlignedSimpleDualCrosscuts
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))
      start finish hunique)
    (boundary : SourceCrosscutBoundaryData data pair) :
    Finset (Fin pair.left.walk.length → Color) := by
  classical
  exact Finset.univ.filter fun word =>
    ∃ leftProfile rightProfile : pair.SourceCrosscutInterfaceProfile data boundary,
      pair.sourceCrosscutInterfaceProfileLeftColorWord data boundary leftProfile = word ∧
        pair.sourceCrosscutInterfaceProfileRightColorWord data boundary rightProfile =
          (fun step => word (Fin.cast pair.length_eq.symm step)) ∧
          0 < pair.sourceCrosscutLiteralOpenProfileCount data boundary
            leftProfile rightProfile

/-- Membership in the retained finite audit support is exactly positivity of
the literal retained seam count.  This is the profile-matrix factorization of
the one-word diagonal count, proved from literal open-tangle fibers. -/
theorem mem_sourceCrosscutLiteralOpenSeamProfileWords_iff
    (data : Data G)
    {start finish : AmbientFace
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    {hunique : PairwiseUniqueSharedInteriorEdges
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    (pair : SeparatedAlignedSimpleDualCrosscuts
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))
      start finish hunique)
    (boundary : SourceCrosscutBoundaryData data pair)
    (word : Fin pair.left.walk.length → Color) :
    word ∈ pair.sourceCrosscutLiteralOpenSeamProfileWords data boundary ↔
      0 < pair.sourceCrosscutLiteralOpenSeamColorCount data boundary word := by
  classical
  simp only [sourceCrosscutLiteralOpenSeamProfileWords, Finset.mem_filter,
    Finset.mem_univ, true_and]
  rw [sourceCrosscutLiteralOpenSeamColorCount]
  exact (pair.sourceCrosscutLiteralBoundaryColorCount_pos_iff_exists_profilePair
    data boundary word (fun step => word (Fin.cast pair.length_eq.symm step))).symm

/-- The finite seam-word support generated by the complementary open tangle's
complete profile-count matrix.  Its profile carrier is independently computed
from the removed side; only the displayed boundary color words are compared.
-/
noncomputable def sourceCrosscutComplementSeamProfileWords
    (data : Data G)
    {start finish : AmbientFace
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    {hunique : PairwiseUniqueSharedInteriorEdges
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    (pair : SeparatedAlignedSimpleDualCrosscuts
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))
      start finish hunique)
    (boundary : SourceCrosscutBoundaryData data pair)
    (hcubic : data.toRotationSystem.IsCubic) :
    Finset (Fin pair.left.walk.length → Color) := by
  classical
  exact Finset.univ.filter fun word =>
    ∃ leftProfile rightProfile :
        pair.SourceCrosscutComplementInterfaceProfile data boundary,
      pair.sourceCrosscutComplementInterfaceProfileLeftColorWord data boundary
          leftProfile = word ∧
        pair.sourceCrosscutComplementInterfaceProfileRightColorWord data boundary
          rightProfile =
            (fun step => word (Fin.cast pair.length_eq.symm step)) ∧
          0 < pair.sourceCrosscutComplementLiteralOpenProfileCount data boundary
            hcubic leftProfile rightProfile

/-- Membership in the complementary finite audit support is exactly positivity
of the literal complementary seam count. -/
theorem mem_sourceCrosscutComplementSeamProfileWords_iff
    (data : Data G)
    {start finish : AmbientFace
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    {hunique : PairwiseUniqueSharedInteriorEdges
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    (pair : SeparatedAlignedSimpleDualCrosscuts
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))
      start finish hunique)
    (boundary : SourceCrosscutBoundaryData data pair)
    (hcubic : data.toRotationSystem.IsCubic)
    (word : Fin pair.left.walk.length → Color) :
    word ∈ pair.sourceCrosscutComplementSeamProfileWords data boundary hcubic ↔
      0 < pair.sourceCrosscutComplementSeamColorCount data boundary hcubic word := by
  classical
  simp only [sourceCrosscutComplementSeamProfileWords, Finset.mem_filter,
    Finset.mem_univ, true_and]
  rw [pair.sourceCrosscutComplementSeamColorCount_eq_boundaryColorCount_diagonal]
  exact (pair.sourceCrosscutComplementBoundaryColorCount_pos_iff_exists_profilePair
    data boundary hcubic word
      (fun step => word (Fin.cast pair.length_eq.symm step))).symm

/-- The exact finite audit required of a repeated source corridor: its two
generated profile matrices accept the same diagonal seam words. -/
def SourceCrosscutFiniteSeamProfileAuditAgreement
    (data : Data G)
    {start finish : AmbientFace
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    {hunique : PairwiseUniqueSharedInteriorEdges
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    (pair : SeparatedAlignedSimpleDualCrosscuts
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))
      start finish hunique)
    (boundary : SourceCrosscutBoundaryData data pair)
    (hcubic : data.toRotationSystem.IsCubic) : Prop :=
  pair.sourceCrosscutLiteralOpenSeamProfileWords data boundary =
    pair.sourceCrosscutComplementSeamProfileWords data boundary hcubic

/-- The finite profile audit is equivalent to the concrete generated-count
support agreement consumed by literal gluing.  This makes the remaining
source transfer obligation finite and checkable without conflating it with a
semantic completion assumption. -/
theorem sourceCrosscutSeamSupportAgreement_iff_finiteSeamProfileAuditAgreement
    (data : Data G)
    {start finish : AmbientFace
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    {hunique : PairwiseUniqueSharedInteriorEdges
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    (pair : SeparatedAlignedSimpleDualCrosscuts
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))
      start finish hunique)
    (boundary : SourceCrosscutBoundaryData data pair)
    (hcubic : data.toRotationSystem.IsCubic) :
    pair.SourceCrosscutSeamSupportAgreement data boundary hcubic ↔
      pair.SourceCrosscutFiniteSeamProfileAuditAgreement data boundary hcubic := by
  constructor
  · intro hsupport
    apply Finset.ext
    intro word
    rw [pair.mem_sourceCrosscutLiteralOpenSeamProfileWords_iff data boundary,
      pair.mem_sourceCrosscutComplementSeamProfileWords_iff data boundary hcubic]
    exact hsupport word
  · intro haudit word
    have hmember := Finset.ext_iff.mp haudit word
    rw [pair.mem_sourceCrosscutLiteralOpenSeamProfileWords_iff data boundary,
      pair.mem_sourceCrosscutComplementSeamProfileWords_iff data boundary hcubic]
      at hmember
    exact hmember

/-- Once the source's generated finite profile audit passes, literal gluing
constructs the complete semantic reverse-completion bridge. -/
noncomputable def sourceCrosscutSemanticProfileBridge_ofFiniteSeamProfileAudit
    (data : Data G)
    {start finish : AmbientFace
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    {hunique : PairwiseUniqueSharedInteriorEdges
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))}
    (pair : SeparatedAlignedSimpleDualCrosscuts
      (orbitFaceBoundary data.toRotationSystem)
      (Finset.univ : Finset (OrbitFace data.toRotationSystem))
      start finish hunique)
    (boundary : SourceCrosscutBoundaryData data pair)
    (hcubic : data.toRotationSystem.IsCubic)
    (seamEndpoints : ∀ step,
      data.toRotationSystem.vertOf
          (orderedBoundaryDart data.toRotationSystem
            (fun vertex => vertex ∈ pair.componentSide boundary.component)
            (pair.left.crossingEdge hunique) boundary.leftCrosses step).1.1.1 ≠
        data.toRotationSystem.vertOf
          (orderedBoundaryDart data.toRotationSystem
            (fun vertex => vertex ∈ pair.componentSide boundary.component)
            (fun index => pair.right.crossingEdge hunique
              (Fin.cast pair.length_eq index))
            (fun index => boundary.rightCrosses
              (Fin.cast pair.length_eq index)) step).1.1.1)
    (haudit : pair.SourceCrosscutFiniteSeamProfileAuditAgreement
      data boundary hcubic) :
    (pair.sourceCrosscutSpliceData data boundary seamEndpoints).SemanticProfileBridge :=
  pair.sourceCrosscutSemanticProfileBridge_ofSeamSupport data boundary hcubic
    seamEndpoints
    ((pair.sourceCrosscutSeamSupportAgreement_iff_finiteSeamProfileAuditAgreement
      data boundary hcubic).2 haudit)

end SeparatedAlignedSimpleDualCrosscuts

end

end GoertzelV24AnnularCrosscut

end Mettapedia.GraphTheory.FourColor
