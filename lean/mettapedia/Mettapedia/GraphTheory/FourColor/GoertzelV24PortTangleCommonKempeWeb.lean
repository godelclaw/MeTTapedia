import Mettapedia.GraphTheory.FourColor.GoertzelV24HexagonPairingTargetAwareBoundary

/-!
# The common Kempe web of one port-tangle colouring

The boundary matchings seen by the three colour pairs are not independent
choices.  They are all induced by one proper colouring of one literal tangle.
This file records the combinatorial part of that statement, before any planar
noncrossing argument.

A `KempeRegion` is a union of bichromatic components described locally: it
contains only darts with one of the selected colours, is closed across every
interior edge, and at a vertex it contains either both active darts or neither.
Switching such a region preserves the literal port-tangle colouring equations
and properness.  Thus every region of the common web gives another word in the
same exact physical support.

Noncrossing of the boundary endpoints is deliberately absent.  `PortTangle`
forgets the rotation system, so that conclusion belongs to a separate planar
disk theorem.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24PortTangleCommonKempeWeb

open GoertzelV24PortTangleGluing
open GoertzelV24PortTangleGluing.PortTangle
open GoertzelV24PortTangleCutParity
open GoertzelV24HexagonPairingTargetAwareBoundary

universe u

variable {V I P : Type u}

/-- A colour lies in the selected bichromatic pair. -/
def pairActiveColor (pair : TaitColorPair) (color : Color) : Prop :=
  color ∈ Color.twoColor pair.colors.1 pair.colors.2

/-- A dart is active in the selected bichromatic subgraph. -/
def pairActiveDart (coloring : Coloring (T : PortTangle V I P))
    (pair : TaitColorPair) (dart : I ⊕ P) : Prop :=
  pairActiveColor pair (coloring.color dart)

/-- A locally saturated union of components of one bichromatic web.

The first clause excludes the third colour.  The second crosses genuine
interior edges.  The third crosses a cubic vertex between its two active
darts.  These are exactly the local moves generating bichromatic components.
-/
structure KempeRegion (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (selected : I ⊕ P → Prop) : Prop where
  active : ∀ dart, selected dart → pairActiveDart coloring pair dart
  alpha_closed : ∀ dart : I,
    selected (Sum.inl (T.alpha dart)) ↔ selected (Sum.inl dart)
  vertex_closed : ∀ first second,
    pairActiveDart coloring pair first →
    pairActiveDart coloring pair second →
    T.vert first = T.vert second →
    (selected first ↔ selected second)

/-- One local wire of the bichromatic web: either pass through a vertex or
cross an interior edge.  Both endpoints are required to be active. -/
def KempeStep (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (first second : I ⊕ P) : Prop :=
  pairActiveDart coloring pair first ∧
    pairActiveDart coloring pair second ∧
    (T.vert first = T.vert second ∨
      ∃ dart : I,
        first = Sum.inl dart ∧
          second = Sum.inl (T.alpha dart))

/-- Connectivity in the one physical bichromatic web generated by the local
vertex and interior-edge wires. -/
def KempeConnected (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) : I ⊕ P → I ⊕ P → Prop :=
  Relation.EqvGen (KempeStep T coloring pair)

theorem pairActiveDart_alpha_iff
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (dart : I) :
    pairActiveDart coloring pair (Sum.inl (T.alpha dart)) ↔
      pairActiveDart coloring pair (Sum.inl dart) := by
  unfold pairActiveDart
  rw [coloring.invariant]

/-- Web connectivity preserves membership in the selected colour pair. -/
theorem pairActiveDart_iff_of_kempeConnected
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) {first second : I ⊕ P}
    (hconnected : KempeConnected T coloring pair first second) :
    pairActiveDart coloring pair first ↔
      pairActiveDart coloring pair second := by
  induction hconnected with
  | rel first second hstep => exact iff_of_true hstep.1 hstep.2.1
  | refl => exact Iff.rfl
  | symm first second _ ih => exact ih.symm
  | trans first middle last _ _ ihFirst ihSecond =>
      exact ihFirst.trans ihSecond

/-- Every dart connected to an active root is active. -/
theorem pairActiveDart_of_kempeConnected
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) {root dart : I ⊕ P}
    (hroot : pairActiveDart coloring pair root)
    (hconnected : KempeConnected T coloring pair root dart) :
    pairActiveDart coloring pair dart :=
  (pairActiveDart_iff_of_kempeConnected T coloring pair hconnected).1 hroot

/-- The equivalence class of one active root is a locally saturated Kempe
region.  Hence `KempeRegion` is not merely an axiomatized switch condition:
literal components of the common web supply it. -/
theorem component_kempeRegion
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (root : I ⊕ P)
    (hroot : pairActiveDart coloring pair root) :
    KempeRegion T coloring pair
      (fun dart => KempeConnected T coloring pair root dart) := by
  constructor
  · intro dart hdart
    exact pairActiveDart_of_kempeConnected T coloring pair hroot hdart
  · intro dart
    by_cases hactive : pairActiveDart coloring pair (Sum.inl dart)
    · have hactiveAlpha :
          pairActiveDart coloring pair (Sum.inl (T.alpha dart)) :=
        (pairActiveDart_alpha_iff T coloring pair dart).2 hactive
      have hedgeForward :
          KempeStep T coloring pair (Sum.inl dart)
            (Sum.inl (T.alpha dart)) :=
        ⟨hactive, hactiveAlpha, Or.inr ⟨dart, rfl, rfl⟩⟩
      constructor
      · intro hselected
        exact Relation.EqvGen.trans _ _ _ hselected
          (Relation.EqvGen.symm _ _
            (Relation.EqvGen.rel _ _ hedgeForward))
      · intro hselected
        exact Relation.EqvGen.trans _ _ _ hselected
          (Relation.EqvGen.rel _ _ hedgeForward)
    · have hactiveAlpha :
          ¬ pairActiveDart coloring pair (Sum.inl (T.alpha dart)) :=
        fun h => hactive ((pairActiveDart_alpha_iff T coloring pair dart).1 h)
      constructor
      · intro hselected
        exact False.elim (hactiveAlpha
          (pairActiveDart_of_kempeConnected T coloring pair hroot hselected))
      · intro hselected
        exact False.elim (hactive
          (pairActiveDart_of_kempeConnected T coloring pair hroot hselected))
  · intro first second hfirst hsecond hvertex
    have hstep : KempeStep T coloring pair first second :=
      ⟨hfirst, hsecond, Or.inl hvertex⟩
    constructor
    · intro hselected
      exact Relation.EqvGen.trans _ _ _ hselected
        (Relation.EqvGen.rel _ _ hstep)
    · intro hselected
      exact Relation.EqvGen.trans _ _ _ hselected
        (Relation.EqvGen.symm _ _ (Relation.EqvGen.rel _ _ hstep))

private theorem colorSwap_eq_equivSwap (first second color : Color) :
    Color.swap first second color = Equiv.swap first second color := by
  by_cases hfirst : color = first
  · subst color
    simp
  · by_cases hsecond : color = second
    · subst color
      simp
    · simp [Color.swap, hfirst, hsecond, Equiv.swap_apply_def]

theorem pairSwap_injective (pair : TaitColorPair) :
    Function.Injective
      (Color.swap pair.colors.1 pair.colors.2) := by
  intro first second heq
  rw [colorSwap_eq_equivSwap, colorSwap_eq_equivSwap] at heq
  exact (Equiv.swap pair.colors.1 pair.colors.2).injective heq

theorem pairSwap_ne_zero (pair : TaitColorPair) {color : Color}
    (hcolor : color ≠ 0) :
    Color.swap pair.colors.1 pair.colors.2 color ≠ 0 := by
  cases pair <;>
    rcases eq_red_or_eq_blue_or_eq_purple_of_ne_zero color hcolor with
      h | h | h <;>
    simp [TaitColorPair.colors, Color.swap, h, red, blue, purple]

theorem pairActiveColor_swap_iff (pair : TaitColorPair) (color : Color) :
    pairActiveColor pair
        (Color.swap pair.colors.1 pair.colors.2 color) ↔
      pairActiveColor pair color := by
  exact Color.swap_mem_twoColor_iff _ _ _

/-- Switch the selected union of components of the common web. -/
noncomputable def switchRegion (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (selected : I ⊕ P → Prop) [DecidablePred selected]
    (region : KempeRegion T coloring pair selected) : Coloring T where
  color dart :=
    if selected dart then
      Color.swap pair.colors.1 pair.colors.2 (coloring.color dart)
    else coloring.color dart
  invariant := by
    intro dart
    have hselected := region.alpha_closed dart
    by_cases hright : selected (Sum.inl dart)
    · have hleft : selected (Sum.inl (T.alpha dart)) := hselected.2 hright
      simp [hright, hleft, coloring.invariant]
    · have hleft : ¬ selected (Sum.inl (T.alpha dart)) := by
        intro h
        exact hright (hselected.1 h)
      simp [hright, hleft, coloring.invariant]

@[simp] theorem switchRegion_color_of_mem
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (selected : I ⊕ P → Prop) [DecidablePred selected]
    (region : KempeRegion T coloring pair selected) {dart : I ⊕ P}
    (hdart : selected dart) :
    (switchRegion T coloring pair selected region).color dart =
      Color.swap pair.colors.1 pair.colors.2 (coloring.color dart) := by
  simp [switchRegion, hdart]

@[simp] theorem switchRegion_color_of_not_mem
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (selected : I ⊕ P → Prop) [DecidablePred selected]
    (region : KempeRegion T coloring pair selected) {dart : I ⊕ P}
    (hdart : ¬ selected dart) :
    (switchRegion T coloring pair selected region).color dart =
      coloring.color dart := by
  simp [switchRegion, hdart]

/-- Switching a union of components preserves active versus inactive darts. -/
theorem pairActiveDart_switchRegion_iff
    (T : PortTangle V I P) (coloring : Coloring T)
    (pair : TaitColorPair) (selected : I ⊕ P → Prop) [DecidablePred selected]
    (region : KempeRegion T coloring pair selected) (dart : I ⊕ P) :
    pairActiveDart (switchRegion T coloring pair selected region) pair dart ↔
      pairActiveDart coloring pair dart := by
  by_cases hdart : selected dart
  · simp [pairActiveDart, switchRegion, hdart, pairActiveColor_swap_iff]
  · simp [pairActiveDart, switchRegion, hdart]

/-- **Common-web switch theorem.**  A switch on any locally saturated union
of components of one bichromatic web preserves a proper port-tangle
colouring. -/
theorem switchRegion_isProper
    (T : PortTangle V I P) (coloring : Coloring T)
    (hproper : IsProper coloring)
    (pair : TaitColorPair) (selected : I ⊕ P → Prop) [DecidablePred selected]
    (region : KempeRegion T coloring pair selected) :
    IsProper (switchRegion T coloring pair selected region) := by
  constructor
  · intro dart
    by_cases hdart : selected dart
    · rw [switchRegion_color_of_mem T coloring pair selected region hdart]
      exact pairSwap_ne_zero pair (hproper.1 dart)
    · rw [switchRegion_color_of_not_mem T coloring pair selected region hdart]
      exact hproper.1 dart
  · intro first second hvertex hne
    by_cases hfirst : selected first
    · have hfirstActive := region.active first hfirst
      by_cases hsecond : selected second
      · rw [switchRegion_color_of_mem T coloring pair selected region hfirst,
            switchRegion_color_of_mem T coloring pair selected region hsecond]
        exact (pairSwap_injective pair).ne
          (hproper.2 first second hvertex hne)
      · rw [switchRegion_color_of_mem T coloring pair selected region hfirst,
            switchRegion_color_of_not_mem T coloring pair selected region hsecond]
        intro heq
        have hsecondInactive : ¬ pairActiveDart coloring pair second := by
          intro hactive
          exact hsecond ((region.vertex_closed first second
            hfirstActive hactive hvertex).1 hfirst)
        apply hsecondInactive
        unfold pairActiveDart at hfirstActive ⊢
        rw [← heq]
        exact (pairActiveColor_swap_iff pair (coloring.color first)).2
          hfirstActive
    · by_cases hsecond : selected second
      · have hsecondActive := region.active second hsecond
        rw [switchRegion_color_of_not_mem T coloring pair selected region hfirst,
            switchRegion_color_of_mem T coloring pair selected region hsecond]
        intro heq
        have hfirstInactive : ¬ pairActiveDart coloring pair first := by
          intro hactive
          exact hfirst ((region.vertex_closed first second
            hactive hsecondActive hvertex).2 hsecond)
        apply hfirstInactive
        unfold pairActiveDart at hsecondActive ⊢
        rw [heq]
        exact (pairActiveColor_swap_iff pair (coloring.color second)).2
          hsecondActive
      · rw [switchRegion_color_of_not_mem T coloring pair selected region hfirst,
            switchRegion_color_of_not_mem T coloring pair selected region hsecond]
        exact hproper.2 first second hvertex hne

/-- A proper literal colouring, with the nonzero proof retained in every
boundary coordinate. -/
def properBoundaryWord (coloring : Coloring (T : PortTangle V I P))
    (hproper : IsProper coloring) : P → {color : Color // color ≠ 0} :=
  fun port => ⟨word coloring port, hproper.1 (Sum.inr port)⟩

/-- The boundary word of a proper colouring lies in the exact physical
support of its tangle. -/
theorem properBoundaryWord_mem_taitSupport
    (T : PortTangle V I P) (coloring : Coloring T)
    (hproper : IsProper coloring) :
    properBoundaryWord coloring hproper ∈ taitSupport T := by
  exact ⟨coloring, hproper, rfl⟩

/-- Boundary coordinates selected by one common-web region. -/
def selectedPorts [Fintype P] [DecidableEq P]
    (selected : I ⊕ P → Prop) [DecidablePred selected] : Finset P :=
  Finset.univ.filter fun port => selected (Sum.inr port)

/-- On six ports, the literal region switch induces exactly the abstract
boundary-word switch used by the adversary audit. -/
theorem properBoundaryWord_switchRegion_eq
    [Fintype P] [DecidableEq P]
    (T : PortTangle V I P) (coloring : Coloring T)
    (hproper : IsProper coloring)
    (pair : TaitColorPair) (selected : I ⊕ P → Prop) [DecidablePred selected]
    (region : KempeRegion T coloring pair selected) :
    properBoundaryWord
        (switchRegion T coloring pair selected region)
        (switchRegion_isProper T coloring hproper pair selected region) =
      fun port =>
        if port ∈ selectedPorts selected then
          ⟨Color.swap pair.colors.1 pair.colors.2
              (properBoundaryWord coloring hproper port).1,
            pairSwap_ne_zero pair
              (properBoundaryWord coloring hproper port).2⟩
        else properBoundaryWord coloring hproper port := by
  funext port
  by_cases hport : selected (Sum.inr port)
  · simp [properBoundaryWord, selectedPorts, hport, word,
      switchRegion_color_of_mem]
  · simp [properBoundaryWord, selectedPorts, hport, word,
      switchRegion_color_of_not_mem]

/-- Every union of components of the common web produces another word in
the same exact physical support. -/
theorem properBoundaryWord_switchRegion_mem_taitSupport
    [Fintype P] [DecidableEq P]
    (T : PortTangle V I P) (coloring : Coloring T)
    (hproper : IsProper coloring)
    (pair : TaitColorPair) (selected : I ⊕ P → Prop) [DecidablePred selected]
    (region : KempeRegion T coloring pair selected) :
    properBoundaryWord
        (switchRegion T coloring pair selected region)
        (switchRegion_isProper T coloring hproper pair selected region) ∈
      taitSupport T :=
  properBoundaryWord_mem_taitSupport _ _ _

end GoertzelV24PortTangleCommonKempeWeb

end Mettapedia.GraphTheory.FourColor
