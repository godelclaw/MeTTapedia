import Mettapedia.GraphTheory.FourColor.GoertzelV24HexagonPairingNoLinearSeparator
import Mettapedia.GraphTheory.FourColor.GoertzelV24HexagonPenroseGaugeAdversary
import Mettapedia.GraphTheory.FourColor.GoertzelV24HexagonCrossedPentagonLeafAdversary

/-!
# Rigidity of the Penrose ray supported on the persistent adversary

The fifteen perfect-pairing contractions have only a one-dimensional family
of integer linear combinations which vanish away from the sixty-word
persistent adversary.  That family is generated by the Penrose kernel tensor
already realized by the crossed pentagon--leaf network.

After applying the boundary sign gauge, every nonnegative pairing-linear
tensor supported on the adversary therefore has one constant multiplicity on
all sixty supported words.  This is an algebraic rigidity statement.  It does
not assert that a positive multiple of this ray is realized by a plane cubic
tangle; that remaining condition is genuinely topological.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24HexagonPenroseRayRigidity

open GoertzelV24RawNooseCountPumping
open GoertzelV24HexagonPairingTargetAwareBoundary
open GoertzelV24HexagonPairingInvariantKernel
open GoertzelV24HexagonPairingNoLinearSeparator
open GoertzelV24HexagonPersistentKempeAdversary
open GoertzelV24HexagonPenroseGaugeAdversary

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

private abbrev r : TaitColor := ⟨red, red_ne_zero⟩
private abbrev b : TaitColor := ⟨blue, blue_ne_zero⟩
private abbrev p : TaitColor := ⟨purple, purple_ne_zero⟩
private abbrev word6 :=
  GoertzelV24HexagonPairingTargetAwareBoundary.explicitWord

/-- Fourteen words outside the persistent adversary whose pairing-evaluation
rows have rank fourteen. -/
def rayWitness : Fin 14 → HexagonTaitWord
  | 0 => word6 r r r r r r
  | 1 => word6 r r r r b b
  | 2 => word6 r r r b r b
  | 3 => word6 r r r b b r
  | 4 => word6 r r b b r r
  | 5 => word6 r r b b b b
  | 6 => word6 r r b b p p
  | 7 => word6 r r b p b p
  | 8 => word6 r b r b r r
  | 9 => word6 r b r b b b
  | 10 => word6 r b r b p p
  | 11 => word6 r b b b r b
  | 12 => word6 r b p r b p
  | 13 => word6 r b p p r b

theorem rayWitness_not_mem_persistentAdversary (index : Fin 14) :
    rayWitness index ∉ persistentAdversary := by
  fin_cases index <;>
    change persistentAdversaryBool _ ≠ true <;> decide

/-- Coefficients of
`delta_4 - delta_5 - delta_9 + delta_10 + delta_12 - delta_13`. -/
def penroseRayCoeff : Fin 15 → Int
  | 4 => 1
  | 5 => -1
  | 9 => -1
  | 10 => 1
  | 12 => 1
  | 13 => -1
  | _ => 0

theorem pairingLinearCombination_penroseRayCoeff
    (word : HexagonTaitWord) :
    pairingLinearCombination penroseRayCoeff word =
      penroseKernelTensor word := by
  simp [pairingLinearCombination, Fin.sum_univ_succ, penroseRayCoeff,
    penroseKernelTensor]
  ring

/-- The fourteen displayed exterior rows cut the fifteen-dimensional pairing
space down to the single Penrose ray. -/
theorem coeff_eq_mul_penroseRayCoeff
    (coeff : Fin 15 → Int)
    (hvanish : ∀ word : HexagonTaitWord,
      word ∉ persistentAdversary →
        pairingLinearCombination coeff word = 0) :
    ∀ index : Fin 15,
      coeff index = coeff 4 * penroseRayCoeff index := by
  have hrow (index : Fin 14) :
      pairingLinearCombination coeff (rayWitness index) = 0 :=
    hvanish _ (rayWitness_not_mem_persistentAdversary index)
  have h0 := hrow 0
  have h1 := hrow 1
  have h2 := hrow 2
  have h3 := hrow 3
  have h4 := hrow 4
  have h5 := hrow 5
  have h6 := hrow 6
  have h7 := hrow 7
  have h8 := hrow 8
  have h9 := hrow 9
  have h10 := hrow 10
  have h11 := hrow 11
  have h12 := hrow 12
  have h13 := hrow 13
  simp +decide [pairingLinearCombination, Fin.sum_univ_succ, pairContraction,
    pairingMate, rayWitness, word6,
    GoertzelV24HexagonPairingTargetAwareBoundary.explicitWord, r, b, p, red,
    blue, purple] at h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11 h12 h13
  intro index
  fin_cases index <;> simp [penroseRayCoeff] <;> omega

/-- Every pairing-linear tensor supported on the persistent adversary is a
scalar multiple of the crossed pentagon--leaf Penrose tensor. -/
theorem pairingLinearCombination_eq_mul_penroseKernelTensor
    (coeff : Fin 15 → Int)
    (hvanish : ∀ word : HexagonTaitWord,
      word ∉ persistentAdversary →
        pairingLinearCombination coeff word = 0)
    (word : HexagonTaitWord) :
    pairingLinearCombination coeff word =
      coeff 4 * penroseKernelTensor word := by
  have hcoeff := coeff_eq_mul_penroseRayCoeff coeff hvanish
  simp only [pairingLinearCombination]
  calc
    (∑ index : Fin 15, coeff index * pairContraction index word) =
        ∑ index : Fin 15,
          (coeff 4 * penroseRayCoeff index) * pairContraction index word := by
      apply Finset.sum_congr rfl
      intro index _
      rw [hcoeff index]
    _ = coeff 4 * pairingLinearCombination penroseRayCoeff word := by
      simp only [pairingLinearCombination, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro index _
      ring
    _ = coeff 4 * penroseKernelTensor word := by
      rw [pairingLinearCombination_penroseRayCoeff]

/-- After the Penrose boundary gauge, the same rigidity says that every
supported value is the constant coefficient `coeff 4`. -/
theorem gauge_mul_pairingLinearCombination_eq_constant_on_adversary
    (coeff : Fin 15 → Int)
    (hvanish : ∀ word : HexagonTaitWord,
      word ∉ persistentAdversary →
        pairingLinearCombination coeff word = 0)
    (word : HexagonTaitWord) (hword : word ∈ persistentAdversary) :
    boundaryGauge word * pairingLinearCombination coeff word = coeff 4 := by
  rw [pairingLinearCombination_eq_mul_penroseKernelTensor coeff hvanish]
  have hone : gaugeCorrectedPenroseTensor word = 1 := by
    rw [GoertzelV24HexagonCrossedPentagonLeafAdversary.gaugeCorrectedPenroseTensor_eq_extensionCount,
      GoertzelV24HexagonCrossedPentagonLeafAdversary.card_crossedPentagonLeafExtensions,
      if_pos hword]
    simp
  change boundaryGauge word * (coeff 4 * penroseKernelTensor word) = coeff 4
  change boundaryGauge word * penroseKernelTensor word = 1 at hone
  calc
    boundaryGauge word * (coeff 4 * penroseKernelTensor word) =
        coeff 4 * (boundaryGauge word * penroseKernelTensor word) := by ring
    _ = coeff 4 * 1 := by rw [hone]
    _ = coeff 4 := by ring

/-- Consumer-facing form: vanishing off `E` leaves exactly one Penrose ray,
and its gauge-corrected values are uniform on `E`. -/
theorem persistentAdversary_pairingRay_rigid
    (coeff : Fin 15 → Int)
    (hvanish : ∀ word : HexagonTaitWord,
      word ∉ persistentAdversary →
        pairingLinearCombination coeff word = 0) :
    (∀ index : Fin 15,
        coeff index = coeff 4 * penroseRayCoeff index) ∧
      (∀ word : HexagonTaitWord, word ∈ persistentAdversary →
        boundaryGauge word * pairingLinearCombination coeff word = coeff 4) := by
  exact ⟨coeff_eq_mul_penroseRayCoeff coeff hvanish,
    gauge_mul_pairingLinearCombination_eq_constant_on_adversary coeff hvanish⟩

end GoertzelV24HexagonPenroseRayRigidity

end Mettapedia.GraphTheory.FourColor
