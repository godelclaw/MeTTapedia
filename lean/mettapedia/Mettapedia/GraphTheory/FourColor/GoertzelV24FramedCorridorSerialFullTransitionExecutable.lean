import Mettapedia.GraphTheory.FourColor.GoertzelV24FramedCorridorSerialFullTransitionDecoder

/-!
# Executable form of the finite serial transition

The finite serial decoder was introduced with the source-sound direction:
every abstract five-coordinate transition is decoded by some finite letter.
This file proves the converse at exactly that abstract level.  Consequently
the existential decoder step and `BoundedSerialFullTransition` are the same
relation, and the latter has a finite decision procedure.

This is not a converse realization theorem for source geometry.  The abstract
letter relation remains a sound over-approximation of literal source Cells;
the result below only shows that its executable presentation neither adds nor
loses transitions relative to that declared finite relation.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24FramedTrail

open GoertzelV24BoundaryProfileFiniteState
open GoertzelV24CorridorProfile
open GoertzelV24WindingClassification

/-- The graph-free executable step generated by the finite serial letters. -/
def BoundedSerialFullDecoderStep
    (input output : BoundedCorridorCutProfile 2 0 4) : Prop :=
  ∃ code : BoundedSerialFullLetterCode,
    code.decode input = some output

/-- A successful decoder application satisfies the complete abstract
five-coordinate transition relation. -/
theorem fullTransition_of_exists_letter_decode_eq_some
    {input output : BoundedCorridorCutProfile 2 0 4}
    (hdecode : BoundedSerialFullDecoderStep input output) :
    BoundedSerialFullTransition input output := by
  rcases hdecode with ⟨code, hdecode⟩
  rcases input with ⟨inputCount, inputProfile⟩
  rcases code with ⟨codeInputCount, codeOutputCount, codeTransition⟩
  rw [BoundedSerialFullLetterCode.decode] at hdecode
  split at hdecode
  next hcount =>
    have hcountFin : inputCount = codeInputCount := Fin.ext hcount
    subst codeInputCount
    simp only [Option.some.injEq] at hdecode
    subst output
    refine ⟨codeTransition, ?_, ?_, ?_, ?_, ?_⟩
    · intro step
      rfl
    · intro pair left right
      dsimp only [BoundedSerialFullLetterCode.outputProfile]
      simp [BoundedSerialFullLetterCode.outputStrandConnected]
    · intro left right
      rfl
    · intro fragment port
      rfl
    · intro fragment
      rfl
  next hcount =>
    simp at hdecode

/-- The deterministic decoder is an exact executable presentation of the
declared finite serial transition relation.  This equivalence is the stable
kernel boundary for a later sparse reachable-closure certificate. -/
theorem boundedSerialFullDecoderStep_iff_fullTransition
    (input output : BoundedCorridorCutProfile 2 0 4) :
    BoundedSerialFullDecoderStep input output ↔
      BoundedSerialFullTransition input output := by
  constructor
  · exact fullTransition_of_exists_letter_decode_eq_some
  · exact exists_letter_decode_eq_some_of_fullTransition

/-- The executable finite serial step is decidable by finite search over the
letter carrier.  No ambient graph or source realization enters the decision
procedure. -/
noncomputable instance boundedSerialFullDecoderStepDecidable
    (input output : BoundedCorridorCutProfile 2 0 4) :
    Decidable (BoundedSerialFullDecoderStep input output) :=
  Fintype.decidableExistsFintype

/-- A finite set is a verified over-approximate closure when it contains the
output of every executable letter from each of its members.  The definition
is intentionally certificate-shaped: a later sparse generator may prove this
property without testing every ordered pair of the ambient profile carrier. -/
def BoundedSerialFullDecoderClosed
    (states : Finset (BoundedCorridorCutProfile 2 0 4)) : Prop :=
  ∀ ⦃input output⦄, input ∈ states →
    BoundedSerialFullDecoderStep input output → output ∈ states

/-- Closure under one executable letter extends to every finite decoder path.
This is the induction principle used by a later kernel-checked reachable-set
certificate. -/
theorem mem_of_decoderReachable_of_closed
    {states : Finset (BoundedCorridorCutProfile 2 0 4)}
    (hclosed : BoundedSerialFullDecoderClosed states)
    {input output : BoundedCorridorCutProfile 2 0 4}
    (hinput : input ∈ states)
    (hreachable : Relation.ReflTransGen BoundedSerialFullDecoderStep
      input output) :
    output ∈ states := by
  induction hreachable using Relation.ReflTransGen.head_induction_on with
  | refl => exact hinput
  | head hstep _ ih =>
      exact ih (hclosed hinput hstep)

end GoertzelV24FramedTrail

end Mettapedia.GraphTheory.FourColor
