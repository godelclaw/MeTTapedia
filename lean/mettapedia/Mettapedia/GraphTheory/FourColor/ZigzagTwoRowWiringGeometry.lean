import Mettapedia.GraphTheory.FourColor.ZigzagTwoRowWiring
import Mettapedia.GraphTheory.FourColor.RotationCutDartSum

/-!
# Actual free-wire replacement of two zigzag rows

The smaller rotation retains precisely the exterior vertices and darts.
Right port `i` is joined to left port `i+1`. Two connected exterior shores
supply endpoint separation and the cut argument. The boundary face return
is retained as a separate geometric observation.
-/

namespace Mettapedia.GraphTheory.FourColor.ZigzagRing.ShiftedWiring.Geometry

open Equiv Equiv.Perm GoertzelV24OpenTangleComposition
open GoertzelV24RotationSpliceConstructor GoertzelV24CompositeSeamMultigraph
open GoertzelV24BoundaryEssentialGluing Multigraph BoundarySmallCutProfile
open OpenTangleCutDartSum SmallCutConnectedBridgeless
open GoertzelV24FaceDualConnectedness GoertzelV24RotationEdgeBridge
open GoertzelV24TwoEdgeCutMinimality GoertzelV24CompositeSeamCubic
open OpenTangleClosedWitness OpenTangleVertexReflection

noncomputable section
set_option backward.isDefEq.respectTransparency false
attribute [local instance] Classical.propDecidable tubeVertexFintype tubeInteriorFintype

variable (k : ℕ) [NeZero k]
variable {V I : Type*} [Fintype V] [DecidableEq V] [Fintype I] [DecidableEq I]
  (O : OpenTangleData V I (Fin k ⊕ Fin k))

/-- These conditions describe the actual exterior components. No connected
or bridge-free conclusion about the proposed replacement is assumed. -/
structure TwoShores where
  shore : V → Bool
  edge : ∀ e, shore ((sideMultigraph O).fst e) = shore ((sideMultigraph O).snd e)
  left : ∀ i, shore (O.boundaryVert (.inl i)) = false
  right : ∀ i, shore (O.boundaryVert (.inr i)) = true
  connected : ∀ u v, shore u = shore v → (sideMultigraph O).Reach u v

def wireMatching : Fin k ≃ Fin k := Equiv.addRight (-1)

def raw : MatchedSeam.Data V I (Fin k) (Fin k) where
  interiorVert := O.interiorVert
  leftVert := fun i => O.boundaryVert (.inl i)
  rightVert := fun i => O.boundaryVert (.inr i)
  interiorAlpha := O.interiorAlpha
  matching := wireMatching k
  rho := O.rho
  outer := O.outer

def Separated : Prop := ∀ i, O.boundaryVert (.inl i) ≠
  O.boundaryVert (.inr (wireMatching k i))

omit [Fintype V] [DecidableEq V] [Fintype I] [DecidableEq I] in
theorem TwoShores.separated (H : TwoShores k O) : Separated k O := by
  intro i he
  have h := (H.left i).symm.trans ((congrArg H.shore he).trans (H.right _))
  cases h

omit [Fintype V] [DecidableEq V] [Fintype I] [DecidableEq I] in
theorem raw_vertex (d : I ⊕ (Fin k ⊕ Fin k)) : (raw k O).vertOf d = O.vertOf d := by
  rcases d with i | (i | i) <;> rfl

/-- Edge orbits are generated by the retained interior flip and the new
matching. No vertices or auxiliary wire darts are introduced. -/
def data (hs : Separated k O) : RewiredDartSystem V (I ⊕ (Fin k ⊕ Fin k)) :=
  (raw k O).toRewiredDartSystem O.interiorAlpha_involutive
    O.interiorAlpha_fixfree (by
      intro d
      rw [raw_vertex, raw_vertex]
      change O.vertOf (O.rho d) = O.vertOf d
      exact O.vert_rho d)
    O.interior_no_self_loops hs

abbrev closed (hs : Separated k O) := (data k O hs).toRotationSystem
abbrev original := sewn O (tube k 1).data (Equiv.refl _)

def seamCost (s : V → Bool) : ℕ :=
  ∑ i : Fin k, bit (s (O.boundaryVert (.inl i)))
    (s (O.boundaryVert (.inr (wireMatching k i))))

theorem cut_cost (hs : Separated k O) (s : V → Bool) :
    RotationCutDartSum.cost (closed k O hs) s =
      2 * cutSize (sideMultigraph O) s + 2 * seamCost k O s := by
  rw [OpenTangleCutDartSum.twice_cutSize]
  unfold RotationCutDartSum.cost
  change (∑ d : I ⊕ (Fin k ⊕ Fin k),
    bit (s ((raw k O).vertOf d)) (s ((raw k O).vertOf ((raw k O).alpha d)))) = _
  rw [Fintype.sum_sum_type, Fintype.sum_sum_type]
  have he : (∑ i : Fin k, bit (s (O.boundaryVert (.inr i)))
      (s (O.boundaryVert (.inl ((wireMatching k).symm i))))) = seamCost k O s := by
    rw [← Equiv.sum_comp (wireMatching k)]
    simp only [Equiv.symm_apply_apply, seamCost]
    apply Finset.sum_congr rfl
    intro i _
    exact bit_symm _ _
  change (∑ d : I, bit (s (O.interiorVert d)) (s (O.interiorVert (O.interiorAlpha d)))) +
    (seamCost k O s + (∑ i : Fin k, bit (s (O.boundaryVert (.inr i)))
      (s (O.boundaryVert (.inl ((wireMatching k).symm i)))))) = _
  rw [he]
  omega

/-- Constant boundary bits extend constantly across the two rows. -/
theorem original_constant_cost (s : V → Bool) (a : Bool)
    (hb : ∀ b, s (O.boundaryVert b) = a) :
    RotationCutDartSum.cost (original k O) (Sum.elim s (fun _ => a)) =
      2 * cutSize (sideMultigraph O) s := by
  rw [RotationCutDartSum.composite_cost, ← OpenTangleCutDartSum.twice_cutSize]
  simp [hb, bit]

omit [NeZero k] [Fintype V] [DecidableEq V] [DecidableEq I] in
private theorem edge_constant_of_zero (s : V → Bool)
    (hz : cutSize (sideMultigraph O) s = 0) :
    ∀ e, s ((sideMultigraph O).fst e) = s ((sideMultigraph O).snd e) := by
  have hz' := Finset.sum_eq_zero_iff.mp hz
  intro e
  have hh := hz' e (Finset.mem_univ e)
  split_ifs at hh with he
  · exact he

omit [NeZero k] [Fintype V] [DecidableEq V] [Fintype I] [DecidableEq I] in
private theorem constant_on_shore (H : TwoShores k O) (s : V → Bool)
    (a : Bool) (he : ∀ e, H.shore ((sideMultigraph O).fst e) = a →
      s ((sideMultigraph O).fst e) = s ((sideMultigraph O).snd e))
    {u v : V} (hu : H.shore u = a) (hv : H.shore v = a) : s u = s v := by
  have hp := H.connected u v (hu.trans hv.symm)
  have hall : ∀ {u v}, (sideMultigraph O).Reach u v →
      H.shore u = a → s u = s v := by
    intro u v path
    induction path with
    | refl => exact fun _ => rfl
    | @tail v w path step ih =>
      intro hroot
      have hv' := (constant_on_path (sideMultigraph O) H.shore
        (fun _ => False) (fun e _ => H.edge e) path).symm.trans hroot
      obtain ⟨e, _, hd⟩ := step
      rcases hd with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
      · exact (ih hroot).trans (he e hv')
      · exact (ih hroot).trans (he e ((H.edge e).trans hv')).symm
  exact hall hp hu

omit [Fintype V] [DecidableEq V] [DecidableEq I] in
private theorem boundary_constant_of_small (hk : 2 ≤ k) (H : TwoShores k O) (s : V → Bool)
    (hs : cutSize (sideMultigraph O) s + seamCost k O s ≤ 1) :
    ∃ a, ∀ b, s (O.boundaryVert b) = a := by
  have ho : cutSize (sideMultigraph O) s ≤ 1 := by omega
  by_cases hz : cutSize (sideMultigraph O) s = 0
  · have hed := edge_constant_of_zero k O s hz
    have hl (i) : s (O.boundaryVert (.inl i)) = s (O.boundaryVert (.inl 0)) :=
      constant_on_path _ s (fun _ => False) (fun e _ => hed e)
        (H.connected _ _ ((H.left i).trans (H.left 0).symm))
    have hr (i) : s (O.boundaryVert (.inr i)) = s (O.boundaryVert (.inr 0)) :=
      constant_on_path _ s (fun _ => False) (fun e _ => hed e)
        (H.connected _ _ ((H.right i).trans (H.right 0).symm))
    have hsame : s (O.boundaryVert (.inl 0)) = s (O.boundaryVert (.inr 0)) := by
      by_contra hn
      have hw : seamCost k O s = k := by simp [seamCost, hl, hr, bit, hn]
      omega
    refine ⟨s (O.boundaryVert (.inl 0)), ?_⟩
    rintro (i | i)
    · exact hl i
    · exact (hr i).trans hsame.symm
  · have hw : seamCost k O s = 0 := by omega
    have hwire (i) : s (O.boundaryVert (.inl i)) =
        s (O.boundaryVert (.inr (wireMatching k i))) := by
      have hh := Finset.sum_eq_zero_iff.mp hw i (Finset.mem_univ i)
      change bit _ _ = 0 at hh
      simpa [bit] using hh
    obtain ⟨e, he⟩ : ∃ e, s ((sideMultigraph O).fst e) ≠ s ((sideMultigraph O).snd e) := by
      by_contra! hn
      exact hz (cutSize_zero _ s hn)
    let a := !(H.shore ((sideMultigraph O).fst e))
    have hedge : ∀ f, H.shore ((sideMultigraph O).fst f) = a →
        s ((sideMultigraph O).fst f) = s ((sideMultigraph O).snd f) := by
      intro f hf
      apply unique_of_small_cut _ s ho e he f
      intro hfe
      subst f
      cases ha : H.shore ((sideMultigraph O).fst e) <;> simp_all [a]
    cases ha : H.shore ((sideMultigraph O).fst e)
    · have hr (i j) : s (O.boundaryVert (.inr i)) = s (O.boundaryVert (.inr j)) :=
        constant_on_shore k O H s a hedge (by simp [a, ha, H.right]) (by simp [a, ha, H.right])
      refine ⟨s (O.boundaryVert (.inr 0)), ?_⟩
      rintro (i | i)
      · exact (hwire i).trans (hr _ _)
      · exact hr _ _
    · have hl (i j) : s (O.boundaryVert (.inl i)) = s (O.boundaryVert (.inl j)) :=
        constant_on_shore k O H s a hedge (by simp [a, ha, H.left]) (by simp [a, ha, H.left])
      refine ⟨s (O.boundaryVert (.inl 0)), ?_⟩
      rintro (i | i)
      · exact hl _ _
      · simpa only [Equiv.apply_symm_apply] using
          ((hwire ((wireMatching k).symm i)).symm.trans (hl _ 0))

/-- A new zero- or one-edge cut lifts to a cut of the original map. The
unchanged shore need not itself be bridgeless. -/
theorem structural (hk : 2 ≤ k) (H : TwoShores k O)
    (hc : (rotationPrimalGraph (original k O)).Connected)
    (hb : EdgeBridgeFree (original k O)) :
    (rotationPrimalGraph (closed k O H.separated)).Connected ∧
      EdgeBridgeFree (closed k O H.separated) := by
  have : Nonempty V := ⟨O.boundaryVert (.inl 0)⟩
  apply RotationCutDartSum.structural_of_cost
  intro s hcost u v
  rw [cut_cost] at hcost
  obtain ⟨a, ha⟩ := boundary_constant_of_small k O hk H s (by omega)
  have hold : RotationCutDartSum.cost (original k O) (Sum.elim s (fun _ => a)) ≤ 2 := by
    rw [original_constant_cost k O s a ha]
    omega
  exact RotationCutDartSum.constant_of_structural (original k O) hc hb _ hold
    (.inl u) (.inl v)

theorem cubic (hs : Separated k O) (h : OpenIsCubic O) : (closed k O hs).IsCubic := by
  intro v
  change (Finset.univ.filter (fun d => (raw k O).vertOf d = v)).card = 3
  simp only [raw_vertex]
  exact h v

theorem rotationCyclic (hs : Separated k O) (h : OpenRotationCyclic O) :
    VertexRotationCyclic (closed k O hs) := by
  intro d e he
  change (raw k O).vertOf d = (raw k O).vertOf e at he
  simp only [raw_vertex] at he
  exact h d e he

/-- Restriction retains the joint seam equation enforced by actual edges. -/
theorem restrict_colour (hs : Separated k O) (c : (closed k O hs).EdgeColoring Color)
    (hc : (closed k O hs).IsTaitEdgeColoring c) :
    IsColor O (fun d => c ((closed k O hs).edgeOf d)) ∧
      ∀ i, c ((closed k O hs).edgeOf (.inr (.inr i))) =
        c ((closed k O hs).edgeOf (.inr (.inl (i + 1)))) := by
  let RS := closed k O hs
  refine ⟨⟨?_, ?_, fun _ => hc _⟩, ?_⟩
  · intro i
    exact congrArg c (RS.edge_alpha (.inl i))
  · intro d e hv hne
    apply c.valid
    apply RS.edgeAdjacencyGraph_adj_iff.mpr
    have hv' : RS.vertOf d = RS.vertOf e := by
      change (raw k O).vertOf d = (raw k O).vertOf e
      simpa only [raw_vertex] using hv
    refine ⟨?_, RS.vertOf d, ?_, ?_⟩
    · intro he
      exact hne (RS.edgeOf_injOn_dartsAt (RS.vertOf d)
        (by simp [RotationSystem.dartsAt]) (by simp [RotationSystem.dartsAt, hv']) he)
    · exact RS.mem_endpoints_iff.mpr ⟨d, RS.mem_dartsOn.mpr rfl, rfl⟩
    · exact RS.mem_endpoints_iff.mpr ⟨e, RS.mem_dartsOn.mpr rfl, hv'.symm⟩
  · intro i
    have h := congrArg c (RS.edge_alpha (.inr (.inr i)))
    change c (RS.edgeOf (.inr (.inl ((wireMatching k).symm i)))) =
      c (RS.edgeOf (.inr (.inr i))) at h
    have he : (wireMatching k).symm i = i + 1 := by simp [wireMatching]
    rw [he] at h
    exact h.symm

/-- Every genuine smaller colouring reconstructs, including the colours
of all retained exterior darts. -/
theorem reconstruct_colour (hk : 3 ≤ k) (hs : Separated k O)
    (c : (closed k O hs).EdgeColoring Color) (hc : (closed k O hs).IsTaitEdgeColoring c) :
    ∃ old : (original k O).EdgeColoring Color, (original k O).IsTaitEdgeColoring old ∧
      ∀ d, old ((original k O).edgeOf (composeDartEquiv (.inl d))) =
        c ((closed k O hs).edgeOf d) := by
  obtain ⟨ho, hw⟩ := restrict_colour k O hs c hc
  exact closed_reconstruction k O (Equiv.refl _) hk _ ho hw

end
end Mettapedia.GraphTheory.FourColor.ZigzagRing.ShiftedWiring.Geometry
