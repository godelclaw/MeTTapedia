import Mettapedia.GraphTheory.FourColor.GoertzelV24PermutationOrbitSurgery
import Mettapedia.GraphTheory.FourColor.GoertzelV24WordReachability

/-!
# The Euler bound for permutation pairs

This module proves the combinatorial core of Euler's formula for maps, in the
generic permutation form that Mathlib currently lacks: for a permutation `σ`
and any finite list of transpositions with product `β`,

    orbits(σ) + orbits(σ * β) ≤ (number of transpositions) + 2 · components,

where `components` counts the orbits of the group generated by `σ` together
with the individual transpositions.

Read as a map: `σ` is the vertex rotation, the transpositions are the edges,
`σ * β` is the face permutation, and the components are the connected
components.  The statement is then `V + F ≤ E + 2C`, which is exactly
`V - E + F ≤ 2C` — Euler's inequality, with equality precisely in the
spherical case.  Nonnegativity of the genus is the same fact.

The proof is one induction over the edge list, and its two cases are supplied
by the two laws proved in the sibling modules:

* adding an edge whose endpoints are already connected can only *split* a
  face orbit (`orbitCount_swap_mul_of_sameCycle`), and leaves the component
  count unchanged (`wordOrbitCount_cons_swap_eq_of_reachable`);
* adding an edge across two components must *merge* two face orbits
  (`orbitCount_swap_mul_of_not_sameCycle`), and the component count can fall
  by at most one (`wordOrbitCount_le_cons_swap_add_one`).

The second case is the one that makes the bound tight: a face orbit is always
contained in a component, so an edge joining two components cannot have its
two sides on one face.  No disjointness of the transpositions is needed.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24MapEulerBound

open Equiv Equiv.Perm
open GoertzelV24PermutationOrbitSurgery
open GoertzelV24WordReachability

variable {D : Type*} [Fintype D] [DecidableEq D]

/-- The product of a list of transpositions, in list order. -/
def swapProduct : List (D × D) → Perm D
  | [] => 1
  | edge :: rest => Equiv.swap edge.1 edge.2 * swapProduct rest

omit [Fintype D] in
@[simp] theorem swapProduct_nil : swapProduct ([] : List (D × D)) = 1 := rfl

omit [Fintype D] in
@[simp] theorem swapProduct_cons (edge : D × D) (rest : List (D × D)) :
    swapProduct (edge :: rest) =
      Equiv.swap edge.1 edge.2 * swapProduct rest := rfl

/-- The transpositions of an edge list, as a generator family. -/
def swapGenerators (edges : List (D × D)) : List (Perm D) :=
  edges.map fun edge => Equiv.swap edge.1 edge.2

omit [Fintype D] in
@[simp] theorem swapGenerators_nil :
    swapGenerators ([] : List (D × D)) = [] := rfl

omit [Fintype D] in
@[simp] theorem swapGenerators_cons (edge : D × D) (rest : List (D × D)) :
    swapGenerators (edge :: rest) =
      Equiv.swap edge.1 edge.2 :: swapGenerators rest := rfl

omit [DecidableEq D] in
/-- Generator families with the same members have the same components. -/
theorem wordOrbitCount_eq_of_mem_iff {L L' : List (Perm D)}
    (h : ∀ g : Perm D, g ∈ L ↔ g ∈ L') :
    wordOrbitCount L = wordOrbitCount L' := by
  refine le_antisymm ?_ ?_
  · exact wordOrbitCount_le_of_le
      (fun _ _ => wordReachable_mono fun g hg => (h g).2 hg)
  · exact wordOrbitCount_le_of_le
      (fun _ _ => wordReachable_mono fun g hg => (h g).1 hg)

omit [DecidableEq D] in
/-- A single generator's components are its cycles. -/
theorem wordOrbitCount_singleton (σ : Perm D) :
    wordOrbitCount [σ] = orbitCount σ := by
  have hiff : ∀ x y : D, WordReachable [σ] x y ↔ σ.SameCycle x y := by
    intro x y
    constructor
    · intro h
      induction h with
      | refl => exact SameCycle.refl σ x
      | tail _hxy hstep ih =>
          obtain ⟨g, hg, rfl⟩ := hstep
          rw [List.mem_singleton] at hg
          subst hg
          exact ih.trans ⟨1, by simp⟩
    · intro h
      obtain ⟨n, rfl⟩ := exists_nat_pow_apply_eq h
      exact wordReachable_pow (List.mem_singleton_self σ) x n
  exact Fintype.card_congr (Quotient.congrRight hiff)

omit [Fintype D] in
/-- Every point is reachable from its image under the edge product, using the
transpositions alone. -/
theorem wordReachable_swapProduct (σ : Perm D) (edges : List (D × D)) (x : D) :
    WordReachable (σ :: swapGenerators edges) x (swapProduct edges x) := by
  induction edges generalizing x with
  | nil => simpa using WordReachable.refl _ x
  | cons edge rest ih =>
      have hstep :
          WordReachable (σ :: swapGenerators (edge :: rest))
            (swapProduct rest x)
            (Equiv.swap edge.1 edge.2 (swapProduct rest x)) := by
        refine wordReachable_step ?_ _
        simp
      have htail :
          WordReachable (σ :: swapGenerators (edge :: rest)) x
            (swapProduct rest x) := by
        refine wordReachable_mono ?_ (ih x)
        intro g hg
        rcases List.mem_cons.mp hg with rfl | hg'
        · exact List.mem_cons_self
        · exact List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hg')
      simpa [swapProduct_cons, Perm.mul_apply] using htail.trans hstep

/-- **Faces refine components.**  Two points on one cycle of the face
permutation lie in one component of the map. -/
theorem wordReachable_of_sameCycle_mul (σ : Perm D) (edges : List (D × D))
    {x y : D} (h : (σ * swapProduct edges).SameCycle x y) :
    WordReachable (σ :: swapGenerators edges) x y := by
  have hstep : ∀ z : D,
      WordReachable (σ :: swapGenerators edges) z
        ((σ * swapProduct edges) z) := by
    intro z
    have hz : WordReachable (σ :: swapGenerators edges) z
        (swapProduct edges z) := wordReachable_swapProduct σ edges z
    have hσ : WordReachable (σ :: swapGenerators edges)
        (swapProduct edges z) (σ (swapProduct edges z)) :=
      wordReachable_step List.mem_cons_self _
    simpa [Perm.mul_apply] using hz.trans hσ
  obtain ⟨n, rfl⟩ := exists_nat_pow_apply_eq h
  clear h
  induction n with
  | zero => simpa using WordReachable.refl (σ :: swapGenerators edges) x
  | succ n ih =>
      have hpow : ((σ * swapProduct edges) ^ (n + 1)) x =
          (σ * swapProduct edges) (((σ * swapProduct edges) ^ n) x) := by
        rw [pow_succ', Perm.mul_apply]
      rw [hpow]
      exact ih.trans (hstep _)

/-- **The Euler bound.**  For a rotation `σ` and any finite edge list, the
vertex-orbit count plus the face-orbit count is at most the edge count plus
twice the component count.  With `σ` a vertex rotation and the edges a
fixed-point-free involution this is `V - E + F ≤ 2C`. -/
theorem orbitCount_add_orbitCount_mul_swapProduct_le (σ : Perm D) :
    ∀ edges : List (D × D), (∀ edge ∈ edges, edge.1 ≠ edge.2) →
      orbitCount σ + orbitCount (σ * swapProduct edges) ≤
        edges.length + 2 * wordOrbitCount (σ :: swapGenerators edges) := by
  intro edges
  induction edges with
  | nil =>
      intro _
      simp only [swapProduct_nil, mul_one, swapGenerators_nil,
        List.length_nil, Nat.zero_add]
      rw [wordOrbitCount_singleton]
      omega
  | cons edge rest ih =>
      intro hne
      classical
      set a := edge.1 with ha_def
      set b := edge.2 with hb_def
      have hab : a ≠ b := hne edge List.mem_cons_self
      have hrest : ∀ e ∈ rest, e.1 ≠ e.2 :=
        fun e he => hne e (List.mem_cons_of_mem _ he)
      have hIH := ih hrest
      set β := swapProduct rest with hβ
      set L := σ :: swapGenerators rest with hL
      set L' := σ :: swapGenerators (edge :: rest) with hL'
      -- the face permutation gains one conjugated transposition
      have hconj : σ * swapProduct (edge :: rest) =
          Equiv.swap (σ a) (σ b) * (σ * β) := by
        rw [swapProduct_cons, ← hβ, ← mul_assoc, Equiv.mul_swap_eq_swap_mul,
          mul_assoc]
      have hσab : σ a ≠ σ b := fun h => hab (σ.injective h)
      -- the two generator families differ only by the new transposition
      have hmem : ∀ g : Perm D,
          g ∈ L' ↔ g ∈ (Equiv.swap a b :: L) := by
        intro g
        simp only [hL, hL', swapGenerators_cons, List.mem_cons, ← ha_def,
          ← hb_def]
        tauto
      have hcount : wordOrbitCount L' =
          wordOrbitCount (Equiv.swap a b :: L) :=
        wordOrbitCount_eq_of_mem_iff hmem
      by_cases hconn : WordReachable L a b
      · -- the endpoints were already connected: components are unchanged,
        -- and the new edge can only split a face
        have hcomp : wordOrbitCount L' = wordOrbitCount L := by
          rw [hcount, wordOrbitCount_cons_swap_eq_of_reachable hconn]
        have hface : orbitCount (σ * swapProduct (edge :: rest)) ≤
            orbitCount (σ * β) + 1 := by
          rw [hconj]
          by_cases hsame : (σ * β).SameCycle (σ a) (σ b)
          · rw [orbitCount_swap_mul_of_sameCycle (σ * β) hσab hsame]
          · have := orbitCount_swap_mul_of_not_sameCycle (σ * β) hσab hsame
            omega
        rw [hcomp]
        simp only [List.length_cons]
        omega
      · -- the endpoints were in different components: the new edge must merge
        -- two faces, and can destroy at most one component
        have hnotsame : ¬ (σ * β).SameCycle (σ a) (σ b) := by
          intro hsame
          apply hconn
          have hreach : WordReachable L (σ a) (σ b) :=
            wordReachable_of_sameCycle_mul σ rest hsame
          have hsa : WordReachable L a (σ a) :=
            wordReachable_step List.mem_cons_self a
          have hsb : WordReachable L b (σ b) :=
            wordReachable_step List.mem_cons_self b
          exact hsa.trans (hreach.trans hsb.symm)
        have hface : orbitCount (σ * β) =
            orbitCount (σ * swapProduct (edge :: rest)) + 1 := by
          rw [hconj]
          exact orbitCount_swap_mul_of_not_sameCycle (σ * β) hσab hnotsame
        have hcomp : wordOrbitCount L ≤ wordOrbitCount L' + 1 := by
          rw [hcount]
          exact wordOrbitCount_le_cons_swap_add_one L a b
        simp only [List.length_cons]
        omega

end GoertzelV24MapEulerBound

end Mettapedia.GraphTheory.FourColor
