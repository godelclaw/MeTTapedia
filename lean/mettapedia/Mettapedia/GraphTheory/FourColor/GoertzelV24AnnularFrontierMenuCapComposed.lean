import Mettapedia.GraphTheory.FourColor.GoertzelV24AnnularFrontierMenuCapMatching

/-!
# The cap-composed Menu predicate and its transverse-chord criterion

The source's Menu B is read after the pentagonal cap is restored: it asks how
many classes the open strand pairing and the restored cap pairing generate
together on the four active boundary positions.  This file builds that composed
relation and reduces it to a criterion that inspects the strand pairing alone.

The cap pairing is a *perfect* matching of the four active positions, in two
blocks.  The strand pairing is only a *partial* matching, because a bichromatic
component of the open tangle has at most two degree-one ends on the inner
boundary.  Those two facts give the dichotomy:

* if no strand joins the two cap blocks, then every generator preserves the
  block partition, so it survives into the generated relation and there are at
  least two classes -- **menu B**;
* if one strand does join them, the two cap blocks are stitched together
  through it and all four active positions collapse into one class -- **menu A**.

So menu B for a pair is exactly the absence of a *transverse chord*.  Nothing
here inspects the interior of the tangle beyond the strand pairing it already
records, which is why the test can be evaluated on the finite rolling profile.
-/

namespace Mettapedia.GraphTheory.FourColor

namespace GoertzelV24AnnularFrontierMenuCapComposed

open GoertzelV24AnnularFrontierMenuCapMatching

variable {strand : Fin 5 → Fin 5 → Prop} {v : Fin 5}

/-- One generating step of the composed relation: an open strand in either
direction, or the restored cap pairing. -/
def ComposedStep (strand : Fin 5 → Fin 5 → Prop) (v : Fin 5) (i j : Fin 5) : Prop :=
  strand i j ∨ strand j i ∨ CapPairRel v i j

/-- The cap-composed pair relation: the equivalence generated by the open strand
pairing together with the restored cap pairing. -/
def ComposedRel (strand : Fin 5 → Fin 5 → Prop) (v : Fin 5) : Fin 5 → Fin 5 → Prop :=
  Relation.ReflTransGen (ComposedStep strand v)

theorem composedStep_symm {i j : Fin 5} (h : ComposedStep strand v i j) :
    ComposedStep strand v j i := by
  rcases h with h | h | h
  · exact Or.inr (Or.inl h)
  · exact Or.inl h
  · exact Or.inr (Or.inr (capPairRel_symm h))

theorem composedRel_refl (i : Fin 5) : ComposedRel strand v i i :=
  Relation.ReflTransGen.refl

theorem composedRel_of_step {i j : Fin 5} (h : ComposedStep strand v i j) :
    ComposedRel strand v i j :=
  Relation.ReflTransGen.single h

theorem composedRel_trans {i j k : Fin 5} (h : ComposedRel strand v i j)
    (h' : ComposedRel strand v j k) : ComposedRel strand v i k :=
  Relation.ReflTransGen.trans h h'

theorem composedRel_symm {i j : Fin 5} (h : ComposedRel strand v i j) :
    ComposedRel strand v j i := by
  induction h with
  | refl => exact Relation.ReflTransGen.refl
  | tail hab hbc ih =>
      exact Relation.ReflTransGen.trans
        (Relation.ReflTransGen.single (composedStep_symm hbc)) ih

/-- **Menu B for one colour pair.**  Two active boundary positions that the
composed relation does not identify, i.e. at least two classes. -/
def CapComposedMenuB (strand : Fin 5 → Fin 5 → Prop) (v : Fin 5) : Prop :=
  ∃ i j : Fin 5, i ≠ v ∧ j ≠ v ∧ ¬ ComposedRel strand v i j

/-- A strand is a **transverse chord** when it joins the two cap blocks. -/
def TransverseChord (strand : Fin 5 → Fin 5 → Prop) (v : Fin 5) : Prop :=
  ∃ i j : Fin 5, i ≠ v ∧ j ≠ v ∧ strand i j ∧ ¬ (CapBlock v i ↔ CapBlock v j)

/-- With no transverse chord present, the block partition is an invariant of the
generated relation. -/
theorem capBlock_iff_of_composedRel
    (hpres : ∀ a b : Fin 5, strand a b → (CapBlock v a ↔ CapBlock v b))
    {i j : Fin 5} (h : ComposedRel strand v i j) :
    CapBlock v i ↔ CapBlock v j := by
  induction h with
  | refl => exact Iff.rfl
  | tail hab hbc ih =>
      refine ih.trans ?_
      rcases hbc with hs | hs | hs
      · exact hpres _ _ hs
      · exact (hpres _ _ hs).symm
      · exact hs

/-- The two cap blocks are inhabited by active positions, and those two
positions lie in different blocks. -/
private theorem add_ne_self (v : Fin 5) {k : Fin 5} (hk : k ≠ 0) : v + k ≠ v := by
  revert hk; revert v k; decide

theorem exists_active_cross (v : Fin 5) :
    (v + 1 : Fin 5) ≠ v ∧ (v + 2 : Fin 5) ≠ v ∧ ¬ (CapBlock v (v + 1) ↔ CapBlock v (v + 2)) := by
  refine ⟨add_ne_self v (by decide), add_ne_self v (by decide), ?_⟩
  have key : ∀ u : Fin 5,
      ¬ ((u + 1 = u + 4 ∨ u + 1 = u + 1) ↔ (u + 2 = u + 4 ∨ u + 2 = u + 1)) := by decide
  exact key v

/-- Every active position shares a cap block with one of the two ends of a
transverse chord. -/
private theorem block_dichotomy {a b i : Fin 5}
    (hab : ¬ (CapBlock v a ↔ CapBlock v b)) :
    (CapBlock v i ↔ CapBlock v a) ∨ (CapBlock v i ↔ CapBlock v b) := by
  by_cases hi : CapBlock v i <;> by_cases ha : CapBlock v a <;> by_cases hb : CapBlock v b <;>
    simp_all [iff_iff_implies_and_implies]

/-- **A transverse chord collapses all four active positions.** -/
theorem composedRel_of_transverseChord (htr : TransverseChord strand v)
    {i j : Fin 5} : ComposedRel strand v i j := by
  obtain ⟨a, b, -, -, hstrand, hab⟩ := htr
  have hab_step : ComposedRel strand v a b :=
    composedRel_of_step (Or.inl hstrand)
  have hreach : ∀ k : Fin 5, ComposedRel strand v k a := by
    intro k
    rcases block_dichotomy (v := v) (i := k) hab with hk | hk
    · exact composedRel_of_step (Or.inr (Or.inr hk))
    · exact composedRel_trans
        (composedRel_of_step (Or.inr (Or.inr hk))) (composedRel_symm hab_step)
  exact composedRel_trans (hreach i) (composedRel_symm (hreach j))

/-- **The transverse-chord criterion.**  Menu B for a colour pair holds exactly
when no open strand joins the two blocks of the restored cap matching.

This is the source's Lemma in the direction that matters for the terminal test:
the whole predicate is a property of the strand pairing and the inactive
position, both of which the finite profile already records. -/
theorem capComposedMenuB_iff_no_transverseChord
    (hactive : ∀ a b : Fin 5, strand a b → a ≠ v ∧ b ≠ v) :
    CapComposedMenuB strand v ↔ ¬ TransverseChord strand v := by
  constructor
  · rintro ⟨i, j, -, -, hne⟩ htr
    exact hne (composedRel_of_transverseChord htr)
  · intro hno
    have hpres : ∀ a b : Fin 5, strand a b → (CapBlock v a ↔ CapBlock v b) := by
      intro a b hs
      by_contra hab
      exact hno ⟨a, b, (hactive a b hs).1, (hactive a b hs).2, hs, hab⟩
    obtain ⟨h1, h2, hcross⟩ := exists_active_cross v
    exact ⟨v + 1, v + 2, h1, h2, fun hrel =>
      hcross (capBlock_iff_of_composedRel hpres hrel)⟩

/-! ## Both menus are realizable

The predicate this one replaces was true on every realizable state.  The two
fixtures below check that the cap-composed predicate is not: it holds when the
strand pairing is empty and fails when a single transverse strand is present.
A terminal test that separates states has to distinguish at least these two. -/

/-- **Total closure implies menu B.**  When every strand is radial the open
pairing on the inner boundary is empty, so no transverse chord exists.  This is
the source's corollary at the five-outer-stub boundary, in one line. -/
theorem capComposedMenuB_of_no_strand (v : Fin 5) :
    CapComposedMenuB (fun _ _ => False) v :=
  (capComposedMenuB_iff_no_transverseChord (fun _ _ h => h.elim)).mpr
    (fun htr => htr.choose_spec.choose_spec.2.2.1)

/-- **One transverse strand gives menu A.**  Joining the two cap blocks
collapses all four active positions into a single class. -/
theorem not_capComposedMenuB_of_single_transverse (v : Fin 5) :
    ¬ CapComposedMenuB
      (fun i j => (i = v + 1 ∧ j = v + 2) ∨ (i = v + 2 ∧ j = v + 1)) v := by
  have hactive : ∀ a b : Fin 5,
      ((a = v + 1 ∧ b = v + 2) ∨ (a = v + 2 ∧ b = v + 1)) → a ≠ v ∧ b ≠ v := by
    obtain ⟨h1, h2, -⟩ := exists_active_cross v
    rintro a b (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · exact ⟨h1, h2⟩
    · exact ⟨h2, h1⟩
  intro hmenu
  obtain ⟨h1, h2, hcross⟩ := exists_active_cross v
  exact (capComposedMenuB_iff_no_transverseChord hactive).mp hmenu
    ⟨v + 1, v + 2, h1, h2, Or.inl ⟨rfl, rfl⟩, hcross⟩

end GoertzelV24AnnularFrontierMenuCapComposed

end Mettapedia.GraphTheory.FourColor
