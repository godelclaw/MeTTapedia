{
  "dialect": "he",
  "schemaVersion": 1,
  "contracts": [
    {
      "head": "match",
      "arity": 3,
      "argRoles": ["space-ref", "pattern", "template"],
      "specConstructors": ["MinimalStep.match", "MinimalStep.match_empty"],
      "semanticAuthority": ["Space.queryEquations", "Matching.matchAtoms", "Matching.mergeBindings", "Bindings.apply"],
      "determinism": "nondeterministic",
      "bindingsFlow": "mergeFromMatch",
      "resultCases": ["match succeeds: template with pattern variables substituted, one result per match", "no match: internal Empty sentinel, reported as no user-visible results"],
      "errorCases": [],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "match: simple equation lookup", "positive": true, "instructionAtom": "(match &self (= a $x) $x)", "expectedResults": ["b"] },
      { "label": "match: no equation → Empty", "positive": true, "instructionAtom": "(match &self (= z $x) $x)", "expectedResults": ["Empty"] },
      { "label": "match: multiple results (nondeterministic)", "positive": true, "instructionAtom": "(match &self (= color $x) $x)", "expectedResults": ["red", "green"] }
      ]
    },
    {
      "head": "unify",
      "arity": 4,
      "argRoles": ["target-atom", "pattern", "success-body", "failure-body"],
      "specConstructors": ["Spec.Eval.Minimal.CoreStepRel.unifySuccess", "Spec.Eval.Minimal.CoreStepRel.unifyNoMatch"],
      "semanticAuthority": ["Matching.matchAtoms", "Matching.mergeBindings", "Bindings.hasLoop", "Bindings.apply"],
      "determinism": "branchingTwoWay",
      "bindingsFlow": "mergeFromMatch",
      "resultCases": ["match succeeds: merged bindings applied to success-body", "match fails: failure-body with original input bindings"],
      "errorCases": ["variable loop in merged bindings: candidate refused; if none survive, use failure-body"],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "unify: match succeeds, binds variable", "positive": true, "instructionAtom": "(unify (A B) ($x $y) (found $x $y) (not-found))", "expectedResults": ["(found A B)"] },
      { "label": "unify: no match, returns else branch", "positive": true, "instructionAtom": "(unify (A B) (C D) success failure)", "expectedResults": ["failure"] },
      { "label": "unify: cyclic candidate refused, returns else branch", "positive": false, "instructionAtom": "(unify $x (f $x) success failure)", "expectedResults": ["failure"] }
      ]
    },
    {
      "head": "switch",
      "arity": 2,
      "argRoles": ["scrutinee under the declared input demand", "branches ((pattern template) ...)"],
      "specConstructors": ["Spec.Eval.CallRel.equation", "Spec.Eval.Minimal.CoreStepRel.functionReturn", "Spec.Eval.Minimal.CoreStepRel.unifySuccess", "Spec.Eval.Minimal.CoreStepRel.unifyNoMatch"],
      "semanticAuthority": ["authored stdlib switch, switch-minimal and switch-internal equations", "Spec.Eval.Minimal.CoreInvocationRel", "Spec.Eval.Steps.UnifyCandidateRel", "Spec.Eval.CallReturnRel"],
      "determinism": "nondeterministic",
      "bindingsFlow": "mergeFromMatch",
      "resultCases": ["first surviving branch: materialize its template with the reached bindings", "switch-minimal: its Atom result demand holds the selected output", "switch: its ordinary return demand may interpret the selected output again", "no matching branch: internal Empty sentinel, reported as no user-visible results"],
      "errorCases": [],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "switch: first match wins", "positive": true, "instructionAtom": "(switch a ((a ok) (b bad)))", "expectedResults": ["ok"] },
      { "label": "switch: variable pattern binds into template", "positive": true, "instructionAtom": "(switch z (($x (tag $x))))", "expectedResults": ["(tag z)"] },
      { "label": "switch: no match → no results", "positive": false, "instructionAtom": "(switch z ((a ok) (b bad)))", "expectedResults": [] },
      { "label": "switch-minimal: selected Atom result", "positive": true, "instructionAtom": "(switch-minimal a ((a ok)))", "expectedResults": ["ok"] }
      ]
    },
    {
      "head": "case",
      "arity": 2,
      "argRoles": ["scrutinee (to be evaluated)", "branches ((pattern template) ...)"],
      "specConstructors": ["MC_Case_Start (evaluates scrutinee, then delegates to switch)"],
      "semanticAuthority": ["metta", "switchContract"],
      "determinism": "nondeterministic",
      "bindingsFlow": "mergeFromMatch",
      "resultCases": ["scrutinee evaluates, then matching branch selected (via switch semantics)", "no matching branch: internal Empty sentinel, reported as no user-visible results"],
      "errorCases": [],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "case: evaluates scrutinee then matches", "positive": true, "instructionAtom": "(case a ((a ok) (b bad)))", "expectedResults": ["ok"] },
      { "label": "case: no match → Empty", "positive": false, "instructionAtom": "(case z ((a ok) (b bad)))", "expectedResults": ["Empty"] }
      ]
    },
    {
      "head": "chain",
      "arity": 3,
      "argRoles": ["minimal source", "local variable", "minimal continuation template"],
      "specConstructors": ["Spec.Eval.Minimal.CoreStepRel.chain"],
      "semanticAuthority": ["Spec.Eval.Minimal.CoreRunRel", "Spec.Type.Presentation.BindingTheory.BindingMaterializationRel", "Spec.Eval.Minimal.substituteName"],
      "determinism": "nondeterministic",
      "bindingsFlow": "fromNested",
      "resultCases": ["each source result: materialize under its output bindings, substitute the local variable and run the minimal template", "source binding refinements are retained; the local binder is not exported", "Empty and NotReducible source sentinels are also substituted into the template", "only final Empty output is omitted at the observation boundary"],
      "errorCases": [],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "chain: eval result substituted into template", "positive": true, "instructionAtom": "(chain x $v (tag $v))", "expectedResults": ["(tag x)"] },
      { "label": "chain: Empty source is substituted into the continuation", "positive": true, "instructionAtom": "(chain Empty $v (tag $v))", "expectedResults": ["(tag Empty)"] }
      ]
    },
    {
      "head": "collapse-bind",
      "arity": 1,
      "argRoles": ["atom (to evaluate and collect all results)"],
      "specConstructors": ["Spec.Eval.Minimal.CoreStepRel.collapseBind"],
      "semanticAuthority": ["Spec.Eval.Minimal.MinimalResultRel", "Spec.Eval.Minimal.EvalEnumeration", "Spec.Eval.Minimal.MinimalEnumerationLaws", "Spec.Eval.Minimal.encodeResults", "Spec.Eval.Minimal.Services.bindingPayload"],
      "determinism": "deterministic",
      "bindingsFlow": "encodeBindings",
      "resultCases": ["one or more results: expression of (<atom> <opaque-bindings>) pairs", "no results: empty expression ()"],
      "errorCases": [],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "collapse-bind: single result with bindings encoded", "positive": true, "instructionAtom": "(collapse-bind x)", "expectedResults": ["((x {  }))"] },
      { "label": "collapse-bind: empty eval → empty expression", "positive": false, "instructionAtom": "(collapse-bind (eval (match &self (= z $w) $w)))", "expectedResults": ["()"] },
      { "label": "collapse-bind: filters Empty branches", "positive": true, "instructionAtom": "(collapse-bind (eval (superpose (a Empty b))))", "expectedResults": ["((b {  }) (a {  }))"] }
      ]
    },
    {
      "head": "superpose-bind",
      "arity": 1,
      "argRoles": ["encoded-pairs (from collapse-bind output)"],
      "specConstructors": ["Spec.Eval.Minimal.CoreStepRel.superposeBind"],
      "semanticAuthority": ["Spec.Eval.Minimal.encodeResults", "Spec.Match.Merge.MergeRel"],
      "determinism": "nondeterministic",
      "bindingsFlow": "restoreFromCollapse",
      "resultCases": ["one result per encoded pair: original (atom, bindings) restored", "empty input: no results"],
      "errorCases": [],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "superpose-bind: restores one collapsed alternative", "positive": true, "instructionAtom": "(chain (collapse-bind x) $collapsed (superpose-bind $collapsed))", "expectedResults": ["x"] },
      { "label": "superpose-bind: restores multiple collapsed alternatives", "positive": true, "instructionAtom": "(chain (collapse-bind (superpose (a b))) $collapsed (superpose-bind $collapsed))", "expectedResults": ["b", "a"] },
      { "label": "superpose-bind: empty input → no results", "positive": false, "instructionAtom": "(superpose-bind ())", "expectedResults": [] }
      ]
    },
    {
      "head": "assert",
      "arity": 1,
      "argRoles": ["expression (to evaluate and check against True)"],
      "specConstructors": ["MC_Assert_Start", "MC_Assert_True", "MC_Assert_NotTrue"],
      "semanticAuthority": ["metta", "Matching.matchAtoms", "Matching.mergeBindings", "Bindings.hasLoop"],
      "determinism": "branchingTwoWay",
      "bindingsFlow": "mergeFromMatch",
      "resultCases": ["result matches True: return unit atom ()", "result does not match True: return (Error (assert <expr>) (<result> not True))"],
      "errorCases": ["assertion failure: explicit Error atom with the failing result"],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "assert: True → unit", "positive": true, "instructionAtom": "(assert True)", "expectedResults": ["()"] },
      { "label": "assert: False → Error", "positive": false, "instructionAtom": "(assert False)", "expectedResults": ["(Error (assert False) (False not True))"] },
      { "label": "assert: non-boolean → Error", "positive": false, "instructionAtom": "(assert hello)", "expectedResults": ["(Error (assert hello) (hello not True))"] }
      ]
    },
    {
      "head": "function",
      "arity": 1,
      "argRoles": ["body (to evaluate until return)"],
      "specConstructors": ["Spec.Eval.Minimal.CoreStepRel.functionReturn", "Spec.Eval.Minimal.CoreStepRel.functionNoReturn"],
      "semanticAuthority": ["Spec.Eval.Minimal.CoreFunctionBodyRel", "Spec.Type.Presentation.BindingTheory.BindingMaterializationRel", "Spec.Eval.Minimal.functionTerminalResult"],
      "determinism": "nondeterministic",
      "bindingsFlow": "fromNested",
      "resultCases": ["materialize every finished body result under its output bindings before classifying it", "an exposed embedded instruction resumes under the saved function frame", "a materialized (return <atom>) unwraps and returns <atom>", "body does not produce (return ...): blame the saved caller, or the terminal at the outermost boundary", "body returns Empty: no user-visible answer"],
      "errorCases": ["NoReturn: body reached a terminal form that is not (return <atom>)"],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "function: return unwraps value", "positive": true, "instructionAtom": "(function (return ok))", "expectedResults": ["ok"] },
      { "label": "function: no return → NoReturn error", "positive": false, "instructionAtom": "(function (stuck))", "expectedResults": ["(Error (stuck) NoReturn)"] }
      ]
    },
    {
      "head": "superpose",
      "arity": 1,
      "argRoles": ["expression (elements to branch over)"],
      "specConstructors": ["MC_Superpose", "MC_Superpose_Empty"],
      "semanticAuthority": [],
      "determinism": "nondeterministic",
      "bindingsFlow": "passthrough",
      "resultCases": ["non-empty expression: one result per element (nondeterministic)", "empty expression (): internal Empty sentinel, reported as no user-visible results"],
      "errorCases": [],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "superpose: branch over elements", "positive": true, "instructionAtom": "(superpose (a b c))", "expectedResults": ["a", "b", "c"] },
      { "label": "superpose: empty → Empty", "positive": false, "instructionAtom": "(superpose ())", "expectedResults": ["Empty"] }
      ]
    },
    {
      "head": "eval",
      "arity": 1,
      "argRoles": ["atom (to evaluate one step)"],
      "specConstructors": ["Spec.Eval.Minimal.CoreStepRel.eval"],
      "semanticAuthority": ["Spec.Eval.Minimal.RawInvocationRel", "Spec.Eval.Minimal.MinimalRunRel", "Spec.Type.Presentation.BindingTheory.BindingMaterializationRel", "Spec.Eval.NativeEmissionRel", "Spec.Eval.GroundedDispatch.bindingMode", "Spec.Eval.GroundedDispatch.valueProvenance"],
      "determinism": "nondeterministic",
      "bindingsFlow": "mergeFromMatch",
      "resultCases": ["materialize the requested atom under the incoming bindings before invocation", "atom reduces: one or more result atoms with updated bindings", "producer binding mode determines whether native emissions remain raw or are materialized after merge", "equation emissions are materialized under their selected output bindings", "ordinary native emission: emitted function completes before the raw result is returned", "producer-completed native value: raw invocation retains the value without function execution", "atom is irreducible: NotReducible", "empty alternatives: internal Empty sentinel; final Empty output is omitted"],
      "errorCases": ["runtime failure: structured Error result", "resource exhaustion: incomplete execution, not an unchanged semantic answer"],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "eval: symbol is irreducible", "positive": false, "instructionAtom": "(eval x)", "expectedResults": ["NotReducible"] },
      { "label": "eval: expression with equation reduces", "positive": true, "instructionAtom": "(eval (f a))", "expectedResults": ["b"] }
      ]
    },
    {
      "head": "cons-atom",
      "arity": 2,
      "argRoles": ["head (atom)", "tail (expression)"],
      "specConstructors": ["Spec.Eval.Minimal.CoreStepRel.consAtom"],
      "semanticAuthority": [],
      "determinism": "deterministic",
      "bindingsFlow": "passthrough",
      "resultCases": ["always succeeds: expression with head prepended to tail elements"],
      "errorCases": [],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "cons-atom: prepend to list", "positive": true, "instructionAtom": "(cons-atom a (b c))", "expectedResults": ["(a b c)"] },
      { "label": "cons-atom: prepend to empty", "positive": true, "instructionAtom": "(cons-atom a ())", "expectedResults": ["(a)"] }
      ]
    },
    {
      "head": "decons-atom",
      "arity": 1,
      "argRoles": ["expression (non-empty, to deconstruct)"],
      "specConstructors": ["Spec.Eval.Minimal.CoreStepRel.deconsAtom"],
      "semanticAuthority": [],
      "determinism": "deterministic",
      "bindingsFlow": "passthrough",
      "resultCases": ["non-empty expression: returns (head tail) where tail is the remaining elements"],
      "errorCases": ["empty expression (): undefined (no MinimalStep constructor matches)"],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "decons-atom: split expression", "positive": true, "instructionAtom": "(decons-atom (a b c))", "expectedResults": ["(a (b c))"] },
      { "label": "decons-atom: singleton", "positive": true, "instructionAtom": "(decons-atom (a))", "expectedResults": ["(a ())"] }
      ]
    },
    {
      "head": "context-space",
      "arity": 0,
      "argRoles": [],
      "specConstructors": ["Spec.Eval.Minimal.CoreStepRel.contextSpace"],
      "semanticAuthority": ["Spec.Eval.Minimal.Services.contextPayload"],
      "determinism": "deterministic",
      "bindingsFlow": "passthrough",
      "resultCases": ["always succeeds: opaque grounded handle for the current space"],
      "errorCases": [],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "context-space: empty space", "positive": true, "instructionAtom": "(context-space)", "expectedResults": ["&self"] }
      ]
    },
    {
      "head": "call-native",
      "arity": 3,
      "argRoles": ["op (executable grounded atom)", "args (expression of arguments)"],
      "specConstructors": ["Spec.Eval.Minimal.CoreStepRel.callNative"],
      "semanticAuthority": ["GroundedDispatch.isExecutable", "GroundedDispatch.execute"],
      "determinism": "nondeterministic",
      "bindingsFlow": "passthrough",
      "resultCases": ["native call succeeds: result atom from native, input bindings preserved", "runtime error: Error atom", "no reduce: atom returned unchanged"],
      "errorCases": ["GroundedResult.runtimeError: explicit error from native function", "GroundedResult.incorrectArgument: wrong argument types"],
      "mutatesSpace": false,
      "fixtures": [
      { "label": "call-native: bindings are not modified (spec limitation)", "positive": true, "instructionAtom": "(call-native + (1 2))", "expectedResults": ["3"] }
      ]
    }
  ]
}
