import Mettapedia.GSLT.LanguageDef.ModuleFormat.Controls
import Lean.Util.CollectAxioms

open Lean Elab Command

run_cmd do
  let modules := #[
    `Mettapedia.GSLT.LanguageDef.ModuleFormat.Value,
    `Mettapedia.GSLT.LanguageDef.ModuleFormat.Envelope,
    `Mettapedia.GSLT.LanguageDef.ModuleFormat.Authoring,
    `Mettapedia.GSLT.LanguageDef.ModuleFormat.Catalog,
    `Mettapedia.GSLT.LanguageDef.ModuleFormat.Linking,
    `Mettapedia.GSLT.LanguageDef.ModuleFormat.Exports,
    `Mettapedia.GSLT.LanguageDef.ModuleFormat.DependencyAdmission,
    `Mettapedia.GSLT.LanguageDef.ModuleFormat,
    `Mettapedia.GSLT.LanguageDef.ModuleFormat.Controls]
  let allowed := #[``propext, ``Quot.sound, ``Classical.choice]
  let compilerHelpers := #[
    "_private.Mettapedia.GSLT.LanguageDef.ModuleFormat.Value.0.Mettapedia.GSLT.LanguageDef.ModuleFormat.decEqValues._unsafe_rec",
    "_private.Mettapedia.GSLT.LanguageDef.ModuleFormat.Value.0.Mettapedia.GSLT.LanguageDef.ModuleFormat.decEqValue._unsafe_rec",
    "_private.Mettapedia.GSLT.LanguageDef.ModuleFormat.Value.0.Mettapedia.GSLT.LanguageDef.ModuleFormat.decEqFields._unsafe_rec",
    "Mettapedia.GSLT.LanguageDef.ModuleFormat.instReprValue.repr._unsafe_rec"]
  let env ← getEnv
  let mut total := 0
  let mut theorems := 0
  let mut compilerOnly := 0
  for moduleName in modules do
    let some index := env.header.moduleNames.toList.idxOf? moduleName
      | throwError "missing audited module {moduleName}"
    let data := env.header.moduleData[index]!
    for name in (data.constNames ++ data.extraConstNames).toList.eraseDups do
      let some info := env.checked.get.find? name | do
        unless data.extraConstNames.contains name do
          throwError "unavailable kernel declaration {name}"
        compilerOnly := compilerOnly + 1
        continue
      if info matches .axiomInfo _ then throwError "new axiom {name}"
      if info.isUnsafe then throwError "unsafe source declaration {name}"
      if info.isPartial then
        unless compilerHelpers.contains name.toString do
          throwError "unexpected partial declaration {name}"
        logInfo m!"COMPILER-HELPER {name}; partial recursion implementation generated by Lean"
        compilerOnly := compilerOnly + 1
        continue
      let dependencies ← liftCoreM <| collectAxioms name
      for dependency in dependencies do
        unless allowed.contains dependency do
          throwError "unpermitted dependency {name}: {dependency}"
      total := total + 1
      if info matches .thmInfo _ then theorems := theorems + 1
      logInfo m!"AUDIT {name}: {dependencies.toList}"
  logInfo m!"SUMMARY: {modules.size} modules, {total} kernel declarations, {theorems} theorems, {compilerOnly} compiler-only names"
