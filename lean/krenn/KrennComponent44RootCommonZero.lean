theorem no_base_common_zero_on_component44 {R : Type*} [Field R] [CharZero R]
    (full : Fin 75 → R) (base : Krenn.FrozenCase0System.CommonZero full)
    (selectedVanish : ∀ generator ∈ componentGenerators 43,
      generatorEval (reduceRaw (rawValues full)) generator = 0) : False := by
  exact Krenn.Component44.Tree.component44HasNoCommonZero (rootValues full)
    (rootCommonZero_of_base_and_component full base selectedVanish)

