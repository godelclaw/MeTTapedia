/-- Component 60 is now an end-to-end frozen-system contradiction. -/
theorem no_base_common_zero_on_component60 {R : Type*} [Field R] [CharZero R]
    (full : Fin 75 → R) (base : Krenn.FrozenCase0System.CommonZero full)
    (selectedVanish : ∀ generator ∈ componentGenerators 59,
      generatorEval (reduceRaw (rawValues full)) generator = 0) : False := by
  exact Krenn.Component60.Tree.component60HasNoCommonZero (rootValues full)
    (rootCommonZero_of_base_and_component full base selectedVanish)

end Krenn.Component60RootCommonZero

