/-- The matching that vertex permutation `s` sends matching `m` to. -/
def pmAct (s m : Nat) : Nat := pmActT (s * 15 + m)

/-- Applying a triple's recorded witness lands on its recorded representative. -/
def witnessOk (t : Nat) : Bool :=
  let m : Nat → Nat := fun i => (t / (if i = 0 then 225 else if i = 1 then 15 else 1)) % 15
  let s := witSigmaT t
  let u := witTauT t
  let img : Nat → Nat := fun i => pmAct s (m (s3T (u * 3 + i)))
  (img 0 * 225 + img 1 * 15 + img 2) == repCodeT (witRepT t)

set_option maxHeartbeats 4000000 in
/-- **Every one of the 3375 matching triples is carried to its orbit
representative by its recorded witness.** -/
theorem classification_correct :
    ((List.range 3375).all fun t => witnessOk t) = true := by decide

set_option maxHeartbeats 4000000 in
/-- The classification uses exactly eight orbits. -/
theorem orbit_count :
    (((List.range 3375).map fun t => witRepT t).foldl max 0) = 7 := by decide

end TripleOrbits
