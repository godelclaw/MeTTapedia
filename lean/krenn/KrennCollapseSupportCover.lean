theorem feasibleHasCertifiedCover (pattern : Fin 26 → Prop)
    (feasible : Feasible pattern) :
    ∃ certificate : CertifiedCover, ActiveMatches certificate.data.active pattern := by
  obtain ⟨row, _, covered⟩ := Semantic.everyFeasiblePatternCovered pattern feasible
  let active := BitVec.ofNat 14 row.activeMask
  let data : ActiveCover := ⟨active, Semantic.strataFor active⟩
  let certificate : CertifiedCover :=
    ⟨data, Semantic.zeroCoveredFromGlobal data rfl⟩
  exact ⟨certificate, Semantic.activeMatchesOfCovers row pattern covered⟩

theorem everyFeasiblePatternCovered (pattern : Fin 26 → Prop)
    (feasible : Feasible pattern) :
    ∃ cover : ActiveCover, ActiveMatches cover.active pattern ∧
      ∃ stratum ∈ cover.strata, ZeroMatches stratum.zero pattern := by
  obtain ⟨certificate, active⟩ := feasibleHasCertifiedCover pattern feasible
  exact ⟨certificate.data, active, certificate.zeroCovered pattern feasible active⟩

end Krenn.CollapseSupportCover

#print axioms Krenn.CollapseSupportCover.everyFeasiblePatternCovered
