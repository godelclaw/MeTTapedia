/-- Component 25 is now an end-to-end frozen-system contradiction. -/
theorem no_base_common_zero_on_component25 {R : Type*} [Field R] [CharZero R]
    (full : Fin 75 → R) (base : Krenn.FrozenCase0System.CommonZero full)
    (selectedVanish : ∀ generator ∈ componentGenerators 24,
      generatorEval (reduceRaw (rawValues full)) generator = 0) : False := by
  exact Krenn.Component25.Tree.component25HasNoCommonZero (rootValues full)
    (rootCommonZero_of_base_and_component full base selectedVanish)

end Krenn.Component25RootCommonZero

