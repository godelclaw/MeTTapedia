/-- Component 48 is now an end-to-end frozen-system contradiction. -/
theorem no_base_common_zero_on_component48 {R : Type*} [Field R] [CharZero R]
    (full : Fin 75 → R) (base : Krenn.FrozenCase0System.CommonZero full)
    (selectedVanish : ∀ generator ∈ componentGenerators 47,
      generatorEval (reduceRaw (rawValues full)) generator = 0) : False := by
  exact Krenn.Component48.Tree.component48HasNoCommonZero (rootValues full)
    (rootCommonZero_of_base_and_component full base selectedVanish)

end Krenn.Component48RootCommonZero

