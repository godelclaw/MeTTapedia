theorem no_base_common_zero_on_component24 {R : Type*} [Field R] [CharZero R]
    (full : Fin 75 → R) (base : Krenn.FrozenCase0System.CommonZero full)
    (selectedVanish : ∀ generator ∈ componentGenerators 23,
      generatorEval (reduceRaw (rawValues full)) generator = 0) : False := by
  exact Krenn.Component24.Tree.component24HasNoCommonZero (rootValues full)
    (rootCommonZero_of_base_and_component full base selectedVanish)

