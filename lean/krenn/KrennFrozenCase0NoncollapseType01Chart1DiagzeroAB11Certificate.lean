/-- The compact selected family is definitionally the indicated
subfamily of the complete frozen parent.  Keeping the selected data
direct avoids repeatedly unfolding a large parent vector downstream. -/
theorem selectedEquation_eq_parent (index : Fin 7) :
    selectedEquations index = parentEquations (selectedIndices index) := by
  fin_cases index <;> rfl

