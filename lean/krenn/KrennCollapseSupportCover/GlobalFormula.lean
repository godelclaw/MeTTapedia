def activityLiterals (activeMask : Nat) : Sat.Clause :=
  (List.range 14).map fun relation =>
    if activeMask.testBit relation then .neg (26 + relation)
    else .pos (26 + relation)

def zeroLiterals (zeroMask : Nat) : Sat.Clause :=
  (List.range 26).filterMap fun coordinate =>
    if zeroMask.testBit coordinate then some (.pos coordinate) else none

def stratumClause (stratum : Stratum) : Sat.Clause :=
  List.append (activityLiterals stratum.activeMask)
    (zeroLiterals stratum.zeroMask)

noncomputable def formula : Sat.Fmla :=
  List.append relationFormula (strata.map stratumClause)

set_option maxHeartbeats 0 in
set_option maxRecDepth 1000000 in
raw_lrat_proof_for contradiction formula
  (include_str "LRAT/GlobalSupportCover.cnf")
  (include_str "LRAT/GlobalSupportCover.lrat")

#print axioms contradiction

end Krenn.CollapseSupportCover.GlobalFormula
