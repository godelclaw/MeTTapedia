theorem no_base_common_zero_on_component22 {R : Type*} [Field R] [CharZero R]
    (full : Fin 75 → R) (base : Krenn.FrozenCase0System.CommonZero full)
    (selectedVanish : ∀ generator ∈ componentGenerators 21,
      generatorEval (reduceRaw (rawValues full)) generator = 0) : False := by
  exact Krenn.Component22.Tree.component22HasNoCommonZero (rootValues full)
    (rootCommonZero_of_base_and_component full base selectedVanish)

