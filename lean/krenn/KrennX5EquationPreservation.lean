/-- The variable that element `g` sends variable `v` to. -/
def varPerm (g v : Nat) : Nat := varPermT (g * 75 + v)
/-- The polynomial index that element `g` sends polynomial `i` to. -/
def polyPerm (g i : Nat) : Nat := polyPermT (g * 675 + i)

/-- Number of monomials of polynomial `i`. -/
def monCount (i : Nat) : Nat := monStartT (i + 1) - monStartT i
/-- The `t`-th monomial code of polynomial `i`. -/
def monAt (i t : Nat) : Nat := monCodeT (monStartT i + t)

/-- Encode a degree-three squarefree monomial as a sorted triple. -/
def enc3 (a b c : Nat) : Nat :=
  let x := min a (min b c)
  let z := max a (max b c)
  let y := a + b + c - x - z
  x * 5625 + y * 75 + z

/-- Rename the variables of a monomial code by element `g`. -/
def renameMon (g m : Nat) : Nat :=
  enc3 (varPerm g (m / 5625)) (varPerm g (m / 75 % 75)) (varPerm g (m % 75))

/-- Does polynomial `j` contain the monomial `m`? -/
def hasMon (j m : Nat) : Bool :=
  (List.range (monCount j)).any (fun t => monAt j t == m)

/-- Renaming polynomial `i` by `g` reproduces polynomial `polyPerm g i` exactly. -/
def preservesPoly (g i : Nat) : Bool :=
  let j := polyPerm g i
  (constNegT j == constNegT i) && (monCount j == monCount i) &&
    (List.range (monCount i)).all (fun t => hasMon j (renameMon g (monAt i t))) &&
    -- distinct monomials stay distinct, so "contained and equinumerous" is
    -- genuinely set equality rather than a covering
    (List.range (monCount i)).all (fun t => (List.range (monCount i)).all
      (fun u => t == u || renameMon g (monAt i t) != renameMon g (monAt i u)))

/-- Each element renames every polynomial of the system to another polynomial
of the system, constants and all. -/
