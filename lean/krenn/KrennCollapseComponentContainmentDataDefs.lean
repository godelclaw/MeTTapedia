noncomputable def squarefreeExponent (support : Nat) : Fin 26 →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm fun coordinate =>
    if support.testBit coordinate then 1 else 0

@[simp] theorem squarefreeExponent_apply (support : Nat) (coordinate : Fin 26) :
    squarefreeExponent support coordinate =
      if support.testBit coordinate then 1 else 0 := by
  simp [squarefreeExponent]

noncomputable def relation (index : Fin 14) : Binomial (Fin 26) :=
  { left := squarefreeExponent (relationLeftSupport index)
    right := squarefreeExponent (relationRightSupport index) }

